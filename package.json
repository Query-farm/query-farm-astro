{
  "name": "query-farm-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "fetch:versions": "node scripts/fetch-haybarn-versions.mjs",
    "snapshot:usage": "scripts/snapshot-usage.sh",
    "snapshot:binary-sizes": "scripts/snapshot-binary-sizes.sh",
    "build": "astro build",
    "postbuild": "node scripts/build-search-index.mjs",
    "check": "astro check",
    "validate": "npm run build",
    "refresh:snapshots": "node scripts/fetch-haybarn-versions.mjs && scripts/snapshot-binary-sizes.sh && scripts/snapshot-usage.sh",
    "preview": "astro preview",
    "astro": "astro",
    "check:examples": "extension-diff-tools/check-examples.py --force-install",
    "gen:api:csharp": "scripts/gen-api-csharp.sh",
    "generate:og-extensions": "node scripts/generate-extension-og-images.mjs",
    "generate:og-vgi-docs": "node scripts/generate-vgi-docs-og-images.mjs",
    "generate:og-images": "npm run generate:og-extensions && npm run generate:og-vgi-docs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.41.1",
    "@haybarn/haybarn-wasm": "1.5.5-rc2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.61",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.5",
    "marked": "^18.0.2",
    "pako": "^3.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "apache-arrow": "^21.1.0",
    "pagefind": "^1.5.2",
    "satori": "^0.33.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "^8.0.13"
  }
}
