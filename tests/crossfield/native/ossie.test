# Website download regression. Run from the extracted ossie directory.
# Expected values are independently specified; native SQLLogicTest runner only.
require crossfield

require-env WEBSITE_EXAMPLE_DIR

statement ok
CREATE TABLE scoped_orders(
    source_id INTEGER PRIMARY KEY, raw_amount INTEGER, region VARCHAR, status VARCHAR
);

statement ok
INSERT INTO scoped_orders VALUES
    (1,10,'N','paid'), (2,20,'N','unpaid'), (3,NULL,'N','paid'),
    (4,5,'S','unpaid'), (5,7,'E',NULL);

statement ok
CREATE TABLE scoped_returns(
    source_id INTEGER PRIMARY KEY, raw_amount INTEGER, region VARCHAR
);

statement ok
INSERT INTO scoped_returns VALUES (1,3,'N'), (2,4,'S');

statement ok
ATTACH '{WEBSITE_EXAMPLE_DIR}/model.ossie.json' AS local_metrics (TYPE crossfield);

statement ok
SET crossfield_mode = 'strict';

query II
SELECT orders.revenue AS sales, returns.revenue AS refunds
FROM SEMANTIC local_metrics.scoped_sales;
----
84	7
