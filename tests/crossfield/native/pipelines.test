# Website download regression. Run from the extracted pipelines directory.
# Expected values are independently specified; native SQLLogicTest runner only.
require crossfield

require-env WEBSITE_EXAMPLE_DIR

statement ok
ATTACH '{WEBSITE_EXAMPLE_DIR}/model.crossfield.json' AS arithmetic (TYPE crossfield);

statement ok
SET crossfield_mode = 'strict';

query II
SELECT number_count, number_sum
FROM SEMANTIC arithmetic.numbers(5);
----
5	10

query II
SELECT number_count, number_sum
FROM SEMANTIC arithmetic.numbers(stop => 5);
----
5	10

query II
SELECT number_count, number_sum
FROM SEMANTIC arithmetic.numbers(seed => 4);
----
3	6

query II
SELECT number_count,number_sum FROM SEMANTIC arithmetic.numbers(seed=>1);
----
0	NULL

statement error
SELECT number_count FROM SEMANTIC arithmetic.numbers();
----
SEMANTIC_SIGNATURE_NO_MATCH
