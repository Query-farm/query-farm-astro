{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "query-farm-website",
  "compatibility_date": "2026-09-14",
  "pages_build_output_dir": "./dist",
  // Hosted Orchard (docs/orchard-hosted.md): the `orchard` D1 database.
  // Apply schema changes with `npx wrangler d1 migrations apply orchard --remote`.
  "d1_databases": [
    {
      "binding": "ORCHARD_DB",
      "database_name": "orchard",
      "database_id": "f9bc4987-3e0f-4542-8cec-b1a6a4a1097a",
      "migrations_dir": "migrations/orchard"
    }
  ]
}
