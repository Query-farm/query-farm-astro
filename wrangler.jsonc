{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "query-farm-website",
  "compatibility_date": "2026-09-14",
  "pages_build_output_dir": "./dist",
  // Hosted Orchard (docs/orchard-hosted.md). Create the database with
  //   npx wrangler d1 create orchard
  // and replace database_id below BEFORE this branch merges: a Pages deploy
  // with an unknown database_id fails.
  "d1_databases": [
    {
      "binding": "ORCHARD_DB",
      "database_name": "orchard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/orchard"
    }
  ]
}
