---
import TutorialCardArt from '../../components/tutorials/TutorialCardArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {tutorialFixtures} from '../../data/tutorial-fixtures';
export function getStaticPaths() {
  return import.meta.env.DEV || process.env.INCLUDE_DRAFTS === 'true'
    ? [{ params: { slug: 'search-tutorials' } }, {params: {slug: 'next-tutorials'}}, {params: {slug: 'practical-tutorials'}}]
    : [];
}
const posts = await getCollection('tutorials');
const reviewBatch=Astro.params.slug==='next-tutorials'?'next-ten':Astro.params.slug==='practical-tutorials'?'practical-ten':undefined;
const batchIds=new Set(tutorialFixtures.filter(tutorial=>tutorial.batch===reviewBatch).map(tutorial=>tutorial.slug));
const articles=posts.filter(post=>!reviewBatch||batchIds.has(post.id)).sort((a,b)=>(a.data.order??999)-(b.data.order??999));
---
<BaseLayout title={`${articles.length} practical SQL tutorials — editorial review`} description="Review Query.Farm tutorials with sample data, interactive illustrations, results, and checked SQL challenges." noindex>
  <main class="mx-auto max-w-6xl px-6 py-14">
    <p class="text-sm font-medium text-sun-700">Editorial review · {articles.length} drafts</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-tight md:text-5xl">Read it. Run it. Tell us what needs work.</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-soil-700">These articles are ready for human review. Each starts with visible sample data, an interactive experiment, and SQL you can change and run. Browser exercises use the site's existing Haybarn shell.</p>
    <p class="mt-4 text-sm text-soil-600">Drafts are excluded from normal production builds. Local preview traffic is excluded from Google Analytics.</p>
    {reviewBatch && <p class="mt-5 text-sm text-soil-700" data-review-scope>
      This review shows one batch of {articles.length} tutorials.
      <a href="/tutorials/" class="ml-1 font-medium text-link underline underline-offset-4">Browse the complete library — all {posts.length} tutorials →</a>
    </p>}
    <div class="mt-10 grid gap-7 lg:grid-cols-3">
      {articles.map((post, index) => (
        <article class="overflow-hidden rounded-2xl border border-soil-300 bg-white/60">
          <a href={`/tutorials/${post.id}/`} aria-label={`Review ${post.data.title}`}>
            <div class="flex h-[180px] justify-center bg-soil-100 p-3"><TutorialCardArt slug={post.id} /></div>
          </a>
          <div class="p-6">
            <p class="text-xs font-medium uppercase tracking-wider text-sun-700">Draft {index + 1} · Tutorial</p>
            <h2 class="mt-3 text-2xl leading-tight"><a href={`/tutorials/${post.id}/`} class="hover:text-link">{post.data.title}</a></h2>
            <p class="mt-4 text-sm leading-relaxed text-soil-700">{post.data.outcome}</p>
            <a href={`/tutorials/${post.id}/`} class="mt-6 inline-flex rounded-lg bg-field-700 px-4 py-2 text-sm font-medium text-white hover:bg-field-600">Open tutorial <span class="ml-2" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <section class="mt-12 max-w-3xl border-t border-soil-300 pt-7">
      <h2 class="text-2xl">What to review</h2>
      <p class="mt-3 leading-relaxed text-soil-700">Check the technical explanation, tone, and usefulness of the examples. Open a shell, edit the query, and rerun it. Every example starts independently, so you can jump to the part that interests you.</p>
      <p class="mt-3 text-sm text-soil-600">Analytics cover example launches, successful runs, edited queries, copies, data downloads, diagram interactions, reading progress, and the existing product next-step cards. SQL text and query results are not included in event payloads.</p>
    </section>
  </main>
</BaseLayout>
