---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { Icon } from 'astro-icon/components';

const HAYBARN_RC = '1.5.2-rc13';
const HAYBARN_RC_PYPI = '1.5.2rc13';
const RELEASES_URL = 'https://github.com/Query-farm-haybarn/haybarn/releases';
const STATUS_URL = 'https://haybarn-status.query.farm';

const platforms = [
  { os: 'Linux',   icon: 'simple-icons:linux',        archs: ['amd64 (glibc)', 'arm64 (glibc)', 'amd64 (musl)', 'arm64 (musl)'] },
  { os: 'macOS',   icon: 'simple-icons:apple',        archs: ['universal (arm64 + x86_64)', 'arm64', 'amd64'] },
  { os: 'Windows', icon: 'simple-icons:windows',      archs: ['amd64'] }
];

const verifyCmd = `gh attestation verify haybarn_cli-linux-amd64.zip \\
  --repo Query-farm-haybarn/haybarn`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Install Haybarn via npx, uvx, pip, or direct GitHub Releases. Builds available for Linux, macOS, and Windows with SLSA build provenance.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Install Haybarn',
    description,
    url: `${SITE_ORIGIN}/haybarn/install`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Install', item: SITE_ORIGIN + '/haybarn/install' },
    ],
  },
];
---

<PageLayout
  title="Install Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 py-12 lg:py-20">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="Install"
          title="Get Haybarn running"
          description={`Haybarn 1.5.2 is in release-candidate phase (current tag: v${HAYBARN_RC}). APIs and on-disk formats inherit from upstream DuckDB v1.5.2 and will not change between RCs.`}
        />
      </div>
    </div>
  </section>

  <!-- Install channels -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto space-y-12">

        <!-- npm / npx -->
        <div>
          <SectionHeader
            eyebrow="Channel 1"
            title="npm / npx — no install required"
            description="The fastest way to try Haybarn. npx fetches and runs the CLI in one step."
            class="mb-6"
          />
          <CodeBlock code="npx haybarn@rc" lang="bash" title="terminal" />
          <p class="text-sm text-soil-600 mt-3">
            Once <code class="font-mono text-earth-700">1.5.2</code> ships final, drop the <code class="font-mono text-earth-700">@rc</code> tag and use <code class="font-mono text-earth-700">npx haybarn</code>.
          </p>
        </div>

        <!-- uvx / pipx -->
        <div>
          <SectionHeader
            eyebrow="Channel 2"
            title="uvx / pipx — no install required"
            description="If your team is on the Python toolchain, run the CLI directly with uv or pipx."
            class="mb-6"
          />
          <CodeBlock code={`uvx haybarn-cli==${HAYBARN_RC_PYPI}\n# or\npipx run haybarn-cli==${HAYBARN_RC_PYPI}`} lang="bash" title="terminal" />
          <p class="text-sm text-soil-600 mt-3">
            <code class="font-mono text-earth-700">haybarn-cli</code> is published on PyPI on every RC release.
          </p>
        </div>

        <!-- pip -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-grain-100 text-grain-800 text-xs font-mono uppercase tracking-wider">Coming with 1.5.2 final</span>
          </div>
          <SectionHeader
            eyebrow="Channel 3"
            title="pip — the Python library"
            description="Drop-in compatible with the DuckDB Python API: import haybarn as duckdb. The library wheels are built on a 20-leg matrix and finishing their publish pipeline."
            class="mb-6"
          />
          <CodeBlock code={`# Once published:\npip install haybarn\n\n# then in Python:\nimport haybarn as duckdb\nduckdb.sql("SELECT 42").show()`} lang="bash" title="terminal" />
          <p class="text-sm text-soil-600 mt-3">
            The CLI (<code class="font-mono text-earth-700">haybarn-cli</code>) is live on PyPI today — use Channel 2 (<code class="font-mono text-earth-700">uvx</code>) until the library wheel lands.
          </p>
        </div>

        <!-- GitHub Releases -->
        <div>
          <SectionHeader
            eyebrow="Channel 4"
            title="GitHub Releases — direct download"
            description="Grab the CLI, shared library, or static library for your platform from GitHub. Every artifact ships with SHA256 checksums, a GPG signature, and SLSA build provenance."
            class="mb-6"
          />
          <div class="space-y-3">
            <Button href={RELEASES_URL} variant="primary" size="md">
              Browse Haybarn Releases on GitHub →
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform matrix -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Supported platforms"
        title="Where Haybarn runs"
        class="mb-10"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {platforms.map(p => (
          <Card padding="lg" class="text-center">
            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-2xl bg-soil-100 text-soil-800">
              <Icon name={p.icon} class="w-9 h-9" />
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-3">{p.os}</h3>
            <ul class="space-y-1.5 text-sm text-soil-700">
              {p.archs.map(a => (
                <li class="font-mono text-xs bg-white border border-soil-200 rounded px-2 py-0.5 inline-block mx-0.5">{a}</li>
              ))}
            </ul>
          </Card>
        ))}
      </div>
      <div class="mt-10 max-w-4xl mx-auto grid sm:grid-cols-2 gap-4">
        <Card padding="md" class="flex items-center gap-4">
          <Icon name="simple-icons:python" class="w-8 h-8 text-soil-700 flex-shrink-0" />
          <div>
            <h4 class="text-sm font-semibold text-soil-900">Python wheels</h4>
            <p class="text-xs text-soil-600 leading-snug">20-leg matrix · Python 3.10–3.14 across Linux (incl. ARM, musl), macOS, Windows.</p>
          </div>
        </Card>
        <Card padding="md" class="flex items-center gap-4">
          <Icon name="simple-icons:nodedotjs" class="w-8 h-8 text-soil-700 flex-shrink-0" />
          <div>
            <h4 class="text-sm font-semibold text-soil-900">Node bindings</h4>
            <p class="text-xs text-soil-600 leading-snug">macOS (arm64 / x64), Linux (arm64 / x64, glibc + musl), Windows (arm64 / x64).</p>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Provenance verification -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="Supply-chain transparency"
          title="Verify a build with SLSA provenance"
          description="Every release artifact has a build provenance attestation signed by GitHub. Verify any download in one command with the GitHub CLI."
          class="mb-6"
        />
        <CodeBlock code={verifyCmd} lang="bash" title="verify-release.sh" />
        <p class="text-sm text-soil-600 mt-4 text-center">
          Releases are hosted on Cloudflare R2 with immutable, version-keyed URLs.
          <a href="/haybarn/status/v1.5.2" class="text-earth-700 underline hover:text-earth-800">Build status</a> ·
          <a href={STATUS_URL} class="text-earth-700 underline hover:text-earth-800">Live dashboard</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Extensions teaser -->
  <section class="py-12 lg:py-16 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <Card padding="lg">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-grain-100 text-grain-800 text-xs font-mono uppercase tracking-wider">Roadmap</span>
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-2">Extensions are getting the same treatment</h3>
          <p class="text-soil-700 text-sm leading-relaxed mb-4">
            Every Haybarn-built extension is on its way to PyPI and npm — pinnable in <code class="font-mono text-earth-700">requirements.txt</code> and <code class="font-mono text-earth-700">package.json</code>, mirrorable to your internal registry, reviewable through the supply-chain process you already have.
          </p>
          <Button href="/haybarn/extensions" variant="primary" size="md">
            Read the extensions plan →
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Need help rolling Haybarn out?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Pinning versions, mirroring extensions internally, or wiring up a private signing chain — we've done it.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">
          Consulting
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
