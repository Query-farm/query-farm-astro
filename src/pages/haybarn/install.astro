---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_RC_PYPI, LATEST_DUCKDB_VERSION } from '../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_RC_PYPI = LATEST_RC_PYPI;
const RELEASES_URL = 'https://github.com/Query-farm-haybarn/haybarn/releases';
const STATUS_URL = 'https://haybarn-status.query.farm';

const verifyCmd = `gh attestation verify haybarn_cli-linux-amd64.zip \\
  --repo Query-farm-haybarn/haybarn`;

const npmStart = `# Start Haybarn
npx haybarn@rc

# Or run one query and exit
npx haybarn@rc -c "SELECT version();"`;

const pypiStart = `# Start Haybarn
uvx haybarn-cli==${HAYBARN_RC_PYPI}

# Or run one query and exit
uvx haybarn-cli==${HAYBARN_RC_PYPI} -c "SELECT version();"`;

const haybarnShell = `-- Run this after Haybarn opens at the memory H prompt.
SELECT 42 AS answer;

-- Try h3, a community extension for H3 geospatial indexing.
INSTALL h3 FROM community;
LOAD h3;

SELECT h3_latlng_to_cell(37.7887, -122.3931, 9);`;

// What Haybarn produces and where to get it. Status reflects current
// availability — "in progress" / "planned" items are wired in CI but not yet
// published for general install.
const ships = [
  { artifact: 'CLI', name: 'haybarn', channel: 'npm · PyPI · GitHub Releases', status: 'Available' },
  { artifact: 'Shared library', name: 'libhaybarn.{so,dylib,dll}', channel: 'GitHub Releases', status: 'Available' },
  { artifact: 'Static library', name: 'libhaybarn_static.a', channel: 'GitHub Releases', status: 'Available' },
  { artifact: 'Core extensions', name: 'Haybarn-signed', channel: 'Haybarn channel · npm', status: 'Available' },
  { artifact: 'Community extensions', name: 'rebuilt & signed', channel: 'Haybarn channel · npm', status: 'Available' },
  { artifact: 'Python library', name: 'haybarn', channel: 'PyPI', status: 'In progress' },
  { artifact: 'Node bindings', name: '@haybarn/node-neo', channel: 'npm', status: 'Planned' },
  { artifact: 'JDBC driver', name: 'haybarn-jdbc', channel: 'Maven', status: 'Planned' },
  { artifact: 'WebAssembly', name: 'haybarn-wasm', channel: 'tracked on status', status: 'In development' },
];
function shipStatusClass(s: string): string {
  switch (s) {
    case 'Available': return 'bg-green-100 text-green-800 ring-green-300';
    case 'Planned':   return 'bg-soil-100 text-soil-700 ring-soil-300';
    default:          return 'bg-amber-100 text-amber-800 ring-amber-300';
  }
}

// Engine / CLI build targets. Signed extensions additionally build for Wasm.
const platforms = [
  { os: 'Linux', arches: ['x86-64 · glibc', 'ARM64 · glibc', 'x86-64 · musl', 'ARM64 · musl'] },
  { os: 'macOS', arches: ['Apple Silicon', 'Intel', 'Universal'] },
  { os: 'Windows', arches: ['x86-64'] },
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Install Haybarn through npm, PyPI, or GitHub Releases. Run the DuckDB-compatible CLI with reviewable release artifacts for Linux, macOS, and Windows.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Install Haybarn',
    description,
    url: `${SITE_ORIGIN}/haybarn/install`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Install', item: SITE_ORIGIN + '/haybarn/install' },
    ],
  },
];
---

<PageLayout
  title="Install Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-12 font-display lg:py-20">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="Install"
          title="Install Haybarn"
          description={`Run the DuckDB-compatible CLI through npm, PyPI, or GitHub Releases. Same SQL and database files, with release artifacts your team can review.`}
        />
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-grain-500"></span>
          Haybarn v{HAYBARN_RC} · release candidate for DuckDB v{LATEST_DUCKDB_VERSION}
        </div>
      </div>
    </div>
  </section>

  <!-- Quickstart -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-lg md:p-8">
          <SectionHeader
            eyebrow="Quickstart"
            title="Run Haybarn without a global install"
            description="Use npx or uvx to fetch and run the CLI temporarily, then try normal DuckDB SQL plus a rebuilt community extension."
            class="mb-6"
          />
          <div class="grid gap-6">
            <CodeBlock code={npmStart} lang="bash" title="terminal · npm" />
            <CodeBlock code={pypiStart} lang="bash" title="terminal · PyPI" />
            <CodeBlock code={haybarnShell} lang="sql" title="Haybarn shell" />
          </div>
          <p class="mt-4 text-sm leading-relaxed text-soil-600">
            On the first <code class="font-mono text-earth-700">npx</code> run, npm may ask for permission to fetch <code class="font-mono text-earth-700">haybarn@rc</code>. After Haybarn starts, run SQL at the <code class="font-mono text-earth-700">memory H</code> prompt.
          </p>
          <p class="mt-5 text-sm leading-relaxed text-soil-600">
            Once <code class="font-mono text-earth-700">{LATEST_DUCKDB_VERSION}</code> ships final, drop the <code class="font-mono text-earth-700">@rc</code> and pinned RC suffixes.
          </p>
        </div>

        <div class="mt-10">
          <SectionHeader
            align="center"
            eyebrow="Install paths"
            title="Choose the path that fits your workflow"
            class="mb-8"
          />
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {[
              ['npm / npx', '', 'Best for Node-oriented teams and quick CLI trials.', 'npx haybarn@rc', 'code'],
              ['uvx', '', 'Best for Python-oriented teams that want a temporary CLI runner.', `uvx haybarn-cli==${HAYBARN_RC_PYPI}`, 'code'],
              ['Direct downloads', '', 'Download the CLI, shared library, or static library for your platform from GitHub Releases.', RELEASES_URL, 'link'],
              ['Python library', 'Coming soon', 'Drop-in compatible with the DuckDB Python API once the library publish pipeline is live.', 'import haybarn as duckdb', 'code'],
            ].map(([title, badge, copy, value, kind]) => (
              <div class="rounded-xl border-2 border-soil-900 bg-grain-50 p-5 shadow-sm">
                <div class="flex items-center gap-2">
                  <h3 class="font-bold text-soil-900">{title}</h3>
                  {badge && (
                    <span class="rounded-md bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-harvest-700 ring-1 ring-soil-200">
                      {badge}
                    </span>
                  )}
                </div>
                <p class="mt-2 text-sm leading-relaxed text-soil-700">{copy}</p>
                {kind === 'link' ? (
                  <div class="group relative mt-4 inline-flex">
                    <a href={value} class="inline-flex rounded-lg border border-soil-900 bg-white px-3 py-2 text-xs font-bold text-soil-900 transition-colors hover:bg-grain-100">
                      Open GitHub Releases
                    </a>
                    <div class="pointer-events-none absolute left-0 top-full z-20 mt-2 w-64 rounded-lg border border-soil-900 bg-white p-3 text-xs leading-relaxed text-soil-700 opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                      Download the artifact for your platform, unzip it, then run the <code class="font-mono text-earth-700">haybarn</code> binary.
                    </div>
                  </div>
                ) : (
                  <p class="mt-4 rounded-lg border border-soil-200 bg-white px-3 py-2 font-mono text-xs text-earth-700">{value}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Haybarn ships -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="What you get"
          title="Everything Haybarn ships"
          description="The CLI, libraries, and signed extensions are available today. Language bindings are rolling out — track them on the status page."
          class="mb-8"
        />
        <div class="overflow-hidden rounded-2xl border-2 border-soil-900 shadow-sm">
          <table class="w-full text-sm bg-white">
            <thead class="bg-soil-100 text-soil-900 text-left">
              <tr>
                <th class="px-4 py-3 font-semibold">Artifact</th>
                <th class="px-4 py-3 font-semibold">Name</th>
                <th class="px-4 py-3 font-semibold">Where</th>
                <th class="px-4 py-3 font-semibold text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-soil-200">
              {ships.map(s => (
                <tr>
                  <td class="px-4 py-2.5 font-bold text-soil-900">{s.artifact}</td>
                  <td class="px-4 py-2.5"><code class="font-mono text-xs text-earth-700">{s.name}</code></td>
                  <td class="px-4 py-2.5 text-soil-600 text-xs">{s.channel}</td>
                  <td class="px-4 py-2.5 text-right">
                    <span class={`inline-flex rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ring-1 ${shipStatusClass(s.status)}`}>{s.status}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-bold uppercase tracking-wider text-soil-900 mb-4 text-center">Supported platforms</h3>
          <div class="grid gap-4 sm:grid-cols-3 max-w-3xl mx-auto">
            {platforms.map(p => (
              <div class="rounded-xl border-2 border-soil-900 bg-white p-4 shadow-sm">
                <p class="font-bold text-soil-900 mb-2">{p.os}</p>
                <ul class="space-y-1">
                  {p.arches.map(a => <li class="font-mono text-xs text-soil-700">{a}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <p class="text-xs text-soil-500 text-center mt-4">
            Signed extensions additionally build for WebAssembly. Per-platform build status is on the <a href={LATEST_STATUS_URL} class="text-earth-700 underline hover:text-earth-800">status page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Verify -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="Optional for teams"
          title="Verify release artifacts"
          description="For casual local use, you can skip this. For production rollouts, Haybarn release artifacts include checksums, signatures, and GitHub build attestations so teams can review where a binary came from."
          class="mb-6"
        />
        <CodeBlock code={verifyCmd} lang="bash" title="verify-release.sh" />
        <p class="mt-3 text-center text-sm text-soil-600">
          Full signing keys and verification steps on the <a href="/haybarn/security" class="text-earth-700 underline hover:text-earth-800">security page</a>.
        </p>
        <p class="mt-3 text-center text-xs text-soil-500">
          Replace the filename with the artifact you downloaded.
        </p>
        <p class="text-sm text-soil-600 mt-4 text-center">
          <a href={LATEST_STATUS_URL} class="text-earth-700 underline hover:text-earth-800">Build status</a> ·
          <a href={STATUS_URL} class="text-earth-700 underline hover:text-earth-800">Live dashboard</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-harvest-700">Expert help</p>
          <h2 class="mb-4 text-3xl font-bold text-soil-900 md:text-4xl">
            Need help rolling Haybarn out?
          </h2>
          <p class="text-lg leading-relaxed text-soil-700">
            We help teams with version pinning, internal mirrors, private extension channels, and production rollout.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href="/consulting" variant="primary" size="md">
            Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a call
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
