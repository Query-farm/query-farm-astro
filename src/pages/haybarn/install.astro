---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_RC_PYPI, LATEST_DUCKDB_VERSION } from '../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_RC_PYPI = LATEST_RC_PYPI;
const RELEASES_URL = 'https://github.com/Query-farm-haybarn/haybarn/releases';
const STATUS_URL = 'https://haybarn-status.query.farm';

const verifyCmd = `gh attestation verify haybarn_cli-linux-amd64.zip \\
  --repo Query-farm-haybarn/haybarn`;

const npmStart = `# Start Haybarn
npx haybarn@rc

# Or run one query and exit
npx haybarn@rc -c "SELECT version();"`;

const pypiStart = `# Start Haybarn
uvx haybarn-cli==${HAYBARN_RC_PYPI}

# Or run one query and exit
uvx haybarn-cli==${HAYBARN_RC_PYPI} -c "SELECT version();"`;

const haybarnShell = `-- Run this after Haybarn opens at the memory H prompt.
SELECT 42 AS answer;

-- Try h3, a community extension for H3 geospatial indexing.
INSTALL h3 FROM community;
LOAD h3;

SELECT h3_latlng_to_cell(37.7887, -122.3931, 9);`;

// What Haybarn produces and where to get it. Status reflects current
// availability — "in progress" / "planned" items are wired in CI but not yet
// published for general install.
const ships = [
  { artifact: 'CLI', name: 'haybarn', channel: 'npm · PyPI · GitHub Releases', status: 'Available' },
  { artifact: 'Shared library', name: 'libhaybarn.{so,dylib,dll}', channel: 'GitHub Releases', status: 'Available' },
  { artifact: 'Static library', name: 'libhaybarn_static.a', channel: 'GitHub Releases', status: 'Available' },
  { artifact: 'Core extensions', name: 'Haybarn-signed', channel: 'Haybarn channel · npm', status: 'Available' },
  { artifact: 'Community extensions', name: 'rebuilt & signed', channel: 'Haybarn channel · npm', status: 'Available' },
  { artifact: 'Python library', name: 'haybarn', channel: 'PyPI', status: 'In progress' },
  { artifact: 'Node bindings', name: '@haybarn/node-neo', channel: 'npm', status: 'Planned' },
  { artifact: 'JDBC driver', name: 'haybarn-jdbc', channel: 'Maven', status: 'Planned' },
  { artifact: 'WebAssembly', name: 'haybarn-wasm', channel: 'tracked on status', status: 'In development' },
];

// Status pills (spec: available → field, in progress/development → sun,
// planned → neutral).
const PILL = 'inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium';
function shipStatusClass(s: string): string {
  switch (s) {
    case 'Available': return `${PILL} border-field-600/45 bg-field-600/10 text-field-700`;
    case 'Planned':   return `${PILL} border-soil-300 text-soil-700`;
    default:          return `${PILL} border-sun-400 bg-sun-400/12 text-sun-700`;
  }
}

// Engine / CLI build targets. Signed extensions additionally build for Wasm.
const platforms = [
  { os: 'Linux', arches: ['x86-64 · glibc', 'ARM64 · glibc', 'x86-64 · musl', 'ARM64 · musl'] },
  { os: 'macOS', arches: ['Apple Silicon', 'Intel', 'Universal'] },
  { os: 'Windows', arches: ['x86-64'] },
];

const installPaths: [string, string, string, string, 'code' | 'link'][] = [
  ['npm / npx', '', 'Best for Node-oriented teams and quick CLI trials.', 'npx haybarn@rc', 'code'],
  ['uvx', '', 'Best for Python-oriented teams that want a temporary CLI runner.', `uvx haybarn-cli==${HAYBARN_RC_PYPI}`, 'code'],
  ['Direct downloads', '', 'Download the CLI, shared library, or static library for your platform from GitHub Releases.', RELEASES_URL, 'link'],
  ['Python library', 'Coming soon', 'Drop-in compatible with the DuckDB Python API once the library publish pipeline is live.', 'import haybarn as duckdb', 'code'],
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Install Haybarn through npm, PyPI, or GitHub Releases. Run the DuckDB-compatible CLI with reviewable release artifacts for Linux, macOS, and Windows.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Install Haybarn',
    description,
    url: `${SITE_ORIGIN}/haybarn/install`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Install', item: SITE_ORIGIN + '/haybarn/install' },
    ],
  },
];

// ── Shared shape vocabulary (family C: docs / reference — no bands) ──
const WRAP_WIDE = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const H2_FIRST = 'scroll-mt-32 text-2xl md:text-3xl text-soil-900';
const H2 = 'mt-11 scroll-mt-32 border-t border-soil-300 pt-6 text-2xl md:text-3xl text-soil-900';
const BODY = 'text-soil-700 leading-relaxed';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';
const NAV_LINK = 'block border-l-2 border-soil-200 px-2.5 py-1 text-sm text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
const NAV_LINK_ON = 'block border-l-2 border-link bg-link/8 px-2.5 py-1 text-sm text-link no-underline transition';
const TOC_LINK = 'block border-l-2 border-soil-200 px-2.5 py-1 text-[13px] text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
const TH = 'border-b border-soil-300 bg-[#fbf7ee] px-3.5 py-2.5 text-left text-[12.5px] font-semibold text-soil-700';
const TH_R = 'border-b border-soil-300 bg-[#fbf7ee] px-3.5 py-2.5 text-right text-[12.5px] font-semibold text-soil-700';

const sectionNav: [string, string][] = [
  ['Overview', '/haybarn'],
  ['Install', '/haybarn/install'],
  ['Security', '/haybarn/security'],
  ['Extensions', '/haybarn/extensions'],
  ['Build status', LATEST_STATUS_URL],
  ['Contribute', '/haybarn/community-extensions'],
  ['Compatibility & FAQ', '/haybarn/compatibility'],
];
const CURRENT = '/haybarn/install';

const toc: [string, string][] = [
  ['Quickstart', '#quickstart'],
  ['Install paths', '#paths'],
  ['What Haybarn ships', '#ships'],
  ['Supported platforms', '#platforms'],
  ['Verify release artifacts', '#verify'],
  ['Rolling it out', '#help'],
];
---

<PageLayout
  title="Install Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Install"
    title="Install Haybarn"
    icon={{ src: '/haybarn/haybarn-logo.png' }}
    lede="Run the DuckDB-compatible CLI through npm, PyPI, or GitHub Releases. Same SQL and database files, with release artifacts your team can review."
  >
    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">v{HAYBARN_RC}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">
        Release candidate · DuckDB v{LATEST_DUCKDB_VERSION}
      </div>
    </Fragment>
  </PageHead>

  <!-- ── Docs grid: section nav / content / page TOC ──────────── -->
  <div class={`${WRAP_WIDE} grid gap-10 py-10 lg:grid-cols-[220px_minmax(0,1fr)_200px] lg:gap-11`}>
    <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto">
      <nav aria-label="Haybarn documentation">
        <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">In this section</h2>
        <ul class="flex flex-col gap-0.5">
          {sectionNav.map(([name, href]) => (
            <li>
              <a
                href={href}
                class={href === CURRENT ? NAV_LINK_ON : NAV_LINK}
                aria-current={href === CURRENT ? 'page' : undefined}
              >{name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="min-w-0">
      <h2 id="quickstart" class={H2_FIRST}>Run Haybarn without a global install</h2>
      <p class={`mt-3 ${BODY}`}>
        Use <code class={CODE}>npx</code> or <code class={CODE}>uvx</code> to fetch and run the CLI
        temporarily, then try normal DuckDB SQL plus a rebuilt community extension.
      </p>

      <div class="mt-6 grid gap-6">
        <CodeBlock code={npmStart} lang="bash" title="terminal · npm" />
        <CodeBlock code={pypiStart} lang="bash" title="terminal · PyPI" />
        <CodeBlock code={haybarnShell} lang="sql" title="Haybarn shell" />
      </div>

      <p class={`mt-5 text-sm ${BODY}`}>
        On the first <code class={CODE}>npx</code> run, npm may ask for permission to fetch
        <code class={CODE}>haybarn@rc</code>. After Haybarn starts, run SQL at the
        <code class={CODE}>memory H</code> prompt.
      </p>
      <p class={`mt-3 text-sm ${BODY}`}>
        Once <code class={CODE}>{LATEST_DUCKDB_VERSION}</code> ships final, drop the
        <code class={CODE}>@rc</code> and pinned RC suffixes.
      </p>

      <h2 id="paths" class={H2}>Choose the path that fits your workflow</h2>
      <div class="mt-6 grid gap-3.5 sm:grid-cols-2">
        {installPaths.map(([title, badge, copy, value, kind]) => (
          <div class={`${CARD} p-5`}>
            <div class="flex flex-wrap items-center gap-2.5">
              <h3 class="text-lg text-soil-900">{title}</h3>
              {badge && (
                <span class="inline-block rounded-full border border-sun-400 bg-sun-400/12 px-2.5 py-0.5 text-[12.5px] font-medium text-sun-700">
                  {badge}
                </span>
              )}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{copy}</p>
            {kind === 'link' ? (
              <div class="mt-4">
                <Button href={value} variant="secondary" size="sm">Open GitHub Releases</Button>
                <p class="mt-2.5 text-xs leading-relaxed text-soil-700">
                  Download the artifact for your platform, unzip it, then run the
                  <code class={CODE}>haybarn</code> binary.
                </p>
              </div>
            ) : (
              <p class="mt-4 rounded-lg border border-soil-300 bg-soil-100 px-3 py-2 font-mono text-xs text-soil-900">{value}</p>
            )}
          </div>
        ))}
      </div>

      <h2 id="ships" class={H2}>Everything Haybarn ships</h2>
      <p class={`mt-3 ${BODY}`}>
        The CLI, libraries, and signed extensions are available today. Language bindings are
        rolling out — track them on the status page.
      </p>

      <div class="mt-6 overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
        <table class="w-full border-collapse text-[14.5px]">
          <thead>
            <tr>
              <th class={TH}>Artifact</th>
              <th class={TH}>Name</th>
              <th class={TH}>Where</th>
              <th class={TH_R}>Status</th>
            </tr>
          </thead>
          <tbody>
            {ships.map(s => (
              <tr class="border-b border-soil-200 last:border-0 hover:bg-[#fbf7ee]">
                <td class="px-3.5 py-2.5 text-soil-900">{s.artifact}</td>
                <td class="px-3.5 py-2.5"><code class="font-mono text-xs text-soil-700">{s.name}</code></td>
                <td class="px-3.5 py-2.5 text-xs text-soil-700">{s.channel}</td>
                <td class="px-3.5 py-2.5 text-right"><span class={shipStatusClass(s.status)}>{s.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="platforms" class={H2}>Supported platforms</h2>
      <div class="mt-6 overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
        <table class="w-full border-collapse text-[14.5px]">
          <thead>
            <tr>
              <th class={TH}>Platform</th>
              <th class={TH}>Build targets</th>
            </tr>
          </thead>
          <tbody>
            {platforms.map(p => (
              <tr class="border-b border-soil-200 last:border-0 hover:bg-[#fbf7ee]">
                <td class="px-3.5 py-2.5 text-soil-900">{p.os}</td>
                <td class="px-3.5 py-2.5 font-mono text-xs text-soil-700">{p.arches.join(' · ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-soil-700">
        Signed extensions additionally build for WebAssembly. Per-platform build status is on the
        <a href={LATEST_STATUS_URL} class={LINK}>status page</a>.
      </p>

      <h2 id="verify" class={H2}>Verify release artifacts</h2>
      <p class={`mt-3 ${BODY}`}>
        For casual local use, you can skip this. For production rollouts, Haybarn release
        artifacts include checksums, signatures, and GitHub build attestations so teams can
        review where a binary came from.
      </p>
      <div class="mt-6">
        <CodeBlock code={verifyCmd} lang="bash" title="verify-release.sh" />
      </div>
      <p class="mt-3 text-sm leading-relaxed text-soil-700">
        Full signing keys and verification steps on the
        <a href="/haybarn/security" class={LINK}>security page</a>.
      </p>
      <p class="mt-2 text-xs leading-relaxed text-soil-700">
        Replace the filename with the artifact you downloaded.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-soil-700">
        <a href={LATEST_STATUS_URL} class={LINK}>Build status</a> ·
        <a href={STATUS_URL} class={LINK}>Live dashboard</a>
      </p>

      <h2 id="help" class={H2}>Need help rolling Haybarn out?</h2>
      <div class={`mt-6 ${CARD} px-6 py-6`}>
        <span class={EYEBROW}>Expert help</span>
        <p class={`mt-3 max-w-[62ch] ${BODY}`}>
          We help teams with version pinning, internal mirrors, private extension channels, and
          production rollout.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>

    <aside class="hidden xl:block xl:sticky xl:top-24 xl:self-start">
      <nav aria-label="On this page">
        <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">On this page</h2>
        <ul class="flex flex-col gap-0.5">
          {toc.map(([name, href]) => (
            <li><a href={href} class={TOC_LINK}>{name}</a></li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>
</PageLayout>
