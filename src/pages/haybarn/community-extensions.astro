---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';

const upstreamRepo = 'https://github.com/duckdb/community-extensions';
const haybarnMirrorRepo = 'https://github.com/Query-farm-haybarn/haybarn-community-extensions';

const descriptorYaml = `extension:
  name: my_extension
  description: One-line summary
  version: 0.1.0
  language: C++
  build: cmake
  license: MIT
  maintainers:
    - your-gh-handle

repo:
  github: owner/repo
  ref: <commit-sha>`;

const haybarnOverride = `# Only needed if upstream code doesn't build against
# the Haybarn engine without a patch.
repo:
  github: owner/repo
  ref:    <commit-sha>
  haybarn_fork: Query-farm-haybarn/your-fork
  haybarn_ref:  <commit-sha>`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Your DuckDB community extension already works on Haybarn. The Haybarn community-extensions catalog is a mirror of duckdb/community-extensions — when an extension lands upstream, Haybarn rebuilds it automatically, signs it with the Haybarn key, and publishes it.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Get a community extension into Haybarn',
    description,
    url: `${SITE_ORIGIN}/haybarn/community-extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Community extensions', item: SITE_ORIGIN + '/haybarn/community-extensions' },
    ],
  },
];
---

<PageLayout
  title="Get a community extension into Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 py-12 lg:py-20">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="Community extensions"
          title="Two ways to ship an extension on Haybarn"
          description="Submit to upstream and Haybarn's mirror builds it automatically — same review, two distributions. Or submit directly to Haybarn's catalog when you want to iterate on a Haybarn-specific variant, ship something upstream hasn't taken, or land an update without waiting for the upstream review queue. Same descriptor schema either way."
        />
      </div>
    </div>
  </section>

  <!-- Two paths -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="Two paths in"
          title="Submit to upstream, or submit to Haybarn directly"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-8">
          Most extensions ship through upstream because <code class="font-mono">duckdb/community-extensions</code> reaches DuckDB <em>and</em> Haybarn users with one PR. But if you have a reason to ship through Haybarn alone — an extension upstream isn't ready to accept yet, a Haybarn-specific variant, or an update you want out before the upstream queue clears — you can. The descriptor schema is identical; Haybarn just adds two optional fields for the patch-stack cases.
        </p>

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <Card padding="lg">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono uppercase tracking-wider text-soil-500">Path A · default</span>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Submit upstream</h3>
            <p class="text-sm text-soil-700 leading-relaxed mb-4">
              Open a PR against <a href={upstreamRepo} class="text-earth-700 underline hover:text-earth-800"><code class="font-mono">duckdb/community-extensions</code></a> adding <code class="font-mono text-earth-700">extensions/&lt;name&gt;/description.yml</code>. Once merged, Haybarn's mirror picks it up automatically — you ship to both worlds with one review.
            </p>
            <p class="text-xs text-soil-500">
              Best for: extensions that fit upstream's review bar and audience.
            </p>
          </Card>
          <Card padding="lg">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono uppercase tracking-wider text-soil-500">Path B · Haybarn-only</span>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Submit to Haybarn directly</h3>
            <p class="text-sm text-soil-700 leading-relaxed mb-4">
              Open a PR against <a href={haybarnMirrorRepo} class="text-earth-700 underline hover:text-earth-800"><code class="font-mono">Query-farm-haybarn/haybarn-community-extensions</code></a> with the same <code class="font-mono text-earth-700">extensions/&lt;name&gt;/description.yml</code> file. Same schema. The extension reaches Haybarn users on the next build, with no upstream dependency.
            </p>
            <p class="text-xs text-soil-500">
              Best for: ships you want now, Haybarn-specific variants, or extensions upstream hasn't taken yet.
            </p>
          </Card>
        </div>

        <h3 class="text-sm font-semibold text-soil-900 uppercase tracking-wider mb-3">Minimum descriptor (same shape in either repo)</h3>
        <CodeBlock code={descriptorYaml} lang="yaml" title="extensions/my_extension/description.yml" />
        <p class="text-sm text-soil-600 mt-3 leading-relaxed">
          Optional fields (<code class="font-mono text-earth-700">excluded_platforms</code>, <code class="font-mono text-earth-700">requires_toolchains</code>, <code class="font-mono text-earth-700">vcpkg_url</code>, etc.) work identically to upstream's schema, which is documented at <a href={upstreamRepo} class="text-earth-700 underline hover:text-earth-800">duckdb/community-extensions</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- How the mirror works -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="What Haybarn does"
          title="The mirror, in three steps"
          class="mb-10"
        />

        <div class="space-y-4">
          <Card padding="lg" class="flex gap-6">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-earth-100 text-earth-700 flex items-center justify-center font-bold">1</div>
            <div>
              <h3 class="font-bold text-soil-900 mb-2">Pick up descriptors</h3>
              <p class="text-sm text-soil-700 leading-relaxed">
                Either a scheduled sync job lifts new and changed descriptors from <code class="font-mono text-earth-700">duckdb/community-extensions</code> into the Haybarn mirror (Path A), or you open a PR directly against the Haybarn repo (Path B). Either way the result is the same: a descriptor sitting in <code class="font-mono text-earth-700">extensions/&lt;name&gt;/description.yml</code> ready to build.
              </p>
            </div>
          </Card>
          <Card padding="lg" class="flex gap-6">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-earth-100 text-earth-700 flex items-center justify-center font-bold">2</div>
            <div>
              <h3 class="font-bold text-soil-900 mb-2">Build against the Haybarn engine</h3>
              <p class="text-sm text-soil-700 leading-relaxed">
                On merge, CI uses the same 12-platform matrix as the rest of the Haybarn build pipeline — Linux (glibc and musl, amd64 + arm64), macOS (Intel + Apple silicon), Windows, WebAssembly — pinned to the exact upstream commit your descriptor specifies. Build inputs and toolchains match upstream conventions.
              </p>
            </div>
          </Card>
          <Card padding="lg" class="flex gap-6">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-earth-100 text-earth-700 flex items-center justify-center font-bold">3</div>
            <div>
              <h3 class="font-bold text-soil-900 mb-2">Sign, publish, ship together</h3>
              <p class="text-sm text-soil-700 leading-relaxed">
                Each built binary is signed with the Haybarn RSA key (same mechanism DuckDB uses, different key) and published to the Haybarn community channel. When we cut a Haybarn engine release, we work to have common community extensions built and available alongside it — and we reach out to maintainers if a previously-working build starts failing.
              </p>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Escape hatches -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="When Haybarn's patch stack diverges from upstream"
          title="Optional Haybarn-side overrides"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-4">
          The Haybarn engine carries a small patch stack on top of upstream DuckDB. For the rare extension where the upstream source needs an adjustment to build against that stack, the descriptor accepts two optional fields to point Haybarn at a fork carrying the patch:
        </p>

        <CodeBlock code={haybarnOverride} lang="yaml" title="extensions/my_extension/description.yml (Haybarn fork override)" />

        <p class="text-sm text-soil-600 mt-3 leading-relaxed mb-6">
          When both <code class="font-mono text-earth-700">haybarn_fork</code> and <code class="font-mono text-earth-700">haybarn_ref</code> are set, the Haybarn build uses your fork (typically a small patch on top of upstream) instead of <code class="font-mono text-earth-700">repo.github</code> + <code class="font-mono text-earth-700">repo.ref</code>. The upstream descriptor is untouched — the Haybarn fields only apply to the Haybarn build pipeline.
        </p>
        <p class="text-sm text-soil-600 leading-relaxed">
          For most extensions you'll never need this. It's the escape hatch for the edge cases, not the path.
        </p>
      </div>
    </div>
  </section>

  <!-- Status + repo links -->
  <section class="py-12 lg:py-16 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        <Card padding="lg">
          <h3 class="text-xl font-bold text-soil-900 mb-2">See what's already there</h3>
          <p class="text-sm text-soil-700 leading-relaxed mb-4">
            Build status for every community extension Haybarn rebuilds against the current engine RC.
          </p>
          <Button href="/haybarn/status/v1.5.2" variant="primary" size="md">Build status →</Button>
        </Card>
        <Card padding="lg">
          <h3 class="text-xl font-bold text-soil-900 mb-2">The Haybarn mirror repo</h3>
          <p class="text-sm text-soil-700 leading-relaxed mb-4">
            CI workflows, descriptor schema, sync job, and the Haybarn override fields documented in README.
          </p>
          <Button href={haybarnMirrorRepo} variant="secondary" size="md">View on GitHub →</Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Shipping a DuckDB extension?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        We help maintainers get extensions across the line — vcpkg conflicts, platform-specific build failures, signing, and the long tail of CI quirks.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">
          Consulting
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
