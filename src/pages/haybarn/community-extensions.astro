---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL } from '../../data/haybarn-versions';

const upstreamRepo = 'https://github.com/duckdb/community-extensions';
const haybarnMirrorRepo = 'https://github.com/Query-farm-haybarn/haybarn-community-extensions';

const descriptorYaml = `extension:
  name: my_extension
  description: One-line summary
  version: 0.1.0
  language: C++
  build: cmake
  license: MIT
  maintainers:
    - your-gh-handle

repo:
  github: owner/repo
  ref: <commit-sha>`;

const haybarnOverride = `# Only if upstream code needs a patch to build
# against the Haybarn engine.
repo:
  github: owner/repo
  ref:    <commit-sha>
  haybarn_fork: Query-farm-haybarn/your-fork
  haybarn_ref:  <commit-sha>`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Your DuckDB community extension already works on Haybarn. Submit upstream and Haybarn rebuilds and signs it automatically, or submit to Haybarn\'s mirror directly. Same descriptor either way.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Get a community extension into Haybarn',
    description,
    url: `${SITE_ORIGIN}/haybarn/community-extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Community extensions', item: SITE_ORIGIN + '/haybarn/community-extensions' },
    ],
  },
];
---

<PageLayout
  title="Get a community extension into Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-12 font-display lg:py-20">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-grain-500"></span>
          Contribute an extension
        </div>
        <h1 class="text-4xl font-extrabold leading-[1.05] text-soil-900 md:text-5xl">
          Get your extension into Haybarn.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-soil-700 md:text-xl">
          It already builds against the Haybarn engine unchanged. Submit upstream and Haybarn rebuilds it automatically — or submit to Haybarn's mirror directly. Same descriptor either way.
        </p>
      </div>
    </div>
  </section>

  <!-- Two paths -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto max-w-5xl">
        <SectionHeader
          eyebrow="Two ways in"
          title="Submit upstream, or to Haybarn directly"
          class="mb-8"
        />

        <div class="grid gap-4 md:grid-cols-2 mb-10">
          <div class="rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-harvest-700">Path A · default</span>
            <h3 class="mt-2 text-xl font-bold text-soil-900">Submit upstream</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">
              Open a PR on <a href={upstreamRepo} target="_blank" rel="noopener" class="text-earth-700 underline hover:text-earth-800"><code class="font-mono">duckdb/community-extensions</code></a>. Once merged, Haybarn's mirror rebuilds it automatically — one review, both engines.
            </p>
          </div>
          <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-harvest-700">Path B · Haybarn-only</span>
            <h3 class="mt-2 text-xl font-bold text-soil-900">Submit to Haybarn</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">
              Open a PR on <a href={haybarnMirrorRepo} target="_blank" rel="noopener" class="text-earth-700 underline hover:text-earth-800"><code class="font-mono">haybarn-community-extensions</code></a> with the same file. Ships on the next build, no upstream wait — for Haybarn-specific variants or extensions upstream hasn't taken.
            </p>
          </div>
        </div>

        <h3 class="text-sm font-bold uppercase tracking-wider text-soil-900 mb-3">The descriptor — identical in either repo</h3>
        <CodeBlock code={descriptorYaml} lang="yaml" title="extensions/my_extension/description.yml" />
        <p class="text-sm text-soil-600 mt-3 leading-relaxed">
          Optional fields (<code class="font-mono text-earth-700">excluded_platforms</code>, <code class="font-mono text-earth-700">vcpkg_url</code>, …) match <a href={upstreamRepo} target="_blank" rel="noopener" class="text-earth-700 underline hover:text-earth-800">upstream's schema</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- What Haybarn does -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <div class="mx-auto max-w-5xl">
        <SectionHeader
          eyebrow="What Haybarn does"
          title="Rebuilt, signed, shipped"
          class="mb-8"
        />
        <div class="grid gap-4 md:grid-cols-3">
          {[
            ['1', 'Rebuild', 'Builds against the Haybarn engine on a 12-platform matrix — Linux (glibc + musl, amd64 + arm64), macOS, Windows, Wasm — pinned to your commit.'],
            ['2', 'Sign', 'Each binary is signed with the Haybarn key. Same mechanism as DuckDB, different key.'],
            ['3', 'Ship', 'Published to the Haybarn community channel alongside each engine release.'],
          ].map(([n, title, body]) => (
            <div class="rounded-xl border-2 border-soil-900 bg-white p-5 shadow-sm">
              <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-earth-100 font-bold text-earth-700">{n}</div>
              <h3 class="font-bold text-soil-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Override escape hatch -->
  <section class="py-16 lg:py-20 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto max-w-5xl">
        <SectionHeader
          eyebrow="Edge case"
          title="Needs a patch? Point Haybarn at a fork"
          class="mb-4"
        />
        <p class="text-soil-700 leading-relaxed mb-6 max-w-3xl">
          The Haybarn engine carries a small patch stack. For the rare extension that needs a tweak to build against it, add two optional fields — the upstream descriptor stays untouched. Most extensions never need this.
        </p>
        <CodeBlock code={haybarnOverride} lang="yaml" title="extensions/my_extension/description.yml" />
      </div>
    </div>
  </section>

  <!-- Links -->
  <section class="py-12 lg:py-16 bg-soil-50 font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-5xl gap-4 md:grid-cols-2">
        <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-soil-900 mb-2">See what's already built</h3>
          <p class="text-sm text-soil-700 leading-relaxed mb-4">
            Live build status for every community extension on the current engine.
          </p>
          <Button href={LATEST_STATUS_URL} variant="primary" size="md">Build status →</Button>
        </div>
        <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-soil-900 mb-2">The mirror repo</h3>
          <p class="text-sm text-soil-700 leading-relaxed mb-4">
            CI workflows, descriptor schema, and the override fields, documented in the README.
          </p>
          <Button href={haybarnMirrorRepo} variant="secondary" size="md" external>View on GitHub →</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-harvest-700">Expert help</p>
          <h2 class="mb-4 text-3xl font-bold text-soil-900 md:text-4xl">
            Stuck getting an extension to build?
          </h2>
          <p class="text-lg leading-relaxed text-soil-700">
            We help maintainers across the line — vcpkg conflicts, platform build failures, signing, and the long tail of CI quirks.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href="/consulting" variant="primary" size="md">
            Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a call
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
