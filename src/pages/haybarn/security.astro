---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { LATEST_STATUS_URL } from '../../data/haybarn-versions';

const HAYBARN_REPO = 'https://github.com/Query-farm-haybarn/haybarn';
const RELEASES_URL = `${HAYBARN_REPO}/releases`;
const RELEASE_KEY_URL = `${HAYBARN_REPO}/blob/main/HAYBARN/haybarn_release_signing.pub`;
const RELEASE_FINGERPRINT = 'AC21 147B 0BAB F694 1225  ECBE C415 9506 8F3F 6537';

const attestCmd = `# Verify GitHub's SLSA build-provenance for any release artifact
gh attestation verify haybarn_cli-linux-amd64.zip \\
  --repo Query-farm-haybarn/haybarn`;

const gpgCmd = `# Import Haybarn's release signing key (GPG, RSA-4096)
#   fingerprint AC21 147B 0BAB F694 1225  ECBE C415 9506 8F3F 6537
gpg --import haybarn_release_signing.pub

# Confirm the checksums file is signed by that key
gpg --verify SHA256SUMS.asc SHA256SUMS

# Then check your download against the checksums
sha256sum -c SHA256SUMS`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Every Haybarn release artifact ships with checksums, a detached GPG signature, and SLSA build-provenance attestations, hosted as immutable per-version artifacts. Extensions are signed with a single Haybarn key and the default catalog leaves third-party vendor code opt-in.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Haybarn security & supply chain',
    description,
    url: `${SITE_ORIGIN}/haybarn/security`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Security & supply chain', item: SITE_ORIGIN + '/haybarn/security' },
    ],
  },
];

const integrity = [
  {
    title: 'SLSA build provenance',
    body: 'Every release artifact carries a GitHub-signed provenance attestation that binds the binary to the exact workflow, repo, and commit that produced it. Verify it with one command — no Haybarn-side trust required.',
  },
  {
    title: 'Checksums + detached signature',
    body: 'Each release ships SHA256SUMS listing every artifact, plus SHA256SUMS.asc — a detached GPG signature of that file from the Haybarn release key.',
  },
  {
    title: 'Registry provenance',
    body: 'npm packages are published with provenance, and PyPI publishes carry PEP 740 attestations — so the same supply-chain trail follows the package channels, not just GitHub Releases.',
  },
  {
    title: 'Immutable hosting',
    body: 'Extensions are served from Cloudflare R2, where every deployed artifact lives at an immutable URL keyed by version and git sha. Nothing is overwritten in place.',
  },
];

// ── Shared shape vocabulary (family C: docs / reference — no bands) ──
const WRAP_WIDE = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const H2_FIRST = 'scroll-mt-32 text-2xl md:text-3xl text-soil-900';
const H2 = 'mt-11 scroll-mt-32 border-t border-soil-300 pt-6 text-2xl md:text-3xl text-soil-900';
const BODY = 'text-soil-700 leading-relaxed';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';
const NAV_LINK = 'block border-l-2 border-soil-200 px-2.5 py-1 text-sm text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
const NAV_LINK_ON = 'block border-l-2 border-link bg-link/8 px-2.5 py-1 text-sm text-link no-underline transition';
const TOC_LINK = 'block border-l-2 border-soil-200 px-2.5 py-1 text-[13px] text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
const BADGE = 'inline-block rounded-full border border-soil-300 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-700';

const sectionNav: [string, string][] = [
  ['Overview', '/haybarn'],
  ['Install', '/haybarn/install'],
  ['Security', '/haybarn/security'],
  ['Extensions', '/haybarn/extensions'],
  ['Build status', LATEST_STATUS_URL],
  ['Contribute', '/haybarn/community-extensions'],
  ["What's different", '/haybarn/differences'],
  ['Compatibility & FAQ', '/haybarn/compatibility'],
];
const CURRENT = '/haybarn/security';

const toc: [string, string][] = [
  ['Trust model', '#trust'],
  ['Provenance & integrity', '#integrity'],
  ['Verify it yourself', '#verify'],
  ['Safer defaults', '#catalog'],
  ['Auditable by construction', '#auditable'],
  ['Supply-chain review', '#help'],
];
---

<PageLayout
  title="Haybarn security & supply chain"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Security & supply chain"
    title="Artifacts your team can verify"
    icon={{ src: '/haybarn/haybarn-mark.svg' }}
    lede="This is why Haybarn exists. Every binary ships with checksums, a signature, and build provenance, hosted immutably — so a security team has something concrete to review before DuckDB goes into production."
  >
    <div class="mt-4 flex flex-wrap gap-2" slot="badges">
      <span class={BADGE}>Signed</span>
      <span class={BADGE}>Attested</span>
      <span class={BADGE}>Reproducible</span>
    </div>
  </PageHead>

  <!-- ── Docs grid: section nav / content / page TOC ──────────── -->
  <div class={`${WRAP_WIDE} grid gap-10 py-10 lg:grid-cols-[220px_minmax(0,1fr)_200px] lg:gap-11`}>
    <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto">
      <nav aria-label="Haybarn documentation">
        <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">In this section</h2>
        <ul class="flex flex-col gap-0.5">
          {sectionNav.map(([name, href]) => (
            <li>
              <a
                href={href}
                class={href === CURRENT ? NAV_LINK_ON : NAV_LINK}
                aria-current={href === CURRENT ? 'page' : undefined}
              >{name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="min-w-0">
      <h2 id="trust" class={H2_FIRST}>Two signing keys, both Haybarn's</h2>
      <p class={`mt-3 max-w-[68ch] ${BODY}`}>
        Haybarn controls its own trust roots end to end — one key for releases, one for
        extensions. Neither is shared with upstream DuckDB.
      </p>
      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Release signing key</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            A GPG RSA-4096 key signs the <code class={CODE}>SHA256SUMS</code> file on every GitHub
            Release. Import it once and you can verify every artifact you download.
          </p>
          <div class="mt-4 rounded-lg border border-soil-300 bg-soil-100 px-3.5 py-2.5">
            <p class="text-[12.5px] font-medium text-soil-700">Fingerprint</p>
            <p class="mt-1 break-all font-mono text-xs text-soil-900">{RELEASE_FINGERPRINT}</p>
          </div>
          <p class="mt-3.5 text-sm">
            <a href={RELEASE_KEY_URL} target="_blank" rel="noopener" class={LINK}>Public key →</a>
          </p>
        </div>
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Extension signing key</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            A single Haybarn RSA key is embedded in the engine and signs every
            <code class={CODE}>.duckdb_extension</code> binary. The trust root is deliberately
            disjoint from DuckDB's.
          </p>
          <ul class="mt-4 flex flex-col gap-2 text-sm leading-relaxed text-soil-700">
            <li>• Only Haybarn-signed extensions load on the Haybarn engine.</li>
            <li>• DuckDB-signed extensions will not load — and vice versa.</li>
            <li>• Haybarn rebuilds and re-signs the whole community catalog with this key.</li>
          </ul>
        </div>
      </div>

      <h2 id="integrity" class={H2}>Four ways to confirm a binary is what it claims</h2>
      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        {integrity.map(item => (
          <div class={`${CARD} p-6`}>
            <h3 class="text-lg text-soil-900">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{item.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 rounded-r-lg border-l-[3px] border-[#a8412a] bg-[#fdf4f1] px-5 py-4">
        <div class="text-[12.5px] font-medium text-[#a8412a]">Not yet</div>
        <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
          OS-native code signing (Apple Developer ID, Windows Authenticode) is not yet wired up.
          Integrity today comes from checksums, the GPG signature, and the build-provenance
          attestations above.
        </p>
      </div>

      <h2 id="verify" class={H2}>Two commands, end to end</h2>
      <p class={`mt-3 max-w-[68ch] ${BODY}`}>
        Nothing here trusts query.farm at runtime — you check GitHub's provenance and a GPG
        signature you import once.
      </p>
      <div class="mt-6 grid gap-6">
        <div>
          <h3 class="mb-3 text-[12.5px] font-medium text-soil-700">Build provenance</h3>
          <CodeBlock code={attestCmd} lang="bash" title="verify-provenance.sh" />
        </div>
        <div>
          <h3 class="mb-3 text-[12.5px] font-medium text-soil-700">Checksums + signature</h3>
          <CodeBlock code={gpgCmd} lang="bash" title="verify-release.sh" />
        </div>
      </div>
      <p class="mt-5 text-sm leading-relaxed text-soil-700">
        Download artifacts from <a href={RELEASES_URL} target="_blank" rel="noopener" class={LINK}>GitHub Releases</a>,
        and see which extensions are built and signed for the current engine on the
        <a href={LATEST_STATUS_URL} class={LINK}>status page</a>.
      </p>

      <h2 id="catalog" class={H2}>A curated catalog, vendor code opt-in</h2>
      <p class={`mt-3 max-w-[68ch] ${BODY}`}>
        Supply-chain risk isn't only about signatures — it's about what runs without you asking.
        Haybarn's default catalog is the open-source set DuckDB's own CI builds, with third-party
        vendor extensions left out of the default install and autoload path.
      </p>
      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Autoload stays narrow</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            A query referencing an extension won't silently pull in third-party vendor code —
            Haybarn's autoloadable list excludes it (motherduck is explicitly removed, with the
            rationale documented in source). You can still configure any extension yourself; it's
            just not on the default path.
          </p>
        </div>
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Everything re-signed</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            The community catalog is rebuilt against the Haybarn engine and re-signed with the
            Haybarn key — the disjoint trust root is what makes the curation enforceable, not just
            advisory.
          </p>
        </div>
      </div>

      <h2 id="auditable" class={H2}>A small, reviewable delta from DuckDB</h2>
      <p class={`mt-3 max-w-[68ch] ${BODY}`}>
        Haybarn is a hard fork kept as a small, curated commit stack on top of an upstream DuckDB
        release tag — so the difference from the engine you already trust is easy to read.
      </p>
      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Curated commit stack</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            Haybarn's changes are branding, signing keys, repository URLs, and CI — a short stack
            on top of the upstream tag, not scattered edits. The engine source, SQL, and file
            format are unchanged.
          </p>
        </div>
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">SHA-pinned builds</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            Extension build-forks are pinned by 40-character commit SHA, not a moving branch —
            every build is explicit about exactly what source went into it.
          </p>
        </div>
      </div>

      <h2 id="help" class={H2}>Reviewing Haybarn for production?</h2>
      <div class={`mt-6 ${CARD} px-6 py-6`}>
        <span class={EYEBROW}>Expert help</span>
        <p class={`mt-3 max-w-[62ch] ${BODY}`}>
          We help security and platform teams with supply-chain review, private signing keys,
          internal mirrors, and custom trust roots.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>

    <aside class="hidden xl:block xl:sticky xl:top-24 xl:self-start">
      <nav aria-label="On this page">
        <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">On this page</h2>
        <ul class="flex flex-col gap-0.5">
          {toc.map(([name, href]) => (
            <li><a href={href} class={TOC_LINK}>{name}</a></li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>
</PageLayout>
