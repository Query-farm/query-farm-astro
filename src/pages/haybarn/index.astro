---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_RC_PYPI, LATEST_DUCKDB_VERSION } from '../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_REPO = 'https://github.com/Query-farm-haybarn/haybarn';

const SITE_ORIGIN = 'https://query.farm';
const haybarnDescription = 'Haybarn is the production distribution layer for DuckDB: same SQL and files, with signed releases, rebuilt extensions, package channels, and supply-chain review built in.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Haybarn',
    description: haybarnDescription,
    url: `${SITE_ORIGIN}/haybarn`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Distribution',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['SQL', 'Python', 'TypeScript', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: HAYBARN_REPO,
    softwareVersion: HAYBARN_RC,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
    ],
  },
];
---

<PageLayout
  title="Haybarn — DuckDB, cultivated"
  description={haybarnDescription}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-14 font-display lg:py-20">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="haybarn-hero-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#haybarn-hero-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_0.9fr] lg:text-left">
        <div class="order-2 lg:order-1">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-grain-500"></span>
            Haybarn v{HAYBARN_RC} · release candidate
          </div>

          <h1 class="text-4xl font-extrabold leading-[1.05] tracking-normal text-soil-900 md:text-5xl lg:text-6xl">
            <span class="block">DuckDB your team can</span>
            <span class="mt-2 inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">ship.</span>
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-soil-700 md:text-xl">
            Same SQL and database files, plus reviewable releases, rebuilt extensions, and artifacts your team can verify.
          </p>

          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
            <Button href="/haybarn/install" variant="accent" size="lg">Install Haybarn</Button>
            <Button href={HAYBARN_REPO} variant="secondary" size="lg">GitHub</Button>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="rounded-2xl border-2 border-soil-900 bg-white p-4 shadow-2xl md:p-5">
            <div class="rounded-xl border-2 border-soil-900 bg-soil-900 p-5 text-soil-100">
              <p class="text-xs font-bold uppercase tracking-wider text-harvest-300">What Haybarn adds</p>
              <div class="mt-4 space-y-3">
                {[
                  ['Drop-in compatibility', 'Same SQL, APIs, files, and extension names.'],
                  ['Verified artifacts', 'Engine and extensions can be checked before use.'],
                  ['Concrete install paths', 'Install through npm, PyPI, and GitHub Releases.'],
                  ['Safer defaults', 'Third-party vendor extensions stay opt-in.'],
                ].map(([title, detail]) => (
                  <div class="rounded-lg border border-white/10 bg-white/10 p-3">
                    <p class="font-bold text-white">{title}</p>
                    <p class="mt-1 text-sm text-soil-300">{detail}</p>
                  </div>
                ))}
              </div>
              <div class="mt-4 rounded-lg border border-harvest-300/30 bg-harvest-300/10 px-3 py-2 text-sm font-bold text-harvest-100">
                DuckDB compatibility stays intact.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- Why Haybarn -->
  <section class="py-16 lg:py-20 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto max-w-5xl rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-lg md:p-8">
        <SectionHeader
          eyebrow="Why Haybarn"
          title="The production layer around DuckDB"
          class="mb-6"
        />
        <p class="max-w-3xl text-lg leading-relaxed text-soil-700">
          DuckDB is an excellent engine. Haybarn adds the distribution, signing, extension, and release controls teams need when DuckDB becomes part of an app, service, agent, or regulated workflow.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
          {[
            ['Approve it', 'Signatures, checksums, and build history give security teams something concrete to review.'],
            ['Mirror it', 'Artifacts and extensions are published through channels that fit internal registries and controlled environments.'],
            ['Ship it', 'Use familiar DuckDB SQL and extension commands while Haybarn handles the production release layer.'],
          ].map(([title, description]) => (
            <div class="rounded-xl border-2 border-soil-900 bg-grain-50 p-5 shadow-sm">
              <h3 class="font-bold text-soil-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-soil-700">{description}</p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button href={LATEST_STATUS_URL} variant="secondary" size="md">View current build status</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Compatibility -->
  <section class="bg-white py-12 font-display">
    <div class="section-container">
      <div class="mx-auto max-w-5xl rounded-2xl border-2 border-soil-900 bg-soil-900 p-6 text-white shadow-lg md:p-8">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-harvest-300">Drop-in where it matters</p>
            <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">Adopt the distribution without rewriting the work.</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              ['Same SQL', 'Queries behave like DuckDB.'],
              ['Same files', `.duckdb files stay compatible with DuckDB v${LATEST_DUCKDB_VERSION}.`],
              ['Same extension commands', 'INSTALL and LOAD keep the familiar shape.'],
              ['One-line Python path', 'Use import haybarn as duckdb when the library package is live.'],
            ].map(([title, description]) => (
              <div class="rounded-xl border border-white/10 bg-white/10 p-4">
                <h3 class="font-bold text-white">{title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-soil-300">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Try it -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          eyebrow="Try it"
          title="A familiar extension command, a verified artifact behind it"
          description="Haybarn keeps the DuckDB workflow familiar while changing how the binary is built, signed, published, and tracked."
          class="mb-8"
        />
        <CodeBlock code={`# uvx fetches and runs the Haybarn CLI temporarily.
uvx haybarn-cli==${LATEST_RC_PYPI}

# Or use npx:
#   npx haybarn@rc

# Same DuckDB engine and SQL.
memory H SELECT version();

# h3 is a DuckDB community extension for H3 geospatial indexing.
# The command is familiar; Haybarn resolves it from Haybarn's
# rebuilt and signed extension channel.
memory H INSTALL h3 FROM community;
memory H LOAD h3;

memory H SELECT h3_latlng_to_cell(37.7887, -122.3931, 9);
`} lang="bash" title="terminal" />
        <p class="text-sm text-soil-600 mt-4 leading-relaxed text-center">
          This is the point: <code class="font-mono text-earth-700">h3</code> is a normal DuckDB community extension, but Haybarn rebuilds it for the Haybarn engine, verifies it with the Haybarn key, and tracks whether it is ready for the release.
        </p>
      </div>
    </div>
  </section>

  <!-- Extension readiness -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="Signed extension ecosystem"
          title="Extensions, ready to load"
          description="Haybarn rebuilds DuckDB extensions, signs them, and tracks whether they are ready for each release."
          class="mb-10"
        />

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {[
            ['Same names', 'Use familiar INSTALL and LOAD commands.'],
            ['Core included', 'Common capabilities ship with the engine.'],
            ['Community rebuilt', 'Community extensions are signed and published by Haybarn.'],
          ].map(([title, description]) => (
            <div class="rounded-xl border-2 border-soil-900 bg-white p-5 shadow-sm">
              <h3 class="font-bold text-soil-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-soil-700">{description}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-xl border-2 border-soil-900 bg-grain-100 p-5">
          <p class="text-sm font-bold uppercase tracking-wider text-harvest-700">For production teams</p>
          <p class="mt-2 text-soil-800">
            Haybarn's extension distribution is designed for approval and repeatability: verifiable binaries, immutable hosted artifacts, release status, and package paths that fit npm/PyPI-style dependency workflows.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <Button href={LATEST_STATUS_URL} variant="primary" size="md">Open status page</Button>
            <Button href="/haybarn/extensions" variant="secondary" size="md">Extension packaging plan</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-harvest-700">Expert help</p>
          <h2 class="mb-4 text-3xl font-bold text-soil-900 md:text-4xl">
            Running Haybarn in production?
          </h2>
          <p class="text-lg leading-relaxed text-soil-700">
            We help teams adopt Haybarn: packaging, signing, internal mirrors, extension portability, and integration with existing DuckDB-based pipelines.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href="/consulting" variant="primary" size="md">
            Consulting & custom builds
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a call
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="py-8 bg-soil-100 border-t border-soil-200">
    <div class="section-container">
      <p class="text-xs text-soil-600 max-w-4xl mx-auto text-center leading-relaxed">
        Haybarn is not affiliated with, sponsored by, or endorsed by the DuckDB Foundation or DuckDB Labs.
        DuckDB is a trademark of the DuckDB Foundation. Haybarn is published by Query Farm LLC and distributed under the MIT License.
      </p>
    </div>
  </section>
</PageLayout>
