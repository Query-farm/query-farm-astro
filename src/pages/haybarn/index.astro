---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_RC_PYPI, LATEST_DUCKDB_VERSION, LATEST_PKG_SUFFIX } from '../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_REPO = 'https://github.com/Query-farm-haybarn/haybarn';

const whyCards = [
  {
    icon: '🛡️',
    title: 'Production-ready extension defaults',
    description: 'Haybarn\'s default catalog is the open-source set DuckDB CI builds, minus third-party vendor extensions. Your query won\'t pull in vendor code by surprise — and you stay in control of what gets loaded.'
  },
  {
    icon: '🚦',
    title: 'Extensions ready when Haybarn ships',
    description: 'Haybarn ships on DuckDB\'s release cadence. When we cut a release, we work to make sure common and popular community extensions are built and available alongside it. If an extension that built before stops building on a new version, we reach out to the maintainer to help land a fix.'
  },
  {
    icon: '🌐',
    title: 'Mirrored distribution',
    description: 'Haybarn is publishing every extension through three channels — R2, PyPI, and npm — so your team can pick the path that fits your supply chain. If one channel has a hiccup, the others keep working.'
  }
];

// In-catalog: extension names (rendered fixed-width) grouped by source layer.
const catalogIn = [
  { layer: 'In-tree (ship with the engine build)', names: ['autocomplete', 'core_functions', 'icu', 'json', 'parquet', 'tpcds', 'tpch'] },
  { layer: 'Haybarn build-forks', names: ['httpfs', 'iceberg', 'ducklake', 'delta'] },
  { layer: 'Out-of-tree, rebuilt from upstream', names: ['avro', 'aws', 'azure', 'encodings', 'excel', 'fts', 'inet', 'mysql_scanner', 'odbc_scanner', 'postgres_scanner', 'spatial', 'sqlite_scanner', 'sqlsmith', 'unity_catalog', 'vss'] }
];
const catalogOut = ['vortex', 'lance', 'motherduck'];

const quickInstall = `# npm / npx — zero install
npx haybarn@rc

# uvx / pipx — zero install
uvx haybarn-cli==${LATEST_RC_PYPI}`;

const SITE_ORIGIN = 'https://query.farm';
const haybarnDescription = 'Haybarn is a fully-compatible distribution of DuckDB. Same engine, same SQL, same database files — adopt with a one-line code change. Query.Farm cultivates the rest, with opinions about what production needs: a curated extension catalog tested against each engine release (no third-party vendor extensions autoloading by default), signed binaries with SLSA build provenance, modernized WASM and httpfs builds, and extensions published through pip and npm. As production teams find new edges, we tend to them. Cultivation doesn\'t stop.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Haybarn',
    description: haybarnDescription,
    url: `${SITE_ORIGIN}/haybarn`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Distribution',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['SQL', 'Python', 'TypeScript', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: HAYBARN_REPO,
    softwareVersion: HAYBARN_RC,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
    ],
  },
];
---

<PageLayout
  title="Haybarn — DuckDB, cultivated"
  description={haybarnDescription}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 overflow-hidden py-16 lg:py-24">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="haybarn-hero-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#haybarn-hero-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <img
          src="/haybarn/haybarn-logo.png"
          alt="Haybarn — DuckDB, cultivated"
          class="mx-auto w-40 md:w-48 lg:w-56 h-auto mb-6 drop-shadow-lg"
          width="550"
          height="550"
        />
        <h1 class="sr-only">Haybarn — DuckDB, cultivated</h1>

        <div class="mb-6 flex items-center justify-center">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/70 border border-soil-200 text-soil-700 text-sm font-mono">
            <span class="w-2 h-2 rounded-full bg-grain-500"></span>
            v{HAYBARN_RC} · release candidate
          </span>
        </div>

        <p class="text-2xl md:text-3xl lg:text-4xl font-bold text-soil-900 mb-4 leading-tight">
          DuckDB, cultivated.
        </p>
        <div class="text-lg md:text-xl text-soil-700 mb-8 lg:mb-12 leading-relaxed max-w-3xl mx-auto space-y-4">
          <p>
            Haybarn is a fully-compatible distribution of DuckDB. Same engine, same SQL, same database files — adopt with a <strong class="text-soil-900 font-semibold">one-line code change</strong>.
          </p>
          <p>
            Query.Farm <strong class="text-green-800 font-semibold">cultivates</strong> the rest, with opinions about what production needs: a curated extension catalog tested against each engine release (no third-party vendor extensions autoloading by default), signed binaries with SLSA build provenance, modernized WASM and httpfs builds, and extensions published through pip and npm.
          </p>
          <p>
            As production teams find new edges, we tend to them. <strong class="text-green-800 font-semibold">Cultivation</strong> doesn't stop.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/haybarn/install" variant="accent" size="lg">Install Haybarn</Button>
          <Button href={HAYBARN_REPO} variant="secondary" size="lg">GitHub</Button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- Distribution analogy -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          eyebrow="The precedent"
          title="A derived distribution, not a fork"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-4">
          Ubuntu is built from the same Debian source. The kernel is the same. The GNU userland is the same. What Ubuntu adds is a <strong>release cadence its users can plan against</strong>, a <strong>package archive Canonical signs and serves</strong>, and defaults tuned for a different audience. Nobody calls Ubuntu a fork — it's a derived distribution.
        </p>
        <p class="text-lg text-soil-700 leading-relaxed mb-4">
          Haybarn plays the same role for DuckDB. The engine source is the same and Haybarn ships on DuckDB's release cadence. What Haybarn adds around the engine — coordination with the community-extension catalog at release time, package formats (PyPI / npm / GitHub Releases), signing pipeline, SLSA build provenance, and extension distribution channels — is what teams running DuckDB in production keep asking for.
        </p>
        <div class="mt-6 border-l-2 border-soil-200 pl-4">
          <p class="text-sm text-soil-600 leading-relaxed">
            <strong class="text-soil-800">Another precedent:</strong> OpenBSD ships <em>OpenSSH</em>; <strong>OpenSSH-portable</strong> ships the same code repackaged for the rest of the world — Linux distros, AIX, Windows — on a schedule that matches users instead of the OpenBSD release train. Same source, different distribution, shipped on a cadence that fits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Haybarn is for -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="Who Haybarn is for"
          title="Teams doing serious work with DuckDB"
          description="Haybarn is for the teams DuckDB has grown beyond the laptop. If you ship DuckDB inside something real, you've probably hit one of these:"
          class="mb-10"
        />
        <div class="grid md:grid-cols-2 gap-6">
          <Card padding="lg">
            <div class="text-3xl mb-3">🏢</div>
            <h3 class="font-bold text-soil-900 mb-2">Enterprises under supply-chain review</h3>
            <p class="text-sm text-soil-700 leading-relaxed">
              Your security team needs every dependency to live in lockfiles, mirror to your internal Artifactory or Nexus, and pass through the SCA scanner you already run. Haybarn publishes every community extension as an npm and PyPI package — your <code class="font-mono text-earth-700">pip install</code> <em>is</em> the supply-chain checkpoint.
            </p>
          </Card>
          <Card padding="lg">
            <div class="text-3xl mb-3">📜</div>
            <h3 class="font-bold text-soil-900 mb-2">Teams under regulatory pressure</h3>
            <p class="text-sm text-soil-700 leading-relaxed">
              SLSA build provenance on every release artifact, GPG-signed checksums, immutable R2 URLs, and a release timeline coordinated with the community-extension catalog. The audit trail you need to point at when a reviewer asks.
            </p>
          </Card>
          <Card padding="lg">
            <div class="text-3xl mb-3">🛡️</div>
            <h3 class="font-bold text-soil-900 mb-2">Teams who want to choose what autoloads</h3>
            <p class="text-sm text-soil-700 leading-relaxed">
              The list of extensions DuckDB will autoload on demand grows over time, and not every addition belongs in your production session. Haybarn ships a catalog that excludes third-party vendor extensions by default — you decide what runs in your engine, not someone else's release notes.
            </p>
          </Card>
          <Card padding="lg">
            <div class="text-3xl mb-3">🛠️</div>
            <h3 class="font-bold text-soil-900 mb-2">Extension authors and builders</h3>
            <p class="text-sm text-soil-700 leading-relaxed">
              Want to ship something into the DuckDB ecosystem without waiting for a particular review queue? Haybarn's community-extensions catalog accepts direct submissions on the same descriptor format upstream uses. Ship to Haybarn users while a longer upstream conversation plays out.
            </p>
          </Card>
        </div>
        <p class="text-sm text-soil-600 mt-6 max-w-3xl mx-auto text-center leading-relaxed">
          If you're using DuckDB for local analysis, notebooks, or a side project, upstream is great — Haybarn is for the next step beyond that.
        </p>
      </div>
    </div>
  </section>

  <!-- Try it in 5 minutes -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          eyebrow="Try it"
          title="Five minutes from zero to running query"
          description="Adopting Haybarn doesn't mean migrating anything. Run the CLI, open an existing DuckDB database, run an existing query. The point of this is to feel the compatibility yourself before you commit to anything."
          class="mb-8"
        />
        <CodeBlock code={`# 1. Run Haybarn — no install needed
uvx haybarn-cli==${LATEST_RC_PYPI}

# Or via npm:
#   npx haybarn@rc

# 2. Inside the shell, try a quick query
D SELECT version();
┌──────────────────────────┐
│        version()         │
│         varchar          │
├──────────────────────────┤
│ v${LATEST_DUCKDB_VERSION}                   │
└──────────────────────────┘

# 3. Open a database you wrote with DuckDB
D ATTACH 'analytics.duckdb' AS prod;
D SELECT count(*) FROM prod.events WHERE day = today();

# 4. Install a community extension (same SQL as DuckDB)
D INSTALL h3 FROM community;
D LOAD h3;
D SELECT h3_latlng_to_cell(37.7887, -122.3931, 9);
`} lang="bash" title="haybarn-5-minutes.sh" />
        <p class="text-sm text-soil-600 mt-4 leading-relaxed text-center">
          Same database file, same SQL, same extension catalog. If something doesn't behave the way DuckDB would, that's a bug — file it.
        </p>
      </div>
    </div>
  </section>

  <!-- What's in / What's out -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="The catalog"
          title="What's in. What's out."
          description="Haybarn's default extension catalog is the open-source set DuckDB's own CI builds, minus third-party vendor extensions. You can still configure those manually — they're just not autoloaded or in the default install path."
          class="mb-10"
        />

        <div class="grid md:grid-cols-2 gap-6">
          <Card padding="lg">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </span>
              <h3 class="text-lg font-bold text-soil-900">Shipped, signed, served</h3>
            </div>
            <div class="space-y-4">
              {catalogIn.map(group => (
                <div>
                  <p class="text-xs font-semibold text-soil-500 uppercase tracking-wider mb-2">{group.layer}</p>
                  <div class="flex flex-wrap gap-x-3 gap-y-1">
                    {group.names.map(n => (
                      <code class="font-mono text-xs text-earth-700 bg-white border border-soil-200 rounded px-1.5 py-0.5">{n}</code>
                    ))}
                  </div>
                </div>
              ))}
              <div>
                <p class="text-xs font-semibold text-soil-500 uppercase tracking-wider mb-2">Community catalog</p>
                <p class="text-sm text-soil-700 leading-relaxed">
                  Every extension in the DuckDB community catalog, rebuilt and re-signed against the Haybarn engine.
                  <a href={LATEST_STATUS_URL} class="text-earth-700 underline hover:text-earth-800">See the build status →</a>
                </p>
              </div>
            </div>
          </Card>

          <Card padding="lg">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-soil-200 text-soil-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
              </span>
              <h3 class="text-lg font-bold text-soil-900">Not in the default catalog</h3>
            </div>
            <p class="text-xs font-semibold text-soil-500 uppercase tracking-wider mb-2">Third-party vendor extensions</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {catalogOut.map(name => (
                <code class="font-mono text-xs text-soil-700 bg-white border border-soil-300 rounded px-1.5 py-0.5">{name}</code>
              ))}
            </div>
            <p class="text-sm text-soil-700 leading-relaxed">
              These are vendor extensions tied to commercial products. Haybarn doesn't ship them by default and doesn't advertise them as autoloadable — so a query you wrote can't implicitly pull in vendor code you didn't intend to depend on.
            </p>
          </Card>
        </div>

        <p class="text-sm text-soil-600 mt-6 max-w-3xl mx-auto text-center leading-relaxed">
          Autoload is the convenience that lets a query implicitly pull in extension code. Useful for first-party extensions, risky for third-party vendor ones. Haybarn's posture is to keep autoload narrow and explicit.
        </p>
      </div>
    </div>
  </section>

  <!-- Targeted improvements on top -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="Beyond rebuilding"
          title="Targeted improvements, all ABI-compatible"
          description="Most of Haybarn is a faithful rebuild of upstream DuckDB. In a few places we carry small patches and build-flag tweaks on top — never deep enough to change ABI, file format, or SQL behavior, but enough to fix concrete production pain points. Where these changes make sense upstream, we contribute them back."
          class="mb-10"
        />
        <ul class="max-w-3xl mx-auto space-y-4 mb-8">
          <li class="flex gap-4">
            <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-earth-500"></span>
            <p class="text-soil-700 leading-relaxed">
              <strong class="text-soil-900">Extension build-forks.</strong> For a handful of extensions — currently <code class="font-mono text-earth-700">httpfs</code>, <code class="font-mono text-earth-700">iceberg</code>, <code class="font-mono text-earth-700">ducklake</code>, <code class="font-mono text-earth-700">delta</code> — Haybarn maintains build-forks pinned to a Haybarn branch, so we can pick up an upstream fix early or carry a small targeted patch when a customer hits a bug we can solve faster than the upstream cadence allows.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-earth-500"></span>
            <p class="text-soil-700 leading-relaxed">
              <strong class="text-soil-900">duckdb-wasm modernization.</strong> Updating <code class="font-mono text-earth-700">duckdb-wasm</code>'s emscripten toolchain and switching build flags to 64-bit integers — same WASM API and SQL, measurably better runtime performance for browser workloads that push past 2 GB or 32-bit address arithmetic.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-earth-500"></span>
            <p class="text-soil-700 leading-relaxed">
              <strong class="text-soil-900">Compile-flag tuning & bug fixes.</strong> Targeted compile-flag changes where they help production workloads, plus small bug fixes our customers run into. Each change stays cleanly contributable back upstream — the goal is to fix what's hurting users now, not to fork the codebase.
            </p>
          </li>
        </ul>
        <p class="text-sm text-soil-600 max-w-3xl mx-auto text-center leading-relaxed">
          None of this changes the ABI, the C++ API surface, the SQL dialect, or the on-disk format. A database file or extension binary written for upstream DuckDB v{LATEST_DUCKDB_VERSION} still works against Haybarn v{LATEST_DUCKDB_VERSION} unchanged.
        </p>
      </div>
    </div>
  </section>

  <!-- Why this exists -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Why Haybarn, and why now"
        title="What you actually get"
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {whyCards.map(c => (
          <Card padding="lg" class="text-center">
            <div class="text-4xl mb-4">{c.icon}</div>
            <h3 class="text-lg font-bold text-soil-900 mb-3">{c.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{c.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- PyPI / npm hook -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center px-2 py-1 rounded-md bg-grain-100 text-grain-800 text-xs font-mono uppercase tracking-wider">Roadmap</span>
        </div>
        <SectionHeader
          eyebrow="The enterprise hook"
          title="DuckDB extensions in requirements.txt"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-6">
          The single most-requested Haybarn feature: <strong>every extension also published as an ordinary PyPI wheel and npm package</strong>. Pin <code class="font-mono text-earth-700 text-base">@haybarn/ext-iceberg-{LATEST_PKG_SUFFIX}</code> in your <code class="font-mono text-earth-700 text-base">package.json</code>. Pin <code class="font-mono text-earth-700 text-base">haybarn-extension-iceberg</code> in your <code class="font-mono text-earth-700 text-base">requirements.txt</code>. Mirror to Artifactory or Nexus. Run it through the supply-chain review you already have for every other dependency.
        </p>
        <ul class="space-y-3 text-soil-700 mb-6">
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-3 text-grain-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Lockfile-pinned, reproducible installs across your whole stack</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-3 text-grain-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Works behind corporate proxies that already mirror npm and PyPI</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-3 text-grain-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>No separate extension-provenance review process — your <code class="font-mono text-earth-700">pip install</code> <em>is</em> the supply-chain checkpoint</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-3 text-grain-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Additive — the existing <code class="font-mono text-earth-700">INSTALL ext</code> network path keeps working</span>
          </li>
        </ul>
        <p class="text-sm text-soil-600 italic">
          Rolling out as part of the GA push. Design and rollout plan lives in the public Haybarn ideas tree.
          <a href="/haybarn/extensions" class="text-earth-700 underline hover:text-earth-800 not-italic font-medium">Read the full extensions plan →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Community status -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="What's ready today"
          title="Community-extension readiness"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-6">
          Haybarn rebuilds <strong>every</strong> extension in the DuckDB community catalog against the Haybarn engine and re-signs them. Build status is public and updated continuously.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <Button href={LATEST_STATUS_URL} variant="primary" size="md">
            See the build matrix →
          </Button>
          <a href="https://haybarn-status.query.farm" class="text-sm text-soil-600 hover:text-earth-700 underline">
            Live dashboard at haybarn-status.query.farm
