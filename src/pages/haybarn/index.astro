---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_RC_PYPI, LATEST_DUCKDB_VERSION } from '../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_REPO = 'https://github.com/Query-farm-haybarn/haybarn';

const SITE_ORIGIN = 'https://query.farm';
const haybarnDescription = 'Haybarn is the production distribution layer for DuckDB: same SQL and files, with signed releases, rebuilt extensions, package channels, and supply-chain review built in.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Haybarn',
    description: haybarnDescription,
    url: `${SITE_ORIGIN}/haybarn`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Distribution',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['SQL', 'Python', 'TypeScript', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: HAYBARN_REPO,
    softwareVersion: HAYBARN_RC,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
    ],
  },
];

// ── Shared shape vocabulary (brief §10: port qf.css shapes as utilities) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';

const guarantees = [
  ['Drop-in compatibility', 'Same SQL, same APIs, same database files, same extension names. Adopting the distribution is not a migration.'],
  ['Verified artifacts', 'Engine and extensions carry checksums, a detached GPG signature, and SLSA build provenance — checkable before anything runs.'],
  ['Concrete install paths', 'npm, PyPI, and GitHub Releases. Pick the channel that already fits your supply chain.'],
  ['Safer defaults', 'The default catalog is the set DuckDB CI builds, minus third-party vendor code. Nothing autoloads that you did not ask for.'],
];

const posture = [
  ['Approve it', 'Signatures, checksums, and build history give a security team something concrete to review.'],
  ['Mirror it', 'Artifacts and extensions publish through channels that fit internal registries and controlled environments.'],
  ['Ship it', 'Familiar DuckDB SQL and extension commands, with Haybarn handling the production release layer.'],
];

const sameness = [
  ['Same SQL', 'Queries behave exactly as they do on DuckDB.'],
  ['Same files', `.duckdb files stay compatible with DuckDB v${LATEST_DUCKDB_VERSION}.`],
  ['Same extension commands', 'INSTALL and LOAD keep the familiar shape.'],
  ['One-line Python path', 'import haybarn as duckdb, once the library package is live.'],
];

const extensionFacts = [
  ['Same names', 'Familiar INSTALL and LOAD commands, resolved from the Haybarn channel.'],
  ['Core included', 'Common capabilities ship built and signed with the engine.'],
  ['Community rebuilt', 'The community catalog is rebuilt against the Haybarn engine and re-signed.'],
];

const stats: [string, string][] = [
  [`v${HAYBARN_RC}`, 'Current release candidate'],
  [`v${LATEST_DUCKDB_VERSION}`, 'DuckDB version tracked'],
  ['12', 'Build platforms per extension'],
  ['3', 'Distribution channels'],
];
---

<PageLayout
  title="Haybarn — DuckDB, cultivated"
  description={haybarnDescription}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Production distribution"
    title="DuckDB your team can ship."
    icon={{ src: '/haybarn/haybarn-logo.png' }}
    lede="Same SQL and database files, plus reviewable releases, rebuilt extensions, and artifacts your team can verify. The part nobody thinks about until a version drifts in production."
    hairband
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/haybarn/install" variant="primary" size="md">Install Haybarn</Button>
      <Button href={LATEST_STATUS_URL} variant="secondary" size="md">See build status</Button>
      <Button href={HAYBARN_REPO} variant="secondary" size="md" external>GitHub ↗</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">v{HAYBARN_RC}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Release candidate</div>
    </Fragment>
  </PageHead>

  <!-- ── What you get ────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>What you get</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Four guarantees</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2">
        {guarantees.map(([title, body]) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <h3 class="text-xl text-soil-900">{title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: install / the key moment ──────────── -->
  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">Try it</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">One command, then it's deterministic</h2>
      <p class="mt-3 max-w-[58ch] text-[17.5px] leading-relaxed text-cream-2">
        A familiar extension command with a verified artifact behind it. The CLI resolves from
        Haybarn's channel and checks the signature before anything lands on disk.
      </p>

      <div class="mt-6 overflow-hidden rounded-xl border border-white/15 bg-rock-950">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
          <span class="text-[12.5px] font-medium text-cream-2">Terminal</span>
          <button
            type="button"
            class="qf-copy rounded-md border border-rock-800 px-2.5 py-1 text-[13px] font-medium text-cream-2 transition-colors hover:border-sun-400 hover:text-sun-400"
          >Copy</button>
        </div>
        <pre class="overflow-x-auto p-5 font-mono text-[12.8px] leading-[1.9] text-[#e9e1d3]"><code><span class="text-[#6d6357]"># uvx fetches and runs the Haybarn CLI temporarily</span>
<span class="text-sun-400">uvx</span> haybarn-cli=={LATEST_RC_PYPI}

<span class="text-[#6d6357]"># or through npm</span>
<span class="text-sun-400">npx</span> haybarn@rc

<span class="text-[#6d6357]"># same engine, same SQL</span>
memory H <span class="text-sun-400">SELECT</span> version();

<span class="text-[#6d6357]"># h3 is a normal DuckDB community extension — Haybarn rebuilds</span>
<span class="text-[#6d6357]"># it, signs it with the Haybarn key, and tracks its readiness</span>
memory H <span class="text-sun-400">INSTALL</span> h3 <span class="text-sun-400">FROM</span> community;
memory H <span class="text-sun-400">LOAD</span> h3;

memory H <span class="text-sun-400">SELECT</span> h3_latlng_to_cell(37.7887, -122.3931, 9);</code></pre>
      </div>

      <div class="mt-8 grid overflow-hidden rounded-xl border border-white/15 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map(([n, label], i) => (
          <div class:list={['px-5 py-5', i < stats.length - 1 && 'lg:border-r lg:border-white/12']}>
            <div class="qf-figure text-[34px] leading-none text-sun-400">{n}</div>
            <div class="mt-2 text-[12.5px] font-medium text-cream-2">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why Haybarn ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Why Haybarn</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">The production layer around DuckDB</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        DuckDB is an excellent engine. Haybarn adds the distribution, signing, extension, and
        release controls teams need when DuckDB becomes part of an app, service, agent, or
        regulated workflow.
      </p>
      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {posture.map(([title, body]) => (
          <div class={`${CARD} p-6`}>
            <h3 class="text-xl text-soil-900">{title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Compatibility ───────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Drop-in where it matters</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Adopt the distribution without rewriting the work</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2">
        {sameness.map(([title, body]) => (
          <div class={`${CARD} p-5`}>
            <h3 class="text-lg text-soil-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Extension readiness ─────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Signed extension ecosystem</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Extensions, ready to load</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Haybarn rebuilds DuckDB extensions, signs them, and tracks whether they are ready for
        each release. Nothing is claimed that isn't measured.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {extensionFacts.map(([title, body]) => (
          <div class={`${CARD} p-5`}>
            <h3 class="text-lg text-soil-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
        <div class="text-[12.5px] font-medium text-sun-700">For production teams</div>
        <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
          The extension distribution is built for approval and repeatability: verifiable
          binaries, immutable hosted artifacts, published release status, and package paths
          that fit npm / PyPI-style dependency workflows.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href={LATEST_STATUS_URL} variant="primary" size="sm">Open status page</Button>
          <Button href="/haybarn/extensions" variant="secondary" size="sm">Extension packaging plan</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="pb-16">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">Evaluating Haybarn for production?</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            We'll walk your team through pinning, signing, internal mirrors, and the upgrade
            path — and tell you honestly if you don't need it yet.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/company/schedule" variant="primary" size="md">Schedule a call</Button>
          <Button href="/haybarn/security" variant="secondary" size="md">Read the security page</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Disclaimer ──────────────────────────────────────────── -->
  <section class="border-t border-soil-300 bg-soil-100 py-7">
    <div class={WRAP}>
      <p class="mx-auto max-w-4xl text-center text-xs leading-relaxed text-soil-700">
        Haybarn is not affiliated with, sponsored by, or endorsed by the DuckDB Foundation or
        DuckDB Labs. DuckDB is a trademark of the DuckDB Foundation. Haybarn is published by
        Query Farm LLC and distributed under the MIT License.
      </p>
    </div>
  </section>
</PageLayout>

<script>
  // Copy button for hand-rolled rock-900/950 code blocks (brief §3: code never
  // sits on a coloured band, so slab code blocks are built here rather than
  // reusing the shared CodeBlock component).
  function wireCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('button.qf-copy').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', async () => {
        const pre = btn.closest('div')?.parentElement?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
        } catch { /* clipboard unavailable */ }
      });
    });
  }
  wireCopyButtons();
  document.addEventListener('astro:after-swap', wireCopyButtons);
</script>
