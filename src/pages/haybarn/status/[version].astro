---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import HaybarnSubNav from '../../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import { Icon } from 'astro-icon/components';

import { HAYBARN_VERSION_TAGS, LATEST_HAYBARN_VERSION } from '../../../data/haybarn-versions';

export function getStaticPaths() {
  return Object.keys(HAYBARN_VERSION_TAGS).map(v => ({ params: { version: v } }));
}

const versionParam = Astro.params.version as string;
const HAYBARN_TAG = HAYBARN_VERSION_TAGS[versionParam] ?? HAYBARN_VERSION_TAGS[LATEST_HAYBARN_VERSION];
const DUCKDB_VERSION = versionParam.replace(/^v/, '');
const STATUS_API = `https://haybarn-status.query.farm/api/r/${HAYBARN_TAG}`;
const STATUS_PAGE = `https://haybarn-status.query.farm/r/${HAYBARN_TAG}`;
// Encoded into Haybarn extension package names. Mirrors repos.js in the
// status service: `haybarn-ext-<name>-h<M>-<m>-<p>`, `@haybarn/ext-<name>-h<M>-<m>-<p>`
// (e.g. h1-5-3 for DuckDB 1.5.3). Derived from the page's version, not hardcoded.
const HAYBARN_VERSION_SUFFIX = `h${DUCKDB_VERSION.replace(/\./g, '-')}`;
function defaultNpmName(extName: string): string  { return `@haybarn/ext-${extName}-${HAYBARN_VERSION_SUFFIX}`; }
function defaultPypiName(extName: string): string { return `haybarn-ext-${extName}-${HAYBARN_VERSION_SUFFIX}`; }
function npmUrl(name: string):  string { return `https://www.npmjs.com/package/${name}`; }
function pypiUrl(name: string): string { return `https://pypi.org/project/${name}/`; }

// Platforms the Haybarn engine builds for. This is the static list — when the
// status service grows per-platform engine job data, swap to derived.
const ENGINE_PLATFORMS = [
  'linux_amd64',
  'linux_arm64',
  'linux_amd64_musl',
  'linux_arm64_musl',
  'osx_universal',
  'osx_arm64',
  'osx_amd64',
  'windows_amd64'
];

// Pretty labels for the per-extension layer that comes back in `sidePanel.core`.
const LAYER_LABEL: Record<string, string> = {
  in_tree: 'in-tree',
  fork:    'build-fork',
  rebuilt: 'rebuilt',
};

type Run = {
  workflowName?: string;
  status?: string;
  conclusion?: string | null;
  createdAt?: string;
  htmlUrl?: string;
};

type Repo = { repo: string; label: string; runs?: Run[]; error?: string | null };
type ForkSummary = { repo: string; label: string; run?: Run | null };
type RegistryInfo = { exists?: boolean; latest?: string | null; url?: string | null; error?: string };
type R2Info = { exists?: boolean; url?: string | null; platform?: string; lastModified?: string | null; contentLength?: string | null; error?: string };
type Extension = {
  name: string;
  layer?: string;                // core only: 'in_tree' | 'fork' | 'rebuilt'
  version?: string | null;       // descriptor's extension.version (semver or author's own)
  commitSha?: string | null;     // upstream commit pin
  description?: string | null;
  repo?: { github?: string; ref?: string | null } | null;
  run?: Run | null;
  registries?: { npm?: RegistryInfo | null; pypi?: RegistryInfo | null } | null;
  r2?: R2Info | null;            // does the .duckdb_extension.gz exist on Haybarn's R2 bucket
  upstream?: R2Info | null;      // does the same binary exist on upstream DuckDB's CDN
};

type StatusData = {
  tag: string;
  fetchedAt: string;
  repos: Repo[];
  sidePanel: {
    forks: ForkSummary[];
    community: { fetchedAt?: string; extensions: Extension[]; catalogSize?: number };
    core?: { fetchedAt?: string; extensions: Extension[]; catalogSize?: number } | null;
  };
} | null;

async function fetchStatus(): Promise<{ data: StatusData; error: string | null }> {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 15_000);
    const res = await fetch(STATUS_API, { signal: ctrl.signal });
    clearTimeout(t);
    if (!res.ok) return { data: null, error: `${res.status} ${res.statusText}` };
    return { data: (await res.json()) as StatusData, error: null };
  } catch (e: any) {
    return { data: null, error: e?.message ?? 'fetch failed' };
  }
}

const { data, error } = await fetchStatus();

// ── Shared shape vocabulary (brief §10) ──────────────────────────────
const WRAP = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const TH = 'border-b border-soil-300 bg-[#fbf7ee] px-3.5 py-2.5 text-left text-[12.5px] font-semibold text-soil-700';
const TH_R = 'border-b border-soil-300 bg-[#fbf7ee] px-3.5 py-2.5 text-right text-[12.5px] font-semibold text-soil-700';
const ROW = 'border-b border-soil-200 last:border-0 hover:bg-[#fbf7ee]';
// Badge/status pill base — the classify helpers below supply only the colour.
const PILL = 'inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium';

// Engine / fork / connector rows still classify on the CI run — those repos
// have reliable per-tag run state and there's no "binary on R2" notion to
// substitute. The CI shape stays for them.
type RunCls = 'success' | 'failure' | 'in_progress' | 'unknown';
function classifyRun(run?: Run | null): RunCls {
  if (!run) return 'unknown';
  if (run.status === 'in_progress' || run.status === 'queued') return 'in_progress';
  if (run.conclusion === 'success') return 'success';
  if (run.conclusion === 'failure' || run.conclusion === 'cancelled' || run.conclusion === 'timed_out') return 'failure';
  return 'unknown';
}
function runBadgeClasses(s: RunCls): string {
  switch (s) {
    case 'success':     return 'border-field-600/45 bg-field-600/10 text-field-700';
    case 'failure':     return 'border-[#a8412a]/40 bg-[#a8412a]/8 text-[#a8412a]';
    case 'in_progress': return 'border-sun-400 bg-sun-400/12 text-sun-700';
    default:            return 'border-soil-300 bg-soil-100 text-soil-700';
  }
}
function runBadgeLabel(s: RunCls): string {
  switch (s) {
    case 'success':     return 'ready';
    case 'failure':     return 'failing';
    case 'in_progress': return 'building';
    default:            return '—';
  }
}

// Community extensions classify on **artifact availability** first, and fall
// back to the latest CI run state when R2 / registries don't have the binary
// yet. The point is to be honest about *why* something isn't available — a
// build that failed should say "failed", not the vague "pending."
type AvailCls = 'available' | 'building' | 'failed' | 'pending' | 'unknown';
function classifyAvailability(ext: Extension): AvailCls {
  if (ext.r2?.exists || ext.registries?.npm?.exists || ext.registries?.pypi?.exists) {
    return 'available';
  }
  const run = ext.run;
  if (run?.status === 'in_progress' || run?.status === 'queued') return 'building';
  if (run?.conclusion === 'failure' || run?.conclusion === 'cancelled' || run?.conclusion === 'timed_out') {
    return 'failed';
  }
  if (ext.r2 == null && ext.registries == null && !run) return 'unknown';
  return 'pending';
}
function availBadgeClasses(s: AvailCls): string {
  switch (s) {
    case 'available': return 'border-field-600/45 bg-field-600/10 text-field-700';
    case 'building':  return 'border-sun-400 bg-sun-400/12 text-sun-700';
    case 'failed':    return 'border-[#a8412a]/40 bg-[#a8412a]/8 text-[#a8412a]';
    case 'pending':   return 'border-soil-300 bg-soil-100 text-soil-700';
    default:          return 'border-soil-200 bg-soil-50 text-soil-500';
  }
}
function availBadgeLabel(s: AvailCls): string {
  switch (s) {
    case 'available': return 'available';
    case 'building':  return 'building';
    case 'failed':    return 'build failed';
    case 'pending':   return 'pending';
    default:          return '—';
  }
}

// Tiny side-by-side comparison pill — shows whether upstream DuckDB's CDN has
// the same binary. When upstream is also missing, the row's Haybarn pending /
// failed isn't really a Haybarn problem.
function upstreamBadge(up?: R2Info | null): { cls: string; label: string; title: string } {
  if (up == null)         return { cls: 'border-soil-200 bg-soil-50 text-soil-500',        label: '—',           title: 'upstream availability not yet probed' };
  if (up.exists === true) return { cls: 'border-field-600/45 bg-field-600/10 text-field-700', label: 'available',   title: 'upstream DuckDB ships this for the same version' };
  return                         { cls: 'border-soil-300 bg-soil-100 text-soil-700',       label: 'not shipped', title: 'upstream DuckDB has not shipped this for the same version either' };
}

function formatRelative(iso?: string): string {
  if (!iso) return '—';
  const diff = (Date.now() - new Date(iso).getTime()) / 1000;
  if (diff < 60)    return `${Math.round(diff)}s ago`;
  if (diff < 3600)  return `${Math.round(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.round(diff / 3600)}h ago`;
  return `${Math.round(diff / 86400)}d ago`;
}

const engineRepo = data?.repos.find(r => r.label === 'Engine');
// Prefer the engine Release build for the engine's status; fall back to the
// most recent run. (`runs[0]` is just "most recent by start time", which can be
// the extensions workflow rather than the engine build itself.)
const engineLatest =
  engineRepo?.runs?.find(r => /release/i.test(r.workflowName ?? '')) ??
  engineRepo?.runs?.[0] ??
  null;
const engineCls = classifyRun(engineLatest);

const coreExts = (data?.sidePanel?.core?.extensions ?? []).slice();
coreExts.sort((a, b) => a.name.localeCompare(b.name));
const coreAvailable = coreExts.filter(e => classifyAvailability(e) === 'available').length;
const coreUpstreamAvailable = coreExts.filter(e => e.upstream?.exists === true).length;

const exts = (data?.sidePanel?.community?.extensions ?? []).slice();
exts.sort((a, b) => a.name.localeCompare(b.name));

const extCount     = data?.sidePanel?.community?.catalogSize ?? exts.length;
const extAvailable = exts.filter(e => classifyAvailability(e) === 'available').length;
const extUpstreamAvailable = exts.filter(e => e.upstream?.exists === true).length;

// Upstream comparison is only meaningful when the status service actually
// probed upstream DuckDB's CDN. Until that field is populated, hide the
// upstream column / stats / divergence filter entirely rather than render
// misleading zeros. When the service starts returning `upstream`, this flips
// back on automatically.
const anyUpstreamKnown = [...coreExts, ...exts].some(e => e.upstream != null);

// Non-engine CI pipelines: language bindings/connectors (from `repos`) and the
// core-extension build-forks (from `sidePanel.forks`). The Engine repo has its
// own section, so it's excluded here.
type PipelineRow = { label: string; slug: string; kind: 'binding' | 'build-fork'; run: Run | null };
const pipelineRows: PipelineRow[] = [
  ...(data?.repos ?? [])
    .filter(r => r.label !== 'Engine')
    .map(r => ({ label: r.label, slug: r.repo, kind: 'binding' as const, run: r.runs?.[0] ?? null })),
  ...(data?.sidePanel?.forks ?? [])
    .map(f => ({ label: f.label, slug: f.repo, kind: 'build-fork' as const, run: f.run ?? null })),
];

const SITE_ORIGIN = 'https://query.farm';
const description = `Build status for Haybarn v${DUCKDB_VERSION} (${HAYBARN_TAG}) — engine, core extensions, connectors, and the community catalog, snapshotted from haybarn-status.query.farm at site-build time.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Haybarn build status — v${DUCKDB_VERSION}`,
    description,
    url: `${SITE_ORIGIN}/haybarn/status/${versionParam}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Status', item: `${SITE_ORIGIN}/haybarn/status/${versionParam}` },
    ],
  },
];
---

<PageLayout
  title={`Haybarn build status — v${DUCKDB_VERSION}`}
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    wide
    eyebrow="Build status"
    icon={{ src: '/haybarn/haybarn-mark.svg' }}
    ledeClass="mt-3.5 max-w-[62ch] text-[17.5px] leading-relaxed text-soil-700"
    hairband
  >
    <Fragment slot="title">
      Haybarn for DuckDB <span class="qf-figure text-sun-700">v{DUCKDB_VERSION}</span>
    </Fragment>

    <Fragment slot="lede">
      {data
        ? <>Snapshot fetched <span class="qf-figure text-soil-900">{formatRelative(data.fetchedAt)}</span> · tag <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.82em] text-soil-900">{HAYBARN_TAG}</code></>
        : <>Snapshot unavailable — the live dashboard is authoritative.</>}
    </Fragment>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href={STATUS_PAGE} variant="secondary" size="md" external>Live dashboard ↗</Button>
    </div>
  </PageHead>

  <!-- ── Summary statrow — on paper, family B takes no slab ──── -->
  {data && (
    <section class="py-11">
      <div class={WRAP}>
        <div class="grid overflow-hidden rounded-xl border border-soil-300 bg-[#fffdf7] sm:grid-cols-2">
          <div class="border-b border-soil-200 px-6 py-5 sm:border-b-0 sm:border-r sm:border-soil-200">
            <div class="text-[12.5px] font-medium text-soil-700">Community extensions available</div>
            <div class="mt-2.5 flex flex-wrap items-baseline gap-x-2.5">
              <span class="qf-figure text-[34px] leading-none text-sun-700">{extAvailable}</span>
              <span class="qf-figure text-base text-soil-500">of {extCount}</span>
              {anyUpstreamKnown && (
                <span class="qf-figure text-base text-soil-500">· upstream {extUpstreamAvailable}</span>
              )}
            </div>
            <p class="mt-2.5 text-xs leading-relaxed text-soil-700">
              {anyUpstreamKnown ? 'shipped binary on Haybarn vs upstream DuckDB.' : 'signed binaries shipped on Haybarn’s community channel.'}
              <a href="#community" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">See the table →</a>
            </p>
          </div>
          <div class="px-6 py-5">
            <div class="text-[12.5px] font-medium text-soil-700">Engine</div>
            <div class="mt-2.5">
              <span class={`${PILL} ${runBadgeClasses(engineCls)}`}>{runBadgeLabel(engineCls)}</span>
            </div>
            <p class="mt-2.5 text-xs leading-relaxed text-soil-700">
              latest CI run on <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.92em] text-soil-900">{HAYBARN_TAG}</code>
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  {error && (
    <section class="py-8">
      <div class={WRAP}>
        <div class="rounded-r-lg border-l-[3px] border-[#a8412a] bg-[#fdf4f1] px-5 py-4">
          <div class="text-[12.5px] font-medium text-[#a8412a]">Snapshot unavailable</div>
          <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
            Live snapshot unavailable at build time ({error}). The live dashboard at
            <a href={STATUS_PAGE} class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">{STATUS_PAGE}</a> is always authoritative.
          </p>
        </div>
      </div>
    </section>
  )}

  {data && (
    <>
      <!-- ── 1. Engine ───────────────────────────────────────── -->
      <section class="border-t border-soil-300 py-16 lg:py-[70px]">
        <div class={WRAP}>
          <span class={EYEBROW}>1. Engine</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Engine build</h2>
          <p class={`mt-3 max-w-[72ch] ${LEDE}`}>
            Haybarn builds the DuckDB engine into its own branded CLI and libraries. The status
            below is the latest engine release workflow; the status service doesn't report
            per-platform job results yet, so the target platforms are listed separately rather
            than each given a (would-be identical) badge.
          </p>

          <div class={`${CARD} mt-8 flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between`}>
            <div class="flex flex-wrap items-center gap-3">
              <span class={`${PILL} ${runBadgeClasses(engineCls)}`}>{runBadgeLabel(engineCls)}</span>
              <span class="text-sm text-soil-700">
                {engineLatest?.workflowName ? <><code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900">{engineLatest.workflowName}</code> · </> : null}
                last build <span class="qf-figure text-soil-900">{formatRelative(engineLatest?.createdAt)}</span>
              </span>
            </div>
            {engineLatest?.htmlUrl ? (
              <a href={engineLatest.htmlUrl} class="text-sm text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">View run on GitHub →</a>
            ) : (
              <span class="text-sm text-soil-500">no run recorded</span>
            )}
          </div>

          <div class="mt-6">
            <div class="mb-2.5 text-[12.5px] font-medium text-soil-500">Target platforms</div>
            <div class="flex flex-wrap gap-2">
              {ENGINE_PLATFORMS.map(p => (
                <span class="inline-block rounded-full border border-soil-300 bg-soil-100 px-2.5 py-1 font-mono text-[11px] text-soil-700">{p}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ── 2. Bindings, connectors & build-forks ───────────── -->
      <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
        <div class={WRAP}>
          <span class={EYEBROW}>2. Build pipelines</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Bindings, connectors &amp; build-forks</h2>
          <p class={`mt-3 max-w-[72ch] ${LEDE}`}>
            CI status for the language bindings and connectors Haybarn ships, plus the
            core-extension build-forks that feed the release. Components with no recorded run
            are repos that haven't started building yet.
          </p>

          {pipelineRows.length > 0 ? (
            <div class="mt-8 overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
              <table class="w-full border-collapse text-[14.5px]">
                <thead>
                  <tr>
                    <th class={TH}>Component</th>
                    <th class={TH}>Type</th>
                    <th class={TH}>Build</th>
                    <th data-numeric class={TH_R}>Last build</th>
                    <th class={TH_R}>Run</th>
                  </tr>
                </thead>
                <tbody>
                  {pipelineRows.map(row => {
                    const cls = classifyRun(row.run);
                    return (
                      <tr class={ROW}>
                        <td class="px-3.5 py-2.5 align-top">
                          <div class="text-soil-900">{row.label}</div>
                          <div class="font-mono text-[11px] text-soil-500">{row.slug}</div>
                        </td>
                        <td class="px-3.5 py-2.5 align-top font-mono text-[11px] text-soil-700">{row.kind}</td>
                        <td class="px-3.5 py-2.5 align-top">
                          <span class={`${PILL} ${runBadgeClasses(cls)}`}>{runBadgeLabel(cls)}</span>
                        </td>
                        <td data-numeric class="px-3.5 py-2.5 text-right align-top text-xs text-soil-700">{formatRelative(row.run?.createdAt)}</td>
                        <td class="px-3.5 py-2.5 text-right align-top">
                          {row.run?.htmlUrl ? (
                            <a href={row.run.htmlUrl} class="text-xs text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">GitHub →</a>
                          ) : (
                            <span class="text-xs text-soil-500">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="mt-8 text-sm text-soil-700">No binding or connector pipelines reported for this tag.</p>
          )}
        </div>
      </section>

      <!-- ── 3. Core extensions — unified table, mirrors community shape ── -->
      <section class="py-16 lg:py-[70px]">
        <div class={WRAP}>
          <span class={EYEBROW}>3. Core extensions</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Shipped on Haybarn's core channel</h2>
          <p class={`mt-3 max-w-[72ch] ${LEDE}`}>
            The extensions Haybarn builds and serves from haybarn-extensions.query.farm/core.
            Layer notes whether each ships in-tree with the engine, carries a Haybarn build-fork
            patch, or is rebuilt from upstream unchanged. Each is published as a signed npm
            package; PyPI packaging is still rolling out.
          </p>
          <p class="mt-4 text-xs text-soil-700">
            <span class="qf-figure text-soil-900">{coreAvailable} of {coreExts.length}</span> on Haybarn{anyUpstreamKnown && <> · <span class="qf-figure text-soil-900">{coreUpstreamAvailable} of {coreExts.length}</span> on upstream for v{DUCKDB_VERSION}</>}.
          </p>

          <div class="mt-6 overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
            <table class="w-full border-collapse text-[14.5px]">
              <thead>
                <tr>
                  <th class={TH}>Extension</th>
                  <th class={TH}>Layer</th>
                  <th data-numeric class={TH}>Version</th>
                  <th class={TH}>Haybarn</th>
                  {anyUpstreamKnown && <th class={TH}>Upstream</th>}
                  <th data-numeric class={TH_R}>Last update</th>
                  <th class={TH_R}>Links</th>
                </tr>
              </thead>
              <tbody>
                {coreExts.map(e => {
                  const avail = classifyAvailability(e);
                  const npmInfo  = e.registries?.npm  ?? null;
                  const pypiInfo = e.registries?.pypi ?? null;
                  const npmHref  = npmInfo?.url  || npmUrl(defaultNpmName(e.name));
                  const pypiHref = pypiInfo?.url || pypiUrl(defaultPypiName(e.name));
                  const npmLive  = npmInfo?.exists === true;
                  const pypiLive = pypiInfo?.exists === true;
                  const updatedAt = e.r2?.lastModified || e.run?.createdAt;

                  // Display version: prefer published registry version,
                  // fall back to short commit sha (engine sha for in-tree
                  // & rebuilt extensions, fork sha for build-forks).
                  const shaShort = e.commitSha ? e.commitSha.slice(0, 7) : null;
                  const displayVersion = npmInfo?.latest || pypiInfo?.latest || shaShort;
                  const versionSource = npmInfo?.latest
                    ? `npm: ${npmInfo.latest}`
                    : pypiInfo?.latest
                      ? `PyPI: ${pypiInfo.latest}`
                      : (e.layer === 'fork'
                        ? `build-fork commit: ${e.commitSha}`
                        : (e.commitSha ? `engine commit: ${e.commitSha}` : ''));
                  return (
                    <tr class={ROW}>
                      <td class="px-3.5 py-2.5 align-top font-mono text-[13px] text-soil-900">{e.name}</td>
                      <td class="px-3.5 py-2.5 align-top">
                        <span class="font-mono text-[11px] text-soil-700">{e.layer ? (LAYER_LABEL[e.layer] || e.layer) : '—'}</span>
                      </td>
                      <td data-numeric class="px-3.5 py-2.5 align-top" title={versionSource}>
                        {displayVersion ? (
                          <span class="inline-block rounded border border-soil-200 bg-soil-50 px-1.5 py-0.5 text-xs text-soil-700">{displayVersion}</span>
                        ) : (
                          <span class="text-xs text-soil-500">—</span>
                        )}
                      </td>
                      <td class="px-3.5 py-2.5 align-top">
                        <span class={`${PILL} ${availBadgeClasses(avail)}`}>{availBadgeLabel(avail)}</span>
                      </td>
                      {anyUpstreamKnown && (
                        <td class="px-3.5 py-2.5 align-top">
                          {(() => { const b = upstreamBadge(e.upstream); return (
                            <span class={`${PILL} ${b.cls}`} title={b.title}>{b.label}</span>
                          ); })()}
                        </td>
                      )}
                      <td data-numeric class="px-3.5 py-2.5 text-right align-top text-xs text-soil-700">{formatRelative(updatedAt)}</td>
                      <td class="px-3.5 py-2.5 text-right align-top">
                        <div class="inline-flex items-center gap-2">
                          <a
                            href={npmHref}
                            class:list={['inline-flex rounded p-1 transition-colors hover:bg-soil-100', npmLive ? 'text-soil-700' : 'text-soil-300']}
                            title={npmLive ? `npm: ${defaultNpmName(e.name)} @ ${npmInfo?.latest}` : 'npm package — not yet published'}
                            aria-label={`npm package for ${e.name}`}
                            target="_blank"
                            rel="noopener"
                          >
                            <Icon name="simple-icons:npm" class="w-4 h-4" />
                          </a>
                          <a
                            href={pypiHref}
                            class:list={['inline-flex rounded p-1 transition-colors hover:bg-soil-100', pypiLive ? 'text-soil-700' : 'text-soil-300']}
                            title={pypiLive ? `PyPI: ${defaultPypiName(e.name)} @ ${pypiInfo?.latest}` : 'PyPI package — not yet published'}
                            aria-label={`PyPI package for ${e.name}`}
                            target="_blank"
                            rel="noopener"
                          >
                            <Icon name="simple-icons:pypi" class="w-4 h-4" />
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ── 4. Community extensions ─────────────────────────── -->
      <section id="community" class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
        <div class={WRAP}>
          <span class={EYEBROW}>4. Community extensions</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Mirrored from duckdb/community-extensions</h2>
          <p class={`mt-3 max-w-[72ch] ${LEDE}`}>
            {anyUpstreamKnown
              ? "Haybarn rebuilds every extension upstream lists. Each row shows whether the binary is currently available on Haybarn and on upstream DuckDB's CDN — if both are unavailable for an extension, it's usually waiting on an upstream change for the new DuckDB version, the same situation those users face on DuckDB itself."
              : "Haybarn rebuilds every extension upstream lists and signs the result for the Haybarn engine. Each row shows whether the binary is currently available on Haybarn's community channel for this version."}
          </p>

          <p class="mt-4 max-w-[72ch] text-sm leading-relaxed text-soil-700">
            Haybarn's catalog has <span class="qf-figure text-soil-900">{extCount}</span> extensions — the same set as <a href="https://github.com/duckdb/community-extensions" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link"><code class="font-mono text-[0.92em]">duckdb/community-extensions</code></a>. <span class="qf-figure text-soil-900">{extAvailable}</span> built and signed for Haybarn{anyUpstreamKnown && <> · <span class="qf-figure text-soil-900">{extUpstreamAvailable}</span> shipped by upstream for v{DUCKDB_VERSION}</>}.
          </p>

          <div class="mt-6 mb-4 flex flex-wrap items-center justify-between gap-4">
            <p class="text-sm text-soil-700">
              Showing <span id="community-visible-count" class="qf-figure text-soil-900">—</span> of <span class="qf-figure text-soil-900">{extCount}</span> extensions
              <span id="community-filter-label" class="text-soil-500"></span>
            </p>
            {anyUpstreamKnown && (
              <label class="inline-flex cursor-pointer select-none items-center gap-2">
                <input
                  id="community-only-divergent"
                  type="checkbox"
                  class="h-4 w-4 rounded border-soil-300 accent-field-700 focus:ring-[3px] focus:ring-sun-400/25"
                />
                <span class="text-sm text-soil-700">Only show where Haybarn and upstream differ</span>
              </label>
            )}
          </div>

          <div class="overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
            <table class="w-full border-collapse text-[14.5px]">
              <thead>
                <tr>
                  <th class={TH}>Extension</th>
                  <th data-numeric class={TH}>Version</th>
                  <th class={TH}>Haybarn</th>
                  {anyUpstreamKnown && <th class={TH}>Upstream</th>}
                  <th data-numeric class={TH_R}>Last update</th>
                  <th class={TH_R}>Links</th>
                </tr>
              </thead>
              <tbody id="community-tbody">
                {exts.map(e => {
                  const avail = classifyAvailability(e);
                  const npmInfo  = e.registries?.npm  ?? null;
                  const pypiInfo = e.registries?.pypi ?? null;
                  const r2Info   = e.r2 ?? null;
                  const npmHref  = npmInfo?.url  || npmUrl(defaultNpmName(e.name));
                  const pypiHref = pypiInfo?.url || pypiUrl(defaultPypiName(e.name));
                  const npmLive  = npmInfo?.exists === true;
                  const pypiLive = pypiInfo?.exists === true;

                  // Visible version: the Haybarn-published version (CalVer or
                  // descriptor semver, whichever the build pipeline stamped on
                  // the package). Tooltip carries the upstream sha + the
                  // descriptor's own version, both useful for supply-chain
                  // review.
                  const haybarnVersion = npmInfo?.latest || pypiInfo?.latest || null;
                  const tooltipParts: string[] = [];
                  if (e.commitSha) tooltipParts.push(`upstream commit ${e.commitSha}`);
                  if (e.version)   tooltipParts.push(`descriptor version ${e.version}`);
                  if (e.repo?.github) tooltipParts.push(e.repo.github);
                  const titleAttr = tooltipParts.join('  ·  ');

                  // "Last update" prefers R2's lastModified (when the binary
                  // was actually published) and falls back to the latest CI
                  // run timestamp.
                  const updatedAt = r2Info?.lastModified || e.run?.createdAt;

                  // Divergence: Haybarn and upstream disagree on availability.
                  // Convergent rows (both ✓ or both ✗) are the boring ones —
                  // we filter them out by default so the actionable list pops.
                  const haybarnAvail  = avail === 'available';
                  const upstreamAvail = e.upstream?.exists === true;
                  const upstreamKnown = e.upstream != null;
                  const divergent = upstreamKnown && (haybarnAvail !== upstreamAvail);

                  return (
                    <tr class={ROW} data-avail={avail} data-divergent={divergent ? 'true' : 'false'}>
                      <td class="px-3.5 py-2.5 align-top font-mono text-[13px] text-soil-900" title={titleAttr}>
                        <span>{e.name}</span>
                      </td>
                      <td data-numeric class="px-3.5 py-2.5 align-top" title={titleAttr}>
                        {haybarnVersion ? (
                          <span class="inline-block rounded border border-soil-200 bg-soil-50 px-1.5 py-0.5 text-xs text-soil-700">{haybarnVersion}</span>
                        ) : (
                          <span class="text-xs text-soil-500">—</span>
                        )}
                      </td>
                      <td class="px-3.5 py-2.5 align-top">
                        <span class={`${PILL} ${availBadgeClasses(avail)}`}>{availBadgeLabel(avail)}</span>
                      </td>
                      {anyUpstreamKnown && (
                        <td class="px-3.5 py-2.5 align-top">
                          {(() => { const b = upstreamBadge(e.upstream); return (
                            <span class={`${PILL} ${b.cls}`} title={b.title}>{b.label}</span>
                          ); })()}
                        </td>
                      )}
                      <td data-numeric class="px-3.5 py-2.5 text-right align-top text-xs text-soil-700">{formatRelative(updatedAt)}</td>
                      <td class="px-3.5 py-2.5 text-right align-top">
                        <div class="inline-flex items-center gap-2">
                          <a
                            href={npmHref}
                            class:list={['inline-flex rounded p-1 transition-colors hover:bg-soil-100', npmLive ? 'text-soil-700' : 'text-soil-300']}
                            title={npmLive ? `npm: ${defaultNpmName(e.name)} @ ${npmInfo?.latest}` : 'npm package — not yet published'}
                            aria-label={`npm package for ${e.name}`}
                            target="_blank"
                            rel="noopener"
                          >
                            <Icon name="simple-icons:npm" class="w-4 h-4" />
                          </a>
                          <a
                            href={pypiHref}
                            class:list={['inline-flex rounded p-1 transition-colors hover:bg-soil-100', pypiLive ? 'text-soil-700' : 'text-soil-300']}
                            title={pypiLive ? `PyPI: ${defaultPypiName(e.name)} @ ${pypiInfo?.latest}` : 'PyPI package — not yet published'}
                            aria-label={`PyPI package for ${e.name}`}
                            target="_blank"
                            rel="noopener"
                          >
                            <Icon name="simple-icons:pypi" class="w-4 h-4" />
                          </a>
                          {e.repo?.github ? (
                            <a
                              href={`https://github.com/${e.repo.github}`}
                              class="inline-flex rounded p-1 text-soil-700 transition-colors hover:bg-soil-100"
                              title={`upstream repo: ${e.repo.github}`}
                              aria-label={`upstream repo for ${e.name}`}
                              target="_blank"
                              rel="noopener"
                            >
                              <Icon name="simple-icons:github" class="w-4 h-4" />
                            </a>
                          ) : (
                            <span class="inline-flex p-1 text-soil-300"><Icon name="simple-icons:github" class="w-4 h-4" /></span>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <p class="mx-auto mt-6 max-w-[72ch] text-center text-xs leading-relaxed text-soil-700">
            A failing build usually means the upstream community extension hasn't yet been adapted for DuckDB v{DUCKDB_VERSION} or has a build-system issue the Haybarn CI exposes. Click through to the GitHub run for per-platform job detail.
          </p>
        </div>
      </section>
    </>
  )}
</PageLayout>

<script>
  function setupCommunityFilter() {
    const tbody = document.getElementById('community-tbody');
    if (!tbody) return;
    // The divergence checkbox only exists when upstream data is available.
    // Without it, we still populate the visible count (showing every row).
    const cb = document.getElementById('community-only-divergent') as HTMLInputElement | null;
    const countEl = document.getElementById('community-visible-count');
    const labelEl = document.getElementById('community-filter-label');

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-avail]'));

    function update() {
      const onlyDivergent = cb?.checked ?? false;
      let visible = 0;
      for (const row of rows) {
        // Default: show every row so the breadth of success is visible.
        // Toggle on to narrow down to the rows where Haybarn ≠ upstream.
        const divergent = row.dataset.divergent === 'true';
        const hide = onlyDivergent && !divergent;
        row.style.display = hide ? 'none' : '';
        if (!hide) visible++;
      }
      if (countEl) countEl.textContent = String(visible);
      if (labelEl) labelEl.textContent = onlyDivergent
        ? ' — rows where Haybarn and upstream differ'
        : '';
    }

    cb?.addEventListener('change', update);
    update();
  }

  setupCommunityFilter();
  document.addEventListener('astro:after-swap', setupCommunityFilter);
</script>
