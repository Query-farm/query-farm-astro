---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL, LATEST_DUCKDB_VERSION, LATEST_PKG_SUFFIX } from '../../data/haybarn-versions';

const EXT_HOST = 'haybarn-extensions.query.farm';

const installCore = `-- Core channel: extensions built with the Haybarn engine.
INSTALL httpfs;
LOAD httpfs;

-- Then query files over HTTPS using the normal DuckDB workflow.
SELECT *
FROM read_csv('https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv')
LIMIT 10;`;

const installCommunity = `-- Community channel: rebuilt from duckdb/community-extensions.
INSTALL h3 FROM community;
LOAD h3;

SELECT h3_latlng_to_cell(37.7887, -122.3931, 9);`;

const pinNpm = `// Roadmap: lockfile-managed extension packages.
{
  "dependencies": {
    "haybarn": "^${LATEST_DUCKDB_VERSION}",
    "@haybarn/ext-httpfs-${LATEST_PKG_SUFFIX}": "^0.5.0"
  }
}`;

const pinPip = `# Roadmap: lockfile-managed extension packages.
haybarn==${LATEST_DUCKDB_VERSION}
haybarn-extension-httpfs-${LATEST_PKG_SUFFIX}==0.5.0`;

const phases = [
  {
    status: 'In progress',
    statusClass: 'bg-amber-100 text-amber-800 border-amber-300',
    title: 'npm and PyPI packages',
    description: 'Publish signed extension binaries through package registries so teams can pin them in lockfiles.'
  },
  {
    status: 'Planned',
    statusClass: 'bg-soil-100 text-soil-700 border-soil-300',
    title: 'Runtime discovery',
    description: 'Python and Node packages discover installed extension packages without changing normal SQL.'
  },
  {
    status: 'Planned',
    statusClass: 'bg-soil-100 text-soil-700 border-soil-300',
    title: 'Broader embedding support',
    description: 'Extend package discovery to embedded Haybarn use cases beyond the CLI and wrappers.'
  }
];

const comparison = [
  { label: 'Install syntax', duckdb: 'INSTALL …; LOAD …;', haybarn: 'Same SQL' },
  { label: 'Default origin', duckdb: 'extensions.duckdb.org', haybarn: EXT_HOST },
  { label: 'Trust root', duckdb: 'DuckDB Foundation key', haybarn: 'Haybarn key' },
  { label: 'Cache directory', duckdb: '~/.duckdb/extensions/', haybarn: '~/.haybarn/extensions/' },
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Haybarn rebuilds core and community DuckDB extensions against the Haybarn engine, signs them with the Haybarn key, and serves them through a production extension channel.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Haybarn extensions',
    description,
    url: `${SITE_ORIGIN}/haybarn/extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Extensions', item: SITE_ORIGIN + '/haybarn/extensions' },
    ],
  },
];
---

<PageLayout
  title="Haybarn extensions — signed DuckDB extensions for production"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-12 font-display lg:py-20">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-grain-500"></span>
          Signed extension ecosystem
        </div>
        <SectionHeader
          align="center"
          eyebrow="Extensions"
          title="Signed DuckDB extensions for Haybarn"
          description="Haybarn rebuilds core and community DuckDB extensions against the Haybarn engine, signs them with the Haybarn key, and serves them from a production extension channel."
        />
      </div>
    </div>
  </section>

  <!-- Today: how INSTALL works -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="Today"
          title="Same INSTALL and LOAD, Haybarn trust behind it"
          description={`Haybarn resolves extensions from ${EXT_HOST}, verifies signatures with the Haybarn key, and caches binaries under ~/.haybarn/extensions/.`}
          class="mb-6"
        />
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="text-sm font-semibold text-soil-900 uppercase tracking-wider mb-2">Core extension</h3>
            <CodeBlock code={installCore} lang="sql" title="Haybarn shell" />
          </div>
          <div>
            <h3 class="text-sm font-semibold text-soil-900 uppercase tracking-wider mb-2">Community extension</h3>
            <CodeBlock code={installCommunity} lang="sql" title="Haybarn shell" />
          </div>
        </div>
        <p class="mt-5 text-sm leading-relaxed text-soil-600">
          Core extensions are built with the engine release. Community extensions are rebuilt from the upstream DuckDB community catalog and served from the <code class="font-mono text-earth-700">community</code> channel.
        </p>
      </div>
    </div>
  </section>

  <!-- Build status link -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <Card padding="lg" class="flex flex-col md:flex-row items-start md:items-center gap-6">
          <div class="flex-1">
            <p class="mb-2 text-sm font-bold uppercase tracking-wider text-harvest-700">Build matrix</p>
            <h3 class="text-2xl font-bold text-soil-900 mb-2">Which extensions are ready right now?</h3>
            <p class="text-soil-700 text-sm leading-relaxed">
              Haybarn tracks engine builds, core extension builds, and community extension builds for each release so teams can see what is ready before rollout.
            </p>
          </div>
          <Button href={LATEST_STATUS_URL} variant="primary" size="md">
            See the build matrix →
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Side by side -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="Side by side"
          title="What changes from DuckDB?"
          description="The SQL stays familiar. The origin, trust root, and cache location move to Haybarn. DuckDB-signed extensions do not load against Haybarn; Haybarn verifies extensions with its own key."
          class="mb-10"
        />
        <div class="overflow-hidden rounded-xl border border-soil-200">
        <table class="w-full text-sm">
          <thead class="bg-soil-100 text-soil-900">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">&nbsp;</th>
              <th class="text-left px-4 py-3 font-semibold">DuckDB</th>
              <th class="text-left px-4 py-3 font-semibold">Haybarn</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-soil-200 bg-white">
            {comparison.map(row => (
              <tr>
                <td class="px-4 py-3 font-medium text-soil-900">{row.label}</td>
                <td class="px-4 py-3 text-soil-700 font-mono text-xs">{row.duckdb}</td>
                <td class="px-4 py-3 text-soil-700 font-mono text-xs">{row.haybarn}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="Roadmap"
          title="Lockfile-managed extensions are coming"
          description="The signed HTTP channel remains the source of truth. npm and PyPI packaging will make extension versions easier to pin, mirror, and review."
          class="mb-10"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {phases.map(p => (
            <Card padding="lg">
              <div class="mb-3">
                <span class={`inline-block px-2 py-0.5 rounded-full border text-xs font-mono ${p.statusClass}`}>{p.status}</span>
              </div>
              <h3 class="text-base font-bold text-soil-900 mb-2">{p.title}</h3>
              <p class="text-sm text-soil-700 leading-relaxed">{p.description}</p>
            </Card>
          ))}
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <div>
            <div class="mb-2 inline-flex rounded-md bg-amber-100 px-2 py-1 text-xs font-bold uppercase tracking-wider text-amber-800 ring-1 ring-amber-300">
              Coming soon
            </div>
            <CodeBlock code={pinNpm} lang="json" title="package.json" />
          </div>
          <div>
            <div class="mb-2 inline-flex rounded-md bg-amber-100 px-2 py-1 text-xs font-bold uppercase tracking-wider text-amber-800 ring-1 ring-amber-300">
              Coming soon
            </div>
            <CodeBlock code={pinPip} lang="text" title="requirements.txt" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-harvest-700">Expert help</p>
          <h2 class="mb-4 text-3xl font-bold text-soil-900 md:text-4xl">
            Need a private extension channel?
          </h2>
          <p class="text-lg leading-relaxed text-soil-700">
            We help teams with internal mirrors, private signing workflows, custom extension CI, and controlled rollout.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href="/consulting" variant="primary" size="md">
            Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a call
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
