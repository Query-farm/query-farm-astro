---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import { LATEST_STATUS_URL, LATEST_DUCKDB_VERSION, LATEST_PKG_SUFFIX } from '../../data/haybarn-versions';

const EXT_HOST = 'haybarn-extensions.query.farm';

const installSqlToday = `-- Today: same as DuckDB. Haybarn resolves the binary from
-- haybarn-extensions.query.farm and verifies the signature
-- against the Haybarn key on load.
INSTALL iceberg;
LOAD iceberg;`;

const pinNpm = `// package.json — coming with ${LATEST_DUCKDB_VERSION} GA
{
  "dependencies": {
    "haybarn": "^${LATEST_DUCKDB_VERSION}",
    "@haybarn/ext-iceberg-${LATEST_PKG_SUFFIX}": "^0.5.0"
  }
}`;

const pinPip = `# requirements.txt — coming with ${LATEST_DUCKDB_VERSION} GA
haybarn==${LATEST_DUCKDB_VERSION}
haybarn-extension-iceberg-${LATEST_PKG_SUFFIX}==0.5.0`;

const phases = [
  {
    label: 'Phase 1',
    status: 'In progress',
    statusClass: 'bg-amber-100 text-amber-800 border-amber-300',
    title: 'Packaging pipeline',
    description: 'After each extension build, CI emits per-platform npm leaf packages, an npm meta-package, and per-platform PyPI data wheels. Same signed binary, two extra publish surfaces.'
  },
  {
    label: 'Phase 2',
    status: 'Planned',
    statusClass: 'bg-soil-100 text-soil-700 border-soil-300',
    title: 'Wrapper-side resolver',
    description: 'The Haybarn Python and Node packages discover installed extension packages and point a file:// custom repository at them — no core engine change, signature verification path unchanged.'
  },
  {
    label: 'Phase 3',
    status: 'Planned',
    statusClass: 'bg-soil-100 text-soil-700 border-soil-300',
    title: 'In-engine search path',
    description: 'The Haybarn engine itself searches node_modules and site-packages for installed extensions. Covers C/C++ embeddings, Go services, JDBC, and the bare CLI in one pass.'
  }
];

const comparison = [
  { label: 'Cache directory', duckdb: '~/.duckdb/extensions/', haybarn: '~/.haybarn/extensions/' },
  { label: 'Trust root', duckdb: 'DuckDB Foundation key', haybarn: 'Haybarn RSA key' },
  { label: 'Default origin', duckdb: 'extensions.duckdb.org', haybarn: EXT_HOST },
  { label: 'Install syntax (today)', duckdb: 'INSTALL …; LOAD …;', haybarn: 'INSTALL …; LOAD …;' },
  { label: 'Extension file format', duckdb: '.duckdb_extension', haybarn: '.duckdb_extension' },
  { label: 'PyPI / npm packaging', duckdb: 'No', haybarn: 'Planned (GA)' },
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Haybarn rebuilds every DuckDB extension against the Haybarn engine and ships them through a signed extension channel — with a roadmap to publish every one as a PyPI wheel and npm package that lives in your lockfile.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Haybarn extensions',
    description,
    url: `${SITE_ORIGIN}/haybarn/extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Haybarn', item: SITE_ORIGIN + '/haybarn' },
      { '@type': 'ListItem', position: 3, name: 'Extensions', item: SITE_ORIGIN + '/haybarn/extensions' },
    ],
  },
];
---

<PageLayout
  title="Haybarn extensions — packaged the way your team already ships software"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 py-12 lg:py-20">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="Extensions"
          title="Packaged the way your team already ships software"
          description="Haybarn rebuilds the DuckDB community extension catalog against the Haybarn engine, re-signs every binary, and is on its way to publishing them as ordinary PyPI wheels and npm packages — so DuckDB extensions live in lockfiles, not a separate sideband."
        />
      </div>
    </div>
  </section>

  <!-- PyPI / npm (lead section — the enterprise hook) -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center px-2 py-1 rounded-md bg-grain-100 text-grain-800 text-xs font-mono uppercase tracking-wider">Roadmap</span>
        </div>
        <SectionHeader
          eyebrow="The plan"
          title="Every extension on PyPI and npm"
          class="mb-6"
        />
        <p class="text-lg text-soil-700 leading-relaxed mb-8">
          Today extensions arrive over HTTP from <code class="font-mono text-earth-700">{EXT_HOST}</code>. The Haybarn extension roadmap extends that delivery channel with versioned, per-platform PyPI wheels and npm packages, so extensions plug into the dependency-management workflows teams already use — pinnable, mirrorable, and reviewable like any other dependency.
        </p>

        <div class="grid md:grid-cols-2 gap-6 mb-10">
          <div>
            <h3 class="text-sm font-semibold text-soil-900 uppercase tracking-wider mb-2">npm</h3>
            <CodeBlock code={pinNpm} lang="json" title="package.json" />
          </div>
          <div>
            <h3 class="text-sm font-semibold text-soil-900 uppercase tracking-wider mb-2">pip</h3>
            <CodeBlock code={pinPip} lang="text" title="requirements.txt" />
          </div>
        </div>

        <p class="text-soil-700 leading-relaxed mb-4">
          The mechanism is the standard native-addon pattern: a meta-package whose <code class="font-mono text-earth-700">optionalDependencies</code> (npm) or platform-tagged wheels (PyPI) install only the correct binary for the platform. <strong>No postinstall scripts.</strong> No fetching at install time. The Haybarn ABI lives in the package-name suffix (<code class="font-mono text-earth-700">-{LATEST_PKG_SUFFIX}</code>) so a Haybarn upgrade is a deliberate dependency bump, not a surprise.
        </p>
        <p class="text-soil-700 leading-relaxed">
          <strong>Importantly:</strong> the registries are a transport, not a new trust boundary. Every shipped <code class="font-mono text-earth-700">.duckdb_extension</code> is the same RSA-signed binary the Haybarn engine verifies at load time. Lockfile sha256 + Haybarn key gives you a clean trust path with no GPG-on-metadata layer to manage.
        </p>
      </div>
    </div>
  </section>

  <!-- Phased rollout -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Rollout"
        title="Three phases, no flag day"
        class="mb-10"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {phases.map(p => (
          <Card padding="lg">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono uppercase tracking-wider text-soil-500">{p.label}</span>
              <span class={`inline-block px-2 py-0.5 rounded-full border text-xs font-mono ${p.statusClass}`}>{p.status}</span>
            </div>
            <h3 class="text-base font-bold text-soil-900 mb-2">{p.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{p.description}</p>
          </Card>
        ))}
      </div>
      <p class="text-center text-sm text-soil-600 mt-8 max-w-3xl mx-auto">
        The existing HTTP channel keeps working through all three phases. PyPI/npm publishing is additive, not a migration.
      </p>
    </div>
  </section>

  <!-- Today: how INSTALL works -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          eyebrow="Today"
          title="INSTALL and LOAD work the way they always have"
          class="mb-6"
        />
        <CodeBlock code={installSqlToday} lang="sql" title="install-extension.sql" />
        <p class="text-sm text-soil-600 mt-4 leading-relaxed">
          Behind the scenes, Haybarn fetches the binary from <code class="font-mono text-earth-700">{EXT_HOST}</code>, verifies it against the Haybarn signing key, and caches it at <code class="font-mono text-earth-700">~/.haybarn/extensions/</code>. Two channels are available: <strong>core</strong> (in-tree extensions shipped with the engine release) and <strong>community</strong> (a rebuilt mirror of <code class="font-mono text-earth-700">duckdb/community-extensions</code>).
        </p>
      </div>
    </div>
  </section>

  <!-- Build status link -->
  <section class="py-12 lg:py-16 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <Card padding="lg" class="flex flex-col md:flex-row items-start md:items-center gap-6">
          <div class="flex-1">
            <h3 class="text-xl font-bold text-soil-900 mb-2">Which extensions are ready right now?</h3>
            <p class="text-soil-700 text-sm leading-relaxed">
              Build status for the engine, bindings, core forks, and every community extension Haybarn rebuilds — pulled live from <code class="font-mono text-earth-700">haybarn-status.query.farm</code>.
            </p>
          </div>
          <Button href={LATEST_STATUS_URL} variant="primary" size="md">
            See the build matrix →
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- DuckDB vs Haybarn comparison -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Side by side"
        title="DuckDB extensions vs. Haybarn extensions"
        class="mb-10"
      />
      <div class="max-w-4xl mx-auto overflow-hidden rounded-xl border border-soil-200">
        <table class="w-full text-sm">
          <thead class="bg-soil-100 text-soil-900">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">&nbsp;</th>
              <th class="text-left px-4 py-3 font-semibold">DuckDB</th>
              <th class="text-left px-4 py-3 font-semibold">Haybarn</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-soil-200 bg-white">
            {comparison.map(row => (
              <tr>
                <td class="px-4 py-3 font-medium text-soil-900">{row.label}</td>
                <td class="px-4 py-3 text-soil-700 font-mono text-xs">{row.duckdb}</td>
                <td class="px-4 py-3 text-soil-700 font-mono text-xs">{row.haybarn}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cross-link to Query.Farm extensions -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-3">Looking for the extensions Query.Farm publishes?</h3>
          <p class="text-soil-700 leading-relaxed mb-6">
            Query.Farm maintains a catalog of DuckDB extensions — connectors, transformations, scripting, sketches, and more. Most are available on both upstream DuckDB and Haybarn (Haybarn re-signs them with its own key before publishing).
          </p>
          <Button href="/products/extensions" variant="primary" size="md">
            Browse Query.Farm extensions →
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Need a private extension channel?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Air-gapped mirrors, internal signing keys, custom CI for your own extensions — we can stand it up for your team.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">
          Consulting
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
