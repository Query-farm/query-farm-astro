---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV || process.env.INCLUDE_DRAFTS === 'true';
  return (await getCollection('tutorials'))
    .filter(tutorial => includeDrafts || !tutorial.data.draft)
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'tutorials'> }
const { entry } = Astro.props;
---
<ArticleLayout entry={entry} />
