---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { marked } from 'marked';

// Governs the website and documentation only. Software licensing lives with
// each repository's own LICENSE — see /licenses/source-available.
const lastUpdated = 'August 10, 2026';

const termsText = `## 1. Agreement

