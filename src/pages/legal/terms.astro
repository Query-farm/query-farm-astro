const termsHtml = marked(termsText, { async: false }) as string;

const summary = [
  { ok: true, text: 'Read, link to, and share the documentation; use the code samples in your own projects.' },
  { ok: true, text: 'Try any extension in the in-browser shell — it runs locally, for evaluation.' },
  { ok: false, text: 'Scrape, probe, or overload the site, or misrepresent an affiliation with us.' },
  { ok: false, text: 'Treat these Terms as a software license — each repository ships its own.' }
];

const SITE_ORIGIN = 'https://query.farm';
const description = "The terms governing use of query.farm — the documentation, the in-browser SQL shell, and the site's content.";
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Service',
    description,
    url: `${SITE_ORIGIN}/legal/terms`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: SITE_ORIGIN + '/legal/terms' },
    ],
  },
];
---

<PageLayout
  title="Terms of Service"
  description={description}
  jsonLd={jsonLd}
>
  <PageHead
    title="Terms of Service"
    hairband
  >
    <p class="mt-6 qf-figure text-sm text-soil-600">Last updated {lastUpdated} · Query Farm LLC</p>
  </PageHead>

  <section class="pt-12 pb-20">
    <div class="mx-auto max-w-[820px] px-6">
      <p class="text-[17.5px] leading-relaxed text-soil-700">
        These terms cover the <em>website</em> — the documentation you are reading, the in-browser SQL
        shell, and everything published here. They are deliberately not a software license: each
        Query.Farm extension is governed by the license that ships with it, such as the
        <a href="/licenses/source-available" class="text-link no-underline underline-offset-2 hover:underline">Query Farm Source-Available License</a>.
      </p>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {summary.map((s) => (
          <div class={`flex items-start gap-2.5 rounded-lg border bg-[#fffdf7] p-3.5 text-sm ${s.ok ? 'border-field-400/50' : 'border-[#a8412a]/40'}`}>
            <span class={`mt-0.5 shrink-0 font-semibold ${s.ok ? 'text-field-700' : 'text-[#a8412a]'}`} aria-hidden="true">{s.ok ? '✓' : '✕'}</span>
            <span class="text-soil-700">{s.text}</span>
          </div>
        ))}
      </div>

      <p class="mt-4 text-[13.5px] text-soil-600">
        This summary is an informal overview, not legal advice — the full text below governs. See also
        the <a href="/legal/privacy" class="text-link no-underline underline-offset-2 hover:underline">Privacy Policy</a>.
      </p>

      <hr class="my-10 border-0 border-t border-soil-300" />

      <div class="qf-legal" set:html={termsHtml} />
    </div>
  </section>
</PageLayout>

<style is:global>
  /* Legal prose: quieter than the editorial measure, same type system. */
  .qf-legal { font-size: 16px; line-height: 1.75; }
  .qf-legal > * + * { margin-top: 16px; }
  .qf-legal p { color: var(--color-soil-700); }
  .qf-legal h2 {
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid var(--color-soil-300);
    font-size: 21px;
  }
  .qf-legal h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .qf-legal a { color: var(--color-link); text-decoration: none; border-bottom: 1px solid rgba(69, 99, 47, 0.4); }
  .qf-legal a:hover { color: var(--color-link-hover); border-bottom-color: var(--color-link-hover); }
  .qf-legal ul, .qf-legal ol { padding-left: 22px; }
  .qf-legal ul { list-style: disc; }
  .qf-legal ol { list-style: decimal; }
  .qf-legal li { margin-top: 6px; color: var(--color-soil-700); }
  .qf-legal strong { color: var(--color-soil-900); font-weight: 600; }
  .qf-legal code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.86em;
    background: var(--color-soil-100);
    padding: 2px 6px;
    border-radius: 5px;
  }
</style>
