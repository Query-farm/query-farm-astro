---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm builds DuckDB extensions and VGI — the Vector Gateway Interface for extending DuckDB in any language. Plus consulting for teams shipping serious data infrastructure.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://twitter.com/queryfarm',
      'https://linkedin.com/company/queryfarm',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <Hero
    title="DuckDB Extensions & Data Infrastructure for Modern Teams"
    subtitle="Build powerful data systems with our ecosystem of 20+ extensions, managed services, and expert consulting."
    primaryCTA={{ text: "Explore Extensions", href: "/products/extensions" }}
    secondaryCTA={{ text: "Schedule a Demo", href: "/company/schedule" }}
  />

  <!-- Value Proposition -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Why Query.Farm"
        title="Everything You Need for DuckDB Success"
        description="From extensions to infrastructure, we provide the complete toolkit for building modern data systems."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-earth-100 flex items-center justify-center text-4xl">
            🔌
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">20+ Extensions</h3>
          <p class="text-soil-700 leading-relaxed">
            Connect to any data source, transform with specialized functions, and optimize performance with our comprehensive extension library.
          </p>
          <Button href="/products/extensions" variant="ghost" size="sm" class="mt-4">
            Browse Extensions →
          </Button>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
            🌐
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Vector Gateway Interface</h3>
          <p class="text-soil-700 leading-relaxed">
            Extend DuckDB with functionality in Python, TypeScript, Go, Rust, Java, or C++. Apache Arrow is the cross-language glue.
          </p>
          <Button href="/vgi" variant="ghost" size="sm" class="mt-4">
            Learn About VGI →
          </Button>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-duck-100 flex items-center justify-center text-4xl">
            🤝
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Expert Consulting</h3>
          <p class="text-soil-700 leading-relaxed">
            Our team helps you architect, implement, and optimize DuckDB solutions. Get expert guidance for your data infrastructure challenges.
          </p>
          <Button href="/consulting" variant="ghost" size="sm" class="mt-4">
            Get Started →
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Product Overview -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="What We Build"
        title="DuckDB, Extended"
        description="A growing library of DuckDB extensions, plus VGI — the language-agnostic protocol for writing extensions in any language."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-12">
        <!-- Extensions -->
        <Card variant="featured" padding="lg" class="lg:col-span-2">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-lg bg-earth-600 flex items-center justify-center text-3xl">
              🔧
            </div>
            <div>
              <h3 class="text-2xl font-bold text-soil-900 mb-2">DuckDB Extensions</h3>
              <p class="text-soil-600">Extend DuckDB with specialized capabilities</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="flex items-start">
              <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <p class="font-medium text-soil-900">Data Connectors</p>
                <p class="text-sm text-soil-600">Arrow Flight, Redis, HTTP, and more</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <p class="font-medium text-soil-900">Transformations</p>
                <p class="text-sm text-soil-600">JSON, Geo, Crypto, Templating</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <p class="font-medium text-soil-900">Analytics & Sketches</p>
                <p class="text-sm text-soil-600">Datasketches, fuzzy matching, hashing</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <p class="font-medium text-soil-900">Scripting & Eval</p>
                <p class="text-sm text-soil-600">QuickJS, Rhai, Tera, MiniJinja</p>
              </div>
            </div>
          </div>

          <Button href="/products/extensions" variant="primary" size="md">
            Browse All Extensions
          </Button>
        </Card>

        <!-- VGI -->
        <Card padding="lg" class="flex flex-col">
          <div class="w-12 h-12 mb-4 rounded-lg bg-harvest-600 flex items-center justify-center text-3xl">
            🌐
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-2">VGI</h3>
          <p class="text-sm text-soil-500 mb-3">Vector Gateway Interface</p>
          <p class="text-soil-700 mb-4 flex-1">
            Extend DuckDB with functionality in Python, TypeScript, Go, Rust, Java, or C++. Apache Arrow is the cross-language glue.
          </p>
          <Button href="/vgi" variant="secondary" size="md" class="w-full justify-center">
            Explore VGI
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  {latestPosts.length > 0 && (
    <section class="py-16 lg:py-24 bg-white">
      <div class="section-container">
        <div class="flex items-center justify-between mb-12">
          <SectionHeader
            eyebrow="From the Blog"
            title="Latest Updates"
            description="News, releases, and insights from the Query.Farm team."
          />
          <Button href="/blog" variant="ghost" size="md" class="hidden md:inline-flex">
            View All Posts →
          </Button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              author={post.data.author}
              tags={post.data.tags}
              slug={post.id}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>

        <div class="mt-8 text-center md:hidden">
          <Button href="/blog" variant="ghost" size="md">
            View All Posts →
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-earth-600 to-harvest-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Ready to Transform Your Data Infrastructure?
      </h2>
      <p class="text-xl md:text-2xl text-earth-50 mb-8 max-w-3xl mx-auto">
        Join teams building modern data systems with DuckDB and Query.Farm.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/schedule" variant="secondary" size="lg">
          Schedule a Meeting
        </Button>
        <Button href="/products/extensions" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Explore Extensions
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
