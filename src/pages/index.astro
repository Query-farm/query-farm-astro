---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

// Get latest blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const extensionCount = publicExtensions.length;
const extensionLoads = usageSummary?.totalLast365Days;
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};

const platformComponents = [
  {
    icon: '🔌',
    title: 'Extensions',
    eyebrow: `${extensionCount} installable capabilities`,
    outcome: 'Connect systems and add SQL capabilities.',
    description: 'Install connectors, transformations, sketches, scripting, geospatial, JSON, text, and operational tools without building native extension plumbing yourself.',
    href: '/products/extensions',
    cta: 'Browse extensions',
    color: 'bg-earth-100 text-earth-800',
  },
  {
    icon: '🌐',
    title: 'VGI',
    eyebrow: 'Vector Gateway Interface',
    outcome: 'Run custom or reusable workers from SQL.',
    description: 'Make APIs, services, models, and business logic available as SQL-accessible tables and functions through Arrow-based workers.',
    href: '/vgi',
    cta: 'Learn about VGI',
    color: 'bg-duck-100 text-duck-800',
  },
  {
    icon: '🏛️',
    title: 'Cupola',
    eyebrow: 'Web frontend for VGI',
    outcome: 'Give teams a place to browse and operate workers.',
    description: 'A web surface for VGI-powered data access: discover connectors, configure workers, and make the platform usable beyond the shell.',
    color: 'bg-sky-100 text-sky-800',
  },
  {
    icon: '🛡️',
    title: 'Haybarn',
    eyebrow: 'Production distribution',
    outcome: 'Package and ship the platform safely.',
    description: 'Run a compatible DuckDB distribution with signed builds, curated extension defaults, provenance, and enterprise-friendly npm/PyPI distribution.',
    href: '/haybarn',
    cta: 'Explore Haybarn',
    color: 'bg-harvest-100 text-harvest-800',
  },
  {
    icon: '🌳',
    title: 'The Orchard',
    eyebrow: 'Connector interface',
    outcome: 'Discover and connect reusable data components.',
    description: 'The connector interface for Query.Farm: a place for teams to find, configure, and reuse the data connections that make up their platform.',
    color: 'bg-emerald-100 text-emerald-800',
  },
];

const useCases = [
  {
    title: 'Query data where it lives',
    description: 'Reach APIs, services, files, databases, and custom systems through a SQL layer instead of moving everything into a warehouse first.',
  },
  {
    title: 'Join operational and analytical data',
    description: 'Use SQL to inspect, join, transform, and operationalize data that normally lives across disconnected tools.',
  },
  {
    title: 'Give teams a connector platform',
    description: 'Let engineers add VGI workers and extensions in one ecosystem instead of building a connector platform from scratch.',
  },
  {
    title: 'Call ML and business logic from SQL',
    description: 'Run inference, validators, enrichment code, or internal services from SQL while keeping implementation code in the right language.',
  },
  {
    title: 'Ship embedded data workflows',
    description: 'Use DuckDB to bring fast analytical SQL into apps, agents, workflows, and internal tools without a warehouse-sized footprint.',
  },
  {
    title: 'Package for production',
    description: 'Use signed builds, provenance, curated catalogs, and deployable extension packages when the workflow needs to leave the laptop.',
  },
];

const queryFarmReasons = [
  'Make an API or internal service queryable through SQL.',
  'Add connectors and workers into one shared platform instead of rebuilding them per project.',
  'Use Orchard as the catalog for reusable VGI workers and data components.',
  'Embed analytical SQL in apps, agents, dashboards, and workflows.',
  'Package DuckDB-based data capabilities for production without a lakehouse rollout.',
];

const practicalExamples = [
  {
    title: 'Databricks: central lakehouse',
    example: 'Use Databricks when the main job is centralizing data into governed storage, running large transformation pipelines, and serving BI, ML, and analytics from one lakehouse.',
  },
  {
    title: 'Query.Farm: composable data farm',
    example: 'Use Query.Farm when the main job is turning live APIs, models, services, streams, files, and custom code into reusable SQL components that teams can discover, attach, and ship.',
  },
];

const practicalScenario = {
  title: 'Example: investment research platform',
  description: 'A hedge fund has market data feeds, portfolio APIs, risk models, vendor datasets, and internal research services. Databricks can centralize historical data and governed reporting. Query.Farm gives the team a platform for the live and reusable pieces: wrap each API, model, or feed as a VGI worker or extension, catalog it in Orchard, attach it in Haybarn, and query it with SQL from notebooks, apps, agents, and dashboards.',
};

const duckDbComparisons = [
  {
    title: 'DuckDB vs. cloud warehouses',
    description: 'Warehouses are great for centralized governed data and shared BI workloads. DuckDB is better when SQL needs to run inside an app, notebook, CLI, service, or workflow without sending every query to a remote warehouse.',
  },
  {
    title: 'DuckDB vs. Spark',
    description: 'Spark is built for distributed processing over large clusters. DuckDB is built for fast analytical SQL in-process, which is simpler for many connector, embedded analytics, local exploration, and app-adjacent workflows.',
  },
  {
    title: 'DuckDB vs. Postgres',
    description: 'Postgres is excellent for transactional applications. DuckDB is optimized for analytical scans, columnar data, and ad hoc SQL over files and datasets.',
  },
];

const proofPoints = [
  { value: String(extensionCount), label: 'public extensions' },
  ...(extensionLoads ? [{ value: `${compactCount(extensionLoads)}+`, label: 'loads in the last year' }] : []),
  { value: 'SQL', label: 'for APIs, files, services, and code' },
];

const heroExamples = [
  {
    sources: 'Citi Bike + NOAA weather',
    query: 'Do rainy days change commute station demand?',
  },
  {
    sources: 'NYC restaurant inspections + Citi Bike + NOAA weather',
    query: 'Where do dinner rides spike after sunny inspection wins?',
  },
  {
    sources: 'OpenStreetMap gyms + CDC activity + NOAA heat',
    query: 'Which neighborhoods need indoor fitness options during heat waves?',
  },
  {
    sources: 'NYC DOF sales + Census ACS',
    query: 'Which affordable neighborhoods are growing fastest?',
  },
  {
    sources: 'SEC filings + FRED rates',
    query: 'Which companies mention rates as policy changes?',
  },
  {
    sources: 'USDA FoodData Central + FDA recalls + openFDA events',
    query: 'Which ingredients show nutrition upside and safety risk?',
  },
  {
    sources: 'NASA fire data + NOAA weather + EPA air quality',
    query: 'Which smoke events line up with wind shifts and bad air?',
  },
  {
    sources: 'NOAA storms + FEMA disasters + Census ACS + HUD housing',
    query: 'Which communities face repeated storm damage and housing risk?',
  },
];

const heroPublicSources = [
  {
    label: 'NOAA weather',
    domain: 'ncei.noaa.gov',
    href: 'https://www.ncei.noaa.gov/',
  },
  {
    label: 'Citi Bike trips',
    domain: 'citibikenyc.com/system-data',
    href: 'https://citibikenyc.com/system-data',
  },
  {
    label: 'NYC inspections',
    domain: 'data.cityofnewyork.us',
    href: 'https://data.cityofnewyork.us/',
  },
  {
    label: 'Census ACS',
    domain: 'census.gov/developers',
    href: 'https://www.census.gov/data/developers/data-sets/acs-5year.html',
  },
];

const quickStart = `-- Add VGI to Haybarn / DuckDB
INSTALL vgi FROM community;
LOAD vgi;

-- Attach a hosted worker as a SQL catalog
ATTACH 'volcanos' AS volcanos (
  TYPE vgi,
  LOCATION 'https://vgi-volcanos.fly.dev/'
);

-- Query the remote service with ordinary SQL
SELECT name, country, primary_type
FROM volcanos.smithsonian.pleistocene_volcanoes
LIMIT 10;`;

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm is a data access platform that helps teams query APIs, services, files, databases, and custom code with SQL, then package those workflows for production.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://twitter.com/queryfarm',
      'https://linkedin.com/company/queryfarm',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="relative flex min-h-[92vh] items-center bg-gradient-to-br from-harvest-100 via-harvest-50 to-white overflow-hidden py-14 lg:py-20 font-display">
    <div class="absolute inset-0 opacity-35">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="home-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#home-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-5xl mx-auto text-center">
        <div class="hero-built-line mb-5" aria-label="Combine public data sources and ask cross-dataset SQL questions">
          <div class="hero-built-row">
            <span class="hero-built-label">Gather public data</span>
            <span class="hero-built-rotator hero-built-sources" aria-hidden="true">
              {heroExamples.map((example, index) => (
                <span style={`--hero-rotate-delay: ${index * 5}s`}>{example.sources}</span>
              ))}
            </span>
          </div>
          <div class="hero-built-row">
            <span class="hero-built-label">Ask with SQL</span>
            <span class="hero-built-rotator hero-built-queries" aria-hidden="true">
              {heroExamples.map((example, index) => (
                <span style={`--hero-rotate-delay: ${index * 5}s`}>{example.query}</span>
              ))}
            </span>
          </div>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-normal text-soil-900 leading-tight">
          Query any data, anywhere,
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">with SQL.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl lg:text-2xl text-soil-700 leading-relaxed max-w-3xl mx-auto">
          Query.Farm gives teams a platform for turning APIs, services, files, databases, and custom code into fast SQL-accessible tables and functions. Build on DuckDB, add VGI workers and extensions, and ship production data workflows without building the platform yourself.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/products" variant="accent" size="lg">Explore Products</Button>
          <Button href="/company/schedule" variant="secondary" size="lg">Talk to an Expert</Button>
        </div>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-3xl mx-auto">
          {proofPoints.map((point) => (
            <div class="rounded-xl border-2 border-soil-900 bg-white px-5 py-4 shadow-sm">
              <div class="text-2xl md:text-3xl font-extrabold tracking-normal text-harvest-700">{point.value}</div>
              <div class="mt-1 text-sm text-soil-600">{point.label}</div>
            </div>
          ))}
        </div>

        <div class="mt-12 rounded-2xl border-2 border-soil-900 bg-white p-3 md:p-4 shadow-2xl text-left">
          <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-5 lg:gap-6 items-stretch">
            <div class="rounded-xl border-2 border-soil-900 bg-grain-50 p-4 md:p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-soil-900 mb-2">Gather public sources</p>
              <p class="mb-4 text-sm text-soil-600 leading-relaxed">
                These are normal public data sites. Query.Farm brings sources like these into one SQL-accessible data farm.
              </p>
              <div class="space-y-3">
                {heroPublicSources.map((source) => (
                  <a
                    href={source.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={source.href}
                    class="group block rounded-lg border border-soil-900/20 bg-white px-3 py-2.5 transition-colors hover:border-soil-900 hover:bg-grain-100"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-sm font-semibold text-soil-800">{source.label}</span>
                      <span class="rounded-full bg-soil-900 px-2.5 py-1 text-xs font-bold text-grain-100">SQL</span>
                    </div>
                    <div class="mt-1 truncate text-xs font-medium text-soil-500 group-hover:text-harvest-800">
                      {source.domain}
                    </div>
                  </a>
                ))}
              </div>
              <p class="mt-4 text-sm text-soil-600 leading-relaxed">
                Start with public data, then use the same pattern for SaaS APIs, files, models, and internal services.
              </p>
            </div>

            <div class="rounded-xl border-2 border-soil-900 bg-soil-900 p-4 md:p-5 text-soil-100 shadow-lg">
              <div class="mb-4 flex items-center justify-between gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">Query.Farm workspace</p>
                  <h3 class="mt-1 text-lg font-bold text-white">Join live sources with ordinary SQL</h3>
                </div>
                <span class="hidden sm:inline-flex rounded-full border border-harvest-400/40 bg-harvest-400/10 px-3 py-1 text-xs font-bold text-harvest-200">DuckDB</span>
              </div>
              <pre class="font-mono overflow-x-auto rounded-lg border border-white/10 bg-black/25 p-4 text-sm leading-relaxed text-soil-100"><code>ATTACH 'weather' AS weather (...);
ATTACH 'citibike' AS trips (...);
ATTACH 'restaurants' AS food (...);

SELECT station, cuisine, rain_mm, trips
FROM trips.daily
JOIN weather.daily USING (date)
JOIN food.neighborhoods USING (neighborhood)
ORDER BY trips DESC;</code></pre>
              <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-3">
                <div class="mb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                  <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">Result</p>
                  <p class="text-xs text-soil-300">Joined public sources in one query</p>
                </div>
                <div class="grid grid-cols-[1.1fr_0.8fr_0.6fr_0.6fr] gap-2 text-xs">
                  <div class="text-soil-300">station</div>
                  <div class="text-soil-300">cuisine</div>
                  <div class="text-soil-300">rain</div>
                  <div class="text-soil-300">trips</div>
                  {[
                    ['Bedford Ave', 'Pizza', '0.1 in', '18.4K'],
                    ['Union Sq', 'Thai', '0.0 in', '14.1K'],
                    ['Kips Bay', 'Cafe', '0.2 in', '9.8K'],
                  ].map((row) => (
                    <>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[0]}</div>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[1]}</div>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[2]}</div>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-harvest-200">{row[3]}</div>
                    </>
                  ))}
                </div>
              </div>
              <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                {['Schemas discovered', 'Catalogs attached', 'No ETL or schema plumbing'].map((item) => (
                  <div class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-xs font-semibold text-soil-100">
                    {item}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform framing -->
  <section class="flex min-h-[90vh] items-center py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="The data farm"
        title="A platform of components that work together"
        description="A real farm is not one tool. It is fields, barns, orchards, paths, storage, and equipment working toward one outcome. Query.Farm works the same way for data access: each component does a job, and together they form a platform for querying scattered data with SQL."
      />

      <div class="mt-12 max-w-6xl mx-auto rounded-2xl border-2 border-soil-900 bg-emerald-50 p-5 md:p-8 shadow-lg overflow-visible">
        <div class="mb-8 text-center">
          <div class="mx-auto max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 mb-2">Query.Farm data platform</p>
            <h3 class="text-2xl font-bold text-soil-900">Every component works together</h3>
            <p class="mt-2 text-sm text-soil-600">
              Each square is one part of the data farm. Together they let teams build, discover, run, and reuse SQL-accessible data connections.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {platformComponents.map((pillar) => (
            <div tabindex="0" class="group relative aspect-square rounded-xl border-2 border-soil-900 bg-white p-4 shadow-sm transition-all hover:z-30 hover:-translate-y-1 hover:bg-grain-50 hover:shadow-xl focus:z-30 focus:-translate-y-1 focus:bg-grain-50 focus:shadow-xl focus:outline-none">
              <div class="flex h-full flex-col items-center justify-center text-center">
                <div class={`w-16 h-16 rounded-xl ${pillar.color} flex items-center justify-center text-4xl`}>
                  {pillar.icon}
                </div>
                <h4 class="mt-4 text-xl font-bold text-soil-900">{pillar.title}</h4>
                <p class="mt-2 text-sm font-semibold leading-snug text-soil-700">{pillar.outcome}</p>
              </div>

              <div class="absolute left-1/2 top-[calc(100%+0.75rem)] z-40 hidden w-72 -translate-x-1/2 rounded-xl border-2 border-soil-900 bg-white p-4 shadow-xl group-hover:block group-focus:block">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">{pillar.eyebrow}</p>
                  <p class="mt-1 text-lg font-bold text-soil-900">{pillar.title}</p>
                  <p class="mt-2 text-sm text-soil-700 leading-relaxed">{pillar.description}</p>
                  {pillar.href ? (
                    <a href={pillar.href} class="mt-4 inline-flex self-start rounded-md border border-soil-900 bg-grain-100 px-3 py-2 text-xs font-bold text-soil-900 hover:bg-grain-200">
                      {pillar.cta} →
                    </a>
                  ) : (
                    <span class="mt-4 inline-flex self-start rounded-md bg-soil-100 px-3 py-2 text-xs font-bold text-soil-500">
                      In development
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-xl border-2 border-soil-900 bg-white p-5 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">All together</p>
          <h4 class="mt-2 text-2xl font-bold text-soil-900">The Query.Farm platform</h4>
          <p class="mt-2 text-sm text-soil-700">
            These components work together as one data platform for building, operating, and reusing SQL-accessible connections.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform comparison -->
  <section class="flex min-h-[90vh] items-center py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Why Query.Farm"
        title="A different kind of data platform"
        description="Databricks centralizes the lakehouse. Query.Farm composes the data farm: reusable connectors, workers, extensions, and SQL catalogs that teams can discover, attach, and ship."
        class="mb-12"
      />

      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 lg:gap-10 items-start">
        <div class="rounded-xl border border-soil-200 bg-white p-6 md:p-8 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">The difference</p>
          <h3 class="text-2xl md:text-3xl font-bold text-soil-900 mb-4">
            Build the platform from reusable data components.
          </h3>
          <p class="text-soil-700 leading-relaxed mb-6">
            Query.Farm gives teams one place to turn APIs, services, models, streams, files, and custom code into reusable data connections. Once a connection exists, people can find it, query it with SQL, and reuse it across apps, dashboards, agents, and workflows.
          </p>
          <div class="space-y-3">
            {queryFarmReasons.map((reason) => (
              <div class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-harvest-100 text-harvest-700">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <p class="text-sm text-soil-700 leading-relaxed">{reason}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-6">
            {practicalExamples.map((item) => (
              <div class="rounded-xl border border-soil-200 bg-white p-6 shadow-sm">
                <h3 class="text-lg font-bold text-soil-900 mb-3">{item.title}</h3>
                <p class="text-sm text-soil-700 leading-relaxed">{item.example}</p>
              </div>
            ))}
          </div>
          <div class="rounded-xl border border-harvest-200 bg-harvest-50 p-6 md:p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">Practical example</p>
            <h3 class="text-xl md:text-2xl font-bold text-soil-900 mb-3">{practicalScenario.title}</h3>
            <p class="text-soil-700 leading-relaxed">{practicalScenario.description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="flex min-h-[90vh] items-center py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Use cases"
        title="Access scattered data through one fast SQL layer"
        description="Modern data is spread across APIs, files, apps, internal services, models, and databases. Query.Farm helps teams inspect, join, transform, and operationalize that data without building a connector platform first."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px overflow-hidden rounded-xl border border-soil-200 bg-soil-200">
        {useCases.map((useCase) => (
          <div class="bg-white p-5 md:p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-harvest-100 text-harvest-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h3 class="font-bold text-soil-900 mb-2">{useCase.title}</h3>
