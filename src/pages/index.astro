---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import PlatformMap from '../components/products/PlatformMap.astro';
import { getCollection } from 'astro:content';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const extensionCount = publicExtensions.length;
const annualizedLoads = usageSummary?.annualizedLoads ?? 0;
const compactCount = (value: number) => {
  if (value >= 1_000_000) return `${Math.round(value / 1_000_000)}M+`;
  if (value >= 1_000) return `${Math.round(value / 1_000)}K+`;
  return `${value}+`;
};

const heroSubjects = ['your data', 'your code', 'your APIs'];
const heroEngines = [{ label: 'DuckDB', src: '/images/duckdb-icon.svg' }];
const dateFmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Make APIs, services, files, databases, models, and custom code queryable from DuckDB today—and from more query engines over time.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://www.linkedin.com/company/query-farm/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];

const WRAP = 'mx-auto w-full max-w-[1280px] px-6 sm:px-7';
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <main>
    <section class="border-b border-soil-300 bg-gradient-to-b from-soil-50 to-soil-100">
      <div class={`${WRAP} pb-16 pt-14 lg:pb-20 lg:pt-20`}>
        <div class="max-w-[900px]">
          <p class="qf-eyebrow text-sun-700">Open-source connectivity for the modern query stack</p>
          <h1
            class="hero-promise mt-4 max-w-[20ch] text-[clamp(2.7rem,5.5vw,5rem)] font-semibold leading-[1.01] tracking-[-0.034em] text-soil-900"
            aria-label="Make anything queryable from anywhere."
          >
            <span class="hero-make-line" aria-hidden="true">
              <span>Make</span>
              <span class="subject-reel">
                {heroSubjects.map((subject, subjectIndex) => (
                  <span class="subject-term" style={`--subject-index: ${subjectIndex}`}>{subject}</span>
                ))}
                <span class="subject-final">anything</span>
              </span>
              <span>queryable</span>
            </span>
            <span class="hero-from-line" aria-hidden="true">
              <span>from</span>
              <span class="engine-reel">
                {heroEngines.map((engine) => (
                  <span class="engine-term">
                    <img src={engine.src} alt="" />
                    <span>{engine.label}</span>
                  </span>
                ))}
                <span class="engine-final">anywhere.</span>
              </span>
            </span>
          </h1>
          <p class="mt-5 max-w-[75ch] text-[clamp(1.03rem,1.5vw,1.19rem)] leading-relaxed text-soil-700">
            Turn APIs, services, databases, and custom code into tables and functions.
            Start with DuckDB today; VGI is expanding the same model to DataFusion, Trino,
            Spark, SQLite, and Polars.
          </p>
        </div>

        <div class="mt-12 flex flex-col gap-5 border-t border-soil-300 pt-9 md:flex-row md:items-end md:justify-between lg:mt-16">
          <div>
            <p class="qf-eyebrow text-sun-700">The product map</p>
            <h2 class="mt-2 text-3xl text-soil-900 md:text-4xl">See the whole system at once</h2>
            <p class="mt-3 max-w-[68ch] text-[17px] leading-relaxed text-soil-700">
              Follow a question from the person or agent asking it, through the query engine and
              integration layer, to the worker and source that can answer it.
            </p>
          </div>
          <Button href="/vision" variant="secondary" size="md" class="shrink-0">Take the guided tour</Button>
        </div>

        <div class="mt-7">
          <PlatformMap />
        </div>
      </div>
    </section>

    <section class="border-b border-soil-300 bg-[#fffdf7]">
      <div class={`${WRAP} grid grid-cols-2 divide-x divide-y divide-soil-300 md:grid-cols-4 md:divide-y-0`}>
        <div class="proof-cell">
          <strong>{extensionCount}</strong>
          <span>published extensions</span>
        </div>
        <div class="proof-cell">
          <strong>{compactCount(annualizedLoads)}</strong>
          <span>annualized extension run rate</span>
        </div>
        <div class="proof-cell">
          <strong>64</strong>
          <span>founder-authored DuckDB core PRs merged</span>
        </div>
        <div class="proof-cell">
          <strong>5</strong>
          <span>VGI language SDKs</span>
        </div>
      </div>
    </section>

    <section class="border-b border-soil-300 bg-rock-900 py-16 text-cream lg:py-20">
      <div class={`${WRAP} grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end`}>
        <div>
          <p class="qf-eyebrow text-sun-400">Start with the stubborn thing</p>
          <h2 class="mt-3 max-w-[18ch] text-3xl text-cream md:text-5xl">Bring us the data, API, or code your team cannot query cleanly.</h2>
          <p class="mt-4 max-w-[68ch] text-[17px] leading-relaxed text-cream/75">
            In thirty minutes, we can place it on the map, tell you what already exists, and scope
            the smallest useful next step. No deck, and no platform prerequisite.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <Button href="/company/schedule" variant="accent" size="lg" onDark>Talk through your use case</Button>
          <Button href="/consulting" variant="secondary" size="lg" onDark>View consulting</Button>
        </div>
      </div>
    </section>

    {latestPosts.length > 0 && (
      <section class="py-16 lg:py-20">
        <div class={WRAP}>
          <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="qf-eyebrow text-sun-700">From the blog</p>
              <h2 class="mt-3 text-3xl text-soil-900 md:text-4xl">Latest updates</h2>
              <p class="mt-3 text-[16px] text-soil-700">Release notes, product thinking, and technical work from Query.Farm.</p>
            </div>
            <Button href="/blog" variant="ghost" size="sm">View all posts <span aria-hidden="true">→</span></Button>
          </div>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="post-card">
                <div class="hairband" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
                <div class="flex h-full flex-col p-6">
                  {post.data.tags?.[0] && <span class="qf-eyebrow text-sun-700">{post.data.tags[0]}</span>}
                  <h3 class="mt-4 text-xl leading-snug text-soil-900">{post.data.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-soil-700">{post.data.description}</p>
                  <div class="mt-auto flex items-center justify-between gap-3 pt-7 text-xs text-soil-500">
                    <span>{post.data.author}</span>
                    <span class="qf-figure">{dateFmt(post.data.pubDate)}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .hero-make-line,
  .hero-from-line { display: flex; align-items: baseline; gap: .2em; white-space: nowrap; }

  .subject-reel,
  .engine-reel {
    position: relative;
    display: inline-block;
    min-width: 0;
    height: 1.08em;
    margin-block: -.04em;
    overflow: visible;
    vertical-align: bottom;
  }

  .subject-reel { width: 4.05em; animation: subject-reel-settles .9s cubic-bezier(.16, 1, .3, 1) 5.1s both; }
  .engine-reel { width: 6.8em; }

  .subject-term,
  .subject-final,
  .engine-term,
  .engine-final {
    position: absolute;
    inset: .29em auto auto 0;
    display: inline-flex;
    align-items: center;
    gap: .18em;
    width: max-content;
    transform-origin: left center;
  }

  .subject-term {
    color: var(--color-sun-700);
    opacity: 0;
    animation: subject-pass 2.3s cubic-bezier(.22, .8, .28, 1) both;
    animation-delay: calc(var(--subject-index) * 1.7s);
  }

  .engine-term { color: var(--color-sun-700); opacity: 0; animation: engine-hold 6.2s cubic-bezier(.22, .8, .28, 1) both; }
  .engine-term img { width: .66em; height: .66em; flex: none; object-fit: contain; }
  .subject-final, .engine-final { opacity: 0; }
  .subject-final { animation: anywhere-arrives .9s cubic-bezier(.16, 1, .3, 1) 5.1s both; }
  .engine-final { animation: anywhere-arrives .9s cubic-bezier(.16, 1, .3, 1) 5.55s both; }

  .engine-final::after {
    content: '';
    position: absolute;
    left: .03em;
    right: .01em;
    bottom: -.09em;
    height: .07em;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-sun-500), var(--color-field-600));
    transform: scaleX(0);
    transform-origin: left;
    animation: anywhere-underline .68s cubic-bezier(.16, 1, .3, 1) 5.95s both;
  }

  .proof-cell { display: flex; min-height: 118px; flex-direction: column; justify-content: center; gap: .4rem; padding: 1.25rem; }
  .proof-cell strong { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.55rem); line-height: 1; color: var(--color-soil-900); }
  .proof-cell span { font-size: .76rem; font-weight: 650; letter-spacing: .035em; color: var(--color-soil-600); }

  .post-card { display: flex; min-height: 330px; flex-direction: column; overflow: hidden; border: 1px solid var(--color-soil-300); border-radius: 13px; background: #fffdf7; transition: transform .2s ease, box-shadow .2s ease; }
  .post-card:hover { transform: translateY(-4px); box-shadow: 0 14px 32px rgb(48 37 23 / .07); }
  .post-card .hairband { height: 5px; flex: none; }

  @keyframes subject-pass {
    0% { opacity: 0; transform: translateY(.48em) rotateX(-32deg); }
    14%, 68% { opacity: 1; transform: translateY(0) rotateX(0); }
    100% { opacity: 0; transform: translateY(-.42em) rotateX(28deg); }
  }
  @keyframes engine-hold {
    0% { opacity: 0; transform: translateY(.38em); }
    7%, 78% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-.32em); }
  }
  @keyframes anywhere-arrives { from { opacity: 0; transform: translateY(.42em); } to { opacity: 1; transform: translateY(0); } }
  @keyframes subject-reel-settles { from { width: 4.05em; } to { width: 3.81em; } }
  @keyframes anywhere-underline { to { transform: scaleX(1); } }

  @media (max-width: 640px) {
    .hero-make-line { flex-wrap: wrap; }
    .subject-reel { width: 4.05em; }
    .engine-reel { width: 6.35em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .subject-term, .engine-term { display: none; animation: none; }
    .subject-final, .engine-final { opacity: 1; animation: none; }
    .subject-reel { width: 3.81em; animation: none; }
    .engine-final::after { transform: scaleX(1); animation: none; }
    .post-card { transition: none; }
  }
</style>
