---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

// Get latest blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const extensionCount = publicExtensions.length;
const extensionLoads = usageSummary?.totalLast365Days;
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};

const platformComponents = [
  {
    icon: '🔌',
    title: 'Extensions',
    eyebrow: `${extensionCount} installable capabilities`,
    outcome: 'Connect systems and add SQL capabilities.',
    description: 'Install connectors, transformations, sketches, scripting, geospatial, JSON, text, and operational tools without building native extension plumbing yourself.',
    href: '/products/extensions',
    cta: 'Browse extensions',
    color: 'bg-earth-100 text-earth-800',
  },
  {
    icon: '🌐',
    title: 'VGI',
    eyebrow: 'Vector Gateway Interface',
    outcome: 'Run custom or reusable workers from SQL.',
    description: 'Make APIs, services, models, and business logic available as SQL-accessible tables and functions through Arrow-based workers.',
    href: '/vgi',
    cta: 'Learn about VGI',
    color: 'bg-duck-100 text-duck-800',
  },
  {
    icon: '🏛️',
    title: 'Cupola',
    eyebrow: 'Web frontend for VGI',
    outcome: 'Give teams a place to browse and operate workers.',
    description: 'A web surface for VGI-powered data access: discover connectors, configure workers, and make the platform usable beyond the shell.',
    color: 'bg-sky-100 text-sky-800',
  },
  {
    icon: '🛡️',
    title: 'Haybarn',
    eyebrow: 'Production distribution',
    outcome: 'Package and ship the platform safely.',
    description: 'Run a compatible DuckDB distribution with signed builds, curated extension defaults, provenance, and enterprise-friendly npm/PyPI distribution.',
    href: '/haybarn',
    cta: 'Explore Haybarn',
    color: 'bg-harvest-100 text-harvest-800',
  },
  {
    icon: '🌳',
    title: 'The Orchard',
    eyebrow: 'VGI worker catalog',
    outcome: 'Start from reusable workers, not blank files.',
    description: 'A growing collection of VGI workers and connectors teams can use, adapt, or contribute to as their data farm grows.',
    color: 'bg-emerald-100 text-emerald-800',
  },
];

const useCases = [
  {
    title: 'Query data where it lives',
    description: 'Reach APIs, services, files, databases, and custom systems through a SQL layer instead of moving everything into a warehouse first.',
  },
  {
    title: 'Join operational and analytical data',
    description: 'Use SQL to inspect, join, transform, and operationalize data that normally lives across disconnected tools.',
  },
  {
    title: 'Give teams a connector platform',
    description: 'Let engineers add VGI workers and extensions in one ecosystem instead of building a connector platform from scratch.',
  },
  {
    title: 'Call ML and business logic from SQL',
    description: 'Run inference, validators, enrichment code, or internal services from SQL while keeping implementation code in the right language.',
  },
  {
    title: 'Ship embedded data workflows',
    description: 'Use DuckDB to bring fast analytical SQL into apps, agents, workflows, and internal tools without a warehouse-sized footprint.',
  },
  {
    title: 'Package for production',
    description: 'Use signed builds, provenance, curated catalogs, and deployable extension packages when the workflow needs to leave the laptop.',
  },
];

const proofPoints = [
  { value: String(extensionCount), label: 'public extensions' },
  ...(extensionLoads ? [{ value: `${compactCount(extensionLoads)}+`, label: 'loads in the last year' }] : []),
  { value: 'SQL', label: 'for APIs, files, services, and code' },
];

const quickStart = `-- Install a Query.Farm extension from DuckDB community
INSTALL airport FROM community;
LOAD airport;

-- Attach a remote Arrow Flight service as a DuckDB catalog
ATTACH 'grpc+tls://flight.example.com:8815' AS remote (TYPE airport);

-- Query remote data with ordinary SQL
SELECT *
FROM remote.public.events
LIMIT 100;`;

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm is a data access platform that helps teams query APIs, services, files, databases, and custom code with SQL, then package those workflows for production.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://twitter.com/queryfarm',
      'https://linkedin.com/company/queryfarm',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-soil-50 via-earth-50 to-white overflow-hidden py-14 lg:py-20">
    <div class="absolute inset-0 opacity-35">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="home-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#home-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-5">
          Data access platform for SQL-first teams
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-soil-900 leading-tight">
          Query any data, anywhere, with SQL.
        </h1>
        <p class="mt-6 text-lg md:text-xl lg:text-2xl text-soil-700 leading-relaxed max-w-3xl mx-auto">
          Query.Farm gives teams a platform for turning APIs, services, files, databases, and custom code into fast SQL-accessible tables and functions. Build on DuckDB, add VGI workers and extensions, and ship production data workflows without building the platform yourself.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/products" variant="accent" size="lg">Explore Products</Button>
          <Button href="/company/schedule" variant="secondary" size="lg">Talk to an Expert</Button>
        </div>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-3xl mx-auto">
          {proofPoints.map((point) => (
            <div class="rounded-lg border border-soil-200 bg-white/85 px-5 py-4 shadow-sm">
              <div class="text-2xl md:text-3xl font-bold text-harvest-700">{point.value}</div>
              <div class="mt-1 text-sm text-soil-600">{point.label}</div>
            </div>
          ))}
        </div>

        <div class="mt-12 rounded-xl border border-soil-200 bg-white/90 p-4 md:p-6 shadow-lg">
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] gap-3 lg:gap-4 items-stretch text-left">
            <div class="rounded-lg border border-soil-200 bg-soil-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-soil-500 mb-2">Scattered data</p>
              <p class="text-base font-bold text-soil-900">APIs, services, files, databases, and custom code</p>
            </div>

            <div class="hidden lg:flex items-center justify-center text-soil-400">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 5l7 7-7 7M4 12h16" />
              </svg>
            </div>

            <div class="rounded-lg border border-harvest-200 bg-harvest-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-harvest-700 mb-2">Query.Farm platform</p>
              <div class="space-y-2">
                <a href="/products/extensions" class="block rounded-md bg-white px-3 py-2 text-xs border border-earth-200 hover:border-earth-400 transition-colors">
                  <span class="font-bold text-soil-900">Extensions:</span>
                  <span class="text-soil-700"> connect systems</span>
                </a>
                <a href="/vgi" class="block rounded-md bg-white px-3 py-2 text-xs border border-duck-300 hover:border-duck-500 transition-colors">
                  <span class="font-bold text-soil-900">VGI:</span>
                  <span class="text-soil-700"> run custom or reusable workers</span>
                </a>
                <span class="block rounded-md bg-white px-3 py-2 text-xs border border-sky-200">
                  <span class="font-bold text-soil-900">Cupola:</span>
                  <span class="text-soil-700"> manage VGI in the browser</span>
                </span>
                <a href="/haybarn" class="block rounded-md bg-white px-3 py-2 text-xs border border-harvest-200 hover:border-harvest-400 transition-colors">
                  <span class="font-bold text-soil-900">Haybarn:</span>
                  <span class="text-soil-700"> package for production</span>
                </a>
                <span class="block rounded-md bg-white px-3 py-2 text-xs border border-emerald-200">
                  <span class="font-bold text-soil-900">Orchard:</span>
                  <span class="text-soil-700"> reuse VGI workers</span>
                </span>
              </div>
            </div>

            <div class="hidden lg:flex items-center justify-center text-soil-400">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 5l7 7-7 7M4 12h16" />
              </svg>
            </div>

            <div class="rounded-lg border border-earth-200 bg-earth-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-earth-700 mb-2">SQL access layer</p>
              <p class="text-base font-bold text-soil-900">Queryable tables, functions, connectors, and packages</p>
            </div>

            <div class="hidden lg:flex items-center justify-center text-soil-400">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 5l7 7-7 7M4 12h16" />
              </svg>
            </div>

            <div class="rounded-lg border border-soil-200 bg-white p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-soil-500 mb-2">Shipped in</p>
              <p class="text-base font-bold text-soil-900">Apps, agents, dashboards, workflows, and internal tools</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform framing -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="The data farm"
        title="A platform of components that work together"
        description="A real farm is not one tool. It is fields, barns, orchards, paths, storage, and equipment working toward one outcome. Query.Farm works the same way for data access: each component does a job, and together they form a platform for querying scattered data with SQL."
      />

      <div class="mt-10 max-w-4xl mx-auto rounded-xl border border-soil-200 bg-soil-50 p-6 md:p-8">
        <h3 class="text-xl font-bold text-soil-900 mb-3">Why DuckDB?</h3>
        <p class="text-soil-700 leading-relaxed">
          DuckDB is a fast analytical SQL engine that can run inside an app, notebook, CLI, browser, or service. It gives teams warehouse-style querying without requiring a warehouse-style deployment. Query.Farm builds the platform around it: connectors, VGI workers, extension packaging, frontend tools, and production distribution.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-6 mt-12">
        {platformComponents.map((pillar) => (
          <Card padding="lg" class="flex h-full flex-col hover:shadow-xl transition-shadow">
            <div class={`w-14 h-14 mb-5 rounded-xl ${pillar.color} flex items-center justify-center text-3xl`}>
              {pillar.icon}
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-soil-500 mb-2">{pillar.eyebrow}</p>
            <h3 class="text-2xl font-bold text-soil-900 mb-4">{pillar.title}</h3>
            <p class="text-base font-semibold text-soil-900 mb-3">{pillar.outcome}</p>
            <p class="text-soil-700 leading-relaxed flex-1">{pillar.description}</p>
            {pillar.href ? (
              <Button href={pillar.href} variant="ghost" size="sm" class="mt-6 self-start">
                {pillar.cta} →
              </Button>
            ) : (
              <span class="mt-6 inline-flex self-start rounded-md bg-soil-100 px-3 py-1.5 text-xs font-semibold text-soil-600">
                In development
              </span>
            )}
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Use cases"
        title="Access scattered data through one fast SQL layer"
        description="Modern data is spread across APIs, files, apps, internal services, models, and databases. Query.Farm helps teams inspect, join, transform, and operationalize that data without building a connector platform first."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {useCases.map((useCase) => (
          <Card padding="lg" class="bg-white">
            <div class="flex items-start gap-3">
              <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-harvest-100 text-harvest-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <h3 class="font-bold text-soil-900 mb-2">{useCase.title}</h3>
                <p class="text-sm text-soil-700 leading-relaxed">{useCase.description}</p>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof + Quick Start -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-center">
        <div>
          <SectionHeader
            eyebrow="From install to impact"
            title="Turn an external service into SQL in minutes"
            description="Install an extension, attach the system you need, and query it like a table or catalog. Start with the public catalog, run custom or reusable workers with VGI, or work with Query.Farm to build and package a native extension for production."
            class="mb-8"
          />
          <div class="grid grid-cols-2 gap-4 mb-8">
            <Card padding="md">
              <div class="text-sm font-semibold text-soil-900">Install from DuckDB community</div>
              <div class="mt-1 text-sm text-soil-600">No new service to stand up.</div>
            </Card>
            <Card padding="md">
              <div class="text-sm font-semibold text-soil-900">Keep ordinary SQL</div>
              <div class="mt-1 text-sm text-soil-600">Use extensions inside fast embedded data workflows.</div>
            </Card>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <Button href="/products/extensions" variant="primary" size="md">
              Browse by Intent
            </Button>
            <Button href="/haybarn" variant="secondary" size="md">
              See Production Packaging
            </Button>
          </div>
        </div>

        <div>
          <CodeBlock code={quickStart} lang="sql" title="duckdb.sql" />
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">Expert help</p>
          <h2 class="text-3xl md:text-4xl font-bold text-soil-900 mb-4">
            Need a connector, worker, extension, or production data platform?
          </h2>
          <p class="text-lg text-soil-700 leading-relaxed">
            We help teams turn APIs, services, and internal logic into SQL-accessible tables and functions, then tune, package, and deploy those workflows for production.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3">
          <Button href="/consulting" variant="primary" size="md">
            View Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a Call
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  {latestPosts.length > 0 && (
    <section class="py-16 lg:py-24 bg-white">
      <div class="section-container">
        <div class="flex items-center justify-between mb-12">
          <SectionHeader
            eyebrow="From the Blog"
            title="Latest Updates"
            description="Release notes, product thinking, and technical notes from the Query.Farm team."
          />
          <Button href="/blog" variant="ghost" size="md" class="hidden md:inline-flex">
            View All Posts →
          </Button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              author={post.data.author}
              tags={post.data.tags}
              slug={post.id}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>

        <div class="mt-8 text-center md:hidden">
          <Button href="/blog" variant="ghost" size="md">
            View All Posts →
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-earth-600 via-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Build the data access layer. Skip the platform detour.
      </h2>
      <p class="text-xl md:text-2xl text-soil-100 mb-8 max-w-3xl mx-auto">
        Start with an extension, add VGI workers, evaluate Haybarn, or bring us the data workflow your team needs to ship.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/extensions" variant="secondary" size="lg">
          Explore Extensions
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Talk to an Expert
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
