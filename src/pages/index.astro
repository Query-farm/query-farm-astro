---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const concepts = [
  {
    icon: '🌱',
    title: 'Everything is a table',
    body: 'Wrap an API, dataset, file, service, or custom code and query it as an ordinary SQL table.',
  },
  {
    icon: '🌿',
    title: 'Workers do the wrapping',
    body: 'A small VGI worker — in Python, Go, Rust, TypeScript, and more — exposes a source and deploys anywhere, like fly.dev.',
  },
  {
    icon: '🌾',
    title: 'Attach & join with SQL',
    body: 'ATTACH workers in DuckDB and join across them. No ETL job, no warehouse model — query where the data lives.',
  },
  {
    icon: '🚜',
    title: 'Reuse & ship',
    body: 'Catalog workers so your team configures once and reuses everywhere with Orchard, then ship a hardened DuckDB to production with Haybarn.',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm is a data access platform that helps teams query APIs, services, files, databases, and custom code with SQL, then package those workflows for production.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://twitter.com/queryfarm',
      'https://linkedin.com/company/queryfarm',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="relative flex items-center bg-gradient-to-br from-harvest-100 via-harvest-50 to-white overflow-hidden py-16 lg:py-24 font-display">
    <div class="absolute inset-0 opacity-35">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="home-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#home-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-5xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-normal text-soil-900 leading-tight">
          Query Any Data
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">Quickly.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl lg:text-2xl text-soil-700 leading-relaxed max-w-2xl mx-auto">
          Turn any API, dataset, file, or service into a table you can query with SQL.
        </p>

        <div class="hero-demo mt-10 mx-auto max-w-2xl text-left">
          <div class="qf-window rounded-2xl border-2 border-soil-900 bg-soil-900 shadow-2xl overflow-hidden">
            <!-- Title bar with Ask / SQL toggle -->
            <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
                <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
              </span>
              <div class="qf-toggle inline-flex rounded-full border border-white/15 bg-black/25 p-0.5 text-xs font-bold" role="tablist" aria-label="Choose how to query">
                <button type="button" data-view-btn="ask" aria-pressed="true" class="rounded-full px-3 py-1 transition-colors">Ask</button>
                <button type="button" data-view-btn="sql" aria-pressed="false" class="rounded-full px-3 py-1 transition-colors">SQL</button>
              </div>
              <span class="ml-auto font-mono text-xs text-soil-400">query.farm</span>
            </div>

            <!-- Terminal body -->
            <div class="qf-workspace font-mono text-sm leading-relaxed p-4 md:p-5 text-soil-100" data-view="ask">
              <!-- Ask view: scripted agent terminal -->
              <div class="qf-view qf-view-ask">
                <p><span class="text-harvest-300">❯</span> <span class="qf-term-q"></span><span class="qf-term-cursor" aria-hidden="true"></span></p>
                <ul class="qf-term-steps mt-3 space-y-1 text-soil-300"></ul>
              </div>

              <!-- SQL view: the query that actually runs -->
              <div class="qf-view qf-view-sql">
                <pre class="overflow-x-auto text-soil-100"><code><span class="sql-keyword">ATTACH</span> <span class="sql-string">'storefronts'</span> (<span class="sql-keyword">TYPE</span> vgi, <span class="sql-keyword">LOCATION</span> <span class="sql-string">'https://vgi-nyc-storefront-rents.fly.dev'</span>);
<span class="sql-keyword">ATTACH</span> <span class="sql-string">'transit'</span>     (<span class="sql-keyword">TYPE</span> vgi, <span class="sql-keyword">LOCATION</span> <span class="sql-string">'https://vgi-mta-ridership.fly.dev'</span>);
<span class="sql-keyword">ATTACH</span> <span class="sql-string">'permits'</span>     (<span class="sql-keyword">TYPE</span> vgi, <span class="sql-keyword">LOCATION</span> <span class="sql-string">'https://vgi-nyc-permits.fly.dev'</span>);

<span class="sql-keyword">SELECT</span> neighborhood, foot_traffic, median_rent, opportunity_score
<span class="sql-keyword">FROM</span> storefronts.available
<span class="sql-keyword">JOIN</span> transit.station_activity <span class="sql-keyword">USING</span> (neighborhood)
<span class="sql-keyword">JOIN</span> permits.food_service    <span class="sql-keyword">USING</span> (neighborhood)
<span class="sql-keyword">ORDER BY</span> opportunity_score <span class="sql-keyword">DESC</span>;</code></pre>
              </div>

              <!-- Shared result: held back until the agent "finishes" in Ask view -->
              <div class="qf-result mt-5">
                <div class="grid grid-cols-[1.5fr_0.8fr_0.8fr_0.6fr] gap-x-4 gap-y-1.5 border-t border-white/10 pt-4">
                  <div class="text-soil-400">neighborhood</div>
                  <div class="text-soil-400">traffic</div>
                  <div class="text-soil-400">rent</div>
                  <div class="text-soil-400">score</div>
                  {[
                    ['Long Island City', 'High', '$7.8K', '91'],
                    ['Astoria', 'High', '$6.4K', '86'],
                    ['Sunset Park', 'Medium', '$4.9K', '82'],
                  ].map((row) => (
                    <>
                      <div class="text-soil-100">{row[0]}</div>
                      <div class="text-soil-100">{row[1]}</div>
                      <div class="text-soil-100">{row[2]}</div>
                      <div class="text-harvest-300 font-bold">{row[3]}</div>
                    </>
                  ))}
                </div>
                <p class="qf-answer mt-4 text-harvest-200 font-semibold">
                  → Long Island City is the strongest spot.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/products" variant="primary" size="lg">Explore Products</Button>
          <Button href="/company/schedule" variant="secondary" size="lg">Talk with Us</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: core concepts -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="How it works"
        title="From any source to a SQL answer"
        description="Four ideas are the whole model. Grow a source into a table, then query it like anything else."
        class="mb-12"
      />

      <ol class="qf-grow mx-auto max-w-2xl">
        {concepts.map((concept, i) => (
          <li class="qf-grow-step">
            <div class="qf-grow-rail">
              <span class="qf-grow-icon" role="img" aria-label={`Step ${i + 1}`}>{concept.icon}</span>
            </div>
            <div class="qf-grow-body">
              <h3 class="text-lg md:text-xl font-bold text-soil-900">
                <span class="text-harvest-700">{i + 1}.</span> {concept.title}
              </h3>
              <p class="mt-1.5 text-soil-700 leading-relaxed">{concept.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Request a datasource -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="mx-auto max-w-4xl rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-lg md:p-10 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">Request a datasource</p>
        <h2 class="text-3xl md:text-4xl font-bold text-soil-900 mb-4">
          Is there a datasource you want to query?
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-soil-700 leading-relaxed">
          Tell us the API, service, file format, or dataset you wish you could query with SQL, and we'll build the connector for you and let you know when it's ready.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="mailto:hello@query.farm?subject=Datasource%20request" variant="accent" size="lg">
            Send us a datasource
          </Button>
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-sm text-soil-600 leading-relaxed">
          Today we build these by hand. One day it will be a self-serve wizard — for now, just send it our way and we'll take care of it.
        </p>
      </div>
    </div>
  </section>

  <!-- Consulting -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">Expert help</p>
          <h2 class="text-3xl md:text-4xl font-bold text-soil-900 mb-4">
            Build the data access layer. Skip the platform detour.
          </h2>
          <p class="text-lg text-soil-700 leading-relaxed">
            Start with an extension, add VGI workers, evaluate Haybarn, or bring us the connector, worker, extension, or production data platform your team needs to ship.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3">
          <Button href="/products/extensions" variant="primary" size="md">
            Explore Extensions
          </Button>
          <Button href="/consulting" variant="primary" size="md">
            View Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a Call
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  {latestPosts.length > 0 && (
    <section class="py-16 lg:py-24 bg-white">
      <div class="section-container">
        <div class="flex items-center justify-between mb-12">
          <SectionHeader
            eyebrow="From the Blog"
            title="Latest Updates"
            description="Release notes, product thinking, and technical notes from the Query.Farm team."
          />
          <Button href="/blog" variant="ghost" size="md" class="hidden md:inline-flex">
            View All Posts →
          </Button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              author={post.data.author}
              tags={post.data.tags}
              slug={post.id}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>

        <div class="mt-8 text-center md:hidden">
          <Button href="/blog" variant="ghost" size="md">
            View All Posts →
          </Button>
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* How it works: growth-stage rail */
  .qf-grow-step {
    position: relative;
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
  }

  .qf-grow-step:last-child {
    padding-bottom: 0;
  }

  .qf-grow-rail {
    position: relative;
    flex-shrink: 0;
  }

  .qf-grow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    border: 2px solid #3d342a;
    background: #fef3c7;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 2px 0 rgba(61, 52, 42, 0.15);
  }

  /* The growing stem connecting each step to the next */
  .qf-grow-step:not(:last-child) .qf-grow-rail::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 3rem;
    bottom: -2.5rem;
    width: 0;
    border-left: 2px dashed rgba(61, 52, 42, 0.3);
    transform: translateX(-1px);
  }

  .qf-grow-body {
    padding-top: 0.4rem;
  }

  .sql-keyword {
    color: #bef264;
    font-weight: 800;
  }

  .sql-string {
    color: #fef3c7;
  }

  /* Ask / SQL view toggle */
  .qf-toggle button {
    color: #cbd5c0;
  }

  .qf-toggle button[aria-pressed="true"] {
    background: #d9f99d;
    color: #1a2e05;
  }

  .qf-workspace[data-view="ask"] .qf-view-sql,
  .qf-workspace[data-view="sql"] .qf-view-ask {
    display: none;
  }

  /* Keep the terminal a stable height so toggling views doesn't jump */
  .qf-workspace {
    min-height: 20rem;
  }

  /* Blinking caret at the end of the typed question */
  .qf-term-cursor {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 0.1ch;
    transform: translateY(0.15em);
    background: #bef264;
    animation: qfCaret 1s steps(1) infinite;
  }

  @keyframes qfCaret {
    50% {
      opacity: 0;
    }
  }

  /* Agent steps stream in one at a time */
  .qf-term-step {
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(0.25rem);
    animation: qfStepIn 260ms ease forwards;
  }

  .qf-term-step::before {
    content: "▸";
    color: #bef264;
  }

  .qf-term-step.is-done::before {
    content: "✓";
  }

  @keyframes qfStepIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* In Ask view, hold the result back until the agent "finishes" */
  .qf-workspace[data-view="ask"] .qf-result {
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 400ms ease, transform 400ms ease;
  }

  .qf-workspace[data-view="ask"].is-answered .qf-result {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('.hero-demo');

  if (demo) {
    // ---- Ask / SQL view toggle + scripted agent terminal ----
    const workspace = demo.querySelector<HTMLElement>('.qf-workspace');
    const qEl = demo.querySelector<HTMLElement>('.qf-term-q');
    const cursorEl = demo.querySelector<HTMLElement>('.qf-term-cursor');
    const stepsEl = demo.querySelector<HTMLElement>('.qf-term-steps');

    if (workspace && qEl && cursorEl && stepsEl) {
      const QUESTION = 'Where should I open a new coffee shop in NYC?';
      const STEPS = [
        'Wrapped NYC storefront rents (CSV) as a VGI worker',
        'Wrapped MTA ridership feed (API) as a VGI worker',
        'Wrapped NYC business permits (civic dataset) as a VGI worker',
        'Attached all three → running SQL on DuckDB',
      ];

      const HOLD_MS = 3200; // how long the finished result rests before replaying
      const timers: number[] = [];
      let run = 0;
      let loopTimer: number | undefined;
      let hovering = false;

      const clearTimers = () => {
        timers.forEach((t) => window.clearTimeout(t));
        timers.length = 0;
      };
      const later = (fn: () => void, ms: number) => {
        timers.push(window.setTimeout(fn, ms));
      };
      const cancelLoop = () => {
        if (loopTimer !== undefined) {
          window.clearTimeout(loopTimer);
          loopTimer = undefined;
        }
      };
      const scheduleLoop = () => {
        if (loopTimer !== undefined) return;
        loopTimer = window.setTimeout(() => {
          loopTimer = undefined;
          playTerminal();
        }, HOLD_MS);
      };

      const playTerminal = () => {
        const token = ++run;
        clearTimers();
        cancelLoop();
        qEl.textContent = '';
        stepsEl.replaceChildren();
        workspace.classList.remove('is-answered');
        cursorEl.style.removeProperty('display');

        // Reveal the agent steps one by one.
        let s = 0;
        const revealSteps = () => {
          if (token !== run) return;
          if (s > 0) stepsEl.children[s - 1]?.classList.add('is-done');
          if (s >= STEPS.length) {
            cursorEl.style.setProperty('display', 'none');
            workspace.classList.add('is-answered');
            // Rest on the result, then loop — unless the reader is hovering.
            if (workspace.dataset.view === 'ask' && !hovering) scheduleLoop();
            return;
          }
          const li = document.createElement('li');
          li.className = 'qf-term-step';
          li.textContent = STEPS[s];
          stepsEl.appendChild(li);
          s += 1;
          later(revealSteps, 560);
        };

        // Type the question, then stream the steps.
        let i = 0;
        const type = () => {
          if (token !== run) return;
          qEl.textContent = QUESTION.slice(0, i);
          i += 1;
          if (i <= QUESTION.length) {
            later(type, 34);
          } else {
            later(revealSteps, 450);
          }
        };

        type();
      };

      const setView = (view: string) => {
        workspace.dataset.view = view;
        demo.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.viewBtn === view));
        });
        if (view === 'ask') {
          playTerminal();
        } else {
          clearTimers();
          cancelLoop();
          run += 1; // cancel any in-flight terminal run
        }
      };

      demo.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((btn) => {
        btn.addEventListener('click', () => setView(btn.dataset.viewBtn || 'ask'));
      });

      // Pause the loop while the reader is hovering, resume when they leave.
      demo.addEventListener('pointerenter', () => {
        hovering = true;
        cancelLoop();
      });
      demo.addEventListener('pointerleave', () => {
        hovering = false;
        if (workspace.dataset.view === 'ask' && workspace.classList.contains('is-answered')) {
          scheduleLoop();
        }
      });

      // Ask view is the default — play it on load.
      playTerminal();
    }
  }
</script>
