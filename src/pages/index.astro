---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

// Get latest blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const extensionCount = publicExtensions.length;
const extensionLoads = usageSummary?.totalLast365Days;
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};

const platformComponents = [
  {
    icon: 'plug',
    title: 'Extensions',
    eyebrow: `${extensionCount} installable capabilities`,
    outcome: 'Connect systems and add SQL capabilities.',
    description: 'Install connectors, transformations, sketches, scripting, geospatial, JSON, text, and operational tools without building native extension plumbing yourself.',
    href: '/products/extensions',
    cta: 'Browse extensions',
    color: 'bg-earth-100 text-earth-800',
  },
  {
    icon: 'gateway',
    title: 'VGI',
    eyebrow: 'Vector Gateway Interface',
    outcome: 'Run custom or reusable workers from SQL.',
    description: 'Make APIs, services, models, and business logic available as SQL-accessible tables and functions through Arrow-based workers.',
    href: '/vgi',
    cta: 'Learn about VGI',
    color: 'bg-duck-100 text-duck-800',
  },
  {
    icon: 'dashboard',
    title: 'Cupola',
    eyebrow: 'Web frontend for VGI',
    outcome: 'Give teams a place to browse and operate workers.',
    description: 'A web surface for VGI-powered data access: discover connectors, configure workers, and make the platform usable beyond the shell.',
    color: 'bg-sky-100 text-sky-800',
  },
  {
    icon: 'shield',
    title: 'Haybarn',
    eyebrow: 'Production distribution',
    outcome: 'Package and ship the platform safely.',
    description: 'Run a compatible DuckDB distribution with signed builds, curated extension defaults, provenance, and enterprise-friendly npm/PyPI distribution.',
    href: '/haybarn',
    cta: 'Explore Haybarn',
    color: 'bg-harvest-100 text-harvest-800',
  },
  {
    icon: 'orchard',
    title: 'The Orchard',
    eyebrow: 'Connector interface',
    outcome: 'Discover and connect reusable data components.',
    description: 'The connector interface for Query.Farm: a place for teams to find, configure, and reuse the data connections that make up their platform.',
    color: 'bg-emerald-100 text-emerald-800',
  },
];

const useCases = [
  {
    title: 'Query data where it lives',
    description: 'APIs, files, services, and databases become SQL-accessible without moving everything first.',
  },
  {
    title: 'Join sources quickly',
    description: 'Attach sources and join them with SQL. No pandas glue, ETL job, or warehouse model required.',
  },
  {
    title: 'Reuse connectors',
    description: 'Build a connector once, catalog it, and reuse it across projects.',
  },
  {
    title: 'Call code from SQL',
    description: 'Run models, validators, enrichment, and internal services from SQL.',
  },
  {
    title: 'Embed analytics',
    description: 'Bring fast SQL into apps, agents, notebooks, workflows, and internal tools.',
  },
  {
    title: 'Package for production',
    description: 'Ship signed builds, curated catalogs, and deployable extension packages.',
  },
];

const queryFarmReasons = [
  'Turn APIs, files, services, models, and custom code into SQL components.',
  'Discover and reuse those components across teams and projects.',
  'Ship data workflows without building connector infrastructure first.',
];

const practicalExamples = [
  {
    title: 'Example: research data platform',
    example: 'A team has market feeds, vendor APIs, internal models, CSV drops, and application data. Query.Farm turns each source into a reusable SQL component so analysts, apps, and agents can join them without rebuilding connectors every time.',
  },
];

const practicalScenario = {
  title: 'The point',
  description: 'You get the useful parts of a data platform: discovery, reusable connectors, SQL access, packaging, and production paths, without starting by building platform infrastructure.',
};

const duckDbComparisons = [
  {
    title: 'Runs anywhere',
    description: 'Use SQL inside an app, notebook, CLI, browser, service, or workflow.',
  },
  {
    title: 'Fast without a cluster',
    description: 'Great for analytical SQL near files, apps, connectors, and services.',
  },
  {
    title: 'Simple to embed',
    description: 'No warehouse-sized footprint when the job is local, embedded, or app-adjacent.',
  },
];

const proofPoints = [
  { value: String(extensionCount), label: 'ready-made SQL capabilities' },
  ...(extensionLoads ? [{ value: `${compactCount(extensionLoads)}+`, label: 'extension loads in the last year' }] : []),
  { value: 'SQL', label: 'to join APIs, files, services, and code' },
];

const heroExamples = [
  {
    sources: 'Citi Bike + NOAA weather',
    query: 'Do rainy days change commute station demand?',
  },
  {
    sources: 'NYC restaurant inspections + Citi Bike + NOAA weather',
    query: 'Where do dinner rides spike after sunny inspection wins?',
  },
  {
    sources: 'OpenStreetMap gyms + CDC activity + NOAA heat',
    query: 'Which neighborhoods need indoor fitness options during heat waves?',
  },
  {
    sources: 'NYC DOF sales + Census ACS',
    query: 'Which affordable neighborhoods are growing fastest?',
  },
  {
    sources: 'SEC filings + FRED rates',
    query: 'Which companies mention rates as policy changes?',
  },
  {
    sources: 'USDA FoodData Central + FDA recalls + openFDA events',
    query: 'Which ingredients show nutrition upside and safety risk?',
  },
  {
    sources: 'NASA fire data + NOAA weather + EPA air quality',
    query: 'Which smoke events line up with wind shifts and bad air?',
  },
  {
    sources: 'NOAA storms + FEMA disasters + Census ACS + HUD housing',
    query: 'Which communities face repeated storm damage and housing risk?',
  },
];

const heroPublicSources = [
  {
    alias: 'storefronts',
    label: 'storefronts.csv',
    type: 'CSV file',
    domain: 'local rent + vacancy list',
    href: 'https://data.cityofnewyork.us/',
  },
  {
    alias: 'transit',
    label: 'Transit ridership',
    type: 'Public API',
    domain: 'mta.info/developers',
    href: 'https://new.mta.info/developers',
  },
  {
    alias: 'permits',
    label: 'Business permits',
    type: 'Civic dataset',
    domain: 'data.cityofnewyork.us',
    href: 'https://data.cityofnewyork.us/',
  },
  {
    alias: 'weather',
    label: 'NOAA weather',
    type: 'Weather dataset',
    domain: 'ncei.noaa.gov',
    href: 'https://www.ncei.noaa.gov/',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm is a data access platform that helps teams query APIs, services, files, databases, and custom code with SQL, then package those workflows for production.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    sameAs: [
      'https://github.com/Query-farm',
      'https://twitter.com/queryfarm',
      'https://linkedin.com/company/queryfarm',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="relative flex min-h-[92vh] items-center bg-gradient-to-br from-harvest-100 via-harvest-50 to-white overflow-hidden py-14 lg:py-20 font-display">
    <div class="absolute inset-0 opacity-35">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="home-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#home-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-5xl mx-auto text-center">
        <div class="hero-built-line mb-8 lg:mb-10" aria-label="Combine public data sources and ask cross-dataset SQL questions">
          <div class="hero-built-row">
            <span class="hero-built-label">Gather public data</span>
            <span class="hero-built-rotator hero-built-sources" aria-hidden="true">
              {heroExamples.map((example, index) => (
                <span style={`--hero-rotate-delay: ${index * 5}s`}>{example.sources}</span>
              ))}
            </span>
          </div>
          <div class="hero-built-row">
            <span class="hero-built-label">Ask with SQL</span>
            <span class="hero-built-rotator hero-built-queries" aria-hidden="true">
              {heroExamples.map((example, index) => (
                <span style={`--hero-rotate-delay: ${index * 5}s`}>{example.query}</span>
              ))}
            </span>
          </div>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-normal text-soil-900 leading-tight">
          Query any data, anywhere,
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">with SQL.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl lg:text-2xl text-soil-700 leading-relaxed max-w-3xl mx-auto">
          Query.Farm turns APIs, public datasets, files, databases, and custom code into SQL-accessible tables and functions. Teams can discover, reuse, and ship those connections without building a data platform from scratch.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/products" variant="accent" size="lg">Explore Products</Button>
          <Button href="/company/schedule" variant="secondary" size="lg">Talk to an Expert</Button>
        </div>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-3xl mx-auto">
          {proofPoints.map((point) => (
            <div class="rounded-xl border-2 border-soil-900 bg-white px-5 py-4 shadow-sm">
              <div class="text-2xl md:text-3xl font-extrabold tracking-normal text-harvest-700">{point.value}</div>
              <div class="mt-1 text-sm text-soil-600">{point.label}</div>
            </div>
          ))}
        </div>

        <div class="hero-demo mt-12 rounded-2xl border-2 border-soil-900 bg-white p-3 md:p-4 shadow-2xl text-left">
          <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-5 lg:gap-6 items-stretch">
            <div class="rounded-xl border-2 border-soil-900 bg-grain-50 p-4 md:p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-soil-900 mb-2">Start with a question</p>
              <div class="mb-4 rounded-xl border border-soil-900/15 bg-white p-3 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-wider text-harvest-700">What we want to answer</p>
                <p class="mt-1 text-sm font-bold leading-relaxed text-soil-900">
                  Where should I open a new coffee shop?
                </p>
              </div>
              <p class="mb-3 text-sm font-semibold text-soil-800 leading-relaxed">
                Gather the public sources needed to answer it:
              </p>
              <p class="mb-4 text-sm text-soil-600 leading-relaxed">
                a local CSV, a public API, a civic dataset, and a weather dataset. Query.Farm makes each one available to the same SQL workspace.
              </p>
              <div class="space-y-3">
                {heroPublicSources.map((source) => (
                  <a
                    href={source.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={source.href}
                    class={`hero-source-card hero-source-${source.alias} group block rounded-lg border border-soil-900/20 bg-white px-3 py-2.5 transition-colors hover:border-soil-900 hover:bg-grain-100 focus:border-soil-900 focus:bg-grain-100 focus:outline-none`}
                  >
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-sm font-semibold text-soil-800">{source.label}</span>
                      <span class="shrink-0 rounded-full bg-soil-900 px-2.5 py-1 text-xs font-bold text-grain-100">{source.type}</span>
                    </div>
                    <div class="mt-1 truncate text-xs font-medium text-soil-500 group-hover:text-harvest-800">
                      {source.domain}
                    </div>
                  </a>
                ))}
              </div>
              <p class="mt-4 text-sm text-soil-600 leading-relaxed">
                Hover a source to see how it flows into the query. Use the same pattern for SaaS APIs, files, models, and internal services.
              </p>
            </div>

            <div class="rounded-xl border-2 border-soil-900 bg-soil-900 p-4 md:p-5 text-soil-100 shadow-lg">
              <div class="mb-4 flex items-center justify-between gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">Query.Farm workspace</p>
                  <h3 class="mt-1 text-lg font-bold text-white">Join live sources with ordinary SQL</h3>
                </div>
                <span class="hidden sm:inline-flex rounded-full border border-harvest-400/40 bg-harvest-400/10 px-3 py-1 text-xs font-bold text-harvest-200">DuckDB</span>
              </div>
              <pre class="font-mono overflow-x-auto rounded-lg border border-white/10 bg-black/25 p-4 text-sm leading-relaxed text-soil-100"><code><span class="sql-keyword">ATTACH</span> <span class="sql-string">'storefronts.csv'</span> <span class="sql-keyword">AS</span> <span class="source-token source-storefronts">storefronts</span> (...);
<span class="sql-keyword">ATTACH</span> <span class="sql-string">'transit'</span> <span class="sql-keyword">AS</span> <span class="source-token source-transit">transit</span> (...);
<span class="sql-keyword">ATTACH</span> <span class="sql-string">'business_permits'</span> <span class="sql-keyword">AS</span> <span class="source-token source-permits">permits</span> (...);
<span class="sql-keyword">ATTACH</span> <span class="sql-string">'weather'</span> <span class="sql-keyword">AS</span> <span class="source-token source-weather">weather</span> (...);

<span class="sql-keyword">SELECT</span> neighborhood, <span class="source-token source-transit">foot_traffic</span>, <span class="source-token source-storefronts">median_rent</span>,
       <span class="source-token source-permits">nearby_cafes</span>, <span class="source-token source-weather">rainy_days</span>, opportunity_score
<span class="sql-keyword">FROM</span> <span class="source-token source-storefronts">storefronts.available</span>
<span class="sql-keyword">JOIN</span> <span class="source-token source-transit">transit.station_activity</span> <span class="sql-keyword">USING</span> (neighborhood)
<span class="sql-keyword">JOIN</span> <span class="source-token source-permits">permits.food_service</span> <span class="sql-keyword">USING</span> (neighborhood)
<span class="sql-keyword">JOIN</span> <span class="source-token source-weather">weather.monthly</span> <span class="sql-keyword">USING</span> (neighborhood)
<span class="sql-keyword">ORDER BY</span> opportunity_score <span class="sql-keyword">DESC</span>;</code></pre>
              <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-3">
                <div class="mb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                  <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">Result</p>
                  <p class="text-xs text-soil-300">Joined different source types in one query</p>
                </div>
                <div class="grid grid-cols-[1.1fr_0.7fr_0.7fr_0.6fr_0.7fr] gap-2 text-xs">
                  <div class="text-soil-300">neighborhood</div>
                  <div class="text-soil-300">traffic</div>
                  <div class="text-soil-300">rent</div>
                  <div class="text-soil-300">cafes</div>
                  <div class="text-soil-300">score</div>
                  {[
                    ['Long Island City', 'High', '$7.8K', '12', '91'],
                    ['Astoria', 'High', '$6.4K', '18', '86'],
                    ['Sunset Park', 'Medium', '$4.9K', '7', '82'],
                  ].map((row) => (
                    <>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[0]}</div>
                      <div class="source-result source-transit rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[1]}</div>
                      <div class="source-result source-storefronts rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[2]}</div>
                      <div class="source-result source-permits rounded bg-white/10 px-2 py-1.5 text-soil-100">{row[3]}</div>
                      <div class="rounded bg-white/10 px-2 py-1.5 text-harvest-200">{row[4]}</div>
                    </>
                  ))}
                </div>
                <p class="mt-3 text-sm font-semibold leading-relaxed text-soil-100">
                  Long Island City rises to the top: strong foot traffic, manageable rent, enough rainy-day demand, and less cafe saturation than other busy neighborhoods.
                </p>
              </div>
              <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                {[
                  ['Schemas discovered', 'Inspect tables immediately'],
                  ['No warehouse model', 'No foreign-key setup first'],
                  ['No ETL job', 'Query before moving data'],
                  ['No pandas glue', 'Join with plain SQL'],
                ].map(([title, detail]) => (
                  <div class="rounded-xl border border-harvest-300/40 bg-harvest-300/15 px-3 py-3 shadow-[0_0_0_1px_rgba(190,242,100,0.08)]">
                    <p class="text-sm font-extrabold text-harvest-100">{title}</p>
                    <p class="mt-1 text-xs font-semibold text-soil-300">{detail}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform framing -->
  <section class="flex min-h-[90vh] items-center py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="The data farm"
        title="A platform of components that work together"
        description="A real farm is not one tool. It is fields, barns, orchards, paths, storage, and equipment working toward one outcome. Query.Farm works the same way for data access: each component does a job, and together they form a platform for querying scattered data with SQL."
      />

      <div class="mt-12 max-w-6xl mx-auto rounded-2xl border-2 border-soil-900 bg-emerald-50 p-5 md:p-8 shadow-lg overflow-visible">
        <div class="mb-8 text-center">
          <div class="mx-auto max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 mb-2">Query.Farm data platform</p>
            <h3 class="text-2xl font-bold text-soil-900">Every component works together</h3>
            <p class="mt-2 text-sm text-soil-600">
              Each square is one part of the data farm. Together they let teams build, discover, run, and reuse SQL-accessible data connections.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {platformComponents.map((pillar) => (
            <div tabindex="0" class="group relative aspect-square rounded-xl border-2 border-soil-900 bg-white p-4 shadow-sm transition-all hover:z-30 hover:-translate-y-1 hover:bg-grain-50 hover:shadow-xl focus:z-30 focus:-translate-y-1 focus:bg-grain-50 focus:shadow-xl focus:outline-none">
              <div class="flex h-full flex-col items-center justify-center text-center">
                <div class={`w-16 h-16 rounded-xl ${pillar.color} flex items-center justify-center`}>
                  {pillar.icon === 'plug' && (
                    <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3M16 7V3M7 7h10v4a5 5 0 01-10 0V7zM12 16v5" />
                    </svg>
                  )}
                  {pillar.icon === 'gateway' && (
                    <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6h5v5H5zM14 13h5v5h-5zM14 6h5M5 18h5M10 8.5h4M12 11v2" />
                    </svg>
                  )}
                  {pillar.icon === 'dashboard' && (
                    <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16v12H4zM8 10h3M8 14h8M15 10h1" />
                    </svg>
                  )}
                  {pillar.icon === 'shield' && (
                    <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3l7 3v5c0 4.5-2.8 8.2-7 10-4.2-1.8-7-5.5-7-10V6l7-3z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-5" />
                    </svg>
                  )}
                  {pillar.icon === 'orchard' && (
                    <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 20v-7M8 20h8M12 13c-3 0-5-1.7-5-4.2C7 6.2 9.2 5 12 7.2 14.8 5 17 6.2 17 8.8 17 11.3 15 13 12 13z" />
                    </svg>
                  )}
                </div>
                <h4 class="mt-4 text-xl font-bold text-soil-900">{pillar.title}</h4>
                <p class="mt-2 text-sm font-semibold leading-snug text-soil-700">{pillar.outcome}</p>
              </div>

              <div class="absolute left-1/2 top-[calc(100%+0.75rem)] z-40 hidden w-72 -translate-x-1/2 rounded-xl border-2 border-soil-900 bg-white p-4 shadow-xl group-hover:block group-focus:block">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">{pillar.eyebrow}</p>
                  <p class="mt-1 text-lg font-bold text-soil-900">{pillar.title}</p>
                  <p class="mt-2 text-sm text-soil-700 leading-relaxed">{pillar.description}</p>
                  {pillar.href ? (
                    <a href={pillar.href} class="mt-4 inline-flex self-start rounded-md border border-soil-900 bg-grain-100 px-3 py-2 text-xs font-bold text-soil-900 hover:bg-grain-200">
                      {pillar.cta} →
                    </a>
                  ) : (
                    <span class="mt-4 inline-flex self-start rounded-md bg-soil-100 px-3 py-2 text-xs font-bold text-soil-500">
                      In development
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-xl border-2 border-soil-900 bg-soil-900 p-6 text-center shadow-xl">
          <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">All together</p>
          <h4 class="mt-2 text-2xl font-bold text-white">The Query.Farm platform</h4>
          <p class="mx-auto mt-2 max-w-2xl text-sm text-soil-200">
            These components work together as one data platform for building, operating, and reusing SQL-accessible connections.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform comparison -->
  <section class="flex min-h-[90vh] items-center py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Why Query.Farm"
        title="Reusable SQL access for scattered data"
