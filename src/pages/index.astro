---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

// ── Blog ────────────────────────────────────────────────────────────────────
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// ── Real numbers ────────────────────────────────────────────────────────────
const extensionCount = publicExtensions.length;
const annualizedLoads = usageSummary?.annualizedLoads ?? null;

/** Compact load counts for the catalog column: 23.5M, 5.5M, 590K. */
const compactLoads = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(0)}K`;
  return String(n);
};

const rankedExtensions = [...publicExtensions]
  .filter(e => typeof e.usageCount === 'number' && e.usageCount > 0)
  .sort((a, b) => (b.usageCount ?? 0) - (a.usageCount ?? 0));

const topExtensions = rankedExtensions.slice(0, 12);
const maxLoads = topExtensions[0]?.usageCount ?? 1;
const loadPeriod = topExtensions[0]?.usagePeriod ?? 'last 90 days';
const remainingExtensions = Math.max(extensionCount - topExtensions.length, 0);

const heroMini = [
  { value: String(extensionCount), label: 'extensions' },
  { value: '6', label: 'worker languages' },
  { value: '1', label: 'install command' },
  { value: '0', label: 'warehouses required' },
];

const sourceChips = [
  { name: 'storefronts.csv', kind: 'CSV' },
  { name: 'mta://ridership', kind: 'Public API' },
  { name: 'nyc://permits', kind: 'Civic dataset' },
  { name: 'noaa://weather', kind: 'Weather' },
  { name: 's3://lake/*.parquet', kind: 'Object store' },
  { name: 'postgres://prod', kind: 'Database' },
  { name: 'internal scoring svc', kind: 'Your code' },
];

const stageNames = ['Source', 'Connector', 'Reuse', 'Ship'];

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// ── Meta (unchanged) ────────────────────────────────────────────────────────
const SITE_ORIGIN = 'https://query.farm';
const homeDescription = 'Query.Farm is a data access platform that helps teams query APIs, services, files, databases, and custom code with SQL, then package those workflows for production.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    logo: `${SITE_ORIGIN}/og-image.jpg`,
    description: homeDescription,
    // `sameAs` is a claim to search engines that these profiles are ours, so it
    // lists only accounts that exist. The Twitter handle never did.
    sameAs: [
      'https://github.com/Query-farm',
      'https://www.linkedin.com/company/query-farm/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Query.Farm',
    url: SITE_ORIGIN,
    description: homeDescription,
  },
];
---

<BaseLayout title="Query.Farm" description={homeDescription} jsonLd={jsonLd}>
  {/* Mobile / narrow: a sticky progress strip naming the current stage. */}
  <div class="railbar" aria-hidden="true">
    <div class="wrap in">
      <span id="rb-label">1 · Source</span>
      <span class="track"><i id="rb-fill"></i></span>
      <span>of 4</span>
    </div>
  </div>

  {/* Wide: fixed dots on the right edge. */}
  <nav class="rail" aria-label="Pipeline stages">
    {stageNames.map((name, i) => (
      <a href={`#st${i + 1}`} data-on={i === 0 ? '' : undefined}>
        <span>{i + 1} · {name}</span>
      </a>
    ))}
  </nav>

  <!-- ═══ 1 · SOURCE ═══ -->
  <section class="stage s1" id="st1" data-stage="1">
    <div class="wrap">
      <span class="stagelbl"><i class="n">1</i> Source</span>
      <h1 class="h-hero">Follow one query from source to shipped.</h1>
      <p class="lede mt-1">
        Query.Farm turns APIs, public datasets, files, databases, and custom code into
        SQL-accessible tables and functions. Below is the whole path — four stages, one page,
        from raw source to a production connector.
      </p>
      <div class="btns mt-2">
        <Button href="#st2" variant="primary">Start the pipeline</Button>
        <Button href="/products/extensions" variant="ghost">Browse {extensionCount} extensions</Button>
      </div>

      <div class="hero-stat">
        {annualizedLoads && (
          <>
            <div class="stat-value n">{annualizedLoads.toLocaleString('en-US')}</div>
            <div class="l">Extension loads per year</div>
          </>
        )}
        <div class="hero-mini">
          {heroMini.map(m => (
            <span><b class="qf-figure">{m.value}</b> {m.label}</span>
          ))}
        </div>
      </div>

      <p class="cap mt-3">What you already have, in whatever shape you left it</p>
      <div class="chips">
        {sourceChips.map(c => (
          <span class="chip">{c.name}<span class="k">{c.kind}</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 2 · CONNECTOR ═══ -->
  <section class="stage s2" id="st2" data-stage="2">
    <div class="wrap">
      <span class="stagelbl"><i class="n">2</i> Connector</span>
      <h2>Something has to speak both languages</h2>
      <p class="d">
        An extension if one already exists — {extensionCount} do. A VGI worker if it doesn't:
        a small program in Python, Go, Rust, Java, TypeScript, or Kotlin that answers with Arrow.
      </p>

      <div class="prods">
        <a class="prod" href="/products/extensions">
          <span class="lg"><img src="/images/duckdb-icon.svg" alt="" width="26" height="26" /></span>
          <h3>Extensions</h3>
          <div class="sub"><span class="qf-figure">{extensionCount}</span> ready · one INSTALL</div>
          <p>
            Connectors, geospatial indexes, hashing, JSON tools, and scripting engines — each
            behaves as if it shipped with DuckDB. No C++ required.
          </p>
        </a>
        <a class="prod" href="/vgi">
          <span class="lg"><img src="/vgi/vgi-logo.png" alt="" width="26" height="26" /></span>
          <h3>VGI</h3>
          <div class="sub"><span class="qf-figure">6</span> worker languages</div>
          <p>
            Wrap an API, service, model, or business rule in a small worker, then ATTACH it so
            DuckDB queries it like any other table.
          </p>
        </a>
      </div>

      {topExtensions.length > 0 && (
        <div class="catalog">
          <div class="ch">
            <h3>The extension catalog</h3>
            <span class="badge badge-gold"><span class="qf-figure">{extensionCount}</span> available</span>
            <span class="m">Loads · {loadPeriod}</span>
          </div>
          <div class="catgrid">
            {topExtensions.map(ext => (
              <a href={`/products/extensions/${ext.id}`}>
                <div class="nm">{ext.name}</div>
                <div class="v qf-figure">{compactLoads(ext.usageCount ?? 0)}</div>
                <div class="bar">
                  <i style={`width:${Math.max(4, Math.round(((ext.usageCount ?? 0) / maxLoads) * 100))}%`}></i>
                </div>
              </a>
            ))}
          </div>
          <div class="catfoot">
            <span class="small">
              {remainingExtensions > 0
                ? `${remainingExtensions} more — geo indexes, templating, streaming, scripting engines.`
                : 'Geo indexes, templating, streaming, scripting engines.'}
            </span>
            <Button href="/products/extensions" variant="ghost" size="sm">Browse all {extensionCount} →</Button>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ 3 · REUSE — mid band, INK text (cream is 2.7:1 here) ═══ -->
  <section class="stage s3" id="st3" data-stage="3">
    <div class="wrap">
      <span class="stagelbl"><i class="n">3</i> Reuse</span>
      <h2>Then it stops being a one-off</h2>
      <p class="lede">
        The connector you just configured is worth more the second time. Catalog it, put a face
        on it, and the next person doesn't rebuild any of it.
      </p>
      <div class="prods">
        <a class="prod" href="/products/orchard">
          <span class="lg"><span class="em" role="img" aria-label="Orchard">🌳</span></span>
          <h3>Orchard</h3>
          <div class="sub">Shared connector catalog</div>
          <p>
            Configure a source once, then let everyone on the team attach and reuse it instead of
            rebuilding it.
          </p>
        </a>
        <a class="prod" href="/products/cupola">
          <span class="lg"><img src="/cupola/cupola-mark.svg" alt="" width="26" height="26" /></span>
          <h3>Cupola</h3>
          <div class="sub">Web frontend for VGI</div>
          <p>
            See what workers exist, what tables and functions each exposes, and run queries
            without opening a terminal.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 4 · SHIP ═══ -->
  <section class="stage s4 on-dark" id="st4" data-stage="4">
    <div class="wrap">
      <span class="stagelbl"><i class="n">4</i> Ship</span>
      <h2>And then it goes to production</h2>
      <div class="two two-center">
        <div>
          <p class="lede mt-0">
            Haybarn is the last stage: a hardened DuckDB distribution with signed builds, pinned
            extension sets, and clients for Python, Node, JDBC, Rust, and the browser — so what
            you tested is exactly what you shipped.
          </p>
          <div class="chips">
            <span class="chip">signed builds</span>
            <span class="chip">pinned extension sets</span>
            <span class="chip">Python · Node · JDBC</span>
            <span class="chip">Rust · browser</span>
          </div>
        </div>
        <a class="prod prod-solo" href="/haybarn">
          <span class="lg"><img src="/haybarn/haybarn-mark.svg" alt="" width="26" height="26" /></span>
          <h3>Haybarn</h3>
          <div class="sub">Production distribution</div>
          <p>
            What you test is exactly what you ship. Per-DuckDB-version build status published for
            every release.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · back to the surface ═══ -->
  <section class="stage s7 closing">
    <div class="wrap">
      <div class="box">
        <div>
          <span class="eyebrow">Expert help</span>
          <h2 class="mt-1">Bring us the connector you'd rather not build.</h2>
          <p class="lede mt-1">
            Start with one extension, add VGI workers, evaluate Haybarn — or hand us the
            production data platform your team needs to ship.
          </p>
        </div>
        <div class="btns">
          <Button href="/company/schedule" variant="primary">Schedule a call</Button>
          <Button href="/consulting" variant="ghost">View consulting</Button>
        </div>
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="posts">
      <div class="wrap">
        <div class="posthead">
          <div>
            <span class="eyebrow">From the blog</span>
            <h2 class="mt-1">Latest updates</h2>
            <p class="lede mt-1">
              Release notes, product thinking, and technical notes from the Query.Farm team.
            </p>
          </div>
          <Button href="/blog" variant="ghost" size="sm">View all posts →</Button>
        </div>

        <div class="postgrid">
          {latestPosts.map(post => (
            <a class="post" href={`/blog/${post.id}`}>
              <span class="strip" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i><i></i>
              </span>
              <div class="pb">
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="badges">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="badge">{tag}</span>
                    ))}
                  </div>
                )}
                <h3>{post.data.title}</h3>
                <p class="small">{post.data.description}</p>
                <div class="meta">
                  {post.data.author && <span>{post.data.author}</span>}
                  <span class="qf-figure">{dateFmt(post.data.pubDate)}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Stage rail. Progressive enhancement only: without JS the rail still links to
  // each stage and the bar shows stage 1.
  const stages = Array.from(document.querySelectorAll<HTMLElement>('.stage[data-stage]'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.rail a'));
  const label = document.getElementById('rb-label');
  const fill = document.getElementById('rb-fill');
  const names = ['Source', 'Connector', 'Reuse', 'Ship'];

  if (stages.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const n = Number((entry.target as HTMLElement).dataset.stage);
          if (!n) continue;
          dots.forEach((d, i) => {
            if (i === n - 1) d.setAttribute('data-on', '');
            else d.removeAttribute('data-on');
          });
          if (label) label.textContent = `${n} · ${names[n - 1]}`;
          if (fill) fill.style.width = `${(n / 4) * 100}%`;
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    stages.forEach(s => io.observe(s));
  }
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════
     Homepage only — family A is the ONLY page allowed full colour
     bands (DESIGN_BRIEF §5). Everything here is scoped to this page.
     ═══════════════════════════════════════════════════════════════ */

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ── type helpers (Petrona sets words) ── */
  .h-hero {
    font-family: 'Petrona', Georgia, serif;
    font-size: clamp(38px, 5.8vw, 74px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-top: 15px;
  }
  .stage h2 {
    font-size: clamp(25px, 3.4vw, 40px);
    margin-top: 15px;
    max-width: 19ch;
  }
  .stage h3,
  .posts h3 {
    font-size: clamp(19px, 2.2vw, 25px);
  }
  .lede {
    font-size: 17.5px;
    color: #5f5344;
    max-width: 58ch;
  }
  .small {
    font-size: 13.5px;
    color: #5f5344;
  }
  /* Small labels are sentence-case Commissioner — mono is for code only, and
     uppercase + tracking on every caption built an instrument-panel texture.
     Weight and colour carry the hierarchy instead. */
  .cap {
    font-weight: 500;
    font-size: 12.5px;
    letter-spacing: 0;
    color: #5f5344;
  }
  .eyebrow {
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 0;
    color: var(--color-sun-700);
  }
  .mt-0 { margin-top: 0; }
  .mt-1 { margin-top: 12px; }
  .mt-2 { margin-top: 22px; }
  .mt-3 { margin-top: 34px; }

  /* ── buttons ──
     Appearance lives in src/components/ui/Button.astro (one API for the
     whole site); this only lays the row out. */
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── badges ── */
  .badges { display: flex; gap: 7px; flex-wrap: wrap; }
  .badge {
    display: inline-block;
    font-weight: 500;
    font-size: 12.5px;
    letter-spacing: 0;
    border: 1px solid #ddd2ba;
    border-radius: 999px;
    padding: 3px 10px;
    color: #5f5344;
  }
  .badge-gold {
    border-color: var(--color-sun-400);
    color: var(--color-sun-700);
    background: rgba(217, 164, 65, 0.12);
  }

  /* ── the six stage bands + the chevron notch ── */
  .stage { padding: 78px 0; position: relative; }
  .stage::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -18px;
    width: 36px;
    height: 36px;
    transform: translateX(-50%) rotate(45deg);
    z-index: 3;
  }
  /* First stop is soil-50, not a cool green-grey. The sticky header is
     soil-50; opening stage 1 on a different hue put a visible seam right
     under the nav on every page load. The gradient still resolves to
     pipe-1, so the stage run is unchanged below the fold. */
  .s1 { background: linear-gradient(180deg, var(--color-soil-50), var(--color-pipe-1)); }
  .s1::after { background: var(--color-pipe-2); }
  .s2 { background: var(--color-pipe-2); }
  .s2::after { background: var(--color-pipe-3); }
  .s3 { background: var(--color-pipe-3); color: var(--color-soil-900); }
  .s3::after { background: var(--color-pipe-4); }
  .s4 { background: var(--color-pipe-4); color: var(--color-cream); }
  .s4::after { background: var(--color-soil-50); }
  .s7 { background: var(--color-soil-50); }
  .s7::after { display: none; }

  .stagelbl {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 0;
  }
  .stagelbl .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 11.5px;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0;
    font-style: normal;
  }
  .stage .d {
    margin-top: 15px;
    max-width: 55ch;
    color: #5f5344;
  }

  /* Contrast law §3 — measured, and it must come after the base .lede/.d
     colours above or the cascade silently undoes it.
       · MID band (pipe-3) takes INK: cream is 2.7:1, ink is 5.7:1
       · pipe-4 is the lightest "dark" band — cream-2 is only 2.9:1 there,
         so stage 4 gets full cream (4.8:1) instead. */
  .s3 .lede,
  .s3 .d,
  .s3 .small { color: var(--color-soil-900); }
  .on-dark .lede,
  .on-dark .d { color: var(--color-cream-2); }
  .s4 .lede,
  .s4 .d { color: var(--color-cream); }
  .on-dark .eyebrow { color: var(--color-sun-400); }

  /* ── stage rail ── */
  .rail {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  @media (max-width: 900px) { .rail { display: none; } }
  .rail a {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(33, 26, 18, 0.2);
    display: block;
    position: relative;
    transition: 0.3s;
  }
  .rail a[data-on] { background: var(--color-link); transform: scale(1.5); }
  .rail a:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }
  .rail a span {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0;
    opacity: 0;
    transition: 0.24s;
    pointer-events: none;
    background: var(--color-rock-900);
    color: var(--color-cream);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .rail a:hover span,
  .rail a:focus-visible span { opacity: 1; }

  .railbar {
    position: sticky;
    /* Sits directly beneath the site nav. The shell header is still 64px at
       this breakpoint (h-16); when it migrates to the 58px nav in the brief,
       change this one value (or point it at --qf-nav-h). */
    top: var(--home-railbar-top, 64px);
    z-index: 30;
    background: var(--color-soil-100);
    border-bottom: 1px solid #ddd2ba;
    display: none;
  }
  @media (max-width: 900px) { .railbar { display: block; } }
  .railbar .in {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0;
    color: #5f5344;
  }
  .railbar .track {
    flex: 1;
    height: 3px;
    background: #ddd2ba;
    border-radius: 2px;
    overflow: hidden;
  }
  .railbar .track i {
    display: block;
    height: 100%;
    width: 16.6%;
    background: var(--color-sun-700);
    transition: width 0.4s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  /* ── hero stat ── */
  .hero-stat {
    margin-top: 46px;
    padding-top: 28px;
    border-top: 1px solid rgba(33, 26, 18, 0.16);
  }
  .hero-stat .n {
    font-size: clamp(46px, 8.4vw, 102px);
    line-height: 0.88;
    color: var(--color-sun-700);
  }
  .hero-stat .l {
    font-weight: 500;
    font-size: 13.5px;
    letter-spacing: 0;
    color: #5f5344;
    margin-top: 10px;
  }
  .hero-mini {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: 22px;
    font-size: 13.5px;
    font-variant-numeric: tabular-nums lining-nums;
    color: #5f5344;
  }
  .hero-mini b { font-size: 19px; color: var(--color-soil-900); font-weight: 500; }

  /* ── chips ── */
  .chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    border: 1px solid rgba(33, 26, 18, 0.2);
    border-radius: 999px;
    padding: 8px 17px;
    font-size: 14.5px;
    background: rgba(255, 255, 255, 0.55);
  }
  .chip .k {
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0;
    opacity: 0.68;
  }
  .s3 .chip { border-color: rgba(33, 26, 18, 0.26); background: rgba(255, 255, 255, 0.45); }
  .on-dark .chip {
    border-color: rgba(255, 255, 255, 0.26);
    background: rgba(255, 255, 255, 0.09);
    color: var(--color-cream);
  }

  /* ── product cards ── */
  .prods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 30px;
  }
  .prod {
    border: 1px solid rgba(33, 26, 18, 0.16);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    padding: 22px 20px;
    text-decoration: none;
    display: block;
    transition: 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .prod:hover {
    transform: translateY(-5px);
    background: #fff;
    border-color: var(--color-sun-400);
    box-shadow: 0 22px 42px -30px rgba(33, 26, 18, 0.6);
  }
