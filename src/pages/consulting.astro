---
import PageLayout from '../layouts/PageLayout.astro';
import PageHead from '../components/ui/PageHead.astro';

// Three shapes of engagement, smallest first. The "01 · Days" kicker is the
// only ornament each card gets, plus a single stage colour on the left edge.
const engagements = [
  {
    n: '01 · Days',
    title: 'A single extension',
    description:
      'You need DuckDB to speak to one specific thing, and nobody on the team wants to write C++ to get there.',
    points: [
      'Scoped to one source or format',
      'Ships as a community extension',
      'You own the repo and the licence',
    ],
    edge: 'bg-pipe-3',
  },
  {
    n: '02 · Weeks',
    title: 'A worker fleet',
    description:
      'Several internal services need to be queryable, and the pattern should be repeatable by your own engineers afterwards.',
    points: [
      'VGI workers in your language',
      'Catalog and reuse conventions',
      'Handover with your team, not to them',
    ],
    edge: 'bg-pipe-4',
  },
  {
    n: '03 · Months',
    title: 'The production path',
    description:
      'You have it working locally and now it has to survive a security review, an upgrade, and a person leaving.',
    points: [
      'Pinned, signed Haybarn distribution',
      'Build matrix and upgrade policy',
      'Runbooks that outlive the engagement',
    ],
    edge: 'bg-pipe-5',
  },
];

const services = [
  {
    title: 'Data infrastructure consulting',
    description:
      'Expert guidance on building scalable, high-performance data infrastructure with DuckDB at the core.',
    offerings: [
      'Architecture design and review',
      'Performance optimization and tuning',
      'Migration from legacy systems',
      'Custom extension development',
      'Security and compliance audits',
      'Training and knowledge transfer',
    ],
    pricing: 'Custom pricing based on project scope',
    duration: 'Flexible engagements from 2 weeks to 6+ months',
  },
  {
    title: 'Data-as-a-Service',
    description:
      'Fully managed data infrastructure. We handle operations, maintenance, and optimization while you focus on insights.',
    offerings: [
      'Managed DuckDB infrastructure',
      'Extension installation and updates',
      'Performance monitoring and optimization',
      'Backup and disaster recovery',
      'Security and access management',
      '24/7 support and SLA guarantees',
    ],
    pricing: 'Starting at $5,000/month',
    duration: 'Ongoing monthly service',
  },
];

const methodology = [
  {
    phase: 'Discovery',
    description: 'Deep dive into your current data infrastructure, pain points, and business objectives.',
    deliverables: ['Infrastructure assessment report', 'Performance benchmarks', 'Gap analysis', 'Recommendation roadmap'],
  },
  {
    phase: 'Design',
    description: 'Architect the optimal solution tailored to your specific needs and constraints.',
    deliverables: ['Architecture diagrams', 'Technology stack recommendations', 'Security and compliance plan', 'Cost and resource estimates'],
  },
  {
    phase: 'Implementation',
    description: 'Execute the plan with precision, building and deploying your data infrastructure.',
    deliverables: ['Production-ready infrastructure', 'Custom extensions (if needed)', 'Automated deployment pipelines', 'Monitoring and alerting setup'],
  },
  {
    phase: 'Optimization',
    description: 'Tune performance, reduce costs, and ensure your system scales with your growth.',
    deliverables: ['Performance optimization report', 'Cost reduction analysis', 'Scaling strategy', 'Best practices documentation'],
  },
  {
    phase: 'Enablement',
    description: 'Empower your team with knowledge and tools to maintain and evolve the system.',
    deliverables: ['Technical training sessions', 'Runbooks and documentation', 'Support handoff plan', 'Ongoing advisory access'],
  },
];

const expertise = [
  {
    area: 'DuckDB expertise',
    details: ['Core DuckDB contributors', '50+ custom extensions built', 'Deep knowledge of query optimizer', 'Performance tuning specialists'],
  },
  {
    area: 'Data engineering',
    details: ['20+ years combined experience', 'Built systems at petabyte scale', 'Real-time and batch processing', 'ETL/ELT pipeline design'],
  },
  {
    area: 'Cloud & infrastructure',
    details: ['AWS, GCP, Azure certified', 'Kubernetes and containerization', 'Infrastructure as Code (Terraform)', 'Multi-cloud and hybrid setups'],
  },
  {
    area: 'Security & compliance',
    details: ['SOC 2, HIPAA, GDPR experience', 'Encryption and key management', 'Audit logging and monitoring', 'Zero-trust architecture'],
  },
];

const faq = [
  {
    q: 'What size companies do you work with?',
    a: "We work with everyone from fast-growing startups to Fortune 500 enterprises. If you're serious about data infrastructure, we can help.",
  },
  {
    q: 'Do you work remotely or on-site?',
    a: "We're a remote-first team and work with clients globally. For strategic engagements, we can arrange on-site visits as needed.",
  },
  {
    q: 'How quickly can you start?',
    a: 'Most projects can begin within 1-2 weeks of contract signing. For urgent needs, we can often accommodate faster timelines.',
  },
  {
    q: 'What if we need ongoing support after the project?',
    a: 'We offer flexible retainer agreements for ongoing support, maintenance, and advisory services. Many clients transition to our Data-as-a-Service offering.',
  },
  {
    q: 'Can you help migrate from our current data warehouse?',
    a: "Absolutely. We've successfully migrated clients from Snowflake, Redshift, BigQuery, and other platforms to DuckDB-based solutions with zero downtime.",
  },
  {
    q: 'What if an extension already exists for our source?',
    a: "Then we'll say so on the call and you'll have saved yourself an engagement. It happens more often than you'd think.",
  },
];

const SITE_ORIGIN = 'https://query.farm';
const consultingDescription = 'Expert DuckDB consulting for data infrastructure, custom extensions, and data-as-a-service.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Query.Farm Consulting',
    url: `${SITE_ORIGIN}/consulting`,
    description: consultingDescription,
    provider: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
    areaServed: 'Worldwide',
    serviceType: [
      'DuckDB consulting',
      'Custom DuckDB extension development',
      'Data infrastructure architecture',
      'Performance optimization',
      'Migration to DuckDB',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Consulting', item: SITE_ORIGIN + '/consulting' },
    ],
  },
];
---

<PageLayout title="Consulting Services" description={consultingDescription} jsonLd={jsonLd}>
  <PageHead
    title="Bring us the connector you'd rather not build."
    lede="We build DuckDB extensions, VGI workers, and production data platforms — usually for teams who need access to data now and don't want to spend two quarters on connector infrastructure first."
    hairband
  />

  <!-- Engagement shapes -->
  <section class="py-16">
    <div class="section-container">
      <span class="text-[13.5px] font-medium text-sun-700">How this usually goes</span>
      <h2 class="mt-3">Three shapes of engagement</h2>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {engagements.map(item => (
          <div class="relative overflow-hidden rounded-xl border border-soil-300 bg-[#fffdf7] px-6 py-6 transition duration-300 ease-out hover:-translate-y-1 hover:border-sun-400 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            <span class={`absolute inset-y-0 left-0 w-1 ${item.edge}`} aria-hidden="true"></span>
            <div class="text-[12.5px] font-medium text-sun-700">{item.n}</div>
            <h3 class="mt-1.5 text-[21px]">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{item.description}</p>
            <ul class="mt-3.5 flex flex-col gap-1.5 border-t border-soil-200 pt-3 text-[13.5px] text-soil-700">
              {item.points.map(point => (
                <li><span class="text-sun-700">→</span> {point}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-t border-soil-300 bg-soil-100/60 py-16">
    <div class="section-container">
      <span class="text-[13.5px] font-medium text-sun-700">Our services</span>
      <h2 class="mt-3">How we can help</h2>
      <p class="mt-3.5 max-w-[58ch] text-[17.5px] leading-relaxed text-soil-700">
        Whether you need strategic guidance or hands-on implementation, there's a service model
        that fits.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {services.map(service => (
          <div class="flex flex-col rounded-xl border border-soil-300 bg-[#fffdf7] p-7">
            <h3 class="text-[25px]">{service.title}</h3>
            <p class="mt-2.5 leading-relaxed text-soil-700">{service.description}</p>

            <h4 class="mt-6 text-[12.5px] font-medium text-soil-500">What's included</h4>
            <ul class="mt-2.5 flex flex-1 flex-col gap-1.5 text-sm text-soil-700">
              {service.offerings.map(offering => (
                <li><span class="text-sun-700">→</span> {offering}</li>
              ))}
            </ul>

            <dl class="mt-6 space-y-2 border-t border-soil-200 pt-4 text-sm">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-soil-600">Pricing</dt>
                <dd class="qf-figure text-right text-soil-900">{service.pricing}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-soil-600">Engagement</dt>
                <dd class="qf-figure text-right text-soil-900">{service.duration}</dd>
              </div>
            </dl>

            <a
              href="/company/schedule"
              class="mt-6 inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-center text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
            >
              Get started
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-16">
    <div class="section-container">
      <span class="text-[13.5px] font-medium text-sun-700">Our process</span>
      <h2 class="mt-3">A methodology that survives contact</h2>

      <div class="mt-8 grid gap-3.5 md:grid-cols-2 lg:grid-cols-3">
        {methodology.map((phase, index) => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-6">
            <div class="qf-figure text-[13px] text-soil-500">
              Phase {String(index + 1).padStart(2, '0')}
            </div>
            <h3 class="mt-1.5 text-[21px]">{phase.phase}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{phase.description}</p>
            <h4 class="mt-4 text-[12.5px] font-medium text-soil-500">Deliverables</h4>
            <ul class="mt-2 flex flex-col gap-1 border-t border-soil-200 pt-2.5 text-[13px] text-soil-700">
              {phase.deliverables.map(deliverable => (
                <li><span class="text-sun-700">→</span> {deliverable}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="border-t border-soil-300 py-16">
    <div class="section-container">
      <span class="text-[13.5px] font-medium text-sun-700">Why us</span>
      <h2 class="mt-3">Deep expertise across the stack</h2>

      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {expertise.map(item => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-6">
            <h3 class="text-lg">{item.area}</h3>
            <ul class="mt-3 flex flex-col gap-1.5 border-t border-soil-200 pt-3 text-[13px] text-soil-700">
              {item.details.map(detail => (
                <li><span class="text-sun-700">→</span> {detail}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The one panel: pitch on a dark side, next steps on paper -->
  <section class="pb-16" id="book">
    <div class="section-container">
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-9 text-cream">
          <span class="text-[13.5px] font-medium text-sun-400">Schedule a call</span>
          <h2 class="mt-3 text-[29px] text-cream">Thirty minutes, no deck</h2>
          <p class="mt-3 max-w-[46ch] leading-relaxed text-cream-2">
            Tell us what you're trying to query and we'll tell you which part you actually need —
            including "none of them, do this instead."
          </p>
          <ul class="mt-5 flex flex-col gap-2.5 text-[14.5px]">
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> We'll say if an existing extension already does it</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> We'll say if you don't need us yet</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> No sales sequence, no drip campaign</li>
          </ul>
        </div>

        <div class="px-8 py-9">
          <h3 class="text-[21px]">How to reach us</h3>
          <p class="mt-2.5 leading-relaxed text-soil-700">
            Book straight into the calendar, or write in with the rough shape of the data, who's
            going to use it, and what you've already tried.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/company/schedule"
              class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
            >
              Book a 30-minute call
            </a>
            <a
              href="mailto:hello@query.farm"
              class="inline-block rounded-lg border border-soil-900 px-5 py-2.5 text-sm font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
            >
              Email instead
            </a>
          </div>

          <p class="mt-4 text-[13.5px] text-soil-600">
            We reply within two working days. No newsletter unless you ask.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pb-20">
    <div class="mx-auto max-w-[820px] px-6">
      <span class="text-[13.5px] font-medium text-sun-700">Questions we get</span>
      <h2 class="mt-3 mb-5">Before you write in</h2>

      <div class="border-t border-soil-300">
        {faq.map((item, index) => (
          <details class="border-b border-soil-300" open={index === 0}>
            <summary class="qf-faq-summary flex cursor-pointer items-center justify-between gap-4 py-4.5 text-[19px] tracking-[-0.018em]">
              {item.q}
            </summary>
            <p class="max-w-[64ch] pb-5 text-soil-700">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .qf-faq-summary {
    font-family: 'Petrona', Georgia, serif;
    font-weight: 600;
    list-style: none;
  }
  .qf-faq-summary::-webkit-details-marker { display: none; }
  .qf-faq-summary::after {
    content: '+';
    flex: none;
    font-size: 19px;
    /* The +/- is the disclosure affordance on a clickable <summary>, so it
       takes the interaction green rather than the identity gold. */
    color: var(--color-link);
  }
  details[open] > .qf-faq-summary::after { content: '–'; }
</style>
