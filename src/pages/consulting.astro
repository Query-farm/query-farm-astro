---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const services = [
  {
    title: 'Data Infrastructure Consulting',
    icon: '🏗️',
    description: 'Expert guidance on building scalable, high-performance data infrastructure with DuckDB at the core.',
    offerings: [
      'Architecture design and review',
      'Performance optimization and tuning',
      'Migration from legacy systems',
      'Custom extension development',
      'Security and compliance audits',
      'Training and knowledge transfer'
    ],
    pricing: 'Custom pricing based on project scope',
    duration: 'Flexible engagements from 2 weeks to 6+ months'
  },
  {
    title: 'Data-as-a-Service',
    icon: '☁️',
    description: 'Fully managed data infrastructure. We handle operations, maintenance, and optimization while you focus on insights.',
    offerings: [
      'Managed DuckDB infrastructure',
      'Extension installation and updates',
      'Performance monitoring and optimization',
      'Backup and disaster recovery',
      'Security and access management',
      '24/7 support and SLA guarantees'
    ],
    pricing: 'Starting at $5,000/month',
    duration: 'Ongoing monthly service'
  }
];

const methodology = [
  {
    phase: 'Discovery',
    icon: '🔍',
    description: 'Deep dive into your current data infrastructure, pain points, and business objectives.',
    deliverables: [
      'Infrastructure assessment report',
      'Performance benchmarks',
      'Gap analysis',
      'Recommendation roadmap'
    ]
  },
  {
    phase: 'Design',
    icon: '📐',
    description: 'Architect the optimal solution tailored to your specific needs and constraints.',
    deliverables: [
      'Architecture diagrams',
      'Technology stack recommendations',
      'Security and compliance plan',
      'Cost and resource estimates'
    ]
  },
  {
    phase: 'Implementation',
    icon: '⚙️',
    description: 'Execute the plan with precision, building and deploying your data infrastructure.',
    deliverables: [
      'Production-ready infrastructure',
      'Custom extensions (if needed)',
      'Automated deployment pipelines',
      'Monitoring and alerting setup'
    ]
  },
  {
    phase: 'Optimization',
    icon: '🚀',
    description: 'Tune performance, reduce costs, and ensure your system scales with your growth.',
    deliverables: [
      'Performance optimization report',
      'Cost reduction analysis',
      'Scaling strategy',
      'Best practices documentation'
    ]
  },
  {
    phase: 'Enablement',
    icon: '🎓',
    description: 'Empower your team with knowledge and tools to maintain and evolve the system.',
    deliverables: [
      'Technical training sessions',
      'Runbooks and documentation',
      'Support handoff plan',
      'Ongoing advisory access'
    ]
  }
];

const caseStudies = [
  {
    company: 'TechCorp Analytics',
    industry: 'SaaS',
    challenge: 'Processing 100TB+ of event data daily with complex analytics queries taking hours to complete.',
    solution: 'Migrated from Snowflake to DuckDB with custom extensions for real-time aggregations.',
    results: [
      '95% reduction in query times',
      '70% cost savings on data infrastructure',
      'Real-time dashboards (previously overnight batch)'
    ],
    testimonial: 'Query.Farm transformed our analytics infrastructure. What used to take hours now happens in seconds.',
    author: 'Sarah Chen, CTO'
  },
  {
    company: 'DataStream Industries',
    industry: 'Financial Services',
    challenge: 'Needed to build a compliant, high-performance data lake for regulatory reporting.',
    solution: 'Designed and implemented DuckDB-based data lake with custom crypto extensions for data security.',
    results: [
      'Passed SOC 2 Type II audit',
      '10x faster regulatory report generation',
      'Zero data breaches in 18 months'
    ],
    testimonial: 'The team delivered beyond expectations. Our data infrastructure is now a competitive advantage.',
    author: 'Michael Rodriguez, VP of Data'
  },
  {
    company: 'Global Logistics Co.',
    industry: 'Logistics & Supply Chain',
    challenge: 'Managing real-time tracking data for 50,000+ shipments across 100+ countries.',
    solution: 'Built real-time analytics platform using DuckDB with geospatial extensions.',
    results: [
      'Sub-second query response times',
      '50% improvement in delivery predictions',
      '$2M annual cost savings'
    ],
    testimonial: 'Query.Farm gave us the infrastructure to compete with the biggest players in our industry.',
    author: 'James Park, Chief Data Officer'
  }
];

const SITE_ORIGIN = 'https://query.farm';
const consultingDescription = 'Expert DuckDB consulting for data infrastructure, custom extensions, and data-as-a-service.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Query.Farm Consulting',
    url: `${SITE_ORIGIN}/consulting`,
    description: consultingDescription,
    provider: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
    areaServed: 'Worldwide',
    serviceType: [
      'DuckDB consulting',
      'Custom DuckDB extension development',
      'Data infrastructure architecture',
      'Performance optimization',
      'Migration to DuckDB',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Consulting', item: SITE_ORIGIN + '/consulting' },
    ],
  },
];

const expertise = [
  {
    area: 'DuckDB Expertise',
    icon: '🦆',
    details: [
      'Core DuckDB contributors',
      '50+ custom extensions built',
      'Deep knowledge of query optimizer',
      'Performance tuning specialists'
    ]
  },
  {
    area: 'Data Engineering',
    icon: '⚡',
    details: [
      '20+ years combined experience',
      'Built systems at petabyte scale',
      'Real-time and batch processing',
      'ETL/ELT pipeline design'
    ]
  },
  {
    area: 'Cloud & Infrastructure',
    icon: '☁️',
    details: [
      'AWS, GCP, Azure certified',
      'Kubernetes and containerization',
      'Infrastructure as Code (Terraform)',
      'Multi-cloud and hybrid setups'
    ]
  },
  {
    area: 'Security & Compliance',
    icon: '🔒',
    details: [
      'SOC 2, HIPAA, GDPR experience',
      'Encryption and key management',
      'Audit logging and monitoring',
      'Zero-trust architecture'
    ]
  }
];
---

<PageLayout
  title="Consulting Services"
  description={consultingDescription}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <Hero
    title="Expert DuckDB Consulting"
    subtitle="Transform your data infrastructure with the team behind Query.Farm. From architecture design to managed services, we make DuckDB work for your business."
    primaryCTA={{ text: "Schedule Consultation", href: "/company/schedule" }}
    secondaryCTA={{ text: "View Case Studies", href: "#case-studies" }}
  />

  <!-- Services Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our Services"
        title="How We Can Help"
        description="Whether you need strategic guidance or hands-on implementation, we have a service model that fits."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {services.map((service) => (
          <Card padding="lg" class="hover:shadow-xl transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="flex-shrink-0 w-16 h-16 rounded-2xl bg-harvest-100 flex items-center justify-center text-4xl">
                {service.icon}
              </div>
              <div>
                <h3 class="text-2xl font-bold text-soil-900 mb-2">{service.title}</h3>
                <p class="text-soil-700 leading-relaxed">
                  {service.description}
                </p>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="text-sm font-semibold text-soil-700 mb-3">What's Included</h4>
              <ul class="space-y-2">
                {service.offerings.map((offering) => (
                  <li class="flex items-start text-sm text-soil-600">
                    <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {offering}
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-soil-200 space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Pricing</span>
                <span class="font-semibold text-harvest-700">{service.pricing}</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Engagement</span>
                <span class="font-medium text-soil-800">{service.duration}</span>
              </div>
            </div>

            <div class="mt-6">
              <Button href="/company/schedule" variant="primary" size="md" class="w-full">
                Get Started
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Methodology Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our Process"
        title="Proven Methodology"
        description="A structured approach that has delivered results for dozens of clients across industries."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {methodology.map((phase, index) => (
          <Card padding="lg" class="relative">
            <div class="absolute -top-4 -left-4 w-12 h-12 rounded-full bg-harvest-600 text-white flex items-center justify-center font-bold text-lg shadow-lg">
              {index + 1}
            </div>
            <div class="flex items-start gap-3 mb-4 mt-2">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-earth-100 flex items-center justify-center text-3xl">
                {phase.icon}
              </div>
              <div>
                <h3 class="text-xl font-bold text-soil-900 mb-2">{phase.phase}</h3>
                <p class="text-sm text-soil-700 leading-relaxed">
                  {phase.description}
                </p>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-soil-200">
              <h4 class="text-xs font-semibold text-soil-600 uppercase tracking-wide mb-2">Deliverables</h4>
              <ul class="space-y-1">
                {phase.deliverables.map((deliverable) => (
                  <li class="text-xs text-soil-600 flex items-center">
                    <span class="w-1.5 h-1.5 rounded-full bg-harvest-600 mr-2"></span>
                    {deliverable}
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertise Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Why Choose Us"
        title="Deep Expertise Across the Stack"
        description="We don't just know DuckDB—we know data infrastructure inside and out."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {expertise.map((item) => (
          <Card padding="lg" class="text-center hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
              {item.icon}
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-4">{item.area}</h3>
            <ul class="space-y-2 text-left">
              {item.details.map((detail) => (
                <li class="text-xs text-soil-700 flex items-start">
                  <svg class="w-4 h-4 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies Section -->
  <section id="case-studies" class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Proven Results"
        title="Case Studies"
        description="Real clients, real challenges, real results. See how we've transformed data infrastructure for leading companies."
        align="center"
        class="mb-12"
      />

      <div class="space-y-8 max-w-5xl mx-auto">
        {caseStudies.map((study) => (
          <Card padding="lg" class="hover:shadow-xl transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-2xl font-bold text-soil-900 mb-1">{study.company}</h3>
                <Badge variant="info" size="sm">{study.industry}</Badge>
              </div>
            </div>

            <div class="grid md:grid-cols-3 gap-6 mb-6">
              <div>
                <h4 class="text-sm font-semibold text-soil-700 mb-2">Challenge</h4>
                <p class="text-sm text-soil-600 leading-relaxed">
                  {study.challenge}
                </p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-soil-700 mb-2">Solution</h4>
                <p class="text-sm text-soil-600 leading-relaxed">
                  {study.solution}
                </p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-soil-700 mb-2">Results</h4>
                <ul class="space-y-1">
                  {study.results.map((result) => (
                    <li class="text-sm text-soil-600 flex items-start">
                      <svg class="w-4 h-4 mr-1 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                      </svg>
                      {result}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-soil-200 bg-grain-50 -mx-6 -mb-6 px-6 py-4 rounded-b-lg">
              <p class="text-soil-800 italic mb-2">"{study.testimonial}"</p>
              <p class="text-sm text-soil-600">— {study.author}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="FAQ"
        title="Common Questions"
        description="Everything you need to know about working with Query.Farm."
        align="center"
        class="mb-12"
      />

      <div class="max-w-3xl mx-auto space-y-6">
        <Card padding="lg">
          <h4 class="text-lg font-bold text-soil-900 mb-2">What size companies do you work with?</h4>
          <p class="text-soil-700 leading-relaxed">
            We work with everyone from fast-growing startups to Fortune 500 enterprises. If you're serious about data infrastructure, we can help.
          </p>
        </Card>

        <Card padding="lg">
          <h4 class="text-lg font-bold text-soil-900 mb-2">Do you work remotely or on-site?</h4>
          <p class="text-soil-700 leading-relaxed">
            We're a remote-first team and work with clients globally. For strategic engagements, we can arrange on-site visits as needed.
          </p>
        </Card>

        <Card padding="lg">
          <h4 class="text-lg font-bold text-soil-900 mb-2">How quickly can you start?</h4>
          <p class="text-soil-700 leading-relaxed">
            Most projects can begin within 1-2 weeks of contract signing. For urgent needs, we can often accommodate faster timelines.
          </p>
        </Card>

        <Card padding="lg">
          <h4 class="text-lg font-bold text-soil-900 mb-2">What if we need ongoing support after the project?</h4>
          <p class="text-soil-700 leading-relaxed">
            We offer flexible retainer agreements for ongoing support, maintenance, and advisory services. Many clients transition to our Data-as-a-Service offering.
          </p>
        </Card>

        <Card padding="lg">
          <h4 class="text-lg font-bold text-soil-900 mb-2">Can you help migrate from our current data warehouse?</h4>
          <p class="text-soil-700 leading-relaxed">
            Absolutely. We've successfully migrated clients from Snowflake, Redshift, BigQuery, and other platforms to DuckDB-based solutions with zero downtime.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Ready to Get Started?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Schedule a free 30-minute consultation to discuss your data infrastructure needs.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/schedule" variant="secondary" size="lg">
          Schedule Consultation
        </Button>
        <Button href="/company/contact" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Contact Sales
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
