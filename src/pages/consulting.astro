---
/**
 * /consulting — custom work across the platform: VGI workers, native
 * extensions, and Haybarn production hardening.
 *
 * Family D per DESIGN_BRIEF §6 — PageHead variant="section", hairband, the
 * shared shape vocabulary from products/index.astro, exactly one full-bleed
 * bg-pipe-6 slab, placed last.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHead from '../components/ui/PageHead.astro';
import Button from '../components/ui/Button.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import EngagementDiagram from '../components/consulting/EngagementDiagram.astro';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const H2 = 'mt-3 text-3xl md:text-4xl text-soil-900';

// ── Counted, not asserted ────────────────────────────────────────────────────
// Every figure on this page is computed from the same data the catalog renders
// from. Nothing here is typed in by hand — that is the entire argument of the
// page, and hardcoding one number would undermine all of them.
const extensionCount = publicExtensions.length;
const annualLoads = usageSummary?.annualizedLoads;

// Verified against github.com/duckdb/duckdb (author:rustyconover is:merged).
// Mirrors company/about.astro — bump both together.
const mergedCorePRs = 64;
const PR_SEARCH =
  'https://github.com/duckdb/duckdb/pulls?q=is%3Apr+author%3Arustyconover+is%3Amerged';

const compact = (n: number): string =>
  n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`
  : n >= 1_000 ? `${(n / 1_000).toFixed(0)}K`
  : String(n);

const stats = [
  { value: String(mergedCorePRs), label: 'merged pull requests to DuckDB core', href: PR_SEARCH, external: true },
  { value: annualLoads ? `${compact(annualLoads)}+` : '—', label: 'extension loads per year', href: '/products/extensions' },
  { value: String(extensionCount), label: 'DuckDB extensions published', href: '/products/extensions' },
  { value: 'May 2024', label: 'shipping extensions since', href: '/company/about' },
];

// The three most-loaded extensions, pulled live so the shelf can never go stale.
const shelf = [...publicExtensions]
  .filter((e) => typeof e.usageCount === 'number' && e.usageCount > 0)
  .sort((a, b) => (b.usageCount ?? 0) - (a.usageCount ?? 0))
  .slice(0, 3);
const shelfPeriod = shelf[0]?.usagePeriod ?? 'last 90 days';

// ── The review ───────────────────────────────────────────────────────────────
// Spans all three tracks below, matching how it's drawn in EngagementDiagram —
// its job is to establish which track applies, so it has to stay neutral
// between them rather than double as a qualification call for one.
const review = {
  title: 'Feasibility review',
  price: '$7,500',
  priceNote: 'fixed, credited in full against a build',
  description:
    'You know what you need to query. You do not yet know whether that is a worker built in a week, a native extension, or something nobody should build.',
  points: [
    'We check the catalog and the community repository first',
    'A written recommendation: VGI worker, native extension, or neither',
    'A proof-of-concept that returns real rows from your real source',
    'An estimate you can take to whoever holds the budget',
  ],
};

// ── The three tracks ─────────────────────────────────────────────────────────
// Ordered by how often each is the right answer, not by price. A VGI worker is
// the default for a connector now — no C++, no platform build matrix, no
// per-release rebuild treadmill — and a coding agent can write a solid first
// draft of one for a well-documented API. Native extension work is reserved
// for what a worker genuinely can't do: custom types, storage, or optimizer
// changes that have to run in-process.
const offers = [
  {
    kicker: 'Track 1 · 2–8 weeks',
    title: 'A VGI worker',
    price: '$18–54K',
    priceNote: 'less for agent-assisted builds on well-documented APIs',
    description:
      'The default path for a connector now. No C++, no build matrix, no rebuild every time DuckDB releases.',
    points: [
      'Python, Go, Rust, Java, or TypeScript — your choice',
      'A coding agent writes a first draft for the common case; we review it and finish it',
      'Auth, pushdown, and caching handled by the protocol, not hand-rolled',
      'A template your team reuses for the next one without us',
    ],
    cta: { label: 'How VGI works →', href: '/vgi' },
    edge: 'bg-pipe-3',
  },
  {
    kicker: 'Track 2 · 3–6 weeks',
    title: 'A native extension',
    price: '$27–67.5K',
    priceNote: 'quoted fixed before we start',
    description:
      'For the cases a worker cannot reach: custom types, storage, or a change to the query optimizer.',
    points: [
      'Written in C++, in-process, where that is the only option',
      'Full platform build matrix — including a WebAssembly build we run, not just compile',
      'Published to the community channel, or kept private',
      'Your repo, your licence, your CI',
    ],
    cta: { label: 'Browse published extensions →', href: '/products/extensions' },
    edge: 'bg-pipe-4',
  },
  {
    kicker: 'Track 3 · 2–3 weeks',
    title: 'Production readiness',
    price: '$22,500',
    priceNote: 'fixed price',
    description:
      'You have it working and now it has to survive a security review, an upgrade, and a person leaving.',
    points: [
      'A pinned, signed Haybarn distribution with build provenance',
      'An upgrade policy that survives the next DuckDB release',
      'A security-review packet: checksums, signatures, attestations, and what is deliberately not in the catalog',
      'Runbooks that outlive the engagement',
    ],
    cta: { label: 'What Haybarn guarantees →', href: '/haybarn/security' },
    edge: 'bg-pipe-5',
  },
];

// ── Public work, used as the case studies ────────────────────────────────────
// No client logos required, and stronger than a logo wall: a reader can verify
// every one of these in under a minute.
const evidence = [
  {
    title: 'We rebuilt the community extension catalogue and made it 2.4× faster',
    body:
      'Every DuckDB release invalidates every community extension binary until it is rebuilt, which is why upgrades break INSTALL. We measured the whole pipeline and rebuilt it around a read-write vcpkg cache: 104 CI-hours against a modelled 245, on identical runners.',
    figure: '2.4×',
    figureLabel: 'faster full-catalogue rebuild',
    href: '/blog/duckdb-community-extensions-distribution',
    cta: 'Read the analysis',
  },
  {
    title: 'We tested every WebAssembly extension and found a third of them broken',
    body:
      'A WASM extension that compiles has proven it compiles — not that it loads, and not that it runs. We built a harness and ran all 124 WASM-enabled community extensions against the published engine. The failures had green badges the whole time.',
    figure: '43 / 124',
    figureLabel: 'failing at runtime, CI green',
    href: '/blog/testing-duckdb-wasm-extensions',
    cta: 'Read the teardown',
  },
];

// ── How it runs ──────────────────────────────────────────────────────────────
// Replaces the five-phase Discovery→Enablement wireframe. Four steps, stated in
// weeks, describing what actually happens rather than a discipline.
const steps = [
  { n: 'Week 0', title: 'We check the catalog', body: 'If an existing extension already reads your source, we tell you and the engagement stops there.' },
  { n: 'Week 1', title: 'A failing test', body: 'The first commit is a test against your real source, so you can confirm we understood the problem before we build on it.' },
  { n: 'Weeks 2–5', title: 'Build, in your repository', body: 'You review pull requests as they land. We do not run a separate status meeting unless you want one.' },
  { n: 'Final week', title: 'Handover', body: 'Your engineers make the last commits and run the build themselves, so the work does not depend on us afterwards.' },
];

const faq = [
  {
    q: 'What if an extension already exists for our source?',
    a: `Then we'll say so on the call and you'll have saved yourself an engagement. It happens more often than you'd think — there are ${extensionCount} in our catalog and several hundred more in DuckDB's community repository.`,
  },
  {
    q: 'Do we have to replace our warehouse?',
    a: "No, and we'd usually rather you didn't. Most of what we build sits beside what you already have: DuckDB reads the Parquet your warehouse already writes, or a worker fronts a system the warehouse was never going to reach. “Rip out Snowflake” is not a project we're interested in selling you.",
  },
  {
    q: 'Who owns the code?',
    a: "You do. The repo is yours, the licence is your choice, and the build runs without us. If it's genuinely reusable we may ask whether you'd like it published as a community extension — which means we keep it building on every DuckDB release, for free. That's an offer, not a condition.",
  },
  {
    q: 'What happens when a new DuckDB version breaks our extension?',
    a: 'This is the real question and most people ask it too late. Every community extension is a separate binary that has to be rebuilt for each engine release, so shipping is not the end of the work. Fixed-price builds include rebuilds for six months; after that it is a support retainer, or we hand you the CI that does it and you take it in-house.',
  },
  {
    q: 'How do you price?',
    a: "Fixed, wherever the scope is knowable — which covers most worker and extension builds. Anything open-ended — advisory, pairing, code review — is $4,500 a day. We don't run time-and-materials on a build we scoped ourselves; if we estimated it wrong, that's our problem.",
  },
  {
    q: 'Are you going to have an AI write our extension?',
    a: "Where it helps, yes. Coding agents can write a solid first draft of a VGI worker, and increasingly a DuckDB extension, for the common case. We use them, review everything they produce line by line, and take over by hand for the parts that still need a person — a novel type system, storage internals, or anything where a subtle mistake is expensive. You're paying for that judgment, not pretending the agent isn't there.",
  },
  {
    q: 'What do you not take on?',
    a: 'Warehouse migrations, platform strategy engagements, staff augmentation, and anything that needs a 24/7 on-call rota. We will tell you on the first call rather than the fourth.',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const description =
  'Custom work across the Query.Farm platform: VGI workers, native DuckDB extensions, and hardened Haybarn distributions. Fixed-price engagements and numbers you can check.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Query.Farm',
    url: `${SITE_ORIGIN}/consulting`,
    description,
    provider: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    areaServed: 'Worldwide',
    serviceType: [
      'DuckDB consulting',
      'VGI worker development',
      'Custom DuckDB extension development',
      'DuckDB production hardening',
      'DuckDB extension maintenance and support',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Consulting', item: SITE_ORIGIN + '/consulting' },
    ],
  },
];
---

<PageLayout title="Custom DuckDB work" description={description} jsonLd={jsonLd}>
  <PageHead
    variant="section"
    eyebrow="Custom work"
    title="Custom work across the DuckDB platform we build."
    lede="Extensions, VGI workers, and hardened Haybarn distributions — the same things this site documents, built against your systems instead of the public catalog. We'll tell you which one you need, including when that's a worker built in a week rather than a native extension."
    ledeClass={`mt-3.5 max-w-[64ch] ${LEDE}`}
    hairband
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/company/schedule" variant="primary" size="md">Book 30 minutes</Button>
    </div>
  </PageHead>

  <!-- ── Receipts, before any claim ───────────────────────────── -->
  <section class="py-14 lg:py-16">
    <div class={WRAP}>
      <span class={EYEBROW}>Track record</span>
      <h2 class={H2}>What we have shipped so far</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        These figures come from the same data the extension catalog is built from, and they update
        when it does. Each one links to its source so you can check it.
      </p>

      <div class="mt-8 grid gap-x-6 gap-y-8 border-t border-soil-300 pt-8 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            class="group block no-underline"
          >
            <div class="qf-figure text-[clamp(2rem,4vw,2.6rem)] leading-none text-soil-900 transition-colors group-hover:text-link">
              {s.value}
            </div>
            <div class="mt-2.5 text-[13px] leading-snug text-soil-600">{s.label}</div>
          </a>
        ))}
      </div>

      {shelf.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2.5 border-t border-soil-200 pt-6">
          <span class="text-[12.5px] font-medium text-soil-500">
            Software you may already be running —
          </span>
          {shelf.map((ext) => (
            <a
              href={`/products/extensions/${ext.id}`}
              class="inline-flex items-baseline gap-1.5 rounded-full border border-soil-300 bg-[#fffdf7] px-3 py-1 text-[13px] text-soil-700 no-underline transition-colors hover:border-sun-400 hover:text-soil-900"
            >
              {ext.name}
              <span class="qf-figure text-soil-500">{compact(ext.usageCount ?? 0)}</span>
            </a>
          ))}
          <span class="text-[12.5px] text-soil-500">loads, {shelfPeriod}</span>
        </div>
      )}
    </div>
  </section>

  <!-- ── Where the work attaches ──────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Where we work</span>
      <h2 class={H2}>Which layer your problem is in</h2>
      <p class={`mt-3 max-w-[68ch] ${LEDE}`}>
        A DuckDB problem usually sits at one of four layers, and which layer it is decides what
        gets built, how long it takes, and what it costs. The left column is the platform as it
        already exists — extensions, Haybarn, VGI, and Rowfence all have their own pages if you
        want the detail. The right column is the work we do there.
      </p>

      <div class="mt-8">
        <EngagementDiagram />
      </div>

      <p class="mt-5 max-w-[68ch] text-sm leading-relaxed text-soil-600">
        Teams often arrive certain they need the extension row and leave having bought the engine
        row, or the other way round. That is what the review at the top is for.
      </p>
    </div>
  </section>

  <!-- ── The offers ───────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]" id="offers">
    <div class={WRAP}>
      <span class={EYEBROW}>What we build</span>
      <h2 class={H2}>Three tracks, and a review that sorts you into one</h2>
      <p class={`mt-3 max-w-[68ch] ${LEDE}`}>
        Most connectors are built as VGI workers now, not native extensions — no C++, no platform
        build matrix, no rebuild every time DuckDB releases. We reserve native extension work for
        what a worker genuinely can't reach: custom types, storage, or optimizer changes. Coding
        agents can write a solid first draft of either kind for the common case; we review what
        they produce and do the parts that still need a person.
      </p>

      <!-- The review, spanning the tracks below it — mirrors EngagementDiagram -->
      <div class={`${CARD} mt-8 flex flex-col gap-5 border-2 border-dashed border-sun-700 bg-sun-400/5 p-6 lg:flex-row lg:items-start lg:justify-between`}>
        <div class="flex-1">
          <div class="qf-figure text-[12.5px] text-sun-700">Start here · any track</div>
          <h3 class="mt-1.5 text-xl text-soil-900">{review.title}</h3>
          <p class="mt-2.5 max-w-[54ch] text-sm leading-relaxed text-soil-700">{review.description}</p>
          <ul class="mt-4 flex flex-col gap-1.5">
            {review.points.map((point) => (
              <li class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-soil-700">
                <span class="mt-[3px] flex-none text-field-700" aria-hidden="true">✓</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex-none text-left lg:text-right">
          <div class="qf-figure text-[28px] leading-none text-sun-700">{review.price}</div>
          <div class="mt-1 text-[12.5px] text-soil-500">{review.priceNote}</div>
        </div>
      </div>

      <div class="mt-6 grid gap-3.5 lg:grid-cols-3">
        {offers.map((offer) => (
          <div class={`${CARD} relative flex flex-col overflow-hidden p-6 pl-7`}>
            <span class={`absolute inset-y-0 left-0 w-1 ${offer.edge}`} aria-hidden="true"></span>
            <div class="qf-figure text-[12.5px] text-soil-500">{offer.kicker}</div>

            <h3 class="mt-1.5 text-xl text-soil-900">{offer.title}</h3>
            <div class="mt-1 flex items-baseline gap-2">
              <span class="qf-figure text-[17px] text-sun-700">{offer.price}</span>
            </div>
            <div class="text-[12.5px] text-soil-500">{offer.priceNote}</div>

            <p class="mt-3 text-sm leading-relaxed text-soil-700">{offer.description}</p>

            <ul class="mt-4 flex flex-1 flex-col gap-2 border-t border-soil-200 pt-3.5">
              {offer.points.map((point) => (
                <li class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-soil-700">
                  <span class="mt-[3px] flex-none text-field-700" aria-hidden="true">✓</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>

            <a href={offer.cta.href} class="mt-4 text-sm text-link no-underline hover:underline">
              {offer.cta.label}
            </a>
          </div>
        ))}
      </div>

      <p class="mt-6 max-w-[72ch] text-sm leading-relaxed text-soil-600">
        Anything that isn't one of these three — code review, pairing with your team on an
        agent-assisted build, or open-ended advisory — is billed at <span class="qf-figure">$4,500</span>/day.
        Standing relationships become a monthly retainer at the same rate, scoped to a fixed number
        of days.
      </p>
    </div>
  </section>

  <!-- ── The deliverable, made literal ────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <span class={EYEBROW}>What you get</span>
          <h2 class={H2}>The deliverable is working software</h2>
          <p class={`mt-3.5 max-w-[52ch] ${LEDE}`}>
            What you receive at the end is the same kind of artifact already in our catalog — the
            same repository layout, the same signing, the same generated documentation, and the
            same community channel if you want it published there.
          </p>
          <p class="mt-3.5 max-w-[52ch] leading-relaxed text-soil-700">
            You own the repository and choose the licence. Your CI builds it. It continues to work
            whether or not you keep working with us.
          </p>
        </div>
        <CodeBlock
          title="the last two lines of the engagement"
          lang="sql"
          tryable={false}
          code={`INSTALL your_thing FROM community;
LOAD your_thing;

-- or, if it's a worker:
ATTACH 'yoursystem://prod' AS yoursystem (TYPE vgi);`}
        />
      </div>
    </div>
  </section>

  <!-- ── Evidence ─────────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Published work</span>
      <h2 class={H2}>Two examples in the open</h2>
      <p class={`mt-3 max-w-[66ch] ${LEDE}`}>
        Client work is mostly under NDA, so here are two pieces of infrastructure work we did on
        the DuckDB ecosystem itself. Both write-ups include the methodology and the raw numbers.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-2">
        {evidence.map((item) => (
          <div class={`${CARD} flex flex-col p-7`}>
            <div class="qf-figure text-[34px] leading-none text-sun-700">{item.figure}</div>
            <div class="mt-2 text-[12.5px] font-medium text-soil-500">{item.figureLabel}</div>
            <h3 class="mt-5 text-xl text-soil-900">{item.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-soil-700">{item.body}</p>
            <a href={item.href} class="mt-5 text-sm text-link no-underline hover:underline">
              {item.cta} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── How it runs ──────────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>How an engagement runs</span>
      <h2 class={H2}>What the weeks look like</h2>

      <div class="mt-8 grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <div class="border-t border-soil-300 pt-5">
            <div class="qf-figure text-[12.5px] text-sun-700">{step.n}</div>
            <h3 class="mt-1.5 text-lg text-soil-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What we build with ───────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>What we build with</span>
      <h2 class={H2}>The tools underneath the work</h2>
      <p class={`mt-3 max-w-[66ch] ${LEDE}`}>
        Most client work is built on one of these three, configured for a specific system. All
        three are open source and documented, and they are used by plenty of people who have never
        contacted us.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {[
          { name: 'VGI', href: '/vgi', img: '/vgi/vgi-logo.png', blurb: 'The protocol behind worker builds — Arrow over pipes, sockets, or HTTP, in five languages. Most connector work happens here now.' },
          { name: 'Extensions', href: '/products/extensions', img: '/images/duckdb-icon.svg', blurb: `${extensionCount} published extensions. When a build genuinely needs C++, this is the shape it takes.` },
          { name: 'Haybarn', href: '/haybarn', img: '/haybarn/haybarn-mark.svg', blurb: 'Signed builds and provenance. The production-readiness track is Haybarn, configured for your constraints.' },
        ].map((p) => (
          <a href={p.href} class={`${CARD} group block p-6 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400 motion-reduce:transition-none motion-reduce:hover:translate-y-0`}>
            <span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-[10px] border border-soil-300 bg-soil-100">
              <img src={p.img} alt="" width="24" height="24" class="h-6 w-6 object-contain" />
            </span>
            <h3 class="mt-4 text-lg text-soil-900 transition-colors group-hover:text-link">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{p.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────── -->
  <section class="border-t border-soil-300 py-16 lg:py-[70px]">
    <div class="mx-auto max-w-[820px] px-6">
      <span class={EYEBROW}>Before you write in</span>
      <h2 class="mt-3 mb-6 text-3xl md:text-4xl text-soil-900">Questions we actually get</h2>

      <div class="border-t border-soil-300">
        {faq.map((item, index) => (
          <details class="border-b border-soil-300" open={index === 0}>
            <summary class="qf-faq-summary flex cursor-pointer items-center justify-between gap-4 py-4.5 text-[19px] tracking-[-0.018em]">
              {item.q}
            </summary>
            <p class="max-w-[64ch] pb-5 text-soil-700">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The one dark slab, full-bleed and terminal ───────────── -->
  <section class="bg-pipe-6 py-16 text-cream lg:py-[70px]">
    <div class={WRAP}>
