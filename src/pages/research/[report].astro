---
// Preserve local preview links while the article follows the blog's draft gate.
export function getStaticPaths() {
  return import.meta.env.DEV || process.env.INCLUDE_DRAFTS === 'true'
    ? [{ params: { report: 'duckdb-2-release-activity' } }] : [];
}
return Astro.redirect('/blog/duckdb-2-release-activity/', 301);
---
