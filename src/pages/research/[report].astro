---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import ReportFigure from '../../components/research/ReportFigure.astro';
import RepositoryActivity from '../../components/research/RepositoryActivity.astro';
import report from '../../data/research/duckdb-2-release-activity.json';

export function getStaticPaths() {
  return import.meta.env.DEV || process.env.INCLUDE_DRAFTS === 'true'
    ? [{ params: { report: 'duckdb-2-release-activity' } }] : [];
}
const assets = '/research/duckdb-2-release-activity';
const date = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const through = date(report.through);
const ratio = (id: keyof typeof report.windows, version = '2.0.0', window: 'post' | 'runup' = 'post', digits = 1, baseline: 'prerun' | 'recent' = 'prerun') => {
  const values = report.windows[id][baseline] as Record<string, { post: number; runup: number }>;
  return `${values[version][window].toFixed(digits)}×`;
};
const groups = report.packageGroups;
const core = report.packages.find(p => p.repo === 'duckdb')!;
const outside = report.counts.issuesOpened - core.counts['2.0.0'].actual;
const newsletter = '/company/newsletter?source=duckdb-2-release-activity';
const schedule = '/company/schedule?source=duckdb-2-release-activity';
const title = 'Upgrading to DuckDB 2.0 — a preliminary report';
const description = `Should you upgrade to DuckDB 2.0? Migration guidance and issue activity across the engine, clients and extensions, compared with 1.4 and 1.5. Data through ${through}.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  author: { '@type': 'Organization', name: 'Query.Farm', url: 'https://query.farm/' },
  publisher: { '@type': 'Organization', name: 'Query.Farm', url: 'https://query.farm/' },
  dateModified: report.collectedAt, image: `https://query.farm${assets}/social.png`,
  about: { '@type': 'SoftwareApplication', name: 'DuckDB', url: 'https://duckdb.org/' },
};
---
<BaseLayout title={title} description={description} ogType="article" ogImage={`${assets}/social.png`}
  ogImageAlt="DuckDB 2.0 upgrade report. Issue activity across the engine, clients and extensions, compared with 1.4 and 1.5. Query.Farm preliminary research."
  jsonLd={jsonLd} articleModifiedTime={report.collectedAt} articleAuthor="Query.Farm" articleSection="Research" noindex>
  <article id="release-report" data-report-id={report.slug}>
    <div class="report-wrap">
      <header class="report-header">
        <div class="report-masthead"><span>Query.Farm research</span><span>Preliminary report · October 2026</span></div>
        <h1>Upgrading to DuckDB <span class="qf-figure">2.0</span></h1>
        <p class="report-deck">What the release activity tells us about the engine, clients and extensions—and what to check in your own workload.</p>
        <p class="byline">By Query.Farm · Data through <time datetime={report.through}>{through} UTC</time> · {report.repositoryCount} repositories</p>
        <nav class="report-contents" aria-label="In this report"><a href="#upgrade">The upgrade decision</a><a href="#activity">Release activity</a><a href="#packages">Packages & integrations</a><a href="#contributors">Contributors</a><a href="#method">Method & data</a></nav>
      </header>

      <section id="upgrade" class="opening" aria-labelledby="upgrade-heading">
        <div>
          <h2 id="upgrade-heading">Should you upgrade to <span class="qf-figure">2.0</span> yet?</h2>
          <p class="opening-answer">Start with your workload on a shadow system. For a mission-critical deployment, consider waiting for a patch release.</p>
          <p>That is the <a href="https://duckdb.org/2026/10/21/announcing-duckdb-200">DuckDB team’s migration advice</a>, and a sensible starting point. The issue trackers help identify where to look next; they do not establish whether a particular workload is ready to move.</p>
          <p>This report follows the release response across the wider DuckDB ecosystem. Of {report.counts.issuesOpened} issues opened in the observed period, <strong>{outside} were outside the core engine repository</strong>. The client and extensions you use deserve their own review.</p>
        </div>
        <aside class="release-dates" aria-label="Release planning dates">
          <p class="small-label">Dates for your plan</p>
          <dl><dt>2.0.1 patch</dt><dd class="qf-figure">18 November 2026 <small>Planned</small></dd><dt>1.5 support</dt><dd>Through March 2027</dd><dt>1.4 support ends</dt><dd class="qf-figure">17 November 2026</dd></dl>
          <a href="https://duckdb.org/release_calendar">DuckDB release calendar ↗</a>
          <p class="fine-print">Schedule checked 27 October 2026. Planned dates may change.</p>
        </aside>
      </section>

      <section id="activity" class="report-section" aria-labelledby="activity-heading">
        <p class="section-number">01 / The release response</p>
        <h2 id="activity-heading">More activity, across a larger ecosystem.</h2>
        <p class="section-intro">Issue intake reached <strong>{ratio('issues_opened')} its expected level</strong> after <span class="qf-figure">2.0</span>, compared with {ratio('issues_opened', '1.4.0')} after <span class="qf-figure">1.4</span> and {ratio('issues_opened', '1.5.0')} after <span class="qf-figure">1.5</span>. Each comparison uses that release’s own weekday-matched baseline and the same {report.postDays}-day window, including release day.</p>
        <ReportFigure metric="calendar" file="issue-calendar" number="1" title="Issue intake across all user-facing repositories" calendar
          alt="Calendar of issue intake from June 2025 through October 2026. A trailing seven-day mean shows a rise around DuckDB 2.0; release dates, patches and the alpha announcement are marked.">
          Daily underlying counts, shown as a trailing seven-day daily mean. Major releases, patch releases and the 2.0 alpha / feature freeze are marked on the calendar. <a href={`${assets}/issue-calendar.csv`} download>Download daily counts ↓</a>
        </ReportFigure>
        <div class="reading-note"><strong>Read growth against its baseline.</strong> DuckDB’s ecosystem was larger by October 2026. A raw count comparison would mix that growth with the release response. Below, <span class="qf-figure">1×</span> means the activity expected for the same weekdays in weeks −12 to −9 before each release.</div>
        <h3 class="subsection-heading">How does the response compare?</h3>
        <p class="section-intro">Against its own baseline, <span class="qf-figure">2.0</span>’s issue response is much closer to <span class="qf-figure">1.5</span> than the raw calendar suggests. Aligning the release dates lets us compare the shape of the response as well as its size.</p>
        <div class="finding-with-chart benchmark-comparison">
          <div class="benchmark-summary">
            <p class="small-label">Matched release windows</p>
            <p class="figure-note">Release day + {report.postDays-1} days<br />Issues opened / expected</p>
            {report.releases.map(release => <div class="benchmark-result">
              <span class="qf-figure" style={`color:${release.color}`}>{release.label}</span>
              <strong class="qf-figure" style={`color:${release.color}`}>{ratio('issues_opened', release.version)}</strong>
            </div>)}
            <p class="figure-note">Each release has its own weekday-matched baseline. These window totals include only post-release days.</p>
          </div>
          <ReportFigure metric="issues_opened" file="issue-benchmarks" number="2" title="Issue activity, benchmarked against earlier releases"
            alt="Issue activity relative to each release’s own baseline, aligned on release day for DuckDB 1.4, 1.5 and 2.0. Matched post-release totals are 1.6, 2.6 and 2.9 times expected activity.">
            Trailing seven-day actual / expected activity. A value of 1× is the weekday-matched expectation. The shaded interval marks the matched observation window; before day 6 the curve includes pre-release days. Later days for 2.0 remain unavailable.
          </ReportFigure>
        </div>
      </section>

      <section id="packages" class="report-section" aria-labelledby="packages-heading">
        <p class="section-number">02 / Where the issues are filed</p>
        <h2 id="packages-heading">Nearly half the intake is outside the engine.</h2>
        <div class="split-reading">
          <p>The core repository accounts for <strong>{core.counts['2.0.0'].actual} of {report.counts.issuesOpened} issues</strong> ({Math.round(core.counts['2.0.0'].actual/report.counts.issuesOpened*100)}%). Its increase is <strong>{core.counts['2.0.0'].ratio?.toFixed(1)}×</strong> baseline, below the <strong>{core.counts['1.5.0'].ratio?.toFixed(1)}×</strong> response around <span class="qf-figure">1.5</span>. The larger ecosystem response does not appear equally in every package.</p>
          <p>Repository location is a starting point for investigation. These are issues filed after each release, across all versions and issue types. We have not classified them as <span class="qf-figure">2.0</span> regressions or assigned severity.</p>
        </div>
        <figure class="distribution">
          <figcaption><span class="figure-number">Fig. 3</span><strong>Where the {report.counts.issuesOpened} issues landed</strong><span class="figure-subtitle">{date(report.releases[2].date)}–{through} · includes release day</span></figcaption>
          <div class="distribution-rows">{groups.map(group => <div class="distribution-row">
            <span>{group.label}</span><div class="distribution-track"><span style={`width:${group.counts['2.0.0'].actual/core.counts['2.0.0'].actual*100}%`}></span></div>
            <strong class="qf-figure">{group.counts['2.0.0'].actual}</strong><span class="distribution-share qf-figure">{(group.counts['2.0.0'].actual/report.counts.issuesOpened*100).toFixed(0)}%</span>
          </div>)}</div>
          <p class="figure-note">Documentation and ecosystem projects are shown separately from the engine, language clients and extensions. Repository groups are recorded in the downloadable scope.</p>
        </figure>

        <h3 class="subsection-heading">Repositories with activity above expected levels</h3>
        <p class="section-intro">Start with the repositories that matter to your stack. These received more issues than their own weekday-matched baseline predicted after <span class="qf-figure">2.0</span>. Each link opens the issues filed in the observed window.</p>
        <RepositoryActivity />
        <p class="figure-note">Links cover 21–26 October 2026 UTC, including release day. Repository boundaries and filing habits can change between releases. <a href={`${assets}/package-comparison.csv`} download>Download counts, baselines and comparisons with 1.4 and 1.5 ↓</a></p>
      </section>

      <section id="reporters" class="report-section" aria-labelledby="reporters-heading">
        <p class="section-number">03 / Who is reporting</p>
        <h2 id="reporters-heading">A broader group is filing issues.</h2>
        <div class="finding-with-chart">
          <div class="finding-text"><p class="finding-value qf-figure">{ratio('issue_new_filers')}</p><p class="finding-label">the expected rate of first-time issue reporters</p><p>For <span class="qf-figure">1.4</span> and <span class="qf-figure">1.5</span>, the matched response was {ratio('issue_new_filers', '1.4.0')} and {ratio('issue_new_filers', '1.5.0')}. “First-time” means first observed in the available history.</p><p>Daily reporter participation rose {ratio('issue_unique_filers')}, while issues per reporter were {ratio('issues_per_filer')} baseline. The increase involves more people, rather than more issues per reporter.</p></div>
          <ReportFigure metric="issue_new_filers" file="first-time-reporters" number="4" title="First-time issue reporters, relative to baseline"
            alt="First-time issue reporter activity around releases 1.4, 1.5 and 2.0. The 2.0 curve rises more sharply around release.">
            Trailing seven-day actual / expected activity. The shaded interval marks the matched post-release window; before day 6 the trend includes pre-release days. Lines stop at observed data. People are counted distinctly per day, not across an entire week.
          </ReportFigure>
        </div>
      </section>

      <section id="contributors" class="report-section" aria-labelledby="contributors-heading">
        <p class="section-number">04 / Contributor activity</p>
        <h2 id="contributors-heading">The busy run-up continued into release.</h2>
        <p class="section-intro">PR openings, net of known supersession, moved from {ratio('prs_opened_net', '2.0.0', 'runup')} baseline in the four weeks before release to {ratio('prs_opened_net')} afterward. Daily participation by people with a merged PR stayed close: {ratio('merged_pr_authors', '2.0.0', 'runup', 2)} before and {ratio('merged_pr_authors', '2.0.0', 'post', 2)} after.</p>
        <div class="paired-figures">
          <ReportFigure metric="prs_opened_net" file="pr-openings" number="5" title="PR openings, net of supersession"
            alt="Trailing seven-day PR opening activity relative to baseline for DuckDB 1.4, 1.5 and 2.0; the 2.0 run-up is elevated.">
            PRs opened by people, excluding known superseded or landed-elsewhere PRs. Supersession is classified only for the core repository.
          </ReportFigure>
          <ReportFigure metric="merged_pr_authors" file="merge-participation" number="6" title="People with a merged PR"
            alt="Daily merge participation, smoothed over seven days and compared with each release's own baseline.">
            Daily distinct PR authors, shown as a trailing seven-day ratio. PR bundles make merged-PR counts a poor comparison; this measures participation, not authorship of every change in a bundle.
          </ReportFigure>
        </div>
        <p class="reading-note"><strong>Issue closures tell a separate story.</strong> {report.counts.issuesClosed} issues closed during the <span class="qf-figure">2.0</span> window; {report.counts.olderIssuesClosed} had been filed before release. Closures moved from {ratio('issues_closed_latest', '2.0.0', 'runup')} to {ratio('issues_closed_latest')} baseline. They are not confirmed fixes or a resolution rate for the {report.counts.issuesOpened} new issues.</p>
      </section>

      <section id="migration" class="report-section" aria-labelledby="migration-heading">
        <p class="section-number">05 / Applying this to an upgrade</p>
        <h2 id="migration-heading">Test the parts your application depends on.</h2>
        <p class="section-intro">Use the repository links to choose which issue trackers to read. Then run representative queries and integrations against <span class="qf-figure">2.0</span>, comparing results and timings with your current deployment. The migration guide identifies several concrete compatibility checks:</p>
        <div class="migration-list">
          <div><h3>Database files & rollback</h3><p>New files use the <span class="qf-figure">2.0</span> storage format by default; older DuckDB versions cannot read them. Existing files retain their earlier format when written by <span class="qf-figure">2.0</span>. Check every process that shares a database file. <a href="https://duckdb.org/docs/2.0/operations_manual/migration#storage-format">Storage migration ↗</a></p></div>
          <div><h3>SQL behavior</h3><p>The old single-arrow lambda syntax is disabled by default. The new parser also changes some expression behavior, including regular-expression matching. Compare query results as well as execution success. <a href="https://duckdb.org/docs/2.0/operations_manual/migration#lambda-syntax">SQL changes ↗</a></p></div>
          <div><h3>Clients & extensions</h3><p>Review the migration notes for your client and verify the extension builds your application loads. The Python client, for example, now requires Python <span class="qf-figure">3.11</span> or newer and has API changes. <a href="https://duckdb.org/docs/2.0/operations_manual/migration#client-apis">Client migration ↗</a></p></div>
        </div>
      </section>

      <section id="your-project" class="project-discussion" aria-labelledby="project-heading" data-cta-placement="project">
        <div><p class="section-number">Working with Query.Farm</p><h2 id="project-heading">Need help with your DuckDB project?</h2><p>We help teams integrate DuckDB, build extensions and applications, and work through production upgrades. Bring us the business problem, the systems you need to connect, or the project you are planning.</p></div>
        <div class="project-actions"><Button href={schedule} size="lg">Discuss your DuckDB project <span aria-hidden="true">↗</span></Button><a href="mailto:hello@query.farm?subject=DuckDB%202.0%20project">Email a project brief</a><p>A 30-minute conversation.</p></div>
      </section>

      <section id="method" class="report-section methods" aria-labelledby="method-heading">
        <p class="section-number">Method & sources</p>
        <h2 id="method-heading">How to read this report.</h2>
        <div class="method-columns">
          <div><p><strong>Scope and time.</strong> {report.repositoryCount} user-facing repositories in the DuckDB GitHub organization: engine, clients, extensions, ecosystem and docs. The fuzzer, registries and CI tooling are excluded. Data ends {through} UTC. The same release-day-through-day-{report.postDays-1} window is used for all three releases. GitHub links show live issue pages; downloads preserve this snapshot.</p><p><strong>Expectations.</strong> Each release has a baseline covering days −84 to −57 (weeks −12 to −9). Expected activity for a day is the mean for that weekday in the baseline. Window and trend ratios divide summed actual by summed expected activity. The calendar uses trailing seven-day daily means; relative curves use the ratio of those means. No weekly bins replace the daily observations.</p><p><strong>Baseline sensitivity.</strong> Using the final four pre-release weeks instead, <span class="qf-figure">2.0</span> issue intake is {ratio('issues_opened', '2.0.0', 'post', 1, 'recent')} expected and first-time reporters {ratio('issue_new_filers', '2.0.0', 'post', 1, 'recent')}. The main baseline ends before the alpha announcement; <span class="qf-figure">1.5</span>’s baseline includes year-end holidays, which lowers its expectation.</p></div>
          <div><p><strong>Package comparisons.</strong> Counts follow the repository where an issue was filed, not a confirmed affected component or version. Zero weekday-matched expectations have no finite multiple. A repository ratio is withheld when the saved history does not establish activity before its baseline began. Repository moves and changing filing habits can affect these comparisons.</p><p><strong>People and outcomes.</strong> Bots and unavailable identities are excluded from people counts. “First-time” is first observed in available histories; the core history has {report.historyGap} unresolved records. Supersession is classified for the core only. Latest closure timestamps do not reconstruct reopen cycles. Activity does not measure severity, effort, adoption or release quality.</p><p><strong>Sources.</strong> Saved GitHub issue and PR records supply the analysis. Upgrade guidance and support dates come from DuckDB’s <a href="https://duckdb.org/2026/10/21/announcing-duckdb-200">release announcement</a>, <a href="https://duckdb.org/docs/2.0/operations_manual/migration">migration guide</a> and <a href="https://duckdb.org/release_calendar">release calendar</a>, reviewed 27 October 2026.</p></div>
        </div>
        <div class="data-links"><a href={`${assets}/aligned-daily.csv`} download>Daily counts & both baselines ↓</a><a href={`${assets}/package-comparison.csv`} download>All package comparisons ↓</a><a href={`${assets}/repositories.json`}>Repository scope ↗</a></div>
      </section>

      <section id="newsletter" class="report-newsletter" aria-labelledby="newsletter-heading">
        <div><h2 id="newsletter-heading">Follow the research.</h2><p>Get Query.Farm’s occasional notes on DuckDB, new extensions and the systems we build.</p><a href={newsletter}>About the newsletter & subscribe →</a></div>
        <NewsletterForm id="report-newsletter-email" placement="release_report" source="duckdb-2-release-activity" />
      </section>
    </div>
  </article>
  <script id="release-report-data" type="application/json" set:html={JSON.stringify(report).replace(/</g, '\\u003c')} />
</BaseLayout>
<script>import '../../scripts/duckdb-release-report';</script>
<style is:global>
  #release-report { color: #211a12; }
  #release-report .report-wrap { max-width: 1176px; margin: 0 auto; padding: 0 32px; }
  #release-report :is(h1,h2,h3) { text-wrap: balance; }
  #release-report h2 { font-size: clamp(27px,3.1vw,38px); line-height: 1.16; letter-spacing: -.018em; }
  #release-report p { line-height: 1.7; }
  #release-report section { scroll-margin-top: 100px; }
  #release-report .report-header { padding-top: 42px; }
  #release-report .report-masthead { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid #211a12; font-size: 12px; letter-spacing: .045em; }
  #release-report h1 { margin: 32px 0 17px; font-size: clamp(36px,5vw,60px); line-height: 1.1; letter-spacing: -.035em; }
  #release-report .report-deck { max-width: 820px; font-size: 21px; line-height: 1.5; color: #5d4632; }
  #release-report .byline { margin-top: 22px; font-size: 12px; color: #5d4632; }
  #release-report .report-contents { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 27px; padding: 16px 0; border-block: 1px solid #cfc4ad; font-size: 12px; }
  #release-report .opening { display: grid; grid-template-columns: minmax(0,1fr) 250px; gap: 70px; padding: 42px 0 0; }
  #release-report .opening h2 { font-size: 28px; }
  #release-report .opening p { margin-top: 15px; font-size: 15px; color: #5d4632; }
  #release-report .opening .opening-answer { font-size: 21px; line-height: 1.55; color: #211a12; }
  #release-report .release-dates { border-left: 1px solid #cfc4ad; padding-left: 24px; }
  #release-report .release-dates .small-label { margin: 0 0 18px; font-size: 12px; color: #211a12; font-weight: 600; }
  #release-report dt { font-size: 12px; color: #5d4632; margin-top: 15px; }
  #release-report dd { font-size: 15px; margin: 4px 0 0; }
  #release-report dd small { display: block; font-size: 11px; color: #5d4632; }
  #release-report .release-dates a { display: inline-block; font-size: 12px; margin-top: 20px; }
  #release-report .release-dates .fine-print { font-size: 11px; line-height: 1.6; }
  #release-report .report-section { margin-top: 56px; padding-top: 28px; border-top: 1px solid #cfc4ad; }
  #release-report .section-number { font-size: 11px; color: #7d5714; letter-spacing: .07em; text-transform: uppercase; margin: 0 0 15px; font-weight: 500; }
  #release-report .section-intro { max-width: 830px; margin: 19px 0 28px; font-size: 16px; color: #5d4632; }
  #release-report .report-figure { min-width: 0; margin: 24px 0 0; }
  #release-report figcaption { font-family: var(--font-sans); font-size: 14px; line-height: 1.5; padding: 15px 0; border-top: 1px solid #cfc4ad; }
  #release-report figcaption strong { font-weight: 500; }
  #release-report .figure-number { font-size: 11px; color: #7d5714; margin-right: 14px; }
  #release-report .figure-subtitle { display: block; margin-top: 4px; font-size: 12px; color: #5d4632; }
  #release-report .report-fallback { display: block; width: 100%; height: auto; }
  #release-report .report-plot { height: 360px; width: 100%; }
  #release-report .calendar-figure .report-plot { height: 450px; }
  #release-report .figure-note { margin-top: 10px; font-size: 11px; line-height: 1.7; color: #5d4632; }
  #release-report .reading-note { margin-top: 24px; border-left: 2px solid #a9762e; padding: 0 0 0 20px; max-width: 920px; font-size: 14px; line-height: 1.75; color: #5d4632; }
  #release-report .reading-note strong { color: #211a12; font-weight: 600; }
  #release-report .split-reading { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin: 22px 0 30px; font-size: 15px; color: #5d4632; }
  #release-report .distribution { margin: 28px 0 46px; }
  #release-report .distribution-rows { max-width: 940px; padding: 8px 0; }
  #release-report .distribution-row { display: grid; grid-template-columns: 230px minmax(0,1fr) 42px 44px; gap: 14px; align-items: center; min-height: 40px; font-size: 14px; }
  #release-report .distribution-track { height: 19px; }
  #release-report .distribution-track span { display: block; height: 100%; background: #a9762e; }
  #release-report .distribution-row strong { text-align: right; font-weight: 500; }
  #release-report .distribution-share { font-size: 12px; color: #5d4632; text-align: right; }
  #release-report .subsection-heading { font-size: 27px; margin-top: 40px; }
  #release-report .finding-with-chart { display: grid; grid-template-columns: 260px minmax(0,1fr); gap: 38px; margin-top: 20px; }
  #release-report .finding-value { font-size: 65px; line-height: 1 !important; color: #7d5714; margin-top: 27px; }
  #release-report .finding-label { font-size: 17px; line-height: 1.4 !important; margin: 10px 0 18px; }
  #release-report .benchmark-summary { padding-top: 36px; }
  #release-report .benchmark-summary .small-label { font-size: 13px; font-weight: 500; }
  #release-report .benchmark-result { display: flex; justify-content: space-between; align-items: baseline; padding: 13px 0; border-bottom: 1px solid #ded5c5; }
  #release-report .benchmark-result > span { font-size: 18px; }
  #release-report .benchmark-result strong { font-size: 33px; font-weight: 500; line-height: 1; }
  #release-report .finding-text p:not(.finding-value):not(.finding-label) { font-size: 14px; color: #5d4632; margin-top: 16px; }
  #release-report .paired-figures { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 35px; }
  #release-report .migration-list > div { display: grid; grid-template-columns: 240px minmax(0,1fr); gap: 40px; padding: 23px 0; border-top: 1px solid #ded5c5; }
  #release-report .migration-list h3 { font-size: 22px; }
  #release-report .migration-list p { font-size: 15px; color: #5d4632; }
