---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getTagGroups, readingTime, TAG_INDEX_MIN_POSTS } from '../../../lib/blog-tags';
import type { TagGroup } from '../../../lib/blog-tags';

export async function getStaticPaths() {
  const groups = await getTagGroups();
  return groups.map(group => ({
    params: { tag: group.slug },
    props: { group },
  }));
}

interface Props {
  group: TagGroup;
}

const { group } = Astro.props;
const count = group.posts.length;
const thin = count < TAG_INDEX_MIN_POSTS;

const description = `${count === 1 ? 'One post' : `${count} posts`} from the Query.Farm blog tagged ${group.label}.`;

const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/blog/tags/${group.slug}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${group.label} — Blog`,
    description,
    url: pageUrl,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: count,
      itemListElement: group.posts.map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: post.data.title,
        url: `${SITE_ORIGIN}/blog/${post.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE_ORIGIN + '/blog' },
      { '@type': 'ListItem', position: 3, name: group.label, item: pageUrl },
    ],
  },
];
---

<PageLayout
  title={`${group.label} — Blog`}
  description={description}
  noindex={thin}
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow="Topic"
    title={group.label}
    lede={description}
  />

  <div class="section-container">
    <div class="grid grid-cols-1 gap-4 pt-2 pb-5 md:grid-cols-2 lg:grid-cols-3">
      {group.posts.map(post => (
        <PostCard
          title={post.data.title}
          excerpt={post.data.description}
          date={post.data.pubDate}
          author={post.data.author}
          tags={post.data.tags}
          slug={post.id}
          heroImage={post.data.heroImage}
          readingTime={readingTime(post.body)}
        />
      ))}
    </div>

    <div class="pt-6 pb-20">
      <a
        href="/blog"
        class="inline-block rounded-lg border border-soil-900 px-4 py-2 text-[12.5px] font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
      >
        ← All posts
      </a>
    </div>
  </div>
</PageLayout>
