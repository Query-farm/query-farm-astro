---
import PageLayout from '../../layouts/PageLayout.astro';
import BlogSubNav from '../../components/blog/BlogSubNav.astro';
import TopicWeather from '../../components/blog/TopicWeather.astro';
import MastheadFields from '../../components/blog/MastheadFields.astro';
import { getPublishedPosts, readingTime } from '../../lib/blog-tags';

const posts = await getPublishedPosts();
const lead = posts[0];
const selections = ['one-query-one-arrow-stream-adbc-duckdb-2', 'a-where-clause-for-taste']
  .map(id => posts.find(p => p.id === id)).filter((p): p is typeof posts[number] => !!p && p !== lead);
const selectedIds = new Set([lead?.id, ...selections.map(p => p.id)]);
const archive = posts.filter(p => !selectedIds.has(p.id));
const dateFor = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const description = 'Deep dives on DuckDB extensions, Arrow transport, and the failure modes that only show up in production — written by the people who build them.';
const origin = 'https://query.farm';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Blog', name: 'Query.Farm Blog', description, url: origin + '/blog', isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: origin }, blogPost: posts.slice(0, 10).map(p => ({ '@type': 'BlogPosting', headline: p.data.title, url: origin + '/blog/' + p.id, datePublished: p.data.pubDate.toISOString() })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: origin + '/blog' }] },
];
---

<PageLayout title="Blog" description={description} ogImage="/og/blog.jpg" jsonLd={jsonLd}>
  <BlogSubNav slot="subnav" />
  <div class="mx-auto max-w-[1120px] px-6 pb-20 sm:px-10">
    <header class="masthead">
      <div class="masthead-title">
        <h1>Notes from<br /><em>the farm.</em></h1>
        <MastheadFields />
      </div>
      <div class="masthead-rule flex flex-wrap justify-between gap-x-6 gap-y-2 py-3 text-[13px] text-soil-700">
        <p>DuckDB, Arrow, and the occasional strong opinion.</p>
        <span class="font-display italic">Written by the people building it.</span>
      </div>
    </header>

    <section aria-label="Selected stories" class="grid gap-10 border-b border-soil-300 py-10 md:grid-cols-[1.8fr_1fr] md:gap-12 md:py-14">
      {lead && <article>
        <h2 class="max-w-[17ch] text-[clamp(2.4rem,4.3vw,3.55rem)] leading-[1.06] tracking-[-0.035em]">
          <a class="editorial-link" href={'/blog/' + lead.id}>{lead.data.title}</a>
        </h2>
        <p class="mt-6 max-w-[48ch] text-[18px] leading-[1.7] text-soil-700">{lead.data.description}</p>
        {lead.data.leadVisual && (
          <img
            class="mt-7 block h-auto w-full"
            src={lead.data.leadVisual.src}
            alt={lead.data.leadVisual.alt}
            width={lead.data.leadVisual.width}
            height={lead.data.leadVisual.height}
            aria-hidden={lead.data.leadVisual.alt === '' ? 'true' : undefined}
          />
        )}
        <p class="mt-7 text-[13px] text-soil-900">By {lead.data.author}</p>
        <p class="mt-2 text-[12px] text-soil-700"><time datetime={lead.data.pubDate.toISOString()}>{dateFor(lead.data.pubDate)}</time><span class="px-2" aria-hidden="true">·</span>{readingTime(lead.body)} min read</p>
        <a class="mt-6 inline-block text-[14px] text-soil-900 underline decoration-soil-400 underline-offset-4 hover:text-link" href={'/blog/' + lead.id}>Continue reading <span aria-hidden="true">→</span></a>
      </article>}
      {selections.length > 0 && <aside aria-labelledby="selected-heading" class="reading-column border-t border-soil-300 pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-10">
        <h2 id="selected-heading" class="text-[24px] italic text-soil-700">In the margins</h2>
        <div class="divide-y divide-soil-300">
          {selections.map(post => <article class="py-6 first:pt-5 last:pb-0">
            <h3 class="text-[27px] leading-[1.18] tracking-[-0.025em]"><a class="editorial-link" href={'/blog/' + post.id}>{post.data.title}</a></h3>
            <p class="mt-3 text-[14px] leading-[1.7] text-soil-700">{post.data.description}</p>
            <p class="mt-4 text-[12px] text-soil-700"><time datetime={post.data.pubDate.toISOString()}>{dateFor(post.data.pubDate)}</time><span class="px-2" aria-hidden="true">·</span>{readingTime(post.body)} min read</p>
          </article>)}
        </div>
        <div class="mt-8 border-t border-soil-300 pt-7">
          <TopicWeather posts={posts} />
        </div>
      </aside>}
    </section>

    <section aria-labelledby="archive-heading" class="pt-10 md:pt-12">
      <div class="archive-heading"><h2 id="archive-heading" class="text-[34px] italic">The back pages</h2><span aria-hidden="true">↙</span></div>
      <div class="divide-y divide-soil-300">
        {archive.map(post => <article class="grid gap-3 py-7 md:grid-cols-[145px_1fr] md:gap-8 md:py-8">
          <time datetime={post.data.pubDate.toISOString()} class="pt-1 text-[12px] text-soil-700">{dateFor(post.data.pubDate)}</time>
          <div>
            <h3 class="max-w-[38ch] text-[clamp(1.5rem,2.6vw,1.9rem)] leading-[1.2]"><a class="editorial-link" href={'/blog/' + post.id}>{post.data.title}</a></h3>
            <p class="mt-3 max-w-[68ch] text-[15px] leading-[1.75] text-soil-700">{post.data.description}</p>
          </div>
        </article>)}
      </div>
      {posts.length === 0 && <p class="py-10 text-soil-700">New field notes are on their way. Check back soon.</p>}
    </section>

    <section aria-labelledby="dispatch-heading" class="mt-6 border-t-2 border-soil-900 py-10 text-center md:py-12">
      <h2 id="dispatch-heading" class="text-[34px] italic">Keep in touch.</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-soil-700">We’ll email you when we publish. Releases, experiments, and things that broke.</p>
      <a href="/company/newsletter" class="mt-5 inline-block text-sm text-soil-900 underline decoration-soil-400 underline-offset-4 hover:text-link">Subscribe to the dispatch <span aria-hidden="true">→</span></a>
    </section>
  </div>
</PageLayout>

<style>
  .masthead-title { display: grid; grid-template-columns: 1fr 290px; align-items: end; gap: 24px; padding: 24px 0 32px; }
  .masthead h1 { font-size: clamp(4rem, 8.9vw, 7.5rem); line-height: .84; letter-spacing: -.055em; font-weight: 600; }
  .masthead h1 em { color: var(--color-soil-600); font-weight: 500; }
  .masthead-rule { border-top: 3px solid var(--color-soil-600); border-bottom: 1px solid var(--color-soil-300); }
  .archive-heading { display: flex; align-items: center; gap: 20px; margin-bottom: 8px; color: var(--color-soil-600); }
  .archive-heading > span { font-family: var(--font-display); font-size: 36px; }
  .editorial-link { color: var(--color-soil-900); text-decoration: none; }
  .editorial-link:hover { color: var(--color-soil-600); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .13em; }
  .editorial-link:focus-visible { outline: 2px solid var(--color-field-700); outline-offset: 5px; }
  @media (max-width: 767px) {
    .masthead-title { grid-template-columns: 1fr 110px; gap: 0; padding: 20px 0 25px; }
    .masthead h1 { font-size: clamp(3.1rem, 10vw, 4.8rem); }
    .masthead-rule { font-size: 12px; }
  }
  @media (max-width: 380px) {
    .masthead-title { grid-template-columns: 1fr 75px; }
    .masthead h1 { font-size: 2.9rem; }
  }
</style>
