---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

// Get all blog posts
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique tags
const allTags = [...new Set(publishedPosts.flatMap(post => post.data.tags))].sort();
---

<PageLayout
  title="Blog"
  description="Latest updates, releases, and insights from the Query.Farm team about DuckDB, data infrastructure, and modern analytics."
>
  <!-- Hero Section -->
  <Hero
    title="Query.Farm Blog"
    subtitle="Latest updates on DuckDB extensions, data infrastructure insights, and product releases from our team."
  />

  <!-- Blog Posts Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <!-- Tag Filter -->
      {allTags.length > 0 && (
        <div class="mb-12">
          <h3 class="text-sm font-semibold text-soil-700 uppercase tracking-wider mb-4">Filter by Topic</h3>
          <div class="flex flex-wrap gap-2">
            <button class="px-4 py-2 rounded-lg bg-harvest-100 text-harvest-800 text-sm font-medium hover:bg-harvest-200 transition-colors">
              All Posts
            </button>
            {allTags.map(tag => (
              <button class="px-4 py-2 rounded-lg bg-soil-100 text-soil-700 text-sm font-medium hover:bg-soil-200 transition-colors capitalize">
                {tag}
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Posts Grid -->
      {publishedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {publishedPosts.map(post => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              author={post.data.author}
              tags={post.data.tags}
              slug={post.slug}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-soil-600">No blog posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-soil-900 mb-4">
          Never Miss an Update
        </h2>
        <p class="text-lg text-soil-600 mb-8">
          Subscribe to our newsletter for the latest DuckDB extensions, product releases, and data infrastructure insights.
        </p>
        <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-3 rounded-lg border border-soil-300 focus:border-harvest-500 focus:ring-2 focus:ring-harvest-500 focus:outline-none"
          />
          <button
            type="submit"
            class="px-8 py-3 bg-harvest-600 hover:bg-harvest-700 text-white font-medium rounded-lg transition-colors"
          >
            Subscribe
          </button>
        </form>
        <p class="text-sm text-soil-500 mt-4">
          Join 1,000+ developers building with DuckDB. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
