---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import PostListItem from '../../components/blog/PostListItem.astro';
import FeaturedPost from '../../components/blog/FeaturedPost.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import { getCollection, render } from 'astro:content';
import { getTagGroups } from '../../lib/blog-tags';

// Get all blog posts
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Read time, from the raw markdown body. 200 wpm, floored at one minute.
const readingTime = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).length / 200));

const [featured, ...rest] = publishedPosts;

// The lead card's contents list is the post's own H2s — no new authoring, and
// it stays correct as the post is edited.
const featuredHeadings = featured
  ? (await render(featured)).headings.filter(h => h.depth === 2).map(h => ({ text: h.text }))
  : [];

// Unique tags, deduped on slug (so "DuckDB"/"duckdb" collapse to one chip) and
// each linking to its archive at /blog/tags/<slug>.
const tagGroups = await getTagGroups(publishedPosts);

// Hold the topic filter back until the archive is big enough to justify it —
// a wall of chips above a handful of posts implies an archive that isn't there.
// The archives themselves exist regardless; posts link to them from their foot.
const FILTER_MIN_POSTS = 8;
const showTagFilter = publishedPosts.length >= FILTER_MIN_POSTS && tagGroups.length > 0;

// The newsletter panel is not about any one post, so it keeps the stage run.
const ART_BANDS = ['bg-pipe-1', 'bg-pipe-2', 'bg-pipe-3', 'bg-pipe-4', 'bg-pipe-5', 'bg-pipe-6'];

const SITE_ORIGIN = 'https://query.farm';
const description =
  'Deep dives on DuckDB extensions, Arrow transport, and the failure modes that only show up in production — written by the people who build them.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Query.Farm Blog',
    description,
    url: `${SITE_ORIGIN}/blog`,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    blogPost: publishedPosts.slice(0, 10).map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: `${SITE_ORIGIN}/blog/${post.id}`,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE_ORIGIN + '/blog' },
    ],
  },
];
---

<PageLayout
  title="Blog"
  description={description}
  ogImage="/og/blog.jpg"
  jsonLd={jsonLd}
>
  <PageHead
    title="Notes from the farm"
    lede="Deep dives on DuckDB extensions, Arrow transport, and the failure modes that only show up in production — written by the people who build them."
  />

  <div class="section-container">
    {/* No thumbnails here on purpose. The only candidates were the posts'
        social cards (cropped past recognition) and crops of their own figures,
        which read as decoration out of context. Each post's topic contour
        (TopicCurves) does the work a thumbnail would, and costs nothing per
        post to author. */}
    {featured && (
      <div class="pt-8 pb-2">
        <FeaturedPost
          title={featured.data.title}
          excerpt={featured.data.description}
          date={featured.data.pubDate}
          tags={featured.data.tags}
          slug={featured.id}
          readingTime={readingTime(featured.body)}
          headings={featuredHeadings}
        />
      </div>
    )}

    {showTagFilter && (
      <div class="pt-8">
        <h2 class="text-[13px] font-medium text-soil-500">Filter by topic</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <span
            aria-current="page"
            class="rounded-full border border-sun-400 bg-sun-400/12 px-3 py-1 text-[12.5px] font-medium text-sun-700"
          >
            All posts
          </span>
          {tagGroups.map(group => (
            <a
              href={`/blog/tags/${group.slug}`}
              class="rounded-full border border-soil-300 px-3 py-1 text-[12.5px] font-medium text-soil-600 no-underline transition hover:border-sun-400 hover:text-link"
            >
              {group.label}
            </a>
          ))}
        </div>
      </div>
    )}

    {rest.length > 0 && (
      <div class="pt-10 pb-5">
        {/* Not "More from the farm" — the page is already titled "Notes from
            the farm", and echoing it here says nothing the position doesn't. */}
        <h2 class="qf-eyebrow border-b border-soil-300 pb-3 text-soil-500">Earlier posts</h2>
        <div class="divide-y divide-soil-200">
          {rest.map(post => (
            <PostListItem
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              tags={post.data.tags}
              slug={post.id}
              readingTime={readingTime(post.body)}
            />
          ))}
        </div>
      </div>
    )}

    {publishedPosts.length === 0 && (
      <p class="py-16 text-center text-[17.5px] text-soil-700">No posts published yet. Check back soon.</p>
    )}
  </div>

  <section class="pt-12 pb-20">
    <div class="section-container">
      <div class="overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7]">
        <!-- The card strip: this family's only use of the stage palette (brief §5). -->
        <div class="grid h-1.5 grid-cols-6" aria-hidden="true">
          {ART_BANDS.map(band => <i class={band}></i>)}
        </div>
        <div class="grid gap-8 px-8 py-9 md:grid-cols-[1fr_1.1fr] md:items-center">
          <div>
            <span class="text-[13.5px] font-medium text-sun-700">The dispatch</span>
            <h2 class="mt-3 text-[29px]">New posts, in your inbox</h2>
            <p class="mt-3 max-w-[46ch] leading-relaxed text-soil-700">
              Extension releases, VGI updates, and the occasional deep dive. Sent when there's
              something worth sending — not on a schedule.
            </p>
          </div>
          <NewsletterForm id="newsletter-blog-index" />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
