---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarTable from '../../components/charts/BarTable.astro';
import SqlKeywordText from '../../components/blog/SqlKeywordText.astro';
import ExampleShellMounter from '../../components/repl/ExampleShellMounter.tsx';
import { readingTime, tagSlug } from '../../lib/blog-tags';
import { topicBands } from '../../lib/blog-topics';
import { blogFigure } from '../../data/blog-figures';
import { blogWasmExamples } from '../../data/blog-wasm-examples';

export async function getStaticPaths() {
  // Drafts are excluded from the blog index and from related posts, but that
  // only makes them unlisted: a built page still resolves at its real URL, and
  // the sitemap and Pagefind both work off dist/, so they would advertise it.
  // Skip building them entirely instead. The dev server still renders drafts
  // so they can be previewed, and INCLUDE_DRAFTS=true forces them into a build
  // for the Access-gated PR preview deploys. (Astro hoists getStaticPaths out
  // of the frontmatter scope, so this flag has to live inside it.)
  const includeDrafts = import.meta.env.DEV || process.env.INCLUDE_DRAFTS === 'true';
  const blogPosts = await getCollection('blog');
  return blogPosts
    .filter(post => includeDrafts || !post.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { entry: post },
    }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { title, description, pubDate, author, tags, heroImage, leadVisual } = entry.data;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = new Date(pubDate).toISOString().slice(0, 10);

const minutes = readingTime(entry.body);

// The kicker carries the primary topic ONLY. Read time moved down to the
// byline, which is the line that answers "who / when / how long" — printing it
// in both places was the duplication half of the old meta block.
const topic = tags[0];
const tagLinks = tags.map(tag => ({ label: tag, href: `/blog/tags/${tagSlug(tag)}` }));

const figure = blogFigure(entry.id);
const wasmExamples = blogWasmExamples(entry.id);
const hasOpeningBrief = entry.body?.includes('class="article-brief"') ?? false;
const sectionHeadings = headings.filter(heading => heading.depth === 2);
const showSectionIndex = sectionHeadings.length >= 6;

// Article structured data for rich results (E-E-A-T: named author, dates).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleImage = heroImage ? new URL(heroImage, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: new Date(pubDate).toISOString(),
  author: author === 'Query.Farm Team'
    ? { '@type': 'Organization', name: author, url: 'https://query.farm' }
    : { '@type': 'Person', name: author, url: new URL('/company/about', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    name: 'Query.Farm',
    logo: { '@type': 'ImageObject', url: new URL('/Query_Farm_Logo.png', Astro.site).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  ...(articleImage ? { image: articleImage } : {}),
};

const shareUrl = canonicalURL.href;

// One genuinely related next read is more useful than a generic content grid.
// Shared topics establish relevance; recency only breaks ties.
const relatedPost = (await getCollection('blog'))
  .filter(post => post.id !== entry.id && !post.data.draft)
  .map(post => ({
    post,
    sharedTopics: post.data.tags.filter(tag => tags.includes(tag)).length,
  }))
  .filter(candidate => candidate.sharedTopics > 0)
  .sort((a, b) =>
    b.sharedTopics - a.sharedTopics ||
    b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )[0]?.post;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={heroImage}
  jsonLd={jsonLd}
  articlePublishedTime={new Date(pubDate).toISOString()}
  articleAuthor={new URL('/company/about', Astro.site).href}
  articleSection={topic}
  articleTags={tags}
>
  <div class="article-progress" aria-hidden="true"><i></i></div>
  <article>
    <div class="mx-auto max-w-[720px] px-6 pt-11 pb-5">
      {topic && (
        <div class="text-[13.5px] font-medium text-link">
          <a
            href={`/blog/tags/${tagSlug(topic)}`}
            class="no-underline transition-colors hover:text-link-hover"
          >{topic}</a>
        </div>
      )}

      <h1 class="mt-3.5 text-[clamp(2rem,4.6vw,3.5rem)] leading-[1.04] tracking-[-0.03em]"><SqlKeywordText text={title} /></h1>

      {/* Byline: one voice. Commissioner throughout, figures tabular via
          .qf-figure (brief §2). Sentence case, no tracking — the kicker and
          the footer chips are the same face, separated by colour and weight
          rather than by a second family. Tags are NOT repeated here; the
          primary topic already leads the kicker and the full set is filed at
          the foot of the article. */}
      <div class="mt-4.5 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-t border-b border-soil-300 py-3.5 text-sm text-soil-500">
        {author && <span class="font-medium text-soil-900">{author}</span>}
        {author && <span aria-hidden="true" class="text-soil-400">·</span>}
        <time datetime={isoDate} class="qf-figure">{formattedDate}</time>
        <span aria-hidden="true" class="text-soil-400">·</span>
        <span class="qf-figure">{minutes} min read</span>
      </div>

      {description && (
        <p class="mt-5 text-[17.5px] leading-relaxed text-soil-700"><SqlKeywordText text={description} /></p>
      )}
    </div>

    {/* The lead figure is the post's own data, drawn (src/data/blog-figures.ts).
        heroImage is NOT rendered here: those files are 1200×630 social cards,
        and cropping one into a page-width slot loses its subject and, on the
        WASM post, prints a second headline that contradicts the real title.
        They stay in the <head> as og:image, which is what they're built for.
        A post with no measured data gets the topic panel instead — we don't
        invent a chart to fill the slot. */}
    <div class="mx-auto max-w-[720px] px-6 pb-2">
      {figure ? (
        <BarTable
          title={figure.title}
          subtitle={figure.subtitle}
          rowHeader={figure.rowHeader}
          series={figure.series}
          rows={figure.rows}
          noteLabel={figure.noteLabel}
          source={figure.source}
          precision={figure.precision}
        />
      ) : leadVisual ? (
        <img
          class="article-lead-visual"
          src={leadVisual.src}
          alt={leadVisual.alt}
          width={leadVisual.width}
          height={leadVisual.height}
          aria-hidden={leadVisual.alt === '' ? 'true' : undefined}
        />
      ) : !hasOpeningBrief ? (
        <div class="flex h-28 overflow-hidden rounded-xl border border-soil-300" aria-hidden="true">
          {topicBands(topic).map(band => (
            <i class="flex-1" style={`background:${band}`}></i>
          ))}
        </div>
      ) : null}
    </div>

    <div class="article-body">
      {wasmExamples && (
        <ExampleShellMounter
          client:idle
          extensionName={wasmExamples.extensionName}
          installSource={wasmExamples.installSource}
          fixtures={wasmExamples.setupSql ?? null}
          controls={wasmExamples.controls}
        />
      )}

      {showSectionIndex && (
        <nav class="article-index" aria-labelledby="article-index-title">
          <div class="article-index__inner">
            <p id="article-index-title" class="article-index__title">In this article</p>
            <ol>
              {sectionHeadings.map(heading => (
                <li><a href={`#${heading.slug}`}><SqlKeywordText text={heading.text} /></a></li>
              ))}
            </ol>
          </div>
        </nav>
      )}

      <div class="qf-prose px-6 pt-6 pb-14">
        <Content />
      </div>
    </div>

    {/* Filed under — the full tag set, once, at the foot of the piece, where
        Medium/Ghost/dev.to put it: a reader who finished the article is the
        one who wants more like it. Chips are links to the tag archives. */}
    {tagLinks.length > 0 && (
      <div class="mx-auto max-w-[720px] px-6 pb-2">
        <div class="border-t border-soil-300 pt-6">
          <h2 class="text-[13px] font-medium text-soil-500">Filed under</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {tagLinks.map(tag => (
              <li>
                <a
                  href={tag.href}
                  class="inline-block rounded-full border border-soil-300 px-3 py-1 text-[12.5px] font-medium text-soil-600 no-underline transition hover:border-sun-400 hover:text-link"
                >{tag.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {relatedPost && (
      <aside class="mx-auto max-w-[720px] px-6 pt-8" aria-labelledby="keep-reading-title">
        <a
          href={`/blog/${relatedPost.id}`}
          class="related-read group block overflow-hidden rounded-xl border border-soil-300 bg-[#fffdf7] no-underline transition hover:-translate-y-0.5 hover:border-sun-500 hover:shadow-[0_12px_32px_rgba(60,43,24,0.09)] motion-reduce:hover:translate-y-0"
        >
          <div class="grid h-1 grid-cols-6" aria-hidden="true">
            {topicBands(relatedPost.data.tags[0]).map(band => <i style={`background:${band}`}></i>)}
          </div>
          <div class="px-6 py-5 sm:px-7 sm:py-6">
            <p id="keep-reading-title" class="text-[12.5px] font-medium text-sun-700">Keep reading</p>
            <h2 class="mt-2 text-[clamp(1.25rem,3vw,1.65rem)] leading-tight transition-colors group-hover:text-link">
              <SqlKeywordText text={relatedPost.data.title} />
            </h2>
            <p class="mt-2 line-clamp-2 text-[14.5px] leading-relaxed text-soil-600">
              {relatedPost.data.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-2 text-[12.5px] font-medium text-link">
              Read next <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </aside>
    )}

    <div class="mx-auto max-w-[720px] px-6 pt-8 pb-20">
      <div class="h-px bg-soil-300"></div>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/blog"
          class="inline-block rounded-lg border border-soil-900 px-4 py-2 text-[12.5px] font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
        >
          ← All posts
        </a>
        <div class="flex items-center gap-4 text-[13px] font-medium text-soil-500">
          <span>Share</span>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline transition-colors hover:text-link"
          >X</a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline transition-colors hover:text-link"
          >LinkedIn</a>
        </div>
      </div>
    </div>
  </article>

  <script>
    const progressBar = document.querySelector<HTMLElement>('.article-progress i');
    const article = document.querySelector<HTMLElement>('main article');

    if (progressBar && article) {
      let frame = 0;
      const updateProgress = () => {
        frame = 0;
        const start = article.offsetTop;
        const distance = Math.max(1, article.offsetHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
        progressBar.style.transform = `scaleX(${progress})`;
      };
      const requestUpdate = () => {
        if (!frame) frame = requestAnimationFrame(updateProgress);
      };
      updateProgress();
      addEventListener('scroll', requestUpdate, { passive: true });
      addEventListener('resize', requestUpdate, { passive: true });
    }
  </script>
</BaseLayout>

<style is:global>
  .article-progress {
    position: fixed;
    z-index: 45;
    top: var(--qf-nav-h);
    left: 0;
    width: 100%;
    height: 3px;
    pointer-events: none;
  }
  .article-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-sun-500);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .article-lead-visual {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-body {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
  }
  .article-index { padding: 24px 24px 0; }
  .article-index__inner {
    border: 1px solid var(--color-soil-300);
    border-radius: 12px;
    background: #fffdf7;
    padding: 20px 22px 22px;
  }
  .article-index__title {
    color: var(--color-sun-700);
    font-size: 12.5px;
    font-weight: 600;
  }
  .article-index ol {
    counter-reset: article-index;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 24px;
    margin-top: 13px;
  }
  .article-index li {
    counter-increment: article-index;
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr);
    align-items: baseline;
    min-width: 0;
  }
  .article-index li::before {
    content: counter(article-index, decimal-leading-zero);
    color: var(--color-soil-400);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }
  .article-index a {
    color: var(--color-soil-800);
    font-size: 13.5px;
    line-height: 1.45;
    text-decoration: none;
  }
  .article-index a:hover { color: var(--color-link); text-decoration: underline; }
  .article-index a:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  @media (min-width: 1280px) {
    .article-index {
      position: absolute;
      top: 24px;
      left: calc(100% + 28px);
      width: 220px;
      height: calc(100% - 24px);
      padding: 0;
    }
    .article-index__inner {
      position: sticky;
      top: calc(var(--qf-nav-h) + 24px);
      padding: 17px 18px 18px;
    }
    .article-index ol {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .article-index li { grid-template-columns: 2.1em minmax(0, 1fr); }
    .article-index a { font-size: 12.5px; line-height: 1.4; }
  }

  .article-brief {
    overflow: hidden;
    border: 1px solid var(--color-soil-300);
    border-radius: 12px;
    background: #fffdf7;
  }
  .article-brief::before {
    content: '';
    display: block;
    height: 5px;
    background: linear-gradient(to right,
      var(--color-pipe-1) 0 16.666%, var(--color-pipe-2) 16.666% 33.333%,
      var(--color-pipe-3) 33.333% 50%, var(--color-pipe-4) 50% 66.666%,
      var(--color-pipe-5) 66.666% 83.333%, var(--color-pipe-6) 83.333% 100%);
  }
  .article-brief-inner { padding: 24px 26px 26px; }
  .article-brief-label {
    color: var(--color-sun-700);
    font-size: 12.5px;
    font-weight: 600;
  }
  .article-brief ul { margin-top: 13px; display: grid; gap: 11px; }
  .article-brief li {
    position: relative;
    padding-left: 19px;
    color: var(--color-soil-800);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .article-brief li::before {
    content: '';
    position: absolute;
    top: .62em;
    left: 0;
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--color-field-700);
  }
  .qf-prose .article-brief-label { color: var(--color-sun-700); }
  .qf-prose .article-brief ul { padding-left: 0; list-style: none; }
  .qf-prose .article-brief li {
    margin-top: 0;
    color: var(--color-soil-800);
  }

  /* Editorial prose — family E. 720px measure, Fraunces doing more work here
     than anywhere else on the site. Global because <Content /> renders markdown
     outside this component's scope; every selector is fenced behind .qf-prose. */
  .qf-prose {
    max-width: 720px;
    min-width: 0;
    margin: 0 auto;
    overflow-wrap: break-word;
    font-size: 17.5px;
    line-height: 1.75;
    counter-reset: article-section;
  }
  .qf-prose > * { min-width: 0; max-width: 100%; }
  .qf-prose > * + * { margin-top: 20px; }
  .qf-prose p,
  .qf-prose li { color: var(--color-soil-700); }
  .qf-prose strong { color: var(--color-soil-900); font-weight: 600; }

  .qf-prose h2 {
    margin-top: 58px;
    padding-top: 28px;
    border-top: 1px solid var(--color-soil-300);
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    counter-increment: article-section;
  }
  .qf-prose h2::before {
    content: 'Section ' counter(article-section, decimal-leading-zero);
    display: block;
    margin-bottom: 9px;
    color: var(--color-sun-700);
    font-family: 'Commissioner', ui-sans-serif, system-ui, sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .02em;
  }
  .qf-prose h2 + p { color: var(--color-soil-800); font-size: 1.035em; }
  .qf-prose h3 {
    margin-top: 38px;
    border-left: 3px solid var(--color-sun-400);
    padding-left: 14px;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
  }
  .qf-prose h4 { margin-top: 26px; }

  /* Drop cap — only when the post actually opens on prose. */
  .qf-prose > p:first-child::first-letter {
    font-family: 'Petrona', Georgia, serif;
    font-weight: 500;
    float: left;
    font-size: 66px;
    line-height: 0.78;
    padding: 6px 12px 0 0;
    color: var(--color-sun-700);
  }
  .qf-prose > .article-brief + p::first-letter {
    font-family: 'Petrona', Georgia, serif;
    font-weight: 500;
    float: left;
    font-size: 66px;
    line-height: 0.78;
    padding: 6px 12px 0 0;
    color: var(--color-sun-700);
  }

  /* Links are green (interaction), not gold (identity) — and the underline is
     load-bearing, not decoration. This palette cannot satisfy WCAG F73's 3:1
     link-vs-body-text rule: no green dark enough for the cat-gold chip also
     clears 3:1 against #211a12. So colour never distinguishes a link on its
     own here. Weight 400 because Commissioner 300 is optically thin and loses
     effective contrast the flat-patch model doesn't capture. */
  .qf-prose a:not(.btn) {
    color: var(--color-link);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--color-link) 45%, transparent);
  }
  .qf-prose a:not(.btn):hover {
    color: var(--color-link-hover);
    text-decoration-thickness: 2px;
    text-decoration-color: currentColor;
  }
  .qf-prose a:not(.btn):focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* External-link marker now lives in global.css as a site-wide standard,
     scoped to `main` + running-text containers. Nothing blog-specific left. */

  .qf-prose ul, .qf-prose ol { padding-left: 22px; }
  .qf-prose ul { list-style: disc; }
  .qf-prose ol { list-style: decimal; }
  .qf-prose li { margin-top: 6px; }
  .qf-prose li::marker { color: var(--color-soil-400); }

  /* Blockquote = ABSTRACT, not pull quote.
     Every blockquote in the corpus is a long prose callout — the two that
     exist run 934 and 711 characters, and one of them opens a post. Setting
     that at display size in Fraunces produced ten lines of oversized wonky
     serif as the first thing on the page. So the markdown default is a
     readable abstract: body face, body measure, tinted ground, sun-400 rule.
     A genuine pull quote is a different device and has to be asked for —
     see .is-pullquote below. */
  .qf-prose blockquote {
    font-family: 'Commissioner', ui-sans-serif, system-ui, sans-serif;
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.7;
    letter-spacing: normal;
    color: var(--color-soil-800);
    background: color-mix(in srgb, var(--color-sun-400) 7%, var(--color-soil-50));
    border-left: 3px solid var(--color-sun-400);
    border-radius: 0 8px 8px 0;
    padding: 18px 22px;
    margin: 30px 0;
  }
  .qf-prose blockquote p { color: inherit; }
  .qf-prose blockquote > * + * { margin-top: 12px; }
  /* The leading "Summary." / "Note." run-in reads as the callout's label. */
  .qf-prose blockquote > p:first-child > strong:first-child {
    font-weight: 600;
    font-size: 0.86em;
    letter-spacing: 0;
    color: var(--color-sun-700);
    display: block;
    margin-bottom: 6px;
  }

  /* Pull quote — opt in with <blockquote class="is-pullquote">. Fraunces at
     SOFT 30 / WONK 1, the only place WONK returns outside the wordmark. Meant
     for a short lifted line; it will look absurd past ~200 characters. */
  .qf-prose blockquote.is-pullquote {
    font-family: 'Petrona', Georgia, serif;
    font-weight: 500;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.32;
    letter-spacing: -0.018em;
    color: var(--color-soil-900);
    background: none;
    border-radius: 0;
    padding: 4px 0 4px 22px;
  }
  .qf-prose blockquote.is-pullquote > p:first-child > strong:first-child {
    font-family: inherit; font-size: inherit; letter-spacing: inherit;
    text-transform: none; color: inherit; display: inline; margin-bottom: 0;
  }

  /* Inline code on paper; block code ALWAYS on rock-900 (brief §3) — Shiki
     paints the ground, this supplies the frame. */
  .qf-prose :not(pre) > code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.86em;
    background: var(--color-soil-100);
    padding: 2px 6px;
    border-radius: 5px;
    color: var(--color-soil-900);
  }
  .qf-prose pre {
    background: var(--color-rock-900);
    color: #e9e1d3;
    border-radius: 12px;
    padding: 20px;
    overflow-x: auto;
    font-size: 12.8px;
    line-height: 1.9;
  }
  .qf-prose pre code { font-family: 'JetBrains Mono', ui-monospace, monospace; }

  /* table.qf, applied to whatever the markdown emits. */
  .qf-prose table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .qf-prose th {
