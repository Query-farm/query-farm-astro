  .note { margin-top: 1.1rem; color: var(--color-soil-700); font-size: .8125rem; line-height: 1.8; }
  .note a { text-decoration: underline; text-underline-offset: 3px; color: var(--color-link); }
  .faq-section,.version-section { background: var(--color-soil-100); border-block: 1px solid var(--color-soil-300); }
  #versions { scroll-margin-top:8rem; }
  .control-section { background: var(--color-pipe-6); color: var(--color-cream); }
  .control-section :is(h2,h3) { color: var(--color-cream); }
  .control-section :is(.lede,.note) { color: var(--color-cream-2); }
  .dark-link { color: var(--color-cream); text-decoration: underline; text-underline-offset: 3px; font-size: .875rem; }
  .host-note { margin-top: 1.5rem; color: var(--color-cream-2); font-size: .75rem; line-height: 1.8; }
  .host-note .dark-link { font-size: inherit; }
  .guide-grid { display: grid; gap: 0 2.5rem; }
  .guide-link { border-top: 1px solid var(--color-soil-300); padding-block: 1.4rem; }
  .guide-link h3 { display: flex; align-items: start; justify-content: space-between; gap: 1rem; font-size: 1.25rem; }
  .guide-link h3 span { color: var(--color-field-700); font-family: var(--font-sans); }
  .guide-link p { margin-top: .6rem; color: var(--color-soil-700); font-size: .875rem; line-height: 1.8; }
  .guide-link:hover h3 { color: var(--color-field-700); }
  .closing-actions { margin-top: 2rem; }
  @media(min-width:768px) { .chapter-nav { grid-template-columns: repeat(3,minmax(0,1fr)); } .guide-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(min-width:1024px) { .split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 3.5rem; } .hero { grid-template-columns: minmax(0,1.05fr) minmax(0,.95fr); } }
  @media(max-width:640px) {
    .wrap { padding-inline: 1.25rem; }
    .hero { padding-block: 2.25rem; }
    h1 { font-size: clamp(2.25rem,10.5vw,2.8rem); }
    .hero-lede { font-size: 1.2rem; }
    .section { padding-block: 3.25rem; }
    .chapter-nav { gap: 0; }
    .chapter-nav a { min-height: 44px; }
    .actions,.closing-actions { align-items: stretch; gap: .65rem; }
    .actions :global(a),.closing-actions :global(a) { display: flex; align-items: center; justify-content: center; min-height: 44px; width: 100%; white-space: normal; text-align: center; }
    .availability,.host-note { font-size: .8125rem; }
  }

  .problem-section { padding-bottom:2.5rem; }
  .problem-framing { margin-bottom:2rem; }
  .recognizable-moments { display:grid; gap:1.5rem; padding:0; list-style:none; }
  .recognizable-moments li { padding-top:1.25rem; border-top:1px solid var(--color-soil-300); }
  .recognizable-moments h3 { font-size:1.3rem; }
  .recognizable-moments p { margin-top:.7rem; color:var(--color-soil-700); font-size:.9375rem; line-height:1.8; }
  .comparison-scroll { overflow-x:auto; }
  .comparison-scroll:focus-visible { outline:2px solid var(--color-link); outline-offset:4px; }
  .table-help { color:var(--color-soil-700); font-size:.8125rem; line-height:1.7; margin-bottom:1rem; }
  .comparison-scroll table { width:100%; min-width:660px; border-collapse:collapse; font-size:.9375rem; line-height:1.8; }
  .comparison-scroll caption { text-align:left; font-size:.8125rem; color:var(--color-soil-700); padding-bottom:.75rem; }
  .comparison-scroll :is(th,td) { text-align:left; vertical-align:top; padding:1rem 1.25rem; border-bottom:1px solid var(--color-soil-300); }
  .comparison-scroll th { font-weight:600; }
  .comparison-scroll thead { background:var(--color-soil-100); }
  .comparison-scroll th:first-child { width:25%; }
  .comparison-scroll td { width:37.5%; color:var(--color-soil-700); }
  .role-benefits,.ecosystem-notes,.evidence-links { display:grid; gap:2rem; }
  .role-benefits > div { padding-top:1.25rem; border-top:1px solid #8f9b79; }
  .role-benefits p { color:var(--color-cream-2); margin-top:.7rem; font-size:.9375rem; line-height:1.8; }
  .agent-disclosure { margin-top:2rem; border-top:1px solid #8f9b79; padding-top:1rem; }
  .agent-disclosure summary { cursor:pointer; min-height:44px; padding-block:.6rem; font-size:.9375rem; }
  .agent-disclosure :global(.agent-workflow) { margin-top:1.5rem; }
  .ecosystem-notes { margin-top:3rem; border-top:1px solid var(--color-soil-300); padding-top:2rem; }
  .ecosystem-notes p,.evidence-links p { color:var(--color-soil-700); font-size:.9375rem; line-height:1.8; margin-top:.8rem; }
  .ecosystem-notes a { color:var(--color-link); text-decoration:underline; text-underline-offset:4px; }
