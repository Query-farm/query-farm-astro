---
import PageLayout from '../../../layouts/PageLayout.astro';
import CrossfieldSubNav from '../../../components/sections/CrossfieldSubNav.astro';
import CrossfieldDiagram from '../../../components/crossfield/CrossfieldDiagram.astro';
import AgentWorkflow from '../../../components/crossfield/AgentWorkflow.astro';
import EditorialArt from '../../../components/crossfield/EditorialArt.astro';
import ChapterOrnament from '../../../components/crossfield/ChapterOrnament.astro';
import Button from '../../../components/ui/Button.astro';
import ScenarioWalkthrough from '../../../components/crossfield/ScenarioWalkthrough.astro';
import ModelRevisions from '../../../components/crossfield/ModelRevisions.astro';
import { organization } from '../../../lib/organization';
import { crossfieldDocs } from '../../../data/crossfield';


const description = 'Spend less time reconciling reports. Crossfield gives reporting teams and AI agents shared, inspectable business definitions through a semantic layer inside DuckDB.';
const guides = [
  { title: 'Run a business example', description: 'Explore order fulfillment or investment reporting with checked results.', href: `${crossfieldDocs}/examples` },
  { title: 'Author a model', description: 'Connect your tables to business definitions and approved operations.', href: `${crossfieldDocs}/models` },
  { title: 'Compose and compare', description: 'Join independent models and query revisions side by side.', href: `${crossfieldDocs}/querying` },
  { title: 'Build with discovery', description: 'Find definitions, inspect generated SQL, and repair rejected queries.', href: `${crossfieldDocs}/discovery` },
];
---

<PageLayout
  title="Crossfield: Semantic Layer for DuckDB"
  description={description}
  ogImage="/og/products.jpg"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Crossfield', description,
      url: 'https://query.farm/products/crossfield', applicationCategory: 'DeveloperApplication',
      softwareVersion: '0.1.0-dev', publisher: organization },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://query.farm/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://query.farm/products' },
      { '@type': 'ListItem', position: 3, name: 'Crossfield', item: 'https://query.farm/products/crossfield' },
    ] },
  ]}
>
  <CrossfieldSubNav slot="subnav" />
  <div class="crossfield-page" data-pagefind-body data-pagefind-filter="kind:page">
    <header class="hero wrap split">
      <div class="hero-copy">
        <div class="product-name"><img src="/crossfield/crossfield-mark.svg" alt="" width="38" height="38" /><span>Crossfield by Query.Farm</span></div>
        <h1>Spend less time<br /><em>reconciling reports.</em></h1>
        <p class="hero-lede">Give teams and AI agents shared definitions to work from.</p>
        <p class="hero-detail">Crossfield keeps business calculations consistent as people ask new questions. Define which records count, how metrics are calculated, and which operations are allowed—then reuse those rules through SQL.</p><p class="product-category">A semantic layer inside DuckDB.</p>
        <div class="actions"><Button href="#walkthrough">See a business example</Button><a class="text-link" href={crossfieldDocs}>Read the documentation →</a></div>
        <p class="availability"><span class="status">Coming in Haybarn</span> Crossfield will ship as part of <a href="/products/haybarn">Query Farm’s DuckDB distribution</a>. <a href="/company/contact">Request evaluation access →</a> <a href={`${crossfieldDocs}/compatibility`}>Release details →</a></p>
      </div>
      <figure class="hero-art"><img src="/crossfield/art/shared-ground.webp" alt="" width="1448" height="1086" fetchpriority="high" /><figcaption><span>Many sources.</span><strong>Shared definitions.</strong><span>New questions.</span></figcaption></figure>
    </header>

    <div class="hairband" aria-hidden="true"><i class="bg-pipe-1"></i><i class="bg-pipe-2"></i><i class="bg-pipe-3"></i><i class="bg-pipe-4"></i><i class="bg-pipe-5"></i><i class="bg-pipe-6"></i></div>

    <nav class="chapter-nav wrap" aria-label="Explore Crossfield">
      <a href="#reporting-problem"><span>01</span> Recognize the reporting problem</a>
      <a href="#walkthrough"><span>02</span> See what changes</a>
      <a href="#what-is-a-semantic-layer"><span>03</span> Understand how it works</a>
    </nav>

    <section class="section wrap problem-section" id="reporting-problem" aria-labelledby="meaning-heading">
      <div class="problem-framing">
        <ChapterOrnament section="shared-definitions" />
        <h2 id="meaning-heading">You built the data platform. The answers still differ.</h2>
        <p class="lede">The systems are connected and teams can access the data. But a dashboard, a SQL report and an AI-generated analysis can still interpret the same business question differently.</p>
        <p>More people and AI agents can now generate queries. Unless the reporting rules are shared, each new query can introduce another version of the business logic.</p>
      </div>
      <ul class="recognizable-moments" aria-label="Recognizable reporting problems">
        <li><h3>The meeting starts with a reconciliation.</h3><p>Two reports disagree. The team has to untangle who counted what before discussing what to do.</p></li>
        <li><h3>The SQL runs and returns rows, but it does not answer the business question.</h3><p>An analyst or AI agent may use a plausible calculation while omitting the agreed cancellation rule or selecting the wrong reporting date. Successful execution does not establish that the query measures what the business intended.</p></li>
        <li><h3>Changing a reporting rule can improve the reported result without improving business performance.</h3><p>Using revised delivery promises can raise the reported on-time rate even when the delivery records are unchanged. Readers need to see that definition change before interpreting the higher rate as better service.</p></li>
      </ul>
    </section>

    <div class="wrap"><ScenarioWalkthrough /></div>

    <section class="section wrap comparison-section" id="existing-workflows" aria-labelledby="comparison-heading">
      <div class="section-heading"><ChapterOrnament section="existing-reporting-practice" /><h2 id="comparison-heading">Build on the work your team already does.</h2><p class="lede">Teams already document definitions, prepare tables and share calculations. Crossfield makes reporting rules available to SQL consumers and validates their use within its supported query contracts.</p></div>
      <p class="table-help" id="comparison-help">Compare each approach with the capability Crossfield adds. On narrow screens, scroll the table horizontally.</p>
      <div class="comparison-scroll" tabindex="0" role="region" aria-label="Comparison with existing reporting practices" aria-describedby="comparison-help">
        <table><caption>Existing practices and what Crossfield adds</caption><thead><tr><th scope="col">What you use today</th><th scope="col">What it already does well</th><th scope="col">What Crossfield adds</th></tr></thead><tbody>
          <tr><th scope="row">Metric documentation</th><td>Explains the intended calculation and business context.</td><td>An executable definition that queries can reuse, with validation of approved operations.</td></tr>
          <tr><th scope="row">Shared SQL, views and prepared tables</th><td>Centralizes data preparation and reusable calculations.</td><td>Explicit metric and dimension contracts, approved combinations, and inspectable semantic intent.</td></tr>
          <tr><th scope="row">Calculations in a BI tool</th><td>Gives reports in that environment a common modeling surface.</td><td>Definitions available through Crossfield’s DuckDB SQL surface, independently of an individual report.</td></tr>
          <tr><th scope="row">Instructions in AI prompts</th><td>Provides context to help an AI agent interpret a question.</td><td>Discoverable definitions and engine checks for supported queries, including optional strict enforcement.</td></tr>
        </tbody></table>
      </div>
      <p class="note">Queries must use Crossfield to receive its validation. This does not automatically change calculations in existing reports or connect every BI tool.</p>
    </section>

    <section class="section wrap" id="composition" aria-labelledby="composition-heading">
      <div class="illustrated-heading">
        <div class="section-heading">
          <ChapterOrnament section="model-composition" />
          <h2 id="composition-heading">Answer broader questions without merging every team’s definitions.</h2>
          <p class="lede">Combine independently computed results through an approved shared dimension. A portfolio team can maintain exposure while a risk team maintains limits, then bring both into one report by issuer. Each team retains ownership of its definitions.</p>
          <p class="note">Crossfield validates the model join; the resulting report compares exposure with limits. It does not block trades.</p>
          <a class="text-link" href={`${crossfieldDocs}/trading#compare-exposure-with-limits`}>See exposure joined to risk limits →</a>
        </div>
        <EditorialArt variant="connected-fields" />
      </div>
    </section>

    <section class="version-section" id="versions" aria-labelledby="versions-heading">
      <div class="wrap section"><ModelRevisions /></div>
    </section>

    <section class="control-section" aria-labelledby="control-heading">
      <div class="wrap section">
        <div class="illustrated-heading"><div class="section-heading"><h2 id="control-heading">Give each team more room to explore, with shared reporting rules.</h2><p class="lede">The people maintaining definitions and the people asking questions have different jobs. A reusable model lets them collaborate without putting every calculation into every report.</p></div><EditorialArt variant="governed-paths" /></div>
        <div class="role-benefits">
          <div><h3>Data teams</h3><p>Maintain and test the definitions in a model. Review proposed changes against the current version before other teams adopt them.</p></div>
          <div><h3>Analysts</h3><p>Choose metrics, supported dimensions and filters. Investigate new questions while retaining the model’s calculation and population rules.</p></div>
          <div><h3>Business users</h3><p>Read reports with explicit meanings. Ask which definition produced a number and whether a definition change explains a difference.</p></div>
          <div><h3>AI engineers</h3><p>Give AI agents discoverable inputs, permitted combinations and actionable errors. Inspect the planned calculation before running a report.</p></div>
        </div>
        <details class="agent-disclosure"><summary>See how an AI agent discovers and uses the model</summary><AgentWorkflow dark /><p class="host-note">An AI agent can still misunderstand the question. Repair must preserve its intended meaning; a rejection does not authorize silently changing the metric or removing a filter. <a class="dark-link" href="/products/crossfield/agents">Follow the recorded discovery and repair session →</a></p></details>
      </div>
    </section>

    <section class="section wrap" id="duckdb-integration" aria-labelledby="patches-heading">
      <div class="split">
        <div><h2 id="patches-heading">The reporting rules are checked inside DuckDB.</h2><p class="lede">Crossfield validates and compiles the semantic request. DuckDB binds, optimizes and executes it in the same connection. Local-table queries need no separate semantic query service.</p><p class="example-copy">Query Farm maintains a matching DuckDB build with additional query-lifecycle hooks. They let Crossfield retain the original request through prepared queries, validate selected implementations during binding, and reject disallowed operations before their callbacks run.</p><p class="note">Models and approval rules stay in the extension. These specialist hooks are maintained independently of upstream acceptance and can support other extensions that need similar lifecycle control. <a href="/products/crossfield/engine">Read why the engine changes are necessary →</a></p></div>
        <CrossfieldDiagram kind="engine" />
      </div>
      <div class="ecosystem-notes">
        <div><h3>Open definitions with Apache Ossie.</h3><p>Crossfield implements a supported profile of <a href="https://ossie.apache.org/">Apache Ossie’s</a> semantic model and expression definitions, with explicit Crossfield approval and execution contracts. This is independent Query Farm work; support is not an Apache endorsement or a claim of complete interchangeability.</p><a class="text-link" href="/products/crossfield/ossie">Read a small model and its SQL →</a></div>
        <div><h3>Delivered as part of Haybarn.</h3><p><a href="/products/haybarn">Haybarn</a>, Query Farm’s DuckDB distribution, will include Crossfield and the engine support it needs. <a href="/vgi">VGI</a> can expose APIs and services as tables and functions; Crossfield adds shared reporting definitions over approved sources.</p><p class="note">These examples use local tables. Provider-backed workloads also need matching connector components.</p><a class="text-link" href={`${crossfieldDocs}/providers`}>Explore model-owned retrieval →</a></div>
      </div>
    </section>

    <section class="faq-section" id="questions" aria-labelledby="questions-heading">
      <div class="wrap section">
        <div class="section-heading"><h2 id="questions-heading">What adopting Crossfield involves.</h2><p class="lede">Start with one reporting requirement and understand the execution boundary before extending it to more users.</p></div>
        <div class="faq-list">
          <details><summary>Do we have to replace dbt or our data pipelines?</summary><p>Your existing preparation workflows can remain. Crossfield models can reference supported tables available to DuckDB. You still author and validate the semantic model and its bindings; this is not an automatic import of every existing dbt or BI definition. <a href={`${crossfieldDocs}/models`}>See model authoring.</a></p></details>
          <details><summary>Where does it run, and which DuckDB build do we need?</summary><p>Haybarn will provide Crossfield together with the matching DuckDB engine. The engine includes the query-lifecycle hooks Crossfield needs to enforce semantic rules during binding and execution. <a href="/products/crossfield/engine">Read why Crossfield is part of Haybarn.</a></p></details>
          <details><summary>Does it decide which business definition is correct?</summary><p>The business owns that decision. Crossfield makes the chosen definitions explicit and reusable, and validates supported queries against them. Source quality, model correctness and the choice of metric still need review. Different populations, filters or source snapshots can legitimately produce different answers.</p></details>
          <details><summary>Can we require AI agents to follow the model?</summary><p>Optional strict mode rejects supported business queries that bypass approved sources or calculations. In an unsealed connection, callers can change the mode. A trusted application can seal a connection to approved model and binding identities. The application still supplies authentication, source permissions and native/process isolation; strict mode is not a catalog access-control system. <a href={`${crossfieldDocs}/compatibility#host-controlled-sessions`}>Read the host-controlled session boundary.</a></p></details>
          <details><summary>Can we use our current BI tools and AI applications?</summary><p>The integration point is the matching DuckDB SQL connection. Clients must support the required build and query surface. These examples do not establish compatibility with every BI product or AI framework. Definitions are not automatically applied to queries that execute elsewhere.</p></details>
          <details><summary>How will Crossfield be available?</summary><p>Crossfield will be included in an upcoming Haybarn release. These guides currently use development builds, so you can evaluate the implemented features before that release. <a href="/company/contact">Contact Query Farm</a> for evaluation access, or read the <a href={`${crossfieldDocs}/compatibility`}>release details and build requirements</a>.</p></details>
        </div>
      </div>
    </section>

    <section class="section wrap" id="evidence" aria-labelledby="evidence-heading">
      <div class="section-heading"><ChapterOrnament section="reporting-evidence" /><h2 id="evidence-heading">Inspect the evidence behind the examples.</h2><p class="lede">Both scenarios include source data, complete model definitions, independently specified answers and actual engine explanations. They are reproducible synthetic demonstrations, not customer case studies or measured productivity claims.</p></div>
      <div class="evidence-links">
        <div><h3>Order fulfillment</h3><p>Inspect the six observed shipments and four eligible orders. Reproduce the original-promise result and compare it with the revised definition.</p><a class="text-link" href={`${crossfieldDocs}/fulfillment`}>Run the fulfillment example →</a><a class="text-link evidence-record" href="/crossfield/examples/fulfillment/verification.txt">Read its native verification record</a></div>
        <div><h3>Investment reporting</h3><p>Inspect the position records, reproduce gross and net exposure, and compare the current scope with the proposed Expansion book.</p><a class="text-link" href={`${crossfieldDocs}/trading`}>Run the investment example →</a><a class="text-link evidence-record" href="/crossfield/examples/finance/verification.txt">Read its native verification record</a></div>
      </div>
      <p class="note">The published verification records identify the executed checks and matching development builds. Each downloadable package includes its own setup instructions and expected results.</p>
    </section>

    <section class="section wrap" aria-labelledby="next-heading">
      <div class="section-heading"><h2 id="next-heading">Start with a report you already need.</h2><p class="lede">Read a model, inspect its SQL, or run a complete example with the matching build. For your own workload, start with one disputed metric and the rules it should follow. Query Farm can help assess the model and execution requirements.</p></div>
      <div class="guide-grid">{guides.map(guide=><a class="guide-link" href={guide.href}><h3>{guide.title}<span aria-hidden="true">↗</span></h3><p>{guide.description}</p></a>)}</div>
      <div class="closing-actions"><Button href={`${crossfieldDocs}/examples`}>Explore the runnable examples</Button><Button variant="secondary" href={`${crossfieldDocs}/models`}>Read the model guide</Button><a class="text-link" href="/company/contact">Request evaluation access</a></div>
    </section>
  </div>
</PageLayout>

<style>
  .crossfield-page { color: var(--color-soil-900); }
  .wrap { width: min(100%,1280px); margin-inline: auto; padding-inline: 1.5rem; }
  .split { display: grid; gap: 2.75rem; align-items: start; }
  .split > * { min-width: 0; }
  .hero { padding-block: 4.5rem; align-items: center; }
  .product-name { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.5rem; color: var(--color-soil-700); font-size: .875rem; font-weight: 500; }
  h1 { font-size: clamp(2.8rem,5.2vw,4.6rem); line-height: 1.06; }
  h1 em { color: var(--color-field-700); font-style: normal; }
  .hero-lede { margin-top: 1.6rem; max-width: 32ch; font-size: 1.35rem; line-height: 1.6; }
  .hero-detail { margin-top: 1.1rem; max-width: 47ch; color: var(--color-soil-700); line-height: 1.8; }
  .product-category { margin-top:1rem; color:var(--color-field-700); font-size:.875rem; font-weight:600; }
  .hero-art { margin: 0; min-width: 0; }
  .hero-art img { display: block; width: 100%; height: auto; border-radius: 50% 50% 2% 2% / 10% 10% 2% 2%; }
  .hero-art figcaption { display: flex; justify-content: center; flex-wrap: wrap; gap: .4rem 1.2rem; font-size: .75rem; color: var(--color-soil-700); padding: 1.1rem .5rem; }
  .hero-art strong { color: var(--color-field-700); font-weight: 600; }
  .illustrated-heading { display: grid; gap: 2rem; align-items: center; margin-bottom: 2.75rem; }
  .illustrated-heading .section-heading { margin-bottom: 0; }
  .illustrated-heading .text-link { display: inline-block; margin-top: 1rem; }
  .illustrated-heading > :global(.editorial-art) { max-width: 640px; }
  @media(min-width:900px) { .illustrated-heading { grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap: 3.5rem; } }
  .actions,.closing-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.8rem; font-size: .8125rem; }
  .availability { margin-top: 1.6rem; max-width: 57ch; color: var(--color-soil-700); font-size: .75rem; line-height: 1.75; }
  .availability a { text-decoration: underline; text-underline-offset: 3px; }
  .status { display: inline-block; margin-right: .4rem; border: 1px solid var(--color-soil-300); border-radius: 2rem; padding: .1rem .55rem; font-weight: 500; }
  .text-link { color: var(--color-link); text-decoration: underline; text-underline-offset: 4px; font-size: .875rem; }
  .chapter-nav { display: grid; gap: .8rem; padding-block: 1.4rem; border-bottom: 1px solid var(--color-soil-300); }
  .chapter-nav a { display: flex; gap: .75rem; align-items: center; color: var(--color-soil-700); font-size: .8125rem; }
  .chapter-nav span { color: var(--color-sun-700); font-family: var(--font-mono); font-size: .6875rem; }
  .chapter-nav a:hover { color: var(--color-field-700); }
  .section { padding-block: 4.75rem; scroll-margin-top: 9rem; }
  h2 { margin-top: 0; font-size: clamp(2rem,3.5vw,3rem); line-height: 1.15; }
  h3 { font-size: 1.3rem; line-height: 1.3; }
  .lede { margin-top: 1.4rem; color: var(--color-soil-700); font-size: 1.1rem; line-height: 1.8; }
  .lede + p { margin-top: 1rem; color: var(--color-soil-700); line-height: 1.8; }
  .section-heading { max-width: 800px; margin-bottom: 2.5rem; }
  .problem-framing { max-width: 960px; margin-bottom: 3.5rem; }
  .problem-framing h2 { max-width: 27ch; }
  .problem-framing > p { max-width: 78ch; }
  .problem-framing > p:not(.lede) { margin-top: 1rem; color: var(--color-soil-700); line-height: 1.8; }
  .example-copy { margin-block: 1rem; color: var(--color-soil-700); font-size: .9375rem; line-height: 1.8; }
