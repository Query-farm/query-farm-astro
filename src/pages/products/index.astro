---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { extensions } from '../../data/extensions';
import { services } from '../../data/services';

// Count extensions by status
const stableCount = extensions.filter(e => e.status === 'stable').length;
const betaCount = extensions.filter(e => e.status === 'beta').length;
const experimentalCount = extensions.filter(e => e.status === 'experimental').length;
---

<PageLayout
  title="Products"
  description="DuckDB extensions, data orchestration services, and ecosystem tools for modern data infrastructure."
>
  <!-- Hero Section -->
  <Hero
    title="Products for Modern Data Infrastructure"
    subtitle="From DuckDB extensions to managed services, everything you need to build production-ready data pipelines."
    primaryCTA={{ text: "Browse Extensions", href: "/products/extensions" }}
    secondaryCTA={{ text: "Schedule Demo", href: "/company/schedule" }}
  />

  <!-- Product Overview Cards -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Our Products"
        title="Built for Production Data Workloads"
        description="Choose from open-source extensions, managed services, or custom development to fit your needs."
        class="mb-16"
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Extensions Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-harvest-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
              🔌
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-3">
              DuckDB Extensions
            </h3>

            <p class="text-soil-700 leading-relaxed mb-6">
              {extensions.length}+ specialized extensions for data connectors, transformations, analytics, and more. All open-source and production-ready.
            </p>

            <div class="flex items-center gap-4 mb-6 text-sm">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-harvest-500"></span>
                <span class="text-soil-600">{stableCount} Stable</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-grain-500"></span>
                <span class="text-soil-600">{betaCount} Beta</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-duck-500"></span>
                <span class="text-soil-600">{experimentalCount} Experimental</span>
              </div>
            </div>

            <div class="space-y-3 mb-8">
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">Data connectors (PostgreSQL, MySQL, S3, Kafka)</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">Transformation tools (JSON, geospatial, time series)</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">Analytics & ML (forecasting, graph algorithms)</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">Performance optimization & developer tools</span>
              </div>
            </div>

            <Button href="/products/extensions" variant="primary" size="md" fullWidth>
              Browse All Extensions
            </Button>
          </div>
        </Card>

        <!-- Services Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-grain-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-grain-100 flex items-center justify-center text-4xl">
              ☁️
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-3">
              Managed Services
            </h3>

            <p class="text-soil-700 leading-relaxed mb-6">
              Production-grade data orchestration and deployment platforms. Focus on your data, not infrastructure.
            </p>

            <div class="space-y-4 mb-8">
              <div class="p-4 bg-soil-50 rounded-lg">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">✈️</span>
                  <h4 class="font-semibold text-soil-900">Flightplan</h4>
                </div>
                <p class="text-sm text-soil-700">
                  Data orchestration platform for DuckDB. Deploy, schedule, and monitor your data pipelines.
                </p>
              </div>

              <div class="p-4 bg-soil-50 rounded-lg">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">🛬</span>
                  <h4 class="font-semibold text-soil-900">Airport as a Service</h4>
                </div>
                <p class="text-sm text-soil-700">
                  Managed DuckDB deployment platform. Instant databases with automatic scaling and backups.
                </p>
              </div>
            </div>

            <Button href="/products/services" variant="primary" size="md" fullWidth>
              Explore Services
            </Button>
          </div>
        </Card>

        <!-- Ecosystem Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-duck-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-duck-100 flex items-center justify-center text-4xl">
              🛠️
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-3">
              Ecosystem & Tools
            </h3>

            <p class="text-soil-700 leading-relaxed mb-6">
              Open-source libraries, Python packages, reports, and community resources for the DuckDB ecosystem.
            </p>

            <div class="space-y-3 mb-8">
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-duck-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">Python modules for data engineering</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-duck-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">DuckDB usage reports and benchmarks</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-duck-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">CLI tools and utilities</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-duck-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-soil-700">GitHub repositories and examples</span>
              </div>
            </div>

            <Button href="/products/ecosystem" variant="primary" size="md" fullWidth>
              View Ecosystem
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="By the Numbers"
        title="Trusted by Data Teams"
        class="mb-12"
      />

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-5xl font-bold text-harvest-600 mb-3">{extensions.length}+</div>
          <div class="text-soil-700 font-medium">Extensions</div>
          <div class="text-sm text-soil-500 mt-1">Production ready</div>
        </div>

        <div class="text-center">
          <div class="text-5xl font-bold text-harvest-600 mb-3">100%</div>
          <div class="text-soil-700 font-medium">Open Source</div>
          <div class="text-sm text-soil-500 mt-1">MIT Licensed</div>
        </div>

        <div class="text-center">
          <div class="text-5xl font-bold text-harvest-600 mb-3">24/7</div>
          <div class="text-soil-700 font-medium">Support</div>
          <div class="text-sm text-soil-500 mt-1">Enterprise plans</div>
        </div>

        <div class="text-center">
          <div class="text-5xl font-bold text-harvest-600 mb-3">6</div>
          <div class="text-soil-700 font-medium">Categories</div>
          <div class="text-sm text-soil-500 mt-1">Specialized tools</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Comparison -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Choose Your Path"
        title="From Open Source to Enterprise"
        description="Start with free extensions and scale up to managed services as your needs grow."
        class="mb-12"
      />

      <div class="max-w-5xl mx-auto">
        <Card padding="none" class="overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-soil-50 border-b border-soil-200">
                <tr>
                  <th class="px-6 py-4 text-left text-sm font-semibold text-soil-900">Feature</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-soil-900">Extensions</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-soil-900">Services</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-soil-900">Consulting</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-soil-200">
                <tr>
                  <td class="px-6 py-4 text-sm text-soil-700">Installation & Setup</td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm text-soil-700">Managed Infrastructure</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm text-soil-700">Custom Development</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm text-soil-700">24/7 Support</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-xs text-soil-500">Community</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm text-soil-700">SLA Guarantee</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-100 text-harvest-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Ready to Get Started?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Choose the products that fit your needs, or schedule a consultation to discuss custom solutions.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/extensions" variant="secondary" size="lg">
          Browse Extensions
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule Demo
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
