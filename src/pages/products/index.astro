---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { extensions, publicExtensions } from '../../data/extensions';
import { usageSummary } from '../../data/usage-summary';

const extensionCount = publicExtensions.length;
const stableCount = extensions.filter(e => e.status === 'stable').length;
const betaCount = extensions.filter(e => e.status === 'beta').length;
const experimentalCount = extensions.filter(e => e.status === 'experimental').length;

const extensionLoads = usageSummary?.annualizedLoads;
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};

// The data farm: each component does one job; together they form a platform for
// querying scattered data with SQL. Cards carry their own detail (no hover-only
// reveal) so the products page reads as a full catalog.
const platformComponents = [
  {
    icon: 'plug',
    title: 'Extensions',
    eyebrow: `${extensionCount} installable capabilities`,
    outcome: 'Connect systems and add SQL capabilities.',
    description: 'Install connectors, transformations, sketches, scripting, geospatial, JSON, text, and operational tools without building native extension plumbing yourself.',
    href: '/products/extensions',
    cta: 'Browse extensions',
    color: 'bg-earth-100 text-earth-800',
    status: 'available',
  },
  {
    icon: 'gateway',
    title: 'VGI',
    eyebrow: 'Vector Gateway Interface',
    outcome: 'Run custom or reusable workers from SQL.',
    description: 'Make APIs, services, models, and business logic available as SQL-accessible tables and functions through Apache Arrow–based workers — in Python, TypeScript, Go, Rust, Java, or C++.',
    href: '/vgi',
    cta: 'Learn about VGI',
    color: 'bg-duck-100 text-duck-800',
    status: 'available',
  },
  {
    icon: 'shield',
    title: 'Haybarn',
    eyebrow: 'Independent distribution',
    outcome: 'Package and ship the platform safely.',
    description: 'A compatible DuckDB distribution with signed builds, curated extension defaults, build provenance, and enterprise-friendly npm / PyPI distribution.',
    href: '/haybarn',
    cta: 'Explore Haybarn',
    color: 'bg-harvest-100 text-harvest-800',
    status: 'available',
  },
  {
    icon: 'dashboard',
    title: 'Cupola',
    eyebrow: 'Web frontend for VGI',
    outcome: 'Give teams a place to browse and operate workers.',
    description: 'A web surface for VGI-powered data access: discover connectors, configure workers, and make the platform usable beyond the shell.',
    color: 'bg-sky-100 text-sky-800',
    status: 'development',
  },
  {
    icon: 'orchard',
    title: 'The Orchard',
    eyebrow: 'Connector interface',
    outcome: 'Discover and reuse data components.',
    description: 'The connector interface for Query.Farm: a place for teams to find, configure, and reuse the data connections that make up their platform.',
    color: 'bg-emerald-100 text-emerald-800',
    status: 'development',
  },
];
---

<PageLayout
  title="Products"
  description="The Query.Farm data platform: a catalog of DuckDB extensions, the Vector Gateway Interface (VGI), the Haybarn distribution, and the components that connect them — query scattered data with SQL."
>
  <!-- Hero Section -->
  <Hero
    title="The Query.Farm platform"
    subtitle="A real farm is not one tool — it's fields, barns, orchards, paths, and storage working toward one outcome. Query.Farm works the same way for data access: each component does a job, and together they let teams query scattered data with SQL."
  />

  <!-- The Data Farm: platform components -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="The data farm"
        title="A platform of components that work together"
        description="Each component below does one job — connect, run, package, browse, or reuse. Mix the ones you need today; the rest are ready when you grow into them."
        class="mb-12"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {platformComponents.map((pillar) => (
          <div class="group relative flex flex-col rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-start justify-between gap-3">
              <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl ${pillar.color}`}>
                {pillar.icon === 'plug' && (
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3M16 7V3M7 7h10v4a5 5 0 01-10 0V7zM12 16v5" />
                  </svg>
                )}
                {pillar.icon === 'gateway' && (
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6h5v5H5zM14 13h5v5h-5zM14 6h5M5 18h5M10 8.5h4M12 11v2" />
                  </svg>
                )}
                {pillar.icon === 'dashboard' && (
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16v12H4zM8 10h3M8 14h8M15 10h1" />
                  </svg>
                )}
                {pillar.icon === 'shield' && (
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3l7 3v5c0 4.5-2.8 8.2-7 10-4.2-1.8-7-5.5-7-10V6l7-3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-5" />
                  </svg>
                )}
                {pillar.icon === 'orchard' && (
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 20v-7M8 20h8M12 13c-3 0-5-1.7-5-4.2C7 6.2 9.2 5 12 7.2 14.8 5 17 6.2 17 8.8 17 11.3 15 13 12 13z" />
                  </svg>
                )}
              </div>
              {pillar.status === 'available' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-harvest-300 bg-harvest-50 px-3 py-1 text-xs font-bold text-harvest-800">
                  <span class="h-2 w-2 rounded-full bg-harvest-500"></span>
                  Available
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-soil-300 bg-soil-100 px-3 py-1 text-xs font-bold text-soil-500">
                  <span class="h-2 w-2 rounded-full bg-soil-400"></span>
                  In development
                </span>
              )}
            </div>

            <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-emerald-700">{pillar.eyebrow}</p>
            <h3 class="mt-1 text-2xl font-bold text-soil-900">{pillar.title}</h3>
            <p class="mt-2 text-sm font-semibold leading-snug text-soil-800">{pillar.outcome}</p>
            <p class="mt-3 text-sm leading-relaxed text-soil-600">{pillar.description}</p>

            <div class="mt-auto pt-5">
              {pillar.href ? (
                <a href={pillar.href} class="inline-flex items-center gap-1 text-sm font-bold text-harvest-700 hover:text-harvest-800">
                  {pillar.cta} →
                </a>
              ) : (
                <span class="text-sm font-semibold text-soil-400">Coming soon</span>
              )}
            </div>
          </div>
        ))}

        <!-- "All together" closer tile -->
        <div class="flex flex-col justify-center rounded-2xl border-2 border-soil-900 bg-soil-900 p-6 text-center shadow-xl">
          <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">All together</p>
          <h3 class="mt-2 text-xl font-bold text-white">One data platform</h3>
          <p class="mx-auto mt-2 text-sm leading-relaxed text-soil-200">
            These components work as one platform for building, operating, and reusing SQL-accessible connections — adopt them piece by piece.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Available today: detailed cards -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Available today"
        title="Ship with what's ready now"
        description="Three production-ready components you can adopt immediately — independently or together."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        <!-- Extensions Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-harvest-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
              🔌
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-3">DuckDB Extensions</h3>

            <p class="text-soil-700 leading-relaxed mb-6">
              {extensionCount}+ specialized extensions for connectors, transformations, sketches, scripting, and more. All open-source and production-ready.
            </p>

            <div class="flex items-center gap-4 mb-6 text-sm">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-harvest-500"></span>
                <span class="text-soil-600">{stableCount} Stable</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-grain-500"></span>
                <span class="text-soil-600">{betaCount} Beta</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-duck-500"></span>
                <span class="text-soil-600">{experimentalCount} Experimental</span>
              </div>
            </div>

            {extensionLoads && (
              <div class="mb-6 rounded-lg border border-harvest-200 bg-harvest-50 px-4 py-3">
                <span class="text-xl font-extrabold text-harvest-700">{compactCount(extensionLoads)}+</span>
                <span class="ml-1 text-sm text-soil-600">extension loads per year</span>
              </div>
            )}

            <Button href="/products/extensions" variant="primary" size="md" fullWidth>
              Browse All Extensions
            </Button>
          </div>
        </Card>

        <!-- VGI Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-grain-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-grain-100 flex items-center justify-center text-4xl">
              🌐
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-1">VGI</h3>
            <p class="text-sm text-soil-500 mb-4">Vector Gateway Interface</p>

            <p class="text-soil-700 leading-relaxed mb-6">
              Extend DuckDB with functionality in Python, TypeScript, Go, Rust, Java, or C++. Apache Arrow is the cross-language glue — no FFI, no rebuilds, no version locking.
            </p>

            <div class="space-y-2 mb-6 text-sm text-soil-700">
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-grain-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>DuckDB-side extension + Python function framework</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-grain-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>SDKs for Python, TypeScript, Go, Rust, Java, C++</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-grain-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Apache Arrow IPC over pipes, sockets, or HTTP</span>
              </div>
            </div>

            <Button href="/vgi" variant="primary" size="md" fullWidth>
              Explore VGI
            </Button>
          </div>
        </Card>

        <!-- Haybarn Card -->
        <Card padding="lg" class="relative overflow-hidden group hover:shadow-xl transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-earth-100 rounded-full -mr-16 -mt-16 opacity-50 group-hover:scale-110 transition-transform"></div>

          <div class="relative z-10">
            <div class="w-16 h-16 mb-6 rounded-xl bg-earth-100 flex items-center justify-center overflow-hidden">
              <img src="/haybarn/haybarn-logo.png" alt="" class="w-12 h-12 object-contain" width="48" height="48" />
            </div>

            <h3 class="text-2xl font-bold text-soil-900 mb-1">Haybarn</h3>
            <p class="text-sm text-soil-500 mb-4">An independent distribution of DuckDB</p>

            <p class="text-soil-700 leading-relaxed mb-6">
              The DuckDB source, rebuilt as branded binaries with an independent release cadence and a signed extension ecosystem. ABI- and file-format-compatible with upstream DuckDB.
            </p>

            <div class="space-y-2 mb-6 text-sm text-soil-700">
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Independent release cadence and versioning</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Signed extensions, SLSA build provenance</span>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Install via npx, uvx, pip, or direct download</span>
              </div>
            </div>

            <Button href="/haybarn" variant="primary" size="md" fullWidth>
              Learn About Haybarn
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Need something custom?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        We build DuckDB extensions for clients who need specific functionality — from connectors to compute engines.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">
          Consulting & Custom Extensions
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
