---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { usageSummary } from '../../data/usage-summary';
import { platformComponents } from '../../data/products';
import PlatformMap from '../../components/products/PlatformMap.astro';
import MobileProductPath from '../../components/products/MobileProductPath.astro';

const extensionLoads = usageSummary?.annualizedLoads;
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';

// The data farm: each component does one job; together they form a platform for
// querying scattered data with SQL. Cards carry their own detail (no hover-only
// reveal) so the products page reads as a full catalog. Data lives in
// src/data/products.ts, shared with Header.astro's "Products" nav dropdown.

// The detailed feature bullets, presented once — the old page repeated the
// Extensions / VGI / Haybarn cards a second time with near-identical copy.
const availableToday = [
  {
    title: 'DuckDB Extensions',
    subtitle: 'Installable SQL capabilities',
    body: 'Specialized extensions for connectors, transformations, sketches, scripting, and more.',
    points: [
      'Connectors, transformations, sketches, and scripting',
      'All open source',
      'Production-ready today',
    ],
    href: '/products/extensions',
    cta: 'Browse all extensions',
  },
  {
    title: 'VGI',
    subtitle: 'Vector Gateway Interface',
    body: 'Extend DuckDB with functionality in Python, TypeScript, Go, Rust, or Java. Apache Arrow is the cross-language glue — no FFI, no rebuilds, no version locking.',
    points: [
      'DuckDB-side extension + Python function framework',
      'SDKs for Python, TypeScript, Go, Rust, and Java',
      'Apache Arrow IPC over pipes, sockets, or HTTP',
    ],
    href: '/vgi',
    cta: 'Explore VGI',
  },
  {
    title: 'Haybarn',
    subtitle: 'An independent distribution of DuckDB',
    body: 'The DuckDB source, rebuilt as branded binaries with an independent release cadence and a signed extension ecosystem. ABI- and file-format-compatible with upstream DuckDB.',
    points: [
      'Independent release cadence and versioning',
      'Signed extensions, SLSA build provenance',
      'Install via npx, uvx, pip, or direct download',
    ],
    href: '/haybarn',
    cta: 'Learn about Haybarn',
  },
];
---

<PageLayout
  title="Products"
  description="The Query.Farm platform connects people, agents, and query engines to APIs, services, data, models, and code through extensions and the Vector Gateway Interface."
  ogImage="/og/products.jpg"
>
  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="The data farm"
    title="The Query.Farm platform"
    ledeClass="mt-3.5 max-w-[62ch] text-[17.5px] leading-relaxed text-soil-700"
    hairband
    lede="A real farm is not one tool — it's fields, barns, orchards, paths, and storage working toward one outcome. Query.Farm works the same way for data access: each component does a job, and together they let teams query scattered data with SQL."
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/products/extensions" variant="primary" size="md">Browse extensions</Button>
      <Button href="/company/schedule" variant="secondary" size="md">Talk with us</Button>
    </div>
  </PageHead>

  <!-- ── How the pieces are organized ────────────────────────── -->
  <section id="product-path" class="scroll-mt-20 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <span class={EYEBROW}>The product map</span>
          <h2 class="mt-3 text-3xl text-soil-900 md:text-4xl">One system, from question to capability</h2>
          <p class={`mt-3 max-w-[72ch] ${LEDE}`}>
            <span class="lg:hidden">Follow the six steps from the question someone asks to the data or compute that answers it. Product status is shown at the point where each component fits.</span>
            <span class="hidden lg:inline">Read the map from top to bottom. People and agents ask questions through the tools they already use; query engines plan the work; extensions and VGI add capability; optional policy controls what may be seen; and workers reach the data or compute that answers. DuckDB works today, while VGI opens the path to more query engines over time.</span>
          </p>
        </div>
        <Button href="/vision" variant="secondary" size="md" class="hidden shrink-0 lg:inline-flex">Take the guided tour</Button>
      </div>

      <div class="mt-8 lg:hidden">
        <MobileProductPath variant="full" />

        <details class="group mt-7 rounded-xl border border-soil-300 bg-[#fffdf7]">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-soil-900 marker:hidden">
            <span>View the complete architecture diagram</span>
            <span class="text-field-700 transition-transform group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">＋</span>
          </summary>
          <div class="border-t border-soil-300 p-3">
            <p class="mb-3 text-xs leading-relaxed text-soil-600">Swipe horizontally to inspect the original desktop diagram.</p>
            <PlatformMap />
          </div>
        </details>
      </div>

      <div class="mt-8 hidden lg:block">
        <PlatformMap />
      </div>
    </div>
  </section>

  <!-- ── The platform components ─────────────────────────────── -->
  <section class="border-t border-soil-200 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>The data farm</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">The components, one by one</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Each component does one job — connect, run, govern, package, browse, or reuse. Mix the
        ones you need today; the rest are ready when you grow into them.
      </p>

      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {platformComponents.map((pillar) => (
          <div class={`${CARD} flex flex-col p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <div class="flex items-start justify-between gap-3">
              <span class="flex h-12 w-12 flex-none items-center justify-center overflow-hidden rounded-[10px] border border-soil-300 bg-soil-100 text-[22px]">
                {pillar.img && <img src={pillar.img} alt="" width="28" height="28" class="h-7 w-7 object-contain" />}
                {pillar.emoji && <span aria-hidden="true">{pillar.emoji}</span>}
              </span>
              {pillar.status === 'available' ? (
                <span class="inline-block rounded-full border border-field-600/45 bg-field-600/10 px-2.5 py-0.5 text-[12.5px] font-medium text-field-700">Available</span>
              ) : pillar.status === 'preview' ? (
                <span class="inline-block rounded-full border border-sun-400 bg-sun-400/12 px-2.5 py-0.5 text-[12.5px] font-medium text-sun-700">Preview</span>
              ) : (
                <span class="inline-block rounded-full border border-soil-300 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-700">In development</span>
              )}
            </div>

            <p class="mt-5 text-[12.5px] font-medium text-soil-500">{pillar.eyebrow}</p>
            <h3 class="mt-1.5 text-xl text-soil-900">{pillar.title}</h3>
            <p class="mt-2 text-sm font-medium leading-snug text-soil-900">{pillar.outcome}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{pillar.description}</p>

            <div class="mt-auto pt-5">
              <a href={pillar.href} class="text-sm text-link no-underline hover:underline">{pillar.cta} →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: the components as a single platform ─ -->
  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">All together</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">One data platform</h2>
      <p class="mt-3 max-w-[62ch] text-[17.5px] leading-relaxed text-cream-2">
        These components work as one platform for building, operating, and reusing
        SQL-accessible connections — adopt them piece by piece. Extensions add capability,
        VGI runs the workers, Rowfence governs who sees what, the Orchard shares them, Haybarn
        ships the engine, and Cupola is where you sit down and query.
      </p>

      {extensionLoads && (
        <div class="mt-8 inline-block rounded-xl border border-white/15 px-7 py-6">
          <div class="qf-figure text-[44px] leading-none text-sun-400">{compactCount(extensionLoads)}+</div>
          <div class="mt-2.5 text-[12.5px] font-medium text-cream-2">Extension loads per year</div>
        </div>
      )}

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/products/extensions" variant="accent" size="md" onDark>Browse extensions</Button>
        <Button href="/vgi" variant="ghost" size="md" onDark>Start with VGI</Button>
      </div>
    </div>
  </section>

  <!-- ── Available today ─────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Available today</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Ship with what's ready now</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Three production-ready components you can adopt immediately — independently or together.
      </p>

      <div class={`${CARD} mt-8 grid overflow-hidden md:grid-cols-3`}>
        {availableToday.map((item, i) => (
          <div class:list={[
            'flex flex-col px-6 py-7',
            i < availableToday.length - 1 && 'border-b border-soil-200 md:border-b-0 md:border-r md:border-soil-200',
          ]}>
            <h3 class="text-xl text-soil-900">{item.title}</h3>
            <p class="mt-1 text-[12.5px] font-medium text-soil-500">{item.subtitle}</p>
            <p class="mt-3 text-sm leading-relaxed text-soil-700">{item.body}</p>
            <ul class="mt-4 flex flex-col gap-2">
              {item.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-soil-700">
                  <span class="mt-[3px] flex-none text-field-700" aria-hidden="true">✓</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-5">
              <a href={item.href} class="text-sm text-link no-underline hover:underline">{item.cta} →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">Need something custom?</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            We build DuckDB extensions for clients who need specific functionality — from
            connectors to compute engines.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting &amp; custom extensions</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
