---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import ServiceCard from '../../components/products/ServiceCard.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { services } from '../../data/services';

const flightplan = services.find(s => s.id === 'flightplan');
const airport = services.find(s => s.id === 'airport');
---

<PageLayout
  title="Services | Query.Farm"
  description="Enterprise-grade data infrastructure services: Flightplan orchestration platform and Airport managed DuckDB hosting."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Services', href: '/products/services' }
  ]}
>
  <!-- Hero Section -->
  <Hero
    title="Enterprise Data Services"
    subtitle="Production-ready DuckDB infrastructure and orchestration. Deploy, manage, and scale your data workloads with confidence."
    primaryCTA={{ text: 'Schedule a Demo', href: '/company/schedule' }}
    secondaryCTA={{ text: 'Contact Sales', href: '/company/contact' }}
  />

  <!-- Services Overview -->
  <section class="section-container py-16 lg:py-24">
    <div class="max-w-6xl mx-auto">
      <SectionHeader
        eyebrow="Our Services"
        title="Choose Your Data Infrastructure Path"
        description="Whether you need orchestration, hosting, or both - we've got you covered."
        align="center"
      />

      <!-- Service Cards Grid -->
      <div class="grid lg:grid-cols-2 gap-8 mb-16">
        {flightplan && (
          <ServiceCard
            name={flightplan.name}
            tagline={flightplan.tagline}
            description={flightplan.description}
            features={flightplan.features}
            benefits={flightplan.benefits}
            useCases={flightplan.useCases}
            icon={flightplan.icon}
            variant="featured"
          />
        )}

        {airport && (
          <ServiceCard
            name={airport.name}
            tagline={airport.tagline}
            description={airport.description}
            features={airport.features}
            benefits={airport.benefits}
            useCases={airport.useCases}
            icon={airport.icon}
            variant="default"
          />
        )}
      </div>

      <!-- Why Choose Query.Farm Services -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-soil-900 mb-8 text-center">Why Choose Query.Farm Services?</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <Card padding="lg">
            <div class="flex items-start gap-3 mb-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-earth-100 flex items-center justify-center">
                <svg class="w-6 h-6 text-earth-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-soil-900 mb-2">Expert Team</h3>
                <p class="text-sm text-soil-700 leading-relaxed">
                  Our team has deep expertise in DuckDB, data engineering, and cloud infrastructure. We've built, deployed, and scaled data systems for organizations of all sizes.
                </p>
              </div>
            </div>
          </Card>

          <Card padding="lg">
            <div class="flex items-start gap-3 mb-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-harvest-100 flex items-center justify-center">
                <svg class="w-6 h-6 text-harvest-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-soil-900 mb-2">Enterprise Security</h3>
                <p class="text-sm text-soil-700 leading-relaxed">
                  Security-first architecture with encryption at rest and in transit, role-based access control, audit logging, and compliance certifications (SOC 2, GDPR, HIPAA).
                </p>
              </div>
            </div>
          </Card>

          <Card padding="lg">
            <div class="flex items-start gap-3 mb-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-grain-100 flex items-center justify-center">
                <svg class="w-6 h-6 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-soil-900 mb-2">99.9% Uptime SLA</h3>
                <p class="text-sm text-soil-700 leading-relaxed">
                  Production-grade reliability with automatic failover, continuous monitoring, and 24/7 support. We guarantee your data infrastructure stays running when you need it most.
                </p>
              </div>
            </div>
          </Card>
        </div>
      </div>

      <!-- Comparison Table -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-soil-900 mb-8 text-center">Service Comparison</h2>
        <Card padding="none" class="overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-soil-50 border-b-2 border-soil-200">
                  <th class="px-6 py-4 text-left text-sm font-semibold text-soil-900">Feature</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-soil-900">
                    <div class="flex items-center justify-center gap-2">
                      <span class="text-2xl">✈️</span>
                      <span>Flightplan</span>
                    </div>
                  </th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-soil-900">
                    <div class="flex items-center justify-center gap-2">
                      <span class="text-2xl">🛬</span>
                      <span>Airport</span>
                    </div>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-soil-200">
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Data Orchestration</td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-sm text-soil-400">—</span>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Managed DuckDB Hosting</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-sm text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Visual Workflow Designer</td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-sm text-soil-400">—</span>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Automatic Backups</td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-sm text-soil-400">—</span>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Multi-System Integration</td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="text-sm text-soil-400">—</span>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">Performance Optimization</td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
                <tr class="hover:bg-soil-50 transition-colors">
                  <td class="px-6 py-4 text-sm text-soil-700">24/7 Expert Support</td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <svg class="w-5 h-5 text-earth-600 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </Card>
      </div>

      <!-- CTA Section -->
      <Card variant="featured" padding="lg" class="text-center">
        <h2 class="text-3xl font-bold text-soil-900 mb-4">Ready to Transform Your Data Infrastructure?</h2>
        <p class="text-lg text-soil-700 mb-8 max-w-2xl mx-auto">
          Schedule a personalized demo to see how Flightplan and Airport can streamline your data operations and reduce costs.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/company/schedule" variant="accent" size="lg">
            Schedule a Demo
          </Button>
          <Button href="/company/contact" variant="secondary" size="lg">
            Contact Sales
          </Button>
          <Button href="/products" variant="ghost" size="lg">
            Explore All Products
          </Button>
        </div>
      </Card>
    </div>
  </section>
</PageLayout>
