---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';

const pythonPackages = [
  {
    name: 'duckdb-farm',
    description: 'Official Python SDK for Query.Farm extensions. Install, manage, and use extensions with a Pythonic API.',
    pypi: 'https://pypi.org/project/duckdb-farm/',
    github: 'https://github.com/queryfarm/duckdb-farm-python',
    stars: '1.2k',
    downloads: '50k/mo',
    features: [
      'Extension management',
      'Connection pooling',
      'Type hints and autocomplete',
      'Async/await support'
    ]
  },
  {
    name: 'farm-analytics',
    description: 'High-level analytics library built on DuckDB. Pandas-like API with DuckDB performance.',
    pypi: 'https://pypi.org/project/farm-analytics/',
    github: 'https://github.com/queryfarm/farm-analytics',
    stars: '850',
    downloads: '25k/mo',
    features: [
      'DataFrame API',
      'Built-in visualizations',
      'Time series analysis',
      'Statistical functions'
    ]
  },
  {
    name: 'farm-ml',
    description: 'Machine learning utilities for DuckDB. Train and deploy ML models directly in SQL.',
    pypi: 'https://pypi.org/project/farm-ml/',
    github: 'https://github.com/queryfarm/farm-ml',
    stars: '620',
    downloads: '15k/mo',
    features: [
      'Model training in SQL',
      'Feature engineering',
      'Model versioning',
      'Batch predictions'
    ]
  }
];

const reports = [
  {
    title: 'DuckDB Extension Benchmark Report 2025',
    date: '2025-01-15',
    description: 'Comprehensive performance benchmarks of all Query.Farm extensions across different workloads and data sizes.',
    downloadUrl: '/reports/extension-benchmarks-2025.pdf',
    type: 'Research',
    pages: 45
  },
  {
    title: 'State of DuckDB Extensions',
    date: '2024-12-01',
    description: 'Annual report on DuckDB extension ecosystem growth, adoption trends, and community insights.',
    downloadUrl: '/reports/state-of-extensions-2024.pdf',
    type: 'Industry Report',
    pages: 32
  },
  {
    title: 'Query.Farm Security Audit',
    date: '2024-11-15',
    description: 'Third-party security audit results for all Query.Farm extensions and infrastructure.',
    downloadUrl: '/reports/security-audit-2024.pdf',
    type: 'Security',
    pages: 28
  }
];

const tools = [
  {
    name: 'Farm CLI',
    description: 'Command-line tool for managing DuckDB extensions, databases, and workflows.',
    icon: '⚡',
    github: 'https://github.com/queryfarm/farm-cli',
    docs: 'https://docs.query.farm/tools/cli'
  },
  {
    name: 'Extension Builder',
    description: 'Scaffold and build custom DuckDB extensions with best practices baked in.',
    icon: '🛠️',
    github: 'https://github.com/queryfarm/extension-builder',
    docs: 'https://docs.query.farm/tools/builder'
  },
  {
    name: 'Query Optimizer',
    description: 'Analyze and optimize your DuckDB queries for maximum performance.',
    icon: '🔍',
    github: 'https://github.com/queryfarm/query-optimizer',
    docs: 'https://docs.query.farm/tools/optimizer'
  },
  {
    name: 'Data Inspector',
    description: 'Visual data profiling and quality assessment tool for DuckDB tables.',
    icon: '📊',
    github: 'https://github.com/queryfarm/data-inspector',
    docs: 'https://docs.query.farm/tools/inspector'
  }
];

const community = [
  {
    name: 'Discord Community',
    description: 'Join 5,000+ developers discussing DuckDB, extensions, and data engineering.',
    icon: '💬',
    link: 'https://discord.gg/queryfarm',
    members: '5.2k'
  },
  {
    name: 'GitHub Discussions',
    description: 'Q&A, feature requests, and community-driven development.',
    icon: '🐙',
    link: 'https://github.com/queryfarm/discussions',
    members: '3.1k'
  },
  {
    name: 'Monthly Newsletter',
    description: 'Extension updates, best practices, and community highlights.',
    icon: '📧',
    link: '/company/newsletter',
    members: '12k'
  },
  {
    name: 'Developer Blog',
    description: 'Deep dives, tutorials, and technical insights from our team.',
    icon: '✍️',
    link: '/blog',
    members: '8k'
  }
];
---

<PageLayout
  title="Ecosystem"
  description="Explore the Query.Farm ecosystem of Python packages, tools, reports, and community resources."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Ecosystem', href: '/products/ecosystem' }
  ]}
>
  <!-- Hero Section -->
  <Hero
    title="Query.Farm Ecosystem"
    subtitle="Beyond extensions. Discover our Python packages, developer tools, research reports, and vibrant community."
    primaryCTA={{ text: "View on GitHub", href: "https://github.com/queryfarm" }}
    secondaryCTA={{ text: "Join Discord", href: "https://discord.gg/queryfarm" }}
  />

  <!-- Python Packages Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Python Ecosystem"
        title="Official Python Packages"
        description="Use Query.Farm extensions and tools from Python with our official SDK and libraries."
        align="center"
        class="mb-12"
      />

      <div class="space-y-8 max-w-5xl mx-auto">
        {pythonPackages.map((pkg) => (
          <Card padding="lg" class="hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-2xl font-bold text-soil-900 font-mono mb-2">{pkg.name}</h3>
                <p class="text-soil-700 leading-relaxed">
                  {pkg.description}
                </p>
              </div>
              <div class="flex gap-4 text-sm text-soil-600">
                <div class="text-center">
                  <div class="font-bold text-harvest-600">⭐ {pkg.stars}</div>
                  <div class="text-xs">stars</div>
                </div>
                <div class="text-center">
                  <div class="font-bold text-harvest-600">📦 {pkg.downloads}</div>
                  <div class="text-xs">downloads</div>
                </div>
              </div>
            </div>

            <div class="mb-4">
              <h4 class="text-sm font-semibold text-soil-700 mb-3">Key Features</h4>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                {pkg.features.map((feature) => (
                  <li class="flex items-start text-sm text-soil-600">
                    <svg class="w-4 h-4 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-soil-200">
              <Button href={pkg.pypi} variant="primary" size="sm" external>
                View on PyPI
              </Button>
              <Button href={pkg.github} variant="ghost" size="sm" external>
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                GitHub
              </Button>
            </div>
          </Card>
        ))}
      </div>

      <div class="mt-12 text-center">
        <Card padding="lg" class="max-w-2xl mx-auto bg-soil-50">
          <h4 class="text-lg font-bold text-soil-900 mb-2">Quick Install</h4>
          <pre class="bg-soil-900 text-soil-50 p-4 rounded-lg text-sm overflow-x-auto"><code>pip install duckdb-farm farm-analytics farm-ml</code></pre>
        </Card>
      </div>
    </div>
  </section>

  <!-- Developer Tools Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Developer Tools"
        title="Command-Line Tools & Utilities"
        description="Powerful CLI tools to streamline your DuckDB development workflow."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {tools.map((tool) => (
          <Card padding="lg" class="hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-earth-100 flex items-center justify-center text-3xl">
                {tool.icon}
              </div>
              <div>
                <h3 class="text-xl font-bold text-soil-900 mb-2">{tool.name}</h3>
                <p class="text-sm text-soil-700 leading-relaxed">
                  {tool.description}
                </p>
              </div>
            </div>
            <div class="flex items-center gap-3 pt-3 border-t border-soil-200">
              <a
                href={tool.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
              >
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                GitHub
              </a>
              <a
                href={tool.docs}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
              >
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                Documentation
              </a>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Reports & Research Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Research & Insights"
        title="Reports & Whitepapers"
        description="In-depth analysis, benchmarks, and research from the Query.Farm team."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {reports.map((report) => (
          <Card padding="lg" class="hover:shadow-lg transition-shadow flex flex-col">
            <div class="flex items-start justify-between mb-3">
              <Badge variant="info" size="sm">{report.type}</Badge>
              <span class="text-xs text-soil-500">{report.pages} pages</span>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{report.title}</h3>
            <p class="text-sm text-soil-600 mb-1">{new Date(report.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p class="text-sm text-soil-700 leading-relaxed mb-4 flex-1">
              {report.description}
            </p>
            <Button href={report.downloadUrl} variant="secondary" size="sm" class="w-full">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Download PDF
            </Button>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Join the Community"
        title="Connect & Collaborate"
        description="Be part of a thriving community of DuckDB developers and data professionals."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {community.map((channel) => (
          <Card padding="lg" class="hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-harvest-100 flex items-center justify-center text-3xl">
                {channel.icon}
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xl font-bold text-soil-900">{channel.name}</h3>
                  <span class="text-sm font-semibold text-harvest-600">{channel.members}</span>
                </div>
                <p class="text-sm text-soil-700 leading-relaxed mb-4">
                  {channel.description}
                </p>
                <Button href={channel.link} variant="secondary" size="sm" external>
                  Join Now
                </Button>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-earth-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Ready to Build?
      </h2>
      <p class="text-xl md:text-2xl text-earth-50 mb-8 max-w-3xl mx-auto">
        Explore our extensions, install our Python packages, and join the community.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/extensions" variant="secondary" size="lg">
          Browse Extensions
        </Button>
        <Button href="https://github.com/queryfarm" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30" external>
          View on GitHub
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
