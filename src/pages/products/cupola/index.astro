---
import PageLayout from '../../../layouts/PageLayout.astro';
import CupolaSubNav from '../../../components/sections/CupolaSubNav.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import { CUPOLA_APP, CUPOLA_REPO, cupolaDemoLaunchUrl as EXAMPLE_LAUNCH } from '../../../data/cupola';

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const PILL = 'inline-block rounded-full border border-soil-300 px-2.5 py-0.5 text-[11px] font-medium text-soil-700';

const features = [
  {
    icon: 'engine',
    title: 'A real database, in your browser',
    description: 'Cupola runs Haybarn — Query.Farm’s build of DuckDB — compiled to multi-threaded WebAssembly. Genuine analytical SQL runs locally in the tab, with no install and nothing to provision.',
  },
  {
    icon: 'query',
    title: 'A shell built for analysts',
    description: 'A fast SQL terminal with autocomplete, history, dot commands, and sessions that survive a reload — plus formatted results and quick export to CSV or Excel.',
  },
  {
    icon: 'ai',
    title: 'An AI analyst on tap',
    description: 'A built-in assistant that writes and runs SQL, inspects your schema, and explains what it found in plain language. It does the tedious parts so you can ask the next question.',
  },
  {
    icon: 'pivot',
    title: 'Pivot, chart, and map',
    description: 'Turn any result into an interactive pivot table, a chart, or a map for geospatial data — drag-and-drop, backed directly by the in-browser engine.',
  },
  {
    icon: 'browse',
    title: 'Browse the whole catalog',
    description: 'A searchable tree of schemas, tables, views, and functions, with row previews, column statistics, and on-demand profiling so you learn the data as you go.',
  },
  {
    icon: 'connect',
    title: 'Sign in and connect',
    description: 'One-click OAuth (Google and more) with per-source identity. Point Cupola at a live data source, share views as deep links, and theme it to match your team.',
  },
];

const steps = [
  { n: 1, t: 'Open the example', d: 'Launch Cupola pointed at our volcano data source. One link does it — no setup, no download.' },
  { n: 2, t: 'Sign in with Google', d: 'The example source asks you to authenticate. Sign in with your Google account and you’re connected.' },
  { n: 3, t: 'Query, pivot, or ask', d: 'Browse the catalog, run SQL in the shell, build a pivot, or ask the AI analyst a question.' },
];

const analystPoints = [
  'Understands your schemas, tables, and column types',
  'Writes, runs, and refines SQL on the live data',
  'Explains results and suggests the next question',
  'Bring your own Anthropic API key — your data stays in your browser',
];

const neighbours = [
  {
    href: '/haybarn',
    img: '/haybarn/haybarn-logo.png',
    title: 'Haybarn',
    body: 'The DuckDB engine that runs inside Cupola — and on the desktop or server when you outgrow the browser.',
  },
  {
    href: '/vgi',
    img: '/vgi/vgi-logo.png',
    title: 'VGI',
    body: 'The protocol that turns APIs, services, and databases into the live SQL sources Cupola connects to.',
  },
  {
    href: '/products/orchard',
    emoji: '🌳',
    title: 'Orchard',
    body: 'The marketplace of ready-made connectors you can open and explore directly inside Cupola.',
  },
];
---

<PageLayout
  title="Cupola — A WASM-Powered Data Analyst Workbench"
  description="Cupola is a free, open-source data-analyst workbench that runs DuckDB (via Haybarn) in your browser — write SQL, pivot and chart results, and use a built-in AI analyst. Connects to live VGI data sources with one-click Google sign-in."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Cupola — data analyst workbench',
      description:
        'A free, open-source, WASM-powered data-analyst workbench that runs DuckDB (via Haybarn) in the browser, with an AI analyst and live VGI connectivity.',
      url: 'https://query.farm/products/cupola',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      codeRepository: CUPOLA_REPO,
      publisher: { '@type': 'Organization', name: 'Query.Farm', url: 'https://query.farm' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://query.farm/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://query.farm/products' },
        { '@type': 'ListItem', position: 3, name: 'Cupola', item: 'https://query.farm/products/cupola' },
      ],
    },
  ]}
>
  <CupolaSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Web workspace for VGI"
    title="A data analyst’s workbench, in a browser tab."
    icon={{
      src: '/cupola/cupola-icon-96.png',
      width: 36,
      height: 36,
      class: 'overflow-hidden',
      imgClass: 'h-9 w-9 object-contain'
    }}
    ledeClass="mt-3.5 max-w-[62ch] text-[17.5px] leading-relaxed text-soil-700"
    lede="Cupola is a fast, modern SQL workbench powered by DuckDB — running entirely in your browser. Write SQL, pivot and chart the results, and hand the hard parts to a built-in AI analyst. Sign in with Google and start exploring live data in seconds."
    hairband
  >
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="inline-block rounded-full border border-field-600/45 bg-field-600/10 px-2.5 py-0.5 text-[11px] font-medium text-field-700">Available now</span>
      <span class={PILL}>Open source · Apache 2.0</span>
      <span class={PILL}>Free</span>
      <span class={PILL}>Runs in your browser</span>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href={EXAMPLE_LAUNCH} variant="primary" size="md" external>Try it on live data →</Button>
      <Button href={CUPOLA_REPO} variant="secondary" size="md" external>
        <svg class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
        </svg>
        View source
      </Button>
    </div>
    <p class="mt-4 text-sm text-soil-500">No install. No account to create. Free and open source.</p>
  </PageHead>

  <!-- ── What is Cupola ──────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-start gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-12">
        <div>
          <span class={EYEBROW}>What is Cupola?</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">A modern shell for working with data</h2>
          <p class={`mt-4 ${LEDE}`}>
            Think of Cupola as a data analyst’s command center that opens in any browser. Under
            the hood it runs <a href="/haybarn" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">Haybarn</a> — Query.Farm’s distribution of DuckDB — compiled to
            multi-threaded WebAssembly. That means a real, fast analytical database runs
            <em>inside the tab</em>: your queries don’t wait on a server, and your data doesn’t
            have to leave your machine.
          </p>
          <p class={`mt-4 ${LEDE}`}>
            On top of that engine, Cupola adds the things analysts actually want — a polished
            SQL shell, pivot tables, charts and maps, a catalog browser, and a built-in AI
            analyst — and lets you connect to live data sources with a single sign-in.
          </p>

          <!-- Friendly VGI explainer so newcomers aren't lost -->
          <div class="mt-7 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
            <div class="text-[11px] font-medium text-sun-700">New to VGI? You don’t need to be.</div>
            <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
              VGI is Query.Farm’s way of turning APIs, services, and databases into live SQL
              tables. Cupola speaks it natively, so a single URL connects you to a ready-to-query
              source — but you don’t have to learn VGI to start. Open a source, and it’s just
              tables and SQL.
            </p>
          </div>
        </div>

        <!-- Mock workspace: rock-900 inset inside a paper card (brief §3) -->
        <div class={`${CARD} p-3`}>
          <div class="overflow-hidden rounded-lg border border-rock-800 bg-rock-900">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#a8412a]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-sun-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-field-400"></span>
              <span class="ml-3 text-[11px] font-medium text-cream-2">Cupola</span>
              <span class="ml-auto rounded-full border border-sun-400/40 bg-sun-400/10 px-2.5 py-0.5 text-[10.5px] font-medium text-sun-400">Haybarn · WASM</span>
            </div>
            <div class="grid grid-cols-[8.5rem_1fr]">
              <div class="border-r border-white/10 bg-black/20 p-3 text-xs">
                <p class="mb-2 text-[10.5px] font-medium text-cream-2">Catalog</p>
                <ul class="space-y-1.5 text-cream">
                  <li class="rounded bg-white/10 px-2 py-1">🌋 volcanoes</li>
                  <li class="rounded px-2 py-1">eruptions</li>
                  <li class="rounded px-2 py-1">regions</li>
                  <li class="rounded px-2 py-1 text-cream-2">ƒ nearest()</li>
                </ul>
              </div>
              <div class="p-3">
                <pre class="overflow-x-auto rounded-lg bg-rock-950 p-3 font-mono text-[12px] leading-relaxed text-[#e9e1d3]"><code><span class="text-sun-400">SELECT</span> name, country, primary_type
<span class="text-sun-400">FROM</span> volcanoes
<span class="text-sun-400">ORDER BY</span> last_eruption_year <span class="text-sun-400">DESC</span>
<span class="text-sun-400">LIMIT</span> 3;</code></pre>
                <div class="mt-3 overflow-hidden rounded-lg border border-white/10">
                  <div class="grid grid-cols-[1.4fr_1fr_1fr] bg-white/10 px-3 py-1.5 text-[10.5px] font-medium text-cream-2">
                    <span>name</span><span>country</span><span>type</span>
                  </div>
                  {[
                    ['Kīlauea', 'US', 'Shield'],
                    ['Etna', 'Italy', 'Strato'],
                    ['Merapi', 'Indonesia', 'Strato'],
                  ].map((row) => (
                    <div class="grid grid-cols-[1.4fr_1fr_1fr] px-3 py-1.5 text-[11px] text-cream odd:bg-white/5">
                      <span>{row[0]}</span><span class="text-cream-2">{row[1]}</span><span>{row[2]}</span>
                    </div>
                  ))}
                </div>
                <div class="mt-3 flex items-center gap-2 rounded-lg border border-sun-400/30 bg-sun-400/10 px-3 py-2 text-[11px] text-cream">
                  <span class="text-[10.5px] font-medium text-sun-400">AI</span>
                  <span>“Which of these erupted most recently?” → Kīlauea (2023)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ────────────────────────────────────────────── -->
  <section id="features" class="scroll-mt-32 border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>What you can do</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Everything an analyst needs, in one tab</h2>

      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <span class="mb-3.5 flex h-10 w-10 items-center justify-center rounded-[9px] border border-soil-300 bg-soil-100 text-soil-700">
              {f.icon === 'engine' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <ellipse cx="12" cy="6" rx="7" ry="3" stroke-width="2.2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" />
                </svg>
              )}
              {f.icon === 'query' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l3 3-3 3M13 15h3M4 5h16v14H4z" />
                </svg>
              )}
              {f.icon === 'ai' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v3M5 8h14v9H5zM9 12h.01M15 12h.01M9 21h6M12 17v4" />
                </svg>
              )}
              {f.icon === 'pivot' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4h16v16H4zM4 9h16M9 9v11" />
                </svg>
              )}
              {f.icon === 'browse' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h10M4 18h7" />
                </svg>
              )}
              {f.icon === 'connect' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4M7.5 7.5a5 5 0 017-.2M16.5 16.5a5 5 0 01-7 .2M4 12a8 8 0 0116 0 8 8 0 01-16 0z" />
                </svg>
              )}
            </span>
            <h3 class="text-lg text-soil-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── AI analyst spotlight ────────────────────────────────── -->
  <section id="ai-analyst" class="scroll-mt-32 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <span class={EYEBROW}>AI data analyst</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Ask in plain English. Get answers in SQL.</h2>
          <p class={`mt-4 ${LEDE}`}>
            Cupola’s built-in analyst is more than autocomplete. It reads your catalog, writes
            and runs real SQL against the in-browser engine, checks its own results, and
            explains what it found — so you can go from a vague question to a defensible answer
            without writing the first query yourself.
          </p>
          <ul class="mt-6 flex flex-col gap-2.5">
            {analystPoints.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-soil-700">
                <span class="mt-[2px] flex-none text-field-700" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Mock AI chat: rock-900 inset inside a paper card -->
        <div class={`${CARD} p-3`}>
          <div class="rounded-lg border border-rock-800 bg-rock-900 p-4">
            <div class="flex flex-col gap-3 text-sm">
              <div class="ml-auto max-w-[80%] rounded-2xl rounded-br-sm bg-sun-400 px-4 py-2 text-rock-900">
                Which countries have the most active volcanoes?
              </div>
              <div class="max-w-[90%] rounded-2xl rounded-bl-sm bg-white/10 px-4 py-3 text-cream">
                <p class="text-[10.5px] font-medium text-sun-400">Analyst</p>
                <p class="mt-1.5">Running a query against <span class="font-mono text-[12px] text-sun-400">volcanoes</span>…</p>
                <pre class="mt-2 overflow-x-auto rounded-lg bg-rock-950 p-3 font-mono text-[12px] leading-relaxed text-[#e9e1d3]"><code><span class="text-sun-400">SELECT</span> country, count(*) AS n
<span class="text-sun-400">FROM</span> volcanoes
<span class="text-sun-400">WHERE</span> last_eruption_year &gt;= 1900
<span class="text-sun-400">GROUP BY</span> country
<span class="text-sun-400">ORDER BY</span> n <span class="text-sun-400">DESC</span> <span class="text-sun-400">LIMIT</span> 3;</code></pre>
                <p class="mt-2.5 text-cream-2">Indonesia (76), Japan (59), and the United States (53) lead — together about a third of all volcanoes active in the last century.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: try it now ───────────────────────── -->
  <section id="quickstart" class="scroll-mt-32 bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">Try it now</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Explore a live dataset in 30 seconds</h2>
      <p class="mt-3 max-w-[62ch] text-[17.5px] leading-relaxed text-cream-2">
        We host an example data source — the Smithsonian global volcano catalog — so you can
        see Cupola work on real data without setting anything up.
      </p>

      <div class="mt-8 grid overflow-hidden rounded-xl border border-white/15 md:grid-cols-3">
        {steps.map((s, i) => (
          <div class:list={['px-6 py-6', i < steps.length - 1 && 'border-b border-white/12 md:border-b-0 md:border-r md:border-white/12']}>
            <div class="qf-figure text-[28px] leading-none text-sun-400">{s.n}</div>
            <h3 class="mt-3 text-lg text-cream">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-2">{s.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 overflow-hidden rounded-xl border border-white/15 bg-rock-950">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
          <span class="text-[11px] font-medium text-cream-2">Launch URL</span>
        </div>
        <p class="overflow-x-auto px-5 py-4 font-mono text-[12.8px] leading-relaxed break-all text-[#e9e1d3]">{EXAMPLE_LAUNCH}</p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button href={EXAMPLE_LAUNCH} variant="accent" size="md" onDark external>Open the volcano example →</Button>
        <Button href={CUPOLA_APP} variant="ghost" size="md" onDark external>Launch Cupola</Button>
      </div>
      <p class="mt-4 max-w-[62ch] text-sm leading-relaxed text-cream-2">
        Heads up: the example source requires a quick <strong class="font-medium text-cream">Google sign-in</strong> to
        connect. Your data and queries stay in your browser.
      </p>
    </div>
  </section>

  <!-- ── Open source + enterprise ────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>Open source</span>
          <h2 class="mt-3 text-2xl text-soil-900">Free, and yours to run</h2>
          <p class="mt-3 text-sm leading-relaxed text-soil-700">
            Cupola is Apache 2.0 licensed. Use the hosted version, or clone the repo and run it
            yourself — it’s a static site backed by DuckDB-WASM, with nothing to license and no
            server to operate.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href={CUPOLA_APP} variant="primary" size="md" external>Launch Cupola</Button>
            <Button href={CUPOLA_REPO} variant="secondary" size="md" external>
              <svg class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </Button>
          </div>
        </div>
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For enterprise</span>
          <h2 class="mt-3 text-2xl text-soil-900">Make it your team’s workbench</h2>
          <p class="mt-3 text-sm leading-relaxed text-soil-700">
            Cupola supports OAuth / PKCE sign-in, per-source identity, and full custom theming
            and branding. We help teams self-host it, white-label it, and wire it to their own
            internal data sources.
          </p>
          <div class="mt-6">
            <Button href="/company/schedule" variant="primary" size="md">Talk about enterprise →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Where it fits ───────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Where it fits</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Cupola and the rest of the data farm</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Cupola is the place you actually work with data. Haybarn is the engine inside it; VGI
        and the Orchard are how you connect live sources to query.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {neighbours.map((n) => (
          <a
            href={n.href}
            class={`${CARD} block p-6 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}
          >
            <span class="mb-3.5 flex h-10 w-10 items-center justify-center overflow-hidden rounded-[9px] border border-soil-300 bg-soil-100 text-[20px]">
              {n.img && <img src={n.img} alt="" width="24" height="24" class="h-6 w-6 object-contain" />}
              {n.emoji && <span aria-hidden="true">{n.emoji}</span>}
            </span>
            <h3 class="text-lg text-soil-900">{n.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{n.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">See your data in a new light</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            Cupola is free, open source, and ready now. Open the live example, or bring your own
            source.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href={EXAMPLE_LAUNCH} variant="primary" size="md" external>Try the live example</Button>
          <Button href={CUPOLA_REPO} variant="secondary" size="md" external>View on GitHub</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
