---
import PageLayout from '../../../layouts/PageLayout.astro';
import CupolaSubNav from '../../../components/sections/CupolaSubNav.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import { CUPOLA_APP, CUPOLA_REPO, cupolaDemoLaunchUrl as EXAMPLE_LAUNCH } from '../../../data/cupola';

const features = [
  {
    icon: 'engine',
    title: 'A real database, in your browser',
    description: 'Cupola runs Haybarn — Query.Farm’s build of DuckDB — compiled to multi-threaded WebAssembly. Genuine analytical SQL runs locally in the tab, with no install and nothing to provision.',
  },
  {
    icon: 'query',
    title: 'A shell built for analysts',
    description: 'A fast SQL terminal with autocomplete, history, dot commands, and sessions that survive a reload — plus formatted results and quick export to CSV or Excel.',
  },
  {
    icon: 'ai',
    title: 'An AI analyst on tap',
    description: 'A built-in assistant that writes and runs SQL, inspects your schema, and explains what it found in plain language. It does the tedious parts so you can ask the next question.',
  },
  {
    icon: 'pivot',
    title: 'Pivot, chart, and map',
    description: 'Turn any result into an interactive pivot table, a chart, or a map for geospatial data — drag-and-drop, backed directly by the in-browser engine.',
  },
  {
    icon: 'browse',
    title: 'Browse the whole catalog',
    description: 'A searchable tree of schemas, tables, views, and functions, with row previews, column statistics, and on-demand profiling so you learn the data as you go.',
  },
  {
    icon: 'connect',
    title: 'Sign in and connect',
    description: 'One-click OAuth (Google and more) with per-source identity. Point Cupola at a live data source, share views as deep links, and theme it to match your team.',
  },
];
---

<PageLayout
  title="Cupola — A WASM-Powered Data Analyst Workbench"
  description="Cupola is a free, open-source data-analyst workbench that runs DuckDB (via Haybarn) in your browser — write SQL, pivot and chart results, and use a built-in AI analyst. Connects to live VGI data sources with one-click Google sign-in."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Cupola — data analyst workbench',
      description:
        'A free, open-source, WASM-powered data-analyst workbench that runs DuckDB (via Haybarn) in the browser, with an AI analyst and live VGI connectivity.',
      url: 'https://query.farm/products/cupola',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      codeRepository: CUPOLA_REPO,
      publisher: { '@type': 'Organization', name: 'Query.Farm', url: 'https://query.farm' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://query.farm/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://query.farm/products' },
        { '@type': 'ListItem', position: 3, name: 'Cupola', item: 'https://query.farm/products/cupola' },
      ],
    },
  ]}
>
  <CupolaSubNav />

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-sky-100 via-harvest-50 to-white overflow-hidden py-16 lg:py-24">
    <div class="absolute inset-0 opacity-30">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="cupola-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-sky-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#cupola-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-10 lg:gap-14 items-center">
        <div>
          <div class="mb-6 flex items-center gap-4">
            <img
              src="/cupola/cupola-icon.png"
              alt="Cupola"
              width="80"
              height="80"
              class="h-20 w-20 rounded-2xl border-2 border-soil-900 object-cover shadow-md"
            />
            <span class="inline-flex items-center rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold uppercase tracking-wider text-soil-900 shadow-sm">
              Cupola
            </span>
          </div>

          <div class="mb-5 flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Available now
            </span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-bold text-soil-700">Open source · Apache 2.0</span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-bold text-soil-700">Free</span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-bold text-soil-700">Runs in your browser</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-normal text-soil-900 leading-tight">
            A data analyst’s workbench,
            <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">in a browser tab.</span>
          </h1>
          <p class="mt-6 text-lg md:text-xl text-soil-700 leading-relaxed">
            Cupola is a fast, modern SQL workbench powered by DuckDB — running entirely in your browser. Write SQL, pivot and chart the results, and hand the hard parts to a built-in AI analyst. Sign in with Google and start exploring live data in seconds.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <Button href={EXAMPLE_LAUNCH} variant="accent" size="lg" external>Try it on live data →</Button>
            <Button href={CUPOLA_REPO} variant="secondary" size="lg" external>
              <svg class="mr-2 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
              </svg>
              View source
            </Button>
          </div>
          <p class="mt-4 text-sm text-soil-500">No install. No account to create. Free and open source.</p>
        </div>

        <!-- Mock workspace -->
        <div class="rounded-2xl border-2 border-soil-900 bg-white p-3 shadow-2xl">
          <div class="rounded-xl border-2 border-soil-900 bg-soil-900 overflow-hidden">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
              <span class="h-3 w-3 rounded-full bg-rose-400"></span>
              <span class="h-3 w-3 rounded-full bg-amber-400"></span>
              <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
              <span class="ml-3 text-xs font-semibold text-soil-300">Cupola</span>
              <span class="ml-auto rounded-full border border-sky-400/40 bg-sky-400/10 px-2.5 py-0.5 text-[10px] font-bold text-sky-200">Haybarn · WASM</span>
            </div>
            <div class="grid grid-cols-[8.5rem_1fr]">
              <div class="border-r border-white/10 bg-black/20 p-3 text-xs">
                <p class="mb-2 font-bold uppercase tracking-wider text-sky-300">Catalog</p>
                <ul class="space-y-1.5 text-soil-200">
                  <li class="rounded bg-white/10 px-2 py-1">🌋 volcanoes</li>
                  <li class="rounded px-2 py-1">eruptions</li>
                  <li class="rounded px-2 py-1">regions</li>
                  <li class="rounded px-2 py-1 text-soil-400">ƒ nearest()</li>
                </ul>
              </div>
              <div class="p-3">
                <pre class="overflow-x-auto rounded-lg bg-black/30 p-3 font-mono text-xs leading-relaxed text-soil-100"><code><span class="text-grain-300">SELECT</span> name, country, primary_type
<span class="text-grain-300">FROM</span> volcanoes
<span class="text-grain-300">ORDER BY</span> last_eruption_year <span class="text-grain-300">DESC</span>
<span class="text-grain-300">LIMIT</span> 3;</code></pre>
                <div class="mt-3 overflow-hidden rounded-lg border border-white/10">
                  <div class="grid grid-cols-[1.4fr_1fr_1fr] bg-white/10 px-3 py-1.5 text-[11px] font-bold text-soil-200">
                    <span>name</span><span>country</span><span>type</span>
                  </div>
                  {[
                    ['Kīlauea', 'US', 'Shield'],
                    ['Etna', 'Italy', 'Strato'],
                    ['Merapi', 'Indonesia', 'Strato'],
                  ].map((row) => (
                    <div class="grid grid-cols-[1.4fr_1fr_1fr] px-3 py-1.5 text-[11px] text-soil-100 odd:bg-white/5">
                      <span>{row[0]}</span><span class="text-sky-200">{row[1]}</span><span>{row[2]}</span>
                    </div>
                  ))}
                </div>
                <div class="mt-3 flex items-center gap-2 rounded-lg border border-sky-400/30 bg-sky-400/10 px-3 py-2 text-[11px] text-sky-100">
                  <span class="font-bold">AI</span>
                  <span>“Which of these erupted most recently?” → Kīlauea (2023)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is Cupola -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="What is Cupola?"
          title="A modern shell for working with data"
        />
        <p class="mt-6 text-lg text-soil-700 leading-relaxed">
          Think of Cupola as a data analyst’s command center that opens in any browser. Under the hood it runs <a href="/haybarn" class="text-harvest-700 font-medium underline underline-offset-2 hover:text-harvest-800">Haybarn</a> — Query.Farm’s distribution of DuckDB — compiled to multi-threaded WebAssembly. That means a real, fast analytical database runs <em>inside the tab</em>: your queries don’t wait on a server, and your data doesn’t have to leave your machine.
        </p>
        <p class="mt-4 text-lg text-soil-700 leading-relaxed">
          On top of that engine, Cupola adds the things analysts actually want — a polished SQL shell, pivot tables, charts and maps, a catalog browser, and a built-in AI analyst — and lets you connect to live data sources with a single sign-in.
        </p>
      </div>

      <!-- Friendly VGI explainer so newcomers aren't lost -->
      <div class="mt-10 max-w-3xl mx-auto rounded-2xl border-2 border-sky-300 bg-sky-50 p-6">
        <p class="text-sm font-bold uppercase tracking-wider text-sky-700">New to VGI? You don’t need to be.</p>
        <p class="mt-2 text-soil-700 leading-relaxed">
          VGI is Query.Farm’s way of turning APIs, services, and databases into live SQL tables. Cupola speaks it natively, so a single URL connects you to a ready-to-query source — but you don’t have to learn VGI to start. Open a source, and it’s just tables and SQL.
        </p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-16 lg:py-24 bg-soil-50 scroll-mt-16">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="What you can do"
        title="Everything an analyst needs, in one tab"
        class="mb-12"
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {features.map((f) => (
          <Card padding="lg" class="border-2 border-soil-900 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-sky-100 text-sky-800">
              {f.icon === 'engine' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <ellipse cx="12" cy="6" rx="7" ry="3" stroke-width="2.2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" />
                </svg>
              )}
              {f.icon === 'query' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l3 3-3 3M13 15h3M4 5h16v14H4z" />
                </svg>
              )}
              {f.icon === 'ai' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v3M5 8h14v9H5zM9 12h.01M15 12h.01M9 21h6M12 17v4" />
                </svg>
              )}
              {f.icon === 'pivot' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4h16v16H4zM4 9h16M9 9v11" />
                </svg>
              )}
              {f.icon === 'browse' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h10M4 18h7" />
                </svg>
              )}
              {f.icon === 'connect' && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4M7.5 7.5a5 5 0 017-.2M16.5 16.5a5 5 0 01-7 .2M4 12a8 8 0 0116 0 8 8 0 01-16 0z" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{f.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{f.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- AI analyst spotlight -->
  <section id="ai-analyst" class="py-16 lg:py-24 bg-white scroll-mt-16">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-10 lg:gap-14 items-center max-w-6xl mx-auto">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-sky-700">AI data analyst</p>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-soil-900">Ask in plain English. Get answers in SQL.</h2>
          <p class="mt-4 text-soil-700 leading-relaxed">
            Cupola’s built-in analyst is more than autocomplete. It reads your catalog, writes and runs real SQL against the in-browser engine, checks its own results, and explains what it found — so you can go from a vague question to a defensible answer without writing the first query yourself.
          </p>
          <ul class="mt-6 space-y-3">
            {[
              'Understands your schemas, tables, and column types',
              'Writes, runs, and refines SQL on the live data',
              'Explains results and suggests the next question',
              'Bring your own Anthropic API key — your data stays in your browser',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-soil-700 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Mock AI chat -->
        <div class="rounded-2xl border-2 border-soil-900 bg-soil-900 p-4 shadow-xl">
          <div class="space-y-3 text-sm">
            <div class="ml-auto max-w-[80%] rounded-2xl rounded-br-sm bg-sky-500 px-4 py-2 text-white">
              Which countries have the most active volcanoes?
            </div>
            <div class="max-w-[90%] rounded-2xl rounded-bl-sm bg-white/10 px-4 py-3 text-soil-100">
              <p class="text-xs font-bold uppercase tracking-wider text-sky-300">Analyst</p>
              <p class="mt-1">Running a query against <span class="font-mono text-grain-300">volcanoes</span>…</p>
              <pre class="mt-2 overflow-x-auto rounded-lg bg-black/30 p-2 font-mono text-xs text-soil-100"><code><span class="text-grain-300">SELECT</span> country, count(*) AS n
<span class="text-grain-300">FROM</span> volcanoes
<span class="text-grain-300">WHERE</span> last_eruption_year >= 1900
<span class="text-grain-300">GROUP BY</span> country
<span class="text-grain-300">ORDER BY</span> n <span class="text-grain-300">DESC</span> <span class="text-grain-300">LIMIT</span> 3;</code></pre>
              <p class="mt-2">Indonesia (76), Japan (59), and the United States (53) lead — together about a third of all volcanoes active in the last century.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quickstart with the example service -->
  <section id="quickstart" class="py-16 lg:py-24 bg-soil-50 scroll-mt-16">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Try it now"
        title="Explore a live dataset in 30 seconds"
        description="We host an example data source — the Smithsonian global volcano catalog — so you can see Cupola work on real data without setting anything up."
        class="mb-12"
      />

      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { n: 1, t: 'Open the example', d: 'Launch Cupola pointed at our volcano data source. One link does it — no setup, no download.' },
          { n: 2, t: 'Sign in with Google', d: 'The example source asks you to authenticate. Sign in with your Google account and you’re connected.' },
          { n: 3, t: 'Query, pivot, or ask', d: 'Browse the catalog, run SQL in the shell, build a pivot, or ask the AI analyst a question.' },
        ].map((s) => (
          <Card padding="lg" class="border-2 border-soil-900 shadow-sm">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-grain-300 text-soil-900 font-extrabold">{s.n}</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{s.t}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{s.d}</p>
          </Card>
        ))}
      </div>

      <div class="mt-10 max-w-3xl mx-auto rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm text-center">
        <p class="text-soil-700">
          Launch Cupola on the example volcano source:
        </p>
        <p class="mt-2 break-all font-mono text-sm text-soil-500">{EXAMPLE_LAUNCH}</p>
        <div class="mt-5">
          <Button href={EXAMPLE_LAUNCH} variant="accent" size="lg" external>Open the volcano example →</Button>
        </div>
        <p class="mt-4 text-sm text-soil-500">
          Heads up: the example source requires a quick <strong>Google sign-in</strong> to connect. Your data and queries stay in your browser.
        </p>
      </div>
    </div>
  </section>

  <!-- Open source + enterprise -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="rounded-2xl border-2 border-soil-900 bg-grain-50 p-8 shadow-sm">
          <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">Open source</p>
          <h3 class="mt-2 text-2xl font-bold text-soil-900">Free, and yours to run</h3>
          <p class="mt-3 text-soil-700 leading-relaxed">
            Cupola is Apache 2.0 licensed. Use the hosted version, or clone the repo and run it yourself — it’s a static site backed by DuckDB-WASM, with nothing to license and no server to operate.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href={CUPOLA_APP} variant="primary" size="md" external>Launch Cupola</Button>
            <Button href={CUPOLA_REPO} variant="secondary" size="md" external>
              <svg class="mr-2 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </Button>
          </div>
        </div>
        <div class="rounded-2xl border-2 border-soil-900 bg-sky-50 p-8 shadow-sm">
          <p class="text-sm font-bold uppercase tracking-wider text-sky-700">For enterprise</p>
          <h3 class="mt-2 text-2xl font-bold text-soil-900">Make it your team’s workbench</h3>
          <p class="mt-3 text-soil-700 leading-relaxed">
            Cupola supports OAuth / PKCE sign-in, per-source identity, and full custom theming and branding. We help teams self-host it, white-label it, and wire it to their own internal data sources.
          </p>
          <Button href="/company/schedule" variant="primary" size="md" class="mt-6">Talk about enterprise →</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- How it fits -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Where it fits"
        title="Cupola and the rest of the data farm"
        description="Cupola is the place you actually work with data. Haybarn is the engine inside it; VGI and the Orchard are how you connect live sources to query."
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/haybarn" class="block">
          <Card padding="lg" class="h-full border-2 border-soil-900 shadow-sm hover:shadow-xl transition-shadow">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-harvest-100 overflow-hidden">
              <img src="/haybarn/haybarn-logo.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Haybarn</h3>
            <p class="text-sm text-soil-700">The DuckDB engine that runs inside Cupola — and on the desktop or server when you outgrow the browser.</p>
          </Card>
        </a>
        <a href="/vgi" class="block">
          <Card padding="lg" class="h-full border-2 border-soil-900 shadow-sm hover:shadow-xl transition-shadow">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-duck-100 text-duck-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6h5v5H5zM14 13h5v5h-5zM14 6h5M5 18h5M10 8.5h4M12 11v2" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">VGI</h3>
            <p class="text-sm text-soil-700">The protocol that turns APIs, services, and databases into the live SQL sources Cupola connects to.</p>
          </Card>
        </a>
        <a href="/products/orchard" class="block">
          <Card padding="lg" class="h-full border-2 border-soil-900 shadow-sm hover:shadow-xl transition-shadow">
            <div class="mb-3 text-3xl">🌳</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">The Orchard</h3>
            <p class="text-sm text-soil-700">The marketplace of ready-made connectors you can open and explore directly inside Cupola.</p>
          </Card>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-sky-600 to-harvest-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">See your data in a new light</h2>
      <p class="text-xl md:text-2xl text-sky-50 mb-8 max-w-3xl mx-auto">
        Cupola is free, open source, and ready now. Open the live example, or bring your own source.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={EXAMPLE_LAUNCH} variant="secondary" size="lg" external>Try the live example</Button>
        <Button href={CUPOLA_REPO} variant="ghost" size="lg" external class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          View on GitHub
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
