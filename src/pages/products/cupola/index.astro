---
import PageLayout from '../../../layouts/PageLayout.astro';
import CupolaSubNav from '../../../components/sections/CupolaSubNav.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import {
  CUPOLA_APP,
  CUPOLA_REPO,
  CUPOLA_DEMOS,
  CUPOLA_DEMO,
  cupolaLaunchUrl,
  cupolaDemoLaunchUrl as EXAMPLE_LAUNCH,
} from '../../../data/cupola';

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const WIDE = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const PILL = 'inline-block rounded-full border border-soil-300 px-2.5 py-0.5 text-[11px] font-medium text-soil-700';
// Headings use the site's display face (Petrona) like every other product
// page. Cupola briefly carried its own — Archivo — but a second typeface made
// it the odd one out next to VGI and Orchard; the mark alone carries the
// product's identity now.
const H2 = 'mt-3 text-3xl md:text-4xl text-soil-900';

/*
  The three images below are real captures of the hosted build (v0.4.115)
  driven against the live `vgi-earthquakes` worker, which is the same source
  this page links to. Taken with Playwright at 1500px CSS wide / DPR 2, then
  cropped to their subject and resized to 2000px wide with a WebP pair. The
  crops are framing only — nothing in them is retouched, and if the app's
  chrome drifts far enough that they look stale, RE-CAPTURE rather than edit:
  the whole point of dropping the old hand-drawn mock is that these are the
  actual product.

  There is deliberately no SQL-shell capture. The shell renders to a canvas and
  only paints once its WASM engine has booted, which did not survive being
  driven headlessly — every attempt produced an empty black panel. A blank
  screenshot is worse than none, so the shell is described in the feature grid
  instead of being faked.
*/
const shots = {
  editor: {
    base: '/cupola/screens/cupola-query-editor',
    w: 2000,
    h: 1093,
    alt: 'Cupola’s query editor: a SQL statement against the USGS earthquake feed with Run, Ask AI, Format and Script controls above it, and twelve result rows in a grid below with Save Results and Pivot beside them.',
  },
  catalog: {
    base: '/cupola/screens/cupola-catalog',
    w: 2000,
    h: 1040,
    alt: 'Cupola’s catalog browser showing the “recent” earthquake table: thirty columns listed with their SQL types, not-null flags, and a written description of each one.',
  },
  chart: {
    base: '/cupola/screens/cupola-chart',
    w: 2000,
    h: 1040,
    alt: 'Cupola’s pivot view: 10,912 live earthquakes plotted on a world map, each point sized and coloured by magnitude so the plate boundaries show as bands of dots, with the Group By, Longitude, Latitude, Colour and Size controls open on the right.',
  },
};

const features = [
  {
    icon: 'engine',
    title: 'A real database, in your browser',
    description:
      'Cupola runs Haybarn — Query.Farm’s build of DuckDB — compiled to WebAssembly. Genuine analytical SQL runs locally in the tab, with no install and nothing to provision.',
  },
  {
    icon: 'query',
    title: 'An editor built for real work',
    description:
      'Tabbed queries with highlighting and completion, one-key formatting, export to CSV or Excel, a downloadable .sql file, and a Share button that puts the whole query in the URL.',
  },
  {
    icon: 'browse',
    title: 'A catalog that documents itself',
    description:
      'A searchable tree of schemas, tables, views, functions and macros — with per-column types and descriptions, argument docs, example queries, and on-demand column profiling.',
  },
  {
    icon: 'pivot',
    title: 'Pivot, chart, and map',
    description:
      'Send any result to a Perspective pivot — group, split, aggregate, then switch to bars, lines, treemaps or heatmaps. Geometry columns draw as maps instead of hex strings.',
  },
  {
    icon: 'ai',
    title: 'An AI analyst on tap',
    description:
      'A built-in assistant that writes and runs SQL, inspects your schema, charts what it finds, and explains it in plain language. Bring your own Anthropic API key.',
  },
  {
    icon: 'terminal',
    title: 'A terminal when you want one',
    description:
      'A full DuckDB shell with tab completion, history, dot commands, and a session that survives a reload — for when you would rather type than click.',
  },
  {
    icon: 'connect',
    title: 'Connects to anything that speaks VGI',
    description:
      'Point it at a URL and it attaches. OAuth and PKCE are there for sources that need identity, per catalog — and your sign-in survives the redirect back to the query you were writing.',
  },
  {
    icon: 'theme',
    title: 'Yours to brand and to host',
    description:
      'Load a colour theme from a URL or build one in the theme editor. Use the hosted build, deploy it to your own Cloudflare account, or run the Docker image behind your gateway.',
  },
];

/*
  The steps used to be: open it, sign in with Google, then query. The middle
  step is gone because the examples changed — see the note in
  src/data/cupola.ts. Every source linked from this page is public and asks
  nothing of the visitor, so there is no longer an auth wall between the click
  and the product.
*/
const steps = [
  {
    n: 1,
    t: 'Open an example',
    d: 'Pick one of the live sources below. One link does it — no download, no account, nothing to configure.',
  },
  {
    n: 2,
    t: 'It attaches itself',
    d: 'Cupola boots DuckDB in the tab, attaches the source, and reads its catalog. You are looking at real tables within seconds.',
  },
  {
    n: 3,
    t: 'Query, pivot, or ask',
    d: 'Browse the schema, run SQL in the editor or the shell, build a pivot, or hand the question to the AI analyst.',
  },
];

const analystPoints = [
  'Reads your schemas, tables, and column types',
  'Writes, runs, and refines SQL against the live data',
  'Charts what it finds, and explains the result',
  'Bring your own Anthropic API key — your data stays in your browser',
];

const neighbours = [
  {
    href: '/haybarn',
    img: '/haybarn/haybarn-mark.svg',
    title: 'Haybarn',
    body: 'The DuckDB engine that runs inside Cupola — and on the desktop or server when you outgrow the browser.',
  },
  {
    href: '/vgi',
    img: '/vgi/vgi-logo.png',
    title: 'VGI',
    body: 'The protocol that turns APIs, services, and databases into the live SQL sources Cupola connects to.',
  },
  {
    href: '/products/orchard',
    emoji: '🌳',
    title: 'Orchard',
    body: 'The marketplace of ready-made connectors you can open and explore directly inside Cupola.',
  },
];
---

<PageLayout
  title="Cupola — A WASM-Powered Data Analyst Workbench"
  description="Cupola is a free, open-source data-analyst workbench that runs DuckDB (via Haybarn) in your browser — write SQL, pivot and chart results, and use a built-in AI analyst. Open a live data source in one click, with no account and no sign-in."
  ogImage="/og/cupola.jpg"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Cupola — data analyst workbench',
      description:
        'A free, open-source, WASM-powered data-analyst workbench that runs DuckDB (via Haybarn) in the browser, with an AI analyst and live VGI connectivity.',
      url: 'https://query.farm/products/cupola',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      codeRepository: CUPOLA_REPO,
      publisher: { '@type': 'Organization', name: 'Query.Farm', url: 'https://query.farm' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://query.farm/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://query.farm/products' },
        { '@type': 'ListItem', position: 3, name: 'Cupola', item: 'https://query.farm/products/cupola' },
      ],
    },
  ]}
>
  <CupolaSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Web workspace for VGI"
    title="A data analyst’s workbench, in a browser tab."
    icon={{
      src: '/cupola/cupola-mark.svg',
      width: 40,
      height: 40,
      imgClass: 'h-10 w-10 object-contain'
    }}
    ledeClass="mt-3.5 max-w-[64ch] text-[17.5px] leading-relaxed text-soil-700"
    lede="Cupola is a fast, modern SQL workbench powered by DuckDB — running entirely in your browser. Write SQL, pivot and chart the results, and hand the hard parts to a built-in AI analyst. Open a live data source with a single link: no install, no account, no sign-in."
    hairband
  >
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="inline-block rounded-full border border-field-600/45 bg-field-600/10 px-2.5 py-0.5 text-[11px] font-medium text-field-700">Available now</span>
      <span class={PILL}>Open source · Apache 2.0</span>
      <span class={PILL}>Free</span>
      <span class={PILL}>Runs in your browser</span>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href={EXAMPLE_LAUNCH} variant="primary" size="md" external>Open a live example →</Button>
      <Button href={CUPOLA_REPO} variant="secondary" size="md" external>
        <svg class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
        </svg>
        View source
      </Button>
    </div>
    <p class="mt-4 text-sm text-soil-500">No install. No account to create. Free and open source.</p>
  </PageHead>

  <!-- ── Hero shot ───────────────────────────────────────────── -->
  <section class="pt-2 pb-16 lg:pb-[70px]">
    <div class={WIDE}>
      <figure class={`${CARD} p-2.5 sm:p-3`}>
        <picture>
          <source srcset={`${shots.editor.base}.webp`} type="image/webp" />
          <img
            src={`${shots.editor.base}.png`}
            width={shots.editor.w}
            height={shots.editor.h}
            alt={shots.editor.alt}
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-lg border border-soil-300"
          />
        </picture>
        <figcaption class="px-1.5 pt-3 pb-1 text-[13px] leading-relaxed text-soil-600">
          Cupola querying the live USGS earthquake feed. The editor, the engine and the results
          grid all sit in the browser tab — the only thing crossing the network is the data
          source itself.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ── What is Cupola ──────────────────────────────────────── -->
  <section class="border-t border-soil-300 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-start gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-12">
        <div>
          <span class={EYEBROW}>What is Cupola?</span>
          <h2 class={H2}>A modern shell for working with data</h2>
          <p class={`mt-4 ${LEDE}`}>
            Think of Cupola as a data analyst’s command center that opens in any browser. Under
            the hood it runs <a href="/haybarn" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">Haybarn</a> — Query.Farm’s distribution of DuckDB — compiled to
            WebAssembly. That means a real, fast analytical database runs
            <em>inside the tab</em>: your queries don’t wait on a server, and your data doesn’t
            have to leave your machine.
          </p>
          <p class={`mt-4 ${LEDE}`}>
            It began as a way to test <a href="/vgi" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">VGI</a> in the browser, and grew into the thing people
            actually work in — a tabbed SQL editor, a terminal, pivot tables, charts and maps, a
            self-documenting catalog browser, and a built-in AI analyst.
          </p>

          <!-- Friendly VGI explainer so newcomers aren't lost -->
          <div class="mt-7 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
            <div class="text-[11px] font-medium text-sun-700">New to VGI? You don’t need to be.</div>
            <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
              VGI is Query.Farm’s way of turning APIs, services, and databases into live SQL
              tables. Cupola speaks it natively, so a single URL connects you to a ready-to-query
              source — but you don’t have to learn VGI to start. Open a source, and it’s just
              tables and SQL.
            </p>
          </div>
        </div>

        <figure class={`${CARD} p-2.5`}>
          <picture>
            <source srcset={`${shots.catalog.base}.webp`} type="image/webp" />
            <img
              src={`${shots.catalog.base}.png`}
              width={shots.catalog.w}
              height={shots.catalog.h}
              alt={shots.catalog.alt}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg border border-soil-300"
            />
          </picture>
          <figcaption class="px-1.5 pt-3 pb-1 text-[13px] leading-relaxed text-soil-600">
            The catalog browser. Every column arrives with its type and a written description,
            so you learn the data while you read it.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Features ────────────────────────────────────────────── -->
  <section id="features" class="scroll-mt-32 border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>What you can do</span>
      <h2 class={H2}>Everything an analyst needs, in one tab</h2>

      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <span class="mb-3.5 flex h-10 w-10 items-center justify-center rounded-[9px] border border-soil-300 bg-soil-100 text-soil-700">
              {f.icon === 'engine' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <ellipse cx="12" cy="6" rx="7" ry="3" stroke-width="2.2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" />
                </svg>
              )}
              {f.icon === 'query' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 5h16v14H4zM4 9h16M8 13h5M8 16h8" />
                </svg>
              )}
              {f.icon === 'terminal' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l3 3-3 3M13 15h3M4 5h16v14H4z" />
                </svg>
              )}
              {f.icon === 'ai' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v3M5 8h14v9H5zM9 12h.01M15 12h.01M9 21h6M12 17v4" />
                </svg>
              )}
              {f.icon === 'pivot' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4h16v16H4zM4 9h16M9 9v11" />
                </svg>
              )}
              {f.icon === 'browse' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h10M4 18h7" />
                </svg>
              )}
              {f.icon === 'connect' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4M7.5 7.5a5 5 0 017-.2M16.5 16.5a5 5 0 01-7 .2M4 12a8 8 0 0116 0 8 8 0 01-16 0z" />
                </svg>
              )}
              {f.icon === 'theme' && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3a9 9 0 100 18h1.5a2 2 0 000-4H13a2 2 0 010-4h4a4 4 0 004-4 6 6 0 00-9-6z" />
                  <circle cx="8.5" cy="10.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
            </span>
            <h3 class="text-lg text-soil-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Pivot / chart ───────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
        <figure class={`${CARD} order-2 p-2.5 lg:order-1`}>
          <picture>
            <source srcset={`${shots.chart.base}.webp`} type="image/webp" />
            <img
              src={`${shots.chart.base}.png`}
              width={shots.chart.w}
              height={shots.chart.h}
              alt={shots.chart.alt}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg border border-soil-300"
            />
          </picture>
        </figure>
        <div class="order-1 lg:order-2">
          <span class={EYEBROW}>Pivot and chart</span>
          <h2 class={H2}>Drag a result into a shape you can read</h2>
          <p class={`mt-4 ${LEDE}`}>
            Any result — a query you wrote, or a whole table — can be sent straight to a
            Perspective pivot. Group, filter and aggregate by dragging columns, then switch
            between a data grid, bars, lines, treemaps and heatmaps — or, when the rows carry
            coordinates, drop them onto a map — without going back to SQL.
          </p>
          <p class={`mt-4 ${LEDE}`}>
            It is backed by the same in-browser engine, so it plots the real rows rather than a
            sample. Every earthquake on Earth in the last 30 days is on the map above —
            <span class="qf-figure">10,912</span> of them, drawn in the tab, with the Ring of
            Fire falling out of the data on its own.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── AI analyst spotlight ────────────────────────────────── -->
  <section id="ai-analyst" class="scroll-mt-32 border-t border-soil-300 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <span class={EYEBROW}>AI data analyst</span>
          <h2 class={H2}>Ask in plain English. Get answers in SQL.</h2>
          <p class={`mt-4 ${LEDE}`}>
            Cupola’s built-in analyst is more than autocomplete. It reads your catalog, writes
            and runs real SQL against the in-browser engine, charts the result, checks its own
            work, and explains what it found — so you can go from a vague question to a
            defensible answer without writing the first query yourself.
          </p>
          <ul class="mt-6 flex flex-col gap-2.5">
            {analystPoints.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-soil-700">
                <span class="mt-[2px] flex-none text-field-700" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Illustration, not a screenshot. The analyst runs on the visitor's own
            Anthropic key, so there is no shared session to capture honestly.
            Kept stylised on rock-900 — as the other panels on this page are
            photographs, this one says so in its caption rather than passing for
            one. The query and the place names are from the same earthquake
            source the page links to. */}
        <div class={`${CARD} p-3`}>
          <div class="rounded-lg border border-rock-800 bg-rock-900 p-4">
            <div class="flex flex-col gap-3 text-sm">
              <div class="ml-auto max-w-[80%] rounded-2xl rounded-br-sm bg-sun-400 px-4 py-2 text-rock-900">
                Where were the strongest quakes this month?
              </div>
              <div class="max-w-[90%] rounded-2xl rounded-bl-sm bg-white/10 px-4 py-3 text-cream">
                <p class="text-[10.5px] font-medium text-sun-400">Analyst</p>
                <p class="mt-1.5">Querying <span class="font-mono text-[12px] text-sun-400">main.recent</span>…</p>
                <pre class="mt-2 overflow-x-auto rounded-lg bg-rock-950 p-3 font-mono text-[12px] leading-relaxed text-[#e9e1d3]"><code><span class="text-sun-400">SELECT</span> place, round(mag, 1) <span class="text-sun-400">AS</span> mag
<span class="text-sun-400">FROM</span> main.recent
<span class="text-sun-400">WHERE</span> mag &gt;= 6.5
<span class="text-sun-400">ORDER BY</span> mag <span class="text-sun-400">DESC</span> <span class="text-sun-400">LIMIT</span> 3;</code></pre>
                <p class="mt-2.5 text-cream-2">Three events above M6.5 — near Ende and Pematangsiantar in Indonesia, and San José del Palmar in Colombia. Want that as a map?</p>
              </div>
            </div>
          </div>
          <p class="px-1.5 pt-3 pb-0.5 text-[12.5px] leading-relaxed text-soil-600">
            Illustration — the analyst runs on your own Anthropic API key, so there is no shared
            demo to photograph.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: try it now ───────────────────────── -->
  <section id="quickstart" class="scroll-mt-32 bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">Try it now</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Open real data in about ten seconds</h2>
      <p class="mt-3 max-w-[66ch] text-[17.5px] leading-relaxed text-cream-2">
        These are the same live sources the <a href="/vgi" class="text-sun-400 underline decoration-sun-400/40 underline-offset-2 hover:decoration-sun-400">VGI tour</a> runs
        against — all public, and not one of them asks you to sign in. Pick one and it opens
        straight into the catalog.
      </p>

      <div class="mt-8 grid overflow-hidden rounded-xl border border-white/15 md:grid-cols-3">
        {steps.map((s, i) => (
          <div class:list={['px-6 py-6', i < steps.length - 1 && 'border-b border-white/12 md:border-b-0 md:border-r md:border-white/12']}>
            <div class="qf-figure text-[28px] leading-none text-sun-400">{s.n}</div>
            <h3 class="mt-3 text-lg text-cream">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-2">{s.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-3.5 grid gap-3.5 md:grid-cols-3">
        {CUPOLA_DEMOS.map((d) => (
          <a
            href={cupolaLaunchUrl(d.service)}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col rounded-xl border border-white/15 bg-white/[0.04] p-6 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400/70 hover:bg-white/[0.07]"
          >
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <h3 class="text-lg text-cream">{d.label}</h3>
              <span class="text-[11px] text-cream-2">{d.source}</span>
            </div>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-cream-2">{d.blurb}</p>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
              <span class="rounded-full border border-white/20 px-2.5 py-0.5 text-[11px] text-cream-2">{d.shape}</span>
              <span class="text-[13px] font-medium text-sun-400 transition-transform group-hover:translate-x-0.5">Open in Cupola →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 overflow-hidden rounded-xl border border-white/15 bg-rock-950">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
          <span class="text-[11px] font-medium text-cream-2">The whole launch URL — that is the entire setup</span>
        </div>
        <p class="overflow-x-auto px-5 py-4 font-mono text-[12.8px] leading-relaxed break-all text-[#e9e1d3]">{EXAMPLE_LAUNCH}</p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button href={EXAMPLE_LAUNCH} variant="accent" size="md" onDark external>Open the {CUPOLA_DEMO.label.toLowerCase()} example →</Button>
        <Button href={CUPOLA_APP} variant="ghost" size="md" onDark external>Launch Cupola empty</Button>
      </div>
      <p class="mt-4 max-w-[66ch] text-sm leading-relaxed text-cream-2">
        No account, and nothing to install. Your queries and your data stay in the browser —
        Cupola only fetches what the source hands back.
      </p>
    </div>
  </section>

  <!-- ── Open source + enterprise ────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>Open source</span>
          <h2 class="mt-3 text-2xl text-soil-900">Free, and yours to run</h2>
          <p class="mt-3 text-sm leading-relaxed text-soil-700">
            Cupola is Apache 2.0 licensed. Use the hosted version, deploy it to your own
            Cloudflare account, or run the Docker image behind your own gateway — it is a static
            site backed by DuckDB-WASM, with nothing to license and no database to operate.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href={CUPOLA_APP} variant="primary" size="md" external>Launch Cupola</Button>
            <Button href={CUPOLA_REPO} variant="secondary" size="md" external>
              <svg class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </Button>
          </div>
        </div>
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For enterprise</span>
          <h2 class="mt-3 text-2xl text-soil-900">Make it your team’s workbench</h2>
          <p class="mt-3 text-sm leading-relaxed text-soil-700">
            Cupola supports OAuth / PKCE sign-in with per-source identity, loadable colour
            themes, and full white-labelling. We help teams self-host it, brand it, and wire it
            to their own internal data sources.
          </p>
          <div class="mt-6">
            <Button href="/company/schedule" variant="primary" size="md">Talk about enterprise →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Where it fits ───────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Where it fits</span>
      <h2 class={H2}>Cupola and the rest of the data farm</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Cupola is the place you actually work with data. Haybarn is the engine inside it; VGI
        and the Orchard are how you connect live sources to query.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {neighbours.map((n) => (
          <a
            href={n.href}
            class={`${CARD} block p-6 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}
          >
            <span class="mb-3.5 flex h-10 w-10 items-center justify-center overflow-hidden rounded-[9px] border border-soil-300 bg-soil-100 text-[20px]">
              {n.img && <img src={n.img} alt="" width="24" height="24" class="h-6 w-6 object-contain" />}
              {n.emoji && <span aria-hidden="true">{n.emoji}</span>}
            </span>
            <h3 class="text-lg text-soil-900">{n.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{n.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">See your data in a new light</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            Cupola is free, open source, and ready now. Open a live example, or point it at your
            own source.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href={EXAMPLE_LAUNCH} variant="primary" size="md" external>Try the live example</Button>
          <Button href={CUPOLA_REPO} variant="secondary" size="md" external>View on GitHub</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
