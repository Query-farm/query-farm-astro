---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ExtensionCard from '../../components/products/ExtensionCard.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import { publicExtensions } from '../../data/extensions';
import { usageSummary } from '../../data/usage-summary';

interface SubBucket { title?: string; slugs: string[] }
interface Bucket {
  id: string;
  title: string;
  blurb: string;
  icon: string;
  /** Tailwind class fragments for the section's color theme. */
  theme: { iconBg: string; iconText: string; titleText: string; sectionBg: string; sectionBorder: string };
  subs: SubBucket[];
}

const TAXONOMY: Bucket[] = [
  { id:'connect', icon:'🔌',
    title:'Connect to external systems',
    blurb:'Read from, write to, or stand alongside another system.',
    theme:{ iconBg:'bg-sky-200',     iconText:'text-sky-800',     titleText:'text-sky-900',     sectionBg:'bg-sky-50',     sectionBorder:'border-sky-200' },
    subs: [
      { title:'Databases',           slugs:['adbc_scanner','airport','redis','vgi'] },
      { title:'Messaging & streams', slugs:['tributary','radio'] },
      { title:'HTTP & shell',        slugs:['http_client','httpserver','shellfs'] },
    ]},
  { id:'json', icon:'🧩',
    title:'Work with JSON',
    blurb:'Query, reshape, and validate JSON columns.',
    theme:{ iconBg:'bg-cyan-200',    iconText:'text-cyan-800',    titleText:'text-cyan-900',    sectionBg:'bg-cyan-50',    sectionBorder:'border-cyan-200' },
    subs: [{ slugs:['jsonata','json_schema'] }]},
  { id:'text', icon:'🔤',
    title:'Work with text & identifiers',
    blurb:'Hash, match, transform strings, and mint stable IDs.',
    theme:{ iconBg:'bg-violet-200',  iconText:'text-violet-800',  titleText:'text-violet-900',  sectionBg:'bg-violet-50',  sectionBorder:'border-violet-200' },
    subs: [
      { title:'Hashing',           slugs:['crypto','hashfuncs'] },
      { title:'Matching & casing', slugs:['rapidfuzz','inflector'] },
      { title:'Identifiers',       slugs:['tsid'] },
    ]},
  { id:'analytics', icon:'🧠',
    title:'Make analytics approximate or fast',
    blurb:'Sketches, probabilistic filters, distributions, and lookup indices.',
    theme:{ iconBg:'bg-fuchsia-200', iconText:'text-fuchsia-800', titleText:'text-fuchsia-900', sectionBg:'bg-fuchsia-50', sectionBorder:'border-fuchsia-200' },
    subs: [
      { title:'Sketches',      slugs:['datasketches','bitfilters'] },
      { title:'Distributions', slugs:['stochastic'] },
      { title:'Indexing',      slugs:['marisa'] },
    ]},
  { id:'geo', icon:'🗺️',
    title:'Index or compress geospatial data',
    blurb:'Pentagonal cell indexes, compact geometry, space-filling curves.',
    theme:{ iconBg:'bg-emerald-200', iconText:'text-emerald-800', titleText:'text-emerald-900', sectionBg:'bg-emerald-50', sectionBorder:'border-emerald-200' },
    subs: [{ slugs:['a5','geosilo','lindel'] }]},
  { id:'render', icon:'📝',
    title:'Render or execute code from rows',
    blurb:'Templates, scripting engines, URL-loaded macros.',
    theme:{ iconBg:'bg-rose-200',    iconText:'text-rose-800',    titleText:'text-rose-900',    sectionBg:'bg-rose-50',    sectionBorder:'border-rose-200' },
    subs: [
      { title:'Templates',       slugs:['minijinja','tera'] },
      { title:'Scripting',       slugs:['quickjs','evalexpr_rhai'] },
      { title:'Macros from URL', slugs:['webmacro'] },
    ]},
  { id:'operate', icon:'⏰',
    title:'Operate your DuckDB process',
    blurb:'Schedule queries; capture and forward events.',
    theme:{ iconBg:'bg-amber-200',   iconText:'text-amber-800',   titleText:'text-amber-900',   sectionBg:'bg-amber-50',   sectionBorder:'border-amber-200' },
    subs: [{ slugs:['cronjob','events'] }]},
  { id:'ergonomics', icon:'✨',
    title:'SQL ergonomics',
    blurb:'Make the CLI nicer, make output prettier.',
    theme:{ iconBg:'bg-slate-200',   iconText:'text-slate-800',   titleText:'text-slate-900',   sectionBg:'bg-slate-50',   sectionBorder:'border-slate-200' },
    subs: [{ slugs:['textplot','fuzzycomplete'] }]},
];

// Lookup helpers
const bySlug = Object.fromEntries(publicExtensions.map(e => [e.id, e]));
const totalExtensions = publicExtensions.length;

// Coverage check — fail loudly if a slug is misspelled or an extension was
// added without being placed in the taxonomy.
const placed = new Set(TAXONOMY.flatMap(b => b.subs.flatMap(s => s.slugs)));
const missingFromTaxonomy = publicExtensions.map(e => e.id).filter(id => !placed.has(id));
const slugsNotFound = [...placed].filter(s => !bySlug[s]);
if (missingFromTaxonomy.length || slugsNotFound.length) {
  throw new Error(
    `Taxonomy/data mismatch:\n` +
    (missingFromTaxonomy.length ? `  not placed: ${missingFromTaxonomy.join(', ')}\n` : '') +
    (slugsNotFound.length ? `  unknown slug: ${slugsNotFound.join(', ')}\n` : '')
  );
}

// Compact-format large counts: 1,234,567 → "1.2M".
function compactCount(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
}

// Short week-start label, e.g. "2026-04-20" → "Apr 20".
function weekLabel(ymd: string): string {
  const [, mm, dd] = ymd.split('-');
  const month = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(mm) - 1] ?? '';
  return `${month} ${Number(dd)}`;
}

// Bar-chart geometry — viewBox-driven so the SVG scales fluidly.
const CHART_VW = 600;
const CHART_VH = 200;
const CHART_PAD = { top: 24, right: 8, bottom: 32, left: 8 };
const buckets = usageSummary?.weeklyBuckets ?? [];
const maxLoads = buckets.reduce((m, b) => Math.max(m, b.loads), 0);
const innerW = CHART_VW - CHART_PAD.left - CHART_PAD.right;
const innerH = CHART_VH - CHART_PAD.top - CHART_PAD.bottom;
const barGap = 6;
const barW = buckets.length > 0 ? (innerW - barGap * (buckets.length - 1)) / buckets.length : 0;

// SEO: structured data. This collection page + a machine-readable ItemList of
// every extension, the breadcrumb trail, and an FAQ. Mirrors the per-extension
// detail pages in [slug].astro, which already declare their place pointing up
// to this URL — this closes the other direction of the graph.
const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/extensions`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'DuckDB Extensions',
    description: `Browse ${totalExtensions} DuckDB extensions from Query.Farm, organized by what you're trying to do.`,
    url: pageUrl,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: totalExtensions,
      itemListElement: publicExtensions.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: e.name,
        url: `${SITE_ORIGIN}/products/extensions/${e.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'DuckDB Extensions', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a DuckDB extension?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "A DuckDB extension is native code that loads inside DuckDB and runs as part of it — the fastest way to add features DuckDB doesn't ship with, with no separate service to run.",
        },
      },
      {
        '@type': 'Question',
        name: 'How do I install a DuckDB extension?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Run INSTALL extension_name FROM community; then LOAD extension_name; in DuckDB. Query.Farm extensions are published to the DuckDB community repository, signed and verified.',
        },
      },
      {
        '@type': 'Question',
        name: "Are Query.Farm's DuckDB extensions free?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Most are open source and free to install from the DuckDB community repository; a few advanced extensions are commercial. Each extension page lists its license and pricing.',
        },
      },
    ],
  },
];

// Flat rows for the sortable/filterable table view. Initial order matches the
// table's default sort (loads desc, unknown loads last, then name) so the
// server-rendered markup is already correct before the sort script loads.
const titleCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const tableRows = [...publicExtensions].sort(
  (a, b) => (b.usageCount ?? -1) - (a.usageCount ?? -1) || a.name.localeCompare(b.name),
);
---

<PageLayout
  title="DuckDB Extensions — Browse by What You Need"
  description={`Browse ${totalExtensions} DuckDB extensions from Query.Farm — for JSON, geospatial, text, crypto, streaming and more. Install in seconds with INSTALL … FROM community.`}
  jsonLd={jsonLd}
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'DuckDB Extensions', href: '/products/extensions' }
  ]}
>
  <!-- Hero -->
  <Hero
    title="DuckDB Extensions"
    logo={{ src: "/images/duckdb-icon.svg", alt: "DuckDB" }}
    subtitle="Add-ons that load inside DuckDB and give it abilities it doesn't ship with — grouped by the job you're trying to do."
    primaryCTA={{ text: "Browse extensions ↓", href: "#connect" }}
  />

  <!-- What an extension is / why Query.Farm builds them -->
  <section class="py-16 lg:py-24 bg-white border-b border-soil-200">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="What is a DuckDB extension?"
          title="Where DuckDB ends, extensions begin."
        />
        <p class="text-lg text-soil-600 max-w-3xl mt-6">
          An extension is native code that loads inside DuckDB and runs as part of it — the fastest way
          to add features DuckDB doesn't ship with, with no separate service to run. It's also the right
          home for capabilities that are too specialized to land in DuckDB itself but that data engineers,
          analysts, and data scientists need anyway.
        </p>
        <p class="text-lg text-soil-600 max-w-3xl mt-4">
          Query.Farm is one of the foremost builders of them. We ship and maintain dozens, available both
          through DuckDB's community extension channel and through
          <a href="/haybarn" class="text-harvest-700 font-medium underline underline-offset-2 hover:text-harvest-800">Haybarn</a>,
          Query.Farm's own distribution of DuckDB.
        </p>

        <div class="grid sm:grid-cols-3 gap-6 mt-12">
          <Card padding="md">
            <h3 class="text-lg font-bold text-soil-900">Runs inside DuckDB</h3>
            <p class="text-soil-600 mt-2">
              Extensions execute as native code alongside your query — no network round-trip, no separate
              service, no added latency.
            </p>
          </Card>
          <Card padding="md">
            <h3 class="text-lg font-bold text-soil-900">Fills the gaps</h3>
            <p class="text-soil-600 mt-2">
              When a capability is too niche or too complex for DuckDB itself, an extension delivers it
              without bending your pipeline around the gap.
            </p>
          </Card>
          <Card padding="md">
            <h3 class="text-lg font-bold text-soil-900">Expert-built</h3>
            <p class="text-soil-600 mt-2">
              Each one is built and maintained by Query.Farm, available through DuckDB's community channel
              and through Haybarn, our DuckDB distribution.
            </p>
          </Card>
        </div>

        <div class="mt-12 flex flex-col sm:flex-row sm:items-center gap-4">
          <p class="text-soil-600">Need something that doesn't exist yet? We can build it.</p>
          <Button variant="primary" href="/consulting">Commission a custom extension →</Button>
        </div>
      </div>
    </div>
  </section>

  {usageSummary && buckets.length > 0 && (
    <section class="py-12 lg:py-16 bg-soil-50 border-b border-soil-200">
      <div class="section-container">
        <div class="max-w-5xl mx-auto">
          <div class="text-xs uppercase tracking-wider text-harvest-600 font-semibold mb-8 text-center md:text-left">
            Used in production, everywhere
          </div>
        <div class="grid md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center">
          <div class="text-center md:text-left">
            <div class="text-5xl lg:text-6xl font-bold text-harvest-600 leading-none">
              {compactCount(usageSummary.annualizedLoads)}+
            </div>
            <div class="mt-2 text-sm uppercase tracking-wide text-soil-600 font-medium">
              extension loads per year
            </div>
            <div class="mt-1 text-xs text-soil-500">
              Annualized from the last {usageSummary.windowDays} days · across {totalExtensions} Query.Farm extensions
            </div>
          </div>

          <div>
            <div class="text-xs uppercase tracking-wide text-soil-600 font-medium mb-2">
              Weekly loads · last {buckets.length} complete weeks
            </div>
            <svg
              viewBox={`0 0 ${CHART_VW} ${CHART_VH}`}
              role="img"
              aria-label={`Bar chart of weekly extension loads over the last ${buckets.length} complete weeks`}
              class="w-full h-auto"
              preserveAspectRatio="xMidYMid meet"
            >
              {buckets.map((b, i) => {
                const h = maxLoads === 0 ? 0 : (b.loads / maxLoads) * innerH;
                const x = CHART_PAD.left + i * (barW + barGap);
                const y = CHART_PAD.top + (innerH - h);
                return (
                  <g>
                    <text
                      x={x + barW / 2}
                      y={y - 6}
                      text-anchor="middle"
                      class="fill-soil-700"
                      style="font-size: 11px; font-weight: 600;"
                    >
                      {compactCount(b.loads)}
                    </text>
                    <rect
                      x={x}
                      y={y}
                      width={barW}
                      height={h}
                      rx="3"
                      class="fill-harvest-500"
                    />
                    <text
                      x={x + barW / 2}
                      y={CHART_PAD.top + innerH + 18}
                      text-anchor="middle"
                      class="fill-soil-600"
                      style="font-size: 10px;"
                    >
                      {weekLabel(b.weekStarting)}
                    </text>
                  </g>
                );
              })}
            </svg>
          </div>
        </div>
        </div>
      </div>
    </section>
  )}

  <!-- Bucket sections -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Browse by intent"
        title="What are you trying to do?"
        description="Pick an intent below. Each section groups the extensions that solve that class of problem, with finer-grained sub-buckets where useful."
        class="mb-12"
      />

      <!-- View toggle: Cards (default, browse by intent) / Table (find & compare) -->
      <div class="flex justify-center mb-12">
        <div role="tablist" aria-label="Extension view" class="inline-flex rounded-lg border border-soil-300 bg-white p-1 shadow-sm">
          <button id="view-cards-btn" type="button" role="tab" aria-selected="true"
            class="px-4 py-2 text-sm font-medium rounded-md transition-colors bg-harvest-600 text-white">
            <span aria-hidden="true">▣</span> Cards
          </button>
          <button id="view-table-btn" type="button" role="tab" aria-selected="false"
            class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-soil-700 hover:text-soil-900">
            <span aria-hidden="true">☰</span> Table
          </button>
        </div>
      </div>

      <!-- Cards view -->
      <div id="cards-view">
      <div class="space-y-20">
        {TAXONOMY.map((bucket) => (
          <section id={bucket.id} class="scroll-mt-24">
            <div class={`flex items-start gap-4 mb-10 p-6 rounded-2xl border ${bucket.theme.sectionBg} ${bucket.theme.sectionBorder}`}>
              <div class={`w-12 h-12 rounded-xl ${bucket.theme.iconBg} ${bucket.theme.iconText} flex items-center justify-center text-2xl shrink-0`}>
                {bucket.icon}
              </div>
              <div class="flex-1">
                <h2 class={`text-2xl md:text-3xl font-bold leading-tight ${bucket.theme.titleText}`}>
                  {bucket.title}
                </h2>
                <p class="text-soil-600 mt-1">{bucket.blurb}</p>
              </div>
            </div>

            <div class="space-y-14">
              {bucket.subs.map((sub) => (
                <div>
                  {sub.title && (
                    <h3 class="text-xl md:text-2xl font-bold text-soil-900 mt-6 mb-6">
                      {sub.title}
                    </h3>
                  )}
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {sub.slugs.map((slug) => {
                      const e = bySlug[slug];
                      return e && <ExtensionCard {...e} />;
                    })}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
      </div>

      <!-- Table view (hidden until toggled) -->
      <div id="table-view" hidden>
        <div class="max-w-5xl mx-auto">
          <label class="sr-only" for="ext-filter">Filter extensions</label>
          <input id="ext-filter" type="search" autocomplete="off"
            placeholder="Filter by name, description, or category…"
            class="w-full mb-6 px-4 py-3 rounded-lg border border-soil-300 bg-white text-soil-900 placeholder-soil-400 focus:outline-none focus:ring-2 focus:ring-harvest-400 focus:border-harvest-400" />

          <div class="overflow-x-auto rounded-xl border border-soil-200 bg-white shadow-sm">
            <table class="w-full text-left border-collapse">
              <thead class="bg-soil-100 text-soil-700 text-xs uppercase tracking-wide">
                <tr>
                  <th scope="col" data-sort="name" aria-sort="none" class="js-sort px-4 py-3 font-semibold cursor-pointer select-none hover:text-soil-900">
                    Extension <span data-arrow class="text-harvest-600"></span>
                  </th>
                  <th scope="col" data-sort="category" aria-sort="none" class="js-sort px-4 py-3 font-semibold cursor-pointer select-none hover:text-soil-900">
                    Category <span data-arrow class="text-harvest-600"></span>
                  </th>
                  <th scope="col" data-sort="loads" aria-sort="descending" class="js-sort px-4 py-3 font-semibold cursor-pointer select-none hover:text-soil-900 text-right">
                    Loads <span data-arrow class="text-harvest-600">▼</span>
                  </th>
                  <th scope="col" data-sort="status" aria-sort="none" class="js-sort px-4 py-3 font-semibold cursor-pointer select-none hover:text-soil-900">
                    Status <span data-arrow class="text-harvest-600"></span>
                  </th>
                </tr>
              </thead>
              <tbody id="ext-tbody" class="divide-y divide-soil-100">
                {tableRows.map((e) => {
                  const cat = titleCase(e.category);
                  const search = `${e.name} ${e.id} ${e.description} ${cat}`.toLowerCase();
                  return (
                    <tr
                      data-name={e.name.toLowerCase()}
                      data-category={cat.toLowerCase()}
                      data-loads={e.usageCount ?? -1}
                      data-status={e.status}
                      data-search={search}
                      class="hover:bg-soil-50 transition-colors"
                    >
                      <td class="px-4 py-3 align-top">
                        <a href={`/products/extensions/${e.id}`} class="font-semibold text-soil-900 hover:text-harvest-700">
                          {e.icon && <span class="mr-1.5" aria-hidden="true">{e.icon}</span>}{e.name}
                        </a>
                        <code class="block text-xs text-soil-500 font-mono">{e.id}</code>
                      </td>
                      <td class="px-4 py-3 align-top text-soil-700 whitespace-nowrap">{cat}</td>
                      <td class="px-4 py-3 align-top text-right tabular-nums whitespace-nowrap"
                        title={typeof e.usageCount === 'number' ? `${e.usageCount.toLocaleString()} loads${e.usagePeriod ? ` · ${e.usagePeriod}` : ''}` : 'Just released'}>
                        {typeof e.usageCount === 'number'
                          ? <span class="text-soil-900 font-medium">{compactCount(e.usageCount)}</span>
                          : <span class="text-sky-700">New</span>}
                      </td>
                      <td class="px-4 py-3 align-top">
                        <span class:list={[
                          'inline-block px-2 py-0.5 rounded-full text-xs font-medium capitalize',
                          e.status === 'stable' && 'bg-emerald-100 text-emerald-800',
                          e.status === 'beta' && 'bg-amber-100 text-amber-800',
                          e.status === 'experimental' && 'bg-rose-100 text-rose-800',
                        ]}>{e.status}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p id="ext-empty" hidden class="text-center text-soil-500 py-8">No extensions match your filter.</p>
          <p class="mt-4 text-xs text-soil-500 text-center">Click a column header to sort · {totalExtensions} extensions</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // View toggle + client-side sort/filter for the extensions table. No React;
    // both views are server-rendered, this only shows/hides and reorders rows.
    const cardsBtn = document.getElementById('view-cards-btn');
    const tableBtn = document.getElementById('view-table-btn');
    const cardsView = document.getElementById('cards-view');
    const tableView = document.getElementById('table-view');

    function setView(view: 'cards' | 'table') {
      const isTable = view === 'table';
      if (tableView) tableView.hidden = !isTable;
      if (cardsView) cardsView.hidden = isTable;
      for (const [btn, active] of [[tableBtn, isTable], [cardsBtn, !isTable]] as const) {
        if (!btn) continue;
        btn.setAttribute('aria-selected', String(active));
        btn.classList.toggle('bg-harvest-600', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('text-soil-700', !active);
      }
    }
    cardsBtn?.addEventListener('click', () => setView('cards'));
    tableBtn?.addEventListener('click', () => setView('table'));

    // Filter
    const filterInput = document.getElementById('ext-filter') as HTMLInputElement | null;
    const tbody = document.getElementById('ext-tbody');
    const emptyMsg = document.getElementById('ext-empty');
    const rows = tbody ? Array.from(tbody.querySelectorAll('tr')) : [];

    function applyFilter() {
      const q = (filterInput?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const r of rows) {
        const show = !q || (r.getAttribute('data-search') || '').includes(q);
        (r as HTMLElement).hidden = !show;
        if (show) visible++;
      }
      if (emptyMsg) emptyMsg.hidden = visible !== 0;
    }
    filterInput?.addEventListener('input', applyFilter);

    // Sort — initial state mirrors the server-rendered order (loads, descending).
    let sortKey = 'loads';
    let sortDir = -1;
    const heads = Array.from(document.querySelectorAll<HTMLElement>('th.js-sort'));

    function valFor(r: Element, key: string): number | string {
      if (key === 'loads') return Number(r.getAttribute('data-loads'));
      return r.getAttribute('data-' + key) || '';
    }
    function sortBy(key: string) {
      if (sortKey === key) sortDir *= -1;
      else { sortKey = key; sortDir = key === 'loads' ? -1 : 1; }
      const sorted = rows.slice().sort((a, b) => {
        const av = valFor(a, key), bv = valFor(b, key);
        let cmp = typeof av === 'number'
          ? (av as number) - (bv as number)
          : String(av).localeCompare(String(bv));
        if (cmp === 0) cmp = (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        return cmp * sortDir;
      });
      for (const r of sorted) tbody?.appendChild(r);
      for (const h of heads) {
        const k = h.getAttribute('data-sort');
        const arrow = h.querySelector('[data-arrow]');
        const active = k === sortKey;
        if (arrow) arrow.textContent = active ? (sortDir === 1 ? '▲' : '▼') : '';
        h.setAttribute('aria-sort', active ? (sortDir === 1 ? 'ascending' : 'descending') : 'none');
      }
    }
    for (const h of heads) {
      h.addEventListener('click', () => sortBy(h.getAttribute('data-sort') || 'name'));
    }
  </script>

