---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ExtensionCategory from '../../components/products/ExtensionCategory.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import { extensions, extensionsByCategory, categoryInfo } from '../../data/extensions';

// Group extensions by category
const groupedExtensions = extensionsByCategory();
const categories = Object.keys(groupedExtensions) as Array<keyof typeof categoryInfo>;
---

<PageLayout
  title="DuckDB Extensions"
  description="Extend DuckDB with 20+ specialized extensions for data connectors, transformations, analytics, performance, and more."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Extensions', href: '/products/extensions' }
  ]}
>
  <!-- Hero Section -->
  <Hero
    title="DuckDB Extensions"
    subtitle="20+ specialized extensions to supercharge your DuckDB workflows. Connect to any data source, transform with powerful functions, and optimize performance."
    primaryCTA={{ text: "View on GitHub", href: "https://github.com/queryfarm" }}
    secondaryCTA={{ text: "Contact Sales", href: "/company/schedule" }}
  />

  <!-- Stats Section -->
  <section class="py-12 bg-white border-b border-soil-200">
    <div class="section-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-harvest-600 mb-2">{extensions.length}+</div>
          <div class="text-sm text-soil-600">Extensions</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-harvest-600 mb-2">6</div>
          <div class="text-sm text-soil-600">Categories</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-harvest-600 mb-2">100%</div>
          <div class="text-sm text-soil-600">Open Source</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-harvest-600 mb-2">24/7</div>
          <div class="text-sm text-soil-600">Support</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Extensions by Category -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Browse Extensions"
        title="Organized by Category"
        description="Find the perfect extension for your use case. All extensions are production-ready and actively maintained."
        class="mb-16"
      />

      <div class="space-y-20">
        {categories.map(categoryKey => {
          const category = categoryInfo[categoryKey];
          const categoryExtensions = groupedExtensions[categoryKey];

          return (
            <ExtensionCategory
              title={category.title}
              description={category.description}
              icon={category.icon}
              extensions={categoryExtensions}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- Installation Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="Getting Started"
          title="Easy Installation"
          description="Install any Query.Farm extension in seconds with DuckDB's built-in extension system."
          class="mb-12"
        />

        <Card padding="lg" class="bg-soil-900 text-soil-50 border-soil-800">
          <h3 class="text-lg font-semibold mb-4 text-white">Install from Query.Farm Repository</h3>
          <pre class="bg-soil-950 p-4 rounded-lg overflow-x-auto mb-4"><code class="text-sm text-harvest-400">-- Install an extension
INSTALL extension_name FROM 'query.farm';

-- Load the extension
LOAD extension_name;

-- Start using it!
SELECT * FROM your_function();</code></pre>

          <p class="text-sm text-soil-300">
            All extensions are signed and verified. View full documentation and examples on our GitHub repository.
          </p>
        </Card>

        <div class="mt-8 text-center">
          <Button href="https://docs.query.farm/extensions" variant="secondary" size="lg" external>
            View Documentation
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Why Query.Farm Extensions"
        title="Built for Production"
        description="Enterprise-grade extensions with professional support and active development."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
            🚀
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">High Performance</h3>
          <p class="text-soil-700 leading-relaxed">
            Optimized for speed with vectorized execution and minimal overhead. Built using DuckDB's native APIs.
          </p>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-grain-100 flex items-center justify-center text-4xl">
            🔒
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Secure & Tested</h3>
          <p class="text-soil-700 leading-relaxed">
            Comprehensive test coverage, security audits, and regular updates. Safe for production workloads.
          </p>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-duck-100 flex items-center justify-center text-4xl">
            📚
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Well Documented</h3>
          <p class="text-soil-700 leading-relaxed">
            Clear documentation, examples, and tutorials. Get started quickly with our comprehensive guides.
          </p>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-earth-100 flex items-center justify-center text-4xl">
            🤝
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Expert Support</h3>
          <p class="text-soil-700 leading-relaxed">
            Direct access to extension authors. Priority support available for enterprise customers.
          </p>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
            🔄
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Active Development</h3>
          <p class="text-soil-700 leading-relaxed">
            Regular updates, new features, and compatibility with latest DuckDB versions. Always improving.
          </p>
        </Card>

        <Card padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-grain-100 flex items-center justify-center text-4xl">
            💼
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Enterprise Ready</h3>
          <p class="text-soil-700 leading-relaxed">
            Commercial licensing available. Custom development and dedicated support for your organization.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Need a Custom Extension?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Our team can build custom DuckDB extensions tailored to your specific needs.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/schedule" variant="secondary" size="lg">
          Schedule Consultation
        </Button>
        <Button href="/consulting" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Learn About Consulting
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
