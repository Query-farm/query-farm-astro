---
import PageLayout from '../../layouts/PageLayout.astro';
import ExtensionsSubNav from '../../components/sections/ExtensionsSubNav.astro';
import ExtensionCard from '../../components/products/ExtensionCard.astro';
import ExtensionIcon from '../../components/products/ExtensionIcon.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { publicExtensions } from '../../data/extensions';
import { usageSummary } from '../../data/usage-summary';

interface SubBucket { title?: string; slugs: string[] }
interface Bucket {
  id: string;
  /** Long form, used for the section blurb and the pill's title attribute. */
  title: string;
  /** Short form for the filter pill. */
  pill: string;
  blurb: string;
  subs: SubBucket[];
}

// The intent taxonomy. It is curated, not derived: it says what a reader is
// trying to *do*, which the per-extension `category` field does not. The
// coverage check below fails the build if an extension is added without being
// placed here, so the pills can never silently under-report the catalog.
const TAXONOMY: Bucket[] = [
  { id:'connect', pill:'Connectors',
    title:'Connect to external systems',
    blurb:'Read from, write to, or stand alongside another system.',
    subs: [
      { title:'Databases',           slugs:['adbc_scanner','airport','redis','vgi'] },
      { title:'Messaging & streams', slugs:['tributary','radio'] },
      { title:'HTTP & shell',        slugs:['http_client','httpserver','shellfs'] },
    ]},
  { id:'json', pill:'JSON',
    title:'Work with JSON',
    blurb:'Query, reshape, and validate JSON columns.',
    subs: [{ slugs:['jsonata','json_schema'] }]},
  { id:'text', pill:'Text & IDs',
    title:'Work with text & identifiers',
    blurb:'Hash, match, transform strings, and mint stable IDs.',
    subs: [
      { title:'Hashing',           slugs:['crypto','hashfuncs'] },
      { title:'Matching & casing', slugs:['rapidfuzz','inflector'] },
      { title:'Identifiers',       slugs:['tsid'] },
    ]},
  { id:'analytics', pill:'Analytics',
    title:'Make analytics approximate or fast',
    blurb:'Sketches, probabilistic filters, distributions, and lookup indices.',
    subs: [
      { title:'Sketches',      slugs:['datasketches','bitfilters'] },
      { title:'Distributions', slugs:['stochastic'] },
      { title:'Indexing',      slugs:['marisa'] },
    ]},
  { id:'geo', pill:'Geospatial',
    title:'Index or compress geospatial data',
    blurb:'Pentagonal cell indexes, compact geometry, space-filling curves.',
    subs: [{ slugs:['a5','geosilo','lindel'] }]},
  { id:'render', pill:'Scripting',
    title:'Render or execute code from rows',
    blurb:'Templates, scripting engines, URL-loaded macros.',
    subs: [
      { title:'Templates',       slugs:['minijinja','tera'] },
      { title:'Scripting',       slugs:['quickjs','evalexpr_rhai'] },
      { title:'Macros from URL', slugs:['webmacro'] },
    ]},
  { id:'operate', pill:'Operations',
    title:'Operate your DuckDB process',
    blurb:'Schedule queries; capture and forward events.',
    subs: [{ slugs:['cronjob','events'] }]},
  { id:'ergonomics', pill:'Ergonomics',
    title:'SQL ergonomics',
    blurb:'Make the CLI nicer, make output prettier.',
    subs: [{ slugs:['textplot','fuzzycomplete'] }]},
];

// Lookup helpers
const bySlug = Object.fromEntries(publicExtensions.map(e => [e.id, e]));
const totalExtensions = publicExtensions.length;

// Coverage check — fail loudly if a slug is misspelled or an extension was
// added without being placed in the taxonomy.
const placed = new Set(TAXONOMY.flatMap(b => b.subs.flatMap(s => s.slugs)));
const missingFromTaxonomy = publicExtensions.map(e => e.id).filter(id => !placed.has(id));
const slugsNotFound = [...placed].filter(s => !bySlug[s]);
if (missingFromTaxonomy.length || slugsNotFound.length) {
  throw new Error(
    `Taxonomy/data mismatch:\n` +
    (missingFromTaxonomy.length ? `  not placed: ${missingFromTaxonomy.join(', ')}\n` : '') +
    (slugsNotFound.length ? `  unknown slug: ${slugsNotFound.join(', ')}\n` : '')
  );
}

// slug → bucket, for the pill filter and the table's category column.
const bucketOf: Record<string, Bucket> = {};
for (const bucket of TAXONOMY) {
  for (const sub of bucket.subs) {
    for (const slug of sub.slugs) bucketOf[slug] = bucket;
  }
}
const bucketCounts = TAXONOMY.map(b => ({
  ...b,
  count: b.subs.reduce((n, s) => n + s.slugs.filter(slug => bySlug[slug]).length, 0),
}));

// Compact-format large counts: 1,234,567 → "1.2M".
function compactCount(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
}

// Short week-start label, e.g. "2026-04-20" → "Apr 20".
function weekLabel(ymd: string): string {
  const [, mm, dd] = ymd.split('-');
  const month = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(mm) - 1] ?? '';
  return `${month} ${Number(dd)}`;
}

// Bar-chart geometry — viewBox-driven so the SVG scales fluidly.
const CHART_VW = 600;
const CHART_VH = 150;
const CHART_PAD = { top: 18, right: 2, bottom: 20, left: 2 };
const buckets = usageSummary?.weeklyBuckets ?? [];
const maxLoads = buckets.reduce((m, b) => Math.max(m, b.loads), 0);
const innerW = CHART_VW - CHART_PAD.left - CHART_PAD.right;
const innerH = CHART_VH - CHART_PAD.top - CHART_PAD.bottom;
// Gap was 5 against a ~45px bar: the twelve bars fused into one gold slab and
// the week-to-week shape stopped reading. 10 separates them without making the
// bars look like tally marks.
const barGap = 10;
const barW = buckets.length > 0 ? (innerW - barGap * (buckets.length - 1)) / buckets.length : 0;
// A label above every bar was noise. The two numbers worth stating go in the
// header instead, and the bars carry the shape.
const peakLoads = buckets.reduce((m, b) => Math.max(m, b.loads), 0);
const latestLoads = buckets.length ? buckets[buckets.length - 1].loads : 0;

// Ordering: loads descending, unknown loads last, then name. The first slice
// gets cards; the tail goes into the dense table.
const ranked = [...publicExtensions].sort(
  (a, b) => (b.usageCount ?? -1) - (a.usageCount ?? -1) || a.name.localeCompare(b.name),
);
const CARD_COUNT = 12;
const featured = ranked.slice(0, CARD_COUNT);
const tail = ranked.slice(CARD_COUNT);
const maxUsageCount = ranked[0]?.usageCount;
const usagePeriodLabel = ranked.find(e => e.usagePeriod)?.usagePeriod ?? 'last 90 days';

const searchKey = (e: (typeof publicExtensions)[number]) =>
  `${e.name} ${e.id} ${e.description} ${bucketOf[e.id]?.pill ?? ''} ${bucketOf[e.id]?.title ?? ''}`.toLowerCase();

// SEO: structured data. This collection page + a machine-readable ItemList of
// every extension, the breadcrumb trail, and an FAQ. Mirrors the per-extension
// detail pages in [slug].astro, which already declare their place pointing up
// to this URL — this closes the other direction of the graph.
const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/extensions`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'DuckDB Extensions',
    description: `Browse ${totalExtensions} DuckDB extensions from Query.Farm, organized by what you're trying to do.`,
    url: pageUrl,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: totalExtensions,
      itemListElement: publicExtensions.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: e.name,
        url: `${SITE_ORIGIN}/products/extensions/${e.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'DuckDB Extensions', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a DuckDB extension?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "A DuckDB extension is native code that loads inside DuckDB and runs as part of it — the fastest way to add features DuckDB doesn't ship with, with no separate service to run.",
        },
      },
      {
        '@type': 'Question',
        name: 'How do I install a DuckDB extension?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Run INSTALL extension_name FROM community; then LOAD extension_name; in DuckDB. Query.Farm extensions are published to the DuckDB community repository, signed and verified.',
        },
      },
      {
        '@type': 'Question',
        name: "Are Query.Farm's DuckDB extensions free?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Most are open source and free to install from the DuckDB community repository; a few advanced extensions are commercial. Each extension page lists its license and pricing.',
        },
      },
    ],
  },
];

const installSnippet = `-- Install an extension
INSTALL airport FROM community;

-- Load it into your session
LOAD airport;`;
---

<PageLayout
  title="DuckDB Extensions — Browse by What You Need"
  description={`Browse ${totalExtensions} DuckDB extensions from Query.Farm — for JSON, geospatial, text, crypto, streaming and more. Install in seconds with INSTALL … FROM community.`}
  jsonLd={jsonLd}
>
  <ExtensionsSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'DuckDB Extensions', href: '/products/extensions' }
    ]}
  />

  <div class="mx-auto w-full max-w-[1360px] px-5 sm:px-7">
    <!-- What an extension is / how to install one -->
    <div class="grid gap-10 pt-12 lg:grid-cols-[minmax(0,1fr)_420px]">
      <div>
        <p class="qf-eyebrow text-sun-700">What is a DuckDB extension?</p>
        <h1 class="mt-3 font-display text-4xl text-soil-900 md:text-5xl">Where DuckDB ends, extensions begin.</h1>
        <p class="mt-4 max-w-[62ch] text-soil-700">
          An extension is native code that loads inside DuckDB and runs as part of it — the fastest way
          to add features DuckDB doesn't ship with, with no separate service to run. It is also the right
          home for capabilities too specialized to land in DuckDB itself but that data engineers,
          analysts, and scientists need anyway.
        </p>
        <p class="mt-4 max-w-[62ch] text-soil-700">
          Query.Farm is one of the foremost builders of them. We ship and maintain dozens, available both
          through DuckDB's community extension channel and through
          <a href="/haybarn" class="text-link underline decoration-link/45 underline-offset-2 hover:decoration-link">Haybarn</a>,
          Query.Farm's own distribution of DuckDB.
        </p>

        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="font-display text-lg text-soil-900">Runs inside DuckDB</dt>
            <dd class="mt-1.5 text-sm text-soil-700">
              Native code alongside your query — no network round-trip, no separate service, no added latency.
            </dd>
          </div>
          <div>
            <dt class="font-display text-lg text-soil-900">Fills the gaps</dt>
            <dd class="mt-1.5 text-sm text-soil-700">
              When a capability is too niche for DuckDB itself, an extension delivers it without bending
              your pipeline around the gap.
            </dd>
          </div>
          <div>
            <dt class="font-display text-lg text-soil-900">Expert-built</dt>
            <dd class="mt-1.5 text-sm text-soil-700">
              Each one is built and maintained by Query.Farm, signed and published to the community channel.
            </dd>
          </div>
        </dl>

        <div class="mt-9 rounded-2xl border border-soil-300/70 bg-white/70 p-6 sm:p-7">
          <p class="qf-eyebrow text-sun-700">Not in the catalog?</p>
          <p class="mt-2 font-display text-2xl text-soil-900">
            Need something that doesn't exist yet? We can build it.
          </p>
          <p class="mt-3 max-w-[56ch] text-soil-700">
            From a single scalar function to a full catalog integration — built, signed, and published
            under a licence you choose, in a repo you own.
          </p>
          <div class="mt-5">
            <Button variant="primary" href="/consulting">Commission a custom extension →</Button>
          </div>
        </div>
      </div>

      <div>
        <p class="qf-eyebrow text-sun-700">Getting started</p>
        <h2 class="mt-3 font-display text-2xl text-soil-900">Install one in two statements</h2>
        <p class="mt-3 text-sm text-soil-700">
          Query.Farm publishes to DuckDB's community repository, so you install these the same way you
          install any community extension — no extra setup, no custom repository.
        </p>
        <div class="mt-4">
          <CodeBlock code={installSnippet} lang="sql" tryable={false} />
        </div>
        {usageSummary && (
          <div class="mt-8 rounded-2xl border border-soil-300/70 bg-white/70 p-6">
            <div class="qf-figure text-[38px] leading-none text-sun-700">
              {usageSummary.annualizedLoads.toLocaleString()}
            </div>
            <div class="mt-2 text-[13px] font-medium text-soil-700">Loads per year · all extensions</div>
            <div class="mt-1 text-[12.5px] text-soil-500">
              Annualized from the <span class="qf-figure">{usageSummary.windowDays}</span>-day snapshot
            </div>
          </div>
        )}
      </div>
    </div>

    <p class="mt-14 border-t border-soil-300 pt-10 text-[13.5px] text-soil-600">
      Load counts come from the DuckDB community extension registry over a rolling
      {' '}{usageSummary?.windowDays ?? 90}-day window, refreshed at build time.
    </p>

    <!-- Weekly loads — measured, not modelled. Every bar keeps its own value
         and week label: this is the evidence behind the annual figure, and
         summarising it away costs the reader the shape AND the numbers. The
         restraint comes from weight — hairline gridlines, light label colour,
         the latest week emphasised — not from removing data.

         Chrome and data are deliberately on different scales. Everything
         structural (gridlines, baseline, tick and value labels) is neutral
         `rock` grey; gold is reserved for the bars themselves. The earlier
         version drew the axis in soil-200/300/500, which is the same warm
         hue as the sun bars: soil-500 labels sat ΔE76 19 from the sun-600
         emphasis bar and soil-200 gridlines ΔE76 33 from the sun-300 bars,
         so the axis read as a washed-out copy of the data rather than as a
         separate layer. rock-700 against the same sun-600 bar is ΔE76 45.

         preserveAspectRatio must stay xMidYMid meet: "none" stretches the
         viewBox to the container and distorts every text label with it. -->
    {usageSummary && buckets.length > 0 && (
      <figure class="mt-5 max-w-[860px] overflow-hidden rounded-xl border border-soil-300/70 bg-white/70">
        <figcaption class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-soil-300/70 px-4 py-2.5">
          <span class="text-[13px] font-medium text-soil-700">
            Weekly loads · last <span class="qf-figure">{buckets.length}</span> complete weeks
          </span>
          <span class="text-[12.5px] text-soil-500">
            peak <span class="qf-figure text-soil-700">{compactCount(peakLoads)}</span>
            <span aria-hidden="true"> · </span>
            latest <span class="qf-figure text-soil-700">{compactCount(latestLoads)}</span>
          </span>
        </figcaption>
        <div class="px-4 pb-3 pt-3">
          <svg
            viewBox={`0 0 ${CHART_VW} ${CHART_VH}`}
            role="img"
            aria-label={`Weekly extension loads over the last ${buckets.length} complete weeks. Peak ${compactCount(peakLoads)}, most recent ${compactCount(latestLoads)}.`}
            class="h-auto w-full"
            preserveAspectRatio="xMidYMid meet"
          >
            {/* Quarter lines, not [0.5, 1]: the 1.0 line landed exactly on the
                peak bar's top edge, so it read as an accident rather than a
                reference. Evenly spaced quarters give the height comparison
                across twelve bars and never coincide with a bar top. */}
            {[0.25, 0.5, 0.75].map(f => (
              <line
                x1={CHART_PAD.left} x2={CHART_VW - CHART_PAD.right}
                y1={CHART_PAD.top + innerH - innerH * f} y2={CHART_PAD.top + innerH - innerH * f}
                class="stroke-rock-700/20" stroke-width="1" shape-rendering="crispEdges"
              />
            ))}
            <line
              x1={CHART_PAD.left} x2={CHART_VW - CHART_PAD.right}
              y1={CHART_PAD.top + innerH + 0.5} y2={CHART_PAD.top + innerH + 0.5}
              class="stroke-rock-700/55" stroke-width="1" shape-rendering="crispEdges"
            />
            {buckets.map((b, i) => {
              const h = maxLoads === 0 ? 0 : Math.max((b.loads / maxLoads) * innerH, 1.5);
              const x = CHART_PAD.left + i * (barW + barGap);
              const y = CHART_PAD.top + (innerH - h);
              const isLast = i === buckets.length - 1;
              return (
                <g>
                  <text
                    x={x + barW / 2} y={y - 5} text-anchor="middle"
                    class={isLast ? 'qf-figure fill-rock-900' : 'qf-figure fill-rock-700'}
                    style={`font-size: 9.5px; ${isLast ? 'font-weight: 600;' : ''}`}
                  >{compactCount(b.loads)}</text>
                  <rect
                    x={x} y={y} width={barW} height={h} rx="1.5"
                    class={isLast ? 'fill-sun-600' : 'fill-sun-400'}
                  >
                    <title>{`${weekLabel(b.weekStarting)} · ${b.loads.toLocaleString()} loads`}</title>
                  </rect>
                  <text
                    x={x + barW / 2} y={CHART_PAD.top + innerH + 13} text-anchor="middle"
                    class="qf-figure fill-rock-700/75" style="font-size: 9.5px;"
                  >{weekLabel(b.weekStarting)}</text>
                </g>
              );
            })}
          </svg>
        </div>
      </figure>
    )}

    <div class="mt-14 border-t border-soil-300 pt-10">
      <p class="qf-eyebrow text-sun-700">Browse by intent</p>
      <h2 class="mt-3 font-display text-3xl text-soil-900">What are you trying to do?</h2>
      <p class="mt-4 max-w-[62ch] text-soil-700">
        Each section groups the extensions that solve one class of problem, with finer-grained
        sub-groups where they help. Filter by intent or search by name.
      </p>
    </div>

  </div>

  <!-- Filters. Full-bleed so the tinted bands below can run edge to edge and
       still scroll cleanly under the sticky bar. -->
  <div
    class="sticky z-30 border-b border-soil-300 bg-soil-50/95 backdrop-blur"
    style="top: calc(var(--qf-nav-h) + 45px)"
  >
    <!-- Two zones that never reflow into one another: the intent chips scroll
         sideways on one line, the search box holds its place on the right. As a
         single wrapping flex row this bar grew to three lines and 113px tall by
         1180px — a sticky header that eats a third of the viewport, and the
         search field ended up on its own orphan row. -->
    <div class="mx-auto flex w-full max-w-[1360px] items-center gap-3 px-5 py-3 sm:px-7">
      <div class="qf-chiprow flex min-w-0 flex-1 items-center gap-2.5 overflow-x-auto">
        <button type="button" class="qf-pill flex-none" data-bucket="all" aria-pressed="true">All {totalExtensions}</button>
        {bucketCounts.map((bucket) => (
          <button type="button" class="qf-pill flex-none" data-bucket={bucket.id} aria-pressed="false" title={bucket.title}>
            {bucket.pill} <span class="qf-figure">{bucket.count}</span>
          </button>
        ))}
      </div>

      <span class="hidden flex-none text-[13px] font-medium text-soil-500 xl:inline">
        Sort: loads &#8595;
      </span>

      <span class="flex w-[190px] flex-none items-center gap-2 rounded-full border border-soil-300 bg-white px-3.5 py-1.5 focus-within:border-link">
        <label for="ext-filter" class="sr-only">Filter extensions</label>
        <input
          id="ext-filter"
          type="search"
          autocomplete="off"
          placeholder="Filter&#8230;"
          class="w-full min-w-0 border-0 bg-transparent text-sm text-soil-900 placeholder:text-soil-500 focus:outline-none"
        />
        <kbd class="hidden flex-none rounded border border-soil-300 px-1.5 font-mono text-[9.5px] text-soil-500 sm:inline">/</kbd>
      </span>
    </div>
  </div>

  <!-- Browse by intent: every extension, grouped. Restored from the
       pre-redesign catalog — ranking the top 12 and dumping the rest into an
       "everything else" table lost the thing that made this page useful, which
       is that it answers "what am I trying to do?".

       Each group is a full-bleed band carrying its own ground tint, the way the
       homepage stages do. The colour change IS the separator, so the headers
       need no chrome — no panel, no icon chip. -->
  <div id="ext-buckets">
    {TAXONOMY.map(bucket => {
      const items = bucket.subs.flatMap(sub => sub.slugs.map(slug => bySlug[slug]).filter(Boolean));
      return (
        <section
          id={bucket.id}
          class="ext-bucket scroll-mt-32"
          data-bucket={bucket.id}
        >
          <div class="mx-auto w-full max-w-[1360px] px-5 py-11 sm:px-7">
            {/* The heading block is held to a reading measure and marked with a
                short gold rule. Full-bleed across 1360px it was a run of very
                wide, very plain text with the count marooned at the far right —
                the eye had nothing to catch on between one section and the next.
                The count now sits with the title it counts. */}
            <div class="max-w-[62ch]">
              <span class="mb-3 block h-[3px] w-9 rounded-full bg-sun-400" aria-hidden="true"></span>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="font-display text-2xl text-soil-900 md:text-[28px]">{bucket.title}</h2>
                <span class="band-count text-[13px]">
                  <span class="qf-figure">{items.length}</span> extensions
                </span>
              </div>
              <p class="band-blurb mt-1.5">{bucket.blurb}</p>
            </div>

            <div class="mt-8 space-y-10">
              {bucket.subs.map(sub => (
                <div class="ext-sub">
                  {sub.title && (
                    <h3 class="mb-5 flex items-center gap-2.5 font-display text-xl text-soil-900">
                      {sub.title}
                      <span class="h-px flex-1 bg-soil-300/70" aria-hidden="true"></span>
                    </h3>
                  )}
                  <div class="grid grid-cols-[repeat(auto-fill,minmax(288px,1fr))] gap-3.5">
                    {sub.slugs.map(slug => {
                      const e = bySlug[slug];
                      return e && (
                        <div class="ext-item" data-bucket={bucket.id} data-search={searchKey(e)}>
                          <ExtensionCard
                            id={e.id}
                            name={e.name}
                            description={e.description}
                            category={e.category}
                            status={e.status}
                            icon={e.icon}
                            usageCount={e.usageCount}
                            usagePeriod={e.usagePeriod}
                            maxUsageCount={maxUsageCount}
                          />
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <div class="mx-auto w-full max-w-[1360px] px-5 sm:px-7">
    <p id="ext-empty" hidden class="py-10 text-center text-soil-600">
      No extensions match that filter.
    </p>

    <div class="mt-16 mb-20 rounded-2xl border border-soil-300/70 bg-soil-100 px-6 py-12 text-center sm:px-10">
      <p class="qf-eyebrow text-sun-700">Expert help</p>
      <h2 class="mx-auto mt-3 max-w-[20ch] font-display text-3xl text-soil-900">
        Need a custom DuckDB extension?
      </h2>
      <p class="mx-auto mt-4 max-w-[56ch] text-lg text-soil-700">
        We build extensions for teams that need a capability DuckDB doesn't have yet &#8212; from a single
        function to a full catalog integration.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <Button href="/company/schedule" variant="primary">Schedule a consultation</Button>
        <Button href="/consulting" variant="secondary">Learn about consulting</Button>
      </div>
    </div>
  </div>

  <script>
    // Catalog filtering. Cards carry `.ext-item` + `data-bucket` / `data-search`.
    // Because the catalog is grouped by intent, filtering also has to collapse
    // any sub-group and bucket left with nothing in it — otherwise a search
    // leaves a page of orphaned headings above empty grids.
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.qf-pill'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('.ext-item'));
    const subs = Array.from(document.querySelectorAll<HTMLElement>('.ext-sub'));
    const bucketEls = Array.from(document.querySelectorAll<HTMLElement>('.ext-bucket'));
    const input = document.getElementById('ext-filter') as HTMLInputElement | null;
    const empty = document.getElementById('ext-empty');

    let activeBucket = 'all';

    const anyVisible = (root: HTMLElement) =>
      Array.from(root.querySelectorAll<HTMLElement>('.ext-item')).some(i => !i.hidden);

    function apply() {
      const q = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const okBucket = activeBucket === 'all' || item.dataset.bucket === activeBucket;
        const okQuery = !q || (item.dataset.search || '').includes(q);
        const show = okBucket && okQuery;
        item.hidden = !show;
        if (show) visible++;
      }
      for (const sub of subs) sub.hidden = !anyVisible(sub);
      for (const b of bucketEls) b.hidden = !anyVisible(b);
      if (empty) empty.hidden = visible !== 0;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        activeBucket = pill.dataset.bucket || 'all';
        for (const p of pills) p.setAttribute('aria-pressed', String(p === pill));
        apply();
      });
    }

    input?.addEventListener('input', apply);

    // `/` focuses the filter, the way every catalog people already use does.
    document.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
      event.preventDefault();
      input?.focus();
    });
  </script>

  <style>
    /* Table rows are `display: table-row`; `hidden` on a <tr> is honoured, but
       Tailwind's preflight sets `display` on some elements — force it. */
    .ext-item[hidden], .ext-sub[hidden], .ext-bucket[hidden] { display: none !important; }

    /* Section bands — a stepped progression, the homepage model.

       The run walks soil-50 to pipe-3 in eight even steps. Both ends are real
       brand tokens: paper at the top, the MID stage band at the bottom. It
       stops at pipe-3 because that is the last band the white catalog cards
       can sit on — pipe-4 and darker would need the homepage's whole .on-dark
       card treatment, and rendering the same 32 peer objects two different
       ways depending on scroll position is worse than a shorter run.

       Steps are ~1.15:1 apart, so each boundary reads without any one band
       looking tinted on its own, and the cards gain separation on the way
       down (1.11:1 on paper to 3.04:1 on pipe-3).

       Text follows the §3 MID-band law rather than a special case: soil-700
       blurbs fail from band 6 (3.99:1) and soil-600 counts from band 4
       (4.18:1), so both go to ink from band 4, where the worst case is
       5.66:1 on pipe-3. Headings were already ink. */
    .ext-bucket:nth-of-type(1) { background: #f7f3ea; }
    .ext-bucket:nth-of-type(2) { background: #e7e6d8; }
    .ext-bucket:nth-of-type(3) { background: #d8dac6; }
    .ext-bucket:nth-of-type(4) { background: #c8cdb4; }
    .ext-bucket:nth-of-type(5) { background: #b9c0a1; }
    .ext-bucket:nth-of-type(6) { background: #a9b38f; }
    .ext-bucket:nth-of-type(7) { background: #9aa77d; }
    .ext-bucket:nth-of-type(8) { background: #8a9a6b; }

    .ext-bucket {
      border-top: 1px solid color-mix(in srgb, var(--color-soil-300) 45%, transparent);
    }
    .band-blurb { color: var(--color-soil-700); }
    .band-count { color: var(--color-soil-600); }
    .ext-bucket:nth-of-type(n+4) .band-blurb,
    .ext-bucket:nth-of-type(n+4) .band-count { color: var(--color-soil-900); }
  </style>
</PageLayout>

<style is:global>
  /* The chip strip scrolls sideways instead of wrapping. Its scrollbar is
     hidden the same way the section subnav hides its own — a visible bar under
     a single row of pills is noise, and the row is short enough that the
     overflow is obvious from the clipped chip at the edge. */
  .qf-chiprow {
    scrollbar-width: none;
  }
  .qf-chiprow::-webkit-scrollbar {
    display: none;
  }

  .qf-pill {
    font-weight: 500;
    font-size: 13.5px;
    letter-spacing: 0;
    color: var(--color-soil-700);
    background: #fff;
    border: 1px solid var(--color-soil-300);
    border-radius: 999px;
    padding: 6px 13px;
    cursor: pointer;
    transition: 0.18s;
  }
  .qf-pill:hover {
    border-color: var(--color-soil-400);
    color: var(--color-soil-900);
  }
  .qf-pill[aria-pressed='true'] {
    background: var(--color-soil-900);
    border-color: var(--color-soil-900);
    color: var(--color-soil-50);
  }
  .qf-pill:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .qf-th {
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0;
    color: var(--color-soil-600);
    background: var(--color-soil-50);
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-soil-300);
    text-align: left;
  }
</style>
