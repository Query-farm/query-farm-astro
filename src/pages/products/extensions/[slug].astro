---
import PageLayout from '../../../layouts/PageLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import ExtensionHero from '../../../components/products/ExtensionHero.astro';
import ExtensionCard from '../../../components/products/ExtensionCard.astro';
import ExtensionInfo from '../../../components/products/ExtensionInfo.astro';
import DuckDBExtensionPragmaDoc from '../../../components/docs/DuckDBExtensionPragmaDoc.astro';
import DuckDBExtensionSecretDoc from '../../../components/docs/DuckDBExtensionSecretDoc.astro';
import DuckDBExtensionMacroDoc from '../../../components/docs/DuckDBExtensionMacroDoc.astro';
import DuckDBExtensionFilesystemDoc from '../../../components/docs/DuckDBExtensionFilesystemDoc.astro';
import DuckDBExtensionStorageDoc from '../../../components/docs/DuckDBExtensionStorageDoc.astro';
import DuckDBExtensionLogTypeDoc from '../../../components/docs/DuckDBExtensionLogTypeDoc.astro';
import DuckDBExtensionLogStorageDoc from '../../../components/docs/DuckDBExtensionLogStorageDoc.astro';
import DuckDBExtensionTechnicalOverview from '../../../components/docs/DuckDBExtensionTechnicalOverview.astro';
import DuckDBExtensionTechnicalDetails from '../../../components/docs/DuckDBExtensionTechnicalDetails.astro';
import DuckDBExtensionContentsTable from '../../../components/docs/DuckDBExtensionContentsTable.astro';
import DuckDBExtensionFunctionReference from '../../../components/docs/DuckDBExtensionFunctionReference.astro';
import DuckDBExtensionPricing from '../../../components/docs/DuckDBExtensionPricing.astro';
import DuckDBExtensionCookbook from '../../../components/docs/DuckDBExtensionCookbook.astro';
import ExtensionSection from '../../../components/docs/ExtensionSection.astro';
import ExtensionPageTOC from '../../../components/docs/ExtensionPageTOC.astro';
import Callout from '../../../components/docs/Callout.astro';
import ExampleShellMounter from '../../../components/repl/ExampleShellMounter.tsx';
import { parseInline } from 'marked';
import { extensions, getExtensionsByIds } from '../../../data/extensions';
import { getExtensionData, loadExtensionMdx, loadCookbookMdx, loadCheckFixtures } from '../../../data/extension-loader';

export async function getStaticPaths() {
  return extensions.map(ext => ({
    params: { slug: ext.id },
    props: { extensionId: ext.id }
  }));
}

interface Props {
  extensionId: string;
}

const { extensionId } = Astro.props;

// Load extension data
const extensionData = await getExtensionData(extensionId);

if (!extensionData) {
  return Astro.redirect('/products/extensions');
}

// Try to load optional technical details MDX content
const mdxModule = await loadExtensionMdx(extensionId);
const TechnicalDetailsContent = mdxModule?.Content || null;

// Try to load optional cookbook MDX content
const cookbookModule = await loadCookbookMdx(extensionId);
const CookbookContent = cookbookModule?.Content || null;

const {
  metadata,
  technicalOverview,
  functions = [],
  pragmas = [],
  secrets = [],
  macros = [],
  filesystems = [],
  storageExtensions = [],
  logTypes = [],
  logStorageTypes = [],
  pricing
} = extensionData;

// Use extension metadata
const GITHUB_URL = metadata.githubUrl;

// Create unified extension contents (functions + macros + pragmas + secrets + filesystems + storage + logging)
interface ExtensionContent {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy' | 'macro' | 'pragma' | 'secret' | 'filesystem' | 'storage' | 'logtype' | 'logstorage';
  category: string;
  description: string;
  href: string;
}

// Helper to map items to extension content format
const mapToContent = <T extends { id: string; name: string; category: string; description: string }>(
  items: T[],
  type: ExtensionContent['type'],
  options?: {
    nameSuffix?: string;
    defaultCategory?: string;
    idTransform?: (item: T) => string;
  }
): ExtensionContent[] => {
  return items.map(item => {
    const id = options?.idTransform ? options.idTransform(item) : item.id;
    return {
      id,
      name: item.name + (options?.nameSuffix || ''),
      type,
      category: item.category || options?.defaultCategory || item.category,
      description: item.description.split('.')[0],
      href: `#${id}`
    };
  });
};

const extensionContents: ExtensionContent[] = [
  // Functions keep their original type (scalar/table/aggregate)
  // flatMap to handle functions with multiple categories
  ...functions.flatMap(fn => fn.categories.map(cat => ({
    id: fn.id,
    name: fn.name + '()',
    type: fn.type,
    category: cat,
    description: fn.description.split('.')[0],
    href: `#${fn.id}`
  }))),
  // All other types use the helper
  ...mapToContent(macros, 'macro', { nameSuffix: '()' }),
  ...mapToContent(pragmas, 'pragma', {
    defaultCategory: 'Configuration',
    idTransform: (p) => p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')
  }),
  ...mapToContent(secrets, 'secret'),
  ...mapToContent(filesystems, 'filesystem', { nameSuffix: '://', defaultCategory: 'Filesystems' }),
  ...mapToContent(storageExtensions, 'storage'),
  ...mapToContent(logTypes, 'logtype'),
  ...mapToContent(logStorageTypes, 'logstorage')
];

// Group extension contents by category
const contentCategories = extensionContents.reduce((acc, item) => {
  (acc[item.category] ??= []).push(item);
  return acc;
}, {} as Record<string, ExtensionContent[]>);

// Automatically discover and sort all categories alphabetically
const sortedContentCategories = Object.keys(contentCategories).sort();

// Related extensions from extension metadata
const relatedExtensionIds = metadata.relatedExtensions || [];
const relatedExtensions = getExtensionsByIds(relatedExtensionIds);

// Hero actions - conditionally include Browse Contents
const heroActions = [
  // Only show Browse Contents if there are extension contents
  ...(extensionContents.length > 0 ? [{
    label: 'Browse Contents',
    href: '#functions-index',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />'
  }] : [])
];

// Build TOC items based on what sections exist
interface TOCItem {
  id: string;
  label: string;
}

const tocItems: TOCItem[] = [
  // Overview (Technical Overview) - always shown if it exists
  ...(technicalOverview ? [{ id: 'overview', label: 'Overview' }] : []),
  // Install
  { id: 'quick-install', label: 'Install' },
  // Quick Start example
  ...((metadata as any).quickStart ? [{ id: 'quick-start', label: 'Quick Start' }] : []),
  // Technical Details (from MDX)
  ...(TechnicalDetailsContent ? [{ id: 'technical-details', label: 'Technical Details' }] : []),
  // Extension Contents
  ...(extensionContents.length > 1 ? [{ id: 'functions-index', label: 'Extension Contents' }] : []),
  // Function Reference
  ...(functions.length > 0 ? [{ id: 'function-reference', label: 'Functions' }] : []),
  // Macros
  ...(macros.length > 0 ? [{ id: 'macros', label: 'Macros' }] : []),
  // Logging
  ...((logTypes.length > 0 || logStorageTypes.length > 0) ? [{ id: 'logging', label: 'Logging' }] : []),
  // Storage Extensions
  ...(storageExtensions.length > 0 ? [{ id: 'storage-extensions', label: 'Storage' }] : []),
  // Settings/Pragmas
  ...(pragmas.length > 0 ? [{ id: 'settings', label: 'Settings' }] : []),
  // Secrets
  ...(secrets.length > 0 ? [{ id: 'secrets', label: 'Secrets' }] : []),
  // Filesystems
  ...(filesystems.length > 0 ? [{ id: 'filesystems', label: 'Filesystems' }] : []),
  // Cookbook
  ...(CookbookContent ? [{ id: 'cookbook', label: 'Cookbook' }] : []),
  // Pricing
  ...(pricing ? [{ id: 'pricing', label: 'Pricing' }] : []),
  // Compatibility
  { id: 'compatibility', label: 'Compatibility' },
  // Related Extensions
  ...(relatedExtensions.length > 0 ? [{ id: 'related-extensions', label: 'Related' }] : []),
];

// SEO: structured data for rich results in search engines.
const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/extensions/${extensionId}`;
const operatingSystems = (metadata.platforms ?? []).map(p => p.platform);
const wasmSupported = (metadata.platforms ?? []).some(p => p.platform === 'WASM');
const installSource = (metadata as any).installSource ?? 'community';
const checkFixtures = loadCheckFixtures(extensionId);
const quickStart = (metadata as any).quickStart as string | undefined;
const installFrom = installSource === 'community'
  ? 'FROM community'
  : installSource.toLowerCase().startsWith('from ') ? installSource : `FROM '${installSource}'`;
const installCommand = `-- Install the extension
INSTALL ${metadata.name} ${installFrom};

-- Load it into your session
LOAD ${metadata.name};`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: metadata.displayName,
    description: metadata.description,
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Extension',
    ...(metadata.writtenIn ? { programmingLanguage: metadata.writtenIn } : {}),
    ...(metadata.license ? { license: metadata.license } : {}),
    ...(operatingSystems.length > 0 ? { operatingSystem: operatingSystems.join(', ') } : {}),
    ...(metadata.githubUrl ? { codeRepository: metadata.githubUrl } : {}),
    ...(metadata.lastRelease ? { dateModified: metadata.lastRelease } : {}),
    ...(metadata.firstRelease ? { datePublished: metadata.firstRelease } : {}),
    ...(metadata.image ? { image: new URL(metadata.image, SITE_ORIGIN).toString() } : {}),
    offers: {
      '@type': 'Offer',
      price: metadata.pricing === 'paid' ? undefined : '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Extensions', item: SITE_ORIGIN + '/products/extensions' },
      { '@type': 'ListItem', position: 4, name: metadata.displayName, item: pageUrl },
    ],
  },
];
---

<PageLayout
  title={`${metadata.displayName} - DuckDB Extension`}
  description={metadata.description}
  ogImage={metadata.image}
  ogType="article"
  jsonLd={jsonLd}
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Extensions', href: '/products/extensions' },
    { name: metadata.displayName, href: `/products/extensions/${extensionId}` }
  ]}
>
  {wasmSupported && (
    <ExampleShellMounter
      client:idle
      extensionName={metadata.name}
      installSource={installSource}
      fixtures={checkFixtures}
    />
  )}

  <!-- Floating TOC Sidebar -->
  {tocItems.length > 0 && (
    <ExtensionPageTOC items={tocItems} />
  )}

  <!-- Hero Section -->
  <ExtensionHero
    name={metadata.displayName}
    icon={metadata.icon}
    description={metadata.description}
    actions={heroActions}
    image={metadata.image}
  />

  <!-- Page-top notice (deprecation, successor announcement, advisory). -->
  {metadata.notice && (
    <section class="py-6 bg-white border-b border-soil-200">
      <div class="section-container">
        <div class="max-w-4xl 2xl:max-w-6xl mx-auto [&_a]:text-harvest-700 [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-harvest-300 hover:[&_a]:decoration-harvest-700 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[0.9em]">
          <Callout type={metadata.notice.type} title={metadata.notice.title}>
            <p set:html={parseInline(metadata.notice.body)}></p>
            {metadata.notice.buttondownList && (
              <form
                action={`https://buttondown.com/api/emails/embed-subscribe/${metadata.notice.buttondownList}`}
                method="post"
                target="popupwindow"
                onsubmit={`window.open('https://buttondown.com/${metadata.notice.buttondownList}', 'popupwindow')`}
                class="mt-4 flex flex-col sm:flex-row gap-2 max-w-lg"
              >
                <label for="bd-email" class="sr-only">Email address</label>
                <input
                  id="bd-email"
                  type="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="flex-1 px-3 py-2 rounded border border-soil-300 bg-white text-soil-900 placeholder:text-soil-500 focus:outline-none focus:ring-2 focus:ring-harvest-500 focus:border-harvest-500"
                />
                <button
                  type="submit"
                  class="px-4 py-2 rounded bg-harvest-700 text-white font-medium hover:bg-harvest-800 focus:outline-none focus:ring-2 focus:ring-harvest-500 focus:ring-offset-1 whitespace-nowrap"
                >
                  {metadata.notice.buttondownCta ?? 'Notify me on release'}
                </button>
              </form>
            )}
          </Callout>
        </div>
      </div>
    </section>
  )}

  <!-- Technical Overview — lead with what the extension is and why, before
       the mechanical install step. -->
  {technicalOverview && (
    <DuckDBExtensionTechnicalOverview
      eyebrow={technicalOverview.eyebrow}
      title={technicalOverview.title}
      description={technicalOverview.description}
      sections={technicalOverview.sections}
    />
  )}

  <!-- Install — just the standard INSTALL/LOAD. Not "tryable": running these
       in the shell does nothing visible (the extension is already loaded). -->
  <section id="quick-install" class="py-12 bg-white border-b border-soil-200 scroll-mt-16">
    <div class="section-container">
      <div class="max-w-4xl 2xl:max-w-6xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <svg width="32" height="32" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
            <circle cx="50" cy="50" r="48" fill="#111111"/>
            <circle cx="40" cy="50" r="18" fill="#FFF000"/>
            <ellipse cx="68" cy="50" rx="8" ry="6" fill="#FFF000"/>
          </svg>
          <h2 class="text-2xl font-bold text-soil-900">Install</h2>
        </div>
        <CodeBlock code={installCommand} lang="sql" tryable={false} />
      </div>
    </div>
  </section>

  <!-- Quick Start — the runnable example, where the "Try" button belongs. -->
  {quickStart && (
    <section id="quick-start" class="py-12 bg-white border-b border-soil-200 scroll-mt-16">
      <div class="section-container">
        <div class="max-w-4xl 2xl:max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold text-soil-900 mb-4">Quick Start</h2>
          <CodeBlock code={quickStart} lang="sql" />
        </div>
      </div>
    </section>
  )}

  <!-- Technical Details (from MDX) -->
  {TechnicalDetailsContent && (
    <DuckDBExtensionTechnicalDetails
      title="Technical Details"
    >
      <TechnicalDetailsContent />
    </DuckDBExtensionTechnicalDetails>
  )}

  <!-- Extension Contents Index — skip when there's only one entry; the
       function/macro/secret card alone is the index in that case. -->
  {extensionContents.length > 1 && (
    <DuckDBExtensionContentsTable
      contents={extensionContents}
      categoryOrder={sortedContentCategories}
      categoryDescriptions={extensionData.categoryDescriptions}
    />
  )}

  <!-- Function Reference -->
  {functions && functions.length > 0 && (
    <DuckDBExtensionFunctionReference functions={functions} slug={extensionId} />
  )}

  <!-- Extension Macros -->
  {macros && macros.length > 0 && (
    <ExtensionSection id="macros" background="soil">
      <SectionHeader
        eyebrow="SQL Macros"
        title="Macros"
        description="Convenience macros that simplify common cryptographic operations and provide shorthand syntax for frequently used patterns."
        class="mb-12"
      />
      {macros.map((macro) => (
        <DuckDBExtensionMacroDoc {...macro} />
      ))}
    </ExtensionSection>
  )}

  <!-- Extension Logging -->
  {((logTypes && logTypes.length > 0) || (logStorageTypes && logStorageTypes.length > 0)) && (
    <ExtensionSection id="logging" background="white">
      <SectionHeader
        eyebrow="Logging Integration"
        title="Logging"
        description="DuckDB logging subsystem integration for monitoring cryptographic operations and storing audit trails."
        class="mb-12"
      />
      <div class="space-y-12">
        {/* Log Types */}
        {logTypes && logTypes.length > 0 && (
          <div>
            <h3 class="text-xl font-bold text-soil-900 mb-6 pb-2 border-b border-soil-200">Log Types</h3>
            <div class="space-y-8">
              {logTypes.map((logType) => (
                <DuckDBExtensionLogTypeDoc {...logType} />
              ))}
            </div>
          </div>
        )}

        {/* Log Storage Types */}
        {logStorageTypes && logStorageTypes.length > 0 && (
          <div>
            <h3 class="text-xl font-bold text-soil-900 mb-6 pb-2 border-b border-soil-200">Log Storage Types</h3>
            <div class="space-y-8">
              {logStorageTypes.map((logStorage) => (
                <DuckDBExtensionLogStorageDoc {...logStorage} />
              ))}
            </div>
          </div>
        )}
      </div>
    </ExtensionSection>
  )}

  <!-- Extension Storage Extensions -->
  {storageExtensions && storageExtensions.length > 0 && (
    <ExtensionSection id="storage-extensions" background="white">
      <SectionHeader
        eyebrow="Database Storage"
        title="Storage Extensions"
        description="Storage extensions that enable secure database attachments with encryption, secret management, and credential rotation."
        class="mb-12"
      />
      {storageExtensions.map((storage) => (
        <DuckDBExtensionStorageDoc {...storage} />
      ))}
    </ExtensionSection>
  )}

  <!-- Settings/Pragmas Section -->
  {pragmas && pragmas.length > 0 && (
    <ExtensionSection id="settings" background="white">
      <SectionHeader
        eyebrow="Configuration"
        title="Settings"
        description={`Configure the ${metadata.displayName.toLowerCase()} extension behavior using these pragma settings.`}
        class="mb-12"
      />
      {pragmas.map((pragma) => (
        <DuckDBExtensionPragmaDoc {...pragma} />
      ))}
    </ExtensionSection>
  )}

  <!-- Extension Secrets -->
  {secrets && secrets.length > 0 && (
    <ExtensionSection id="secrets" background="soil">
      <SectionHeader
        eyebrow="Security"
        title="Secrets"
        description={`DuckDB secrets for securely storing credentials and encryption keys used by the ${metadata.displayName.toLowerCase()} extension.`}
        class="mb-12"
      />
      {secrets.map((secret) => (
        <DuckDBExtensionSecretDoc {...secret} />
      ))}
    </ExtensionSection>
  )}

  <!-- Extension Filesystems -->
  {filesystems && filesystems.length > 0 && (
    <ExtensionSection id="filesystems" background="white">
      <SectionHeader
        eyebrow="Virtual Filesystems"
        title="Filesystems"
        description="Virtual filesystem implementations that provide transparent encryption and secure access to data storage."
        class="mb-12"
      />
      {filesystems.map((filesystem) => (
        <DuckDBExtensionFilesystemDoc {...filesystem} />
      ))}
    </ExtensionSection>
  )}

  <!-- Cookbook Section -->
  {CookbookContent && (
    <DuckDBExtensionCookbook>
      <CookbookContent />
    </DuckDBExtensionCookbook>
  )}

  <!-- Pricing Section -->
  {pricing && (
    <DuckDBExtensionPricing
      {...pricing}
      extensionName={metadata.displayName}
    />
  )}

  <!-- Back to Top -->
  <section class="py-8 bg-white border-t border-soil-200">
    <div class="section-container">
      <div class="text-center">
        <a href="#" class="inline-flex items-center gap-2 text-harvest-700 hover:text-harvest-800 font-medium transition-colors group">
          <svg class="w-5 h-5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
          Back to Top
        </a>
      </div>
    </div>
  </section>

  <!-- Compatibility -->
  <ExtensionInfo
      githubUrl={GITHUB_URL}
      githubStars={metadata.githubStars}
      license={metadata.license || 'MIT'}
      pricing={metadata.pricing || 'free'}
      firstRelease={metadata.firstRelease}
      lastRelease={metadata.lastRelease}
      binarySize={metadata.binarySize}
      writtenIn={metadata.writtenIn}
      sourceAvailable={metadata.sourceAvailable}
      dependencies={metadata.dependencies}
      usageStats={metadata.usageStats}
      platforms={metadata.platforms}
      duckdbVersions={metadata.duckdbVersions || ['1.1.0', '1.1.1', '1.1.2', '1.1.3']}
      binarySizes={metadata.binarySizes}
    />

  <!-- Related Extensions (if any exist) -->
  {relatedExtensions && relatedExtensions.length > 0 && (
    <ExtensionSection id="related-extensions" background="soil">
      <SectionHeader
        eyebrow="You might also like"
        title="Related Extensions"
        description={`Extensions that complement ${metadata.displayName.toLowerCase()} for your data workflows.`}
        align="center"
        class="mb-12"
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedExtensions.map((ext) => (
          <ExtensionCard
            id={ext.id}
            name={ext.name}
            description={ext.description}
            category={ext.category}
            status={ext.status}
            icon={ext.icon}
            features={ext.features}
          />
        ))}
      </div>
    </ExtensionSection>
  )}

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-soil-900 to-soil-800 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        {metadata.cta.title}
      </h2>
      <p class="text-xl text-soil-300 mb-8 max-w-2xl mx-auto">
        {metadata.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="#quick-install" variant="primary" size="lg">
          Install Now
        </Button>
        <Button href="/products/extensions" variant="secondary" size="lg">
          View Other Extensions
        </Button>
      </div>
    </div>
  </section>

</PageLayout>
