---
import PageLayout from '../../../layouts/PageLayout.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import ExtensionHero from '../../../components/products/ExtensionHero.astro';
import ExtensionsSubNav from '../../../components/sections/ExtensionsSubNav.astro';
import ExtensionCard from '../../../components/products/ExtensionCard.astro';
import ExtensionInfo from '../../../components/products/ExtensionInfo.astro';
import DuckDBExtensionPragmaDoc from '../../../components/docs/DuckDBExtensionPragmaDoc.astro';
import DuckDBExtensionSecretDoc from '../../../components/docs/DuckDBExtensionSecretDoc.astro';
import DuckDBExtensionMacroDoc from '../../../components/docs/DuckDBExtensionMacroDoc.astro';
import DuckDBExtensionFilesystemDoc from '../../../components/docs/DuckDBExtensionFilesystemDoc.astro';
import DuckDBExtensionStorageDoc from '../../../components/docs/DuckDBExtensionStorageDoc.astro';
import DuckDBExtensionLogTypeDoc from '../../../components/docs/DuckDBExtensionLogTypeDoc.astro';
import DuckDBExtensionLogStorageDoc from '../../../components/docs/DuckDBExtensionLogStorageDoc.astro';
import DuckDBExtensionTechnicalOverview from '../../../components/docs/DuckDBExtensionTechnicalOverview.astro';
import DuckDBExtensionTechnicalDetails from '../../../components/docs/DuckDBExtensionTechnicalDetails.astro';
import DuckDBExtensionContentsTable from '../../../components/docs/DuckDBExtensionContentsTable.astro';
import DuckDBExtensionFunctionReference from '../../../components/docs/DuckDBExtensionFunctionReference.astro';
import DuckDBExtensionPricing from '../../../components/docs/DuckDBExtensionPricing.astro';
import DuckDBExtensionCookbook from '../../../components/docs/DuckDBExtensionCookbook.astro';
import DuckDBExtensionTypeReference from '../../../components/docs/DuckDBExtensionTypeReference.astro';
import ExtensionSection from '../../../components/docs/ExtensionSection.astro';
import ExtensionPageTOC from '../../../components/docs/ExtensionPageTOC.astro';
import Callout from '../../../components/docs/Callout.astro';
import ExampleShellMounter from '../../../components/repl/ExampleShellMounter.tsx';
import { parseInline } from 'marked';
import { publicExtensions, getExtensionById, getExtensionsByIds } from '../../../data/extensions';
import { getExtensionData, loadExtensionMdx, loadCookbookMdx, loadCheckFixtures } from '../../../data/extension-loader';
import { extensionNameAnchor } from '../../../lib/extension-anchors';
import { extensionFunctionCategoryAnchorPath } from '../../../lib/extension-reference';

export async function getStaticPaths() {
  return publicExtensions.map(ext => ({
    params: { slug: ext.id },
    props: { extensionId: ext.id }
  }));
}

interface Props {
  extensionId: string;
}

const { extensionId } = Astro.props as Props;

// Load extension data
const extensionData = await getExtensionData(extensionId);

if (!extensionData) {
  return Astro.redirect('/products/extensions');
}

// Try to load optional technical details MDX content
const mdxModule = await loadExtensionMdx(extensionId);
const TechnicalDetailsContent = mdxModule?.Content || null;

// Try to load optional cookbook MDX content
const cookbookModule = await loadCookbookMdx(extensionId);
const CookbookContent = cookbookModule?.Content || null;

const {
  metadata,
  technicalOverview,
  functions = [],
  types = [],
  pragmas = [],
  secrets = [],
  macros = [],
  filesystems = [],
  storageExtensions = [],
  logTypes = [],
  logStorageTypes = [],
  pricing
} = extensionData;

// Use extension metadata
const GITHUB_URL = metadata.githubUrl;

// Create unified extension contents (functions + macros + pragmas + secrets + filesystems + storage + logging)
interface ExtensionContent {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy' | 'type' | 'macro' | 'pragma' | 'secret' | 'filesystem' | 'storage' | 'logtype' | 'logstorage';
  category: string;
  description: string;
  href: string;
}

// Short summary for the contents index: the first sentence. A naive
// `.split('.')[0]` truncates at the first period *anywhere* — including ones
// inside `OVER (...)`, decimals, or `e.g.` — so instead match up to the first
// sentence-ending `.`/`!`/`?` that is followed by whitespace or end-of-string.
const firstSentence = (s: string): string => {
  const m = s.match(/^.*?[.!?](?=\s|$)/);
  return (m ? m[0] : s).trim();
};

// Helper to map items to extension content format
const mapToContent = <T extends { id?: string; name: string; category?: string; description?: string }>(
  items: T[],
  type: ExtensionContent['type'],
  options?: {
    nameSuffix?: string;
    defaultCategory?: string;
    idTransform?: (item: T) => string;
  }
): ExtensionContent[] => {
  return items.map(item => {
    const id = options?.idTransform ? options.idTransform(item) : item.id ?? extensionNameAnchor(item.name);
    return {
      id,
      name: item.name + (options?.nameSuffix || ''),
      type,
      category: item.category || options?.defaultCategory || 'Other',
      description: firstSentence(item.description ?? ''),
      href: `#${id}`
    };
  });
};

// Secrets and catalog implementations can legitimately share the same public
// name (for example both are called `adbc`). Preserve short anchors everywhere
// they are unique, and namespace only real collisions so every page ID remains
// unambiguous without churning existing deep links across the catalog.
const sharedObjectAnchorCounts = [...secrets, ...storageExtensions].reduce((counts, item) => {
  const anchor = extensionNameAnchor(item.id || item.name);
  counts.set(anchor, (counts.get(anchor) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const objectAnchor = (kind: 'secret' | 'catalog', item: { id?: string; name: string }) => {
  const anchor = extensionNameAnchor(item.id || item.name);
  return (sharedObjectAnchorCounts.get(anchor) ?? 0) > 1 ? `${kind}-${anchor}` : anchor;
};

const extensionContents: ExtensionContent[] = [
  // Functions keep their original type (scalar/table/aggregate)
  // flatMap to handle functions with multiple categories. Functions without any
  // category still need to appear, so fall back to a generic bucket — otherwise
  // `[].map()` drops them from the contents index entirely.
  ...functions.flatMap(fn => (fn.categories.length ? fn.categories : ['Functions']).map(cat => ({
    id: fn.id,
    name: fn.name + '()',
    type: fn.type,
    category: cat,
    description: firstSentence(fn.description),
    href: extensionFunctionCategoryAnchorPath(extensionId, cat, fn.id)
  }))),
  ...types.map(type => ({
    id: extensionNameAnchor(type.id || type.name),
    name: type.name,
    type: 'type' as const,
    category: type.category && type.category !== 'None' ? type.category : 'Types',
    description: firstSentence(type.description || 'Logical type registered by this extension.'),
    href: `#${extensionNameAnchor(type.id || type.name)}`,
  })),
  // All other types use the helper
  ...mapToContent(macros, 'macro', { nameSuffix: '()' }),
  ...mapToContent(pragmas, 'pragma', {
    defaultCategory: 'Configuration',
    idTransform: (p) => extensionNameAnchor(p.name)
  }),
  ...mapToContent(secrets, 'secret', { idTransform: (secret) => objectAnchor('secret', secret) }),
  ...mapToContent(filesystems, 'filesystem', { nameSuffix: '://', defaultCategory: 'Filesystems' }),
  ...mapToContent(storageExtensions, 'storage', { idTransform: (storage) => objectAnchor('catalog', storage) }),
  ...mapToContent(logTypes, 'logtype'),
  ...mapToContent(logStorageTypes, 'logstorage')
];

// Group extension contents by category
const contentCategories = extensionContents.reduce((acc, item) => {
  (acc[item.category] ??= []).push(item);
  return acc;
}, {} as Record<string, ExtensionContent[]>);

// Automatically discover and sort all categories alphabetically
const sortedContentCategories = Object.keys(contentCategories).sort();

// Related extensions from extension metadata
const relatedExtensionIds = metadata.relatedExtensions || [];
const relatedExtensions = getExtensionsByIds(relatedExtensionIds);

// Build TOC items based on what sections exist
interface TOCItem {
  id: string;
  label: string;
}

const tocItems: TOCItem[] = [
  // Overview (Technical Overview) - always shown if it exists
  ...(technicalOverview ? [{ id: 'overview', label: 'Overview' }] : []),
  // Technical Details (from MDX) — the rest of the "what is this and why",
  // so it stays with the Overview rather than sitting below the SQL.
  ...(TechnicalDetailsContent ? [{ id: 'technical-details', label: 'Technical Details' }] : []),
  // Install
  { id: 'quick-install', label: 'Install' },
  // Quick Start example(s) — string (legacy) or non-empty array of examples
  ...(((q) => (Array.isArray(q) ? q.length > 0 : !!q))((metadata as any).quickStart)
    ? [{ id: 'quick-start', label: 'Quick Start' }]
    : []),
  // Extension Contents
  ...(extensionContents.length > 0 ? [{ id: 'functions-index', label: 'Extension Contents' }] : []),
  // Function Reference
  ...(functions.length > 0 ? [{ id: 'function-reference', label: 'Functions' }] : []),
  ...(types.length > 0 ? [{ id: 'types', label: 'Types' }] : []),
  // Macros
  ...(macros.length > 0 ? [{ id: 'macros', label: 'Macros' }] : []),
  // Logging
  ...((logTypes.length > 0 || logStorageTypes.length > 0) ? [{ id: 'logging', label: 'Logging' }] : []),
  // Storage Extensions
  ...(storageExtensions.length > 0 ? [{ id: 'storage-extensions', label: 'Storage' }] : []),
  // Settings/Pragmas
  ...(pragmas.length > 0 ? [{ id: 'settings', label: 'Settings' }] : []),
  // Secrets
  ...(secrets.length > 0 ? [{ id: 'secrets', label: 'Secrets' }] : []),
  // Filesystems
  ...(filesystems.length > 0 ? [{ id: 'filesystems', label: 'Filesystems' }] : []),
  // Cookbook
  ...(CookbookContent ? [{ id: 'cookbook', label: 'Cookbook' }] : []),
  // Pricing
  ...(pricing ? [{ id: 'pricing', label: 'Pricing' }] : []),
  // Compatibility
  { id: 'compatibility', label: 'Compatibility' },
  // Related Extensions
  ...(relatedExtensions.length > 0 ? [{ id: 'related-extensions', label: 'Related' }] : []),
];

// SEO: structured data for rich results in search engines.
const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/extensions/${extensionId}`;
const operatingSystems = (metadata.platforms ?? []).map(p => p.platform);
const wasmSupported = (metadata.platforms ?? []).some(p => p.platform === 'WASM');
const installSource = (metadata as any).installSource ?? 'community';
const checkFixtures = loadCheckFixtures(extensionId);
// quickStart is either the legacy single SQL string or the preferred array of
// {title, sql} examples. Normalize both into a list of cells to render.
const rawQuickStart = (metadata as any).quickStart as
  | string
  | { title?: string; sql: string }[]
  | undefined;
const quickStartExamples: { title?: string; sql: string }[] = Array.isArray(rawQuickStart)
  ? rawQuickStart
  : rawQuickStart
    ? [{ sql: rawQuickStart }]
    : [];
const installFrom = installSource === 'community'
  ? 'FROM community'
  : installSource.toLowerCase().startsWith('from ') ? installSource : `FROM '${installSource}'`;
// The Install section's SQL, one statement per line — INSTALL fetches the
// extension once, LOAD brings it into the session every time. Rendered by the
// same CodeBlock as every other SQL snippet on the page, but `tryable={false}`:
// these do nothing visible in the in-page REPL (the extension is already loaded
// there), so the block must not get a "Try it in your browser" button.
const installSql = `INSTALL ${metadata.name} ${installFrom};\nLOAD ${metadata.name};`;

// ── Page header ──────────────────────────────────────────────────────────
const listing = getExtensionById(extensionId);
const loadCount = metadata.usageStats?.count ?? listing?.usageCount;
const loadPeriod = metadata.usageStats?.period ?? listing?.usagePeriod;

// Header badges are for the two facts that change what you can do with the page
// right now: whether it costs money, and whether the examples will run in your
// browser. Category, status and licence used to sit here too — they are
// catalogue metadata, already listed in the Compatibility section, and three
// static chips under every extension name said nothing a reader acts on.
const headerBadges: { label: string; tone?: 'neutral' | 'gold' | 'field'; href?: string; title?: string }[] = [
  ...(metadata.status === 'experimental'
    ? [{ label: 'Experimental', tone: 'gold' as const, href: '#compatibility', title: 'API and behavior may still change.' }]
    : metadata.status === 'beta'
      ? [{ label: 'Beta', tone: 'neutral' as const, href: '#compatibility', title: 'Usable, but not yet marked stable.' }]
      : []),
  ...(metadata.pricing === 'paid' ? [{ label: 'Commercial', tone: 'gold' as const, href: '#pricing' }] : []),
];

// ── Docs rail ────────────────────────────────────────────────────────────
// One rail, on the left, listing page sections only — the same job the sidebar
// did before the redesign. The extension's individual functions/macros/secrets
// are deliberately not enumerated here: the Extension Contents index already
// does that, in a form that scales past a 400-function extension.

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: metadata.displayName,
    description: metadata.description,
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Extension',
    ...(metadata.writtenIn ? { programmingLanguage: metadata.writtenIn } : {}),
    ...(metadata.license ? { license: metadata.license } : {}),
    ...(operatingSystems.length > 0 ? { operatingSystem: operatingSystems.join(', ') } : {}),
    ...(metadata.githubUrl ? { codeRepository: metadata.githubUrl } : {}),
    ...(metadata.lastRelease ? { dateModified: metadata.lastRelease } : {}),
    ...(metadata.firstRelease ? { datePublished: metadata.firstRelease } : {}),
    ...(metadata.image ? { image: new URL(metadata.image, SITE_ORIGIN).toString() } : {}),
    offers: {
      '@type': 'Offer',
      price: metadata.pricing === 'paid' ? undefined : '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'DuckDB Extensions', item: SITE_ORIGIN + '/products/extensions' },
      { '@type': 'ListItem', position: 4, name: metadata.displayName, item: pageUrl },
    ],
  },
];
---

<PageLayout
  title={`${metadata.displayName} - DuckDB Extension`}
  description={metadata.description}
  ogImage={metadata.image}
  ogType="article"
  jsonLd={jsonLd}
>
  <ExtensionsSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'DuckDB Extensions', href: '/products/extensions' },
      { name: metadata.displayName, href: `/products/extensions/${extensionId}` }
    ]}
  />

  {wasmSupported && (
    <ExampleShellMounter
      client:load
      extensionName={metadata.name}
      installSource={installSource}
      fixtures={checkFixtures}
      controls="toolbar"
    />
  )}

  <!-- Page header — mark, name, badges, lede, loads. -->
  <ExtensionHero
    name={metadata.displayName}
    description={firstSentence(metadata.description)}
    badges={headerBadges}
    loads={loadCount}
    loadsPeriod={loadPeriod}
  />

  <!-- Two columns: page TOC / prose. One under 900px — the rail drops, never
       the content. -->
  <div class="mx-auto grid w-full max-w-[1200px] grid-cols-1 gap-x-10 gap-y-0 px-5 pt-8 pb-16 sm:px-7 min-[900px]:grid-cols-[220px_minmax(0,1fr)]">
    {tocItems.length > 0 && (
      <ExtensionPageTOC items={tocItems} class="hidden min-[900px]:block" />
    )}

    <!-- ExtensionSection rules its top edge to separate itself from the section
         before it. The first one has nothing before it but the page header,
         which already draws its own bottom border — so the two stack into a
         double line. `first-of-type` counts sections only, so an optional
         notice above them doesn't shift which one is suppressed. -->
    <div class="min-w-0 [&>section:first-of-type]:border-t-0">
      <ExtensionPageTOC items={tocItems} mobile class="min-[900px]:hidden" />
      <!-- Page-top notice (deprecation, successor announcement, advisory). -->
      {metadata.notice && (
        <div class="mb-8 [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[0.9em]">
          <Callout type={metadata.notice.type} title={metadata.notice.title}>
            <p set:html={parseInline(metadata.notice.body)}></p>
            {metadata.notice.buttondownList && (
              <form
                action={`https://buttondown.com/api/emails/embed-subscribe/${metadata.notice.buttondownList}`}
                method="post"
                target="popupwindow"
                onsubmit={`window.open('https://buttondown.com/${metadata.notice.buttondownList}', 'popupwindow')`}
                class="mt-4 flex flex-col sm:flex-row gap-2 max-w-lg"
              >
                <label for="bd-email" class="sr-only">Email address</label>
                <input
                  id="bd-email"
                  type="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="flex-1 px-3 py-2 rounded-lg border border-soil-300 bg-white text-soil-900 placeholder:text-soil-500 focus:outline-none focus:border-link focus:ring-3 focus:ring-link/20"
                />
                <button
                  type="submit"
                  class="px-4 py-2 rounded-lg bg-field-700 text-white font-medium hover:bg-soil-900 focus:outline-none focus:ring-3 focus:ring-sun-400/25 whitespace-nowrap"
                >
                  {metadata.notice.buttondownCta ?? 'Notify me on release'}
                </button>
              </form>
            )}
          </Callout>
        </div>
      )}

      <!-- Technical Overview — lead with what the extension is and why. -->
      {technicalOverview && (
        <DuckDBExtensionTechnicalOverview
          eyebrow={technicalOverview.eyebrow}
          title={technicalOverview.title}
          description={technicalOverview.description}
          sections={technicalOverview.sections}
        />
      )}

      <!-- Technical Details (from MDX) — the long-form half of "what is this
           and why", so it belongs directly under the Technical Overview. On an
           extension with no overview (airport, shellfs) it becomes the page's
           opening section, which is the point: nobody should meet a new
           extension with `INSTALL` as the first thing on the page. -->
      {TechnicalDetailsContent && (
        <DuckDBExtensionTechnicalDetails
          title="Technical Details"
        >
          <TechnicalDetailsContent />
        </DuckDBExtensionTechnicalDetails>
      )}

      <!-- Install — after the prose, not before it: what the extension is
           earns the top of the page, and this is one line people learn once.
           Keeps the `quick-install` id, so old deep links still land. -->
      <ExtensionSection id="quick-install">
        <h2 class="mb-5 text-[clamp(1.55rem,3.4vw,2.5rem)] text-soil-900">Install</h2>
        <CodeBlock code={installSql} lang="sql" tryable={false} />
      </ExtensionSection>

      <!-- Quick Start — each example is its own Try-able cell, so a Try click
           runs just that example rather than the whole script. -->
      {quickStartExamples.length > 0 && (
        <ExtensionSection id="quick-start">
          <h2 class="mb-6 text-[clamp(1.55rem,3.4vw,2.5rem)] text-soil-900">Quick Start</h2>
          <div class="space-y-6">
            {quickStartExamples.map((example) => (
              <div>
                {/* A caption, not a headline: it says what the query does, so
                    it takes body Commissioner at body size. Left bare it would
                    inherit the global h* rule — Petrona at display metrics —
                    which is why it read as tiny serif type. */}
                {example.title && (
                  <h3 class="mb-2 font-sans text-[14px] font-medium leading-normal tracking-normal text-soil-700">{example.title}</h3>
                )}
                <CodeBlock code={example.sql} lang="sql" />
              </div>
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Extension Contents Index. Shown whenever the extension registers
           anything at all: the old `> 1` gate assumed a lone entry was already
           self-describing from its own card, but on a settings-only extension
           like shellfs that erased both the index and its TOC entry, leaving no
           statement anywhere of what the extension actually adds. -->
      {extensionContents.length > 0 && (
        <DuckDBExtensionContentsTable
          contents={extensionContents}
          categoryOrder={sortedContentCategories}
          categoryDescriptions={extensionData.categoryDescriptions}
        />
      )}

      <!-- Function Reference -->
      {functions && functions.length > 0 && (
        <DuckDBExtensionFunctionReference
          functions={functions}
          slug={extensionId}
          categoryDescriptions={extensionData.categoryDescriptions}
        />
      )}

      {types.length > 0 && <DuckDBExtensionTypeReference types={types} />}

      <!-- Extension Macros -->
      {macros && macros.length > 0 && (
        <ExtensionSection id="macros">
          <SectionHeader
            eyebrow="SQL Macros"
            title="Macros"
            description="Convenience macros that wrap common operations in shorthand syntax."
            class="mb-10"
          />
          <div class="space-y-8">
            {macros.map((macro) => (
              <DuckDBExtensionMacroDoc {...macro} />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Extension Logging -->
      {((logTypes && logTypes.length > 0) || (logStorageTypes && logStorageTypes.length > 0)) && (
        <ExtensionSection id="logging">
          <SectionHeader
            eyebrow="Logging Integration"
            title="Logging"
            description="DuckDB logging subsystem integration for monitoring operations and storing audit trails."
            class="mb-10"
          />
          <div class="space-y-12">
            {/* Log Types */}
            {logTypes && logTypes.length > 0 && (
              <div>
                <h3 class="mb-6 border-b border-soil-300/70 pb-2 font-display text-xl text-soil-900">Log Types</h3>
                <div class="space-y-8">
                  {logTypes.map((logType) => (
                    <DuckDBExtensionLogTypeDoc {...logType} />
                  ))}
                </div>
              </div>
            )}

            {/* Log Storage Types */}
            {logStorageTypes && logStorageTypes.length > 0 && (
              <div>
                <h3 class="mb-6 border-b border-soil-300/70 pb-2 font-display text-xl text-soil-900">Log Storage Types</h3>
                <div class="space-y-8">
                  {logStorageTypes.map((logStorage) => (
                    <DuckDBExtensionLogStorageDoc {...logStorage} />
                  ))}
                </div>
              </div>
            )}
          </div>
        </ExtensionSection>
      )}

      <!-- Extension Storage Extensions -->
      {storageExtensions && storageExtensions.length > 0 && (
        <ExtensionSection id="storage-extensions">
          <SectionHeader
            eyebrow="Database Storage"
            title="Storage Extensions"
            description="Catalog implementations that attach external storage as a DuckDB database."
            class="mb-10"
          />
          <div class="space-y-8">
            {storageExtensions.map((storage) => (
              <DuckDBExtensionStorageDoc {...storage} id={objectAnchor('catalog', storage)} />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Settings/Pragmas Section -->
      {pragmas && pragmas.length > 0 && (
        <ExtensionSection id="settings">
          <SectionHeader
            eyebrow="Configuration"
            title="Settings"
            description={`Configure the ${metadata.displayName.toLowerCase()} extension behavior using these settings.`}
            class="mb-10"
          />
          <div class="space-y-8">
            {pragmas.map((pragma) => (
              <DuckDBExtensionPragmaDoc {...pragma} />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Extension Secrets -->
      {secrets && secrets.length > 0 && (
        <ExtensionSection id="secrets">
          <SectionHeader
            eyebrow="Security"
            title="Secrets"
            description={`DuckDB secrets for storing the credentials and keys used by the ${metadata.displayName.toLowerCase()} extension.`}
            class="mb-10"
          />
          <div class="space-y-8">
            {secrets.map((secret) => (
              <DuckDBExtensionSecretDoc {...secret} id={objectAnchor('secret', secret)} />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Extension Filesystems -->
      {filesystems && filesystems.length > 0 && (
        <ExtensionSection id="filesystems">
          <SectionHeader
            eyebrow="Virtual Filesystems"
            title="Filesystems"
            description="Filesystem implementations this extension registers, usable anywhere a path is accepted."
            class="mb-10"
          />
          <div class="space-y-8">
            {filesystems.map((filesystem) => (
              <DuckDBExtensionFilesystemDoc {...filesystem} />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- Cookbook Section -->
      {CookbookContent && (
        <DuckDBExtensionCookbook>
          <CookbookContent />
        </DuckDBExtensionCookbook>
      )}

      <!-- Pricing Section -->
      {pricing && (
        <DuckDBExtensionPricing
          {...pricing}
          extensionName={metadata.displayName}
        />
      )}

      <!-- Compatibility -->
      <ExtensionInfo
        githubUrl={GITHUB_URL}
        status={metadata.status}
        githubStars={metadata.githubStars}
        license={metadata.license}
        licenseHref={/source-available/i.test(metadata.license ?? '') ? '/licenses/source-available' : undefined}
        pricing={metadata.pricing || 'free'}
        firstRelease={metadata.firstRelease}
        lastRelease={metadata.lastRelease}
        binarySize={metadata.binarySize}
        writtenIn={metadata.writtenIn}
        sourceAvailable={metadata.sourceAvailable}
        dependencies={metadata.dependencies}
        usageStats={metadata.usageStats}
        platforms={metadata.platforms}
        duckdbVersions={metadata.duckdbVersions}
        binarySizes={metadata.binarySizes}
      />

      <!-- Related Extensions (if any exist) -->
      {relatedExtensions && relatedExtensions.length > 0 && (
        <ExtensionSection id="related-extensions">
          <SectionHeader
            eyebrow="You might also like"
            title="Related Extensions"
            description={`Extensions that complement ${metadata.displayName.toLowerCase()}.`}
            class="mb-10"
          />
          <div class="grid gap-4 sm:grid-cols-2">
            {relatedExtensions.map((ext) => (
              <ExtensionCard
                id={ext.id}
                name={ext.name}
                description={ext.description}
                category={ext.category}
                status={ext.status}
                icon={ext.icon}
                features={ext.features}
                usageCount={ext.usageCount}
                usagePeriod={ext.usagePeriod}
              />
            ))}
          </div>
        </ExtensionSection>
      )}

      <!-- No closing CTA. It restated the lede in different words and offered
           two links the page already carries: Install is a section above, and
           "All extensions" sits in the subnav on every scroll position. The
           `cta` field survives in metadata.json and the Zod schema — nothing
           renders it now. -->
    </div>
  </div>

  <!-- Record this visit for the "Recently viewed" list in the Products nav. -->
  <script is:inline define:vars={{ extId: extensionId, extName: metadata.displayName }}>
    try {
      const key = 'qf:recentExtensions';
      const prev = JSON.parse(localStorage.getItem(key) || '[]').filter((e) => e && e.id !== extId);
      prev.unshift({ id: extId, name: extName });
      localStorage.setItem(key, JSON.stringify(prev.slice(0, 8)));
    } catch (e) { /* ignore storage errors */ }
  </script>
</PageLayout>
