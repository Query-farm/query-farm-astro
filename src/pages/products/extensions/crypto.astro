---
import PageLayout from '../../../layouts/PageLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import ExtensionHero from '../../../components/products/ExtensionHero.astro';
import ExtensionCard from '../../../components/products/ExtensionCard.astro';
import ExtensionInfo from '../../../components/products/ExtensionInfo.astro';
import ExtensionChangelog from '../../../components/products/ExtensionChangelog.astro';
import DuckDBExtensionFunctionDoc from '../../../components/docs/DuckDBExtensionFunctionDoc.astro';
import DuckDBExtensionPragmaDoc from '../../../components/docs/DuckDBExtensionPragmaDoc.astro';
import DuckDBExtensionSecretDoc from '../../../components/docs/DuckDBExtensionSecretDoc.astro';
import DuckDBExtensionMacroDoc from '../../../components/docs/DuckDBExtensionMacroDoc.astro';
import { cryptoFunctions, cryptoPragmas, cryptoSecrets, cryptoMacros, extensionMetadata } from '../../../data/crypto-functions';
import { getExtensionsByIds } from '../../../data/extensions';

// Use extension metadata
const GITHUB_URL = extensionMetadata.githubUrl;

// Group functions by category
const categories = cryptoFunctions.reduce((acc, fn) => {
  if (!acc[fn.category]) {
    acc[fn.category] = [];
  }
  acc[fn.category].push(fn);
  return acc;
}, {} as Record<string, typeof cryptoFunctions>);

// Sort categories
const categoryOrder = ['Hashing', 'HMAC', 'Password', 'Key Generation', 'Auditing', 'Aggregation'];
const sortedCategories = categoryOrder.filter(cat => categories[cat]);

// Create unified extension contents (functions + macros + pragmas + secrets)
interface ExtensionContent {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'macro' | 'pragma' | 'secret';
  category: string;
  description: string;
  href: string;
}

const extensionContents: ExtensionContent[] = [
  // Add all functions
  ...cryptoFunctions.map(fn => ({
    id: fn.id,
    name: fn.name + '()',
    type: fn.type,
    category: fn.category,
    description: fn.description.split('.')[0],
    href: `#${fn.id}`
  })),
  // Add all macros
  ...cryptoMacros.map(macro => ({
    id: macro.id,
    name: macro.name + '()',
    type: 'macro' as const,
    category: macro.category,
    description: macro.description.split('.')[0],
    href: `#${macro.id}`
  })),
  // Add all pragmas
  ...cryptoPragmas.map(pragma => ({
    id: pragma.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    name: pragma.name,
    type: 'pragma' as const,
    category: 'Configuration',
    description: pragma.description.split('.')[0],
    href: `#${pragma.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
  })),
  // Add all secrets
  ...cryptoSecrets.map(secret => ({
    id: secret.id,
    name: secret.name,
    type: 'secret' as const,
    category: secret.category,
    description: secret.description.split('.')[0],
    href: `#${secret.id}`
  }))
];

// Group extension contents by category
const contentCategories = extensionContents.reduce((acc, item) => {
  if (!acc[item.category]) {
    acc[item.category] = [];
  }
  acc[item.category].push(item);
  return acc;
}, {} as Record<string, ExtensionContent[]>);

// Sort content categories (functions first, then macros, then Configuration, then Secrets)
const sortedContentCategories = [
  ...categoryOrder,
  'Data Privacy', 'Security', 'Data Integrity', 'Encryption',
  'Configuration',
  'Cloud Storage', 'Database Connections'
].filter(cat => contentCategories[cat]);

// Related extensions - just list the IDs
const relatedExtensionIds = ['hashfunctions'];
const relatedExtensions = getExtensionsByIds(relatedExtensionIds);

// Changelog data
const changelogEntries = [
  {
    version: '2.1.0',
    date: '2024-11-15',
    type: 'minor' as const,
    changes: [
      {
        category: 'added' as const,
        items: [
          'Added Argon2 password hashing support for enhanced security',
          'New crypto_uuid_v4() function for generating random UUIDs',
          'Support for custom cost factors in bcrypt (4-31 range)'
        ]
      },
      {
        category: 'changed' as const,
        items: [
          'Improved performance of SHA-512 hashing by 40% using vectorized operations',
          'Enhanced error messages for invalid key sizes in RSA generation'
        ]
      },
      {
        category: 'fixed' as const,
        items: [
          'Fixed memory leak in crypto_generate_keys() for large batch operations',
          'Corrected Merkle tree root calculation for odd-numbered datasets'
        ]
      }
    ]
  },
  {
    version: '2.0.1',
    date: '2024-10-08',
    type: 'patch' as const,
    changes: [
      {
        category: 'fixed' as const,
        items: [
          'Fixed crash when using crypto_audit_trail with empty tables',
          'Resolved base64 encoding issue with Unicode characters'
        ]
      },
      {
        category: 'security' as const,
        items: [
          'Updated bcrypt library to address CVE-2024-xxxxx timing attack vulnerability'
        ]
      }
    ]
  },
  {
    version: '2.0.0',
    date: '2024-09-20',
    type: 'major' as const,
    changes: [
      {
        category: 'added' as const,
        items: [
          'Introduced table-returning functions: crypto_generate_keys() and crypto_audit_trail()',
          'Aggregate functions: crypto_hash_agg() and crypto_merkle_root()',
          'Base64 encoding/decoding utilities'
        ]
      },
      {
        category: 'changed' as const,
        items: [
          'Breaking: Renamed crypto_hash() to crypto_sha256() for clarity',
          'Default bcrypt cost increased from 8 to 10 for better security'
        ]
      },
      {
        category: 'removed' as const,
        items: [
          'Deprecated MD5 hashing (moved to crypto_md5_legacy())'
        ]
      }
    ]
  }
];
---

<PageLayout
  title="crypto - DuckDB Extension"
  description="Comprehensive cryptographic functions for secure data handling including hashing, encryption, and digital signatures."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Extensions', href: '/products/extensions' },
    { name: 'crypto', href: '/products/extensions/crypto' }
  ]}
>
  <!-- Hero Section -->
  <ExtensionHero
    name={extensionMetadata.name}
    icon={extensionMetadata.icon}
    description={extensionMetadata.description}
    actions={[
      {
        label: 'Browse Functions',
        href: '#functions-index',
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />'
      },
      {
        label: 'Install Instructions',
        href: '#quick-install',
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />'
      },
      {
        label: 'View on GitHub',
        href: GITHUB_URL,
        icon: '<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" fill="currentColor" />'
      }
    ]}
  />

  <!-- Quick Install -->
  <section id="quick-install" class="py-12 bg-white border-b border-soil-200 scroll-mt-16">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-soil-900 mb-4">Quick Install</h2>
        <CodeBlock
          code={`-- Install the extension
INSTALL crypto FROM 'query.farm';

-- Load it into your session
LOAD crypto;

-- Start using cryptographic functions
SELECT crypto_sha256('Hello, World!') AS hash;`}
          lang="sql"
        />
      </div>
    </div>
  </section>

  <!-- Technical Overview -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="Technical Overview"
          title="Why Use Crypto Functions?"
          description="Understanding when and how to leverage cryptographic capabilities in your data workflows."
          class="mb-12"
        />

        <div class="space-y-12">
          <!-- Data Security & Compliance -->
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-harvest-100 text-harvest-700 flex items-center justify-center text-xl">🔒</span>
              Data Security & Compliance
            </h3>
            <p class="text-soil-700 leading-relaxed mb-4">
              Modern data systems must handle sensitive information securely. This extension provides enterprise-grade cryptographic primitives directly within DuckDB, eliminating the need to export sensitive data to external systems for encryption or hashing.
            </p>
            <ul class="space-y-2 text-soil-700">
              <li class="flex items-start gap-2">
                <span class="text-harvest-600 font-bold">•</span>
                <span><strong>Password Storage:</strong> Use bcrypt hashing for secure password storage with automatic salt generation and configurable work factors.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-harvest-600 font-bold">•</span>
                <span><strong>PII Protection:</strong> Hash or encrypt personally identifiable information (PII) to meet GDPR, CCPA, and HIPAA requirements.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-harvest-600 font-bold">•</span>
                <span><strong>Data Masking:</strong> Create consistent, irreversible hashes for data anonymization in analytics and testing environments.</span>
              </li>
            </ul>
          </div>

          <!-- Data Integrity & Verification -->
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-grain-100 text-grain-700 flex items-center justify-center text-xl">✓</span>
              Data Integrity & Verification
            </h3>
            <p class="text-soil-700 leading-relaxed mb-4">
              Ensure data hasn't been tampered with by generating cryptographic fingerprints and audit trails. Detect unauthorized modifications and maintain chain-of-custody for critical data.
            </p>
            <ul class="space-y-2 text-soil-700">
              <li class="flex items-start gap-2">
                <span class="text-grain-600 font-bold">•</span>
                <span><strong>Blockchain-Style Auditing:</strong> Build immutable audit trails using hash chaining to detect any tampering with historical records.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-grain-600 font-bold">•</span>
                <span><strong>Aggregate Verification:</strong> Generate Merkle roots and aggregate hashes to verify entire datasets with a single value.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-grain-600 font-bold">•</span>
                <span><strong>Checksum Validation:</strong> Quickly validate data integrity during ETL pipelines and data transfers.</span>
              </li>
            </ul>
          </div>

          <!-- Performance & Scalability -->
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-duck-100 text-duck-700 flex items-center justify-center text-xl">⚡</span>
              Performance & Scalability
            </h3>
            <p class="text-soil-700 leading-relaxed mb-4">
              Native DuckDB extensions leverage columnar processing and vectorized execution for high-performance cryptographic operations on large datasets without moving data out of the database.
            </p>
            <ul class="space-y-2 text-soil-700">
              <li class="flex items-start gap-2">
                <span class="text-duck-600 font-bold">•</span>
                <span><strong>In-Database Processing:</strong> Process millions of rows without data serialization or network overhead.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-duck-600 font-bold">•</span>
                <span><strong>Vectorized Operations:</strong> Benefit from DuckDB's SIMD optimizations for batch hashing and encryption.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-duck-600 font-bold">•</span>
                <span><strong>Zero-Copy Architecture:</strong> Avoid expensive data transfers between database and application layers.</span>
              </li>
            </ul>
          </div>

          <!-- Use Cases -->
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-soil-200 text-soil-700 flex items-center justify-center text-xl">🎯</span>
              Common Use Cases
            </h3>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                <h4 class="font-semibold text-soil-900 mb-2">Financial Services</h4>
                <p class="text-sm text-soil-700">Transaction verification, audit trails for compliance, and secure customer data handling.</p>
              </div>
              <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                <h4 class="font-semibold text-soil-900 mb-2">Healthcare Systems</h4>
                <p class="text-sm text-soil-700">HIPAA-compliant patient data encryption, secure medical record hashing, and audit logging.</p>
              </div>
              <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                <h4 class="font-semibold text-soil-900 mb-2">Data Engineering</h4>
                <p class="text-sm text-soil-700">ETL pipeline checksums, data deduplication via hashing, and secure data lake operations.</p>
              </div>
              <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                <h4 class="font-semibold text-soil-900 mb-2">SaaS Applications</h4>
                <p class="text-sm text-soil-700">Multi-tenant data isolation, API key management, and secure password authentication.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Extension Contents Index -->
  <section id="functions-index" class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Reference"
        title="Extension Contents"
        description="Quick reference to all available functions and settings organized by category."
        class="mb-12"
      />

      <div class="max-w-6xl mx-auto">
        <Card padding="none" class="overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-soil-100 border-b-2 border-soil-300">
                <tr>
                  <th class="px-4 py-3 text-left font-semibold text-soil-900">Name</th>
                  <th class="px-4 py-3 text-left font-semibold text-soil-900">Type</th>
                  <th class="px-4 py-3 text-left font-semibold text-soil-900">Description</th>
                </tr>
              </thead>
              <tbody>
                {sortedContentCategories.map((categoryName, catIndex) => {
                  const categoryId = categoryName.toLowerCase().replace(/\s+/g, '-');
                  const items = contentCategories[categoryName];

                  return (
                    <>
                      {/* Category Header Row (spans all columns) */}
                      <tr id={`functions-index-${categoryId}`} class="scroll-mt-32">
                        <td colspan="3" class="px-4 py-3 bg-earth-200 border-y border-earth-400">
                          <span class="font-bold text-soil-900">{categoryName}</span>
                        </td>
                      </tr>

                      {/* Content Rows */}
                      {items.map((item, itemIndex) => (
                        <tr
                          class={`hover:bg-soil-50 cursor-pointer ${itemIndex === items.length - 1 && catIndex !== sortedContentCategories.length - 1 ? 'border-b border-soil-300' : ''}`}
                          onclick={`window.location.hash='${item.id}'`}
                        >
                          <td class="px-4 py-3">
                            <a href={item.href} class="font-mono text-harvest-700 hover:text-harvest-800 font-medium">
                              {item.name}
                            </a>
                          </td>
                          <td class="px-4 py-3">
                            {item.type === 'scalar' && <Badge variant="info" size="sm">Scalar Function</Badge>}
                            {item.type === 'table' && <Badge variant="success" size="sm">Table Function</Badge>}
                            {item.type === 'aggregate' && (
                              <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-orange-100 text-orange-800 border-orange-300">
                                Aggregate Function
                              </span>
                            )}
                            {item.type === 'macro' && (
                              <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-teal-100 text-teal-800 border-teal-300">
                                Macro
                              </span>
                            )}
                            {item.type === 'pragma' && (
                              <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-purple-100 text-purple-800 border-purple-300">
                                Pragma
                              </span>
                            )}
                            {item.type === 'secret' && (
                              <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-indigo-100 text-indigo-800 border-indigo-300">
                                Secret
                              </span>
                            )}
                          </td>
                          <td class="px-4 py-3 text-soil-700">{item.description}</td>
                        </tr>
                      ))}
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Function Reference -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="API Reference"
        title="Function Documentation"
        description="Detailed documentation for each function including signatures, parameters, and examples."
        class="mb-12"
      />

      <div class="max-w-6xl mx-auto">
        {cryptoFunctions.map((fn) => (
          <DuckDBExtensionFunctionDoc {...fn} />
        ))}
      </div>
    </div>
  </section>

  <!-- Extension Macros -->
  {cryptoMacros && cryptoMacros.length > 0 && (
    <section id="macros" class="py-16 lg:py-24 bg-soil-50">
      <div class="section-container">
        <SectionHeader
          eyebrow="SQL Macros"
          title="Extension Macros"
          description="Convenience macros that simplify common cryptographic operations and provide shorthand syntax for frequently used patterns."
          class="mb-12"
        />

        <div class="max-w-6xl mx-auto">
          {cryptoMacros.map((macro) => (
            <DuckDBExtensionMacroDoc {...macro} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Settings/Pragmas Section -->
  {cryptoPragmas && cryptoPragmas.length > 0 && (
    <section id="settings" class="py-16 lg:py-24 bg-white">
      <div class="section-container">
        <SectionHeader
          eyebrow="Configuration"
          title="Extension Settings"
          description="Configure the crypto extension behavior using these pragma settings."
          class="mb-12"
        />

        <div class="max-w-6xl mx-auto">
          {cryptoPragmas.map((pragma) => (
            <DuckDBExtensionPragmaDoc {...pragma} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Extension Secrets -->
  {cryptoSecrets && cryptoSecrets.length > 0 && (
    <section id="secrets" class="py-16 lg:py-24 bg-soil-50">
      <div class="section-container">
        <SectionHeader
          eyebrow="Security"
          title="Extension Secrets"
          description="DuckDB secrets for securely storing credentials and encryption keys used by the crypto extension."
          class="mb-12"
        />

        <div class="max-w-6xl mx-auto">
          {cryptoSecrets.map((secret) => (
            <DuckDBExtensionSecretDoc {...secret} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Back to Top -->
  <section class="py-8 bg-white border-t border-soil-200">
    <div class="section-container">
      <div class="text-center">
        <a href="#" class="inline-flex items-center gap-2 text-harvest-700 hover:text-harvest-800 font-medium transition-colors group">
          <svg class="w-5 h-5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
          Back to Top
        </a>
      </div>
    </div>
  </section>

  <!-- Changelog -->
  <div id="changelog">
    <ExtensionChangelog entries={changelogEntries} />
  </div>

  <!-- Extension Info -->
  <div id="extension-info">
    <ExtensionInfo
      githubUrl={GITHUB_URL}
      githubStars={1247}
      license="MIT"
      pricing="free"
      usageStats={{ count: 324000, period: "the last 60 days" }}
      platforms={['Linux', 'Windows', 'macOS', 'WASM']}
      duckdbVersions={['1.4', '1.5']}
    />
  </div>

  <!-- Related Extensions -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        <SectionHeader
          eyebrow="You might also like"
          title="Related Extensions"
          description="Extensions that complement crypto for your data workflows."
          align="center"
          class="mb-12"
        />
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedExtensions.map((ext) => (
            <ExtensionCard
              id={ext.id}
              name={ext.name}
              description={ext.description}
              category={ext.category}
              status={ext.status}
              icon={ext.icon}
              features={ext.features}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-soil-900 to-soil-800 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        {extensionMetadata.cta.title}
      </h2>
      <p class="text-xl text-soil-300 mb-8 max-w-2xl mx-auto">
        {extensionMetadata.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={GITHUB_URL} variant="primary" size="lg" external>
          View on GitHub
        </Button>
        <Button href="/products/extensions" variant="secondary" size="lg">
          View Other Extensions
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
