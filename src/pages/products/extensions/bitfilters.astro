---
import PageLayout from '../../../layouts/PageLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { Code } from 'astro:components';
---

<PageLayout
  title="Bit Filters & Bloom - DuckDB Extension"
  description="High-performance probabilistic data structures including Bloom filters, HyperLogLog, and Count-Min Sketch for approximate computations."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Extensions', href: '/products/extensions' },
    { name: 'Bit Filters & Bloom', href: '/products/extensions/bitfilters' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 lg:py-16 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container">
      <div class="flex items-start gap-6">
        <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-5xl">
          🎯
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-4">
            <h1 class="text-4xl md:text-5xl font-bold">
              Bit Filters & Bloom
            </h1>
            <Badge variant="success" size="sm">Stable</Badge>
          </div>
          <p class="text-xl md:text-2xl text-harvest-50 mb-6 max-w-3xl">
            High-performance probabilistic data structures for membership testing, cardinality estimation, and frequency counting with minimal memory footprint.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="https://github.com/queryfarm/duckdb-bitfilters" variant="secondary" size="md" external>
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              View on GitHub
            </Button>
            <Button href="https://docs.query.farm/extensions/bitfilters" variant="ghost" size="md" class="bg-white/10 hover:bg-white/20 text-white border-white/30" external>
              Full Documentation
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Install -->
  <section class="py-12 bg-white border-b border-soil-200">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-soil-900 mb-4">Quick Install</h2>
        <Card padding="lg" class="bg-soil-900">
          <Code code={`-- Install the extension
INSTALL bitfilters FROM 'query.farm';

-- Load it into your session
LOAD bitfilters;

-- Create a Bloom filter for fast membership testing
SELECT bloom_create(SELECT DISTINCT user_id FROM users) AS user_filter;`} lang="sql" theme="dracula" />
        </Card>
      </div>
    </div>
  </section>

  <!-- What Are Probabilistic Data Structures? -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Overview"
        title="Probabilistic Data Structures Explained"
        description="Trade perfect accuracy for massive memory savings and lightning-fast performance."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-3xl">
            💾
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Space Efficient</h3>
          <p class="text-soil-700">
            Use a fraction of the memory compared to exact data structures. A Bloom filter can represent millions of items in just kilobytes.
          </p>
        </Card>

        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-grain-100 flex items-center justify-center text-3xl">
            ⚡
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Blazing Fast</h3>
          <p class="text-soil-700">
            O(1) or O(k) operations regardless of dataset size. Check membership or estimate cardinality in constant time.
          </p>
        </Card>

        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-duck-100 flex items-center justify-center text-3xl">
            🎲
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Tunable Accuracy</h3>
          <p class="text-soil-700">
            Configure false positive rates and precision to balance accuracy against memory usage for your specific needs.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Data Structures"
        title="Three Powerful Algorithms"
        class="mb-12"
      />

      <div class="space-y-8 max-w-6xl mx-auto">
        <Card padding="lg" class="border-l-4 border-harvest-500">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-harvest-100 flex items-center justify-center text-3xl">
              🌸
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-soil-900 mb-3">Bloom Filters</h3>
              <p class="text-soil-700 mb-4">
                Test whether an element is a member of a set with guaranteed no false negatives. Perfect for caching, deduplication, and pre-filtering.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Use Cases:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• Cache existence checks</li>
                    <li>• Malicious URL detection</li>
                    <li>• Duplicate prevention</li>
                    <li>• Database query optimization</li>
                  </ul>
                </div>
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Characteristics:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• 0% false negatives</li>
                    <li>• Configurable false positive rate</li>
                    <li>• Constant-time operations</li>
                    <li>• No delete support (by design)</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </Card>

        <Card padding="lg" class="border-l-4 border-grain-500">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-grain-100 flex items-center justify-center text-3xl">
              📊
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-soil-900 mb-3">HyperLogLog (HLL)</h3>
              <p class="text-soil-700 mb-4">
                Estimate cardinality (count distinct) of massive datasets using just a few kilobytes. Accurate within 2% standard error.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Use Cases:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• Unique visitor counting</li>
                    <li>• Stream analytics</li>
                    <li>• Database statistics</li>
                    <li>• A/B test metrics</li>
                  </ul>
                </div>
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Characteristics:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• ~2% standard error</li>
                    <li>• 1.5KB for billions of items</li>
                    <li>• Mergeable across datasets</li>
                    <li>• One-pass algorithm</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </Card>

        <Card padding="lg" class="border-l-4 border-duck-500">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-duck-100 flex items-center justify-center text-3xl">
              📈
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-soil-900 mb-3">Count-Min Sketch (CMS)</h3>
              <p class="text-soil-700 mb-4">
                Approximate frequency counting for streams. Find heavy hitters and track item frequencies with minimal memory.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Use Cases:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• Top-K frequent items</li>
                    <li>• Traffic monitoring</li>
                    <li>• Anomaly detection</li>
                    <li>• Real-time analytics</li>
                  </ul>
                </div>
                <div>
                  <p class="font-semibold text-soil-800 mb-2">Characteristics:</p>
                  <ul class="space-y-1 text-soil-700">
                    <li>• Overestimates (never underestimates)</li>
                    <li>• Configurable accuracy</li>
                    <li>• Updateable and mergeable</li>
                    <li>• Sub-linear space</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Examples -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Examples"
        title="Real-World Usage"
        class="mb-12"
      />

      <div class="space-y-12 max-w-6xl mx-auto">
        <!-- Bloom Filter Examples -->
        <div>
          <h3 class="text-2xl font-bold text-soil-900 mb-6">🌸 Bloom Filter Examples</h3>

          <div class="space-y-8">
            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Duplicate Detection</h4>
              <p class="text-soil-700 mb-4">
                Check if an email has already been processed without scanning the entire database.
              </p>
              <Code code={`-- Create a Bloom filter from processed emails
CREATE TABLE processed_filter AS
SELECT bloom_create(
  SELECT email FROM processed_emails,
  false_positive_rate := 0.01  -- 1% false positive rate
) AS filter;

-- Check if new email was already processed (super fast!)
SELECT
  email,
  bloom_contains(
    (SELECT filter FROM processed_filter),
    email
  ) AS possibly_duplicate
FROM new_emails;

-- If possibly_duplicate = false, definitely not processed
-- If possibly_duplicate = true, verify with exact lookup (1% chance it's wrong)`} lang="sql" theme="dracula" />
            </Card>

            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Malicious URL Filtering</h4>
              <p class="text-soil-700 mb-4">
                Block known malicious URLs in real-time with minimal memory.
              </p>
              <Code code={`-- Build filter from threat intelligence feed
CREATE TABLE malicious_url_filter AS
SELECT bloom_create(
  SELECT url FROM threat_intel_malicious_urls,
  false_positive_rate := 0.001  -- 0.1% FPR for security
) AS filter;

-- Check incoming URLs instantly
SELECT
  request_url,
  CASE
    WHEN bloom_contains(
      (SELECT filter FROM malicious_url_filter),
      request_url
    ) THEN 'BLOCKED'
    ELSE 'ALLOWED'
  END AS action
FROM incoming_requests;`} lang="sql" theme="dracula" />
            </Card>

            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Query Optimization</h4>
              <p class="text-soil-700 mb-4">
                Skip expensive joins when you know the result will be empty.
              </p>
              <Code code={`-- Pre-filter before expensive join
WITH active_user_filter AS (
  SELECT bloom_create(
    SELECT user_id FROM active_users_last_30_days
  ) AS filter
)
SELECT
  e.*,
  u.username
FROM events e
JOIN users u ON e.user_id = u.user_id
WHERE bloom_contains(
  (SELECT filter FROM active_user_filter),
  e.user_id::VARCHAR
);
-- Dramatically reduces rows before join!`} lang="sql" theme="dracula" />
            </Card>
          </div>
        </div>

        <!-- HyperLogLog Examples -->
        <div>
          <h3 class="text-2xl font-bold text-soil-900 mb-6">📊 HyperLogLog Examples</h3>

          <div class="space-y-8">
            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Unique Visitor Counting</h4>
              <p class="text-soil-700 mb-4">
                Count unique visitors across millions of page views using just a few KB.
              </p>
              <Code code={`-- Daily unique visitors (exact method would use tons of memory)
SELECT
  date,
  hll_cardinality(hll_create(user_id)) AS unique_visitors
FROM page_views
GROUP BY date
ORDER BY date;

-- Result: Accurate within ~2%, uses 1.5KB per day regardless of traffic!

-- Weekly rollups by merging HLL sketches
SELECT
  DATE_TRUNC('week', date) AS week,
  hll_cardinality(
    hll_merge(daily_sketch)
  ) AS unique_visitors_this_week
FROM (
  SELECT
    date,
    hll_create(user_id) AS daily_sketch
  FROM page_views
  GROUP BY date
) daily
GROUP BY DATE_TRUNC('week', date);`} lang="sql" theme="dracula" />
            </Card>

            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Stream Analytics</h4>
              <p class="text-soil-700 mb-4">
                Real-time distinct count estimates for streaming data.
              </p>
              <Code code={`-- Create HLL sketch for streaming data
CREATE TABLE stream_metrics AS
SELECT
  window_start,
  hll_create(event_id) AS events_sketch,
  hll_create(user_id) AS users_sketch,
  hll_create(session_id) AS sessions_sketch
FROM event_stream
GROUP BY TIME_BUCKET(INTERVAL '5 minutes', timestamp) AS window_start;

-- Get real-time estimates
SELECT
  window_start,
  hll_cardinality(events_sketch) AS unique_events,
  hll_cardinality(users_sketch) AS unique_users,
  hll_cardinality(sessions_sketch) AS unique_sessions
FROM stream_metrics
WHERE window_start >= NOW() - INTERVAL '1 hour'
ORDER BY window_start DESC;`} lang="sql" theme="dracula" />
            </Card>

            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">A/B Test Metrics</h4>
              <p class="text-soil-700 mb-4">
                Compare unique user engagement across experiment variants.
              </p>
              <Code code={`-- Compare unique users per variant
SELECT
  experiment_variant,
  hll_cardinality(hll_create(user_id)) AS unique_users,
  COUNT(*) AS total_events,
  -- Users per event (engagement metric)
  hll_cardinality(hll_create(user_id))::DOUBLE / COUNT(*) AS users_per_event
FROM experiment_events
GROUP BY experiment_variant;

-- Result example:
-- variant  | unique_users | total_events | users_per_event
-- control  | 15234        | 45123        | 0.337
-- variant_a| 15891        | 52341        | 0.304  -- Higher engagement!`} lang="sql" theme="dracula" />
            </Card>
          </div>
        </div>

        <!-- Count-Min Sketch Examples -->
        <div>
          <h3 class="text-2xl font-bold text-soil-900 mb-6">📈 Count-Min Sketch Examples</h3>

          <div class="space-y-8">
            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Top-K Frequent Items</h4>
              <p class="text-soil-700 mb-4">
                Find the most frequent IP addresses, products, or queries without exact counting.
              </p>
              <Code code={`-- Create CMS for access logs
CREATE TABLE ip_frequency AS
SELECT cms_create(
  SELECT ip_address FROM access_logs,
  epsilon := 0.001,   -- 0.1% error
  delta := 0.01       -- 99% confidence
) AS sketch;

-- Get top IPs by estimated frequency
SELECT
  DISTINCT ip_address,
  cms_estimate(
    (SELECT sketch FROM ip_frequency),
    ip_address
  ) AS estimated_count
FROM access_logs
ORDER BY estimated_count DESC
LIMIT 100;

-- Memory used: ~100KB regardless of log size!`} lang="sql" theme="dracula" />
            </Card>

            <Card padding="lg">
              <h4 class="text-xl font-semibold text-soil-900 mb-3">Anomaly Detection</h4>
              <p class="text-soil-700 mb-4">
                Detect unusual spikes in item frequencies.
              </p>
              <Code code={`-- Track item frequencies over time
CREATE TABLE item_tracking AS
SELECT
  TIME_BUCKET(INTERVAL '1 hour', timestamp) AS hour,
  cms_create(SELECT item_id FROM events WHERE ...) AS sketch
FROM events
GROUP BY TIME_BUCKET(INTERVAL '1 hour', timestamp);

-- Detect anomalies (items with unusual frequency)
WITH current_hour AS (
  SELECT sketch FROM item_tracking
  WHERE hour = DATE_TRUNC('hour', NOW())
),
baseline AS (
  SELECT cms_merge(sketch) AS sketch
  FROM item_tracking
  WHERE hour >= NOW() - INTERVAL '7 days'
    AND hour < NOW() - INTERVAL '1 day'
)
SELECT
  item_id,
  cms_estimate((SELECT sketch FROM current_hour), item_id) AS current_freq,
  cms_estimate((SELECT sketch FROM baseline), item_id) / 168 AS avg_hourly_freq,
  -- Alert if current > 3x baseline
  CASE
    WHEN cms_estimate((SELECT sketch FROM current_hour), item_id) >
         3 * cms_estimate((SELECT sketch FROM baseline), item_id) / 168
    THEN 'ANOMALY'
    ELSE 'NORMAL'
  END AS status
FROM unique_items;`} lang="sql" theme="dracula" />
            </Card>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- API Reference -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="API Reference"
        title="Function Reference"
        class="mb-12"
      />

      <div class="max-w-6xl mx-auto space-y-8">
        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">Bloom Filter Functions</h3>
          <div class="space-y-4 text-sm">
            <div class="grid grid-cols-3 gap-4 font-semibold text-soil-900 border-b border-soil-200 pb-2">
              <div>Function</div>
              <div>Parameters</div>
              <div>Description</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">bloom_create()</div>
              <div>subquery, fpr=0.01</div>
              <div>Creates Bloom filter from subquery with false positive rate</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">bloom_contains()</div>
              <div>filter, value</div>
              <div>Tests if value might be in set (true = maybe, false = definitely not)</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">bloom_size()</div>
              <div>filter</div>
              <div>Returns memory size of filter in bytes</div>
            </div>
          </div>
        </Card>

        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">HyperLogLog Functions</h3>
          <div class="space-y-4 text-sm">
            <div class="grid grid-cols-3 gap-4 font-semibold text-soil-900 border-b border-soil-200 pb-2">
              <div>Function</div>
              <div>Parameters</div>
              <div>Description</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">hll_create()</div>
              <div>column</div>
              <div>Creates HLL sketch from column values</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">hll_cardinality()</div>
              <div>sketch</div>
              <div>Estimates distinct count from sketch (~2% error)</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">hll_merge()</div>
              <div>sketch1, sketch2, ...</div>
              <div>Combines multiple HLL sketches</div>
            </div>
          </div>
        </Card>

        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">Count-Min Sketch Functions</h3>
          <div class="space-y-4 text-sm">
            <div class="grid grid-cols-3 gap-4 font-semibold text-soil-900 border-b border-soil-200 pb-2">
              <div>Function</div>
              <div>Parameters</div>
              <div>Description</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">cms_create()</div>
              <div>subquery, epsilon, delta</div>
              <div>Creates CMS with specified accuracy parameters</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">cms_estimate()</div>
              <div>sketch, value</div>
              <div>Estimates frequency of value (may overestimate)</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-soil-700">
              <div class="font-mono text-xs">cms_merge()</div>
              <div>sketch1, sketch2, ...</div>
              <div>Combines multiple CMS sketches</div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Performance Comparison -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Benchmarks"
        title="Memory & Performance"
        description="Real-world comparison of probabilistic vs. exact methods."
        class="mb-12"
      />

      <div class="max-w-5xl mx-auto">
        <Card padding="lg">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="border-b-2 border-soil-300">
                <tr class="text-left">
                  <th class="pb-3 font-semibold text-soil-900">Dataset Size</th>
                  <th class="pb-3 font-semibold text-soil-900">Exact Set</th>
                  <th class="pb-3 font-semibold text-harvest-700">Bloom Filter</th>
                  <th class="pb-3 font-semibold text-harvest-700">HyperLogLog</th>
                  <th class="pb-3 font-semibold text-harvest-700">Count-Min</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-soil-200">
                <tr>
                  <td class="py-3 text-soil-700">1M items</td>
                  <td class="py-3 text-soil-700">~64 MB</td>
                  <td class="py-3 text-harvest-700 font-semibold">1.2 MB</td>
                  <td class="py-3 text-harvest-700 font-semibold">1.5 KB</td>
                  <td class="py-3 text-harvest-700 font-semibold">100 KB</td>
                </tr>
                <tr>
                  <td class="py-3 text-soil-700">10M items</td>
                  <td class="py-3 text-soil-700">~640 MB</td>
                  <td class="py-3 text-harvest-700 font-semibold">12 MB</td>
                  <td class="py-3 text-harvest-700 font-semibold">1.5 KB</td>
