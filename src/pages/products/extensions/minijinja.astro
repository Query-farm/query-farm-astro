---
import PageLayout from '../../../layouts/PageLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { Code } from 'astro:components';
---

<PageLayout
  title="MiniJinja Templates - DuckDB Extension"
  description="Powerful Jinja2-style templating engine for DuckDB. Generate dynamic SQL, format output, and transform data with expressive templates."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'Extensions', href: '/products/extensions' },
    { name: 'MiniJinja Templates', href: '/products/extensions/minijinja' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 lg:py-16 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container">
      <div class="flex items-start gap-6">
        <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-5xl">
          📝
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-4">
            <h1 class="text-4xl md:text-5xl font-bold">
              MiniJinja Templates
            </h1>
            <Badge variant="warning" size="sm">Beta</Badge>
          </div>
          <p class="text-xl md:text-2xl text-harvest-50 mb-6 max-w-3xl">
            Bring the power of Jinja2 templating to DuckDB. Generate dynamic SQL, format output, and transform data with control flow, filters, and macros.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="https://github.com/queryfarm/duckdb-minijinja" variant="secondary" size="md" external>
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              View on GitHub
            </Button>
            <Button href="https://docs.query.farm/extensions/minijinja" variant="ghost" size="md" class="bg-white/10 hover:bg-white/20 text-white border-white/30" external>
              Full Documentation
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Install -->
  <section class="py-12 bg-white border-b border-soil-200">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-soil-900 mb-4">Quick Install</h2>
        <Card padding="lg" class="bg-soil-900">
          <Code code={`-- Install the extension
INSTALL minijinja FROM 'query.farm';

-- Load it into your session
LOAD minijinja;

-- Render a template
SELECT template_render('Hello, {{ name }}!', '{"name": "World"}') AS output;
-- Result: 'Hello, World!'`} lang="sql" theme="dracula" />
        </Card>
      </div>
    </div>
  </section>

  <!-- Why Templates in SQL? -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Overview"
        title="Why Templating in SQL?"
        description="Dynamic SQL generation, complex text formatting, and data transformation with familiar Jinja2 syntax."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-3xl">
            🔧
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Dynamic SQL</h3>
          <p class="text-soil-700">
            Generate queries programmatically with variables, loops, and conditions. Build reports that adapt to user input.
          </p>
        </Card>

        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-grain-100 flex items-center justify-center text-3xl">
            📊
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Rich Formatting</h3>
          <p class="text-soil-700">
            Format query results into HTML, Markdown, JSON, or custom text formats. Perfect for reports and notifications.
          </p>
        </Card>

        <Card padding="lg" class="bg-white">
          <div class="w-16 h-16 mb-4 rounded-xl bg-duck-100 flex items-center justify-center text-3xl">
            🎨
          </div>
          <h3 class="text-xl font-bold text-soil-900 mb-3">Jinja2 Compatible</h3>
          <p class="text-soil-700">
            Familiar syntax if you've used Flask, Ansible, or other Jinja2 tools. Full feature set including filters and macros.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Capabilities"
        title="Complete Template Engine"
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <Card padding="lg" class="border-l-4 border-harvest-500">
          <h3 class="text-xl font-bold text-soil-900 mb-3">🔁 Control Flow</h3>
          <ul class="space-y-2 text-sm text-soil-700">
            <li>• <code class="bg-soil-100 px-1 rounded">{% if %}</code> conditional blocks</li>
            <li>• <code class="bg-soil-100 px-1 rounded">{% for %}</code> loops with break/continue</li>
            <li>• <code class="bg-soil-100 px-1 rounded">{% while %}</code> loops</li>
            <li>• Nested conditionals and loops</li>
            <li>• <code class="bg-soil-100 px-1 rounded">{% elif %}</code> and <code class="bg-soil-100 px-1 rounded">{% else %}</code> branches</li>
          </ul>
        </Card>

        <Card padding="lg" class="border-l-4 border-grain-500">
          <h3 class="text-xl font-bold text-soil-900 mb-3">🔧 Filters</h3>
          <ul class="space-y-2 text-sm text-soil-700">
            <li>• String manipulation (upper, lower, title, trim)</li>
            <li>• Number formatting (round, abs, format)</li>
            <li>• Date/time formatting</li>
            <li>• Collection filters (join, sort, unique)</li>
            <li>• Custom filter registration</li>
          </ul>
        </Card>

        <Card padding="lg" class="border-l-4 border-duck-500">
          <h3 class="text-xl font-bold text-soil-900 mb-3">📦 Macros</h3>
          <ul class="space-y-2 text-sm text-soil-700">
            <li>• Reusable template snippets</li>
            <li>• Parameters and default values</li>
            <li>• Macro imports across templates</li>
            <li>• Variable scoping</li>
            <li>• Recursive macros</li>
          </ul>
        </Card>

        <Card padding="lg" class="border-l-4 border-earth-500">
          <h3 class="text-xl font-bold text-soil-900 mb-3">🛡️ Safety</h3>
          <ul class="space-y-2 text-sm text-soil-700">
            <li>• Auto-escaping for HTML/XML</li>
            <li>• SQL injection prevention</li>
            <li>• Configurable escaping modes</li>
            <li>• Safe filters (safe, escape)</li>
            <li>• Sandboxed execution</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <!-- Basic Examples -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Getting Started"
        title="Basic Examples"
        class="mb-12"
      />

      <div class="space-y-8 max-w-6xl mx-auto">
        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">Variable Substitution</h3>
          <p class="text-soil-700 mb-4">
            The simplest use case: replace variables in text.
          </p>
          <Code code={`-- Basic variable substitution
SELECT template_render(
  'Hello, {{ user.name }}! You have {{ count }} new messages.',
  '{"user": {"name": "Alice"}, "count": 5}'
) AS message;
-- Result: 'Hello, Alice! You have 5 new messages.'

-- Use with table data
SELECT template_render(
  'Order #{{ order_id }} for {{ customer }} is {{ status }}.',
  json_object(
    'order_id', order_id,
    'customer', customer_name,
    'status', status
  )
) AS notification
FROM orders
WHERE created_at >= CURRENT_DATE;`} lang="sql" theme="dracula" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">Conditionals</h3>
          <p class="text-soil-700 mb-4">
            Show different content based on conditions.
          </p>
          <Code code={`-- Conditional rendering
SELECT template_render(
  '{% if score >= 90 %}Excellent{% elif score >= 70 %}Good{% else %}Needs Improvement{% endif %}',
  json_object('score', 85)
) AS grade;
-- Result: 'Good'

-- Dynamic email based on user status
SELECT
  email,
  template_render(
    'Dear {{ name }},
    {% if is_premium %}
      Thank you for being a premium member!
    {% else %}
      Upgrade to premium for exclusive benefits.
    {% endif %}',
    json_object('name', name, 'is_premium', is_premium)
  ) AS email_body
FROM users;`} lang="sql" theme="dracula" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">Loops</h3>
          <p class="text-soil-700 mb-4">
            Iterate over arrays and generate repeated content.
          </p>
          <Code code={`-- Loop over items
SELECT template_render(
  'Order Items:
  {% for item in items %}
  - {{ item.name }}: ${{ item.price }}
  {% endfor %}',
  '{"items": [
    {"name": "Widget", "price": 10.99},
    {"name": "Gadget", "price": 24.99}
  ]}'
) AS order_summary;

-- Result:
-- Order Items:
-- - Widget: $10.99
-- - Gadget: $24.99

-- Loop with special variables
SELECT template_render(
  '{% for user in users %}
  {{ loop.index }}. {{ user }}{% if not loop.last %}, {% endif %}
  {% endfor %}',
  '{"users": ["Alice", "Bob", "Charlie"]}'
) AS numbered_list;
-- Result: '1. Alice, 2. Bob, 3. Charlie'`} lang="sql" theme="dracula" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">Filters</h3>
          <p class="text-soil-700 mb-4">
            Transform values with built-in filters.
          </p>
          <Code code={`-- String filters
SELECT template_render(
  'HELLO WORLD' | lower | title,
  '{}'
) AS formatted;
-- Result: 'Hello World'

-- Number formatting
SELECT template_render(
  'Price: ${{ price | round(2) }}',
  '{"price": 19.99456}'
) AS display_price;
-- Result: 'Price: $19.99'

-- Array filters
SELECT template_render(
  'Tags: {{ tags | join(", ") | upper }}',
  '{"tags": ["sql", "database", "analytics"]}'
) AS tag_list;
-- Result: 'Tags: SQL, DATABASE, ANALYTICS'

-- Date formatting
SELECT template_render(
  'Published: {{ date | date("%B %d, %Y") }}',
  json_object('date', CURRENT_DATE)
) AS formatted_date;`} lang="sql" theme="dracula" />
        </Card>
      </div>
    </div>
  </section>

  <!-- Advanced Examples -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Advanced Usage"
        title="Real-World Applications"
        class="mb-12"
      />

      <div class="space-y-8 max-w-6xl mx-auto">
        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">📧 HTML Email Generation</h3>
          <p class="text-soil-700 mb-4">
            Generate personalized HTML emails with auto-escaping for safety.
          </p>
          <Code code={`-- Generate HTML email for abandoned carts
SELECT
  user_id,
  email,
  template_render(
    '<!DOCTYPE html>
    <html>
    <body>
      <h1>Hi {{ customer_name }}!</h1>
      <p>You left {{ cart_count }} item{{ cart_count > 1 ? "s" : "" }} in your cart:</p>
      <ul>
      {% for item in cart_items %}
        <li>
          <strong>{{ item.name }}</strong> - ${{ item.price }}
          {% if item.discount %}
            <span style="color: red;">{{ item.discount }}% off!</span>
          {% endif %}
        </li>
      {% endfor %}
      </ul>
      <p><strong>Total: ${{ total }}</strong></p>
      <a href="{{ checkout_url }}">Complete Your Purchase</a>
    </body>
    </html>',
    json_object(
      'customer_name', name,
      'cart_count', cart_count,
      'cart_items', cart_items_json,
      'total', cart_total,
      'checkout_url', 'https://example.com/checkout/' || user_id
    )
  ) AS email_html
FROM abandoned_carts
WHERE last_updated < CURRENT_TIMESTAMP - INTERVAL '24 hours';`} lang="sql" theme="github-light" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">📊 Markdown Report Generation</h3>
          <p class="text-soil-700 mb-4">
            Create formatted reports in Markdown for documentation or notifications.
          </p>
          <Code code={`-- Weekly analytics report in Markdown
WITH weekly_metrics AS (
  SELECT
    json_object(
      'week', DATE_TRUNC('week', CURRENT_DATE),
      'total_users', COUNT(DISTINCT user_id),
      'total_revenue', SUM(amount),
      'top_products', json_group_array(
        json_object('name', product_name, 'sales', sales_count)
      )
    ) AS metrics_json
  FROM sales
  WHERE date >= CURRENT_DATE - INTERVAL '7 days'
)
SELECT template_render(
  '# Weekly Report - {{ week | date("%B %d, %Y") }}

## Overview
- **Total Users**: {{ total_users | number_format }}
- **Revenue**: ${{ total_revenue | round(2) | number_format }}

## Top Products
{% for product in top_products %}
{{ loop.index }}. **{{ product.name }}** - {{ product.sales }} sales
{% endfor %}

## Performance
{% if total_revenue > 10000 %}
🎉 **Excellent week!** Revenue exceeded $10,000.
{% elif total_revenue > 5000 %}
✅ **Good progress.** On track for monthly goals.
{% else %}
⚠️ **Below target.** Focus on promotions this week.
{% endif %}
',
  metrics_json
) AS report_markdown
FROM weekly_metrics;`} lang="sql" theme="github-light" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">🔧 Dynamic SQL Generation</h3>
          <p class="text-soil-700 mb-4">
            Build complex queries programmatically based on user input or configuration.
          </p>
          <Code code={`-- Generate WHERE clause from user filters
WITH user_filters AS (
  SELECT json_object(
    'date_from', '2024-01-01',
    'date_to', '2024-12-31',
    'status', ['active', 'pending'],
    'min_amount', 100,
    'categories', ['electronics', 'books']
  ) AS filters
)
SELECT template_render(
  'SELECT * FROM orders
   WHERE 1=1
   {% if date_from %}
     AND order_date >= ''{{ date_from }}''
   {% endif %}
   {% if date_to %}
     AND order_date <= ''{{ date_to }}''
   {% endif %}
   {% if status %}
     AND status IN ({% for s in status %}''{{ s }}''{% if not loop.last %}, {% endif %}{% endfor %})
   {% endif %}
   {% if min_amount %}
     AND amount >= {{ min_amount }}
   {% endif %}
   {% if categories %}
     AND category IN ({% for c in categories %}''{{ c }}''{% if not loop.last %}, {% endif %}{% endfor %})
   {% endif %}
   ORDER BY order_date DESC',
  filters
) AS generated_query
FROM user_filters;

-- Result: Ready-to-execute SQL with dynamic filters applied`} lang="sql" theme="github-light" />
        </Card>

        <Card padding="lg">
          <h3 class="text-xl font-semibold text-soil-900 mb-3">🎯 Macros for Reusable Components</h3>
          <p class="text-soil-700 mb-4">
            Define macros for repeated patterns and complex logic.
          </p>
          <Code code={`-- Define and use macros
SELECT template_render(
  '{% macro product_card(product) %}
  <div class="product">
    <h3>{{ product.name | upper }}</h3>
    <p>{{ product.description }}</p>
    <p class="price">${{ product.price | round(2) }}</p>
    {% if product.in_stock %}
      <button>Add to Cart</button>
    {% else %}
      <p class="out-of-stock">Out of Stock</p>
    {% endif %}
  </div>
  {% endmacro %}

  <div class="products-grid">
  {% for product in products %}
    {{ product_card(product) }}
  {% endfor %}
  </div>',
  json_object('products', products_json)
) AS products_html
FROM product_catalog;

-- Macro with default parameters
SELECT template_render(
  '{% macro badge(text, color="blue") %}
  <span class="badge badge-{{ color }}">{{ text }}</span>
  {% endmacro %}

  Status: {{ badge("Active", "green") }}
  Priority: {{ badge("High", "red") }}
  Type: {{ badge("User") }}',
  '{}'
) AS badges_html;`} lang="sql" theme="github-light" />
        </Card>
      </div>
    </div>
  </section>

  <!-- API Reference -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="API Reference"
        title="Function Reference"
        class="mb-12"
      />

      <div class="max-w-6xl mx-auto space-y-8">
        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">Core Functions</h3>

          <div class="space-y-6">
            <div>
              <h4 class="text-lg font-semibold text-soil-900 mb-2 font-mono text-sm">template_render(template, context_json)</h4>
              <p class="text-soil-700 mb-3">
                Renders a template string with the provided JSON context. Returns the rendered string.
              </p>
              <div class="bg-soil-100 rounded p-3 text-sm space-y-1">
                <p><strong>Parameters:</strong></p>
                <ul class="list-disc list-inside text-soil-700 ml-4">
                  <li><code>template</code>: Template string with Jinja2 syntax</li>
                  <li><code>context_json</code>: JSON string or object with template variables</li>
                </ul>
                <p class="mt-2"><strong>Returns:</strong> VARCHAR - Rendered template</p>
              </div>
            </div>

            <div>
              <h4 class="text-lg font-semibold text-soil-900 mb-2 font-mono text-sm">template_render_file(file_path, context_json)</h4>
              <p class="text-soil-700 mb-3">
                Loads and renders a template from a file.
              </p>
              <Code code={`-- Load template from file system
SELECT template_render_file(
  '/templates/email.jinja',
  json_object('name', 'Alice', 'order_id', 12345)
) AS email;`} lang="sql" theme="dracula" />
            </div>

            <div>
              <h4 class="text-lg font-semibold text-soil-900 mb-2 font-mono text-sm">template_validate(template)</h4>
              <p class="text-soil-700 mb-3">
                Validates template syntax. Returns NULL if valid, error message if invalid.
              </p>
              <Code code={`-- Validate before using
SELECT template_validate('Hello {{ name }}!');
-- Result: NULL (valid)

SELECT template_validate('Hello {{ name }');
-- Result: 'Syntax error: Unclosed variable'`} lang="sql" theme="dracula" />
            </div>
          </div>
        </Card>

        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">Built-in Filters</h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div>
              <h4 class="font-semibold text-soil-900 mb-2">String Filters</h4>
              <ul class="space-y-1 text-soil-700 font-mono text-xs">
                <li>• upper, lower, title, capitalize</li>
                <li>• trim, ltrim, rtrim</li>
                <li>• replace(old, new)</li>
                <li>• truncate(length)</li>
                <li>• escape, safe</li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-soil-900 mb-2">Number Filters</h4>
              <ul class="space-y-1 text-soil-700 font-mono text-xs">
                <li>• round(precision)</li>
                <li>• abs, floor, ceil</li>
                <li>• number_format</li>
                <li>• float, int</li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-soil-900 mb-2">Array/List Filters</h4>
              <ul class="space-y-1 text-soil-700 font-mono text-xs">
                <li>• join(separator)</li>
                <li>• sort, reverse</li>
                <li>• first, last</li>
                <li>• length, count</li>
                <li>• unique, slice(start, end)</li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-soil-900 mb-2">Date/Time Filters</h4>
              <ul class="space-y-1 text-soil-700 font-mono text-xs">
                <li>• date(format)</li>
                <li>• datetime(format)</li>
                <li>• timestamp</li>
              </ul>
            </div>
          </div>
        </Card>

        <Card padding="lg">
          <h3 class="text-2xl font-bold text-soil-900 mb-6">Template Syntax Quick Reference</h3>

          <div class="space-y-4">
            <div class="grid grid-cols-3 gap-4 text-sm font-semibold text-soil-900 border-b border-soil-200 pb-2">
              <div>Syntax</div>
              <div>Purpose</div>
              <div>Example</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{{ "{{ var }}" }}</div>
              <div>Variable output</div>
              <div class="font-mono text-xs">{{ "{{ user.name }}" }}</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{% "{% if %}" %}</div>
              <div>Conditional</div>
              <div class="font-mono text-xs">{% "{% if x > 10 %}" %}...{% "{% endif %}" %}</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{% "{% for %}" %}</div>
              <div>Loop</div>
              <div class="font-mono text-xs">{% "{% for item in items %}" %}...{% "{% endfor %}" %}</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{{ "{{ var | filter }}" }}</div>
              <div>Apply filter</div>
              <div class="font-mono text-xs">{{ "{{ name | upper }}" }}</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{% "{% macro %}" %}</div>
              <div>Define macro</div>
              <div class="font-mono text-xs">{% "{% macro greeting(name) %}" %}...{% "{% endmacro %}" %}</div>
            </div>
            <div class="grid grid-cols-3 gap-4 text-sm text-soil-700">
              <div class="font-mono text-xs">{# ... #}</div>
              <div>Comment</div>
              <div class="font-mono text-xs">{# This is ignored #}</div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

