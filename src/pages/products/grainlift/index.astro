---
import { organization } from '../../../lib/organization';
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import SectionSubNav from '../../../components/sections/SectionSubNav.astro';
import GrainliftArchitecture from '../../../components/products/GrainliftArchitecture.astro';
import RelatedPosts from '../../../components/blog/RelatedPosts.astro';
import { Icon } from 'astro-icon/components';

const repo = 'https://github.com/Query-farm/grainlift';
const evidence = `${repo}/tree/main/validation/load-results`;
const description = 'Make your data a service. Proxy existing databases or build new ADBC services in Rust, Go, Python, and TypeScript. Grainlift connects both to ordinary ADBC applications through Arrow and VGI-RPC.';
const tabs = [
  { name: 'Architecture', href: '#architecture' },
  { name: 'Build a service', href: '#frameworks' },
  { name: 'Benchmarks', href: '#benchmarks' },
  { name: 'Grainlift & VGI', href: '#ecosystem' },
  { name: 'Walkthroughs', href: '#stories' },
];
const languages = [
  { name: 'Rust', icon: 'simple-icons:rust', role: 'Build on the native server library.', detail: 'Implement Grainlift’s Backend, BackendConnection, and BackendStatement traits.', sdk: `${repo}/tree/main/crates/grainlift-server`, example: 'grainlift-rust-hello-world', label: 'Server library' },
  { name: 'Go', icon: 'simple-icons:go', role: 'Bring your backend to net/http.', detail: 'Implement Backend, Connection, and Statement interfaces; return an Arrow record reader.', sdk: 'https://github.com/Query-farm/grainlift-go', example: 'grainlift-hello-world-go', label: 'Go framework' },
  { name: 'Python', icon: 'simple-icons:python', role: 'Turn Python logic into a data service.', detail: 'Implement Worker, Connection, and Statement hooks; yield lazy PyArrow batches.', sdk: 'https://github.com/Query-farm/grainlift-python', example: 'grainlift-hello-world-python', label: 'Python framework' },
  { name: 'TypeScript', icon: 'simple-icons:typescript', role: 'Serve Arrow from your Node.js stack.', detail: 'Implement backend classes with typed results and the Grainlift service lifecycle.', sdk: 'https://github.com/Query-farm/grainlift-typescript', example: 'grainlift-hello-world-typescript', label: 'TypeScript framework' },
];
const proxyResults = [
  { name: 'DuckDB', value: '3,349.6', amount: 3349.6, p99: '17.5 ms' },
  { name: 'PostgreSQL', value: '1,130.0', amount: 1130, p99: '35.3 ms' },
  { name: 'SQLite', value: '1,064.4', amount: 1064.4, p99: '32.2 ms' },
];
const serviceResults = [
  { name: 'TCP / mTLS', value: '3.82', amount: 3.82, p99: '4.18–5.26 ms' },
  { name: 'HTTP', value: '10.09', amount: 10.09, p99: '10.76–16.18 ms' },
];
---
<PageLayout title="Grainlift — Make your data a service" description={description}
  ogImage="/grainlift/grainlift-social.png"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Grainlift', description,
    url: 'https://query.farm/products/grainlift', applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS, Windows',
    license: 'https://www.apache.org/licenses/LICENSE-2.0', publisher: organization }}>
  <SectionSubNav slot="subnav" name="Grainlift" href="/products/grainlift" tabs={tabs}>
    <img slot="icon" src="/grainlift/grainlift-mark.svg" alt="" width="28" height="28" />
    <a slot="action" class="text-xs text-link" href={repo}>GitHub ↗</a>
  </SectionSubNav>

  <div class="grainlift-page">
    <header class="hero">
      <div class="wrap hero-layout">
        <div class="hero-copy">
          <span class="eyebrow">Grainlift / Open-source data infrastructure</span>
          <a class="preview-note" href="#framework-availability"><strong>Developer preview</strong><span>Build from source ↗</span></a>
          <h1>Make your data<br/>a <em>service.</em></h1>
          <p class="hero-lede">The database you already run.<br/>The data product you haven’t built yet.<br/><strong>One standard way to connect to both.</strong></p>
          <p class="hero-detail">Proxy existing database drivers or build an ADBC service for anything your code can reach. Write it in Rust, Go, Python, or TypeScript. You define the query; Apache Arrow carries the results.</p>
          <div class="hero-actions"><Button href="#architecture">See how it works ↓</Button><a href="#frameworks" class="editorial-link">Build a service <span>↗</span></a></div>
          <p class="open-note">Apache 2.0 <span>·</span> Built by Query.Farm</p>
        </div>
        <figure class="hero-art">
          <img src="/grainlift/grainlift-data-elevator.webp" width="1536" height="1024" fetchpriority="high" alt="An illustrated grain elevator connects existing storage silos and a custom workshop to three delivery stations, a metaphor for making databases and new services accessible through one interface." />
          <figcaption><span><i class="silo-dot"></i> Existing databases</span><span><i class="workshop-dot"></i> New data services</span><span>↓ One ADBC interface</span></figcaption>
        </figure>
      </div>
    </header>
    <div class="hairband" aria-hidden="true"><i class="bg-pipe-1"></i><i class="bg-pipe-2"></i><i class="bg-pipe-3"></i><i class="bg-pipe-4"></i><i class="bg-pipe-5"></i><i class="bg-pipe-6"></i></div>

    <section id="adbc" class="opening wrap" aria-labelledby="adbc-heading">
      <p class="eyebrow">New to ADBC? Start here.</p>
      <h2 id="adbc-heading">A common way to connect.<br/>Data ready for analytics.</h2>
      <div class="adbc-introduction">
        <p><strong>ADBC stands for Arrow Database Connectivity.</strong> It is an open standard from the Apache Arrow project for connecting applications to databases. Like ODBC or JDBC, it gives developers a familiar set of operations: connect, run a query, and read the results.</p>
        <p>ADBC is built around Apache Arrow: a format that organizes data into typed columns. Results arrive in batches that analytical tools and data frames can consume efficiently, reducing the need for format conversions.</p>
        <p><strong>Grainlift brings that interface to your service or idea.</strong> ADBC drivers typically connect to databases. Grainlift can proxy those connections—or let you build a service that behaves like an ADBC driver to its clients, backed by anything your code can reach.</p>
        <a class="adbc-docs" href="https://arrow.apache.org/adbc/current/">Get to know Apache Arrow ADBC ↗</a>
      </div>
    </section>

    <div class="wrap standards-row" aria-label="Built on open standards">
      <a href="https://arrow.apache.org/" aria-label="Apache Arrow"><img src="/grainlift/apache-arrow-logo.svg" alt="Apache Arrow" width="180" height="94" loading="lazy" /></a>
      <div><span class="eyebrow">Built on Apache Arrow</span><p><a href="https://arrow.apache.org/adbc/current/">ADBC for the connection.</a> Arrow for the data.</p></div>
    </div>

    <aside class="wrap scanner-connection" aria-labelledby="scanner-heading">
      <div class="scanner-inner">
        <img src="/images/duckdb-icon.svg" alt="" width="38" height="38" loading="lazy" />
        <div><h3 id="scanner-heading">We build on ADBC in DuckDB, too.</h3><p>Query Farm maintains <a href="/products/extensions/adbc_scanner"><code>adbc_scanner</code></a>, the DuckDB extension for connecting to databases through ADBC drivers. Query external data, explore catalogs, and bring Arrow results into DuckDB.</p></div>
        <a class="scanner-link" href="/products/extensions/adbc_scanner">Explore ADBC Scanner →</a>
      </div>
    </aside>

    <section id="architecture" class="architecture-section wrap">
      <div class="section-heading"><div><span class="eyebrow">Two starting points. One interface.</span><h2>Connect what exists.<br/>Create what’s next.</h2></div><p>Both paths use the same Grainlift client driver. Choose where the data comes from; your applications keep speaking ADBC.</p></div>
      <GrainliftArchitecture />
      <div class="path-stories">
        <article><span class="story-index">01 / PROXY</span><h3>Turn installed drivers<br/>into shared infrastructure.</h3><p>Run downstream drivers and their dependencies once on the service. Give applications a named, authorized target. Keep database credentials and configuration under central control.</p><a href={`${repo}#quick-start`}>Start with an existing database ↗</a></article>
        <article><span class="story-index">02 / BUILD</span><h3>Anything your code can reach.<br/>An ADBC interface to it all.</h3><p>Connect to APIs, files, models, proprietary systems, or your own business logic. Your service interprets the request and returns Arrow batches through the Grainlift driver. Grainlift handles the connection and result lifecycle; no downstream database is required.</p><a href="#frameworks">Choose your framework ↓</a></article>
      </div>
    </section>

    <section id="query-semantics" class="query-language wrap" aria-labelledby="query-language-heading">
      <div class="query-language-copy"><span class="eyebrow">A familiar interface. Your own semantics.</span><h2 id="query-language-heading">You decide what<br/>a query means.</h2><p>Database drivers usually interpret a query as SQL. In a custom Grainlift service, your backend decides how to interpret the statement text: SQL, a domain-specific expression, a command, or a natural-language request.</p><p>You implement the parser, routing, or model call. The application still executes a statement through ADBC and reads typed Arrow results.</p><a href="https://github.com/Query-farm/grainlift-rust-hello-world#workload">See it in practice: the Rust example accepts <code>QUERY</code> ↗</a></div>
      <figure class="query-examples"><div class="query-example-heading"><span>Your statement text</span><span>Your backend’s response</span></div>
        <div class="query-example"><code>QUERY</code><span aria-hidden="true">→</span><p>Generate Arrow batches<small>The runnable Rust example</small></p></div>
        <div class="query-example"><code>prices: AAPL, MSFT</code><span aria-hidden="true">→</span><p>Fetch a market-data API<small>Return symbols, prices, and timestamps</small></p></div>
        <div class="query-example"><code>Forecast next week</code><span aria-hidden="true">→</span><p>Run your forecasting model<small>Return dates and predicted values</small></p></div>
        <figcaption>The API and forecast requests illustrate services you could build. Your backend defines their syntax and behavior. Tools that generate SQL need a backend that understands that SQL.</figcaption>
      </figure>
    </section>

    <section class="possibilities wrap">
      <div class="margin-label"><span class="eyebrow">What this enables</span><p>Less integration work.<br/>More places your data can go.</p></div>
      <div class="possibility-list">
        <article><Icon name="ph:plugs-connected"/><div><h3>One integration for your customers.</h3><p>Deliver your data product through a standard ADBC connection. Customers can consume Arrow results in their applications and pipelines.</p></div></article>
        <article><Icon name="ph:buildings"/><div><h3>A shared access layer for your teams.</h3><p>Centralize database drivers, credentials, and target permissions. Keep native driver installations out of every notebook, job, and application image.</p></div></article>
        <article><Icon name="ph:flask"/><div><h3>A path from useful code to useful service.</h3><p>Put your pricing logic, research dataset, or model outputs behind an ADBC interface. Implement the queries and capabilities your backend can actually support.</p></div></article>
      </div>
    </section>

    <section id="frameworks" class="frameworks-section">
      <div class="wrap">
        <div class="section-heading"><div><span class="eyebrow">Your language. Their database interface.</span><h2>Write the service.<br/>Grainlift brings the plumbing.</h2></div><p>Frameworks in four languages share the Grainlift contract. Define what a request means and where its data comes from; reuse authentication, handle ownership, bounded results, and cleanup.</p></div>
        <div class="ownership-strip"><div><span>You write</span><strong>Query behavior & Arrow results</strong></div><span class="ownership-arrow" aria-hidden="true">→</span><div><span>Grainlift provides</span><strong>ADBC service lifecycle over VGI-RPC</strong></div><span class="ownership-arrow" aria-hidden="true">→</span><div><span>Your users get</span><strong>An ordinary ADBC connection</strong></div></div>
        <div class="language-list">{languages.map(language => <article>
          <div class="language-name"><Icon name={language.icon}/><h3>{language.name}</h3></div>
          <div class="language-detail"><h4>{language.role}</h4><p>{language.detail}</p></div>
          <div class="language-links"><a href={language.sdk}>{language.label} ↗</a><a href={`https://github.com/Query-farm/${language.example}`}>Hello world ↗</a></div>
        </article>)}</div>
        <details id="framework-availability" class="release-notes"><summary>Framework availability & supported capabilities</summary><div><p>The Rust path reuses the Grainlift server library; Go, Python, and TypeScript have dedicated backend frameworks. Start from the source repositories and runnable examples. The TypeScript package is prerelease and not yet on npm; Python package publication is a separate release step.</p><p>Go supports HTTP, HTTPS, loopback TCP, mTLS TCP, and Iroh with the published VGI-RPC Go v0.30.0 dependency. Iroh requires a separately installed VGI Iroh bridge. See each framework’s repository for transport setup and requirements. Your backend implements SQL behavior, transactions, and other capabilities; unsupported operations return ADBC NOT_IMPLEMENTED. The frameworks do not supply a general SQL engine.</p></div></details>
      </div>
    </section>

    <section id="benchmarks" class="benchmarks-section wrap">
      <div class="section-heading"><div><span class="eyebrow">Measured, not imagined / EC2 · 26 Sep 2026</span><h2>Real queries.<br/>Recorded results.</h2></div><p>Database proxy throughput and custom-service latency, measured through the native ADBC driver. Select a workload to see the numbers in context.</p></div>
      <div class="benchmark-explorer" data-benchmarks>
        <div class="benchmark-switch" role="tablist" aria-label="Benchmark workload"><button id="proxy-tab" type="button" role="tab" aria-selected="true" aria-controls="proxy-benchmark" data-benchmark="proxy">Database proxy</button><button id="service-tab" type="button" role="tab" aria-selected="false" aria-controls="service-benchmark" tabindex="-1" data-benchmark="service">Custom Rust service</button></div>
        <div id="proxy-benchmark" role="tabpanel" aria-labelledby="proxy-tab" tabindex="0">
          <div class="benchmark-main"><div class="benchmark-stat"><div class="stat-value">3,349<span>.6</span></div><p>queries / second</p><span>DuckDB through Grainlift · HTTP</span><div class="stat-foot">32 concurrent sessions<br/>2,048 verified rows per query</div></div>
          <div class="chart"><div class="chart-heading"><span>THROUGHPUT / QUERIES PER SECOND</span><span>Higher is better →</span></div>{proxyResults.map(result => <div class="chart-row"><div class="chart-label"><strong>{result.name}</strong><span class="qf-figure">{result.value}</span></div><div class="bar-track"><div class="bar" style={`width:${result.amount / 3500 * 100}%`}></div></div><span class="chart-tail">p99 latency {result.p99}</span></div>)}<div class="chart-axis"><span>0</span><span>1,750</span><span>3,500</span></div></div></div>
          <div class="benchmark-method"><p><strong>The workload.</strong> A 200,000-row dataset; 2,048 rows and a 128-byte payload per row returned and verified on each query. Each of 32 independent sessions ran two warmups and 50 measured iterations. One short run per backend over HTTP.</p><p><strong>The environment.</strong> Client, server, and databases on the same EC2 host: 48 ARM Neoverse-N1 CPUs, 92.6 GiB RAM, Amazon Linux 2023. DuckDB 1.5.5; SQLite and PostgreSQL ADBC drivers 1.12.0; PostgreSQL 14. No query errors in these runs.</p><a href={`${evidence}/ec2-v04-20260926`}>Read the workload, memory figures & raw evidence ↗</a></div>
        </div>
        <div id="service-benchmark" role="tabpanel" aria-labelledby="service-tab" tabindex="0" hidden>
          <div class="benchmark-main"><div class="benchmark-stat"><div class="stat-value">3<span>.82</span><small>ms</small></div><p>mean query latency</p><span>Custom Rust service · TCP / mTLS</span><div class="stat-foot">4,096 verified rows per query<br/>8 Arrow batches · no SQL engine</div></div>
          <div class="chart"><div class="chart-heading"><span>MEAN QUERY LATENCY / MILLISECONDS</span><span>← Lower is better</span></div>{serviceResults.map(result => <div class="chart-row"><div class="chart-label"><strong>{result.name}</strong><span class="qf-figure">{result.value} ms</span></div><div class="bar-track"><div class="bar" style={`width:${result.amount / 12 * 100}%`}></div></div><span class="chart-tail">Per-run p99 range {result.p99}</span></div>)}<div class="chart-axis"><span>0</span><span>6</span><span>12 ms</span></div></div></div>
          <div class="benchmark-method"><p><strong>The workload.</strong> A synthetic Rust service returns 4,096 rows with 64-byte payloads in eight 512-row batches. One reused ADBC connection; ten warmups, 1,000 measured queries, and 100 expected errors per run. Means average three repetitions; successful-query latency excludes expected errors and initial connection setup.</p><p><strong>The environment.</strong> Same-host EC2 loopback, 48 ARM Neoverse-N1 CPUs, 92.6 GiB RAM, Amazon Linux 2023. Release Rust build, verified mTLS, and bounded result connection reuse. No downstream database. All reported cases passed with zero unexpected errors.</p><a href={`${evidence}/ec2-result-reuse-20260926`}>Read the methodology & raw evidence ↗</a></div>
        </div>
      </div>
      <p class="benchmark-scope">These are different workloads, not a proxy-versus-framework comparison. Same-host measurements do not establish WAN performance or production capacity. There is no direct-ADBC baseline here. Go and TypeScript performance is not represented by these results.</p>
    </section>

    <section id="ecosystem" class="ecosystem-section"><div class="wrap ecosystem-layout">
      <div><span class="eyebrow">Grainlift + VGI / Complementary by design</span><h2>Shared roots.<br/>Different ways to grow.</h2><p>Grainlift and VGI are complementary products, built for different ways of using data. You can use both in the same platform.</p><p><strong>Grainlift</strong> gives applications a standard ADBC connection to databases and custom services. <strong>VGI</strong> extends DuckDB and Haybarn with remote tables and functions that participate in SQL queries.</p><p>They share <strong>VGI-RPC</strong> and Apache Arrow underneath. That common foundation supports both database-style access from applications and custom capabilities inside a query engine.</p><a href="/vgi">Explore the VGI product →</a></div>
      <figure class="family-tree" aria-label="Grainlift for ADBC applications and VGI for DuckDB and Haybarn share VGI-RPC and Apache Arrow as their foundation."><div class="family-branches"><div><span>ADBC applications</span><i aria-hidden="true">↕</i><div class="family-logo"><img src="/grainlift/grainlift-mark.svg" alt="" width="76" height="76" loading="lazy" /></div><strong>Grainlift</strong><small>Database & service access</small></div><div><span>DuckDB / Haybarn</span><i aria-hidden="true">↕</i><div class="family-logo"><img src="/vgi/vgi-emblem.webp" alt="" width="112" height="82" loading="lazy" /></div><strong>VGI</strong><small>Remote tables & functions</small></div></div><div class="family-trunk" aria-hidden="true"></div><a class="family-root" href="https://vgi-rpc.query.farm"><strong>VGI-RPC <span>↗</span></strong><small>Shared RPC foundation</small></a><div class="arrow-foundation"><img src="/grainlift/apache-arrow-logo.svg" alt="Apache Arrow" width="150" height="78" loading="lazy" /></div></figure>
    </div>
    <div class="wrap ecosystem-fit">
      <table>
        <caption>Choose the interface your users already work with.</caption>
        <thead><tr><th scope="col">Your goal</th><th scope="col">Grainlift</th><th scope="col">VGI</th></tr></thead>
        <tbody>
          <tr><th scope="row">Reach your users</th><td>Connect notebooks, applications, and pipelines through an ADBC driver.</td><td>Let DuckDB and Haybarn users query remote tables and call functions from SQL.</td></tr>
          <tr><th scope="row">Expose your backend</th><td>Proxy an existing database driver, or interpret requests in your own data service.</td><td>Build a worker that exposes data and computation through VGI’s table and function interfaces.</td></tr>
        </tbody>
      </table>
      <div class="ecosystem-example"><h3>One business capability.<br/>Two ways to use it.</h3><div><p>A pricing team could expose its engine through Grainlift for applications that submit pricing requests, and through a VGI worker for analysts who call a pricing function inside a DuckDB query. Both implementations can reuse the team’s underlying pricing logic.</p><p class="fit-note">Each interface needs its own implementation. Sharing VGI-RPC does not make a Grainlift endpoint a VGI catalog, or make a VGI worker an ADBC service. Grainlift does not require DuckDB.</p></div></div>
    </div></section>

    <RelatedPosts
      title="Grainlift in practice"
      description="Start with an existing database driver, a Cloudflare application, or a service running on your own machine."
      posts={[
        { id: 'native-adbc-in-your-browser', description: 'Connect PostgreSQL to browser SQL through its native ADBC driver. The walkthrough covers connection profiles, Cupola, and joins with local data.' },
        { id: 'query-cloudflare-from-duckdb', description: 'Query Durable Objects, D1, and Analytics Engine through Grainlift. Try the live demo in your browser, or connect from the command line or Python.' },
        { id: 'iroh-vgi-rpc', description: 'Reach a Grainlift gateway through Iroh while keeping the database driver on your machine. See how browser relays and native connections differ.' },
      ]}
    />

    <section class="closing wrap">
      <div class="closing-heading"><img src="/grainlift/grainlift-mark.svg" alt="" width="70" height="70"/><span class="eyebrow">What will you connect next?</span><h2>Your data.<br/>Their next connection.</h2><p>Put an existing database behind Grainlift, or build the service only your team can build.</p><div class="hero-actions"><Button href="/company/contact">Talk to Query Farm →</Button><a class="editorial-link" href={repo}>Explore the source ↗</a></div></div>
      <div class="next-steps"><a href={`${repo}#quick-start`}><span>01</span><div><strong>Proxy a database</strong><small>Build the driver and configure your first target.</small></div><span>↗</span></a><a href="#frameworks"><span>02</span><div><strong>Build a data service</strong><small>Pick a language and run a hello-world backend.</small></div><span>↑</span></a><details><summary>Deployment essentials</summary><p>Sessions, transactions, and cursors belong to one server process. Replicas need session affinity; restarts invalidate sessions. Driver capabilities and cancellation vary. Writes are not automatically replayed after connection loss.</p><a href={`${repo}/blob/main/docs/security.md`}>Security & resource limits ↗</a></details></div>
    </section>
    <div class="wrap trademark-note"><p>Apache Arrow, Arrow, Apache Arrow ADBC, ADBC, and the Apache Arrow logo are trademarks or registered trademarks of <a href="https://www.apache.org/">The Apache Software Foundation</a> in the United States and other countries.</p></div>
  </div>
</PageLayout>

<style>
  .preview-note { display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;width:fit-content;margin-top:16px;font-size:12px;color:var(--color-soil-700);text-decoration:none; }.preview-note strong { border:1px solid var(--color-soil-300);border-radius:4px;padding:4px 8px;color:var(--color-sun-700);font-weight:600; }.preview-note span { text-decoration:underline;text-underline-offset:3px; }#framework-availability { scroll-margin-top:140px; }
  .ecosystem-fit { margin-top:50px; }.ecosystem-fit table { width:100%;border-collapse:collapse;table-layout:fixed;font-size:13px;line-height:1.8;color:var(--color-cream-2); }.ecosystem-fit caption { text-align:left;font:600 26px/1.2 var(--font-display);color:var(--color-cream);padding-bottom:24px; }.ecosystem-fit th,.ecosystem-fit td { padding:17px 20px;border-bottom:1px solid #f4ece030;vertical-align:top;text-align:left; }.ecosystem-fit th { color:var(--color-cream);font-weight:500; }.ecosystem-fit th:first-child { width:23%;padding-left:0; }.ecosystem-fit thead th { font-size:14px; }.ecosystem-example { display:grid;grid-template-columns:.8fr 1.2fr;gap:45px;margin-top:32px; }.ecosystem-example h3 { color:var(--color-cream);font-size:26px; }.ecosystem-example p { color:var(--color-cream-2);font-size:14px;line-height:1.8; }.ecosystem-example .fit-note { margin-top:15px;font-size:11px; }
  @media(max-width:760px) { .ecosystem-fit { margin-top:36px; }.ecosystem-fit th,.ecosystem-fit td { padding:13px 8px;font-size:11px;overflow-wrap:anywhere; }.ecosystem-fit thead th { font-size:12px; }.ecosystem-fit th:first-child { width:23%; }.ecosystem-example { grid-template-columns:1fr;gap:18px; } }
  .query-language { display:grid;grid-template-columns:1fr 1.1fr;gap:60px;padding-bottom:65px;align-items:center; }
  .query-language-copy p { margin-top:18px;font-size:14px;line-height:1.85;color:var(--color-soil-700); }.query-language-copy>a { display:inline-block;margin-top:18px;font-size:12px; }
  .query-examples { border:1px solid var(--color-soil-300);background:#fffdf7; }.query-example-heading { display:flex;justify-content:space-between;gap:16px;padding:18px 22px;background:var(--color-soil-100);font:10px var(--font-mono);color:var(--color-soil-700); }
