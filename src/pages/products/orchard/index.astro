---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import ConnectorCard from '../../../components/products/ConnectorCard.astro';
import { connectors, featuredConnectors } from '../../../data/connectors';

const connectorCount = connectors.length;

// Marketplace catalog: category facets (with counts) + a browse order that puts
// featured connectors first, then the most-attached.
const categoryCounts = connectors.reduce<Record<string, number>>((m, c) => {
  m[c.category] = (m[c.category] ?? 0) + 1;
  return m;
}, {});
const categories = [
  { key: 'all', label: 'All connectors', count: connectors.length },
  ...Object.keys(categoryCounts)
    .sort()
    .map((cat) => ({ key: cat.toLowerCase(), label: cat, count: categoryCounts[cat] })),
];
const catalog = [...connectors].sort(
  (a, b) => Number(b.popular ?? false) - Number(a.popular ?? false) || (b.uses ?? 0) - (a.uses ?? 0),
);

const steps = [
  {
    title: 'Browse the catalog',
    description: 'Find a connector or worker that exposes the system you need — streaming, email, governance, federation, or public data.',
  },
  {
    title: 'Subscribe',
    description: 'Pick a plan and get a token. Free connectors attach with no token at all; paid ones bill per worker.',
  },
  {
    title: 'Attach from SQL',
    description: 'ATTACH the worker in DuckDB or Haybarn and query its tables and functions like any other catalog.',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const orchardDescription =
  'The Orchard is the Query.Farm marketplace for VGI workers and connectors — subscribe to a connector and attach it from DuckDB or Haybarn with ordinary SQL.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Orchard — VGI connector marketplace',
    description: orchardDescription,
    url: `${SITE_ORIGIN}/products/orchard`,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: connectorCount,
      itemListElement: connectors.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        url: `${SITE_ORIGIN}/products/orchard/connectors/${c.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
    ],
  },
];

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
---

<PageLayout
  title="Orchard — VGI Connector Marketplace"
  description={orchardDescription}
  ogImage="/og/orchard.jpg"
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
    ]}
  />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Connector marketplace"
    title="The marketplace for connectors."
    lede="Every connector is a VGI worker that exposes a real system as SQL tables and functions. Subscribe, then attach it from DuckDB or Haybarn with one line of SQL."
    hairband
  >
    <span
      slot="icon"
      class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-3xl leading-none"
      aria-hidden="true"
    >🌳</span>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="#catalog" variant="primary" size="md">Browse the catalog</Button>
      <Button href="/products/orchard/submit" variant="secondary" size="md">Publish a connector</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">{connectorCount}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Connectors listed</div>
    </Fragment>
  </PageHead>

  <!-- ── Featured ────────────────────────────────────────────── -->
  {featuredConnectors.length > 0 && (
    <section class="py-14">
      <div class={WRAP}>
        <span class={EYEBROW}>Featured</span>
        <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Connectors worth a look</h2>
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredConnectors.map((c) => (
            <ConnectorCard connector={c} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Marketplace catalog ─────────────────────────────────── -->
  <section id="catalog" class="scroll-mt-32 border-y border-soil-300 bg-soil-100 py-14 lg:py-16">
    <div class={WRAP}>
      <span class={EYEBROW}>Marketplace</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Browse the Orchard</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Every connector attaches as a SQL catalog in DuckDB or Haybarn. Filter by category or
        search to find one.
      </p>

      <!-- Search -->
      <div class="mt-7 max-w-xl">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
          </svg>
          <input
            id="orchard-search"
            type="search"
            placeholder="Search connectors…"
            autocomplete="off"
            aria-label="Search connectors"
            class="w-full rounded-lg border border-soil-300 bg-[#fffdf7] py-2.5 pl-12 pr-4 text-base font-light text-soil-900 transition placeholder:text-soil-500 focus:border-link focus:outline-none focus:ring-[3px] focus:ring-link/20"
          />
        </div>
      </div>

      <div class="mt-8 lg:grid lg:grid-cols-[13rem_1fr] lg:gap-10">
        <!-- Category rail (chips on mobile, sticky rail on desktop) -->
        <aside class="mb-8 lg:mb-0">
          <h3 class="mb-3 hidden text-[12.5px] font-semibold text-soil-500 lg:block">Categories</h3>
          <div id="orchard-cats" class="flex flex-wrap gap-2 lg:sticky lg:top-24 lg:flex-col lg:gap-1">
            {categories.map((cat, i) => (
              <button type="button" data-cat={cat.key} class:list={['orchard-cat', { 'is-active': i === 0 }]}>
                <span>{cat.label}</span>
                <span class="orchard-cat__count qf-figure">{cat.count}</span>
              </button>
            ))}
          </div>
        </aside>

        <!-- Grid -->
        <div>
          <div id="orchard-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {catalog.map((c) => (
              <div
                class="orchard-item"
                data-category={c.category.toLowerCase()}
                data-search={`${c.name} ${c.tagline} ${c.category} ${c.provider}`.toLowerCase()}
              >
                <ConnectorCard connector={c} />
              </div>
            ))}
          </div>

          <div id="orchard-empty" class="hidden py-16 text-center text-soil-700">
            No connectors match your search.
            <button type="button" id="orchard-reset" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">Clear filters</button>
          </div>

          <p id="orchard-count" class="mt-8 text-center text-[13px] font-medium text-soil-500"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: attach from SQL ──────────────────── -->
  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">How it works</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Subscribe, then attach</h2>
      <p class="mt-3 max-w-[58ch] text-[17.5px] leading-relaxed text-cream-2">
        The Orchard adds the marketplace around VGI workers: discovery, subscriptions,
        credentials, and one consistent way to attach. Bring the connectors you need; leave the
        plumbing to the worker.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class="rounded-xl border border-white/15 px-5 py-5">
            <div class="qf-figure text-2xl leading-none text-sun-400">{i + 1}</div>
            <h3 class="mt-3 text-lg text-cream">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-2">{step.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 overflow-hidden rounded-xl border border-white/15 bg-rock-950">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
          <span class="text-[12.5px] font-medium text-cream-2">attach.sql</span>
          <button
            type="button"
            class="qf-copy rounded-md border border-rock-800 px-2.5 py-1 text-[13px] font-medium text-cream-2 transition-colors hover:border-sun-400 hover:text-sun-400"
          >Copy</button>
        </div>
        <pre class="overflow-x-auto p-5 font-mono text-[12.8px] leading-[1.9] text-[#e9e1d3]"><code><span class="text-[#6d6357]">-- once per session</span>
<span class="text-sun-400">INSTALL</span> vgi <span class="text-sun-400">FROM</span> community;
<span class="text-sun-400">LOAD</span> vgi;

<span class="text-[#6d6357]">-- attach a subscribed connector as a SQL catalog</span>
<span class="text-sun-400">ATTACH</span> <span class="text-[#9fc48c]">'kafka'</span> <span class="text-sun-400">AS</span> <span class="text-[#8fc7d8]">kafka</span> (
  <span class="text-sun-400">TYPE</span> vgi,
  <span class="text-sun-400">LOCATION</span> <span class="text-[#9fc48c]">'https://orchard.query.farm/kafka'</span>
);

<span class="text-sun-400">SELECT</span> * <span class="text-sun-400">FROM</span> <span class="text-[#8fc7d8]">kafka.topics</span>;</code></pre>
      </div>

      <p class="mt-4 text-sm text-cream-2">
        Free connectors skip the token entirely — just <span class="font-mono text-sun-400">ATTACH</span> and query.
        <a href="/products/orchard/subscribe" class="text-link-dark underline decoration-link-dark/40 underline-offset-2 hover:text-link-dark-hover hover:decoration-link-dark-hover">How subscriptions work →</a>
      </p>
    </div>
  </section>

  <!-- ── For subscribers / publishers ────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For teams</span>
          <h2 class="mt-3 text-2xl text-soil-900">Subscribe to a connector</h2>
          <p class="mt-3 leading-relaxed text-soil-700">
            Pick a plan, get a token, and attach. Free connectors need no token; paid connectors
            bill per worker with no infrastructure to run yourself.
          </p>
          <Button href="/products/orchard/subscribe" variant="primary" size="md" class="mt-6">
            How subscriptions work →
          </Button>
        </div>
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For builders</span>
          <h2 class="mt-3 text-2xl text-soil-900">Publish your own</h2>
          <p class="mt-3 leading-relaxed text-soil-700">
            Built a VGI worker? List it on the Orchard, set your pricing, and let teams discover
            and subscribe to it with the same one-line attach.
          </p>
          <Button href="/products/orchard/submit" variant="primary" size="md" class="mt-6">
            Get listed →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="pb-16">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">Need a connector that isn't here yet?</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            We build VGI connectors for the systems your team depends on — and we can publish
            them on the Orchard for you.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Commission a connector</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>
  </section>

  <style>
    .orchard-cat {
      display: inline-flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      border-radius: 0.5rem;
      border: 1px solid var(--color-soil-300);
      background: #fffdf7;
      padding: 0.4rem 0.75rem;
      font-size: 0.875rem;
      font-weight: 400;
      color: var(--color-soil-700);
      cursor: pointer;
      transition: background 0.14s, color 0.14s, border-color 0.14s;
    }
    .orchard-cat:hover {
      border-color: var(--color-sun-400);
      color: var(--color-soil-900);
    }
    .orchard-cat:focus-visible {
      outline: none;
      border-color: var(--color-link);
      box-shadow: 0 0 0 3px rgb(69 99 47 / 0.25);
    }
    .orchard-cat.is-active {
      background: var(--color-soil-900);
      border-color: var(--color-soil-900);
      color: var(--color-cream);
    }
    .orchard-cat__count {
      font-size: 0.72rem;
      color: var(--color-soil-500);
    }
    .orchard-cat.is-active .orchard-cat__count {
      color: var(--color-cream-2);
    }
    /* Chips (not full-width rail) below the lg breakpoint. */
    @media (max-width: 1023px) {
      .orchard-cat {
        width: auto;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const search = document.getElementById('orchard-search');
      const cats = document.getElementById('orchard-cats');
      const grid = document.getElementById('orchard-grid');
      const empty = document.getElementById('orchard-empty');
      const count = document.getElementById('orchard-count');
      const reset = document.getElementById('orchard-reset');
      if (!grid || !cats || !search) return;
      const items = Array.prototype.slice.call(grid.querySelectorAll('.orchard-item'));
      let activeCat = 'all';

      function apply() {
        const q = (search.value || '').trim().toLowerCase();
        let shown = 0;
        items.forEach(function (it) {
          const catOk = activeCat === 'all' || it.dataset.category === activeCat;
          const qOk = !q || it.dataset.search.indexOf(q) !== -1;
          const vis = catOk && qOk;
          it.style.display = vis ? '' : 'none';
          if (vis) shown++;
        });
        empty.classList.toggle('hidden', shown > 0);
        count.textContent =
          shown === items.length
            ? 'Showing all ' + items.length + ' connectors'
            : 'Showing ' + shown + ' of ' + items.length + ' connectors';
      }

      cats.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-cat]');
        if (!btn) return;
        activeCat = btn.dataset.cat;
        cats.querySelectorAll('[data-cat]').forEach(function (b) {
          b.classList.toggle('is-active', b === btn);
        });
        apply();
      });

      search.addEventListener('input', apply);

      if (reset)
        reset.addEventListener('click', function () {
          search.value = '';
          activeCat = 'all';
          cats.querySelectorAll('[data-cat]').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.cat === 'all');
          });
          apply();
        });

      apply();
    })();
  </script>
</PageLayout>

<script>
  // Copy button for the hand-rolled rock-950 code block inside the dark slab
  // (brief §3: code never sits on a coloured band).
  function wireCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('button.qf-copy').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', async () => {
        const pre = btn.closest('div')?.parentElement?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
        } catch { /* clipboard unavailable */ }
      });
    });
  }
  wireCopyButtons();
  document.addEventListener('astro:after-swap', wireCopyButtons);
</script>
