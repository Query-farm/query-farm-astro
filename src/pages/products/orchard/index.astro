---
import PageLayout from '../../../layouts/PageLayout.astro';
import Hero from '../../../components/sections/Hero.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import ConnectorCard from '../../../components/products/ConnectorCard.astro';
import { connectors, featuredConnectors } from '../../../data/connectors';

const connectorCount = connectors.length;

// Marketplace catalog: category facets (with counts) + a browse order that puts
// featured connectors first, then the most-attached.
const categoryCounts = connectors.reduce<Record<string, number>>((m, c) => {
  m[c.category] = (m[c.category] ?? 0) + 1;
  return m;
}, {});
const categories = [
  { key: 'all', label: 'All connectors', count: connectors.length },
  ...Object.keys(categoryCounts)
    .sort()
    .map((cat) => ({ key: cat.toLowerCase(), label: cat, count: categoryCounts[cat] })),
];
const catalog = [...connectors].sort(
  (a, b) => Number(b.popular ?? false) - Number(a.popular ?? false) || (b.uses ?? 0) - (a.uses ?? 0),
);

const steps = [
  {
    title: 'Browse the catalog',
    description: 'Find a connector or worker that exposes the system you need — streaming, email, governance, federation, or public data.',
  },
  {
    title: 'Subscribe',
    description: 'Pick a plan and get a token. Free connectors attach with no token at all; paid ones bill per worker.',
  },
  {
    title: 'Attach from SQL',
    description: 'ATTACH the worker in DuckDB or Haybarn and query its tables and functions like any other catalog.',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const orchardDescription =
  'The Orchard is the Query.Farm marketplace for VGI workers and connectors — subscribe to a connector and attach it from DuckDB or Haybarn with ordinary SQL.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Orchard — VGI connector marketplace',
    description: orchardDescription,
    url: `${SITE_ORIGIN}/products/orchard`,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: connectorCount,
      itemListElement: connectors.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        url: `${SITE_ORIGIN}/products/orchard/connectors/${c.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
    ],
  },
];
---

<PageLayout
  title="Orchard — VGI Connector Marketplace"
  description={orchardDescription}
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
    ]}
  />

  <!-- Hero (compact marketplace banner) -->
  <section class="relative overflow-hidden bg-gradient-to-br from-emerald-100 via-harvest-50 to-white py-8 lg:py-12 font-display">
    <div class="absolute inset-0 opacity-30">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="orchard-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-emerald-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#orchard-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10 flex flex-col items-center gap-4 text-center sm:flex-row sm:items-end sm:justify-between sm:text-left">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">🌳 Orchard</p>
        <h1 class="mt-1 text-3xl md:text-4xl font-extrabold text-soil-900 leading-tight">
          The marketplace for
          <span class="inline-block rounded-xl border-2 border-soil-900 bg-grain-300 px-2.5 pb-0.5 text-soil-900 shadow-sm">connectors.</span>
        </h1>
        <p class="mt-2 max-w-2xl text-base text-soil-700 leading-relaxed">
          Subscribe and attach any of them from DuckDB or Haybarn with one line of SQL.
        </p>
      </div>
      <Button href="/products/orchard/submit" variant="secondary" size="md" class="shrink-0">Publish a connector</Button>
    </div>
  </section>

  <!-- Featured row -->
  {featuredConnectors.length > 0 && (
    <section class="py-12 lg:py-16 bg-white font-display">
      <div class="section-container">
        <SectionHeader align="center" eyebrow="Featured" title="Connectors worth a look" class="mb-8" />

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredConnectors.map((c) => (
            <ConnectorCard connector={c} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Marketplace catalog -->
  <section id="catalog" class="py-14 lg:py-20 bg-soil-50 scroll-mt-20 font-display">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Marketplace"
        title="Browse the Orchard"
        description="Every connector attaches as a SQL catalog in DuckDB or Haybarn. Filter by category or search to find one."
        class="mb-8"
      />

      <!-- Search -->
      <div class="mx-auto mb-8 max-w-xl">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-soil-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
          </svg>
          <input
            id="orchard-search"
            type="search"
            placeholder="Search connectors…"
            autocomplete="off"
            aria-label="Search connectors"
            class="w-full rounded-xl border-2 border-soil-900 bg-white py-3 pl-12 pr-4 text-soil-900 shadow-sm placeholder:text-soil-400 focus:outline-none focus:ring-2 focus:ring-harvest-400"
          />
        </div>
      </div>

      <div class="lg:grid lg:grid-cols-[13rem_1fr] lg:gap-10">
        <!-- Category rail (full-width chips on mobile, sticky rail on desktop) -->
        <aside class="mb-8 lg:mb-0">
          <p class="mb-3 hidden text-xs font-bold uppercase tracking-wider text-soil-500 lg:block">Categories</p>
          <div id="orchard-cats" class="flex flex-wrap gap-2 lg:sticky lg:top-24 lg:flex-col lg:gap-1">
            {categories.map((cat, i) => (
              <button type="button" data-cat={cat.key} class:list={['orchard-cat', { 'is-active': i === 0 }]}>
                <span>{cat.label}</span>
                <span class="orchard-cat__count">{cat.count}</span>
              </button>
            ))}
          </div>
        </aside>

        <!-- Grid -->
        <div>
          <div id="orchard-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {catalog.map((c) => (
              <div
                class="orchard-item"
                data-category={c.category.toLowerCase()}
                data-search={`${c.name} ${c.tagline} ${c.category} ${c.provider}`.toLowerCase()}
              >
                <ConnectorCard connector={c} />
              </div>
            ))}
          </div>

          <div id="orchard-empty" class="hidden py-16 text-center text-soil-600">
            No connectors match your search.
            <button type="button" id="orchard-reset" class="font-bold text-harvest-700 underline underline-offset-2 hover:text-harvest-800">Clear filters</button>
          </div>

          <p id="orchard-count" class="mt-8 text-center text-sm text-soil-600"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- What is the Orchard -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="What is the Orchard?"
          title="Connectors you can plant in any query"
        />
        <p class="mt-6 text-lg text-soil-700 leading-relaxed">
          Every Orchard connector is a <a href="/vgi" class="text-harvest-700 font-medium underline underline-offset-2 hover:text-harvest-800">VGI worker</a> — a service that exposes a system as SQL tables and functions. The Orchard adds the marketplace around them: discovery, subscriptions, credentials, and one consistent way to attach. Bring the connectors you need; leave the plumbing to the worker.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {steps.map((step, i) => (
          <Card padding="lg" class="border-2 border-soil-900 shadow-sm">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-grain-300 text-soil-900 font-extrabold">
              {i + 1}
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{step.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{step.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- For subscribers / publishers -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="rounded-2xl border-2 border-soil-900 bg-grain-50 p-8 shadow-sm">
          <p class="text-sm font-bold uppercase tracking-wider text-harvest-700">For teams</p>
          <h3 class="mt-2 text-2xl font-bold text-soil-900">Subscribe to a connector</h3>
          <p class="mt-3 text-soil-700 leading-relaxed">
            Pick a plan, get a token, and attach. Free connectors need no token; paid connectors bill per worker with no infrastructure to run yourself.
          </p>
          <Button href="/products/orchard/subscribe" variant="primary" size="md" class="mt-6">
            How subscriptions work →
          </Button>
        </div>
        <div class="rounded-2xl border-2 border-soil-900 bg-emerald-50 p-8 shadow-sm">
          <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">For builders</p>
          <h3 class="mt-2 text-2xl font-bold text-soil-900">Publish your own</h3>
          <p class="mt-3 text-soil-700 leading-relaxed">
            Built a VGI worker? List it on the Orchard, set your pricing, and let teams discover and subscribe to it with the same one-line attach.
          </p>
          <Button href="/products/orchard/submit" variant="primary" size="md" class="mt-6">
            Get listed →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-emerald-600 to-harvest-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">Need a connector that isn’t here yet?</h2>
      <p class="text-xl md:text-2xl text-emerald-50 mb-8 max-w-3xl mx-auto">
        We build VGI connectors for the systems your team depends on — and we can publish them on the Orchard for you.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">Commission a connector</Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>

  <style>
    .orchard-cat {
      display: inline-flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      border-radius: 0.6rem;
      border: 1px solid var(--color-soil-300);
      background: #fff;
      padding: 0.45rem 0.8rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-soil-700);
      cursor: pointer;
      transition: background 0.12s, color 0.12s, border-color 0.12s;
    }
    .orchard-cat:hover {
      background: var(--color-grain-100);
    }
    .orchard-cat.is-active {
      background: var(--color-soil-900);
      border-color: var(--color-soil-900);
      color: #fff;
    }
    .orchard-cat__count {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-soil-500);
    }
    .orchard-cat.is-active .orchard-cat__count {
      color: rgba(255, 255, 255, 0.75);
    }
    /* Chips (not full-width rail) below the lg breakpoint. */
    @media (max-width: 1023px) {
      .orchard-cat {
        width: auto;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const search = document.getElementById('orchard-search');
      const cats = document.getElementById('orchard-cats');
      const grid = document.getElementById('orchard-grid');
      const empty = document.getElementById('orchard-empty');
      const count = document.getElementById('orchard-count');
      const reset = document.getElementById('orchard-reset');
      if (!grid || !cats || !search) return;
      const items = Array.prototype.slice.call(grid.querySelectorAll('.orchard-item'));
      let activeCat = 'all';

      function apply() {
        const q = (search.value || '').trim().toLowerCase();
        let shown = 0;
        items.forEach(function (it) {
          const catOk = activeCat === 'all' || it.dataset.category === activeCat;
          const qOk = !q || it.dataset.search.indexOf(q) !== -1;
          const vis = catOk && qOk;
          it.style.display = vis ? '' : 'none';
          if (vis) shown++;
        });
        empty.classList.toggle('hidden', shown > 0);
        count.textContent =
          shown === items.length
            ? 'Showing all ' + items.length + ' connectors'
            : 'Showing ' + shown + ' of ' + items.length + ' connectors';
      }

      cats.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-cat]');
        if (!btn) return;
        activeCat = btn.dataset.cat;
        cats.querySelectorAll('[data-cat]').forEach(function (b) {
          b.classList.toggle('is-active', b === btn);
        });
        apply();
      });

      search.addEventListener('input', apply);

      if (reset)
        reset.addEventListener('click', function () {
          search.value = '';
          activeCat = 'all';
          cats.querySelectorAll('[data-cat]').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.cat === 'all');
          });
          apply();
        });

      apply();
    })();
  </script>
</PageLayout>
