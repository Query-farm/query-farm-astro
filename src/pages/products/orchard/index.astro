---
import { linkHaybarn } from '../../../lib/haybarn-link';
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import WorkerCard from '../../../components/orchard/WorkerCard.astro';
import { workers as openWorkers, categories as workerCategories, workersInCategory, VGI_SETUP } from '../../../data/vgi-workers';

const openPicks = ['color', 'conform', 'yfinance', 'llm', 'sigma', 'tika'].map(s => openWorkers.find(w => w.slug === s)).filter(Boolean).slice(0, 6) as typeof openWorkers;


const connectorCount = openWorkers.length;
const attachExample = openWorkers.find(w => w.slug === 'yfinance') ?? openWorkers[0];
const attachSqlExample = `${VGI_SETUP.duckdb}\n\n${attachExample.attachSql}`;

const steps = [
  {
    title: 'Find a connector',
    description: 'Search by service, file format, domain, or any table, function or column name — every catalog is visible before you install anything.',
  },
  {
    title: 'Attach it',
    description: 'One ATTACH in DuckDB or Haybarn. The vgi extension downloads the verified release for your platform and runs it locally.',
  },
  {
    title: 'Query it',
    description: 'Its tables and functions behave like any other catalog — join them with your own data in ordinary SQL.',
  },
];

const SITE_ORIGIN = 'https://query.farm';
const orchardDescription =
  'The Orchard is the Query.Farm marketplace for DuckDB connectors — VGI workers that bring services, file formats, models and libraries into DuckDB and Haybarn as SQL catalogs.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Orchard — VGI connector marketplace',
    description: orchardDescription,
    url: `${SITE_ORIGIN}/products/orchard`,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: connectorCount,
      itemListElement: openWorkers.map((w, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: w.name,
        url: `${SITE_ORIGIN}/products/orchard/connectors/${w.slug}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
    ],
  },
];

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
---

<PageLayout
  title="Orchard — VGI Connector Marketplace"
  description={orchardDescription}
  ogImage="/og/orchard.jpg"
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
    ]}
  />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Connector marketplace"
    title="The marketplace for connectors."
    hairband
  >
    <Fragment slot="lede" set:html={linkHaybarn('Every connector is a VGI worker that exposes a service, a file format, a model or a library as SQL tables and functions. Find one, then attach it from DuckDB or Haybarn with one line of SQL.')} />
    <span
      slot="icon"
      class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-3xl leading-none"
      aria-hidden="true"
    >🌳</span>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/products/orchard/connectors" variant="primary" size="md">Browse connectors</Button>
      <Button href="/products/orchard/submit" variant="secondary" size="md">Publish a connector</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">{connectorCount}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Connectors listed</div>
    </Fragment>
  </PageHead>

  <!-- ── Connectors ───────────────────────────────────────────── -->
  {openWorkers.length > 0 && (
    <section class="py-14">
      <div class={WRAP}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <span class={EYEBROW}>Connectors</span>
            <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">{openWorkers.length} connectors, free to run</h2>
            <p class={`mt-3 max-w-[62ch] ${LEDE}`}>
              Services, file formats, models, security artefacts and public data — each verified before it is listed.
              Attach one with a single line of SQL. More are added all the time.
            </p>
          </div>
          <Button href="/products/orchard/connectors" variant="primary" size="md">Browse all connectors</Button>
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          {workerCategories.filter(c => workersInCategory(c.id).length).map(c => (
            <a href={`/products/orchard/connectors/category/${c.id}`} class="rounded-full border border-soil-300 bg-[#fffdf7] px-3 py-1 text-[13px] text-soil-700 no-underline hover:border-sun-400 hover:text-soil-900">
              {c.name} <span class="qf-figure text-soil-500">{workersInCategory(c.id).length}</span>
            </a>
          ))}
        </div>
        {openPicks.length > 0 && (
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {openPicks.map(w => <WorkerCard worker={w} />)}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── The one dark slab: attach from SQL ──────────────────── -->
  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">How it works</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Find it, attach it, query it</h2>
      <p class="mt-3 max-w-[58ch] text-[17.5px] leading-relaxed text-cream-2">
        The Orchard adds the marketplace around VGI workers: discovery, verified releases,
        documented credentials, and one consistent way to attach. Bring the connectors you need;
        leave the plumbing to the worker.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class="rounded-xl border border-white/15 px-5 py-5">
            <div class="qf-figure text-2xl leading-none text-sun-400">{i + 1}</div>
            <h3 class="mt-3 text-lg text-cream">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-2" set:html={linkHaybarn(step.description, 'dark')} />
          </div>
        ))}
      </div>

      <div class="mt-6">
        <CodeBlock code={attachSqlExample} lang="sql" title="attach.sql" tryable={false} />
      </div>

      <p class="mt-4 text-sm text-cream-2">
        That's {attachExample.name}; every connector page has its own, ready to paste.
      </p>
    </div>
  </section>

  <!-- ── For subscribers / publishers ────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For teams</span>
          <h2 class="mt-3 text-2xl text-soil-900">Subscribe to a connector</h2>
          <p class="mt-3 leading-relaxed text-soil-700">
            Pick a plan, get a token, and attach. Free connectors need no token; paid connectors
            bill per worker with no infrastructure to run yourself.
          </p>
          <Button href="/products/orchard/connectors" variant="primary" size="md" class="mt-6">
            Browse connectors →
          </Button>
        </div>
        <div class={`${CARD} p-8`}>
          <span class={EYEBROW}>For builders</span>
          <h2 class="mt-3 text-2xl text-soil-900">Publish your own</h2>
          <p class="mt-3 leading-relaxed text-soil-700">
            Built a VGI worker? List it on the Orchard, set your pricing, and let teams discover
            and subscribe to it with the same one-line attach.
          </p>
          <Button href="/products/orchard/submit" variant="primary" size="md" class="mt-6">
            Get listed →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="pb-16">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">Need a connector that isn't here yet?</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            We build VGI connectors for the systems your team depends on — and we can publish
            them on the Orchard for you.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Commission a connector</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

