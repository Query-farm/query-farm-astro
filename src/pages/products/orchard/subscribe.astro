---
import PageLayout from '../../../layouts/PageLayout.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import { connectors } from '../../../data/connectors';

const steps = [
  {
    title: 'Pick a connector',
    description: 'Browse the Orchard and choose the connector that exposes the system you need.',
  },
  {
    title: 'Choose a plan',
    description: 'Free connectors need no subscription. Paid connectors bill per worker — monthly or annually.',
  },
  {
    title: 'Get your token',
    description: 'Subscribing issues an Orchard token. Store it as an environment variable or a DuckDB secret.',
  },
  {
    title: 'Attach and query',
    description: 'ATTACH the worker with your token and query its tables and functions like any other catalog.',
  },
];

const tiers = [
  {
    name: 'Free',
    price: 'Contact us for details',
    /** Prices are figures — Commissioner tabular, never Fraunces (brief §2). Not a figure: pricing is undisclosed. */
    priceIsFigure: false,
    blurb: 'Public-data and demo connectors.',
    features: ['No token required', 'Community support', 'Great for learning & prototypes'],
    badge: 'border-field-600/45 bg-field-600/10 text-field-700',
    cta: 'Browse free connectors',
    href: '/products/orchard',
  },
  {
    name: 'Subscription',
    price: 'Contact us for details',
    priceIsFigure: false,
    blurb: 'Production connectors, billed per worker.',
    features: ['Hosted, managed worker', 'Token-based auth', 'Email support & SLAs', 'Cancel anytime'],
    badge: 'border-sun-400 bg-sun-400/12 text-sun-700',
    cta: 'Browse connectors',
    href: '/products/orchard#catalog',
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Contact us for details',
    priceIsFigure: false,
    blurb: 'Governance, federation, and custom needs.',
    features: ['Private deployment options', 'SSO & audit logging', 'Custom connectors', 'Dedicated support'],
    badge: 'border-soil-300 text-soil-700',
    cta: 'Talk to sales',
    href: '/company/schedule',
  },
];

const plansPitch = [
  'Contact us for current pricing on any connector — no bundle you have to grow into.',
  'Billing, credentials, and worker hosting are handled for you.',
  'Free connectors attach with no token and no subscription at all.',
  'Cancel a subscription and the ATTACH simply stops resolving.',
];

const attach = `-- 1. Install the VGI extension (once)
INSTALL vgi FROM community;
LOAD vgi;

-- 2. Store your Orchard token as a secret
CREATE SECRET orchard (TYPE vgi, TOKEN 'orch_live_…');

-- 3. Attach a subscribed connector and query it
ATTACH 'kafka' AS kafka (
  TYPE vgi,
  LOCATION 'https://orchard.query.farm/kafka'
);

SELECT * FROM kafka.topics;`;

const description =
  'How to subscribe to Orchard connectors — pick a connector, choose a plan, get a token, and attach it from DuckDB or Haybarn.';

const SITE_ORIGIN = 'https://query.farm';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Subscribe to Orchard Connectors',
    description,
    url: `${SITE_ORIGIN}/products/orchard/subscribe`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
      { '@type': 'ListItem', position: 4, name: 'Subscribe', item: SITE_ORIGIN + '/products/orchard/subscribe' },
    ],
  },
];

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
---

<PageLayout
  title="Subscribe to Orchard Connectors"
  description={description}
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Subscribe', href: '/products/orchard/subscribe' },
    ]}
  />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="For teams"
    title="Subscribe and attach in minutes."
    lede="No connector infrastructure to run. Subscribe to a hosted worker, get a token, and query it from DuckDB or Haybarn with one ATTACH."
    hairband
  >
    <span
      slot="icon"
      class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-2xl"
      aria-hidden="true"
    >🌳</span>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/products/orchard#catalog" variant="primary" size="md">Browse connectors</Button>
      <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">{connectors.length}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Connectors listed</div>
    </Fragment>
  </PageHead>

  <!-- ── How it works ────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>How it works</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Four steps to query</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <div class="qf-figure text-[13.5px] text-sun-700">
              Step {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="mt-2 text-lg text-soil-900">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The attach flow ─────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <span class={EYEBROW}>The attach flow</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">From token to rows</h2>
          <p class={`mt-3.5 max-w-[52ch] ${LEDE}`}>
            One extension, one secret, one ATTACH. After that the connector's tables behave like
            any other catalog in the session.
          </p>
          <div class="mt-6 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
            <div class="text-[12.5px] font-medium text-sun-700">No token needed</div>
            <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
              Free connectors like
              <a
                href="/products/orchard/connectors/citibike"
                class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link"
              >Citi Bike</a>
              skip the secret entirely — just ATTACH and query.
            </p>
          </div>
        </div>
        <div class="min-w-0">
          <CodeBlock code={attach} lang="sql" title="subscribe.sql" tryable={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one panel: plans & pricing ──────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-8 text-cream">
          <span class="qf-eyebrow text-sun-400">Plans</span>
          <h2 class="mt-3 text-2xl md:text-3xl text-cream">Pricing that matches the connector</h2>
          <p class="mt-3 text-[15.5px] leading-relaxed text-cream-2">
            Contact us for pricing on any connector. These are the plan types you’ll see across the
            Orchard — <span class="qf-figure text-sun-400">{connectors.length}</span> listings and growing.
          </p>
          <ul class="mt-6 flex flex-col gap-3 text-[14.5px] leading-relaxed">
            {plansPitch.map((p) => (
              <li class="flex items-start gap-2.5">
                <span class="flex-none text-sun-400" aria-hidden="true">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-7">
            <Button href="/products/orchard" variant="secondary" size="md" onDark>Browse the Orchard</Button>
          </div>
        </div>

        <div class="px-8 py-8">
          <div class="flex flex-col gap-3.5">
            {tiers.map((tier) => (
              <div
                class:list={[
                  'rounded-xl border bg-[#fffdf7] p-5',
                  tier.featured ? 'border-sun-400' : 'border-soil-300',
                ]}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <span
                    class={`inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium ${tier.badge}`}
                  >{tier.name}</span>
                  {tier.featured && (
                    <span class="text-[12.5px] font-medium text-soil-500">Most common</span>
                  )}
                </div>
                <p
                  class:list={[
                    'mt-3 text-2xl leading-none text-soil-900',
                    tier.priceIsFigure && 'qf-figure',
                  ]}
                >{tier.price}</p>
                <p class="mt-2 text-sm text-soil-700">{tier.blurb}</p>
                <ul class="mt-3.5 flex flex-col gap-1.5 border-t border-soil-200 pt-3.5">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-2 text-[13.5px] leading-relaxed text-soil-700">
                      <span class="mt-[1px] flex-none text-xs text-field-700" aria-hidden="true">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={tier.href}
                  class="mt-4 inline-block text-[13px] font-medium text-link no-underline hover:underline"
                >{tier.cta} →</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
