---
import PageLayout from '../../../layouts/PageLayout.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import { connectors } from '../../../data/connectors';

const steps = [
  {
    title: 'Pick a connector',
    description: 'Browse the Orchard and choose the connector that exposes the system you need.',
  },
  {
    title: 'Choose a plan',
    description: 'Free connectors need no subscription. Paid connectors bill per worker — monthly or annually.',
  },
  {
    title: 'Get your token',
    description: 'Subscribing issues an Orchard token. Store it as an environment variable or a DuckDB secret.',
  },
  {
    title: 'Attach and query',
    description: 'ATTACH the worker with your token and query its tables and functions like any other catalog.',
  },
];

const tiers = [
  {
    name: 'Free',
    price: '$0',
    blurb: 'Public-data and demo connectors.',
    features: ['No token required', 'Community support', 'Great for learning & prototypes'],
    accent: 'border-emerald-300 bg-emerald-50',
    badge: 'bg-emerald-100 text-emerald-800',
    cta: 'Browse free connectors',
    href: '/products/orchard',
  },
  {
    name: 'Subscription',
    price: 'From $29/mo',
    blurb: 'Production connectors, billed per worker.',
    features: ['Hosted, managed worker', 'Token-based auth', 'Email support & SLAs', 'Cancel anytime'],
    accent: 'border-soil-900 bg-grain-50',
    badge: 'bg-harvest-100 text-harvest-800',
    cta: 'Browse connectors',
    href: '/products/orchard#catalog',
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Contact us',
    blurb: 'Governance, federation, and custom needs.',
    features: ['Private deployment options', 'SSO & audit logging', 'Custom connectors', 'Dedicated support'],
    accent: 'border-soil-300 bg-white',
    badge: 'bg-soil-200 text-soil-800',
    cta: 'Talk to sales',
    href: '/company/schedule',
  },
];

const attach = `-- 1. Install the VGI extension (once)
INSTALL vgi FROM community;
LOAD vgi;

-- 2. Store your Orchard token as a secret
CREATE SECRET orchard (TYPE vgi, TOKEN 'orch_live_…');

-- 3. Attach a subscribed connector and query it
ATTACH 'kafka' AS kafka (
  TYPE vgi,
  LOCATION 'https://orchard.query.farm/kafka'
);

SELECT * FROM kafka.topics;`;

const description =
  'How to subscribe to Orchard connectors — pick a connector, choose a plan, get a token, and attach it from DuckDB or Haybarn.';
---

<PageLayout
  title="Subscribe to Orchard Connectors"
  description={description}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Subscribe', href: '/products/orchard/subscribe' },
    ]}
  />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-16 lg:py-20 border-b border-soil-200">
    <div class="section-container text-center">
      <p class="text-sm font-bold uppercase tracking-wider text-harvest-700">For teams</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-extrabold text-soil-900 leading-tight">
        Subscribe and attach in minutes
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg md:text-xl text-soil-700 leading-relaxed">
        No connector infrastructure to run. Subscribe to a hosted worker, get a token, and query it from DuckDB or Haybarn with one ATTACH.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/orchard#catalog" variant="accent" size="lg">Browse connectors</Button>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader align="center" eyebrow="How it works" title="Four steps to query" class="mb-12" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {steps.map((step, i) => (
          <Card padding="lg" class="border-2 border-soil-900 shadow-sm">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-grain-300 text-soil-900 font-extrabold">
              {i + 1}
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{step.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{step.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Plans"
        title="Pricing that matches the connector"
        description="Every connector lists its own price. These are the plan types you’ll see across the Orchard."
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto items-stretch">
        {tiers.map((tier) => (
          <div class={`relative flex flex-col rounded-2xl border-2 p-7 shadow-sm ${tier.accent}`}>
            {tier.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full border-2 border-soil-900 bg-grain-300 px-3 py-0.5 text-xs font-bold text-soil-900">
                Most common
              </span>
            )}
            <span class={`self-start rounded-full px-2.5 py-1 text-xs font-bold ${tier.badge}`}>{tier.name}</span>
            <p class="mt-4 text-3xl font-extrabold text-soil-900">{tier.price}</p>
            <p class="mt-1 text-sm text-soil-600">{tier.blurb}</p>
            <ul class="mt-5 space-y-2 flex-1">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-soil-700">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <Button href={tier.href} variant="primary" size="md" class="mt-6 w-full justify-center">{tier.cta}</Button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Attach example -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader align="center" eyebrow="The attach flow" title="From token to rows" class="mb-8" />
        <CodeBlock code={attach} lang="sql" title="subscribe.sql" tryable={false} />
        <p class="mt-4 text-center text-sm text-soil-600">
          Free connectors like
          <a href="/products/orchard/connectors/citibike" class="font-medium text-harvest-700 hover:text-harvest-800">Citi Bike</a>
          skip the secret entirely — just ATTACH and query.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{connectors.length} connectors and growing</h2>
      <p class="text-lg md:text-xl text-harvest-50 mb-8 max-w-2xl mx-auto">
        Find the one you need, or ask us to build it.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/orchard" variant="secondary" size="lg">Browse the Orchard</Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
