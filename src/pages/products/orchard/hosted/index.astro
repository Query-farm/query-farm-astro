---
// Hosted Orchard: Query.Farm runs Orchard workers on Fly.io for a team.
// Prices come from src/lib/orchard/pricing.ts (Fly list price × FLY_MARKUP).
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import CodeBlock from '../../../../components/ui/CodeBlock.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import {
  FLY_MARKUP, FLY_PRICES_AS_OF, LICENSE_MONTHLY_USD, MAX_INSTANCES, REGIONS, SIZES, hourlyUsd, monthlyUsd, usd,
} from '../../../../lib/orchard/pricing';

const markupPct = Math.round((FLY_MARKUP - 1) * 100);
const asOf = new Date(`${FLY_PRICES_AS_OF}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const steps = [
  { title: 'Sign in and pick a worker', description: 'Create an Orchard account (it comes with your own workspace), then choose any connector, a size, how many instances and a region.' },
  { title: 'Set up billing once', description: 'Add a card through Stripe Checkout. Usage is billed monthly; invoices and cards live in the Stripe portal.' },
  { title: 'We run it on Fly.io', description: 'We deploy the verified release and email you when it is live, usually within one business day.' },
  { title: 'Attach it, sign in from DuckDB', description: 'Paste the ATTACH from the console. No keys in your SQL: the first query asks you to sign in with your Orchard account from DuckDB.' },
];

const exampleAttach = [
  "ATTACH 'yfinance' AS yfinance (",
  '  TYPE vgi,',
  "  LOCATION 'https://<your-deployment>.fly.dev'",
  ');',
].join('\n');

const faq = [
  {
    q: 'What exactly am I paying for?',
    a: `Fly.io's list price for the machines your deployment runs on, plus ${markupPct}% for running, updating and watching them. Instances are metered by the minute while they run, and nothing is billed while a deployment is stopped. Workers marked paid on the Orchard add a ${usd(LICENSE_MONTHLY_USD, 0)} monthly license per deployment.`,
  },
  {
    q: 'How do I scale up or down?',
    a: `Use the + and − buttons in the console (1 to ${MAX_INSTANCES} instances per deployment). Each change is a request we make on Fly.io by hand for now, usually within one business day; billing follows the count actually running.`,
  },
  {
    q: 'Who can query my deployment?',
    a: 'Only the people in your Orchard workspace. DuckDB opens a browser to sign in with your Orchard account on the first query, and the deployment refuses anyone who is not a member.',
  },
  {
    q: 'Do you see my data?',
    a: 'A connector processes the queries and arguments you send it, and whatever it fetches from the service it connects to, in order to answer them, on machines Fly.io operates for us. Credentials for outside services stay in your own DuckDB secrets and travel with each query.',
  },
  {
    q: 'Can I still run it myself?',
    a: 'Yes. Every open connector stays free to run on your own machine with one ATTACH, exactly as its page shows. Hosting is for teams that would rather not run it.',
  },
  {
    q: 'Which regions?',
    a: `${REGIONS.map(r => r.label).join(', ')}. Prices on this page use Fly's US-East rates (as of ${asOf}); other regions can cost more, and we confirm any difference before provisioning.`,
  },
];

const SITE_ORIGIN = 'https://query.farm';
const description = `Query.Farm runs Orchard connectors for your team on Fly.io. Pricing is Fly.io infrastructure cost + ${markupPct}%, plus a license fee for paid workers.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Hosted Orchard',
    description,
    provider: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    url: `${SITE_ORIGIN}/products/orchard/hosted`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
---

<PageLayout title="Hosted Orchard — Connectors We Run for You" description={description} jsonLd={jsonLd}>
  <OrchardSubNav breadcrumbs={[{ name: 'Products', href: '/products' }, { name: 'Orchard', href: '/products/orchard' }, { name: 'Hosted', href: '/products/orchard/hosted' }]} />

  <PageHead variant="section" eyebrow="Hosted Orchard" title="Connectors we run for you." hairband>
    <Fragment slot="lede">Pick any Orchard connector and Query.Farm runs it on Fly.io for your team. You choose the size and how many instances, scale from the console, and attach it from DuckDB or Haybarn with no keys in your SQL.</Fragment>
    <span slot="icon" class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-3xl leading-none" aria-hidden="true">☁️</span>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/products/orchard/console/new" variant="primary">Start a deployment</Button>
      <Button href="#pricing" variant="secondary">See pricing</Button>
    </div>
    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">+{markupPct}%</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">on Fly.io's list price</div>
    </Fragment>
  </PageHead>

  <section class="py-14">
    <div class={WRAP}>
      <span class={EYEBROW}>How it works</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">From a connector page to a hosted catalog</h2>
      <div class="mt-8 grid gap-3.5 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <div class={`${CARD} px-5 py-5`}>
            <div class="qf-figure text-2xl leading-none text-sun-700">{i + 1}</div>
            <h3 class="mt-3 text-lg text-soil-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{step.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 max-w-[720px]">
        <CodeBlock code={exampleAttach} lang="sql" title="attach.sql" tryable={false} />
        <p class="mt-3 text-sm text-soil-600">What the console gives you once a deployment is live. Sign-in happens in the browser; no token or secret goes into the query.</p>
      </div>
    </div>
  </section>

  <section id="pricing" class="scroll-mt-28 py-14">
    <div class={WRAP}>
      <span class={EYEBROW}>Pricing</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Fly.io infrastructure cost + {markupPct}%, plus a license fee for paid workers</h2>
      <p class={`mt-3 max-w-[68ch] ${LEDE}`}>
        No platform fee and no minimum. Instances are metered by the minute while they run. Open connectors carry no license;
        paid workers add {usd(LICENSE_MONTHLY_USD, 0)} per deployment per month.
      </p>
      <div class={`${CARD} mt-8 overflow-x-auto`}>
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-b border-soil-300 text-[12.5px] text-soil-600">
            <tr>
              <th class="px-5 py-3 font-semibold">Size</th>
              <th class="px-5 py-3 font-semibold">Machine</th>
              <th class="px-5 py-3 text-right font-semibold">Fly.io list price</th>
              <th class="px-5 py-3 text-right font-semibold">Per instance-hour</th>
              <th class="px-5 py-3 text-right font-semibold">Per instance-month</th>
            </tr>
          </thead>
          <tbody>
            {SIZES.map(s => (
              <tr class="border-b border-soil-200 last:border-0">
                <td class="px-5 py-4"><div class="font-semibold text-soil-900">{s.label}</div><div class="text-[13px] text-soil-600">{s.blurb}</div></td>
                <td class="px-5 py-4 text-soil-700">{s.cpus}, {s.memoryGb} GB <span class="font-mono text-[12px] text-soil-500">{s.flyPreset}</span></td>
                <td class="qf-figure px-5 py-4 text-right text-soil-700">{usd(s.flyMonthlyUsd)}/mo</td>
                <td class="qf-figure px-5 py-4 text-right text-soil-900">{usd(hourlyUsd(s), 4)}</td>
                <td class="qf-figure px-5 py-4 text-right font-semibold text-soil-900">{usd(monthlyUsd(s))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-[13px] text-soil-600">
        Fly.io prices for a machine running all month in its lowest-priced US regions, as published on {asOf}. If Fly.io changes its prices, ours follow.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class={WRAP}>
      <span class={EYEBROW}>Questions</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">FAQ</h2>
      <div class="mt-6 grid max-w-[860px] gap-3">
        {faq.map(f => (
          <details class={`${CARD} group px-5 py-4`}>
            <summary class="cursor-pointer text-[17px] font-semibold text-soil-900">{f.q}</summary>
            <p class="mt-3 leading-relaxed text-soil-700">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-6 text-sm text-soil-600">
        Using the hosted service means agreeing to the <a href="/legal/terms#hosted" class="text-link underline decoration-link/40 underline-offset-2">hosted service terms</a>.
        See the <a href="/legal/privacy" class="text-link underline decoration-link/40 underline-offset-2">privacy policy</a> for the account and billing data involved.
      </p>
    </div>
  </section>

  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">Get started</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Run a connector without running a server</h2>
      <p class="mt-3 max-w-[58ch] text-[17.5px] leading-relaxed text-cream-2">Create an account, choose a worker and we'll do the rest. Nothing is billed until a deployment is running.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/products/orchard/console/new" variant="accent" onDark>Start a deployment</Button>
        <Button href="/products/orchard/connectors" variant="secondary" onDark>Browse connectors</Button>
        <Button href="/company/schedule" variant="ghost" onDark>Talk to us</Button>
      </div>
    </div>
  </section>
</PageLayout>
