---
// Hosted Orchard console: the signed-in org's deployments. Static and noindex;
// src/scripts/orchard-console.ts fills it from /api/orchard/*.
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import Card from '../../../../components/ui/Card.astro';
import Badge from '../../../../components/ui/Badge.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import { LICENSE_MONTHLY_USD, SIZES, monthlyUsd } from '../../../../lib/orchard/pricing';

const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const LABEL = 'text-[12px] font-semibold text-soil-500';
const TH = 'px-3 py-2 text-left text-[12px] font-semibold text-soil-500 whitespace-nowrap';
const TD = 'px-3 py-2.5 align-top whitespace-nowrap';
// Per-instance monthly prices for the inventory's estimate column.
const PRICES = JSON.stringify({ ...Object.fromEntries(SIZES.map(sz => [sz.id, monthlyUsd(sz)])), license: LICENSE_MONTHLY_USD });
---

<PageLayout title="Console — Hosted Orchard" description="Your hosted Orchard deployments." noindex>
  <OrchardSubNav breadcrumbs={[{ name: 'Orchard', href: '/products/orchard' }, { name: 'Console', href: '/products/orchard/console' }]} />

  <PageHead variant="section" eyebrow="Hosted Orchard" title="Console">
    <Fragment slot="lede">Workers Query.Farm runs for you on Fly.io. Ask for more or fewer instances and we make the change, usually within one business day.</Fragment>
  </PageHead>

  <section class="pt-10 pb-16">
    <div class={WRAP}>
      <p data-state="loading" class="text-soil-600">Loading…</p>

      <div data-state="signed-out" hidden>
        <Card padding="lg" class="max-w-[640px]">
          <h2 class="text-2xl text-soil-900">Sign in to the console</h2>
          <p class="mt-3 leading-relaxed text-soil-700">
            Use your Orchard account to see and scale your hosted workers. New here? Creating an account
            sets up your own workspace; nothing is billed until you request a deployment.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <span data-signin="signin" class="contents"><Button href="/api/auth/login" variant="primary">Sign in</Button></span>
            <span data-signin="signup" class="contents"><Button href="/api/auth/login?signup=1" variant="secondary">Create an account</Button></span>
          </div>
        </Card>
      </div>

      <div data-state="error" hidden>
        <Card padding="lg" class="max-w-[640px]">
          <p data-message class="text-soil-800"></p>
          <p class="mt-3 text-sm text-soil-600">If this keeps happening, email <a class="text-link underline" href="mailto:hello@query.farm">hello@query.farm</a>.</p>
        </Card>
      </div>

      <div data-state="ready" hidden>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="text-soil-700"><span data-org-name class="font-semibold text-soil-900"></span> · <span data-user-email></span></p>
          <div class="flex flex-wrap gap-3">
            <Button href="/products/orchard/console/new" variant="primary" size="sm">New deployment</Button>
            <span data-admin-link hidden><Button href="/products/orchard/console/admin" variant="ghost" size="sm">Request tracker</Button></span>
            <Button href="/api/auth/logout" variant="ghost" size="sm">Sign out</Button>
          </div>
        </div>

        <p data-billing-done hidden class="mt-4 rounded-lg border border-field-600/45 bg-field-600/10 px-4 py-3 text-sm text-field-700">
          Billing is set up. Thank you — it can take a few seconds to show as active.
        </p>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <Card padding="md">
            <div data-billing class="flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-lg text-soil-900">Billing</h2>
                <span data-billing-badge-ok hidden><Badge variant="success"><span data-billing-status></span></Badge></span>
                <span data-billing-badge-todo hidden><Badge variant="warning"><span data-billing-status></span></Badge></span>
              </div>
              <p class="text-sm text-soil-700">Instances are billed by the minute at Fly.io's price plus 35%; paid workers add a monthly license. Invoices and cards are in the Stripe portal.</p>
              <p data-payment-failed hidden class="text-sm font-medium text-sun-700">Your last payment failed. Update your card in the billing portal.</p>
              <div class="flex flex-wrap gap-3">
                <span data-action="checkout" hidden class="contents"><Button variant="primary" size="sm">Set up billing</Button></span>
                <span data-action="portal" hidden class="contents"><Button variant="secondary" size="sm">Manage billing</Button></span>
              </div>
            </div>
          </Card>
          <Card padding="md">
            <h2 class="text-lg text-soil-900">This month so far</h2>
            <div data-mtd-usage class="qf-figure mt-3 text-3xl leading-none text-soil-900">—</div>
            <p class="mt-2 text-sm text-soil-700"><span data-mtd-hours></span>, <span data-mtd-license></span>.</p>
            <p class="mt-1 text-[12.5px] text-soil-500">An estimate from the instance counts we record; your Stripe invoice is authoritative.</p>
          </Card>
        </div>

        <Card padding="md" class="mt-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-lg text-soil-900">Workspace</h2>
              <p class="mt-1 text-sm text-soil-700">Your workspace owns your deployments and billing. Everyone in it can sign in to its deployments from DuckDB.</p>
            </div>
            <div class="flex items-center gap-2 text-sm text-soil-600">
              <span>Invite teammates</span><Badge>Coming later</Badge>
            </div>
          </div>
        </Card>

        <div data-inventory hidden data-prices={PRICES} class="mt-10">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-2xl text-soil-900">Inventory</h2>
            <p data-inventory-summary class="text-sm text-soil-600"></p>
          </div>
          <div class="mt-4 overflow-x-auto rounded-xl border border-soil-200 bg-[#fffdf7]">
            <table class="w-full text-[14.5px] text-soil-800">
              <thead class="border-b border-soil-200">
                <tr>
                  <th scope="col" class={TH}>Worker</th>
                  <th scope="col" class={TH}>Release</th>
                  <th scope="col" class={TH}>Size</th>
                  <th scope="col" class={TH}>Region</th>
                  <th scope="col" class={`${TH} text-right`}>Instances</th>
                  <th scope="col" class={TH}>Status</th>
                  <th scope="col" class={`${TH} text-right`}>Est. per month</th>
                </tr>
              </thead>
              <tbody data-inventory-rows class="divide-y divide-soil-200/70"></tbody>
              <tfoot class="border-t border-soil-200 font-semibold text-soil-900">
                <tr>
                  <td class={TD} colspan="4">Running now</td>
                  <td data-inventory-instances class={`${TD} qf-figure text-right`}></td>
                  <td class={TD}></td>
                  <td data-inventory-monthly class={`${TD} qf-figure text-right`}></td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="mt-2 text-[12.5px] text-soil-500">Estimates assume the running instances stay up all month, plus licenses for paid workers. Stopped deployments are listed last and cost nothing.</p>
        </div>

        <h2 class="mt-10 text-2xl text-soil-900">Deployments</h2>
        <div data-deployments class="mt-4 flex flex-col gap-4"></div>
        <div data-empty hidden class="mt-4">
          <Card padding="lg">
            <p class="text-soil-700">No hosted workers yet. Pick one from the Orchard, or start a deployment here.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <Button href="/products/orchard/console/new" variant="primary" size="sm">New deployment</Button>
              <Button href="/products/orchard/connectors" variant="secondary" size="sm">Browse connectors</Button>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <template id="tpl-inventory-row">
    <tr data-row>
      <th scope="row" class={`${TD} text-left font-medium`}><a data-name class="text-soil-900 underline decoration-soil-300 underline-offset-2 hover:text-link"></a></th>
      <td data-version class={`${TD} font-mono text-[13px]`}></td>
      <td data-size class={TD}></td>
      <td data-region class={TD}></td>
      <td data-instances class={`${TD} qf-figure text-right`}></td>
      <td class={TD}><span data-status></span></td>
      <td data-monthly class={`${TD} qf-figure text-right`}></td>
    </tr>
  </template>

  <template id="tpl-deployment">
    <Card padding="md">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <h3 class="text-xl text-soil-900"><a data-worker-link data-name class="no-underline hover:text-link"></a></h3>
          <p data-meta class="mt-1 text-sm text-soil-600"></p>
        </div>
        <Badge variant="info"><span data-status></span></Badge>
      </div>
      <div class="mt-4 flex flex-wrap items-end gap-x-8 gap-y-4">
        <div>
          <div class={LABEL}>Instances running</div>
          <div class="mt-1 flex items-center gap-3">
            <span data-actual class="qf-figure text-3xl leading-none text-soil-900"></span>
            <span data-desired-wrap hidden class="text-sm text-soil-600">→ <span data-desired class="qf-figure"></span> requested</span>
          </div>
        </div>
        <div data-controls class="flex flex-wrap items-center gap-2">
          <span data-action="minus" class="contents"><Button variant="secondary" size="sm" class="min-w-9" ><span aria-hidden="true">−</span><span class="sr-only">One fewer instance</span></Button></span>
          <span data-action="plus" class="contents"><Button variant="secondary" size="sm" class="min-w-9"><span aria-hidden="true">+</span><span class="sr-only">One more instance</span></Button></span>
          <span data-action="stop" class="contents"><Button variant="ghost" size="sm">Stop</Button></span>
        </div>
      </div>
      <p data-pending class="mt-3 text-sm text-soil-600"></p>
      <div data-endpoint-wrap hidden class="mt-4">
        <div class={LABEL}>Endpoint</div>
        <p data-endpoint class="mt-1 break-all font-mono text-sm text-soil-800"></p>
      </div>
      <div data-attach-wrap hidden class="mt-4">
        <div class="flex items-center justify-between gap-3">
          <div class={LABEL}>Attach from DuckDB or Haybarn</div>
          <span data-action="copy" class="contents"><Button variant="ghost" size="sm">Copy</Button></span>
        </div>
        <pre class="mt-2 overflow-x-auto rounded-xl border border-rock-800 bg-rock-900 p-4 font-mono text-[13.5px] leading-relaxed text-[#e9e1d3]"><code data-attach></code></pre>
        <p class="mt-2 text-[12.5px] text-soil-500">No secrets needed: the first query opens a browser to sign in with your Orchard account. Install the vgi extension first, as in any connector's Quick start.</p>
      </div>
    </Card>
  </template>

  <script>
    import { initConsole } from '../../../../scripts/orchard-console';
    initConsole();
  </script>
</PageLayout>
