---
// Request a hosted deployment: worker, size, instances, region. Creates a
// deployment plus a `create` request for the team to fulfil on Fly.io. Billing
// must be set up first; the script sends the user through Stripe Checkout and
// back here with their choices intact.
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import Card from '../../../../components/ui/Card.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import { LICENSE_MONTHLY_USD, MAX_INSTANCES, REGIONS, SIZES, monthlyUsd, usd } from '../../../../lib/orchard/pricing';

const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const LEGEND = 'text-[15px] font-semibold text-soil-900';
const ERR = 'mt-1 text-sm text-sun-700';
const FIELD = 'mt-2 w-full rounded-lg border border-soil-300 bg-white px-3 py-2 text-[15px] text-soil-900 focus-visible:outline-2 focus-visible:outline-link';
---

<PageLayout title="New deployment — Hosted Orchard" description="Request a hosted Orchard worker." noindex>
  <OrchardSubNav breadcrumbs={[{ name: 'Orchard', href: '/products/orchard' }, { name: 'Console', href: '/products/orchard/console' }]} />

  <PageHead variant="section" eyebrow="Hosted Orchard" title="New deployment">
    <Fragment slot="lede">Choose a worker and how much of it to run. We provision it on Fly.io and email you when it's live, usually within one business day.</Fragment>
  </PageHead>

  <section class="pt-10 pb-16">
    <div class={WRAP}>
      <p data-state="loading" class="text-soil-600">Loading…</p>

      <div data-state="signed-out" hidden>
        <Card padding="lg" class="max-w-[640px]">
          <h2 class="text-2xl text-soil-900">Sign in to request a deployment</h2>
          <p class="mt-3 leading-relaxed text-soil-700">Your Orchard account comes with a workspace that holds your deployments and billing.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <span data-signin="signin" class="contents"><Button href="/api/auth/login" variant="primary">Sign in</Button></span>
            <span data-signin="signup" class="contents"><Button href="/api/auth/login?signup=1" variant="secondary">Create an account</Button></span>
          </div>
        </Card>
      </div>

      <div data-state="error" hidden>
        <Card padding="lg" class="max-w-[640px]"><p data-message class="text-soil-800"></p></Card>
      </div>

      <div data-state="ready" hidden>
        <form data-new class="grid max-w-[760px] gap-8" novalidate>
          <p data-billing-done hidden class="rounded-lg border border-field-600/45 bg-field-600/10 px-4 py-3 text-sm text-field-700">
            Billing is set up. Check your choices and send the request.
          </p>

          <label class="block">
            <span class={LEGEND}>Worker</span>
            <select name="worker" required class={FIELD}><option value="">Loading workers…</option></select>
            <p data-error-for="worker" class={ERR}></p>
          </label>

          <fieldset>
            <legend class={LEGEND}>Size</legend>
            <div class="mt-2 grid gap-3 sm:grid-cols-3">
              {SIZES.map((s, i) => (
                <label class="flex cursor-pointer flex-col gap-1 rounded-xl border border-soil-300 bg-[#fffdf7] p-4 has-[:checked]:border-field-600 has-[:checked]:bg-field-600/5">
                  <span class="flex items-center gap-2">
                    <input type="radio" name="size" value={s.id} checked={i === 0} data-monthly={monthlyUsd(s)} />
                    <span class="font-semibold text-soil-900">{s.label}</span>
                  </span>
                  <span class="text-sm text-soil-700">{s.cpus}, {s.memoryGb} GB</span>
                  <span class="text-sm text-soil-600">{s.blurb}</span>
                  <span class="qf-figure mt-1 text-soil-900">{usd(monthlyUsd(s))}<span class="text-sm text-soil-600">/instance-month</span></span>
                </label>
              ))}
            </div>
            <p data-error-for="size" class={ERR}></p>
          </fieldset>

          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block">
              <span class={LEGEND}>Instances</span>
              <input name="instances" type="number" min="1" max={MAX_INSTANCES} value="1" required class={FIELD} />
              <p class="mt-1 text-[13px] text-soil-600">1 to {MAX_INSTANCES}. You can scale later from the console.</p>
              <p data-error-for="instances" class={ERR}></p>
            </label>
            <label class="block">
              <span class={LEGEND}>Region</span>
              <select name="region" required class={FIELD}>
                {REGIONS.map(r => <option value={r.id}>{r.label}</option>)}
              </select>
              <p class="mt-1 text-[13px] text-soil-600">Prices use Fly's US-East rates; we confirm any difference before provisioning elsewhere.</p>
              <p data-error-for="region" class={ERR}></p>
            </label>
          </div>

          <Card padding="md">
            <div class="text-[12px] font-semibold text-soil-500">Estimate</div>
            <p data-estimate class="qf-figure mt-1 text-2xl text-soil-900">—</p>
            <p class="mt-1 text-sm text-soil-600">Billed by the minute while instances run. Paid workers add {usd(LICENSE_MONTHLY_USD, 0)}/month per deployment.</p>
            <p data-billing-required hidden class="mt-3 text-sm text-soil-700">You'll set up billing with Stripe first, then come straight back here.</p>
          </Card>

          <div>
            <Button type="submit" variant="primary">Request deployment</Button>
            <p data-form-error class={ERR}></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { initNew } from '../../../../scripts/orchard-console';
    initNew();
  </script>
</PageLayout>
