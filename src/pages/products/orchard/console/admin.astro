---
// The hosted Orchard request tracker, for the ORCHARD_ADMINS allow-list.
// Fulfil a request on Fly.io by hand, then mark it done here with the
// endpoint and the instance count actually running; that writes the
// deployment_events row metering bills from.
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import Card from '../../../../components/ui/Card.astro';
import Badge from '../../../../components/ui/Badge.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import { MAX_INSTANCES } from '../../../../lib/orchard/pricing';

const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const FIELD = 'mt-1 w-full rounded-lg border border-soil-300 bg-white px-3 py-1.5 text-sm text-soil-900 disabled:bg-soil-100';
const LABEL = 'text-[12px] font-semibold text-soil-500';
---

<PageLayout title="Request tracker — Hosted Orchard" description="Hosted Orchard request tracker." noindex>
  <OrchardSubNav breadcrumbs={[{ name: 'Orchard', href: '/products/orchard' }, { name: 'Console', href: '/products/orchard/console' }]} />

  <PageHead variant="section" eyebrow="Hosted Orchard · staff" title="Request tracker">
    <Fragment slot="lede">Open requests first, then anything resolved in the last two weeks. Marking a request done records the instances actually running.</Fragment>
  </PageHead>

  <section class="pt-10 pb-16">
    <div class={WRAP}>
      <p data-state="loading" class="text-soil-600">Loading…</p>
      <div data-state="signed-out" hidden>
        <Card padding="lg" class="max-w-[640px]">
          <p class="text-soil-700">Sign in with an admin account.</p>
          <div class="mt-4"><span data-signin="signin" class="contents"><Button href="/api/auth/login" variant="primary">Sign in</Button></span></div>
        </Card>
      </div>
      <div data-state="error" hidden>
        <Card padding="lg" class="max-w-[640px]"><p data-message class="text-soil-800"></p></Card>
      </div>
      <div data-state="ready" hidden>
        <div class="flex justify-end"><Button href="/products/orchard/console" variant="ghost" size="sm">Back to console</Button></div>
        <div data-gate-panel hidden class="mt-4">
          <Card variant="featured" padding="md">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg text-soil-900">Gate setup for <span data-gate-deployment class="font-mono text-[15px]"></span></h2>
              <span data-action="gate-copy" class="contents"><Button variant="secondary" size="sm">Copy</Button></span>
            </div>
            <p class="mt-1 text-sm font-medium text-sun-700">The secret is shown once. Set it on Fly now; it is stored only as a hash. Lost it? Generate a new one from the request below.</p>
            <pre class="mt-3 overflow-x-auto rounded-xl border border-rock-800 bg-rock-900 p-4 font-mono text-[13px] leading-relaxed text-[#e9e1d3]"><code data-gate-setup></code></pre>
          </Card>
        </div>
        <div data-requests class="mt-4 flex flex-col gap-4"></div>
        <p data-empty hidden class="mt-4 text-soil-600">No requests.</p>
      </div>
    </div>
  </section>

  <template id="tpl-request">
    <Card padding="md">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 data-title class="text-lg capitalize text-soil-900"></h2>
          <p data-meta class="mt-1 text-sm text-soil-700"></p>
          <p data-detail class="mt-1 break-all font-mono text-[12.5px] text-soil-600"></p>
          <p class="mt-1 text-[12.5px] text-soil-500">Requested <span data-created></span></p>
          <p data-note class="mt-1 text-sm italic text-soil-700"></p>
        </div>
        <Badge variant="warning"><span data-status></span></Badge>
      </div>
      <div data-fulfil class="mt-4 grid gap-3 border-t border-soil-200 pt-4 sm:grid-cols-[2fr_1fr_2fr]">
        <label><span class={LABEL}>Endpoint (https://…)</span><input name="endpoint" type="url" class={FIELD} placeholder="https://qf-….fly.dev" /></label>
        <label><span class={LABEL}>Instances running</span><input name="instances" type="number" min="0" max={MAX_INSTANCES} class={FIELD} /></label>
        <label><span class={LABEL}>Note (optional)</span><input name="note" type="text" maxlength="1000" class={FIELD} /></label>
        <div class="flex flex-wrap gap-2 sm:col-span-3">
          <span data-action="progress" class="contents"><Button variant="secondary" size="sm">Mark in progress</Button></span>
          <span data-action="done" class="contents"><Button variant="primary" size="sm">Mark done</Button></span>
          <span data-action="reject" class="contents"><Button variant="ghost" size="sm">Reject</Button></span>
        </div>
      </div>
      <div data-gate-row hidden class="mt-4 flex flex-wrap items-center gap-3 border-t border-soil-200 pt-4 text-sm text-soil-700">
        <span data-gate-state></span>
        <span data-action="gate-secret" class="contents"><Button variant="ghost" size="sm">New gate secret</Button></span>
      </div>
    </Card>
  </template>

  <script>
    import { initAdmin } from '../../../../scripts/orchard-console';
    initAdmin();
  </script>
</PageLayout>
