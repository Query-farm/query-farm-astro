---
import PageLayout from '../../../../../layouts/PageLayout.astro';
import PageHead from '../../../../../components/ui/PageHead.astro';
import OrchardSubNav from '../../../../../components/sections/OrchardSubNav.astro';
import WorkerDirectory from '../../../../../components/orchard/WorkerDirectory.astro';
import { Icon } from 'astro-icon/components';
import { categories, workersInCategory, tintFor } from '../../../../../data/vgi-workers';

export function getStaticPaths() {
  return categories
    .filter(c => workersInCategory(c.id).length > 0)
    .map(c => ({ params: { category: c.id }, props: { category: c } }));
}
const { category } = Astro.props;
const list = workersInCategory(category.id);
const tint = tintFor(category.tint);
---

<PageLayout title={`${category.name} — VGI Worker Library`} description={`${list.length} VGI workers for ${category.name.toLowerCase()}: ${category.description}`}>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Workers', href: '/products/orchard/workers' },
      { name: category.name, href: `/products/orchard/workers/category/${category.id}` },
    ]}
  />
  <PageHead variant="section" eyebrow="Worker library" title={category.name} lede={category.description} hairband>
    <span slot="icon" class={`flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 ${tint.tile} ${tint.ink}`} aria-hidden="true">
      <Icon name={category.icon} class="h-7 w-7" />
    </span>
    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">{list.length}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Workers</div>
    </Fragment>
  </PageHead>
  <section class="border-y border-soil-300 bg-soil-100 py-12">
    <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
      <WorkerDirectory workers={list} activeCategory={category.id} />
    </div>
  </section>
</PageLayout>
