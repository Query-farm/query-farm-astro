---
import { marked } from 'marked';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import CodeBlock from '../../../../components/ui/CodeBlock.astro';
import CodeTabs from '../../../../components/ui/CodeTabs.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import WorkerCard from '../../../../components/orchard/WorkerCard.astro';
import CatalogExplorer from '../../../../components/orchard/CatalogExplorer.astro';
import { workers, relatedWorkers, platformLabel, LANGUAGE_ICON, type Worker } from '../../../../data/vgi-workers';

export function getStaticPaths() {
  return workers.map(w => ({ params: { slug: w.slug }, props: { worker: w } }));
}
const { worker: w } = Astro.props as { worker: Worker };
const related = relatedWorkers(w);
const SITE = 'https://query.farm';
const url = `${SITE}/products/orchard/workers/${w.slug}`;
const cat = w.primaryCategory;

// The worker's long-form docs (vgi.doc_md) are written as a standalone page:
// drop a leading H1 (it repeats the page title) and demote the remaining
// headings below this page's own h2 sections.
function renderDoc(src: string): string {
  const body = src.replace(/^\s*#\s+[^\n]*\n+/, '');
  const demoted = body.replace(/^(#{1,4})(\s)/gm, (_m, h: string, sp: string) => '#'.repeat(Math.min(h.length + 2, 6)) + sp);
  return marked.parse(demoted) as string;
}
const docHtml = w.doc_md ? renderDoc(w.doc_md) : '';
const examples = w.example_queries.length
  ? w.example_queries
  : w.readme_sql
    ? [{ title: 'From the README', description: null, sql: w.readme_sql.replace(/^```sql\n?|```$/g, '').trim() }]
    : [];

const installTabs = w.installMethods.map(m => ({ id: m.id, label: m.label, icon: m.icon, lang: 'sql', steps: m.steps.map(s => ({ title: s.title, description: s.description, code: s.code, lang: s.lang })) }));

// "For authors": which declared metadata fed which part of this page.
const coverage = [
  { label: 'Title (vgi.title)', ok: Boolean(w.title) },
  { label: 'Catalog description', ok: Boolean(w.summary) },
  { label: 'Long-form docs (vgi.doc_md)', ok: Boolean(w.doc_md) },
  { label: 'Keywords (vgi.keywords)', ok: w.keywords.length > 0 },
  { label: 'Example queries', ok: w.example_queries.length > 0 },
  { label: 'Agent test tasks', ok: w.agent_tasks.length > 0 },
  { label: 'Licence (vgi.license)', ok: Boolean(w.license) },
  {
    label: 'Every object documented',
    ok: w.objects.length > 0 && w.objects.every(o => o.comment),
  },
];

const facts: [string, string][] = [
  ['Catalog', w.catalog],
  ['Language', w.language],
  ...(w.builtOn.length ? [['Built on', w.builtOn.join(', ')] as [string, string]] : []),
  ...(w.release ? [['Release', w.release.tag] as [string, string]] : []),
  ...(w.license ? [['Licence', w.license] as [string, string]] : []),
  ['Exposes', w.facets.surfaces.join(', ') || '—'],
  ['Runs on', [...w.platforms.filter(p => p !== 'wasm').map(platformLabel), ...(w.language === 'Python' ? ['Any OS (uv)'] : []), ...(w.language === 'Java' ? ['Any OS (Java 21+)'] : []), ...(w.image ? ['Docker'] : [])].join(', ') || '—'],
  ['Cost', w.offering.pricing === 'open' ? 'Free and open source — you run it yourself' : 'Paid'],
  ...(w.facets.needsCredentials
    ? [['Credentials', w.facets.secretTypes.length ? `Needs a ${w.facets.secretTypes.join(' / ')} secret` : 'Needs credentials at ATTACH'] as [string, string]]
    : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: w.repo,
    description: w.blurb,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url,
    codeRepository: w.repo_url,
    softwareVersion: w.release?.tag,
    license: w.license ?? undefined,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE },
  },
];
const H2 = 'text-2xl text-soil-900';
---

<PageLayout title={`${w.repo} — ${w.displayTitle} | Orchard`} description={w.blurb} ogImage="/og/orchard.jpg" jsonLd={jsonLd}>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Workers', href: '/products/orchard/workers' },
      { name: w.repo, href: `/products/orchard/workers/${w.slug}` },
    ]}
  />

  <PageHead variant="section" eyebrow={cat ? cat.name : 'Open worker'} lede={w.blurb} hairband>
    <span slot="title" class="font-mono">{w.repo}</span>
    <span slot="icon" class={`flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 ${w.tint.tile} ${w.tint.ink}`} aria-hidden="true">
      <Icon name={cat?.icon ?? 'ph:cube'} class="h-7 w-7" />
    </span>
    <div slot="badges" class="mt-3 flex flex-wrap items-center gap-1.5">
      <span class="inline-flex items-center gap-1 rounded-full border border-soil-300 bg-soil-100/70 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-700">
        <Icon name={LANGUAGE_ICON[w.language] ?? 'ph:code'} class="h-3.5 w-3.5" aria-hidden="true" />{w.language}
      </span>
      {w.release && <span class="inline-flex items-center rounded-full border border-soil-300 bg-soil-100/70 px-2.5 py-0.5 font-mono text-[12px] text-soil-700">{w.release.tag}</span>}
      {w.lint?.score != null && <span class="inline-flex items-center rounded-full border border-sun-400/60 bg-sun-400/10 px-2.5 py-0.5 text-[12.5px] font-medium text-sun-700" title="vgi-lint metadata quality score">Metadata {w.lint.score}/100</span>}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href="#quick-start" variant="primary" size="md">Quick start</Button>
      <Button href="#catalog" variant="secondary" size="md">Explore the catalog</Button>
      <Button href={w.repo_url} variant="ghost" size="md">GitHub ↗</Button>
    </div>
  </PageHead>

  <div class="mx-auto w-full max-w-[1200px] px-6 py-10 sm:px-7 lg:grid lg:grid-cols-[1fr_18rem] lg:gap-10">
    <div class="min-w-0">
      <!-- Overview -->
      {(w.summary || docHtml) && (
        <section>
          <h2 class={H2}>Overview</h2>
          {w.summary && w.summary !== w.blurb && <p class="mt-3 text-[17px] leading-relaxed text-soil-700">{w.summary}</p>}
          {docHtml && <div class="prose mt-3 max-w-none text-[15.5px] prose-headings:text-soil-900 prose-p:text-soil-700 prose-li:text-soil-700 prose-a:text-link prose-strong:text-soil-900 prose-code:text-soil-900 prose-code:bg-soil-100 prose-code:font-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[14px] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-pre:bg-rock-900 prose-pre:text-[#e9e1d3]" set:html={docHtml} />}
        </section>
      )}

      <!-- Quick start -->
      <section id="quick-start" class="mt-12 scroll-mt-32">
        <h2 class={H2}>Quick start</h2>
        <p class="mt-2 text-soil-700">
          Pick how you want to run it. The worker runs locally as a subprocess of DuckDB or Haybarn — there's nothing to
          sign up for.
        </p>
        <div class="mt-5">
          {installTabs.length > 0 ? (
            <CodeTabs tabs={installTabs} group="orchard-install" ariaLabel="Choose how to run the worker" />
          ) : (
            <CodeBlock code={w.attachSql} lang="sql" title="attach.sql" tryable={false} />
          )}
        </div>
        {w.attach_options.length > 0 && (
          <div class="mt-5 rounded-xl border border-soil-300 bg-[#fffdf7] p-4">
            <h3 class="text-[15px] font-semibold text-soil-900">ATTACH options</h3>
            <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
              {w.attach_options.map(o => (
                <>
                  <dt class="font-mono text-soil-900">{o.name}{o.required && <span class="ml-1 text-[11px] font-sans text-sun-700">required</span>}</dt>
                  <dd class="text-soil-700">{o.description}{o.type && <span class="ml-1 font-mono text-[12px] text-soil-500">{o.type}</span>}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
      </section>

      <!-- Examples -->
      {examples.length > 0 && (
        <section id="examples" class="mt-12 scroll-mt-32">
          <h2 class={H2}>Try these queries</h2>
          <div class="mt-4 flex flex-col gap-4">
            {examples.slice(0, 8).map(e => (
              <div>
                {(e.title || e.description) && (
                  <p class="mb-1.5 text-sm text-soil-700">
                    {e.title && <strong class="font-semibold text-soil-900">{e.title}</strong>}
                    {e.title && e.description && ' — '}
                    {e.description}
                  </p>
                )}
                <CodeBlock code={e.sql} lang="sql" tryable={false} />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Agent tasks -->
      {w.agent_tasks.length > 0 && (
        <section id="ask" class="mt-12 scroll-mt-32">
          <h2 class={H2}>Questions it can answer</h2>
          <p class="mt-2 text-soil-700">The worker ships these as agent test tasks — plain-English questions an AI agent should be able to answer with SQL against this catalog.</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {w.agent_tasks.slice(0, 10).map(t => (
              <li class="rounded-lg border border-soil-300 bg-[#fffdf7] px-4 py-3 text-sm leading-relaxed text-soil-800">“{t}”</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Catalog explorer -->
      <section id="catalog" class="mt-12 scroll-mt-32">
        <h2 class={H2}>Catalog</h2>
        <p class="mt-2 text-soil-700">
          Everything <code class="font-mono">{w.catalog}</code> exposes once attached — read straight from the worker's
          released build.
        </p>
        <div class="mt-5">
          <CatalogExplorer worker={w} />
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="mt-12 lg:mt-0">
      <div class="flex flex-col gap-4 lg:sticky lg:top-28">
        <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
          <h2 class="text-[15px] font-semibold text-soil-900">At a glance</h2>
          <dl class="mt-3 flex flex-col gap-2 text-sm">
            {facts.map(([k, v]) => (
              <div>
                <dt class="text-[12px] font-semibold text-soil-500">{k}</dt>
                <dd class="text-soil-800">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-4 flex flex-col gap-1.5 border-t border-soil-200 pt-3 text-sm">
            <a href={w.repo_url} class="text-link underline decoration-link/40 underline-offset-2">Source on GitHub</a>
            {w.release && <a href={`${w.repo_url}/releases/tag/${w.release.tag}`} class="text-link underline decoration-link/40 underline-offset-2">Release {w.release.tag} &amp; checksums</a>}
            {w.image && <span class="font-mono text-[12px] text-soil-600">{w.image}</span>}
          </div>
        </div>

        <details class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
          <summary class="cursor-pointer text-[15px] font-semibold text-soil-900">For worker authors</summary>
          <p class="mt-2 text-[13px] leading-relaxed text-soil-700">This page is generated from the metadata the worker declares in its catalog. What it found:</p>
          <ul class="mt-2 flex flex-col gap-1 text-[13px]">
            {coverage.map(c => (
              <li class="flex items-center gap-2">
                <Icon name={c.ok ? 'ph:check-circle-fill' : 'ph:circle-dashed'} class:list={['h-4 w-4 flex-none', c.ok ? 'text-field-600' : 'text-soil-400']} aria-hidden="true" />
                <span class={c.ok ? 'text-soil-800' : 'text-soil-500'}>{c.label}</span>
              </li>
            ))}
          </ul>
          <a href="/vgi/docs/" class="mt-3 inline-block text-[13px] text-link underline decoration-link/40 underline-offset-2">Metadata tags reference →</a>
        </details>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="border-t border-soil-300 bg-soil-100 py-12">
      <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
        <h2 class={H2}>Related workers</h2>
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map(r => <WorkerCard worker={r} />)}
        </div>
      </div>
    </section>
  )}
</PageLayout>
