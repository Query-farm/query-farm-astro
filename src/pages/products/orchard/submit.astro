---
import PageLayout from '../../../layouts/PageLayout.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';

const steps = [
  {
    title: 'Build a VGI worker',
    description: 'Implement your connector as a VGI worker in any supported language. It exposes schemas, tables, and functions over the VGI protocol.',
  },
  {
    title: 'Describe your listing',
    description: 'Add a manifest: name, category, summary, the tables and functions you expose, an example query, and your pricing model.',
  },
  {
    title: 'Submit for review',
    description: 'We review the worker for correctness, security, and a clean schema. We test the attach flow and your example queries.',
  },
  {
    title: 'Publish & get paid',
    description: 'Once approved, your connector appears in the Orchard. Subscriptions are billed by Query.Farm and paid out to you on a revenue share.',
  },
];

const requirements = [
  'A working VGI worker that runs as a hosted service.',
  'A stable schema — tables and functions that won’t change without versioning.',
  'Auth handled via DuckDB secrets / Orchard tokens, never hard-coded.',
  'A runnable example query that returns rows.',
  'Clear docs for each table, function, and required credential.',
];

const manifest = `# orchard.toml — connector listing manifest (prototype)
id = "my-connector"
name = "My Connector"
category = "Streaming"
summary = "One-line description shown on the marketplace card."
language = "python"

pricing.model = "subscription"   # free | subscription | enterprise
pricing.note  = "From $49/mo"

[[offers]]
kind = "table"
name = "my.things"
description = "What this table contains."

[example]
sql = """
ATTACH 'my-connector' AS mc (TYPE vgi, LOCATION 'https://orchard.query.farm/my-connector', TOKEN getenv('ORCHARD_TOKEN'));
SELECT * FROM mc.things LIMIT 10;
"""`;

const SITE_ORIGIN = 'https://query.farm';
const description =
  'Publish a VGI connector on the Orchard — build a worker, describe your listing, pass review, and earn a revenue share on subscriptions.';
---

<PageLayout
  title="Publish on the Orchard — Get Your Connector Listed"
  description={description}
  showBreadcrumbs
  breadcrumbs={[
    { name: 'Products', href: '/products' },
    { name: 'The Orchard', href: '/products/orchard' },
    { name: 'Publish', href: '/products/orchard/submit' },
  ]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-emerald-100 via-harvest-50 to-white py-16 lg:py-20 border-b border-soil-200">
    <div class="section-container text-center">
      <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">For builders</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-extrabold text-soil-900 leading-tight">
        Publish your connector on the Orchard
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg md:text-xl text-soil-700 leading-relaxed">
        Built a VGI worker? List it in the marketplace, set your pricing, and let teams discover and subscribe to it with one line of SQL.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/contact" variant="accent" size="lg">Apply to publish</Button>
        <Button href="/vgi/building-a-worker" variant="secondary" size="lg">Build a worker first</Button>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="How it works"
        title="From worker to listing in four steps"
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {steps.map((step, i) => (
          <Card padding="lg" class="border-2 border-soil-900 shadow-sm flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-grain-300 text-soil-900 font-extrabold">
              {i + 1}
            </div>
            <div>
              <h3 class="text-lg font-bold text-soil-900 mb-1">{step.title}</h3>
              <p class="text-sm text-soil-700 leading-relaxed">{step.description}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Requirements + manifest -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-start max-w-6xl mx-auto">
        <div>
          <SectionHeader eyebrow="Requirements" title="What a listing needs" />
          <ul class="mt-6 space-y-3">
            {requirements.map((r) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-soil-700 leading-relaxed">{r}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 rounded-xl border-2 border-harvest-300 bg-harvest-50 p-5">
            <h3 class="font-bold text-soil-900">Revenue share</h3>
            <p class="mt-2 text-sm text-soil-700 leading-relaxed">
              Query.Farm handles billing, credentials, and distribution. You keep a revenue share on every subscription — exact terms are set during onboarding while the Orchard is in preview.
            </p>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-harvest-700 mb-3">Example listing manifest</h3>
          <CodeBlock code={manifest} lang="bash" title="orchard.toml" tryable={false} />
          <p class="mt-3 text-xs text-soil-500">
            The manifest format is a prototype and will change as the Orchard matures.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-emerald-600 to-harvest-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Have a connector to share?</h2>
      <p class="text-lg md:text-xl text-emerald-50 mb-8 max-w-2xl mx-auto">
        Tell us what you’ve built and we’ll help you get it listed on the Orchard.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/contact" variant="secondary" size="lg">Apply to publish</Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
