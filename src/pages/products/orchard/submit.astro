---
import PageLayout from '../../../layouts/PageLayout.astro';
import OrchardSubNav from '../../../components/sections/OrchardSubNav.astro';
import Button from '../../../components/ui/Button.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';

const steps = [
  {
    title: 'Build a VGI worker',
    description: 'Implement your connector as a VGI worker in any supported language. It exposes schemas, tables, and functions over the VGI protocol.',
  },
  {
    title: 'Describe your listing',
    description: 'Add a manifest: name, category, summary, the tables and functions you expose, an example query, and your pricing model.',
  },
  {
    title: 'Submit for review',
    description: 'We review the worker for correctness, security, and a clean schema. We test the attach flow and your example queries.',
  },
  {
    title: 'Publish & get paid',
    description: 'Once approved, your connector appears in the Orchard. Subscriptions are billed by Query.Farm and paid out to you on a revenue share.',
  },
];

const requirements = [
  'A working VGI worker that runs as a hosted service.',
  'A stable schema — tables and functions that won’t change without versioning.',
  'Auth handled via DuckDB secrets / Orchard tokens, never hard-coded.',
  'A runnable example query that returns rows.',
  'Clear docs for each table, function, and required credential.',
];

const payoff = [
  'Query.Farm handles billing, credentials, and distribution.',
  'You keep a revenue share on every subscription.',
  'Your listing sits in the catalog beside every other connector.',
  'Exact terms are set during onboarding while the Orchard is in preview.',
];

const manifest = `# orchard.toml — connector listing manifest (prototype)
id = "my-connector"
name = "My Connector"
category = "Streaming"
summary = "One-line description shown on the marketplace card."
language = "python"

pricing.model = "subscription"   # free | subscription | enterprise
pricing.note  = "From $49/mo"

[[offers]]
kind = "table"
name = "my.things"
description = "What this table contains."

[example]
sql = """
ATTACH 'my-connector' AS mc (TYPE vgi, LOCATION 'https://orchard.query.farm/my-connector', TOKEN getenv('ORCHARD_TOKEN'));
SELECT * FROM mc.things LIMIT 10;
"""`;

const description =
  'Publish a VGI connector on the Orchard — build a worker, describe your listing, pass review, and earn a revenue share on subscriptions.';

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
---

<PageLayout
  title="Publish on the Orchard — Get Your Connector Listed"
  description={description}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Publish', href: '/products/orchard/submit' },
    ]}
  />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="For builders"
    title="Publish your connector on the Orchard."
    lede="Built a VGI worker? List it in the marketplace, set your pricing, and let teams discover and subscribe to it with one line of SQL."
    hairband
  >
    <span
      slot="icon"
      class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-2xl"
      aria-hidden="true"
    >🌳</span>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/company/contact" variant="primary" size="md">Apply to publish</Button>
      <Button href="/vgi/building-a-worker" variant="secondary" size="md">Build a worker first</Button>
    </div>
  </PageHead>

  <!-- ── How it works ────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>How it works</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">From worker to listing in four steps</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2">
        {steps.map((step, i) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            <div class="qf-figure text-[13.5px] text-sun-700">
              Step {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="mt-2 text-xl text-soil-900">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Example manifest ────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <span class={EYEBROW}>The manifest</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">One file describes the listing</h2>
          <p class={`mt-3.5 max-w-[52ch] ${LEDE}`}>
            The manifest is what the marketplace card, the detail page, and the review checklist
            all read from — name, category, pricing, the objects you expose, and a query that
            actually runs.
          </p>
          <div class="mt-6 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
            <div class="text-[12.5px] font-medium text-sun-700">Prototype</div>
            <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
              The manifest format is a prototype and will change as the Orchard matures.
            </p>
          </div>
        </div>
        <div class="min-w-0">
          <CodeBlock code={manifest} lang="bash" title="orchard.toml" tryable={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one panel: apply to publish ─────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-8 text-cream">
          <span class="qf-eyebrow text-sun-400">Apply to publish</span>
          <h2 class="mt-3 text-2xl md:text-3xl text-cream">Have a connector to share?</h2>
          <p class="mt-3 text-[15.5px] leading-relaxed text-cream-2">
            Tell us what you’ve built and we’ll help you get it listed. Query.Farm runs the
            commercial side so you can keep working on the connector.
          </p>
          <ul class="mt-6 flex flex-col gap-3 text-[14.5px] leading-relaxed">
            {payoff.map((p) => (
              <li class="flex items-start gap-2.5">
                <span class="flex-none text-sun-400" aria-hidden="true">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-cream-2">
            Or just email <span class="text-sun-400">rusty@query.farm</span> — that reaches the same person.
          </p>
        </div>

        <div class="px-8 py-8">
          <span class={EYEBROW}>Requirements</span>
          <h3 class="mt-3 text-xl md:text-2xl text-soil-900">What a listing needs</h3>
          <ul class="mt-5 flex flex-col gap-3">
            {requirements.map((r) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-[3px] flex-none text-sm text-field-700" aria-hidden="true">✓</span>
                <span class="text-[15px] leading-relaxed text-soil-700">{r}</span>
              </li>
            ))}
          </ul>
          <div class="mt-7 flex flex-wrap gap-3 border-t border-soil-200 pt-6">
            <Button href="/company/contact" variant="primary" size="md">Apply to publish</Button>
            <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
          </div>
          <p class="mt-3.5 text-xs leading-relaxed text-soil-500">
            We reply within two working days. Exact revenue-share terms are agreed during
            onboarding while the Orchard is in preview.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
