---
// One catalog-explorer row body as a bare fragment, for workers whose catalog
// is too large to inline (lazyCatalog). Fetched by CatalogExplorer on first open.
import CatalogObjectBody from '../../../../../../components/orchard/CatalogObjectBody.astro';
import { workers, groupOverloads } from '../../../../../../data/vgi-workers';
import { lazyCatalog, objectAnchor as anchor } from '../../../../../../data/vgi-workers/lazy';

export function getStaticPaths() {
  const paths = [];
  for (const w of workers.filter(lazyCatalog)) {
    for (const s of w.schemas) {
      for (const t of s.tables) paths.push({ params: { slug: w.slug, obj: anchor(s.name, t.name) }, props: { repo: w.repo, catalog: w.catalog, schema: s.name, table: t } });
      for (const [fname, group] of groupOverloads(s.functions))
        paths.push({ params: { slug: w.slug, obj: anchor(s.name, fname) }, props: { repo: w.repo, catalog: w.catalog, schema: s.name, group } });
    }
  }
  return paths;
}
const { repo, catalog, schema, table, group } = Astro.props;
const { obj } = Astro.params;
---

<!doctype html>
<meta name="robots" content="noindex" />
{table ? <CatalogObjectBody repo={repo} catalog={catalog} schema={schema} anchor={obj!} table={table} /> : <CatalogObjectBody repo={repo} catalog={catalog} schema={schema} anchor={obj!} group={group} />}
