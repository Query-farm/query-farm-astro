---
import PageLayout from '../../../../layouts/PageLayout.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import Button from '../../../../components/ui/Button.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import CodeBlock from '../../../../components/ui/CodeBlock.astro';
import ConnectorCard from '../../../../components/products/ConnectorCard.astro';
import { connectors, getConnector, statusLabel } from '../../../../data/connectors';

export function getStaticPaths() {
  return connectors.map((c) => ({ params: { slug: c.id }, props: { id: c.id } }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const connector = getConnector(id);
if (!connector) return Astro.redirect('/products/orchard');
const c = connector;

const related = connectors.filter((x) => x.id !== c.id).slice(0, 3);

const offerKindLabel: Record<string, string> = {
  table: 'Table',
  function: 'Function',
  macro: 'Macro',
  secret: 'Secret',
};
// Offer kinds on the farm palette: neutral / gold / field / warn (brief §3).
const offerKindClass: Record<string, string> = {
  table: 'border-soil-300 text-soil-700',
  function: 'border-sun-400 bg-sun-400/12 text-sun-700',
  macro: 'border-field-600/45 bg-field-600/10 text-field-700',
  secret: 'border-[#a8412a]/40 bg-[#a8412a]/8 text-[#a8412a]',
};

const statusClass: Record<string, string> = {
  stable: 'border-field-600/45 bg-field-600/10 text-field-700',
  beta: 'border-sun-400 bg-sun-400/12 text-sun-700',
  preview: 'border-sun-400 bg-sun-400/12 text-sun-700',
};

const subscribeCtaLabel = 'Contact us';

const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/orchard/connectors/${c.id}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `${c.name} connector`,
    description: c.summary,
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'VGI connector',
    operatingSystem: 'Linux, macOS, Windows',
    publisher: { '@type': 'Organization', name: c.provider, url: SITE_ORIGIN },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
      { '@type': 'ListItem', position: 4, name: c.name, item: pageUrl },
    ],
  },
];

// ── Shared shape vocabulary (brief §10) ──
const WRAP_WIDE = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const PILL = 'inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium';
const H2 = 'mt-11 scroll-mt-32 border-t border-soil-300 pt-6 text-2xl md:text-3xl text-soil-900';
---

<PageLayout
  title={`${c.name} — Orchard Connector`}
  description={c.summary}
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: c.name, href: pageUrl },
    ]}
  />

  <!-- ── Early-preview strip (gold callout, not a band) ───────── -->
  <div class="border-b border-soil-300 bg-sun-400/12">
    <div class={`${WRAP_WIDE} py-2 text-center text-[13px] font-medium text-sun-700`}>
      Orchard is an early preview — connector details below are illustrative while we iterate.
    </div>
  </div>

  <!-- ── Page header (family C: no hairband, no slab) ─────────── -->
  <PageHead
    variant="section"
    wide
    eyebrow={c.category}
    title={c.name}
    ledeClass="mt-3.5 max-w-[62ch] text-[17.5px] leading-relaxed text-soil-700"
    lede={c.summary}
  >
    <span
      slot="icon"
      class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-3xl"
      aria-hidden="true"
    >{c.icon}</span>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class={`${PILL} ${statusClass[c.status] ?? 'border-soil-300 text-soil-700'}`}>{statusLabel[c.status]}</span>
      <span class={`${PILL} border-soil-300 text-soil-700`}>By {c.provider}</span>
      <span class={`${PILL} border-soil-300 text-soil-700`}>{c.language} worker</span>
    </div>

    <Fragment slot="aside">
      <div class="text-2xl leading-tight text-sun-700">{c.priceNote}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">
        Pricing
      </div>
    </Fragment>
  </PageHead>

  <!-- ── Docs grid: prose + sticky rail ──────────────────────── -->
  <div class={`${WRAP_WIDE} grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-11`}>
    <!-- Not a landmark element: BaseLayout already renders the page's single main. -->
    <div class="min-w-0">
      <section aria-labelledby="overview">
        <h2 id="overview" class="scroll-mt-32 text-2xl md:text-3xl text-soil-900">What {c.name} does</h2>
        <div class="mt-4 flex flex-col gap-4">
          {c.description.map((p) => (
            <p class="leading-relaxed text-soil-700">{p}</p>
          ))}
        </div>
      </section>

      <section aria-labelledby="highlights">
        <h2 id="highlights" class={H2}>Highlights</h2>
        <ul class="mt-4 flex flex-col gap-3">
          {c.features.map((f) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-[3px] flex-none text-sm text-field-700" aria-hidden="true">✓</span>
              <span class="leading-relaxed text-soil-700">{f}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="offers">
        <h2 id="offers" class={H2}>Tables &amp; functions it exposes</h2>
        <p class="mt-3 leading-relaxed text-soil-700">
          Once attached, the connector adds these objects to your SQL session.
        </p>
        <dl class={`${CARD} mt-5 overflow-hidden`}>
          {c.offers.map((o) => (
            <div class="flex flex-col gap-2 border-b border-soil-200 px-5 py-4 last:border-0 sm:flex-row sm:items-start sm:gap-5">
              <dt class="flex flex-none items-center gap-3 sm:w-[19rem]">
                <span class={`${PILL} ${offerKindClass[o.kind] ?? 'border-soil-300 text-soil-700'} flex-none`}>
                  {offerKindLabel[o.kind]}
                </span>
                <code class="min-w-0 break-words font-mono text-sm text-soil-900">{o.name}</code>
              </dt>
              <dd class="min-w-0 text-sm leading-relaxed text-soil-700">{o.description}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="usecases">
        <h2 id="usecases" class={H2}>What teams build with {c.name}</h2>
        <div class="mt-5 grid gap-3.5 md:grid-cols-3">
          {c.useCases.map((u) => (
            <div class={`${CARD} p-5`}>
              <p class="text-sm leading-relaxed text-soil-700">{u}</p>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="cta">
        <h2 id="cta" class={H2}>Ready to attach {c.name}?</h2>
        <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
          Contact us for pricing and to get started, or talk to us about a custom connector for your stack.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/products/orchard/subscribe" variant="primary" size="md">{subscribeCtaLabel}</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Talk with us</Button>
        </div>
      </section>
    </div>

    <aside class="min-w-0 lg:sticky lg:top-24 lg:self-start">
      <div class={`${CARD} p-5`}>
        <div class="text-[12.5px] font-medium text-soil-700">Pricing</div>
        <p class="mt-2 text-2xl leading-tight text-soil-900">{c.priceNote}</p>
        <Button href="/products/orchard/subscribe" variant="primary" size="md" class="mt-5 w-full">
          {subscribeCtaLabel}
        </Button>
        <a
          href="/products/orchard"
          class="mt-3 block text-center text-[13px] font-medium text-link no-underline hover:underline"
        >← Back to the Orchard</a>
      </div>

      <div class="mt-6 min-w-0">
        <div class="mb-2.5 text-[12.5px] font-medium text-soil-500">Attach &amp; query</div>
        <CodeBlock code={c.exampleSql} lang="sql" title={`${c.id}.sql`} tryable={false} />
        <p class="mt-3 text-xs leading-relaxed text-soil-500">
          Requires the
          <a
            href="/vgi"
            class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link"
          >VGI</a>
          extension. Set <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900">ORCHARD_TOKEN</code>
          after subscribing.
        </p>
      </div>
    </aside>
  </div>

  <!-- ── Related connectors ──────────────────────────────────── -->
  <section class="border-t border-soil-300 py-14">
    <div class={WRAP_WIDE}>
      <span class={EYEBROW}>Keep exploring</span>
      <h2 class="mt-3 text-2xl md:text-3xl text-soil-900">Other connectors</h2>
      <div class="mt-7 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => (
          <ConnectorCard connector={r} />
        ))}
      </div>
    </div>
  </section>

  <!-- Record this visit for the "Recently viewed" list in the Products nav. -->
  <script is:inline define:vars={{ connId: c.id, connName: c.name }}>
    try {
      const key = 'qf:recentConnectors';
      const prev = JSON.parse(localStorage.getItem(key) || '[]').filter((e) => e && e.id !== connId);
      prev.unshift({ id: connId, name: connName });
      localStorage.setItem(key, JSON.stringify(prev.slice(0, 8)));
    } catch (e) { /* ignore storage errors */ }
  </script>
</PageLayout>
