---
import { linkHaybarn, HAYBARN_HREF } from '../../../../lib/haybarn-link';
import { marked } from 'marked';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import CodeBlock from '../../../../components/ui/CodeBlock.astro';
import CodeTabs from '../../../../components/ui/CodeTabs.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import WorkerCard from '../../../../components/orchard/WorkerCard.astro';
import CatalogExplorer from '../../../../components/orchard/CatalogExplorer.astro';
import WorkerCredentials from '../../../../components/orchard/WorkerCredentials.astro';
import { formatExampleSql } from '../../../../data/vgi-workers/format-sql';
import { workers, relatedWorkers, platformLabel, platformIcon, platformOrder, VGI_SETUP, exampleObjects, type Worker } from '../../../../data/vgi-workers';

export function getStaticPaths() {
  return workers.map(w => ({ params: { slug: w.slug }, props: { worker: w } }));
}
const { worker: w } = Astro.props as { worker: Worker };
const related = relatedWorkers(w);
const SITE = 'https://query.farm';
const url = `${SITE}/products/orchard/connectors/${w.slug}`;
const cat = w.primaryCategory;

// The worker's long-form docs (vgi.doc_md) are written as a standalone page:
// drop a leading H1 (it repeats the page title) and demote the remaining
// headings below this page's own h2 sections.
function renderDoc(src: string): string {
  const body = src.replace(/^\s*#\s+[^\n]*\n+/, '');
  const demoted = body.replace(/^(#{1,4})(\s)/gm, (_m, h: string, sp: string) => '#'.repeat(Math.min(h.length + 2, 6)) + sp);
  const html = marked.parse(demoted) as string;
  // Fenced blocks: CodeBlock's own frame (dark, rounded, farm-theme highlighting) and
  // `not-prose`, so the prose inline-code chip doesn't paint a light box inside them.
  return html.replace(
    /<pre><code(?: class="language-([\w-]+)")?>([\s\S]*?)<\/code><\/pre>/g,
    (_m, lang: string | undefined, code: string) => {
      const l = lang ?? 'text';
      return `<div class="not-prose my-4 code-block-wrapper relative overflow-hidden rounded-xl border border-rock-800 bg-rock-900"><pre class="overflow-x-auto p-5 language-${l} farm-theme text-[14px] leading-relaxed"><code class="language-${l}">${code.replace(/\n$/, '')}</code></pre></div>`;
    },
  );
}
const docHtml = w.doc_md ? renderDoc(w.doc_md) : '';
const examples = w.example_queries.length
  ? w.example_queries
  : w.readme_sql
    ? [{ title: 'From the README', description: null, sql: w.readme_sql.replace(/^```sql\n?|```$/g, '').trim() }]
    : [];
const EXAMPLES_SHOWN = 6;
const exampleList = examples.map(e => ({ ...e, uses: exampleObjects(w, e.sql) }));

const installTabs = w.installMethods.map(m => ({ id: m.id, label: m.label, icon: m.icon, lang: 'sql', steps: m.steps.map(s => ({ title: s.title, description: s.description, code: s.code, lang: s.lang })) }));

// "For authors": which declared metadata fed which part of this page.
const coverage = [
  { label: 'Title (vgi.title)', ok: Boolean(w.title) },
  { label: 'Catalog description', ok: Boolean(w.summary) },
  { label: 'Long-form docs (vgi.doc_md)', ok: Boolean(w.doc_md) },
  { label: 'Keywords (vgi.keywords)', ok: w.keywords.length > 0 },
  { label: 'Example queries', ok: w.example_queries.length > 0 },
  { label: 'Agent test tasks', ok: w.agent_tasks.length > 0 },
  { label: 'Licence (vgi.license)', ok: Boolean(w.license) },
  {
    label: 'Every object documented',
    ok: w.objects.length > 0 && w.objects.every(o => o.comment),
  },
  ...(w.credentials.length
    ? [
        { label: 'Secret keys documented (vgi_doc)', ok: w.credentials.every(c => c.params.every(p => p.description)) },
        { label: 'Required keys marked (vgi_required)', ok: w.credentials.some(c => c.params.some(p => p.required)) },
        { label: 'Credentials link (vgi_doc_url)', ok: w.credentials.every(c => c.docUrl) },
      ]
    : []),
];
const hasCredentials = w.credentials.length > 0;
const secretList = w.credentials.map(c => c.type);

const runsOn: { label: string; icon: string }[] = [
  // One row per OS: Linux's two architectures share a line ("Linux x86-64 · ARM64").
  ...Object.values(
    w.platforms
      .filter(p => p !== 'wasm')
      .sort(platformOrder)
      .reduce<Record<string, { label: string; icon: string }>>((rows, p) => {
        const icon = platformIcon(p);
        const label = platformLabel(p);
        const os = label.split(' ')[0];
        rows[icon] = rows[icon] ? { icon, label: `${rows[icon].label} · ${label.slice(os.length + 1)}` } : { icon, label };
        return rows;
      }, {}),
  ),
  ...(w.language === 'Python' ? [{ label: 'Any OS (uv)', icon: 'simple-icons:python' }] : []),
  ...(w.language === 'Java' ? [{ label: 'Any OS (Java 21+)', icon: 'simple-icons:openjdk' }] : []),
];

const facts: [string, string][] = [
  ['Catalog', w.catalog],
  ['Language', w.language],
  ...(w.builtOn.length ? [['Built on', w.builtOn.join(', ')] as [string, string]] : []),
  ...(w.release ? [['Release', w.release.tag] as [string, string]] : []),
  ...(w.license ? [['Licence', w.license] as [string, string]] : []),
  ...(w.verification?.verified
    ? [[
        'Verified',
        `${w.verification.checked_at ? new Date(w.verification.checked_at).toISOString().slice(0, 10) + ' — ' : ''}${w.verification.passed ?? 0}/${(w.verification.total ?? 0) - (w.verification.needs_credentials ?? 0)} examples pass${w.verification.needs_credentials ? ` (${w.verification.needs_credentials} more need credentials)` : ''} via ${w.verification.transport ?? 'attach'}${w.verification.environment?.haybarn_version ? ` on Haybarn ${w.verification.environment.haybarn_version}` : ''}`,
      ] as [string, string]]
    : []),
  ['Cost', w.offering.pricing === 'open' ? 'Free and open source — you run it yourself' : 'Paid'],
  ...(w.facets.needsCredentials
    ? [['Credentials', w.facets.secretTypes.length ? `Uses a DuckDB secret of type ${w.facets.secretTypes.join(' or ')}` : 'Needs credentials at ATTACH'] as [string, string]]
    : []),
];

// "Runs on" sits where it always did: after the release/licence facts, before Verified/Cost.
const runsOnAt = facts.findIndex(([k]) => k === 'Verified' || k === 'Cost');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: w.name,
    alternateName: w.repo,
    description: w.blurb,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url,
    codeRepository: w.repo_url,
    softwareVersion: w.release?.tag,
    license: w.license ?? undefined,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE },
  },
];
const H2 = 'text-2xl text-soil-900';
---

<PageLayout title={`${w.name} — ${w.displayTitle} | Orchard`} description={w.blurb} ogImage="/og/orchard.jpg" jsonLd={jsonLd}>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Connectors', href: '/products/orchard/connectors' },
      { name: w.name, href: `/products/orchard/connectors/${w.slug}` },
    ]}
    trail={[
      ...(cat ? [{ name: cat.name, href: `/products/orchard/connectors/category/${cat.id}` }] : []),
      { name: w.name, href: `/products/orchard/connectors/${w.slug}` },
    ]}
  />

  <PageHead variant="section" eyebrow={cat ? cat.name : 'Connectors'} lede={w.blurb} hairband>
    <span slot="title">{w.name}</span>
    <span slot="icon" class={`flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 ${w.tint.tile} ${w.tint.ink}`} aria-hidden="true">
      <Icon name={cat?.icon ?? 'ph:cube'} class="h-7 w-7" />
    </span>
    <div slot="badges" class="mt-3 flex flex-wrap items-center gap-1.5">
      {w.release && <span class="inline-flex items-center rounded-full border border-soil-300 bg-soil-100/70 px-2.5 py-0.5 font-mono text-[12px] text-soil-700">{w.release.tag}</span>}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href="#quick-start" variant="primary" size="md">Quick start</Button>
      <Button href="#catalog" variant="secondary" size="md">Explore the catalog</Button>
    </div>
  </PageHead>

  <div class="mx-auto w-full max-w-[1200px] px-6 py-10 sm:px-7 lg:grid lg:grid-cols-[1fr_18rem] lg:gap-10">
    <div class="min-w-0">
      <!-- Overview -->
      {(w.summary || docHtml) && (
        <section>
          <h2 class={H2}>Overview</h2>
          {w.summary && w.summary !== w.blurb && <p class="mt-3 text-[17px] leading-relaxed text-soil-700">{w.summary}</p>}
          {docHtml && <div class="prose mt-3 max-w-none text-[15.5px] prose-headings:text-soil-900 prose-p:text-soil-700 prose-li:text-soil-700 prose-a:text-link prose-strong:text-soil-900 prose-code:text-soil-900 prose-code:bg-soil-100 prose-code:font-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[14px] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-pre:bg-rock-900 prose-pre:text-[#e9e1d3]" set:html={docHtml} />}
        </section>
      )}

      <!-- Quick start -->
      <section id="quick-start" class="mt-12 scroll-mt-32">
        <h2 class={H2}>Quick start</h2>
        <p class="mt-2 text-soil-700">
          The worker runs locally as a subprocess of DuckDB or <a href={HAYBARN_HREF} class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">Haybarn</a> — there's nothing to sign up for with Query.Farm.
          {hasCredentials && <>It calls an outside service, so some functions need your own credentials — see <a href="#credentials" class="text-link underline decoration-link/40 underline-offset-2">step 3</a>.</>}
        </p>
        <h3 class="mt-6 text-[17px] font-semibold text-soil-900">1. Install the vgi extension</h3>
        <p class="mt-1 text-[15px] text-soil-700">
          Once per machine. On DuckDB, keep <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[14px] text-soil-900">FROM query_farm</code> on
          the <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[14px] text-soil-900">LOAD</code> in later sessions.
        </p>
        <div class="mt-3">
          <CodeTabs
            tabs={[
              { id: 'duckdb', label: 'DuckDB 2.0', icon: 'simple-icons:duckdb', lang: 'sql', title: 'setup.sql', code: VGI_SETUP.duckdb },
              { id: 'haybarn', label: 'Haybarn', icon: 'ph:barn', lang: 'sql', title: 'setup.sql', code: VGI_SETUP.haybarn },
            ]}
            group="orchard-engine"
            ariaLabel="Choose your engine"
          />
        </div>
        <h3 class="mt-7 text-[17px] font-semibold text-soil-900">2. Attach the worker</h3>
        <p class="mt-1 text-[15px] text-soil-700">Pick how you want to run it.</p>
        <div class="mt-3">
          {installTabs.length > 0 ? (
            <CodeTabs tabs={installTabs} group="orchard-install" ariaLabel="Choose how to run the worker" />
          ) : (
            <CodeBlock code={w.attachSql} lang="sql" title="attach.sql" tryable={false} />
          )}
        </div>
        {hasCredentials && (
          <>
            <h3 class="mt-7 text-[17px] font-semibold text-soil-900">3. Add your credentials</h3>
            <p class="mt-1 text-[15px] text-soil-700">
              Create a DuckDB secret of type {secretList.map((t, i) => <>{i > 0 && (i === secretList.length - 1 ? ' or ' : ', ')}<a href={`#secret-${t}`} class="font-mono text-link underline decoration-link/40 underline-offset-2">{t}</a></>)} — the keys and a ready-to-fill
              <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[14px] text-soil-900">CREATE SECRET</code> are under <a href="#credentials" class="text-link underline decoration-link/40 underline-offset-2">Credentials</a>.
            </p>
          </>
        )}
        {w.attach_options.length > 0 && (
          <div class="mt-5 rounded-xl border border-soil-300 bg-[#fffdf7] p-4">
            <h3 class="text-[15px] font-semibold text-soil-900">ATTACH options</h3>
            <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
              {w.attach_options.map(o => (
                <>
                  <dt class="font-mono text-soil-900">{o.name}{o.required && <span class="ml-1 text-[11px] font-sans text-sun-700">required</span>}</dt>
                  <dd class="text-soil-700">{o.description}{o.type && <span class="ml-1 font-mono text-[12px] text-soil-500">{o.type}</span>}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
      </section>

      <!-- Catalog explorer -->
      <section id="catalog" class="mt-12 scroll-mt-32">
        <h2 class={H2}>Catalog</h2>
        <p class="mt-2 text-soil-700">
          Everything <code class="font-mono">{w.catalog}</code> exposes once attached — read straight from the worker's
          released build.
        </p>
        <div class="mt-5">
          <CatalogExplorer worker={w} />
        </div>
      </section>

      <!-- Credentials -->
      {hasCredentials && (
        <section id="credentials" class="mt-12 scroll-mt-32">
          <h2 class={H2}>Credentials</h2>
          <p class="mt-2 text-soil-700">
            {w.credentials.length === 1 ? 'The secret type' : `The ${w.credentials.length} secret types`} <code class="font-mono">{w.catalog}</code> declares, as reported by the worker itself.
          </p>
          <div class="mt-5">
            <WorkerCredentials credentials={w.credentials} catalog={w.catalog} />
          </div>
        </section>
      )}

      <!-- Examples -->
      {examples.length > 0 && (
        <section id="examples" class="mt-12 scroll-mt-32">
          <h2 class={H2}>Try these queries</h2>
          <div class="mt-4 flex flex-col gap-4">
            {[exampleList.slice(0, EXAMPLES_SHOWN), exampleList.slice(EXAMPLES_SHOWN)].map((list, i) =>
              list.length === 0 ? null : i === 0 ? (
                list.map(e => (
                  <div>
                    {(e.title || e.description) && (
                      <p class="mb-1.5 text-sm text-soil-700">
                        {e.title && <strong class="font-semibold text-soil-900">{e.title}</strong>}
                        {e.title && e.description && ' — '}
                        {e.description}
                      </p>
                    )}
                    <CodeBlock code={formatExampleSql(e.sql)} lang="sql" tryable={false} />
                    {e.uses.length > 0 && (
                      <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[12.5px] text-soil-500">
                        Uses
                        {e.uses.map(u => <a href={`#${u.anchor}`} class="rounded-md border border-soil-300 bg-soil-100/60 px-1.5 py-0.5 font-mono text-[12px] text-link hover:border-sun-400">{u.name}</a>)}
                      </p>
                    )}
                  </div>
                ))
              ) : (
                <details class="group">
                  <summary class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-soil-300 bg-[#fffdf7] px-3 py-1.5 text-sm font-medium text-soil-800 hover:border-sun-400">
                    <span class="group-open:hidden">Show all {exampleList.length} examples</span>
                    <span class="hidden group-open:inline">Hide {list.length} more</span>
                  </summary>
                  <div class="mt-4 flex flex-col gap-4">
                    {list.map(e => (
                      <div>
                        {(e.title || e.description) && (
                          <p class="mb-1.5 text-sm text-soil-700">
                            {e.title && <strong class="font-semibold text-soil-900">{e.title}</strong>}
                            {e.title && e.description && ' — '}
                            {e.description}
                          </p>
                        )}
                        <CodeBlock code={formatExampleSql(e.sql)} lang="sql" tryable={false} />
                        {e.uses.length > 0 && (
                          <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[12.5px] text-soil-500">
                            Uses
                            {e.uses.map(u => <a href={`#${u.anchor}`} class="rounded-md border border-soil-300 bg-soil-100/60 px-1.5 py-0.5 font-mono text-[12px] text-link hover:border-sun-400">{u.name}</a>)}
                          </p>
                        )}
                      </div>
                    ))}
                  </div>
                </details>
              ),
            )}
          </div>
        </section>
      )}

      <!-- Agent tasks -->
      {w.agent_tasks.length > 0 && (
        <section id="ask" class="mt-12 scroll-mt-32">
          <h2 class={H2}>Questions it can answer</h2>
          <p class="mt-2 text-soil-700">The worker ships these as agent test tasks — plain-English questions an AI agent should be able to answer with SQL against this catalog.</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {w.agent_tasks.slice(0, 10).map(t => (
              <li class="rounded-lg border border-soil-300 bg-[#fffdf7] px-4 py-3 text-sm leading-relaxed text-soil-800">“{t}”</li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="mt-12 lg:mt-0">
      <div class="flex flex-col gap-4 lg:sticky lg:top-28">
        <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
          <h2 class="text-[15px] font-semibold text-soil-900">At a glance</h2>
          <dl class="mt-3 flex flex-col gap-2 text-sm">
            {facts.slice(0, runsOnAt).map(([k, v]) => (
              <div>
                <dt class="text-[12px] font-semibold text-soil-500">{k}</dt>
                <dd class="text-soil-800">{v}</dd>
              </div>
            ))}
            <div>
              <dt class="text-[12px] font-semibold text-soil-500">Runs on</dt>
              <dd class="text-soil-800">
                {runsOn.length ? (
                  <ul class="mt-1 flex flex-col gap-1">
                    {runsOn.map(r => (
                      <li class="flex items-center gap-2">
                        <Icon name={r.icon} class="h-4 w-4 flex-none text-cat-field-ink" aria-hidden="true" />
                        {r.label}
                      </li>
                    ))}
                  </ul>
                ) : '—'}
              </dd>
            </div>
            {facts.slice(runsOnAt).map(([k, v]) => (
              <div>
                <dt class="text-[12px] font-semibold text-soil-500">{k}</dt>
                <dd class="text-soil-800" set:html={linkHaybarn(v)} />
              </div>
            ))}
          </dl>
          {hasCredentials && (
            <a href="#credentials" class="mt-3 inline-flex items-center gap-1.5 text-sm text-link underline decoration-link/40 underline-offset-2">
              <Icon name="ph:key" class="h-4 w-4" aria-hidden="true" />Credentials setup
            </a>
          )}
          <div class="mt-4 flex flex-col gap-1.5 border-t border-soil-200 pt-3 text-sm">
            <a href={w.repo_url} class="text-link underline decoration-link/40 underline-offset-2">Source on GitHub</a>
            <span class="font-mono text-[12.5px] text-soil-600">{w.repo_url.replace('https://github.com/', '')}</span>
          </div>
        </div>

        <details class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
          <summary class="cursor-pointer text-[15px] font-semibold text-soil-900">For worker authors</summary>
          <p class="mt-2 text-[13px] leading-relaxed text-soil-700">This page is generated from the metadata the worker declares in its catalog. What it found:</p>
          <ul class="mt-2 flex flex-col gap-1 text-[13px]">
            {coverage.map(c => (
              <li class="flex items-center gap-2">
                <Icon name={c.ok ? 'ph:check-circle-fill' : 'ph:circle-dashed'} class:list={['h-4 w-4 flex-none', c.ok ? 'text-field-600' : 'text-soil-400']} aria-hidden="true" />
                <span class={c.ok ? 'text-soil-800' : 'text-soil-500'}>{c.label}</span>
              </li>
            ))}
          </ul>
          <a href="/vgi/docs/" class="mt-3 inline-block text-[13px] text-link underline decoration-link/40 underline-offset-2">Metadata tags reference →</a>
        </details>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="border-t border-soil-300 bg-soil-100 py-12">
      <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
        <h2 class={H2}>Related workers</h2>
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map(r => <WorkerCard worker={r} />)}
        </div>
      </div>
    </section>
  )}
</PageLayout>
