---
import PageLayout from '../../../../layouts/PageLayout.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import SectionHeader from '../../../../components/ui/SectionHeader.astro';
import Button from '../../../../components/ui/Button.astro';
import Card from '../../../../components/ui/Card.astro';
import CodeBlock from '../../../../components/ui/CodeBlock.astro';
import ConnectorCard from '../../../../components/products/ConnectorCard.astro';
import { connectors, getConnector, pricingLabel, statusLabel } from '../../../../data/connectors';

export function getStaticPaths() {
  return connectors.map((c) => ({ params: { slug: c.id }, props: { id: c.id } }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const connector = getConnector(id);
if (!connector) return Astro.redirect('/products/orchard');
const c = connector;

const related = connectors.filter((x) => x.id !== c.id).slice(0, 3);

const offerKindLabel: Record<string, string> = {
  table: 'Table',
  function: 'Function',
  macro: 'Macro',
  secret: 'Secret',
};
const offerKindClass: Record<string, string> = {
  table: 'bg-sky-100 text-sky-800',
  function: 'bg-harvest-100 text-harvest-800',
  macro: 'bg-violet-100 text-violet-800',
  secret: 'bg-rose-100 text-rose-800',
};

const subscribeCtaLabel = c.pricing === 'free' ? 'Attach for free' : c.pricing === 'enterprise' ? 'Contact sales' : 'Subscribe';

const SITE_ORIGIN = 'https://query.farm';
const pageUrl = `${SITE_ORIGIN}/products/orchard/connectors/${c.id}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `${c.name} connector`,
    description: c.summary,
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'VGI connector',
    operatingSystem: 'Linux, macOS, Windows',
    publisher: { '@type': 'Organization', name: c.provider, url: SITE_ORIGIN },
    offers: {
      '@type': 'Offer',
      price: c.pricing === 'free' ? '0' : undefined,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Orchard', item: SITE_ORIGIN + '/products/orchard' },
      { '@type': 'ListItem', position: 4, name: c.name, item: pageUrl },
    ],
  },
];
---

<PageLayout
  title={`${c.name} — Orchard Connector`}
  description={c.summary}
  jsonLd={jsonLd}
>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: c.name, href: pageUrl },
    ]}
  />

  <!-- Prototype banner -->
  <div class="bg-amber-100 border-b border-amber-300">
    <div class="section-container py-2 text-center text-xs font-semibold text-amber-900">
      🌱 Orchard is an early preview — connector details below are illustrative while we iterate.
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-emerald-50 via-white to-white py-12 lg:py-16 border-b border-soil-200">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 lg:items-center">
        <div>
          <div class="flex items-center gap-4">
            <div class={`flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border-2 border-soil-900 text-4xl shadow-sm ${c.theme.iconBg}`}>
              {c.icon}
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">{c.category}</p>
              <h1 class="text-3xl md:text-4xl font-extrabold text-soil-900">{c.name}</h1>
            </div>
          </div>
          <p class="mt-5 max-w-2xl text-lg text-soil-700 leading-relaxed">{c.summary}</p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-semibold text-soil-700">{statusLabel[c.status]}</span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-semibold text-soil-700">{pricingLabel[c.pricing]}</span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-semibold text-soil-700">By {c.provider}</span>
            <span class="rounded-full border border-soil-300 bg-white px-3 py-1 text-xs font-semibold text-soil-700">{c.language} worker</span>
          </div>
        </div>

        <Card padding="lg" class="border-2 border-soil-900 shadow-sm min-w-[16rem]">
          <p class="text-xs font-semibold uppercase tracking-wider text-soil-500">Pricing</p>
          <p class="mt-1 text-3xl font-extrabold text-soil-900">{c.priceNote}</p>
          <p class="mt-1 text-sm text-soil-600">{pricingLabel[c.pricing]} plan</p>
          <Button href="/products/orchard/subscribe" variant="accent" size="md" class="mt-5 w-full justify-center">
            {subscribeCtaLabel}
          </Button>
          <a href="/products/orchard" class="mt-3 block text-center text-sm font-medium text-harvest-700 hover:text-harvest-800">
            ← Back to the Orchard
          </a>
        </Card>
      </div>
    </div>
  </section>

  <!-- Overview + example -->
  <section class="py-16 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-14 items-start max-w-6xl mx-auto">
        <div>
          <SectionHeader eyebrow="Overview" title={`What ${c.name} does`} />
          <div class="mt-6 space-y-4">
            {c.description.map((p) => (
              <p class="text-soil-700 leading-relaxed">{p}</p>
            ))}
          </div>

          <h3 class="mt-10 text-lg font-bold text-soil-900">Highlights</h3>
          <ul class="mt-4 space-y-3">
            {c.features.map((f) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-harvest-100 text-harvest-700">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-soil-700 leading-relaxed">{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:sticky lg:top-24">
          <h3 class="text-sm font-bold uppercase tracking-wider text-harvest-700 mb-3">Attach &amp; query</h3>
          <CodeBlock code={c.exampleSql} lang="sql" title={`${c.id}.sql`} tryable={false} />
          <p class="mt-3 text-xs text-soil-500">
            Requires the <a href="/vgi" class="underline underline-offset-2 hover:text-harvest-700">VGI</a> extension. Set <code class="font-mono">ORCHARD_TOKEN</code> after subscribing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What it offers -->
  <section class="py-16 bg-soil-50">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader
          eyebrow="What you get"
          title="Tables &amp; functions it exposes"
          description="Once attached, the connector adds these objects to your SQL session."
          class="mb-10"
        />
        <div class="overflow-hidden rounded-xl border border-soil-200 bg-white shadow-sm divide-y divide-soil-100">
          {c.offers.map((o) => (
            <div class="flex items-start gap-4 p-4 md:p-5">
              <span class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-bold ${offerKindClass[o.kind]}`}>
                {offerKindLabel[o.kind]}
              </span>
              <div class="min-w-0">
                <code class="text-sm font-mono font-semibold text-soil-900 break-words">{o.name}</code>
                <p class="mt-1 text-sm text-soil-600 leading-relaxed">{o.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 bg-white">
    <div class="section-container">
      <div class="max-w-5xl mx-auto">
        <SectionHeader eyebrow="Use cases" title={`What teams build with ${c.name}`} class="mb-10" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {c.useCases.map((u) => (
            <Card padding="lg" class="border-2 border-soil-900 shadow-sm">
              <p class="text-soil-800 font-semibold leading-relaxed">{u}</p>
            </Card>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-16 bg-soil-50 border-t border-soil-200">
    <div class="section-container">
      <SectionHeader eyebrow="Keep exploring" title="Other connectors" class="mb-10" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {related.map((r) => (
          <ConnectorCard connector={r} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-emerald-600 to-harvest-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to attach {c.name}?</h2>
      <p class="text-lg md:text-xl text-emerald-50 mb-8 max-w-2xl mx-auto">
        Subscribe in minutes, or talk to us about a custom connector for your stack.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/products/orchard/subscribe" variant="secondary" size="lg">{subscribeCtaLabel}</Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Talk with Us
        </Button>
      </div>
    </div>
  </section>

  <!-- Record this visit for the "Recently viewed" list in the Products nav. -->
  <script is:inline define:vars={{ connId: c.id, connName: c.name }}>
    try {
      const key = 'qf:recentConnectors';
      const prev = JSON.parse(localStorage.getItem(key) || '[]').filter((e) => e && e.id !== connId);
      prev.unshift({ id: connId, name: connName });
      localStorage.setItem(key, JSON.stringify(prev.slice(0, 8)));
    } catch (e) { /* ignore storage errors */ }
  </script>
</PageLayout>
