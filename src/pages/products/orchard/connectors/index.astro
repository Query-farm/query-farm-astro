---
import { linkHaybarn } from '../../../../lib/haybarn-link';
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHead from '../../../../components/ui/PageHead.astro';
import Button from '../../../../components/ui/Button.astro';
import OrchardSubNav from '../../../../components/sections/OrchardSubNav.astro';
import WorkerDirectory from '../../../../components/orchard/WorkerDirectory.astro';
import OpenWorkersSlab from '../../../../components/orchard/OpenWorkersSlab.astro';
import { workers } from '../../../../data/vgi-workers';

const objectCount = workers.reduce((n, w) => n + w.objects.length, 0);
const SITE = 'https://query.farm';
const description = `Orchard connectors: ${workers.length} verified VGI connectors that bring services, file formats, models and libraries into DuckDB and Haybarn as SQL catalogs. Search every table, function and column.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Orchard — DuckDB connectors',
    description,
    url: `${SITE}/products/orchard/connectors`,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: workers.length,
      itemListElement: workers.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.name, url: `${SITE}/products/orchard/connectors/${w.slug}` })),
    },
  },
];

const personas = [
  {
    eyebrow: 'SQL analysts',
    title: 'One ATTACH, then SQL',
    body: 'Every connector page gives you a verified download, the exact ATTACH statement and starter queries to paste.',
    icon: 'ph:terminal-window',
  },
  {
    eyebrow: 'Data users',
    title: 'Find data by what it is',
    body: 'Search by domain, dataset, column or function name and see the whole catalog before you install anything.',
    icon: 'ph:magnifying-glass',
  },
  {
    eyebrow: 'Worker authors',
    title: 'Your catalog is your listing',
    body: 'Built a VGI worker? Its listing is generated from the metadata it declares — titles, docs, examples and agent tasks.',
    icon: 'ph:hammer',
    href: '/products/orchard/submit',
  },
];
---

<PageLayout title="DuckDB Connectors — Orchard" description={description} ogImage="/og/orchard.jpg" jsonLd={jsonLd}>
  <OrchardSubNav
    breadcrumbs={[
      { name: 'Products', href: '/products' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Connectors', href: '/products/orchard/connectors' },
    ]}
  />

  <PageHead
    variant="section"
    eyebrow="Connectors"
    title="Connect DuckDB to services, formats and libraries."
    hairband
  >
    <Fragment slot="lede" set:html={linkHaybarn('Each connector is a VGI worker that turns a service, a file format, a model or a library into a SQL catalog. Find one, ATTACH it from DuckDB or Haybarn with a single line, and query it. Every connector here is verified before it is listed, and more are added all the time.')} />
    <span slot="icon" class="flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-3xl leading-none" aria-hidden="true">🌱</span>
    <Fragment slot="aside">
      <div class="flex gap-8">
        <div>
          <div class="qf-figure text-4xl leading-none text-sun-700">{workers.length}</div>
          <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Connectors</div>
        </div>
        <div>
          <div class="qf-figure text-4xl leading-none text-sun-700">{objectCount.toLocaleString('en-US')}</div>
          <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Tables &amp; functions</div>
        </div>
      </div>
    </Fragment>
  </PageHead>

  <section id="directory" class="scroll-mt-32 border-y border-soil-300 bg-soil-100 py-12 lg:py-14">
    <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
      <WorkerDirectory workers={workers} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
      <div class="grid gap-3.5 md:grid-cols-3">
        {personas.map(p => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
            <span class="qf-eyebrow text-sun-700">{p.eyebrow}</span>
            <h2 class="mt-2 text-lg text-soil-900">{p.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-soil-700">{p.body}</p>
            {p.href && <a href={p.href} class="mt-2 inline-block text-sm text-link underline decoration-link/40 underline-offset-2">How listing works →</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <OpenWorkersSlab />

  <section class="py-14">
    <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
      <div class="flex flex-wrap items-center justify-between gap-6 rounded-xl border border-soil-300 bg-[#fffdf7] px-8 py-8">
        <div class="max-w-[56ch]">
          <h2 class="text-2xl text-soil-900">Need a connector that isn't here yet?</h2>
          <p class="mt-2 text-[17px] leading-relaxed text-soil-700">
            We build VGI connectors for the systems your team depends on — and can publish them on the Orchard for you.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Commission a connector</Button>
          <Button href="/products/orchard/connectors/catalog.json" variant="secondary" size="md">catalog.json</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
