---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import HaybarnSubNav from '../../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import ExampleShellMounter from '../../../components/repl/ExampleShellMounter.tsx';
import HaybarnInstall from '../../../components/sections/HaybarnInstall.astro';
import { LATEST_STATUS_URL, LATEST_RC, LATEST_DUCKDB_VERSION } from '../../../data/haybarn-versions';

const HAYBARN_RC = LATEST_RC;
const HAYBARN_REPO = 'https://github.com/Query-farm-haybarn/haybarn';

const SITE_ORIGIN = 'https://query.farm';
const haybarnDescription = 'Haybarn is a DuckDB distribution for everyone: same SQL and database files, with signed releases, rebuilt extensions, engine improvements, package channels, and supply-chain review built in.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Haybarn',
    description: haybarnDescription,
    url: `${SITE_ORIGIN}/products/haybarn`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Distribution',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['SQL', 'Python', 'TypeScript', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: HAYBARN_REPO,
    softwareVersion: HAYBARN_RC,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Haybarn', item: SITE_ORIGIN + '/products/haybarn' },
    ],
  },
];

// ── Shared shape vocabulary (brief §10: port qf.css shapes as utilities) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';

// One sample, two audiences: it pastes into the CLI installed above, and the
// REPL island runs it verbatim. The INSTALL/LOAD lines stay in — a CLI user
// needs them, and in the shell they are a no-op because the mounter has already
// installed a5 from Haybarn's community channel.
const demoSql = `INSTALL a5 FROM community;
LOAD a5;

SELECT version()                                   AS engine,
       a5_lonlat_to_cell(-122.4194, 37.7749, 10)   AS san_francisco;`;

const guarantees = [
  ['Drop-in compatibility', 'Same SQL, same APIs, same database files, same extension names. Adopting the distribution is not a migration.'],
  ['Verified artifacts', 'Engine and extensions carry checksums, a detached GPG signature, and SLSA build provenance — checkable before anything runs.'],
  ['Concrete install paths', 'npm, PyPI, crates.io, Maven Central, and GitHub Releases. Pick the channel you already use.'],
  ['Safer defaults', 'The default catalog is the set DuckDB CI builds, minus third-party vendor code. Nothing autoloads that you did not ask for.'],
];

// Four reasons to switch, one sentence each. This is the landing page: it makes
// the claim and names the one number that makes it credible. The evidence — the
// benchmarks, the settings, what upstream does instead — lives on
// /products/haybarn/differences, which every card links into. Resist growing this list;
// the first version enumerated all nine changes and read like a changelog.
const reasons: [string, string, string][] = [
  [
    'Remote data arrives faster',
    'Parallel range reads share one HTTP/2 connection instead of opening one each, and a file that changes mid-read costs you nothing instead of a wasted 16 MiB.',
    '#faster',
  ],
  [
    'Installs stop drifting',
    'Pin an extension version and the engine actually remembers it — or declare it in your lockfile and load it with no network at all.',
    '#reproducible',
  ],
  [
    'Your tools connect',
    'Power BI, DBeaver, Grafana and anything else speaking the PostgreSQL wire protocol connect and introspect instead of failing on a broken catalog join.',
    '#clients',
  ],
  [
    'It works in the browser',
    'Wasm extensions survive their first exception rather than dying on it, and can run a real sign-in flow from inside a Worker.',
    '#browser',
  ],
];

const sameness = [
  ['Same SQL', 'Queries behave exactly as they do on DuckDB.'],
  ['Same files', `.duckdb files stay compatible with DuckDB v${LATEST_DUCKDB_VERSION}.`],
  ['Same extension commands', 'INSTALL and LOAD keep the familiar shape.'],
  ['One-line Python path', 'import haybarn as duckdb, once the library package is live.'],
];

const extensionFacts = [
  ['Same names', 'Familiar INSTALL and LOAD commands, resolved from the Haybarn channel.'],
  ['Core included', 'Common capabilities ship built and signed with the engine.'],
  ['Community rebuilt', 'The community catalog is rebuilt against the Haybarn engine and re-signed.'],
];

const stats: [string, string][] = [
  [`v${HAYBARN_RC}`, 'Current release candidate'],
  [`v${LATEST_DUCKDB_VERSION}`, 'DuckDB version tracked'],
  ['12', 'Build platforms per extension'],
  ['3', 'Distribution channels'],
];
---

<PageLayout
  title="Haybarn — a DuckDB distribution for everyone"
  description={haybarnDescription}
  ogImage="/og/haybarn.jpg"
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="DuckDB distribution"
    title="A DuckDB Distribution for Everyone."
    icon={{ src: '/haybarn/haybarn-mark.svg' }}
    lede="Same SQL, same database files, same extension names — with signed builds, rebuilt extensions, and a faster object-store client on top. Free to use on a laptop, and reviewable enough to put in production."
    hairband
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/products/haybarn/install" variant="primary" size="md">Install Haybarn</Button>
      {/* The differences page is no longer a subnav tab (the row was overflowing),
          so the overview carries it: here, in the section nav on every docs page,
          and in the "full inventory" callout below. */}
      <Button href="/products/haybarn/differences" variant="secondary" size="md">What's different</Button>
      <Button href={HAYBARN_REPO} variant="secondary" size="md" external>GitHub ↗</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">v{HAYBARN_RC}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Release candidate</div>
    </Fragment>
  </PageHead>

  <!-- ── What you get ────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>What you get</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Four guarantees</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2">
        {guarantees.map(([title, body], i) => (
          <div class={`${CARD} p-6 transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
            {/* Index numeral + hairline. Figures are tabular Commissioner via
                .qf-figure, never Fraunces (DESIGN_BRIEF §2), and sun-700 is the
                only gold that may carry text on a light ground (§3). */}
            <div class="flex items-center gap-3">
              <span class="qf-figure text-[15px] font-semibold leading-none tracking-[0.04em] text-sun-700">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="h-px flex-1 bg-soil-200"></span>
            </div>
            <h3 class="mt-4 text-xl text-soil-900">{title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The one dark slab: install / the key moment ──────────── -->
  <section class="bg-pipe-6 py-16 text-cream">
    <div class={WRAP}>
      <span class="qf-eyebrow text-sun-400">Get it</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-cream">Install it, then it's deterministic</h2>
      <p class="mt-3 max-w-[62ch] text-[17.5px] leading-relaxed text-cream-2">
        Pick the client you already use. Every artifact below is checksummed, GPG-signed, and
        carries SLSA build provenance, and the CLI checks the signature before anything lands
        on disk.
      </p>

      <div class="mt-7">
        <HaybarnInstall />
      </div>

      <!-- ── Then the SQL — one block, two ways to run it ─────── -->
      <!-- This used to be two blocks: a static sample and a separate runnable
           one, which showed near-identical SQL and left the reader deciding
           which was the real one. It is now a single CodeBlock, which
           ExampleShellMounter (at the foot of this page) finds by its
           data-language="sql" and hangs a Try button under. Opening the shell
           boots @haybarn/haybarn-wasm and resolves a5 from Haybarn's own
           community channel — so the demo exercises the real signed
           distribution, and the same text pastes into the CLI above. -->
      <div class="mt-12">
        <span class="qf-eyebrow text-sun-400">Then</span>
        <h3 class="mt-2.5 text-2xl text-cream">The same SQL you already write</h3>
        <p class="mt-2.5 max-w-[64ch] text-[15px] leading-relaxed text-cream-2">
          Nothing here is Haybarn-specific.
          <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[0.88em] text-cream">a5</code>
          is an ordinary DuckDB community extension — Haybarn rebuilds it, signs it with the
          Haybarn key, and tracks its readiness for every release. Paste it into the CLI you
          just installed, or press <strong class="font-semibold text-cream">Try it in your
          browser</strong>: that boots the Haybarn engine compiled to WebAssembly, right in this
          tab, and resolves <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[0.88em] text-cream">a5</code>
          from the same signed channel the CLI uses.
        </p>
        <div class="mt-4">
          <CodeBlock code={demoSql} lang="sql" title="Haybarn shell" />
        </div>
      </div>

      <div class="mt-8 grid overflow-hidden rounded-xl border border-white/15 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map(([n, label], i) => (
          <div class:list={['px-5 py-5', i < stats.length - 1 && 'lg:border-r lg:border-white/12']}>
            <div class="qf-figure text-[34px] leading-none text-sun-400">{n}</div>
            <div class="mt-2 text-[12.5px] font-medium text-cream-2">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why Haybarn ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Why switch</span>
      <h2 class="mt-3 max-w-[20ch] text-3xl md:text-4xl text-soil-900">Nothing changes in your SQL. Four things stop being your problem.</h2>
      <p class={`mt-4 max-w-[62ch] ${LEDE}`}>
        Haybarn is the same engine, so switching costs you nothing. What you get back are the
        rough edges around it, already filed off.
      </p>

      <div class="mt-9 grid gap-3.5 md:grid-cols-2">
        {reasons.map(([title, body, anchor]) => (
          <a
            href={`/products/haybarn/differences${anchor}`}
            class={`${CARD} group flex h-full flex-col p-7 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}
          >
            <h3 class="text-2xl leading-snug text-soil-900 group-hover:text-link">{title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-soil-700">{body}</p>
            {/* mt-auto pins the affordance to the card floor so it lines up
                across a row of uneven-length claims. */}
            <span class="mt-auto pt-4 text-[13px] font-medium text-sun-700">How it works &rarr;</span>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href="/products/haybarn/differences" variant="primary" size="md">See everything that's different</Button>
        <p class="text-sm leading-relaxed text-soil-700">
          Measurements, settings, and what upstream does instead.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Who decides ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16">
        <div>
          <span class={EYEBROW}>Who decides</span>
          <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Opinionated, on purpose</h2>
          <p class={`mt-4 ${LEDE}`}>
            Haybarn is built and controlled by Query.Farm, and that independence is the whole
            point. We can reach a different conclusion than the DuckDB project does, on our own
            timeline, when our experience and our clients' work tell us to.
          </p>
          <p class={`mt-4 ${LEDE}`}>
            Every change we ship started there. Moving object-store reads onto HTTP/2, widening
            the WebAssembly API surface until an extension could run a real sign-in, extending
            engine APIs so a pin actually holds — none of these are things upstream got wrong.
            They are places we had a firm opinion, someone depending on it, and the freedom to act.
          </p>
        </div>

        <div class={`${CARD} self-start p-7`}>
          <h3 class="text-xl text-soil-900">Which cuts both ways</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-soil-700">
            Some of this is judgement about where DuckDB workloads are heading, and judgement can
            be wrong. We would rather say that plainly than pretend every call is settled fact.
          </p>
          <p class="mt-3 text-[15px] leading-relaxed text-soil-700">
            When one of ours turns out badly, we change it. And where a change belongs to
            everyone we offer it upstream — when it lands, we drop our patch and carry one
            less thing.
          </p>
          <p class="mt-3 text-[15px] leading-relaxed text-soil-700">
            When it doesn't land, that is just as good an outcome. DuckDB answers to a far wider
            audience than we do, and a change that is right for the people running Haybarn does
            not need anyone else's agreement to be worth shipping. It stays here, and we maintain
            it. What you are choosing is a distribution with a point of view, and people who will
            keep exercising it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Compatibility ───────────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Drop-in where it matters</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Adopt the distribution without rewriting the work</h2>
      <div class="mt-8 grid gap-3.5 sm:grid-cols-2">
        {sameness.map(([title, body]) => (
          <div class={`${CARD} p-5`}>
            <h3 class="text-lg text-soil-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Extension readiness ─────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Signed extension ecosystem</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Extensions, ready to load</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Haybarn rebuilds DuckDB extensions, signs them, and tracks whether they are ready for
        each release. Nothing is claimed that isn't measured.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {extensionFacts.map(([title, body]) => (
          <div class={`${CARD} p-5`}>
            <h3 class="text-lg text-soil-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 rounded-r-lg border-l-[3px] border-sun-400 bg-[#fffdf7] px-5 py-4">
        <div class="text-[12.5px] font-medium text-sun-700">For production teams</div>
        <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
          The extension distribution is built for approval and repeatability: verifiable
          binaries, immutable hosted artifacts, published release status, and package paths
          that fit npm / PyPI-style dependency workflows.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href={LATEST_STATUS_URL} variant="primary" size="sm">Open status page</Button>
          <Button href="/products/haybarn/extensions" variant="secondary" size="sm">Extension packaging plan</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <section class="pb-16">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <h2 class="text-2xl md:text-3xl text-soil-900">Try it, or talk it through</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            Haybarn is MIT-licensed and free to use — start with one command above. If you're
            weighing it for a team, we'll walk through pinning, signing, internal mirrors, and
            the upgrade path — and tell you honestly if you don't need it yet.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/company/schedule" variant="primary" size="md">Schedule a call</Button>
          <Button href="/products/haybarn/security" variant="secondary" size="md">Read the security page</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Disclaimer ──────────────────────────────────────────── -->
  <section class="border-t border-soil-300 bg-soil-100 py-7">
    <div class={WRAP}>
      <p class="mx-auto max-w-4xl text-center text-xs leading-relaxed text-soil-700">
        Haybarn is not affiliated with, sponsored by, or endorsed by the DuckDB Foundation or
        DuckDB Labs. DuckDB is a trademark of the DuckDB Foundation. Haybarn is published by
        Query Farm LLC and distributed under the MIT License.
      </p>
    </div>
  </section>

  <!-- Wires the Try button onto the SQL block in the slab above. a5 installs
       once, engine-wide, from Haybarn's community channel. -->
  <ExampleShellMounter client:load extensionName="a5" installSource="community" fixtures={null} />
</PageLayout>
