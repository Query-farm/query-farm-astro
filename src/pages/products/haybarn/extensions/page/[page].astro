---
import Directory from '../../../../../components/haybarn-extensions/Directory.astro';
import { extensions } from '../../../../../data/haybarn-extensions';
import { pageCount } from '../../../../../data/haybarn-extensions/pagination.mjs';
export function getStaticPaths() {
  return Array.from({ length: pageCount(extensions.length) - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }));
}
interface Props { page: number; }
---
<Directory page={Astro.props.page} />
