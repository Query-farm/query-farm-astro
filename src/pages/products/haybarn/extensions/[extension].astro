---
import ExtensionPage from '../../../../components/haybarn-extensions/ExtensionPage.astro';
import { prototypes, extensions, type PrototypeName } from '../../../../data/haybarn-extensions';
export function getStaticPaths() {
  return Object.keys(prototypes).filter(name => extensions.some(extension => extension.name === name)).map(name => ({ params: { extension: name }, props: { name: name as PrototypeName } }));
}
interface Props { name: PrototypeName; }
---
<ExtensionPage name={Astro.props.name} />
