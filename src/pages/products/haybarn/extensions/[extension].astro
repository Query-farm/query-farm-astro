---
import ExtensionPage from '../../../../components/haybarn-extensions/ExtensionPage.astro';
import CommunityExtensionPage from '../../../../components/haybarn-extensions/CommunityExtensionPage.astro';
import { communityExtensions, referenceExtensions, type CommunityExtension, type PrototypeName } from '../../../../data/haybarn-extensions';
export function getStaticPaths() {
  return [
    ...referenceExtensions.map(({ name }) => ({ params: { extension: name }, props: { name: name as PrototypeName } })),
    ...communityExtensions.map(extension => ({ params: { extension: extension.name }, props: { extension } })),
  ];
}
interface Props { name?: PrototypeName; extension?: CommunityExtension; }
---
{Astro.props.name ? <ExtensionPage name={Astro.props.name} /> : <CommunityExtensionPage extension={Astro.props.extension!} />}
