---
import ExtensionPage from '../../../../components/haybarn-extensions/ExtensionPage.astro';
import { referenceExtensions, type PrototypeName } from '../../../../data/haybarn-extensions';
export function getStaticPaths() {
  return referenceExtensions.map(({ name }) => ({ params: { extension: name }, props: { name: name as PrototypeName } }));
}
interface Props { name: PrototypeName; }
---
<ExtensionPage name={Astro.props.name} />
