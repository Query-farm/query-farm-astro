---
import Directory from '../../../../../../../components/haybarn-extensions/Directory.astro';
import { categories, extensions } from '../../../../../../../data/haybarn-extensions';
import { pageCount } from '../../../../../../../data/haybarn-extensions/pagination.mjs';
export function getStaticPaths() {
  return categories.flatMap(category => {
    const count = extensions.filter(extension => extension.categories.includes(category.id)).length;
    return Array.from({ length: pageCount(count) - 1 }, (_, index) => ({
      params: { category: category.id, page: String(index + 2) },
      props: { category: category.id, page: index + 2 },
    }));
  });
}
interface Props { category: string; page: number; }
---
<Directory category={Astro.props.category} page={Astro.props.page} />
