---
import Layout from '@haybarn/layouts/Layout.astro';
import { defaultSnapshot, getFunction } from '@haybarn/lib/catalog';
import { functionJsonUrl, functionMarkdownUrl, indexJsonUrl } from '@haybarn/lib/agent-docs';
const example = getFunction(defaultSnapshot, 'list_transform')!;
const exampleJson = functionJsonUrl(defaultSnapshot, example);
---
<Layout title="Agent access" active="agents" wide>
  <div class="agent-heading"><h1>Agent access</h1><p>Fetch function signatures and examples as Markdown or JSON.</p><div class="hero-actions"><a href="/products/haybarn/functions/llms.txt" class="button primary">Start at llms.txt ↗</a><a href="/products/haybarn/functions/api/v1/releases.json" class="text-link">Open the release manifest →</a></div></div>
  <div class="agent-workflow"><a href="/products/haybarn/functions/api/v1/releases.json"><span>01</span><h2>Choose a release</h2><p>Find the Haybarn or DuckDB release you use.</p><code>releases.json →</code></a><a href={indexJsonUrl(defaultSnapshot)}><span>02</span><h2>Find a function</h2><p>Match a name, search its description, or look for accepted input and return types.</p><code>functions.json →</code></a><a href={exampleJson}><span>03</span><h2>Read its reference</h2><p>Get the signatures, descriptions, examples, and supported releases.</p><code>function.json →</code></a></div>
  <section class="agent-contract"><div><h2>API resources</h2><p>Fetch a function index, then follow its links to the references you need.</p><a href="/products/haybarn/functions/agents/index.md" class="text-link">Read the agent guide as Markdown ↗</a></div><div class="agent-resources"><a href="/products/haybarn/functions/llms.txt"><span>Discovery</span><code>/products/haybarn/functions/llms.txt</code><span>↗</span></a><a href="/products/haybarn/functions/api/v1/releases.json"><span>Snapshots & comparisons</span><code>/products/haybarn/functions/api/v1/releases.json</code><span>↗</span></a><a href={indexJsonUrl(defaultSnapshot)}><span>Names, descriptions & types</span><code>/{defaultSnapshot.id}/functions.json</code><span>↗</span></a><a href={functionMarkdownUrl(defaultSnapshot, example)}><span>Function reference</span><code>list_transform / index.md</code><span>↗</span></a><a href={exampleJson}><span>Structured function data</span><code>list_transform.json</code><span>↗</span></a><a href="/products/haybarn/functions/api/v1/function.schema.json"><span>Document contract</span><code>function.schema.json · v1</code><span>↗</span></a></div></section>
  <p class="catalog-source">Static resources use API schema version 1. Filter indexes in your client; there is no server-side query or SQL execution endpoint. <a href="/products/haybarn/functions/agents/index.md">Full contract</a></p>
</Layout>
