---
import Layout from '@haybarn/layouts/Layout.astro';
import UsageGuide from '@haybarn/components/UsageGuide.astro';
import InlineDescription from '@haybarn/components/InlineDescription.astro';
import { categories, defaultSnapshot, getFunctions, getFunction, functionUrl, catalogUrl } from '@haybarn/lib/catalog';
import { categoryGuides } from '@haybarn/data/category-guides';
import { usageFor } from '@haybarn/lib/usage-guides';
import { compareFunctionNames } from '@haybarn/lib/function-order';
import { referenceName } from '../../../../../../scripts/haybarn-functions/notation.mjs';
export function getStaticPaths() { return categories.map(category => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const guide = categoryGuides[category.id];
const functions = getFunctions(defaultSnapshot).filter(fn => fn.category === category.id).sort((a, b) => compareFunctionNames(a.name, b.name));
const choices = guide.choices.map(([name, reason]) => ({ fn: getFunction(defaultSnapshot, name)!, reason }));
const example = getFunction(defaultSnapshot, guide.example)!;
const usage = usageFor(defaultSnapshot, guide.example)!;
---
<Layout title={`${guide.title} | Haybarn`} description={guide.summary} active={category.id}>
  <div class="breadcrumbs"><a href="/products/haybarn/functions/">Functions</a><span>/</span><span>{category.name}</span></div>
  <div class="page-heading"><h1>{guide.title}</h1><p>{guide.summary}</p></div>
  <section class="doc-section"><h2>Choose a function</h2><p>{guide.approach}</p>
    <ul class="function-choices">{choices.map(({ fn, reason }) => <li><a href={functionUrl(defaultSnapshot, fn)}><code>{referenceName(fn.name)}</code></a><span>{reason}</span></li>)}</ul>
    <p>{guide.caution}</p>
  </section>
  <section class="doc-section" id="example"><h2>{usage.purpose}</h2><UsageGuide guide={usage} /><p><a class="text-link" href={functionUrl(defaultSnapshot, example)}>Full {referenceName(example.name)} reference →</a></p></section>
  <section class="doc-section"><h2>All {category.name.toLowerCase()} functions</h2>
    <p>{functions.length} functions in {defaultSnapshot.label}. <a class="text-link" data-category-catalog href={`${catalogUrl()}?category=${category.id}`}>Browse the filtered catalog →</a></p>
    <ul class="category-functions">{functions.map(fn => <li><a href={functionUrl(defaultSnapshot, fn)}><code>{referenceName(fn.name)}</code></a>{(usageFor(defaultSnapshot, fn.name)?.summary || fn.description) && <p><InlineDescription text={usageFor(defaultSnapshot, fn.name)?.summary || fn.description} /></p>}</li>)}</ul>
  </section>
</Layout>
<style>
  .function-choices, .category-functions { list-style: none; padding: 0; }
  .function-choices li { margin: 14px 0; display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; }
  .function-choices code, .category-functions code { overflow-wrap: anywhere; }
  .category-functions li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .category-functions p { margin: 5px 0 0; font-size: 14px; }
</style>
