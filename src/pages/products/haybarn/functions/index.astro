---
import Layout from '@haybarn/layouts/Layout.astro';
import Playground from '@haybarn/components/Playground.astro';
import { defaultSnapshot, categories, categoryInfo, categoryUrl, catalogUrl, functionUrl, getFunction } from '@haybarn/lib/catalog';
import { recipes } from '@haybarn/data/recipes';
const examples = [
  { id: 'transform-a-list', title: 'Transform a list' },
  { id: 'clean-text', title: 'Clean up text' },
  { id: 'bucket-dates', title: 'Group dates by month' },
  { id: 'read-json', title: 'Read a JSON field' },
].map(example => ({ ...recipes.find(recipe => recipe.id === example.id)!, ...example }));
---
<Layout title="Haybarn SQL functions" description="Search Haybarn functions, look up arguments, and run SQL examples in your browser." active="home" wide>
  <header class="home-intro">
    <h1>Haybarn SQL functions</h1>
    <p class="haybarn-introduction">Haybarn is <a href="/products/haybarn">Query.Farm’s open-source DuckDB distribution</a>. It keeps DuckDB’s SQL, database files, and familiar extension commands, with signed releases, rebuilt extensions, and engine improvements.</p>
    <form class="home-search" role="search" aria-label="Search function documentation" action={catalogUrl()} data-search-form>
      <label for="home-search-input">Search functions, arguments, and examples</label>
      <div class="home-search-field">
        <input id="home-search-input" name="q" type="search" placeholder="e.g. strftime or VARCHAR" autocomplete="off" spellcheck="false" />
        <button class="button primary" type="submit" aria-haspopup="dialog" aria-controls="haybarn-search">Search <span aria-hidden="true">↗</span></button>
      </div>
    </form>
    <div class="home-intro-links"><a class="text-link" href={catalogUrl()}>Browse all functions <span aria-hidden="true">→</span></a><a class="text-link" href="/products/haybarn/install">Install Haybarn <span aria-hidden="true">↗</span></a></div>
  </header>

  <section class="home-examples" aria-labelledby="examples-title">
    <div class="section-heading"><h2 id="examples-title">Try a query</h2><a class="text-link" href="/products/haybarn/playground/">Open playground <span aria-hidden="true">↗</span></a></div>
    <div class="example-workspace">
      <nav class="example-picker" aria-label="Choose an example" data-example-picker>
        {examples.map(example => {
          const category = categoryInfo(example.category);
          return <a id={`choose-${example.id}`} href={`#example-${example.id}`} class={category.color}>
            <span class="example-symbol" aria-hidden="true">{category.icon}</span>
            <span>{example.title}</span>
            <span class="example-arrow" aria-hidden="true">→</span>
          </a>;
        })}
      </nav>
      <div class="example-panels">
        {examples.map(example => <section id={`example-${example.id}`} class="example-panel" aria-labelledby={`choose-${example.id}`} data-example-panel>
          <Playground sql={example.sql} title={example.title} />
          <div class="example-reference"><span>Functions in this query</span>{example.functions.map(name => {
            const fn = getFunction(defaultSnapshot, name)!;
            return <a href={functionUrl(defaultSnapshot, fn)}><code>{name}()</code><span aria-hidden="true">↗</span></a>;
          })}</div>
        </section>)}
      </div>
    </div>
    <a class="text-link more-recipes" href="/products/haybarn/recipes/">More SQL recipes <span aria-hidden="true">→</span></a>
  </section>

  <section class="home-categories" aria-labelledby="category-title">
    <div class="section-heading"><h2 id="category-title">Browse by category</h2></div>
    <div class="home-category-list">{categories.map(category => <a class={`home-category ${category.color}`} href={categoryUrl(category.id)}>
      <span class="example-symbol" aria-hidden="true">{category.icon}</span>
      <div><h3>{category.name}</h3><p>{category.short}</p></div>
      <span aria-hidden="true">↗</span>
    </a>)}</div>
  </section>
</Layout>

<script>
  const picker = document.querySelector<HTMLElement>('[data-example-picker]')!;
  const tabs = [...picker.querySelectorAll<HTMLAnchorElement>('a')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-example-panel]')];
  // Without JavaScript, the links jump to four fully readable examples.
  picker.setAttribute('role', 'tablist');
  const layout = matchMedia('(max-width: 1000px)');
  const orient = () => picker.setAttribute('aria-orientation', layout.matches ? 'horizontal' : 'vertical');
  orient();
  layout.addEventListener('change', orient);
  tabs.forEach((tab, index) => {
    tab.setAttribute('role', 'tab');
    tab.setAttribute('aria-controls', panels[index].id);
    panels[index].setAttribute('role', 'tabpanel');
  });
  function select(index: number) {
    tabs.forEach((tab, i) => {
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
      panels[i].hidden = i !== index;
    });
  }
  function readHash() {
    select(Math.max(0, tabs.findIndex(tab => tab.hash === location.hash)));
  }
  function activate(index: number) {
    select(index);
    history.replaceState(null, '', tabs[index].hash);
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', event => { event.preventDefault(); activate(index); });
    tab.addEventListener('keydown', event => {
      let next: number;
      const forward = layout.matches ? 'ArrowRight' : 'ArrowDown';
      const backward = layout.matches ? 'ArrowLeft' : 'ArrowUp';
      if (event.key === forward) next = (index + 1) % tabs.length;
      else if (event.key === backward) next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else if (event.key === ' ') { event.preventDefault(); activate(index); return; }
      else return;
      event.preventDefault(); activate(next); tabs[next].focus();
    });
  });
  window.addEventListener('hashchange', readHash);
  readHash();
</script>

<style>
  .home-intro { padding: 0 0 35px; }
  .home-intro h1 { font-size: clamp(38px, 3.6vw, 54px); margin-bottom: 12px; }
  .home-intro > p { margin-bottom: 24px; }
  .haybarn-introduction { max-width: 800px; line-height: 1.8; }
  .haybarn-introduction a { color: var(--green); text-decoration: underline; text-underline-offset: 4px; }
  .home-intro-links { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .home-search { max-width: 800px; margin-bottom: 14px; }
  .home-search label { display: block; font-size: var(--text-base); font-weight: 500; margin-bottom: 8px; }
  .home-search-field { display: flex; gap: 10px; }
  .home-search input { flex: 1; min-width: 0; width: 100%; border: 1px solid #b9b19a; border-radius: 4px; padding: 13px 16px; color: var(--ink); background: var(--paper-light); }
  .home-search input::placeholder { color: var(--muted); opacity: 1; }
  .home-search button { flex-shrink: 0; }
  .home-examples { border-top: 1px solid var(--line); padding: 30px 0 35px; }
  .home-examples h2, .home-categories h2 { font-size: 30px; }
  .example-workspace { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 26px; align-items: start; }
  .example-picker { display: flex; flex-direction: column; gap: 8px; }
  .example-picker a { display: flex; align-items: center; gap: 12px; padding: 15px 12px; border: 1px solid transparent; border-radius: 4px; font-size: var(--text-base); line-height: 1.5; }
  .example-picker a:hover { background: var(--paper-deep); }
  .example-picker a[aria-selected=true] { background: #e6ecdc; border-color: #c2ceb0; color: var(--green-dark); font-weight: 500; }
  .example-symbol { flex-shrink: 0; display: inline-flex; justify-content: center; align-items: center; width: 34px; height: 34px; font: 18px var(--mono); white-space: nowrap; color: var(--tint-ink); background: var(--tint); border-radius: 4px; }
  .example-arrow { margin-left: auto; opacity: 0; }
  [aria-selected=true] .example-arrow { opacity: 1; }
  .example-panel { min-width: 0; scroll-margin-top: 16px; }
  .example-panel + .example-panel { margin-top: 24px; }
  .example-panel[role=tabpanel] { margin-top: 0; }
  .example-reference { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 14px; margin-top: 15px; font-size: var(--text-base); }
  .example-reference > span { color: var(--muted); }
  .example-reference a { display: inline-flex; align-items: center; gap: 6px; color: var(--green); }
  .example-reference a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .example-reference code { font-size: var(--text-sm); }
  .more-recipes { margin-top: 24px; }
  .home-categories { border-top: 1px solid var(--line); padding-top: 30px; }
  .home-category-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 30px; }
  .home-category { display: flex; align-items: center; gap: 16px; padding: 19px 0; border-bottom: 1px solid var(--line); }
  .home-category:hover h3 { color: var(--green); text-decoration: underline; text-underline-offset: 4px; }
  .home-category h3 { font-size: 22px; margin-bottom: 6px; }
  .home-category p { font-size: var(--text-base); margin: 0; }
  .home-category > span:last-child { margin-left: auto; color: var(--muted); }
  @media (max-width: 1000px) {
    .example-workspace { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .example-picker { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .example-arrow { display: none; }
    .home-category-list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .home-intro { padding-bottom: 28px; }
    .home-search-field { gap: 8px; }
    .home-search input { padding: 12px; font-size: var(--text-base); }
    .home-search button { padding: 12px 15px; }
    .home-search button > span { display: none; }
    .example-picker a { padding: 11px 9px; gap: 9px; align-items: start; }
    .example-picker .example-symbol { width: 30px; height: 30px; font-size: 16px; }
    .home-examples h2, .home-categories h2 { font-size: 28px; }
  }
</style>
