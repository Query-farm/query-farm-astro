---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import { LATEST_STATUS_URL, LATEST_PKG_SUFFIX } from '../../../data/haybarn-versions';

const EXT_HOST = 'haybarn-extensions.query.farm';

const installCore = `-- Core channel: extensions built with the Haybarn engine.
INSTALL httpfs;
LOAD httpfs;

-- Then query files over HTTPS using the normal DuckDB workflow.
SELECT *
FROM read_csv('https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv')
LIMIT 10;`;

const installCommunity = `-- Community channel: rebuilt from duckdb/community-extensions.
INSTALL a5 FROM community;
LOAD a5;

SELECT a5_lonlat_to_cell(-122.4194, 37.7749, 10);`;

const pinNpm = `// Signed Haybarn extensions are published to npm today.
{
  "dependencies": {
    "@haybarn/ext-httpfs-${LATEST_PKG_SUFFIX}": "202606.9.140951"
  }
}`;

const pinPip = `# Roadmap: PyPI wheels, pinnable the same way.
haybarn-ext-httpfs-${LATEST_PKG_SUFFIX}==202606.9.140951`;

// ── Shared shape vocabulary (brief §10) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';

const PILL = 'inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium';
const PILL_READY = `${PILL} border-field-600/45 bg-field-600/10 text-field-700`;
const PILL_PROGRESS = `${PILL} border-sun-400 bg-sun-400/12 text-sun-700`;
const PILL_NEUTRAL = `${PILL} border-soil-300 bg-soil-100 text-soil-700`;

const TH = 'border-b border-soil-300 bg-[#fbf7ee] px-3.5 py-2.5 text-left text-[12.5px] font-semibold text-soil-700';

const phases = [
  {
    status: 'Available',
    statusClass: PILL_READY,
    title: 'npm packages',
    description: 'Every community extension is published to npm today — signed and pinnable in package.json.'
  },
  {
    status: 'In progress',
    statusClass: PILL_PROGRESS,
    title: 'PyPI wheels',
    description: 'Per-platform wheels so extensions can be pinned in requirements.txt and mirrored internally.'
  },
  {
    status: 'Planned',
    statusClass: PILL_NEUTRAL,
    title: 'Runtime discovery',
    description: 'Python and Node packages discover installed extension packages without changing normal SQL.'
  }
];

const comparison = [
  { label: 'Install syntax', duckdb: 'INSTALL …; LOAD …;', haybarn: 'Same SQL' },
  { label: 'Default origin', duckdb: 'extensions.duckdb.org', haybarn: EXT_HOST },
  { label: 'Trust root', duckdb: 'DuckDB Foundation key', haybarn: 'Haybarn key' },
  { label: 'Cache directory', duckdb: '~/.duckdb/extensions/', haybarn: '~/.haybarn/extensions/' },
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Haybarn rebuilds core and community DuckDB extensions against the Haybarn engine, signs them with the Haybarn key, and serves them through a production extension channel.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Haybarn extensions',
    description,
    url: `${SITE_ORIGIN}/products/haybarn/extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Haybarn', item: SITE_ORIGIN + '/products/haybarn' },
      { '@type': 'ListItem', position: 4, name: 'Extensions', item: SITE_ORIGIN + '/products/haybarn/extensions' },
    ],
  },
];
---

<PageLayout
  title="Haybarn extensions — signed DuckDB extensions for production"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Signed extension ecosystem"
    title="Signed DuckDB extensions for Haybarn."
    icon={{ src: '/products/haybarn/haybarn-mark.svg' }}
    lede="Haybarn rebuilds core and community DuckDB extensions against the Haybarn engine, signs them with the Haybarn key, and serves them from a production extension channel."
    hairband
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href={LATEST_STATUS_URL} variant="primary" size="md">See the build matrix</Button>
      <Button href="/products/haybarn/install" variant="secondary" size="md">Install Haybarn</Button>
    </div>
  </PageHead>

  <!-- ── Today: how INSTALL works ────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Today</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Same INSTALL and LOAD, Haybarn trust behind it</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        Haybarn resolves extensions from
        <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900">{EXT_HOST}</code>, verifies
        signatures with the Haybarn key, and caches binaries under
        <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900">~/.haybarn/extensions/</code>.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="mb-2.5 text-[12.5px] font-medium text-soil-700">Core extension</h3>
          <CodeBlock code={installCore} lang="sql" title="Haybarn shell" />
        </div>
        <div>
          <h3 class="mb-2.5 text-[12.5px] font-medium text-soil-700">Community extension</h3>
          <CodeBlock code={installCommunity} lang="sql" title="Haybarn shell" />
        </div>
      </div>

      <p class="mt-5 max-w-[70ch] text-sm leading-relaxed text-soil-700">
        Core extensions are built with the engine release. Community extensions are rebuilt from
        the upstream DuckDB community catalog and served from the
        <code class="rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900">community</code> channel.
      </p>
    </div>
  </section>

  <!-- ── Build status link ───────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-11">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-8`}>
        <div class="max-w-[58ch]">
          <span class={EYEBROW}>Build matrix</span>
          <h2 class="mt-3 text-2xl md:text-3xl text-soil-900">Which extensions are ready right now?</h2>
          <p class="mt-3 text-sm leading-relaxed text-soil-700">
            Haybarn tracks engine builds, core extension builds, and community extension builds
            for each release, so teams can see what is ready before rollout.
          </p>
        </div>
        <Button href={LATEST_STATUS_URL} variant="primary" size="md">See the build matrix</Button>
      </div>
    </div>
  </section>

  <!-- ── Side by side ────────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Side by side</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">What changes from DuckDB?</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        The SQL stays familiar. The origin, trust root, and cache location move to Haybarn.
        DuckDB-signed extensions do not load against Haybarn; Haybarn verifies extensions with
        its own key.
      </p>

      <div class="mt-8 overflow-x-auto rounded-xl border border-soil-300 bg-[#fffdf7]">
        <table class="w-full border-collapse text-[14.5px]">
          <thead>
            <tr>
              <th class={TH}><span class="sr-only">Property</span></th>
              <th class={TH}>DuckDB</th>
              <th class={TH}>Haybarn</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(row => (
              <tr class="border-b border-soil-200 last:border-0 hover:bg-[#fbf7ee]">
                <td class="px-3.5 py-2.5 text-soil-900">{row.label}</td>
                <td class="px-3.5 py-2.5 font-mono text-xs text-soil-700">{row.duckdb}</td>
                <td class="px-3.5 py-2.5 font-mono text-xs text-soil-700">{row.haybarn}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── Packaging roadmap ───────────────────────────────────── -->
  <section class="border-y border-soil-300 bg-soil-100 py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>Packaging</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-soil-900">Lockfile-managed extensions</h2>
      <p class={`mt-3 max-w-[64ch] ${LEDE}`}>
        The signed HTTP channel remains the source of truth. Extensions are published to npm
        today, with PyPI wheels and deeper runtime discovery rolling out — so versions can be
        pinned, mirrored, and reviewed.
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {phases.map(p => (
          <div class={`${CARD} p-6`}>
            <span class={p.statusClass}>{p.status}</span>
            <h3 class="mt-3.5 text-xl text-soil-900">{p.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{p.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div>
          <div class="mb-2.5"><span class={PILL_READY}>Available now</span></div>
          <CodeBlock code={pinNpm} lang="json" title="package.json" />
        </div>
        <div>
          <div class="mb-2.5"><span class={PILL_PROGRESS}>Coming soon</span></div>
          <CodeBlock code={pinPip} lang="text" title="requirements.txt" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Consulting CTA ──────────────────────────────────────── -->
  <section class="py-16 lg:py-[70px]">
    <div class={WRAP}>
      <div class={`${CARD} flex flex-wrap items-center justify-between gap-6 px-8 py-9`}>
        <div class="max-w-[52ch]">
          <span class={EYEBROW}>Expert help</span>
          <h2 class="mt-3 text-2xl md:text-3xl text-soil-900">Need a private extension channel?</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">
            We help teams with internal mirrors, private signing workflows, custom extension CI,
            and controlled rollout.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
