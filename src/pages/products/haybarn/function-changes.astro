---
import Layout from '@haybarn/layouts/Layout.astro';
import ReleaseComparison from '@haybarn/components/ReleaseComparison.astro';
import { snapshots, defaultSnapshot } from '@haybarn/lib/catalog';
import { comparisonSource } from '@haybarn/data/release-selection.mjs';
const to = defaultSnapshot;
const from = comparisonSource(snapshots, to);
---
<Layout title="Function changes" description="Compare function availability, arguments, and return types across Haybarn and DuckDB releases." active="releases" wide>
  <div class="page-heading"><h1>Function changes</h1></div>
  {from ? <ReleaseComparison {from} {to} /> : <p>A comparison will be available when a second release is documented.</p>}
</Layout>
