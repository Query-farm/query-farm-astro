---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import HaybarnSubNav from '../../../components/sections/HaybarnSubNav.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import { LATEST_STATUS_URL } from '../../../data/haybarn-versions';

const upstreamRepo = 'https://github.com/duckdb/community-extensions';
const haybarnMirrorRepo = 'https://github.com/Query-farm-haybarn/haybarn-community-extensions';

const descriptorYaml = `extension:
  name: my_extension
  description: One-line summary
  version: 0.1.0
  language: C++
  build: cmake
  license: MIT
  maintainers:
    - your-gh-handle

repo:
  github: owner/repo
  ref: <commit-sha>`;

const haybarnOverride = `# Only if upstream code needs a patch to build
# against the Haybarn engine.
repo:
  github: owner/repo
  ref:    <commit-sha>
  haybarn_fork: Query-farm-haybarn/your-fork
  haybarn_ref:  <commit-sha>`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Your DuckDB community extension already works on Haybarn. Submit upstream and Haybarn rebuilds and signs it automatically, or submit to Haybarn\'s mirror directly. Same descriptor either way.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Get a community extension into Haybarn',
    description,
    url: `${SITE_ORIGIN}/products/haybarn/community-extensions`,
    author: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    publisher: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE_ORIGIN + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Haybarn', item: SITE_ORIGIN + '/products/haybarn' },
      { '@type': 'ListItem', position: 4, name: 'Community extensions', item: SITE_ORIGIN + '/products/haybarn/community-extensions' },
    ],
  },
];

const steps: [string, string, string][] = [
  ['1', 'Rebuild', 'Builds against the Haybarn engine on a 12-platform matrix — Linux (glibc + musl, amd64 + arm64), macOS, Windows, Wasm — pinned to your commit.'],
  ['2', 'Sign', 'Each binary is signed with the Haybarn key. Same mechanism as DuckDB, different key.'],
  ['3', 'Ship', 'Published to the Haybarn community channel alongside each engine release.'],
];

// ── Shared shape vocabulary (family C: docs / reference — no bands) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const H2_FIRST = 'scroll-mt-32 text-2xl md:text-3xl text-soil-900';
const H2 = 'mt-11 scroll-mt-32 border-t border-soil-300 pt-6 text-2xl md:text-3xl text-soil-900';
const BODY = 'text-soil-700 leading-relaxed';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';
const NAV_LINK = 'block border-l-2 border-soil-200 px-2.5 py-1 text-sm text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
const NAV_LINK_ON = 'block border-l-2 border-link bg-link/8 px-2.5 py-1 text-sm text-link no-underline transition';

const sectionNav: [string, string][] = [
  ['Overview', '/products/haybarn'],
  ['Install', '/products/haybarn/install'],
  ['Security', '/products/haybarn/security'],
  ['Extensions', '/products/haybarn/extensions'],
  ['Build status', LATEST_STATUS_URL],
  ['Contribute', '/products/haybarn/community-extensions'],
  ["What's different", '/products/haybarn/differences'],
  ['Compatibility & FAQ', '/products/haybarn/compatibility'],
];
const CURRENT = '/products/haybarn/community-extensions';
---

<PageLayout
  title="Get a community extension into Haybarn"
  description={description}
  jsonLd={jsonLd}
>
  <HaybarnSubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    eyebrow="Contribute an extension"
    title="Get your extension into Haybarn."
    icon={{ src: '/haybarn/haybarn-mark.svg' }}
    ledeClass="mt-3.5 max-w-[62ch] text-[17.5px] leading-relaxed text-soil-700"
    lede="It already builds against the Haybarn engine unchanged. Submit upstream and Haybarn rebuilds it automatically — or submit to Haybarn's mirror directly. Same descriptor either way."
  />

  <!-- ── Docs grid: section nav / content (two columns) ───────── -->
  <div class={`${WRAP} grid gap-10 py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-11`}>
    <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto">
      <nav aria-label="Haybarn documentation">
        <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">In this section</h2>
        <ul class="flex flex-col gap-0.5">
          {sectionNav.map(([name, href]) => (
            <li>
              <a
                href={href}
                class={href === CURRENT ? NAV_LINK_ON : NAV_LINK}
                aria-current={href === CURRENT ? 'page' : undefined}
              >{name}</a>
            </li>
          ))}
        </ul>
        <h2 class="mt-7 mb-2.5 text-[12.5px] font-semibold text-soil-500">On this page</h2>
        <ul class="flex flex-col gap-0.5">
          <li><a href="#paths" class={NAV_LINK}>Two ways in</a></li>
          <li><a href="#pipeline" class={NAV_LINK}>What Haybarn does</a></li>
          <li><a href="#override" class={NAV_LINK}>Needs a patch?</a></li>
          <li><a href="#help" class={NAV_LINK}>Get help</a></li>
        </ul>
      </nav>
    </aside>

    <div class="min-w-0 max-w-[860px]">
      <h2 id="paths" class={H2_FIRST}>Submit upstream, or to Haybarn directly</h2>
      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <span class={EYEBROW}>Path A · default</span>
          <h3 class="mt-2.5 text-xl text-soil-900">Submit upstream</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            Open a PR on <a href={upstreamRepo} target="_blank" rel="noopener" class={LINK}><code class="font-mono">duckdb/community-extensions</code></a>.
            Once merged, Haybarn's mirror rebuilds it automatically — one review, both engines.
          </p>
        </div>
        <div class={`${CARD} p-6`}>
          <span class={EYEBROW}>Path B · Haybarn-only</span>
          <h3 class="mt-2.5 text-xl text-soil-900">Submit to Haybarn</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            Open a PR on <a href={haybarnMirrorRepo} target="_blank" rel="noopener" class={LINK}><code class="font-mono">haybarn-community-extensions</code></a>
            with the same file. Ships on the next build, no upstream wait — for Haybarn-specific
            variants or extensions upstream hasn't taken.
          </p>
        </div>
      </div>

      <h3 class="mt-8 text-[12.5px] font-medium text-soil-700">The descriptor — identical in either repo</h3>
      <div class="mt-3">
        <CodeBlock code={descriptorYaml} lang="yaml" title="extensions/my_extension/description.yml" />
      </div>
      <p class="mt-3 text-sm leading-relaxed text-soil-700">
        Optional fields (<code class={CODE}>excluded_platforms</code>, <code class={CODE}>vcpkg_url</code>, …)
        match <a href={upstreamRepo} target="_blank" rel="noopener" class={LINK}>upstream's schema</a>.
      </p>

      <h2 id="pipeline" class={H2}>Rebuilt, signed, shipped</h2>
      <div class="mt-6 grid gap-3.5 md:grid-cols-3">
        {steps.map(([n, title, body]) => (
          <div class={`${CARD} p-5`}>
            <div class="qf-figure flex h-9 w-9 items-center justify-center rounded-full border border-sun-400 bg-sun-400/12 text-sun-700">{n}</div>
            <h3 class="mt-3 text-lg text-soil-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">{body}</p>
          </div>
        ))}
      </div>

      <h2 id="override" class={H2}>Needs a patch? Point Haybarn at a fork</h2>
      <p class={`mt-3 max-w-[68ch] ${BODY}`}>
        The Haybarn engine carries a small patch stack. For the rare extension that needs a tweak
        to build against it, add two optional fields — the upstream descriptor stays untouched.
        Most extensions never need this.
      </p>
      <div class="mt-6">
        <CodeBlock code={haybarnOverride} lang="yaml" title="extensions/my_extension/description.yml" />
      </div>

      <div class="mt-11 grid gap-3.5 border-t border-soil-300 pt-6 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">See what's already built</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            Live build status for every community extension on the current engine.
          </p>
          <div class="mt-4">
            <Button href={LATEST_STATUS_URL} variant="primary" size="sm">Build status →</Button>
          </div>
        </div>
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">The mirror repo</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            CI workflows, descriptor schema, and the override fields, documented in the README.
          </p>
          <div class="mt-4">
            <Button href={haybarnMirrorRepo} variant="secondary" size="sm" external>View on GitHub →</Button>
          </div>
        </div>
      </div>

      <h2 id="help" class={H2}>Stuck getting an extension to build?</h2>
      <div class={`mt-6 ${CARD} px-6 py-6`}>
        <span class={EYEBROW}>Expert help</span>
        <p class={`mt-3 max-w-[62ch] ${BODY}`}>
          We help maintainers across the line — vcpkg conflicts, platform build failures, signing,
          and the long tail of CI quirks.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>
  </div>
</PageLayout>
