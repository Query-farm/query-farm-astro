---
// /products/haybarn/status redirects to the latest versioned status URL. Update
// `LATEST_HAYBARN_VERSION` in src/data/haybarn-versions.ts to roll forward.
import { LATEST_STATUS_URL } from '../../../../data/haybarn-versions';
const target = LATEST_STATUS_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Haybarn build status → {target}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>…</p>
    <script type="text/javascript" set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
