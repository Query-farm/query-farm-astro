---
import Layout from '@haybarn/layouts/Layout.astro';
import Playground from '@haybarn/components/Playground.astro';
import { recipes } from '@haybarn/data/recipes';
import { defaultSnapshot, getFunction, functionUrl, categoryInfo } from '@haybarn/lib/catalog';
---
<Layout title="SQL recipes" active="recipes">
  <div class="page-heading"><h1>SQL recipes</h1><p>Run and edit queries with their sample data included.</p></div>
  <nav class="recipe-jump-links" aria-label="Recipes">{recipes.map(r => <a href={`#${r.id}`}>{categoryInfo(r.category).name} ↓</a>)}</nav>
  {recipes.map((recipe, index) => <section class="recipe-section" id={recipe.id}><div class="recipe-heading"><span class="recipe-number">{String(index + 1).padStart(2, '0')}</span><div><p class="eyebrow">{categoryInfo(recipe.category).name}</p><h2>{recipe.title}</h2><p>{recipe.description}</p></div></div><Playground sql={recipe.sql} title={recipe.title} /><div class="recipe-functions"><span>Functions</span>{recipe.functions.map(name => { const fn = getFunction(defaultSnapshot, name)!; return <a href={functionUrl(defaultSnapshot, fn)}><code>{name}()</code><span>↗</span></a>; })}</div></section>)}
</Layout>
