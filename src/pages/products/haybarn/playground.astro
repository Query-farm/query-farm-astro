---
import Layout from '@haybarn/layouts/Layout.astro';
import Playground from '@haybarn/components/Playground.astro';
import { recipes } from '@haybarn/data/recipes';
import { wasmVersion } from '@haybarn/data/settings';
const sql = "SELECT\n  function_name,\n  description,\n  parameter_types,\n  return_type\nFROM duckdb_functions()\nWHERE function_name = 'list_transform';";
---
<Layout title="SQL playground" active="playground">
  <div class="page-heading"><h1>SQL playground</h1></div>
  <Playground sql={sql} title="Your SQL playground" source="Your scratchpad" />
  <div class="playground-notes"><p><strong>Haybarn WASM {wasmVersion}</strong><br />The engine downloads on your first run. Queries execute in this tab.</p><p><strong>A temporary workspace</strong><br />Data lasts until you reload or stop the engine. The result preview shows up to 100 rows.</p></div>
  <section class="playground-starters"><h2>Try a recipe</h2><div class="starter-grid">{recipes.map(recipe => <button data-starter={recipe.sql}><span>{recipe.title}</span><code>{recipe.functions[0]}()</code><span aria-hidden="true">↗</span></button>)}</div></section>
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach(button => button.addEventListener('click', () => {
    const editor = document.querySelector('textarea')!;
    editor.value = button.dataset.starter!; editor.dispatchEvent(new Event('input')); editor.focus(); editor.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }));
</script>
