---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHead from '../../../components/ui/PageHead.astro';
import Button from '../../../components/ui/Button.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';
import { organization } from '../../../lib/organization';

const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const example = `-- Setup prints the connection for your computer.
ATTACH 'mail' AS mail (
    TYPE vgi,
    LOCATION '/path/to/vgi-email',
    PROVIDER 'gmail',
    SECRET 'gmail_main',
    ACCESS 'readonly'
);

SELECT name FROM mail.main.mailboxes;`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'vgi-email',
  applicationCategory: 'BusinessApplication',
  url: 'https://query.farm/products/vgi-email/',
  description: 'An installed email productivity adapter connecting local SQL tools to Gmail.',
  publisher: organization,
};
---

<PageLayout title="vgi-email — Email in your local SQL tools" description="Search and work with Gmail from a local SQL client. A commercial email productivity adapter from Query Farm." jsonLd={jsonLd}>
  <PageHead variant="section" eyebrow="vgi-email · Local email adapter" title="Your mailbox. Your SQL tools." lede="Search messages, read attachments, and work with your email from a SQL client on your own computer." hairband>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="mailto:hello@query.farm?subject=vgi-email%20preview">Ask about the preview</Button>
      <Button href="/products/vgi-email/setup/" variant="secondary">How setup works</Button>
    </div>
    <p class="mt-4 text-sm text-soil-700">Commercial preview. Public availability follows platform validation and Google verification.</p>
  </PageHead>

  <section class="bg-soil-50 py-12">
    <div class={`${WRAP} grid gap-10 lg:grid-cols-2 lg:items-center`}>
      <div>
        <span class={EYEBROW}>An email workflow you control</span>
        <h2 class="mt-3 text-3xl text-soil-900">Connect once. Query from your desktop.</h2>
        <p class={`mt-4 ${LEDE}`}>Use Gmail search and local SQL to review messages, inspect bodies and attachments, and explore mailbox and label information. Optional read/write access adds mailbox organization, drafts, and sending.</p>
        <p class="mt-4 leading-relaxed text-soil-700">The adapter connects directly from your computer to Google. Your local SQL client receives the results. Query Farm does not run a mailbox processing backend for this product.</p>
      </div>
      <CodeBlock code={example} language="sql" />
    </div>
  </section>

  <section class="border-y border-soil-300 bg-soil-100 py-12">
    <div class={WRAP}>
      <h2 class="text-3xl text-soil-900">Choose the access your work needs</h2>
      <div class="mt-7 grid gap-5 md:grid-cols-2">
        <article class={`${CARD} p-7`}>
          <span class={EYEBROW}>Default · Read-only</span>
          <h3 class="mt-3 text-2xl text-soil-900">Read and search</h3>
          <p class="mt-3 leading-relaxed text-soil-700">Read messages, attachments, drafts, and labels. The worker rejects actions that modify your mailbox, including sending.</p>
        </article>
        <article class={`${CARD} p-7`}>
          <span class={EYEBROW}>Optional · Read/write</span>
          <h3 class="mt-3 text-2xl text-soil-900">Organize and send</h3>
          <p class="mt-3 leading-relaxed text-soil-700">Change read or starred status, manage labels and drafts, move messages to Trash, and send mail. Setup requests this permission only when you select it.</p>
        </article>
      </div>
      <p class="mt-6 max-w-[80ch] leading-relaxed text-soil-700">Sign in through your system browser. Setup checks a mailbox query and saves a local DuckDB secret. DuckDB's default persistent secret store is not encrypted; setup explains this before you continue. <a class="text-link underline" href="/products/vgi-email/privacy/">Read the vgi-email privacy policy.</a></p>
    </div>
  </section>

  <section class="bg-soil-50 py-12">
    <div class={WRAP}>
      <h2 class="text-3xl text-soil-900">Built for local work</h2>
      <p class={`mt-4 max-w-[75ch] ${LEDE}`}>The release targets macOS on Apple Silicon and Intel, Linux on ARM64 and x86-64, and Windows x86-64. The standalone bundle includes its Python runtime; a compatible local SQL client and the VGI extension complete the connection.</p>
      <p class="mt-4 max-w-[80ch] leading-relaxed text-soil-700">Gmail is the first guided setup. Microsoft, Fastmail, and IMAP are also available through the adapter's developer interfaces. The preview's support matrix and installation instructions will be finalized before public downloads.</p>
    </div>
  </section>

  <section class="bg-pipe-6 py-12 text-cream">
    <div class={`${WRAP} flex flex-wrap items-center justify-between gap-7`}>
      <div class="max-w-[65ch]">
        <h2 class="text-3xl text-cream">A commercial adapter from Query Farm</h2>
        <p class="mt-4 leading-relaxed">Use requires a commercial license from Query Farm LLC. Contact us for preview access, licensing, or setup support.</p>
        <p class="mt-4"><a class="text-cream underline underline-offset-4 hover:text-white" href="/products/vgi-email/privacy/">Product privacy</a> · <a class="text-cream underline underline-offset-4 hover:text-white" href="/products/vgi-email/setup/">Setup and removal</a> · <a class="text-cream underline underline-offset-4 hover:text-white" href="/legal/terms/">Website terms</a></p>
      </div>
      <Button href="mailto:hello@query.farm?subject=vgi-email" onDark>Contact hello@query.farm</Button>
    </div>
  </section>
</PageLayout>
