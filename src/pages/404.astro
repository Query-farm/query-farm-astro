---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

const links = [
  { icon: '🔌', title: 'Extensions', description: 'Browse our DuckDB extension catalog.', href: '/products/extensions' },
  { icon: '🌐', title: 'VGI', description: 'Vector Gateway Interface — extend DuckDB in any language.', href: '/vgi' },
  { icon: '🛠️', title: 'Consulting', description: 'Custom DuckDB extensions and data infrastructure work.', href: '/consulting' },
  { icon: '✍️', title: 'Blog', description: 'Posts from the Query.Farm team.', href: '/blog' },
];
---

<PageLayout title="Page not found" description="The page you're looking for doesn't exist or has moved.">
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-sm uppercase tracking-wider text-harvest-600 font-semibold mb-4">404 · Not Found</p>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-soil-900 mb-6 leading-tight">
          This field hasn't been planted yet.
        </h1>
        <p class="text-lg md:text-xl text-soil-700 mb-10 leading-relaxed">
          The page you're looking for doesn't exist — maybe it moved, maybe it was renamed, or maybe you took a wrong turn at the silo. Try one of these instead:
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
          <Button href="/" variant="primary" size="lg">Back to Home</Button>
          <Button href="/products/extensions" variant="secondary" size="lg">Browse Extensions</Button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto mt-12">
        {links.map(l => (
          <a href={l.href} class="block">
            <Card padding="lg" class="h-full hover:shadow-xl transition-shadow text-center">
              <div class="text-3xl mb-3">{l.icon}</div>
              <h3 class="font-bold text-soil-900 mb-2">{l.title}</h3>
              <p class="text-sm text-soil-600">{l.description}</p>
            </Card>
          </a>
        ))}
      </div>

      <p class="text-center mt-12 text-sm text-soil-600">
        Still stuck? <a href="/company/contact" class="text-harvest-700 underline">Get in touch</a> and we'll help you find what you're looking for.
      </p>
    </div>
  </section>
</PageLayout>
