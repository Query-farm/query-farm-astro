---
import PageLayout from '../layouts/PageLayout.astro';
import { publicExtensions } from '../data/extensions';

const extensionCount = publicExtensions.length;

const links = [
  { title: 'Extensions', href: '/products/extensions' },
  { title: 'VGI', href: '/vgi' },
  { title: 'Haybarn', href: '/haybarn' },
  { title: 'Consulting', href: '/consulting' },
  { title: 'Blog', href: '/blog' },
];
---

<PageLayout title="Page not found" description="The page you're looking for doesn't exist or has moved.">
  <section class="px-6 pt-20 pb-16 text-center">
    <img src="/mark-strata-sun.svg" alt="" width="96" height="96" class="mx-auto h-24 w-24" />

    <p class="mt-6 text-[13.5px] font-medium text-sun-700">
      404 · nothing at this depth
    </p>

    <h1 class="mx-auto mt-3 max-w-[16ch] text-[clamp(2.125rem,5vw,3.75rem)]">
      That row isn't in the result set.
    </h1>

    <p class="mx-auto mt-4 max-w-[52ch] text-[17.5px] leading-relaxed text-soil-700">
      The page you asked for doesn't exist, or it moved. The catalog is a good place to start over.
    </p>

    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/products/extensions"
        class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
      >
        Browse <span class="qf-figure">{extensionCount}</span> extensions
      </a>
      <a
        href="/"
        class="inline-block rounded-lg border border-soil-900 px-5 py-2.5 text-sm font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
      >
        Back to the homepage
      </a>
    </div>

    <div class="mx-auto mt-9 max-w-[420px] text-left">
      <div class="flex items-center gap-3.5 rounded-[10px] bg-rock-900 px-4 py-3.5 font-mono text-[13px] text-[#e9e1d3]">
        <span class="text-rock-700">$</span>
        <span>
          <span class="text-sun-400">SELECT</span> *
          <span class="text-sun-400">FROM</span> pages
          <span class="text-sun-400">WHERE</span> url = ?;
        </span>
      </div>
      <p class="qf-figure mt-2 text-[13px] text-soil-600">0 rows returned.</p>
    </div>

    <nav aria-label="Elsewhere on the site" class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] font-medium text-soil-500">
      {links.map(link => (
        <a href={link.href} class="no-underline transition-colors hover:text-link">{link.title}</a>
      ))}
    </nav>

    <p class="mt-6 text-[13.5px] text-soil-600">
      Still stuck?
      <a href="/company/contact" class="text-link no-underline underline-offset-2 hover:underline">Get in touch</a>
      and we'll help you find it.
    </p>
  </section>
</PageLayout>
