---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';

const team = [
  {
    name: 'Dr. Sarah Chen',
    role: 'Founder & CEO',
    bio: 'Former DuckDB core team member with 15+ years in data infrastructure. PhD in Database Systems from MIT. Built data platforms at Google and Snowflake.',
    avatar: '👩‍💻',
    linkedin: 'https://linkedin.com/in/sarahchen',
    github: 'https://github.com/sarahchen'
  },
  {
    name: 'Marcus Rodriguez',
    role: 'CTO & Co-Founder',
    bio: 'Data engineering veteran who architected petabyte-scale systems at Netflix. Open source contributor to Apache Arrow and Parquet.',
    avatar: '👨‍💻',
    linkedin: 'https://linkedin.com/in/marcusrodriguez',
    github: 'https://github.com/mrodriguez'
  },
  {
    name: 'Emily Park',
    role: 'VP of Engineering',
    bio: 'Previously led data platform teams at Stripe and Databricks. Passionate about making data infrastructure accessible to everyone.',
    avatar: '👩‍🔬',
    linkedin: 'https://linkedin.com/in/emilypark',
    github: 'https://github.com/emilypark'
  },
  {
    name: 'James Wilson',
    role: 'Head of Product',
    bio: '10+ years building developer tools at HashiCorp and GitHub. Believes great products solve real problems elegantly.',
    avatar: '👨‍🎨',
    linkedin: 'https://linkedin.com/in/jameswilson',
    github: 'https://github.com/jwilson'
  }
];

const values = [
  {
    icon: '🎯',
    title: 'Performance First',
    description: 'Every line of code is optimized for speed. We measure in microseconds, not milliseconds.'
  },
  {
    icon: '🔓',
    title: 'Open by Default',
    description: 'Open source is in our DNA. All our extensions are publicly available and MIT licensed.'
  },
  {
    icon: '🤝',
    title: 'Community Driven',
    description: 'We build for developers, with developers. Your feedback shapes our roadmap.'
  },
  {
    icon: '📚',
    title: 'Documentation Matters',
    description: 'Code without docs is incomplete. We invest heavily in clear, comprehensive documentation.'
  },
  {
    icon: '🔒',
    title: 'Security Always',
    description: 'Security is not optional. Every extension undergoes rigorous testing and auditing.'
  },
  {
    icon: '🚀',
    title: 'Move Fast',
    description: 'Ship early, iterate quickly. We release updates weekly and listen to our users.'
  }
];

const timeline = [
  {
    year: '2023',
    quarter: 'Q1',
    milestone: 'Founded Query.Farm',
    description: 'Started with a simple idea: make DuckDB extensions enterprise-ready.'
  },
  {
    year: '2023',
    quarter: 'Q2',
    milestone: 'First Extensions Released',
    description: 'Launched crypto, geospatial, and JSON extensions. First 100 users.'
  },
  {
    year: '2023',
    quarter: 'Q4',
    milestone: 'Reached 1,000 Installations',
    description: 'Extensions powering data infrastructure at 500+ companies.'
  },
  {
    year: '2024',
    quarter: 'Q2',
    milestone: 'Launched Data-as-a-Service',
    description: 'Introduced managed DuckDB infrastructure for enterprise customers.'
  },
  {
    year: '2024',
    quarter: 'Q4',
    milestone: 'Ecosystem Expansion',
    description: 'Released Python SDK, CLI tools, and 10 new extensions. 10,000+ users.'
  },
  {
    year: '2025',
    quarter: 'Q1',
    milestone: 'Series A Funding',
    description: '$12M Series A to expand team and accelerate product development.'
  }
];

const stats = [
  { value: '20+', label: 'Extensions' },
  { value: '50K+', label: 'Downloads' },
  { value: '1,000+', label: 'Companies' },
  { value: '99.9%', label: 'Uptime SLA' }
];
---

<PageLayout
  title="About Us"
  description="Learn about Query.Farm's mission, team, and journey to make DuckDB the best data infrastructure platform."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Company', href: '/company/about' },
    { name: 'About', href: '/company/about' }
  ]}
>
  <!-- Hero Section -->
  <Hero
    title="Building the Future of Data Infrastructure"
    subtitle="We're a team of database engineers, data scientists, and infrastructure experts on a mission to make DuckDB the best data platform for modern teams."
    primaryCTA={{ text: "Join Our Team", href: "/company/contact" }}
    secondaryCTA={{ text: "Our Products", href: "/products" }}
  />

  <!-- Stats Section -->
  <section class="py-12 bg-white border-b border-soil-200">
    <div class="section-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map((stat) => (
          <div>
            <div class="text-4xl font-bold text-harvest-600 mb-2">{stat.value}</div>
            <div class="text-sm text-soil-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="Our Mission"
          title="Making DuckDB Enterprise-Ready"
          align="center"
          class="mb-12"
        />

        <div class="space-y-6 text-lg leading-relaxed text-soil-700">
          <p>
            Query.Farm was founded by data engineers who were frustrated with the complexity and cost of modern data infrastructure. We saw DuckDB's potential to revolutionize how teams work with data, but recognized a gap: while DuckDB excelled at core analytics, it needed a rich ecosystem of extensions and tooling for enterprise adoption.
          </p>

          <p>
            We started building extensions for our own projects—cryptographic functions, geospatial tools, advanced connectors. When we shared them with the community, the response was overwhelming. Teams at startups and Fortune 500 companies alike were using our extensions in production.
          </p>

          <p>
            Today, Query.Farm is the leading provider of DuckDB extensions, tools, and services. We work with hundreds of companies to build blazing-fast data infrastructure that's simple to operate and scales to billions of rows.
          </p>

          <p class="font-semibold text-soil-900">
            Our goal: Make DuckDB the default choice for data infrastructure—from analytics to machine learning to real-time applications.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our Values"
        title="What We Stand For"
        description="Principles that guide everything we build and every decision we make."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {values.map((value) => (
          <Card padding="lg" class="text-center hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-harvest-100 flex items-center justify-center text-4xl">
              {value.icon}
            </div>
            <h3 class="text-xl font-bold text-soil-900 mb-3">{value.title}</h3>
            <p class="text-soil-700 leading-relaxed">
              {value.description}
            </p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Meet the Team"
        title="The People Behind Query.Farm"
        description="A diverse team of engineers, researchers, and builders passionate about data infrastructure."
        align="center"
        class="mb-12"
      />

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {team.map((member) => (
          <Card padding="lg" class="hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-harvest-100 flex items-center justify-center text-5xl">
                {member.avatar}
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-soil-900 mb-1">{member.name}</h3>
                <p class="text-sm text-harvest-700 font-semibold mb-3">{member.role}</p>
                <p class="text-sm text-soil-700 leading-relaxed mb-4">
                  {member.bio}
                </p>
                <div class="flex items-center gap-3">
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
                  >
                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                  </a>
                  <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
                  >
                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                    </svg>
                    GitHub
                  </a>
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>

      <div class="mt-12 text-center">
        <Card padding="lg" class="max-w-2xl mx-auto bg-harvest-50">
          <h4 class="text-lg font-bold text-soil-900 mb-2">Join Our Team</h4>
          <p class="text-soil-700 mb-4">
            We're hiring! If you're passionate about data infrastructure and want to work on cutting-edge database technology, we'd love to hear from you.
          </p>
          <Button href="/company/contact" variant="primary" size="md">
            View Open Positions
          </Button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our Journey"
        title="Company Timeline"
        description="From a side project to powering data infrastructure at 1,000+ companies."
        align="center"
        class="mb-12"
      />

      <div class="max-w-4xl mx-auto">
        <div class="space-y-8">
          {timeline.map((item, index) => (
            <div class="flex gap-6">
              <div class="flex-shrink-0 w-24 text-right">
                <div class="text-2xl font-bold text-harvest-600">{item.year}</div>
                <div class="text-sm text-soil-600">{item.quarter}</div>
              </div>
              <div class="flex-shrink-0 w-px bg-soil-300 relative">
                <div class="absolute -left-2 top-2 w-4 h-4 rounded-full bg-harvest-600 border-4 border-white"></div>
              </div>
              <div class="flex-1 pb-8">
                <h3 class="text-xl font-bold text-soil-900 mb-2">{item.milestone}</h3>
                <p class="text-soil-700 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Let's Build Together
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Whether you're looking to adopt our extensions, need consulting, or want to join our team—we'd love to connect.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/contact" variant="secondary" size="lg">
          Get in Touch
        </Button>
        <Button href="/products" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Explore Products
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
