---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import { usageSummary } from '../../data/usage-summary';
import { publicExtensions } from '../../data/extensions';

// Compact large counts: 186,270,588 → "186M". Mirrors the homepage helper so
// the loads figure on About matches the loads figure on the landing page.
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};
const annualLoads = usageSummary?.annualizedLoads;
// Fallback tracks the committed snapshot so the page never shows a stale figure
// if the AE credentials are absent at build time.
const loadsLabel = `${compactCount(annualLoads ?? 221_579_082)}+`;

// Counted, not asserted. `publicExtensions` — not `extensions` — is the honest
// number: the full set also carries the `example` docs template and extensions
// held back from the catalog, which a visitor can't go and find.
const extensionCount = publicExtensions.length;

// Verified against github.com/duckdb/duckdb (author:rustyconover is:merged) on
// 2026-08-10. Bump this when the linked search shows a higher count.
const mergedCorePRs = 64;

// Live per-extension load counts, keyed by slug, so the timeline chips stay in
// sync with the same usage snapshot that powers the cards (no stale hardcoding).
const loadsBySlug: Record<string, number> = Object.fromEntries(
  publicExtensions
    .filter((e) => typeof e.usageCount === 'number')
    .map((e) => [e.id, e.usageCount as number])
);
// Resolve a list of slugs to {slug, loads} chips, dropping anything without a
// count or a public detail page so every rendered chip has a valid destination.
const chips = (slugs: string[]) =>
  slugs.map((slug) => ({ slug, loads: loadsBySlug[slug] })).filter((c) => typeof c.loads === 'number');

// The four headline numbers. Each is true and checkable — the first two are the
// strongest. Loads and the extension count are computed, not hardcoded.
const stats = [
  { value: String(mergedCorePRs), label: 'merged pull requests to DuckDB core' },
  { value: loadsLabel, label: 'extension loads per year' },
  { value: String(extensionCount), label: 'DuckDB extensions published' },
  { value: 'May 2024', label: 'shipping extensions since' },
];

const values = [
  {
    title: 'Open source, and honest about what isn’t',
    description:
      'Most of what we make is open source, including the extensions this site documents. We also build commercial and closed-source products — and we tell you which is which.',
  },
  {
    title: 'We contribute upstream, across the data stack',
    description:
      'Our patches land in DuckDB itself — from Arrow integration and the C API to statistics and serialization — and across Apache Arrow’s JavaScript, Go, nanoarrow, and .NET implementations, as well as Apache Iceberg.',
  },
  {
    title: 'Built to be run in production',
    description:
      'Signed builds, verifiable artifacts, real load counts, and a hardened distribution. Not demos — software you can ship.',
  },
  {
    title: 'Useful before it’s a platform',
    description:
      'We ship the part that does the job and skip the platform detour. You shouldn’t have to stand up infrastructure to answer one question.',
  },
];

const friends = [
  {
    name: 'Arctos Alliance',
    href: 'https://opencollective.com/arctosalliance',
    description:
      'Supporting the long-term sustainability of Apache Arrow and Apache Parquet by funding the maintainers who keep them moving.',
  },
  {
    name: 'Columnar',
    href: 'https://columnar.tech',
    description:
      'Building ADBC tooling and advancing open standards for faster, simpler, and more secure database access.',
  },
  {
    name: 'DuckLabs',
    href: 'https://www.ducklabs.com',
    description:
      'The creators and maintainers of DuckDB, DuckLake, and Quack, and stewards of the wider DuckDB community.',
  },
  {
    name: 'MotherDuck',
    href: 'https://motherduck.com',
    description:
      'A serverless cloud data warehouse powered by DuckDB, built for teams, applications, and data agents.',
  },
];

const timeline = [
  {
    date: 'May 2024',
    milestone: 'The first extension',
    description:
      'shellfs ships — pipe shell commands straight into DuckDB SQL, and the steady cadence begins.',
    featured: ['shellfs'],
  },
  {
    date: 'Summer 2024',
    milestone: 'Crypto, geometry, and scripting',
    description:
      'Within weeks: cryptographic hashing, space-filling curves for spatial ordering, Arrow Flight connectivity, and an embedded scripting language.',
    featured: ['airport', 'lindel', 'crypto', 'evalexpr_rhai'],
  },
  {
    date: 'Late 2024',
    milestone: 'Reaching other systems',
    description:
      'HTTP serving and client calls, LLM prompting from SQL, and Apache DataSketches — which alone now sees millions of loads.',
    featured: ['datasketches', 'http_client', 'httpserver', 'openprompt'],
  },
  {
    date: '2025',
    milestone: 'Scale arrives',
    description:
      'A full JavaScript engine, probabilistic filters, and fast non-cryptographic hashing push loads into the millions every week.',
    featured: ['quickjs', 'hashfuncs', 'bitfilters', 'rapidfuzz'],
  },
  {
    date: 'Late 2025',
    milestone: 'Past thirty extensions',
    description:
      'Pentagonal geospatial indexing, an ADBC scanner, JSONata queries, templating, and string tooling round out the catalog.',
    featured: ['a5', 'adbc_scanner', 'jsonata', 'minijinja', 'inflector'],
  },
  {
    date: 'Jan 2026',
    milestone: 'VGI launches',
    description:
      'The Vector Gateway Interface turns any external system into a queryable table, with SDKs across Go, Java, Python, Rust, TypeScript, and Kotlin.',
    featured: ['events'],
  },
  {
    date: 'Apr 2026',
    milestone: 'Geometry gets smaller',
    description:
      'geosilo lands a first-class column type that delta-encodes coordinates as scaled integers and pairs with ZSTD — about 21% smaller geometry storage.',
    featured: ['geosilo'],
  },
  {
    date: 'May 2026',
    milestone: 'Haybarn',
    description:
      'An independent derived distribution of DuckDB — build-forks of Iceberg, DuckLake, Delta, and HTTPFS, plus clients for Python, Node, JDBC, Rust, and WebAssembly.',
    featured: [],
  },
  {
    date: 'Jun 2026',
    milestone: 'Orchard and Cupola',
    description:
      'Orchard opens a marketplace of VGI connectors you attach with one line of SQL, and Cupola puts a DuckDB analyst workbench — SQL, pivots, charts — in a browser tab.',
    featured: [],
  },
];
const SITE_ORIGIN = 'https://query.farm';
const description =
  "Query.Farm builds DuckDB extensions, a hardened distribution, and the tooling around them — founded by Rusty Conover, who has contributed to DuckDB's core.";
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Query.Farm',
    description,
    url: `${SITE_ORIGIN}/company/about`,
    isPartOf: { '@type': 'WebSite', name: 'Query.Farm', url: SITE_ORIGIN },
    mainEntity: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
      founder: { '@type': 'Person', name: 'Rusty Conover', url: `${SITE_ORIGIN}/company/about` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Rusty Conover',
    jobTitle: 'Founder & CEO',
    url: `${SITE_ORIGIN}/company/about`,
    image: 'https://github.com/rustyconover.png?size=220',
    worksFor: { '@type': 'Organization', name: 'Query.Farm', url: SITE_ORIGIN },
    sameAs: ['https://github.com/rustyconover', 'https://github.com/Query-farm'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: SITE_ORIGIN + '/company/about' },
    ],
  },
];
---

<PageLayout
  title="About"
  description={description}
  jsonLd={jsonLd}
>
  <PageHead eyebrow="About Query.Farm" hairband>
    <!-- Figures never set in Fraunces — DESIGN_BRIEF §2. -->
    <Fragment slot="title">
      <span class="qf-figure">{loadsLabel}</span> DuckDB extension loads a year — from one small team.
    </Fragment>
    <Fragment slot="lede">
      {extensionCount} extensions, dozens of fixes merged into DuckDB’s core, and the production
      layer on top — <a href="/products/haybarn" class="text-link no-underline underline-offset-2 hover:underline">Haybarn</a>,
      <a href="/vgi" class="text-link no-underline underline-offset-2 hover:underline">VGI</a>, and
      <a href="/products/orchard" class="text-link no-underline underline-offset-2 hover:underline">Orchard</a>.
      It started with one extension in May 2024.
    </Fragment>
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/company/schedule"
        class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
      >
        Talk with us
      </a>
      <a
        href="/products/extensions"
        class="inline-block rounded-lg border border-soil-900 px-5 py-2.5 text-sm font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
      >
        Explore the extensions
      </a>
    </div>
  </PageHead>

  <!-- Stat tiles -->
  <section class="py-12">
    <div class="section-container">
      <div class="grid grid-cols-2 gap-4 md:gap-5 lg:grid-cols-4">
        {stats.map((stat) => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] px-5 py-5 text-center">
            <div class="qf-figure text-[30px] leading-none text-sun-700 md:text-[36px]">{stat.value}</div>
            <div class="mt-2.5 text-sm leading-snug text-soil-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="border-t border-soil-300 bg-soil-100/60 py-16">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">The founder</span>
      <h2 class="mt-3">The person behind all of it</h2>

      <div class="mt-9 rounded-2xl border border-soil-300 bg-[#fffdf7] p-6 md:p-9">
        <div class="flex flex-col items-start gap-8 md:flex-row">
          <div class="mx-auto flex-shrink-0 md:mx-0">
            <img
              src="https://github.com/rustyconover.png?size=220"
              alt="Rusty Conover"
              width="160"
              height="160"
              loading="lazy"
              class="h-40 w-40 rounded-2xl border border-soil-300 object-cover"
            />
          </div>
          <div class="flex-1">
            <h3 class="text-[23px]">Rusty Conover</h3>
            <p class="qf-eyebrow mt-1.5 mb-4 text-sun-700">Founder &amp; CEO</p>
            <div class="space-y-4 text-soil-700 leading-relaxed">
              <p>
                Rusty has spent more than two decades building data infrastructure that has to
                stay up and stay fast. He was Head of Cloud Data Platform at Schonfeld Strategic
                Advisors, and held senior engineering and CTO roles at J.P. Morgan and Two Sigma,
                running petabyte-scale analytics for quantitative trading. He’s also a repeat
                founder — he co-founded and was CTO of GearBuyer / InfoGears, scaling it past
                $21M in annual transactions.
              </p>
              <p>
                Query.Farm grew out of that work. DuckDB is a superb engine, but production teams
                kept needing the same things around it: extensions, connectors, and a distribution
                hardened for real workloads. So he started building them — shellfs in May 2024, and
                {extensionCount - 1} more since. Today he contributes directly to DuckDB’s core,
                publishes the extensions this site documents, and builds the platform layer on top
                of them.
              </p>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
              <a href="https://github.com/duckdb/duckdb/pulls?q=is%3Apr+author%3Arustyconover+is%3Amerged" target="_blank" rel="noopener noreferrer" class="font-medium text-link no-underline underline-offset-2 hover:underline">{mergedCorePRs} merged PRs to DuckDB core ↗</a>
              <a href="https://github.com/rustyconover" target="_blank" rel="noopener noreferrer" class="text-soil-600 no-underline hover:text-soil-900">GitHub</a>
              <a href="https://github.com/Query-farm" target="_blank" rel="noopener noreferrer" class="text-soil-600 no-underline hover:text-soil-900">Query.Farm on GitHub</a>
            </div>
          </div>
        </div>
        <p class="mt-8 border-t border-soil-300 pt-6 text-sm text-soil-500">
          Query.Farm is founder-led and guided by a board of advisors.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-t border-soil-300 bg-soil-100/60 py-16">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Our values</span>
      <h2 class="mt-3">What we stand for</h2>
      <div class="mt-9 grid gap-5 md:grid-cols-2">
        {values.map((value) => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-6">
            <h3 class="mb-2 text-[19px]">{value.title}</h3>
            <p class="leading-relaxed text-soil-700">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnerships -->
  <section class="border-t border-soil-300 py-16">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Partnerships</span>
      <h2 class="mt-3">Building better data systems together</h2>
      <div class="mt-9 grid max-w-5xl gap-5 md:grid-cols-2">
        <div class="flex flex-col rounded-xl border border-soil-300 bg-[#fffdf7] p-6 md:p-8">
          <div class="mb-5 flex h-16 items-center">
            <img
              src="https://gizmodata.com/gizmodata-logo.png"
              alt=""
              width="159"
              height="170"
              loading="lazy"
              class="h-16 w-auto object-contain"
            />
          </div>
          <h3 class="text-[23px]">GizmoData</h3>
          <p class="qf-eyebrow mt-1.5 text-sun-700">Technology partner</p>
          <p class="mt-5 leading-relaxed text-soil-700">
            Query.Farm is a technology partner of GizmoData, the company behind GizmoSQL.
            Query.Farm’s DuckDB extensions work with GizmoSQL, bringing a broad catalog of
            additional capabilities to its users.
          </p>
          <div class="mt-auto pt-5">
            <a
              href="https://gizmodata.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-link no-underline underline-offset-2 hover:underline"
            >
              Visit GizmoData ↗
            </a>
          </div>
        </div>

        <div class="flex flex-col rounded-xl border border-soil-300 bg-[#fffdf7] p-6 md:p-8">
          <div class="mb-5 flex h-16 items-center">
            <img
              src="https://qxip.net/images/qxip.png"
              alt=""
              width="1000"
              height="406"
              loading="lazy"
              class="max-h-14 w-auto max-w-[190px] object-contain"
            />
          </div>
          <h3 class="text-[23px]">QXIP</h3>
          <p class="qf-eyebrow mt-1.5 text-sun-700">Technology partner</p>
          <p class="mt-5 leading-relaxed text-soil-700">
            Query.Farm partners with QXIP, an R&amp;D company building open-source and commercial
            observability and telecom monitoring technology for operators, service providers,
            and voice platforms around the world.
          </p>
          <div class="mt-auto pt-5">
            <a
              href="https://qxip.net"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-link no-underline underline-offset-2 hover:underline"
            >
              Visit QXIP ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Friends -->
  <section class="border-t border-soil-300 bg-soil-100/60 py-16">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Community</span>
      <h2 class="mt-3">Friends of Query.Farm</h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
        We’re proud to be part of a wider community strengthening open data infrastructure,
        DuckDB, and Arrow.
      </p>
      <div class="mt-9 grid gap-5 sm:grid-cols-2">
        {friends.map((friend) => (
          <a
            href={friend.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col rounded-xl border border-soil-300 bg-[#fffdf7] p-6 no-underline transition duration-300 ease-out hover:-translate-y-1 hover:border-sun-400 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <h3 class="text-[20px] transition-colors group-hover:text-link">{friend.name}</h3>
            <p class="mt-2 leading-relaxed text-soil-700">{friend.description}</p>
            <span class="mt-auto pt-4 text-sm font-medium text-link">Visit {friend.name} ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="border-t border-soil-300 py-16">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Our journey</span>
      <h2 class="mt-3">From one extension to a stack</h2>
      <div class="mt-9 max-w-3xl">
        <div class="space-y-8">
          {timeline.map((item) => {
            const items = chips(item.featured);
            return (
            <div class="flex gap-4 md:gap-6">
              <div class="w-20 flex-shrink-0 pt-1 text-right md:w-24">
                <div class="qf-figure text-[15px] leading-tight font-medium text-sun-700">{item.date}</div>
              </div>
              <div class="relative w-px flex-shrink-0 bg-soil-300">
                <div class="absolute top-2 -left-[7px] h-3.5 w-3.5 rounded-full border-[3px] border-[#fffdf7] bg-sun-700"></div>
              </div>
              <div class="flex-1 pb-2">
                <h3 class="mb-1 text-[19px]">{item.milestone}</h3>
                <p class="leading-relaxed text-soil-700">{item.description}</p>
                {items.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {items.map((c) => (
                      <a
                        href={`/products/extensions/${c.slug}`}
                        class="inline-flex items-baseline gap-1.5 rounded-lg border border-soil-300 bg-soil-100 px-2.5 py-1 text-sm no-underline transition-colors hover:border-sun-400 hover:bg-[#fffdf7]"
                      >
                        <span class="font-mono font-medium text-soil-900">{c.slug}</span>
                        <span class="qf-figure font-medium text-sun-700">{compactCount(c.loads as number)}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )})}
        </div>
        <p class="mt-10 text-xs text-soil-500">
          Chips show each extension’s loads over the last 90 days. Explore them all on the <a href="/products/extensions" class="text-link no-underline underline-offset-2 hover:underline">extensions page</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA — the page's single dark slab (DESIGN_BRIEF §5) -->
  <section class="pb-20">
    <div class="section-container">
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-9 text-cream">
          <span class="qf-eyebrow text-sun-400">Get in touch</span>
          <h2 class="mt-3 text-[29px] text-cream">Building on DuckDB? Let’s talk.</h2>
          <p class="mt-3 max-w-[46ch] leading-relaxed text-cream-2">
            Whether you want to adopt our extensions, run Haybarn in production, or need a hand
            with a hard data problem — we’d love to hear from you.
          </p>
        </div>

        <div class="px-8 py-9">
          <h3 class="text-[21px]">Two ways in</h3>
          <p class="mt-2.5 leading-relaxed text-soil-700">
            Book a call, or start with the catalog and see whether something we already ship does
            the job.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/company/schedule"
              class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
            >
              Schedule a call
            </a>
            <a
              href="/products"
              class="inline-block rounded-lg border border-soil-900 px-5 py-2.5 text-sm font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
            >
              Explore products
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
