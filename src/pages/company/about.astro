---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import { usageSummary } from '../../data/usage-summary';
import { extensions } from '../../data/extensions';

// Compact large counts: 186,270,588 → "186M". Mirrors the homepage helper so
// the loads figure on About matches the loads figure on the landing page.
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};
const annualLoads = usageSummary?.annualizedLoads;

// Live per-extension load counts, keyed by slug, so the timeline chips stay in
// sync with the same usage snapshot that powers the cards (no stale hardcoding).
const loadsBySlug: Record<string, number> = Object.fromEntries(
  extensions.filter((e) => typeof e.usageCount === 'number').map((e) => [e.id, e.usageCount as number])
);
// Resolve a list of slugs to {slug, loads} chips, dropping any without a count.
const chips = (slugs: string[]) =>
  slugs.map((slug) => ({ slug, loads: loadsBySlug[slug] })).filter((c) => typeof c.loads === 'number');

// The four headline numbers. Each is true and checkable — the first two are the
// strongest. The loads tile is computed live from the usage snapshot.
const stats = [
  { value: '63', label: 'merged pull requests to DuckDB core' },
  ...(annualLoads
    ? [{ value: `${compactCount(annualLoads)}+`, label: 'extension loads per year' }]
    : [{ value: '186M+', label: 'extension loads per year' }]),
  { value: '30+', label: 'DuckDB extensions published' },
  { value: 'May 2024', label: 'shipping extensions since' },
];

const values = [
  {
    title: 'Open source, and honest about what isn’t',
    description:
      'Most of what we make is open source, including the extensions this site documents. We also build commercial and closed-source products — and we tell you which is which.',
  },
  {
    title: 'We contribute to the core, not just the edges',
    description:
      'Our work lands in DuckDB itself — Arrow integration, the C API, scalar functions, statistics, serialization — so the tools we build on top stand on solid ground.',
  },
  {
    title: 'Built to be run in production',
    description:
      'Signed builds, verifiable artifacts, real load counts, and a hardened distribution. Not demos — software you can ship.',
  },
  {
    title: 'Useful before it’s a platform',
    description:
      'We ship the part that does the job and skip the platform detour. You shouldn’t have to stand up infrastructure to answer one question.',
  },
];

const pillars = [
  {
    name: 'Extensions',
    href: '/products/extensions',
    blurb: '30+ DuckDB extensions — connectors, hashing, geospatial indexing, scripting, and more.',
  },
  {
    name: 'Haybarn',
    href: '/haybarn',
    blurb: 'An independent, hardened distribution of DuckDB — signed builds, clients, and a browser engine.',
  },
  {
    name: 'VGI',
    href: '/vgi',
    blurb: 'The Vector Gateway Interface: expose any external system as a queryable DuckDB table, in any language.',
  },
];

const timeline = [
  {
    date: 'May 2024',
    milestone: 'The first extension',
    description:
      'shellfs ships — pipe shell commands straight into DuckDB SQL, and the steady cadence begins.',
    featured: ['shellfs'],
  },
  {
    date: 'Summer 2024',
    milestone: 'Crypto, geometry, and scripting',
    description:
      'Within weeks: cryptographic hashing, space-filling curves for spatial ordering, Arrow Flight connectivity, and an embedded scripting language.',
    featured: ['airport', 'lindel', 'crypto', 'evalexpr_rhai'],
  },
  {
    date: 'Late 2024',
    milestone: 'Reaching other systems',
    description:
      'HTTP serving and client calls, LLM prompting from SQL, and Apache DataSketches — which alone now sees millions of loads.',
    featured: ['datasketches', 'http_client', 'httpserver', 'openprompt'],
  },
  {
    date: '2025',
    milestone: 'Scale arrives',
    description:
      'A full JavaScript engine, probabilistic filters, and fast non-cryptographic hashing push loads into the millions every week.',
    featured: ['quickjs', 'hashfuncs', 'bitfilters', 'rapidfuzz'],
  },
  {
    date: 'Late 2025',
    milestone: 'Past thirty extensions',
    description:
      'Pentagonal geospatial indexing, an ADBC scanner, JSONata queries, templating, and string tooling round out the catalog.',
    featured: ['a5', 'adbc_scanner', 'jsonata', 'minijinja', 'inflector'],
  },
  {
    date: 'Jan 2026',
    milestone: 'VGI launches',
    description:
      'The Vector Gateway Interface turns any external system into a queryable table, with SDKs across Go, Java, Python, Rust, TypeScript, and Kotlin.',
    featured: ['events'],
  },
  {
    date: 'May 2026',
    milestone: 'Haybarn',
    description:
      'An independent derived distribution of DuckDB — build-forks of Iceberg, DuckLake, Delta, and HTTPFS, plus clients for Python, Node, JDBC, Rust, and WebAssembly.',
    featured: [],
  },
];
---

<PageLayout
  title="About"
  description="Query.Farm builds DuckDB extensions, a hardened distribution, and the tooling around them — founded by Rusty Conover, a DuckDB core contributor."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Company', href: '/company/about' },
    { name: 'About', href: '/company/about' }
  ]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-grain-50 border-b-2 border-soil-900">
    <div class="section-container py-16 lg:py-24">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-wider text-harvest-700 mb-4">About Query.Farm</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-normal text-soil-900 leading-tight">
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 shadow-sm">
            {annualLoads ? `${compactCount(annualLoads)}+` : '186M+'}
          </span>
          DuckDB extension loads a year — from one studio.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-soil-700 max-w-3xl leading-relaxed">
          30+ extensions, dozens of fixes merged into DuckDB’s core, and the production layer on
          top — <a href="/haybarn" class="font-semibold text-harvest-700 underline underline-offset-2 decoration-harvest-300 hover:decoration-harvest-700">Haybarn</a>
          and <a href="/vgi" class="font-semibold text-harvest-700 underline underline-offset-2 decoration-harvest-300 hover:decoration-harvest-700">VGI</a>. It started with one extension in May 2024.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <Button href="/company/schedule" variant="secondary" size="lg">Talk to an Expert</Button>
          <Button href="/products/extensions" variant="ghost" size="lg" class="border-2 border-soil-900 text-soil-900 hover:bg-grain-100">Explore the extensions</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Stat tiles -->
  <section class="py-12 bg-white border-b-2 border-soil-900">
    <div class="section-container">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {stats.map((stat) => (
          <div class="rounded-xl border-2 border-soil-900 bg-white px-5 py-5 shadow-sm text-center">
            <div class="text-3xl md:text-4xl font-extrabold tracking-normal text-harvest-700">{stat.value}</div>
            <div class="mt-2 text-sm text-soil-600 leading-snug">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="The founder"
        title="The person behind all of it"
        align="center"
        class="mb-12"
      />

      <div class="max-w-5xl mx-auto rounded-2xl border-2 border-soil-900 bg-white p-6 md:p-10 shadow-lg">
        <div class="flex flex-col md:flex-row gap-8 items-start">
          <div class="flex-shrink-0 mx-auto md:mx-0">
            <img
              src="https://github.com/rustyconover.png?size=220"
              alt="Rusty Conover"
              width="160"
              height="160"
              loading="lazy"
              class="w-40 h-40 rounded-2xl border-2 border-soil-900 object-cover shadow-sm"
            />
          </div>
          <div class="flex-1">
            <h3 class="text-2xl font-bold text-soil-900">Rusty Conover</h3>
            <p class="text-sm font-semibold text-harvest-700 mb-4">Founder &amp; CEO</p>
            <div class="space-y-4 text-soil-700 leading-relaxed">
              <p>
                Rusty has spent more than two decades building data infrastructure that has to
                stay up and stay fast. He was Head of Cloud Data Platform at Schonfeld Strategic
                Advisors, and held senior engineering and CTO roles at J.P. Morgan and Two Sigma,
                running petabyte-scale analytics for quantitative trading. He’s also a repeat
                founder — he co-founded and was CTO of GearBuyer / InfoGears, scaling it past
                $21M in annual transactions.
              </p>
              <p>
                Query.Farm grew out of that work. DuckDB is a superb engine, but production teams
                kept needing the same things around it: extensions, connectors, and a distribution
                hardened for real workloads. So he started building them — shellfs in May 2024,
                then thirty more. Today he contributes directly to DuckDB’s core, publishes the
                extensions this site documents, and builds the platform layer on top of them.
              </p>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
              <a href="https://github.com/duckdb/duckdb/pulls?q=is%3Apr+author%3Arustyconover+is%3Amerged" target="_blank" rel="noopener noreferrer" class="text-harvest-700 hover:text-harvest-900 underline underline-offset-2 decoration-harvest-300 hover:decoration-harvest-700">63 merged PRs to DuckDB core ↗</a>
              <a href="https://github.com/rustyconover" target="_blank" rel="noopener noreferrer" class="text-soil-600 hover:text-soil-900">GitHub</a>
              <a href="https://github.com/Query-farm" target="_blank" rel="noopener noreferrer" class="text-soil-600 hover:text-soil-900">Query.Farm on GitHub</a>
              <a href="https://rustyconover.work" target="_blank" rel="noopener noreferrer" class="text-soil-600 hover:text-soil-900">Full résumé</a>
            </div>
          </div>
        </div>
        <p class="mt-8 pt-6 border-t border-soil-200 text-sm text-soil-500">
          Query.Farm is founder-led and guided by a board of advisors.
        </p>
      </div>
    </div>
  </section>

  <!-- What we build -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="What we build"
        title="Three layers, one stack"
        description="Everything Query.Farm makes builds on DuckDB — and on each other."
        align="center"
        class="mb-12"
      />
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {pillars.map((p) => (
          <a href={p.href} class="group block rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-sm transition-all hover:-translate-y-1 hover:bg-grain-100 hover:shadow-lg">
            <h3 class="text-xl font-bold text-soil-900 group-hover:text-harvest-700 transition-colors">{p.name}</h3>
            <p class="mt-2 text-soil-700 leading-relaxed">{p.blurb}</p>
            <span class="mt-4 inline-block text-sm font-bold text-harvest-700">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our values"
        title="What we stand for"
        align="center"
        class="mb-12"
      />
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {values.map((value) => (
          <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-soil-900 mb-2">{value.title}</h3>
            <p class="text-soil-700 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        eyebrow="Our journey"
        title="From one extension to a stack"
        align="center"
        class="mb-12"
      />
      <div class="max-w-3xl mx-auto">
        <div class="space-y-8">
          {timeline.map((item) => {
            const items = chips(item.featured);
            return (
            <div class="flex gap-4 md:gap-6">
              <div class="flex-shrink-0 w-20 md:w-24 text-right pt-1">
                <div class="text-base md:text-lg font-extrabold text-harvest-700 leading-tight">{item.date}</div>
              </div>
              <div class="flex-shrink-0 w-px bg-soil-300 relative">
                <div class="absolute -left-2 top-2 w-4 h-4 rounded-full bg-harvest-600 border-4 border-white"></div>
              </div>
              <div class="flex-1 pb-2">
                <h3 class="text-xl font-bold text-soil-900 mb-1">{item.milestone}</h3>
                <p class="text-soil-700 leading-relaxed">{item.description}</p>
                {items.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {items.map((c) => (
                      <a
                        href={`/products/extensions/${c.slug}`}
                        class="inline-flex items-baseline gap-1.5 rounded-lg border border-soil-900/20 bg-grain-50 px-2.5 py-1 text-sm transition-colors hover:border-soil-900 hover:bg-grain-100"
                      >
                        <span class="font-mono font-semibold text-soil-900">{c.slug}</span>
                        <span class="font-bold text-harvest-700 tabular-nums">{compactCount(c.loads as number)}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )})}
        </div>
        <p class="mt-10 text-center text-xs text-soil-500">
          Chips show each extension’s loads over the last 90 days. Explore them all on the <a href="/products/extensions" class="underline underline-offset-2 decoration-soil-300 hover:decoration-soil-700">extensions page</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Building on DuckDB? Let’s talk.
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        Whether you want to adopt our extensions, run Haybarn in production, or need a hand with
        a hard data problem — we’d love to hear from you.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/company/schedule" variant="secondary" size="lg">
          Schedule a call
        </Button>
        <Button href="/products" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Explore products
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
