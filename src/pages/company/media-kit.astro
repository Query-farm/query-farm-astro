---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import StrataSun from '../../components/ui/StrataSun.astro';
import { usageSummary } from '../../data/usage-summary';
import { publicExtensions } from '../../data/extensions';
import { LANGUAGES } from '../../lib/vgi-docs';

// Family F — hairband + one panel (DESIGN_BRIEF.md §6). No slab.
//
// Structure is deliberately two zones, not one long list of asset sections:
// press-facing material (facts, boilerplate, the logo, naming) comes first
// and reads as a page; embeddable developer assets (status shields) are
// clearly separated after, since a journalist has no reason to read that
// far and shouldn't have to scroll past it to find what they need.

// Disabled for now — flip back on when the section is ready to ship again.
const SHOW_TYPEFACES = false;

const KIT_VERSION = '1.0';
const KIT_UPDATED = 'August 30, 2026';

// Same computed facts as /company/about — computed, not hardcoded, so this
// page can't quietly drift out of sync with the numbers press can already
// cross-check there. Mirrors that page's own compactCount helper.
const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};
const annualLoads = usageSummary?.annualizedLoads;
const loadsLabel = `${compactCount(annualLoads ?? 221_579_082)}+`;
const extensionCount = publicExtensions.length;
// Verified against github.com/duckdb/duckdb (author:rustyconover is:merged) on
// 2026-08-10 — same figure /company/about uses. Bump both when it's higher.
const mergedCorePRs = 64;
const foundedLabel = 'May 2024';
// Shipped SDKs only — LANGUAGES excludes the language-neutral Concepts entry
// (CONCEPTS is a separate export), so this is exactly the count of worker
// languages a developer can pick today.
const vgiLanguageCount = LANGUAGES.length;

// One fact per pathway (DESIGN_BRIEF's own Extend/Connect/Operate split —
// see the footer's `pathways`), so the strip doesn't read as an extensions
// catalog with a founding date attached.
const facts = [
  { value: foundedLabel, label: 'building DuckDB infrastructure since' },
  { value: String(extensionCount), label: 'open-source DuckDB extensions' },
  { value: String(vgiLanguageCount), label: 'VGI worker SDK languages' },
  { value: loadsLabel, label: 'extension loads per year' },
];

const boilerplate = [
  {
    label: 'One-liner',
    text: 'Query.Farm turns APIs, services, databases, and custom code into queryable tables — starting with DuckDB, and extending the same model to DataFusion, Trino, Spark, SQLite, and Polars.',
  },
  {
    label: 'Short — ~50 words',
    text: `Query.Farm gives DuckDB three practical paths: extend it with open-source extensions, connect it to APIs and other systems through VGI, and operate it in production with Haybarn, a signed distribution. Founded in ${foundedLabel} by Rusty Conover, who has contributed to DuckDB's core.`,
  },
  {
    label: 'Long — ~150 words',
    text: `Query.Farm gives DuckDB — and, increasingly, other query engines — three practical paths: extend it with open-source DuckDB extensions, connect it to APIs, files, and other systems through VGI (Vector Gateway Interface), and operate it in production with Haybarn, a signed and hardened distribution. Rowfence adds row- and column-level security to VGI, Cupola is a desktop client for querying with DuckDB and Haybarn, and Orchard is a growing marketplace of ready-made VGI connectors.\n\nFounded by Rusty Conover — who has contributed to DuckDB's core, and previously held senior engineering and CTO roles at J.P. Morgan, Two Sigma, and Schonfeld Strategic Advisors — Query.Farm shipped its first extension in ${foundedLabel}. Since then it has published ${extensionCount} open-source DuckDB extensions, used in more than ${loadsLabel} loads a year, shipped VGI worker SDKs in ${vgiLanguageCount} languages, and contributed ${mergedCorePRs} merged pull requests directly to DuckDB's core.`,
  },
];

// Curated, not exhaustive — the two formats someone actually reaches for.
// Every size, both grounds, and the small-size mark variant are in the zip.
const markFiles = [
  { label: 'Mark — SVG', href: '/media-kit/logo/mark.svg' },
  { label: 'Mark — PNG', href: '/media-kit/logo/mark-1024.png' },
];
const wordmarkFiles = [
  { label: 'Wordmark, light — SVG', href: '/media-kit/logo/wordmark-light.svg' },
  { label: 'Wordmark, dark — SVG', href: '/media-kit/logo/wordmark-dark.svg' },
  { label: 'Wordmark, adaptive — SVG', href: '/media-kit/logo/wordmark-adaptive.svg' },
];

const productMarks = [
  {
    name: 'Haybarn',
    blurb: 'Signed, reproducible DuckDB distribution.',
    icon: '/products/haybarn/haybarn-mark.svg',
    href: '/products/haybarn',
    file: '/media-kit/products/haybarn/haybarn-mark.svg',
  },
  {
    name: 'VGI',
    blurb: 'Vector Gateway Interface — turn anything into a table.',
    icon: '/vgi/vgi-logo.png',
    href: '/vgi',
    file: '/media-kit/products/vgi/vgi-logo.png',
  },
  {
    name: 'Rowfence',
    blurb: 'Row and column security layer for VGI.',
    icon: '/rowfence/rowfence-icon.svg',
    href: '/products/rowfence',
    file: '/media-kit/products/rowfence/rowfence-icon.svg',
  },
  {
    name: 'Cupola',
    blurb: 'Desktop client for DuckDB and Haybarn.',
    icon: '/cupola/cupola-mark.svg',
    href: '/products/cupola',
    file: '/media-kit/products/cupola/cupola-mark.svg',
  },
];

const typefaces = [
  {
    name: 'Petrona',
    role: 'Display',
    weights: 'Weight 300–700, real italic',
    usage: 'Headings and the wordmark, always weight 600 (700 in the wordmark). No opsz/SOFT/WONK axes.',
    fontFamily: "'Petrona', Georgia, serif",
    fontUrl: 'https://fonts.google.com/specimen/Petrona',
  },
  {
    name: 'Commissioner',
    role: 'Body & figures',
    weights: 'Weight 200–700',
    usage: 'Running text at 300. Every numeral on the site — tables, load counts, stats — sets in Commissioner, tabular, even inside a Petrona heading.',
    fontFamily: "'Commissioner', ui-sans-serif, system-ui, sans-serif",
    fontUrl: 'https://fonts.google.com/specimen/Commissioner',
  },
  {
    name: 'JetBrains Mono',
    role: 'Code',
    weights: 'Weight 400, 500, 600',
    usage: 'SQL, shell, and every code block — always on a rock-900 ground, never on a coloured band.',
    fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
    fontUrl: 'https://fonts.google.com/specimen/JetBrains+Mono',
  },
];

const shields = [
  { file: 'built-with-query-farm.svg', label: 'Built with Query.Farm', alt: 'built with: query.farm' },
  { file: 'powered-by-haybarn.svg', label: 'Powered by Haybarn', alt: 'powered by haybarn: query.farm' },
  { file: 'duckdb-extension.svg', label: 'DuckDB extension by Query.Farm', alt: 'duckdb extension: query.farm' },
  { file: 'vgi-worker.svg', label: 'VGI worker', alt: 'vgi worker: query.farm' },
];

function shieldSnippet(file: string, alt: string) {
  return `[![${alt}](https://query.farm/media-kit/shields/${file})](https://query.farm)`;
}
---

<PageLayout
  title="Media Kit"
  description="Facts, boilerplate copy, and the logo for writing about Query.Farm — plus embeddable buttons and badges for developers."
>
  <PageHead
    eyebrow="Press & media"
    title="Media kit"
    lede="If you're writing about Query.Farm, this is everything in one place — the facts, ready-to-use copy, and the logo. Assets for developers (README buttons, status badges) are further down. Grab what you need; ask if something's missing."
    hairband
  >
    <div slot="aside" class="hidden lg:block">
      <a
        href="/media-kit/query-farm-media-kit.zip"
        download
        class="inline-flex items-center gap-2 rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px hover:bg-field-800 motion-reduce:hover:translate-y-0"
      >
        Download full kit (.zip)
      </a>
      <p class="mt-2 text-center text-[11.5px] text-soil-500">Updated {KIT_UPDATED} · v{KIT_VERSION}</p>
    </div>
  </PageHead>

  <!-- ══ ZONE 1 — for press ═══════════════════════════════════════════ -->

  <!-- ── Facts + boilerplate ───────────────────────────────────────── -->
  <section class="py-14">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Press</span>
      <h2 class="mt-3 text-[29px] text-soil-900">Facts &amp; boilerplate</h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
        Numbers we can stand behind, and copy-paste descriptions at three lengths — for a
        byline, a program blurb, or a full write-up. These are pulled automatically from the
        same data <a href="/company/about" class="text-link no-underline underline-offset-2 hover:underline">the About page</a> uses, so nothing here goes stale.
      </p>

      <div class="mt-7 grid grid-cols-2 gap-4 md:gap-5 lg:grid-cols-4">
        {facts.map(fact => (
          <div class="rounded-xl border border-soil-300 bg-[#fffdf7] px-5 py-5 text-center">
            <div class="qf-figure text-[28px] leading-none text-sun-700 md:text-[32px]">{fact.value}</div>
            <div class="mt-2.5 text-sm leading-snug text-soil-600">{fact.label}</div>
          </div>
        ))}
      </div>

      <div class="mt-5 flex flex-col gap-3">
        {boilerplate.map(b => (
          <div class="rounded-2xl border border-soil-300 bg-[#fffdf7] p-5">
            <div class="flex items-start justify-between gap-4">
              <span class="qf-eyebrow text-soil-500">{b.label}</span>
              <button type="button" data-copy-value={b.text} class="shrink-0 rounded-md border border-soil-300 bg-soil-50 px-2.5 py-1 text-[12px] font-medium text-soil-700 transition hover:border-sun-400 hover:text-link">
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <p class="mt-2.5 max-w-[68ch] whitespace-pre-line text-[13.5px] leading-relaxed text-soil-700">{b.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2 rounded-xl border border-soil-300 bg-soil-100 px-5 py-3.5 text-[13.5px] text-soil-700">
        <span class="font-medium text-soil-900">Press inquiries:</span>
        <a href="mailto:hello@query.farm?subject=Press%20inquiry" class="text-link no-underline underline-offset-2 hover:underline">hello@query.farm</a>
        <span class="text-soil-500">— put "press" in the subject and it'll get to the right person.</span>
      </div>
    </div>
  </section>

  <!-- ── Logo ───────────────────────────────────────────────────────── -->
  <section class="border-t border-soil-300 bg-soil-100 py-14">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Logo</span>
      <h2 class="mt-3 text-[29px] text-soil-900">The Strata Sun mark</h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
        A circle clipped over four hard horizontal bands, palest at top — reads as a sun and as
        a core sample seen end-on. Petrona sets the name beside it. Don't recolor the bands,
        don't rotate the mark, and keep a little clear space around it.
      </p>

      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-5 rounded-2xl border border-soil-300 bg-[#fffdf7] p-8">
          <StrataSun size={56} animate={false} label="Query.Farm" />
          <img src="/media-kit/logo/wordmark-light.svg" alt="Query.Farm" class="h-9 w-auto" />
          <p class="text-[12.5px] font-medium text-soil-500">On light</p>
        </div>
        <div class="flex flex-col items-center justify-center gap-5 rounded-2xl border border-rock-800 bg-rock-900 p-8">
          <StrataSun size={56} animate={false} label="Query.Farm" />
          <img src="/media-kit/logo/wordmark-dark.svg" alt="Query.Farm" class="h-9 w-auto" />
          <p class="text-[12.5px] font-medium text-cream-2">On dark</p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2.5">
        {[...markFiles, ...wordmarkFiles].map(f => (
          <a
            href={f.href}
            download
            class="group inline-flex items-center gap-2 rounded-lg border border-soil-300 bg-[#fffdf7] px-3.5 py-2 text-[13px] font-medium text-soil-800 no-underline transition hover:border-sun-400 hover:text-link"
          >
            <svg class="h-3.5 w-3.5 text-soil-400 transition-colors group-hover:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
            </svg>
            {f.label}
          </a>
        ))}
        <span class="text-[13px] text-soil-500">— the "adaptive" wordmark switches itself for light/dark automatically. PNGs and the small-size mark are in the full kit.</span>
      </div>

      <!-- Product marks -->
      <div class="mt-10 border-t border-soil-300 pt-8">
        <h3 class="text-[17px] text-soil-900">Product marks</h3>
        <p class="mt-1.5 max-w-[62ch] text-[13.5px] leading-relaxed text-soil-600">
          Each product carries its own illustrated mark rather than a Petrona lockup.
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {productMarks.map(p => (
            <div class="flex flex-col rounded-2xl border border-soil-300 bg-[#fffdf7] p-5">
              <div class="flex h-16 items-center justify-center">
                <img src={p.icon} alt={`${p.name} mark`} class="h-14 w-14 object-contain" />
              </div>
              <h4 class="mt-3 text-[16px] text-soil-900">
                <a href={p.href} class="text-soil-900 no-underline hover:text-link">{p.name}</a>
              </h4>
              <p class="mt-1.5 text-[12.5px] leading-relaxed text-soil-600">{p.blurb}</p>
              <a
                href={p.file}
                download
                class="mt-3 self-start rounded-md border border-soil-300 bg-soil-50 px-2.5 py-1 text-[12px] font-medium text-soil-700 no-underline transition hover:border-sun-400 hover:text-link"
              >
                Download
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Name & trademark -->
      <div class="mt-8 rounded-2xl border border-soil-300 bg-[#fffdf7] p-6">
        <h3 class="text-[17px] text-soil-900">Writing the name</h3>
        <p class="mt-2.5 max-w-[72ch] text-[13.5px] leading-relaxed text-soil-700">
          In running text, write it like the wordmark — <strong class="font-medium text-soil-900">Query.Farm</strong>,
          capital Q, capital F, the dot kept, no space (not "QueryFarm" or "Query Farm").
          Lowercase is fine for a URL, a badge, or code — never mid-sentence.
        </p>
        <p class="mt-3 max-w-[72ch] text-[13.5px] leading-relaxed text-soil-700">
          <strong class="font-medium text-soil-900">Query.Farm</strong> is the brand. The
          registered legal entity is <strong class="font-medium text-soil-900">Query Farm LLC</strong> —
          no dot, since an LLC's legal name can't contain punctuation — use that form in a
          contract, invoice, or copyright line.
        </p>
        <p class="mt-3 max-w-[72ch] text-[13.5px] leading-relaxed text-soil-700">
          Query.Farm and the Strata Sun mark are trademarks of Query Farm LLC. You're welcome
          to use them to refer to us, but please don't recolor or distort the mark, and don't
          use it in a way that implies our endorsement.
          <a href="/company/contact" class="text-link no-underline underline-offset-2 hover:underline">Ask first</a> if you're not sure — it's almost always a quick yes.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Typefaces ──────────────────────────────────────────────────── -->
  {SHOW_TYPEFACES && (
    <section class="border-t border-soil-300 py-14">
      <div class="section-container">
        <span class="qf-eyebrow text-sun-700">Type</span>
        <h2 class="mt-3 text-[29px] text-soil-900">Typefaces</h2>
        <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
          All three are open-source Google Fonts (SIL Open Font License) — free to bundle into
          your own product or install locally. The site loads them from Google Fonts directly
          rather than shipping font files, so that's the canonical source.
        </p>

        <div class="mt-7 grid gap-4 lg:grid-cols-3">
          {typefaces.map(f => (
            <div class="flex flex-col rounded-2xl border border-soil-300 bg-[#fffdf7] p-6">
              <span class="qf-eyebrow text-soil-500">{f.role}</span>
              <p style={`font-family:${f.fontFamily}; font-weight:600;`} class="mt-2 text-[34px] leading-tight text-soil-900">
                {f.name}
              </p>
              <p style={`font-family:${f.fontFamily}; font-weight:600; font-style:italic;`} class="mt-1 text-[17px] text-soil-700">
                Aa Bb Cc 123
              </p>
              <p class="mt-3 text-[12.5px] font-medium text-soil-500">{f.weights}</p>
              <p class="mt-3 flex-1 text-[13.5px] leading-relaxed text-soil-700">{f.usage}</p>
              <a
                href={f.fontUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 text-[13px] font-medium text-link no-underline underline-offset-2 hover:underline"
              >
                Get {f.name} on Google Fonts ↗
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ ZONE 2 — for developers ══════════════════════════════════════ -->

  <section class="border-t border-soil-300 py-10">
    <div class="section-container text-center">
      <span class="qf-eyebrow text-soil-500">For developers &amp; integrators</span>
      <p class="mx-auto mt-2 max-w-[54ch] text-[13.5px] leading-relaxed text-soil-600">
        Nothing below this line is required reading for a press piece. If you're crediting
        Query.Farm in a repo, a docs page, or an app footer, these are built for that.
      </p>
    </div>
  </section>

  <!-- ── Shields ─────────────────────────────────────────────────────── -->
  <section class="border-t border-soil-300 bg-soil-100 py-14">
    <div class="section-container">
      <span class="qf-eyebrow text-sun-700">Badges</span>
      <h2 class="mt-3 text-[29px] text-soil-900">Shields</h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-soil-700">
        Embeddable status badges for a README, docs page, or app footer — plain SVG, no script
        and no network fetch. The label sets in the site's actual Commissioner, subset to a
        few KB and embedded directly in the file, with a system-sans fallback for any host
        that strips fonts from an uploaded SVG.
      </p>

      <div class="mt-7 flex flex-col gap-5">
        {shields.map(s => (
          <div class="flex flex-col gap-3 rounded-2xl border border-soil-300 bg-[#fffdf7] p-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <img src={`/media-kit/shields/${s.file}`} alt={s.alt} height="21" />
              <span class="text-[13px] text-soil-600">{s.label}</span>
            </div>
            <a
              href={`/media-kit/shields/${s.file}`}
              download
              class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-md border border-soil-300 bg-soil-50 px-3 py-1.5 text-[12.5px] font-medium text-soil-700 no-underline transition hover:border-sun-400 hover:text-link sm:self-auto"
            >
              Download SVG
            </a>
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-col gap-4">
        {shields.map(s => (
          <CodeBlock code={shieldSnippet(s.file, s.alt)} lang="markdown" tryable={false} title={s.label} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contact ─────────────────────────────────────────────────────── -->
  <section class="border-t border-soil-300 py-12">
    <div class="section-container">
      <div class="flex flex-col items-start justify-between gap-4 rounded-2xl border border-soil-300 bg-soil-100 p-6 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-[19px] text-soil-900">Need something that isn't here?</h2>
          <p class="mt-1.5 max-w-[52ch] text-[13.5px] leading-relaxed text-soil-700">
            A specific file format, a quote for a piece, or a usage question — reach out and
            we'll put it together.
          </p>
        </div>
        <a
          href="/company/contact"
          class="shrink-0 rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px hover:bg-field-800 motion-reduce:hover:translate-y-0"
        >
          Contact us →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Generic click-to-copy for [data-copy-value] — currently just the
  // boilerplate blurbs. Delegated on document so it covers every instance
  // without per-element wiring, matching CodeBlock's own copy button UX.
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest<HTMLElement>('[data-copy-value]');
    if (!trigger) return;

    const value = trigger.getAttribute('data-copy-value') ?? '';
    const label = trigger.querySelector<HTMLElement>('.copy-label') ?? trigger;
    const original = label.textContent;

    try {
      await navigator.clipboard.writeText(value);
      label.textContent = 'Copied!';
    } catch (err) {
      console.error('Copy failed:', err);
      return;
    }

    setTimeout(() => {
      label.textContent = original;
    }, 1500);
  });
</script>
