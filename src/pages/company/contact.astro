---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';

const contactEmail = 'hello@query.farm';
---

<PageLayout
  title="Contact Us"
  description="Get in touch with Query.Farm for questions about our DuckDB extensions, services, or partnerships."
  showBreadcrumbs={true}
  breadcrumbs={[
    { name: 'Company', href: '/company/about' },
    { name: 'Contact', href: '/company/contact' }
  ]}
>
  <!-- Hero Section -->
  <Hero
    title="Get in Touch"
    subtitle="Have questions about our extensions, need help with integration, or want to discuss a partnership? We'd love to hear from you."
  />

  <!-- Contact Section -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-2xl mx-auto">
        <Card padding="lg" class="text-center">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-harvest-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>

          <h2 class="text-2xl font-bold text-soil-900 mb-4">Email Us</h2>
          <p class="text-soil-700 mb-6 leading-relaxed">
            For general inquiries, support questions, partnership opportunities, or academic pricing requests, reach out to us at:
          </p>

          <a
            href={`mailto:${contactEmail}`}
            class="inline-flex items-center gap-2 text-2xl font-semibold text-harvest-700 hover:text-harvest-800 transition-colors"
          >
            <span>{contactEmail}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <p class="text-sm text-soil-500 mt-6">
            We typically respond within 1-2 business days.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Additional Info -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="Quick Links"
          title="Looking for Something Specific?"
          align="center"
          class="mb-12"
        />

        <div class="grid md:grid-cols-3 gap-6">
          <Card padding="md" class="text-center hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-soil-100 flex items-center justify-center text-2xl">
              📦
            </div>
            <h3 class="font-bold text-soil-900 mb-2">Extensions</h3>
            <p class="text-sm text-soil-600 mb-4">Browse our catalog of DuckDB extensions.</p>
            <a href="/products/extensions" class="text-sm font-medium text-harvest-700 hover:text-harvest-800">
              View Extensions →
            </a>
          </Card>

          <Card padding="md" class="text-center hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-soil-100 flex items-center justify-center text-2xl">
              🛠️
            </div>
            <h3 class="font-bold text-soil-900 mb-2">Consulting</h3>
            <p class="text-sm text-soil-600 mb-4">Need help with your data infrastructure?</p>
            <a href="/consulting" class="text-sm font-medium text-harvest-700 hover:text-harvest-800">
              Learn More →
            </a>
          </Card>

          <Card padding="md" class="text-center hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-soil-100 flex items-center justify-center text-2xl">
              👥
            </div>
            <h3 class="font-bold text-soil-900 mb-2">About Us</h3>
            <p class="text-sm text-soil-600 mb-4">Learn about our team and mission.</p>
            <a href="/company/about" class="text-sm font-medium text-harvest-700 hover:text-harvest-800">
              Meet the Team →
            </a>
          </Card>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
