---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';

const contactEmail = 'hello@query.farm';

const links = [
  {
    title: 'Extensions',
    blurb: 'Browse the catalog of DuckDB extensions, with load counts and full function docs.',
    href: '/products/extensions',
    cta: 'View extensions →',
  },
  {
    title: 'Consulting',
    blurb: 'Custom extensions, VGI workers, and production data platforms.',
    href: '/consulting',
    cta: 'How it works →',
  },
  {
    title: 'Schedule',
    blurb: 'Book thirty minutes with us — no prep needed, bring your questions.',
    href: '/company/schedule',
    cta: 'Pick a time →',
  },
];
---

<PageLayout
  title="Contact Us"
  description="Get in touch with Query.Farm for questions about our DuckDB extensions, services, or partnerships."
>
  <PageHead
    title="Get in touch"
    lede="Questions about an extension, help with an integration, or a partnership to talk through — one address reaches all of it."
    hairband
  />

  <section class="py-14">
    <div class="section-container">
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-9 text-cream">
          <span class="text-[13.5px] font-medium text-sun-400">Write to us</span>
          <h2 class="mt-3 text-[29px] text-cream">A real person reads it</h2>
          <p class="mt-3 max-w-[46ch] leading-relaxed text-cream-2">
            There's no ticketing system and no sales sequence behind this address. General
            questions, support, partnerships, and academic pricing all land in the same inbox.
          </p>
          <ul class="mt-6 flex flex-col gap-2.5 text-[14.5px]">
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> Reply within 1–2 working days</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> Attachments and long briefs welcome</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> Bug reports can go straight to GitHub instead</li>
          </ul>
        </div>

        <div class="flex flex-col justify-center px-8 py-9">
          <span class="text-[12.5px] font-medium text-soil-600">Email</span>
          <a
            href={`mailto:${contactEmail}`}
            class="mt-2 inline-flex items-baseline gap-2 font-display text-[clamp(1.5rem,3vw,2rem)] font-semibold text-link no-underline underline-offset-4 hover:underline"
          >
            {contactEmail}
            <span aria-hidden="true">→</span>
          </a>

          <p class="mt-5 leading-relaxed text-soil-700">
            Useful things to include: what you're trying to query, which DuckDB version you're on,
            and what you've already tried.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/company/schedule"
              class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
            >
              Book a call instead
            </a>
            <a
              href="https://github.com/Query-farm"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-lg border border-soil-900 px-5 py-2.5 text-sm font-medium no-underline transition hover:-translate-y-px hover:border-link hover:text-link motion-reduce:hover:translate-y-0"
            >
              Open a GitHub issue ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-soil-300 py-14">
    <div class="section-container">
      <span class="text-[13.5px] font-medium text-sun-700">Quick links</span>
      <h2 class="mt-3">Looking for something specific?</h2>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {links.map(link => (
          <a
            href={link.href}
            class="group block rounded-xl border border-soil-300 bg-[#fffdf7] p-6 no-underline transition duration-300 ease-out hover:-translate-y-1 hover:border-sun-400 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <h3 class="text-[21px] transition-colors group-hover:text-link">{link.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">{link.blurb}</p>
            <span class="mt-4 inline-block text-[12.5px] font-medium text-link">{link.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
