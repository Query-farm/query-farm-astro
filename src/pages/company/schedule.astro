---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';

// Cal.com embed configuration. Profile-level link (renders the event-type chooser).
const calLink = 'queryfarm';
const calUrl = `https://cal.com/${calLink}`;

const SITE_ORIGIN = 'https://query.farm';
const description = 'Book a 30-minute meeting with the Query.Farm team — for consulting, custom DuckDB extension work, or VGI questions.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Schedule a Meeting',
    description,
    url: `${SITE_ORIGIN}/company/schedule`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Schedule a Meeting', item: SITE_ORIGIN + '/company/schedule' },
    ],
  },
];
---

<PageLayout
  title="Schedule a Meeting"
  description={description}
  jsonLd={jsonLd}
>
  <PageHead
    title="Thirty minutes, no deck"
    lede="Book a call to talk through DuckDB extensions, VGI integrations, or a consulting engagement. No prep needed — bring your questions."
    hairband
  />

  <section class="py-12">
    <div class="section-container">
      <div class="overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7]">
        <div class="flex items-center justify-between gap-3 border-b border-soil-300 bg-[#fbf7ee] px-4 py-2.5 text-[12.5px] font-medium text-soil-600">
          <span>Pick a time</span>
          <span>cal.com/{calLink}</span>
        </div>

        <!-- Cal.com inline embed -->
        <div id="cal-inline" style="min-height: 720px;">
          <noscript>
            <div class="p-8 text-center">
              <p class="mb-4 text-soil-700">JavaScript is required to load the scheduler.</p>
              <a
                href={calUrl}
                class="inline-block rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white no-underline"
              >
                Open scheduler in a new tab →
              </a>
            </div>
          </noscript>
        </div>
      </div>

      <!-- Fallback link (also visible above the embed for users on flaky networks) -->
      <p class="mt-4 text-center text-[13.5px] text-soil-600">
        Embed not loading?
        <a href={calUrl} target="_blank" rel="noopener noreferrer" class="text-link no-underline underline-offset-2 hover:underline">
          Open the scheduler directly →
        </a>
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="section-container">
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-9 text-cream">
          <span class="text-[13.5px] font-medium text-sun-400">On the call</span>
          <h2 class="mt-3 text-[29px] text-cream">What actually happens</h2>
          <ul class="mt-6 flex flex-col gap-2.5 text-[14.5px]">
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> You describe what you're trying to query</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> We say whether an extension already does it</li>
            <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> We say if you don't need us yet</li>
          </ul>
        </div>

        <div class="px-8 py-9">
          <h2 class="text-[21px]">Or reach us another way</h2>
          <dl class="mt-5 space-y-5">
            <div>
              <dt class="text-[12.5px] font-medium text-soil-600">Email</dt>
              <dd class="mt-1 text-sm leading-relaxed text-soil-700">
                Best for project briefs, questions with attachments, or async conversations.<br />
                <a href="mailto:hello@query.farm" class="text-link no-underline underline-offset-2 hover:underline">hello@query.farm</a>
              </dd>
            </div>
            <div>
              <dt class="text-[12.5px] font-medium text-soil-600">GitHub</dt>
              <dd class="mt-1 text-sm leading-relaxed text-soil-700">
                Issues, PRs, and feature requests for any of our open-source extensions.<br />
                <a href="https://github.com/Query-farm" target="_blank" rel="noopener noreferrer" class="text-link no-underline underline-offset-2 hover:underline">github.com/Query-farm ↗</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline define:vars={{ calLink }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else { p(cal, ar); }
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "schedule", { origin: "https://cal.com" });
  Cal.ns.schedule("inline", {
    elementOrSelector: "#cal-inline",
    config: { layout: "month_view" },
    calLink: calLink,
  });
  Cal.ns.schedule("ui", {
    theme: "light",
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>
