---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';

// Cal.com embed configuration. Profile-level link (renders the event-type chooser).
const calLink = 'queryfarm';
const calUrl = `https://cal.com/${calLink}`;
---

<PageLayout
  title="Schedule a Meeting"
  description="Book a 30-minute meeting with the Query.Farm team — for consulting, custom DuckDB extension work, or VGI questions."
>
  <Hero
    title="Schedule a Meeting"
    subtitle="Book a 30-minute call to talk through DuckDB extensions, VGI integrations, or a consulting engagement. No prep needed — bring your questions."
  />

  <section class="py-12 lg:py-16 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <!-- Cal.com inline embed -->
        <div id="cal-inline" class="rounded-xl overflow-hidden border border-soil-200 bg-white" style="min-height: 720px;">
          <noscript>
            <div class="p-8 text-center">
              <p class="text-soil-700 mb-4">JavaScript is required to load the scheduler.</p>
              <Button href={calUrl} variant="primary" size="md">Open scheduler in a new tab →</Button>
            </div>
          </noscript>
        </div>

        <!-- Fallback link (also visible above the embed for users on flaky networks) -->
        <p class="mt-6 text-center text-sm text-soil-600">
          Embed not loading? <a href={calUrl} target="_blank" rel="noopener noreferrer" class="text-harvest-700 underline">Open the scheduler directly →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-soil-50">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-soil-900 mb-6 text-center">Or reach us another way</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <Card padding="lg">
            <h3 class="text-lg font-bold text-soil-900 mb-2">📧 Email</h3>
            <p class="text-soil-700 mb-4 text-sm">Best for project briefs, questions with attachments, or async conversations.</p>
            <a href="mailto:hello@query.farm" class="text-harvest-700 underline">hello@query.farm</a>
          </Card>
          <Card padding="lg">
            <h3 class="text-lg font-bold text-soil-900 mb-2">💬 GitHub</h3>
            <p class="text-soil-700 mb-4 text-sm">Issues, PRs, and feature requests for any of our open-source extensions.</p>
            <a href="https://github.com/Query-farm" target="_blank" rel="noopener noreferrer" class="text-harvest-700 underline">github.com/Query-farm</a>
          </Card>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline define:vars={{ calLink }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else { p(cal, ar); }
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "schedule", { origin: "https://cal.com" });
  Cal.ns.schedule("inline", {
    elementOrSelector: "#cal-inline",
    config: { layout: "month_view" },
    calLink: calLink,
  });
  Cal.ns.schedule("ui", {
    theme: "light",
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>
