---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';

const buttondownList = 'queryfarm-dispatch';

const promises = [
  'New DuckDB extension releases — what they do, how to install, what to watch out for.',
  'VGI updates — new language SDKs, protocol changes, real-world usage notes.',
  'Occasional deep dives — DuckDB internals, performance, design decisions we made and why.',
];

const SITE_ORIGIN = 'https://query.farm';
const description = 'Subscribe to the Query.Farm newsletter for updates on new DuckDB extensions, VGI releases, and posts from the team.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Newsletter',
    description,
    url: `${SITE_ORIGIN}/company/newsletter`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Newsletter', item: SITE_ORIGIN + '/company/newsletter' },
    ],
  },
];
---

<PageLayout
  title="Newsletter"
  description={description}
  jsonLd={jsonLd}
>
  <PageHead
    title="The Query.Farm dispatch"
    lede="Updates on new DuckDB extensions, VGI releases, and the occasional deep dive — straight to your inbox. No spam, easy unsubscribe."
    hairband
  />

  <section class="py-14">
    <div class="section-container">
      <div class="grid overflow-hidden rounded-2xl border border-soil-300 bg-[#fffdf7] md:grid-cols-[1fr_1.1fr]">
        <div class="bg-pipe-6 px-8 py-9 text-cream">
          <span class="text-[13.5px] font-medium text-sun-400">What you'll get</span>
          <h2 class="mt-3 text-[29px] text-cream">Sent when there's something to send</h2>
          <ul class="mt-6 flex flex-col gap-3 text-[14.5px] text-cream">
            {promises.map(promise => (
              <li class="flex gap-2.5"><span class="shrink-0 text-sun-400">✓</span> {promise}</li>
            ))}
          </ul>
          <p class="mt-7 text-[13.5px] text-cream-2">
            Prefer to read it here? The same writing lands on the
            <a href="/blog" class="text-sun-400 no-underline underline-offset-2 hover:underline">blog</a>.
          </p>
        </div>

        <div class="px-8 py-9">
          <h2 class="text-[21px]">Subscribe</h2>
          <p class="mt-2.5 text-[13.5px] leading-relaxed text-soil-700">
            One field, no confirmation dance beyond the double opt-in.
          </p>

          <form
            action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownList}`}
            method="post"
            target="popupwindow"
            onsubmit={`window.open('https://buttondown.com/${buttondownList}', 'popupwindow')`}
            class="mt-6"
          >
            <div class="flex flex-col gap-1.5">
              <label for="bd-email" class="text-[12.5px] font-medium text-soil-600">
                Email address
              </label>
              <input
                id="bd-email"
                type="email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full rounded-lg border border-soil-300 bg-[#fffdf7] px-3.5 py-2.5 text-[15.5px] font-light text-soil-900 transition placeholder:text-soil-500 focus:border-link focus:ring-[3px] focus:ring-link/20 focus:outline-none"
              />
            </div>

            <button
              type="submit"
              class="mt-4 w-full rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white transition hover:-translate-y-px motion-reduce:hover:translate-y-0 sm:w-auto"
            >
              Subscribe
            </button>

            <p class="mt-3.5 text-[13px] text-soil-600">
              You'll be redirected to a Buttondown confirmation page. We use Buttondown — your
              email isn't shared with anyone else.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
