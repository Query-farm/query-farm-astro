---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import AgentSessionReplay from '../../components/vgi/AgentSessionReplay.astro';
import { vgiSkillsFile } from '../../lib/vgi-agents';
---
<PageLayout title="Watch a real agent build a VGI worker" description="Step through recorded Claude Code tool calls, generated source, and verified DuckDB results.">
  <VGISubNav />
  <section class="section-container py-12" data-replay-page>
    <div class="mb-7" data-replay-intro><a class="text-link underline text-sm" href="/vgi/build-with-an-agent/">← Build with your agent</a><h1 class="mt-5 text-4xl text-soil-900">From a request to a tested worker.</h1><p class="mt-4 max-w-[80ch] leading-relaxed text-soil-700">Step through a real Claude Code session. These are selected tool calls, generated source, and actual results. The replay omits setup and dependency inspection; the CSV follow-on was verified after the build.</p></div>
    <AgentSessionReplay />
    <p class="mt-6 text-sm leading-relaxed text-soil-700" data-replay-links><a class="text-link underline" href="/vgi/agents/build-transcript.txt">Read the selected tool transcript</a> · <a class="text-link underline" href={vgiSkillsFile('examples/agent-duckdb-typescript-slugify/README.md')}>Source and tests</a> · <a class="text-link underline" href={vgiSkillsFile('evals/RESULTS.md')}>Evaluation details</a></p>
  </section>
</PageLayout>
