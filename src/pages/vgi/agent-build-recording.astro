---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import VgiWalkthroughVideo from '../../components/vgi/VgiWalkthroughVideo.astro';
import { vgiSkillsFile } from '../../lib/vgi-agents';
---
<PageLayout title="Full recording: Codex builds a GitHub VGI integration" description="The original screen capture of a coding agent writing and testing a GitHub API integration for DuckDB.">
  <VGISubNav />
  <section class="section-container py-12">
    <a class="text-link underline text-sm" href="/vgi/build-with-an-agent/">← Build with your agent</a>
    <h1 class="mt-5 text-4xl text-soil-900">The actual agent session, at original speed.</h1>
    <p class="mt-4 mb-7 max-w-[80ch] leading-relaxed text-soil-700">This capture shows a live terminal connected to Codex CLI. It includes the initial folder trust confirmation, SDK inspection, generated source, tests, and the live API query. Python was selected for this demo; your worker can use any supported SDK language.</p>
    <VgiWalkthroughVideo compact full />
    <p class="mt-6 text-sm leading-relaxed text-soil-700"><a class="text-link underline" href={vgiSkillsFile('examples/agent-github-releases/README.md')}>Generated source, tests, and reproduction commands →</a></p>
  </section>
</PageLayout>
