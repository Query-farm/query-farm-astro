---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

// Source of truth: vgi-rpc-website/src/components/LanguageCards.astro
const languages = [
  {
    name: 'Python',
    id: 'python',
    icon: '🐍',
    status: 'Reference Implementation',
    statusColor: 'bg-harvest-100 text-harvest-700',
    description: 'The original implementation with full feature support — strict mypy typing, all transports, streaming, introspection, shared memory, and OpenTelemetry. Two layers: `vgi-rpc` for the transport, `vgi` for the higher-level DuckDB worker framework.',
    repo: 'https://github.com/Query-farm/vgi-python',
    docs: 'https://vgi-rpc-python.query.farm',
    install: 'pip install vgi          # DuckDB worker framework\npip install vgi-rpc      # RPC layer only',
    example: `from typing import Annotated
import pyarrow as pa
import pyarrow.compute as pc
from vgi import ScalarFunction, Param, Returns, Worker


class Upper(ScalarFunction):
    @classmethod
    def compute(
        cls,
        s: Annotated[pa.StringArray, Param()],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.utf8_upper(s)


class W(Worker):
    functions = [Upper]


if __name__ == "__main__":
    W().run()`,
    exampleLang: 'python',
    exampleTitle: 'worker.py'
  },
  {
    name: 'TypeScript',
    id: 'typescript',
    icon: '📘',
    status: 'Feature Parity',
    statusColor: 'bg-harvest-100 text-harvest-700',
    description: 'Full-featured TypeScript implementation for Bun, Node.js, and Deno. HTTP server/client, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-rpc-typescript',
    docs: 'https://vgi-rpc-typescript.query.farm',
    install: 'bun add @query-farm/vgi-rpc\nnpm install @query-farm/vgi-rpc',
    example: `import { protocol, runStdio } from "@query-farm/vgi-rpc";

const service = protocol()
  .unary({
    name: "upper",
    params: { s: "str" },
    result: "str",
  }, ({ s }) => ({ result: s.toUpperCase() }));

await runStdio(service);`,
    exampleLang: 'typescript',
    exampleTitle: 'worker.ts'
  },
  {
    name: 'Go',
    id: 'go',
    icon: '🐹',
    status: 'Feature Parity',
    statusColor: 'bg-harvest-100 text-harvest-700',
    description: 'Full-featured Go implementation built on apache/arrow-go. HTTP server, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-rpc-go',
    docs: 'https://vgi-rpc-go.query.farm',
    install: 'go get github.com/Query-farm/vgi-rpc/vgirpc',
    example: `package main

import (
    "context"
    "strings"
    "github.com/Query-farm/vgi-rpc/vgirpc"
)

type UpperParams struct {
    S string \`vgirpc:"s"\`
}

func main() {
    server := vgirpc.NewServer()
    vgirpc.Unary(server, "upper",
      func(_ context.Context, _ *vgirpc.CallContext, p UpperParams) (string, error) {
        return strings.ToUpper(p.S), nil
      })
    server.RunStdio()
}`,
    exampleLang: 'go',
    exampleTitle: 'main.go'
  },
  {
    name: 'Rust',
    id: 'rust',
    icon: '🦀',
    status: 'Feature Parity',
    statusColor: 'bg-harvest-100 text-harvest-700',
    description: 'Rust workspace tracking the Python reference byte-for-byte on the wire — 452 / 452 conformance tests pass across pipe, subprocess, http, and unix transports. Optional features for HTTP, JWT, OAuth-PKCE, mTLS, OpenTelemetry, and Sentry.',
    repo: 'https://github.com/Query-farm/vgi-rpc-rust',
    docs: 'https://vgi-rpc-rust.query.farm',
    install: 'cargo add vgi-rpc',
    example: `use std::sync::Arc;
use arrow_schema::{DataType, Field, Schema};
use vgi_rpc::{MethodInfo, RpcServer};

#[tokio::main]
async fn main() {
    let mut srv = RpcServer::builder()
        .protocol_name("MyService")
        .build();

    let params = Arc::new(Schema::new(vec![
        Field::new("s", DataType::Utf8, false),
    ]));
    let result = Arc::new(Schema::new(vec![
        Field::new("result", DataType::Utf8, false),
    ]));

    srv.register(MethodInfo::unary("upper", params, result, /* handler */));
    srv.run_stdio().await.unwrap();
}`,
    exampleLang: 'rust',
    exampleTitle: 'main.rs'
  },
  {
    name: 'Java',
    id: 'java',
    icon: '☕',
    status: 'In Development',
    statusColor: 'bg-grain-100 text-grain-800',
    description: 'Java 21 server framework under the `farm.query.vgirpc` package. Stdio, Unix-socket, and HTTP transports; bearer / JWT / mTLS authenticators; access-log hooks. Conformance-tested against the Python reference; Maven publishing in progress.',
    repo: 'https://github.com/Query-farm/vgi-rpc-java',
    docs: 'https://vgi-rpc-java.query.farm',
    install: '# Gradle (Java 21):\nimplementation("farm.query:vgi-rpc:0.1.0-SNAPSHOT")',
    example: null,
    exampleLang: null,
    exampleTitle: null
  },
  {
    name: 'C++',
    id: 'cpp',
    icon: '⚡',
    status: 'In Development',
    statusColor: 'bg-grain-100 text-grain-800',
    description: 'C++20 server framework with pipe and subprocess transports. All RPC patterns (unary, producer, exchange), introspection, error propagation, client logging, and stream headers. Conformance-tested against the Python reference.',
    repo: 'https://github.com/Query-farm/vgi-rpc-cpp',
    docs: 'https://vgi-rpc-cpp.query.farm',
    install: '# CMake / vcpkg integration — see the docs site',
    example: null,
    exampleLang: null,
    exampleTitle: null
  }
];
---

<PageLayout
  title="VGI — Language SDKs"
  description="VGI implementations for Python, TypeScript, Go, Rust, Java, and C++. Pick the SDK that matches your stack and ship functionality DuckDB can call."
>
  <Hero
    title="Workers in Your Language"
    subtitle="One wire protocol, multiple implementations. All SDKs interoperate via the same Apache Arrow IPC format."
    primaryCTA={{ text: "vgi-rpc.query.farm", href: "https://vgi-rpc.query.farm" }}
    secondaryCTA={{ text: "Architecture →", href: "/vgi/architecture" }}
  />

  <!-- Status legend / context -->
  <section class="py-8 bg-soil-50 border-b border-soil-200">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center text-sm text-soil-700">
        Each SDK has its own dedicated docs site under <code class="text-xs bg-white px-2 py-0.5 rounded border border-soil-200">vgi-rpc-&lt;lang&gt;.query.farm</code> with full API reference, transports, examples, and benchmarks.
      </div>
    </div>
  </section>

  <!-- Language sections -->
  {languages.map(lang => (
    <section id={lang.id} class="py-16 lg:py-20 bg-white odd:bg-soil-50 scroll-mt-24">
      <div class="section-container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
            <!-- Left: heading + pitch + links -->
            <div class="lg:col-span-2">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-5xl">{lang.icon}</span>
                <div>
                  <h2 class="text-3xl font-bold text-soil-900">{lang.name}</h2>
                  <span class={`inline-block mt-1 text-xs font-semibold px-2 py-0.5 rounded ${lang.statusColor}`}>
                    {lang.status}
                  </span>
                </div>
              </div>
              <p class="text-soil-700 leading-relaxed mb-4">{lang.description}</p>
              <div class="space-y-3">
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wide text-soil-500 mb-1">Install</div>
                  <pre class="text-xs bg-soil-900 text-soil-100 p-3 rounded overflow-x-auto font-mono leading-relaxed">{lang.install}</pre>
                </div>
                <div class="flex flex-wrap gap-2 pt-2">
                  <Button href={lang.docs} variant="primary" size="sm">Docs →</Button>
                  <Button href={lang.repo} variant="secondary" size="sm">GitHub</Button>
                </div>
              </div>
            </div>

            <!-- Right: code example -->
            <div class="lg:col-span-3">
              {lang.example ? (
                <CodeBlock code={lang.example} lang={lang.exampleLang} title={lang.exampleTitle} />
              ) : (
                <Card padding="lg" class="bg-soil-50 border-2 border-dashed border-soil-300">
                  <div class="text-center py-8">
                    <div class="text-4xl mb-3">🚧</div>
                    <h3 class="text-lg font-bold text-soil-900 mb-2">Active Development</h3>
                    <p class="text-sm text-soil-700 mb-4">The C++ SDK is under active development — full conformance with the Python reference is the gate for a 1.0 release.</p>
                    <Button href={lang.repo} variant="ghost" size="sm">Track progress on GitHub →</Button>
                  </div>
                </Card>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Don't see your language -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          eyebrow="Don't see your language?"
          title="VGI is a protocol — anyone can implement it"
          align="center"
          class="mb-6"
        />
        <p class="text-soil-700 leading-relaxed mb-6">
          The wire format is Apache Arrow IPC over a pluggable transport. If your language has Arrow bindings (Java, Rust, R, Julia, …) it can speak VGI. The full byte-level spec lives at <a href="https://vgi-rpc.query.farm/wire-protocol" class="text-harvest-700 underline">vgi-rpc.query.farm/wire-protocol</a>.
        </p>
        <p class="text-soil-700 leading-relaxed">
          Working on a port? <a href="/company/contact" class="text-harvest-700 underline">Get in touch</a> — we're happy to help, and to list it here.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Need a custom worker built?</h2>
      <p class="text-lg md:text-xl text-harvest-50 mb-6">
        We build VGI workers and DuckDB extensions for clients across stacks.
      </p>
      <Button href="/consulting" variant="secondary" size="lg">Talk to us</Button>
    </div>
  </section>
</PageLayout>
