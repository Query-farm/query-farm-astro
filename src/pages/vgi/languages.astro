---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { Icon } from 'astro-icon/components';

const REF = 'bg-harvest-100 text-harvest-800 ring-1 ring-harvest-300';
const PARITY = 'bg-harvest-100 text-harvest-800 ring-1 ring-harvest-300';
const DEV = 'bg-amber-100 text-amber-800 ring-1 ring-amber-300';

// Source of truth: vgi-rpc-website/src/components/LanguageCards.astro
const languages = [
  {
    name: 'Python',
    id: 'python',
    icon: 'simple-icons:python',
    tone: 'bg-harvest-100',
    status: 'Reference Implementation',
    statusColor: REF,
    description: 'The original implementation with full feature support — strict mypy typing, all transports, streaming, introspection, shared memory, and OpenTelemetry. Two layers: `vgi-rpc` for the transport, `vgi` for the higher-level DuckDB worker framework.',
    repo: 'https://github.com/Query-farm/vgi-python',
    docs: 'https://vgi-rpc-python.query.farm',
    install: 'pip install vgi          # DuckDB worker framework\npip install vgi-rpc      # RPC layer only',
    example: `from typing import Annotated
import pyarrow as pa
import pyarrow.compute as pc
from vgi import ScalarFunction, Param, Returns, Worker


class Upper(ScalarFunction):
    @classmethod
    def compute(
        cls,
        s: Annotated[pa.StringArray, Param()],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.utf8_upper(s)


class W(Worker):
    functions = [Upper]


if __name__ == "__main__":
    W().run()`,
    exampleLang: 'python',
    exampleTitle: 'worker.py'
  },
  {
    name: 'TypeScript',
    id: 'typescript',
    icon: 'simple-icons:typescript',
    tone: 'bg-duck-100',
    status: 'Feature Parity',
    statusColor: PARITY,
    description: 'Full-featured TypeScript implementation for Bun, Node.js, and Deno. HTTP server/client, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-rpc-typescript',
    docs: 'https://vgi-rpc-typescript.query.farm',
    install: 'bun add @query-farm/vgi-rpc\nnpm install @query-farm/vgi-rpc',
    example: `import { protocol, runStdio } from "@query-farm/vgi-rpc";

const service = protocol()
  .unary({
    name: "upper",
    params: { s: "str" },
    result: "str",
  }, ({ s }) => ({ result: s.toUpperCase() }));

await runStdio(service);`,
    exampleLang: 'typescript',
    exampleTitle: 'worker.ts'
  },
  {
    name: 'Go',
    id: 'go',
    icon: 'simple-icons:go',
    tone: 'bg-grain-100',
    status: 'Feature Parity',
    statusColor: PARITY,
    description: 'Full-featured Go implementation built on apache/arrow-go. HTTP server, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-rpc-go',
    docs: 'https://vgi-rpc-go.query.farm',
    install: 'go get github.com/Query-farm/vgi-rpc/vgirpc',
    example: `package main

import (
    "context"
    "strings"
    "github.com/Query-farm/vgi-rpc/vgirpc"
)

type UpperParams struct {
    S string \`vgirpc:"s"\`
}

func main() {
    server := vgirpc.NewServer()
    vgirpc.Unary(server, "upper",
      func(_ context.Context, _ *vgirpc.CallContext, p UpperParams) (string, error) {
        return strings.ToUpper(p.S), nil
      })
    server.RunStdio()
}`,
    exampleLang: 'go',
    exampleTitle: 'main.go'
  },
  {
    name: 'Rust',
    id: 'rust',
    icon: 'simple-icons:rust',
    tone: 'bg-earth-100',
    status: 'Feature Parity',
    statusColor: PARITY,
    description: 'Rust workspace tracking the Python reference byte-for-byte on the wire — 452 / 452 conformance tests pass across pipe, subprocess, http, and unix transports. Optional features for HTTP, JWT, OAuth-PKCE, mTLS, OpenTelemetry, and Sentry.',
    repo: 'https://github.com/Query-farm/vgi-rpc-rust',
    docs: 'https://vgi-rpc-rust.query.farm',
    install: 'cargo add vgi-rpc',
    example: `use std::sync::Arc;
use arrow_schema::{DataType, Field, Schema};
use vgi_rpc::{MethodInfo, RpcServer};

#[tokio::main]
async fn main() {
    let mut srv = RpcServer::builder()
        .protocol_name("MyService")
        .build();

    let params = Arc::new(Schema::new(vec![
        Field::new("s", DataType::Utf8, false),
    ]));
    let result = Arc::new(Schema::new(vec![
        Field::new("result", DataType::Utf8, false),
    ]));

    srv.register(MethodInfo::unary("upper", params, result, /* handler */));
    srv.run_stdio().await.unwrap();
}`,
    exampleLang: 'rust',
    exampleTitle: 'main.rs'
  },
  {
    name: 'Java',
    id: 'java',
    icon: 'simple-icons:openjdk',
    tone: 'bg-duck-100',
    status: 'In Development',
    statusColor: DEV,
    description: 'Java 21 server framework under the `farm.query.vgirpc` package. Stdio, Unix-socket, and HTTP transports; bearer / JWT / mTLS authenticators; access-log hooks. Conformance-tested against the Python reference; Maven publishing in progress.',
    repo: 'https://github.com/Query-farm/vgi-rpc-java',
    docs: 'https://vgi-rpc-java.query.farm',
    install: '# Gradle (Java 21):\nimplementation("farm.query:vgi-rpc:0.1.0-SNAPSHOT")',
    example: null,
    exampleLang: null,
    exampleTitle: null
  },
  {
    name: 'C++',
    id: 'cpp',
    icon: 'simple-icons:cplusplus',
    tone: 'bg-grain-100',
    status: 'In Development',
    statusColor: DEV,
    description: 'C++20 server framework with pipe and subprocess transports. All RPC patterns (unary, producer, exchange), introspection, error propagation, client logging, and stream headers. Conformance-tested against the Python reference.',
    repo: 'https://github.com/Query-farm/vgi-rpc-cpp',
    docs: 'https://vgi-rpc-cpp.query.farm',
    install: '# CMake / vcpkg integration — see the docs site',
    example: null,
    exampleLang: null,
    exampleTitle: null
  }
];
---

<PageLayout
  title="VGI — Language SDKs"
  description="VGI implementations for Python, TypeScript, Go, Rust, Java, and C++. Pick the SDK that matches your stack and ship functionality DuckDB can call."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-14 font-display lg:py-20">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="vgi-lang-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#vgi-lang-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
          <img src="/vgi/vgi-logo.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
          Language SDKs
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-normal text-soil-900 leading-tight">
          Workers in your
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">language.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-soil-700 leading-relaxed">
          One wire protocol, multiple implementations. Every SDK interoperates over the same Apache Arrow IPC format.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="https://vgi-rpc.query.farm" variant="accent" size="lg" external>vgi-rpc.query.farm</Button>
          <Button href="/vgi/architecture" variant="secondary" size="lg">Architecture →</Button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- Jump nav + context -->
  <section class="py-8 bg-soil-50 border-b border-soil-200 font-display">
    <div class="section-container">
      <div class="flex flex-wrap justify-center gap-2">
        {languages.map(l => (
          <a href={`#${l.id}`} class="inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-3 py-1.5 text-sm font-bold text-soil-900 transition-colors hover:bg-grain-50">
            <Icon name={l.icon} class="w-4 h-4" /> {l.name}
          </a>
        ))}
      </div>
      <p class="mt-5 max-w-3xl mx-auto text-center text-sm text-soil-600">
        Each SDK has its own docs site under <code class="text-xs bg-white px-2 py-0.5 rounded border border-soil-200">vgi-rpc-&lt;lang&gt;.query.farm</code> with full API reference, transports, examples, and benchmarks.
      </p>
    </div>
  </section>

  <!-- Language sections -->
  {languages.map(lang => (
    <section id={lang.id} class="py-16 lg:py-20 bg-white odd:bg-soil-50 scroll-mt-24 font-display">
      <div class="section-container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
            <!-- Left: heading + pitch + links -->
            <div class="lg:col-span-2">
              <div class="flex items-center gap-3 mb-4">
                <span class={`inline-flex h-14 w-14 items-center justify-center rounded-2xl border-2 border-soil-900 ${lang.tone} text-soil-900 shadow-sm`}>
                  <Icon name={lang.icon} class="w-7 h-7" />
                </span>
                <div>
                  <h2 class="text-3xl font-bold text-soil-900">{lang.name}</h2>
                  <span class={`inline-block mt-1 text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${lang.statusColor}`}>
                    {lang.status}
                  </span>
                </div>
              </div>
              <p class="text-soil-700 leading-relaxed mb-4">{lang.description}</p>
              <div class="space-y-3">
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wide text-soil-500 mb-1">Install</div>
                  <pre class="text-xs bg-soil-900 text-soil-100 p-3 rounded-lg overflow-x-auto font-mono leading-relaxed">{lang.install}</pre>
                </div>
                <div class="flex flex-wrap gap-2 pt-2">
                  <Button href={lang.docs} variant="primary" size="sm" external>Docs →</Button>
                  <Button href={lang.repo} variant="secondary" size="sm" external>GitHub</Button>
                </div>
              </div>
            </div>

            <!-- Right: code example -->
            <div class="lg:col-span-3">
              {lang.example ? (
                <CodeBlock code={lang.example} lang={lang.exampleLang} title={lang.exampleTitle} />
              ) : (
                <div class="rounded-2xl border-2 border-dashed border-soil-400 bg-white p-8 text-center">
                  <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl border-2 border-soil-900 bg-grain-100 text-soil-900">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M14.6 6.3a4 4 0 01-5 5l-5.3 5.3 2 2 5.3-5.3a4 4 0 005-5l-2.4 2.4-2-2 2.4-2.4z" />
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-soil-900 mb-2">Active development</h3>
                  <p class="text-sm text-soil-700 mb-4 max-w-sm mx-auto">
                    Conformance with the Python reference is the gate for release. A code example will land here as the SDK stabilises.
                  </p>
                  <Button href={lang.repo} variant="ghost" size="sm" external>Track progress on GitHub →</Button>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Don't see your language -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border-2 border-soil-900 bg-grain-50 p-8 md:p-10 text-center shadow-sm">
          <SectionHeader
            eyebrow="Don't see your language?"
            title="VGI is a protocol — anyone can implement it"
            align="center"
            class="mb-6"
          />
          <p class="text-soil-700 leading-relaxed mb-6">
            The wire format is Apache Arrow IPC over a pluggable transport. If your language has Arrow bindings (R, Julia, …) it can speak VGI. The full byte-level spec lives at <a href="https://vgi-rpc.query.farm/wire-protocol" target="_blank" rel="noopener" class="text-harvest-700 underline hover:text-harvest-800">vgi-rpc.query.farm/wire-protocol</a>.
          </p>
          <p class="text-soil-700 leading-relaxed">
            Working on a port? <a href="/company/contact" class="text-harvest-700 underline hover:text-harvest-800">Get in touch</a> — we're happy to help, and to list it here.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting CTA -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 rounded-2xl border-2 border-soil-900 bg-grain-50 p-6 shadow-lg md:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-harvest-700">Expert help</p>
          <h2 class="mb-4 text-3xl font-bold text-soil-900 md:text-4xl">
            Need a custom worker built?
          </h2>
          <p class="text-lg leading-relaxed text-soil-700">
            We build VGI workers and DuckDB extensions for clients across stacks — pick the language, we'll ship the worker.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href="/consulting" variant="primary" size="md">
            Consulting
          </Button>
          <Button href="/company/schedule" variant="secondary" size="md">
            Schedule a call
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
