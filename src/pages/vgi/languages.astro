---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Button from '../../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import PageToc from '../../components/vgi/PageToc.astro';
import { GRID, HEAD_CONTAINER } from '../../lib/vgi-layout';

// ── Shared shape vocabulary (brief §10) ──
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const P = 'mt-4 leading-relaxed text-soil-700';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';

// Status pills: shipped/at-parity reads field green, in-flight reads gold.
const PILL_FIELD = 'inline-block rounded-full border border-field-600/45 bg-field-600/10 px-2.5 py-0.5 text-[12.5px] font-medium text-field-700';

const CURRENT = '/vgi/languages';

// Source of truth: vgi-rpc-website/src/components/LanguageCards.astro
//
// The header's "N Implementations" figure counts THIS array rather than being
// written out, because it was written out and went stale: it read 6 while five
// SDKs were listed. A C++ SDK does exist (Query-farm/vgi-c++) and passes the
// integration suite over the subprocess transport, but it has no published
// package, no install command and no section under /vgi/docs/, so it is not
// something a reader can act on here. Add a row below when it ships and the
// figure follows on its own.
//
// `docs` is the SDK's own section under /vgi/docs/<language>/; `rpcDocs` is the
// vgi-rpc-<language>.query.farm site for the RPC layer underneath. Every card
// carries both, which is what the two-button row below already assumed — until
// all five had in-site docs, only Python did, and the other four spent their
// primary "Docs" button on the RPC site instead.
const languages = [
  {
    name: 'Python',
    id: 'python',
    icon: 'simple-icons:python',
    status: 'Reference implementation',
    statusClass: PILL_FIELD,
    description: 'Build VGI workers in Python — the reference implementation, with full feature support: strict mypy typing, all transports, streaming, introspection, shared memory, and OpenTelemetry. The `vgi` package is the DuckDB worker framework; `vgi-rpc` is the transport layer underneath.',
    repo: 'https://github.com/Query-farm/vgi-python',
    docs: '/vgi/docs/python/',
    rpcDocs: 'https://vgi-rpc-python.query.farm',
    install: 'pip install vgi-python\n# or: uv add vgi-python'
  },
  {
    name: 'TypeScript',
    id: 'typescript',
    icon: 'simple-icons:typescript',
    status: 'Feature parity',
    statusClass: PILL_FIELD,
    description: 'Build VGI workers in TypeScript for Bun, Node.js, and Deno. HTTP server/client, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-typescript',
    docs: '/vgi/docs/typescript/',
    rpcDocs: 'https://vgi-rpc-typescript.query.farm',
    install: 'npm install @query-farm/vgi\n# or: bun add @query-farm/vgi'
  },
  {
    name: 'Go',
    id: 'go',
    icon: 'simple-icons:go',
    status: 'Feature parity',
    statusClass: PILL_FIELD,
    description: 'Build VGI workers in Go, built on apache/arrow-go. HTTP server, OpenTelemetry, dispatch hooks, HTML pages, external storage with S3/GCS backends, and SHA-256 checksums.',
    repo: 'https://github.com/Query-farm/vgi-go',
    docs: '/vgi/docs/go/',
    rpcDocs: 'https://vgi-rpc-go.query.farm',
    install: 'go get github.com/Query-farm/vgi-go/vgi'
  },
  {
    name: 'Rust',
    id: 'rust',
    icon: 'simple-icons:rust',
    status: 'Feature parity',
    statusClass: PILL_FIELD,
    description: 'Build VGI workers in Rust, tracking the Python reference byte-for-byte on the wire — <span class="qf-figure">452 / 452</span> conformance tests pass across pipe, subprocess, http, and unix transports. Optional features for HTTP, JWT, OAuth-PKCE, mTLS, OpenTelemetry, and Sentry.',
    repo: 'https://github.com/Query-farm/vgi-rust',
    docs: '/vgi/docs/rust/',
    rpcDocs: 'https://vgi-rpc-rust.query.farm',
    install: 'cargo add vgi'
  },
  {
    name: 'Java',
    id: 'java',
    icon: 'simple-icons:openjdk',
    status: 'Feature parity',
    statusClass: PILL_FIELD,
    description: 'Build VGI workers in Java <span class="qf-figure">21+</span> with the `farm.query:vgi` package. Annotation-driven scalar/table/aggregate functions, catalogs with pushdown and statistics, stdio / Unix-socket / HTTP transports, and a shared-memory side-channel on JDK <span class="qf-figure">22+</span>. Wire-compatible with the Python reference and Go port — all three pass the same integration suite.',
    repo: 'https://github.com/Query-farm/vgi-java',
    docs: '/vgi/docs/java/',
    rpcDocs: 'https://vgi-rpc-java.query.farm',
    install: '# Gradle (Kotlin DSL), Java 21+:\nimplementation("farm.query:vgi:0.1.0")'
  }
];

// Was assembled inline in the old right-hand rail; hoisted so PageToc can take it.
const toc = [
  ...languages.map(l => ({ id: l.id, label: l.name })),
  { id: 'port-it', label: 'Port it yourself' },
  { id: 'consulting', label: 'Custom workers' },
];
---

<PageLayout
  title="VGI — Language SDKs"
  description="VGI implementations for Python, TypeScript, Go, Rust, and Java. Pick the SDK that matches your stack and ship functionality DuckDB can call."
>
  <VGISubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    container={HEAD_CONTAINER}
    eyebrow="Language SDKs"
    title="Workers in your language."
    lede="One wire protocol, multiple implementations. Every SDK interoperates over the same Apache Arrow IPC format."
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="/vgi/getting-started" variant="primary" size="md">Get started →</Button>
      <Button href="/vgi/architecture" variant="secondary" size="md">Architecture →</Button>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">{languages.length}</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Implementations</div>
    </Fragment>
  </PageHead>

  <!-- ── Docs grid: section nav / content / page TOC ──────────── -->
  <div class={GRID}>
    <PageToc items={toc} />

    <!-- Not a landmark element: BaseLayout already renders the page's single main. -->

    <div class="min-w-0 max-w-[78ch]">
      <p class={LEDE}>
        Every implementation speaks the same wire protocol, so a DuckDB session can attach
        workers written in different languages in the same query. Pick the one your team already
        runs.
      </p>

      {languages.map((lang) => (
        <section class="mt-10 border-t border-soil-300 pt-8">
          <div class="flex flex-wrap items-center gap-3.5">
            <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100 text-soil-900">
              <Icon name={lang.icon} class="h-6 w-6" />
            </span>
            <div class="min-w-0">
              <h2 id={lang.id} class="scroll-mt-32 text-2xl md:text-3xl text-soil-900">{lang.name}</h2>
              <span class={`mt-2 ${lang.statusClass}`}>{lang.status}</span>
            </div>
          </div>

          <p
            class={`${P} [&_code]:rounded [&_code]:bg-soil-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.88em] [&_code]:text-soil-900`}
            set:html={lang.description.replace(/`([^`]+)`/g, '<code>$1</code>')}
          ></p>

          <p class="mt-5 text-[12.5px] font-medium text-soil-500">Install</p>
          <pre class="mt-1.5 overflow-x-auto rounded-lg border border-rock-800 bg-rock-900 p-4 font-mono text-[12.5px] leading-[1.8] text-[#e9e1d3]">{lang.install}</pre>

          <div class="mt-4 flex flex-wrap gap-2.5">
            <Button href={lang.docs} variant="primary" size="sm" external={lang.docs.startsWith('http')}>Docs →</Button>
            {lang.rpcDocs && <Button href={lang.rpcDocs} variant="secondary" size="sm" external>RPC layer →</Button>}
            <Button href={lang.repo} variant="secondary" size="sm" external>GitHub</Button>
          </div>
        </section>
      ))}

      <!-- Don't see your language -->
      <section class="mt-12 border-t border-soil-300 pt-8">
        <span class={EYEBROW}>Don't see your language?</span>
        <h2 id="port-it" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">VGI is a protocol — anyone can implement it</h2>
        <p class={P}>
          The wire format is Apache Arrow IPC over a pluggable transport. If your language has
          Arrow bindings (R, Julia, …) it can speak VGI. The full byte-level
          <a href="https://vgi-rpc.query.farm/wire-protocol" target="_blank" rel="noopener" class={LINK}>wire-protocol spec</a>
          documents the exact format.
        </p>
        <p class={P}>
          Working on a port? <a href="/company/contact" class={LINK}>Get in touch</a> — we're
          happy to help, and to list it here.
        </p>
      </section>

      <!-- Consulting CTA -->
      <div class={`mt-10 ${CARD} flex flex-wrap items-center justify-between gap-6 px-7 py-7`}>
        <div class="max-w-[50ch]">
          <span class={EYEBROW}>Expert help</span>
          <h2 id="consulting" class="mt-2.5 scroll-mt-32 text-2xl text-soil-900">Need a custom worker built?</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-soil-700">
            We build VGI workers and DuckDB extensions for clients across stacks — pick the
            language, we'll ship the worker.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/consulting" variant="primary" size="md">Consulting</Button>
          <Button href="/company/schedule" variant="secondary" size="md">Schedule a call</Button>
        </div>
      </div>
    </div>

  </div>
</PageLayout>
