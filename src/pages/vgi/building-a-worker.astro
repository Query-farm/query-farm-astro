---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import VGISectionNav from '../../components/sections/VGISectionNav.astro';
import { Icon } from 'astro-icon/components';

// ── Shared shape vocabulary (brief §10) ──
const WRAP_WIDE = 'mx-auto w-full max-w-[1360px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const P = 'mt-4 leading-relaxed text-soil-700';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';
const NAV_LINK = 'block border-l-2 px-2.5 py-1 text-sm no-underline transition';
const NAV_REST = 'border-soil-200 text-soil-700 hover:border-soil-300 hover:text-soil-900';

const CURRENT = '/vgi/building-a-worker';

const toc: { id: string; label: string }[] = [
  { id: 'should-you', label: 'Should you build one?' },
  { id: 'capabilities', label: 'What a worker can offer' },
  { id: 'choose-a-language', label: 'Choosing a language' },
  { id: 'how-it-runs', label: 'How it runs' },
  { id: 'tutorials', label: 'Language tutorials' },
  { id: 'share', label: 'Then share it' },
];

// ── The decision. Most people never build a worker; they attach one somebody
// else did. These two lists exist so a reader can rule themselves out fast.
const buildWhen = [
  'You own an API, a dataset, a model, or an internal service, and you want SQL access to it without building a pipeline first.',
  'The logic already exists in a language you like — a Python model, a Go client library, a Rust parser — and porting it to C++ isn’t worth it.',
  'You want to hand a colleague or a customer a URL instead of an export.',
  'Access rules belong at the source: per-user auth, row and column filtering, metering, audit.',
  'You want it to keep working across DuckDB releases without a rebuild-and-resign matrix.',
];

const skipWhen = [
  'The data is already a file DuckDB reads — Parquet, CSV, JSON, on disk or in object storage. Just query it.',
  'An extension already does the job. Check the catalog before you write anything.',
  'The whole thing is a few lines of SQL. A macro or a view is smaller and faster.',
  'You need in-process, billion-rows-a-second scalar throughput on the hottest path — a native extension still wins there.',
];

// ── The five function shapes. Same glyphs the Python docs use
// (public/vgi/docs/assets/kinds/) rather than redrawn here, so the shape
// vocabulary is identical wherever a reader meets it.
const shapes = [
  {
    name: 'Scalar',
    glyph: '/vgi/docs/assets/kinds/scalar.svg',
    formula: '1 row → 1 value',
    body: 'The everyday UDF. Transform each row — but vectorized: you receive whole Arrow columns, not a per-row callback.',
  },
  {
    name: 'Table',
    glyph: '/vgi/docs/assets/kinds/table.svg',
    formula: 'args → N rows',
    body: 'Generate rows from arguments. The usual shape for wrapping an API, a dataset, or a search endpoint.',
  },
  {
    name: 'Table-in-out',
    glyph: '/vgi/docs/assets/kinds/table-in-out.svg',
    formula: 'N rows → M rows',
    body: 'Consume a relation and stream a transformed one back, batch by batch. Nothing is buffered, so input size is unbounded.',
  },
  {
    name: 'Aggregate',
    glyph: '/vgi/docs/assets/kinds/aggregate.svg',
    formula: 'N rows → 1 value',
    body: 'Usable in `GROUP BY` and over windows. Partial states combine, which is what lets DuckDB run it in parallel.',
  },
  {
    name: 'Buffering',
    glyph: '/vgi/docs/assets/kinds/buffering.svg',
    formula: 'stream → [state] → stream',
    body: 'For work that must see every input row first — a global sort, a top-k, a full reduction — then emits.',
  },
];

// ── The half people forget: a worker is a catalog, not just a bag of UDFs.
const beyondFunctions = [
  {
    name: 'Whole catalogs',
    icon: 'ph:database',
    body: 'Schemas, tables, and views that show up in `information_schema`. Column statistics and projection / filter / `LIMIT` pushdown mean the worker sends back less.',
    href: '/vgi/data-as-a-service',
    hrefLabel: 'Data-as-a-Service →',
  },
  {
    name: 'Authentication',
    icon: 'ph:key',
    body: 'Callers arrive with a token or a DuckDB secret, so the worker knows who is asking before it answers.',
    href: '/vgi/authentication',
    hrefLabel: 'Authentication →',
  },
  {
    name: 'Row & column security',
    icon: 'ph:shield-check',
    body: 'Filter rows and mask or drop columns per identity, at the source — the client never receives what it isn’t entitled to.',
    href: '/vgi/row-column-security',
    hrefLabel: 'Row & column security →',
  },
  {
    name: 'Observability',
    icon: 'ph:chart-line',
    body: 'OpenTelemetry traces and structured logs that surface back in the calling session, so a slow query is debuggable from both ends.',
    href: '/vgi/architecture',
    hrefLabel: 'Architecture →',
  },
];

// ── Language matrix. Source of truth is /vgi/languages — the transport
// columns are read off the same SDK descriptions, not re-derived. HTTP is
// broken out on its own because it is the one capability that decides
// whether a worker can be *hosted* for other people (see /vgi/distributing-a-worker).
const languages = [
  {
    name: 'Python',
    id: 'python',
    icon: 'simple-icons:python',
    status: 'Reference implementation',
    shipped: true,
    local: 'Pipes, subprocess, Unix socket, shared memory',
    http: true,
    fit: 'The reference SDK, and the shortest path if your logic is already Python — ML, pandas, the scientific stack.',
    docs: '/vgi/docs/python/',
    external: false,
  },
  {
    name: 'TypeScript',
    id: 'typescript',
    icon: 'simple-icons:typescript',
    status: 'Feature parity',
    shipped: true,
    local: 'Pipes, subprocess, Unix socket',
    http: true,
    fit: 'Bun, Node, and Deno — and the natural pick for edge and serverless runtimes that only speak HTTP.',
    docs: '/vgi/docs/typescript/',
    external: false,
  },
  {
    name: 'Go',
    id: 'go',
    icon: 'simple-icons:go',
    status: 'Feature parity',
    shipped: true,
    local: 'Pipes, subprocess, Unix socket',
    http: true,
    fit: 'One static binary to ship and a mature HTTP server. Easy to hand someone a release artifact they just run.',
    docs: '/vgi/docs/go/',
    external: false,
  },
  {
    name: 'Rust',
    id: 'rust',
    icon: 'simple-icons:rust',
    status: 'Feature parity',
    shipped: true,
    local: 'Pipes, subprocess, Unix socket',
    http: true,
    fit: 'Throughput and tight memory control, tracking the Python reference byte-for-byte on the wire.',
    docs: '/vgi/docs/rust/',
    external: false,
  },
  {
    name: 'Java',
    id: 'java',
    icon: 'simple-icons:openjdk',
    status: 'Feature parity',
    shipped: true,
    local: 'Pipes, subprocess, Unix socket, shared memory (JDK 22+)',
    http: true,
    fit: 'JVM shops. Annotation-driven functions, and it reaches the JDBC drivers and internal libraries you already run.',
    docs: '/vgi/docs/java/',
    external: false,
  },
];

const attachBothWays = `-- 1. DuckDB spawns the worker for you and talks over pipes.
--    Nothing is deployed; nothing touches the network.
ATTACH 'sales' AS sales (TYPE vgi, LOCATION 'uv run worker.py');

-- 2. Or it calls a worker you host. One deployment, any number of sessions.
ATTACH 'sales' AS sales (TYPE vgi, LOCATION 'https://worker.example.com/');

-- Either way, what the worker exposes is now ordinary SQL.
SELECT * FROM sales.main.orders WHERE region = 'EU' LIMIT 10;`;

// Status pills: shipped/at-parity reads field green, in-flight reads gold.
const PILL_FIELD = 'inline-block rounded-full border border-field-600/45 bg-field-600/10 px-2 py-0.5 text-[12px] font-medium text-field-700';
const PILL_SUN = 'inline-block rounded-full border border-sun-400 bg-sun-400/12 px-2 py-0.5 text-[12px] font-medium text-sun-700';
---

<PageLayout
  title="VGI — Building a Worker"
  description="Decide whether to build a VGI worker, what it can expose to SQL, and which of the six language SDKs to write it in — then start your language's tutorial."
>
  <VGISubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    wide
    eyebrow="Guide"
    title="Building a VGI worker"
  >
    <Fragment slot="lede">
      A worker is a program that exposes functions, tables, and whole catalogs to DuckDB. This
      page is the decision, not the code: whether to build one, what it can offer, and which
      language to write it in — then it hands you to that SDK's own tutorial.
    </Fragment>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="#choose-a-language" variant="primary" size="md">Choose a language →</Button>
    </div>
  </PageHead>

  <!-- ── Docs grid: section nav / content / page TOC ──────────── -->
  <div class={`${WRAP_WIDE} grid gap-10 py-10 lg:grid-cols-[220px_minmax(0,1fr)_200px] lg:gap-11`}>
    <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto">
      <VGISectionNav current={CURRENT} />
      <h2 class="mt-7 mb-2.5 text-[12.5px] font-semibold text-soil-500">Reference</h2>
      <ul class="flex flex-col gap-0.5">
        <li><a href="/products/extensions/vgi" class={`${NAV_LINK} ${NAV_REST}`}>VGI extension</a></li>
      </ul>
    </aside>

    <!-- Not a landmark element: BaseLayout already renders the page's single main. -->

    <div class="min-w-0 max-w-[78ch]">
      <p class={LEDE}>
        Most people never build a worker — they <a href="/vgi/connect-to-a-worker" class={LINK}>attach one</a>
        somebody else built. You build one when you own something DuckDB can't reach on its own,
        and you'd rather expose it than copy it.
      </p>

      <!-- ── Should you build one? ─────────────────────────────── -->
      <p class={`${EYEBROW} mt-10 block`}>The decision</p>
      <h2 id="should-you" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">Should you build a worker?</h2>
      <p class={P}>
        A worker earns its keep when the thing you want to query lives behind code — an API, a
        model, a service, a proprietary format — and the alternative is exporting it on a
        schedule. If the data is already sitting in a file DuckDB can open, stop here.
      </p>

      <div class="mt-6 grid gap-3.5 md:grid-cols-2">
        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Build one when…</h3>
          <ul class="mt-4 flex flex-col gap-3">
            {buildWhen.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-[3px] flex-none text-sm text-field-700" aria-hidden="true">✓</span>
                <span class="text-[14.5px] leading-relaxed text-soil-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class={`${CARD} p-6`}>
          <h3 class="text-lg text-soil-900">Reach for something else when…</h3>
          <ul class="mt-4 flex flex-col gap-3">
            {skipWhen.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-[3px] flex-none text-sm text-soil-500" aria-hidden="true">→</span>
                <span class="text-[14.5px] leading-relaxed text-soil-700">{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-soil-200 pt-4 text-sm leading-relaxed text-soil-700">
            Before writing anything, check the
            <a href="/products/extensions" class={LINK}>extension catalog</a> and the
            <a href="/products/orchard" class={LINK}>Orchard</a> — someone may have already built
            what you need. The trade-off against a native C++ extension is laid out on the
            <a href="/vgi/architecture" class={LINK}>architecture page</a>.
          </p>
        </div>
      </div>

      <!-- ── What a worker can offer ───────────────────────────── -->
      <p class={`${EYEBROW} mt-12 block border-t border-soil-300 pt-6`}>Scope</p>
      <h2 id="capabilities" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">What a worker can offer</h2>
      <p class={P}>
        A worker is not limited to scalar UDFs. It can implement every DuckDB function shape, and
        it can present itself as a catalog — schemas, tables, and views that behave like any
        attached database. Decide how far you want to go before you pick an SDK; the answer is the
        same in every language.
      </p>

      <div class="mt-6 grid gap-3.5 sm:grid-cols-2">
        {shapes.map((s) => (
          <div class={`${CARD} p-5`}>
            <div class="flex items-start gap-3.5">
              <img src={s.glyph} alt="" aria-hidden="true" width="34" height="34" class="mt-0.5 h-[34px] w-[34px] flex-none" />
              <div class="min-w-0">
                <h3 class="text-lg text-soil-900">{s.name}</h3>
                <p class="mt-1 font-mono text-[12.5px] text-soil-500">{s.formula}</p>
              </div>
            </div>
            <p
              class="mt-3 text-sm leading-relaxed text-soil-700 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.88em] [&_code]:text-soil-900"
              set:html={s.body.replace(/`([^`]+)`/g, '<code>$1</code>')}
            ></p>
          </div>
        ))}
      </div>

      <h3 class="mt-9 text-xl text-soil-900">Beyond functions</h3>
      <div class="mt-4 grid gap-3.5 sm:grid-cols-2">
        {beyondFunctions.map((f) => (
          <div class={`${CARD} p-5`}>
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-soil-300 bg-soil-100 text-soil-900">
                <Icon name={f.icon} class="h-[18px] w-[18px]" />
              </span>
              <h4 class="text-[17px] text-soil-900">{f.name}</h4>
            </div>
            <p
              class="mt-3 text-sm leading-relaxed text-soil-700 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.88em] [&_code]:text-soil-900"
              set:html={f.body.replace(/`([^`]+)`/g, '<code>$1</code>')}
            ></p>
            <a href={f.href} class={`mt-3 inline-block text-[13px] font-medium ${LINK}`}>{f.hrefLabel}</a>
          </div>
        ))}
      </div>

      <!-- ── Choosing a language ───────────────────────────────── -->
      <p class={`${EYEBROW} mt-12 block border-t border-soil-300 pt-6`}>The SDK</p>
      <h2 id="choose-a-language" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">Choosing a language</h2>
      <p class={P}>
        There are <span class="qf-figure">five</span> implementations of the protocol, and they all
        speak the same wire format — a single DuckDB session can attach workers written in
        different languages and join across them. So the choice is mostly about your code, not
        about VGI: pick the language your logic already lives in, or the one your team runs in
        production.
      </p>
      <p class={P}>
        Every one of them can also be deployed as a hosted HTTP service, not just launched locally
        by DuckDB over pipes — so if you intend to
        <a href="/vgi/distributing-a-worker" class={LINK}>share or sell</a> the worker, that's
        covered no matter which language you pick.
      </p>

      <div class="mt-6 overflow-x-auto rounded-xl border border-soil-300">
        <table class="w-full min-w-[720px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-soil-300 bg-soil-100">
              <th scope="col" class="px-4 py-3 font-medium text-soil-900">Language</th>
              <th scope="col" class="px-4 py-3 font-medium text-soil-900">Status</th>
              <th scope="col" class="px-4 py-3 font-medium text-soil-900">Local transports</th>
              <th scope="col" class="px-4 py-3 font-medium text-soil-900">HTTP (hostable)</th>
              <th scope="col" class="px-4 py-3 font-medium text-soil-900">Tutorial</th>
            </tr>
          </thead>
          <tbody>
            {languages.map((l) => (
              <tr class="border-b border-soil-200 last:border-0 bg-[#fffdf7] align-top">
                <th scope="row" class="whitespace-nowrap px-4 py-3.5 font-medium text-soil-900">
                  <span class="flex items-center gap-2">
                    <Icon name={l.icon} class="h-4 w-4 flex-none" />
                    {l.name}
                  </span>
                </th>
                <td class="px-4 py-3.5">
                  <span class={l.shipped ? PILL_FIELD : PILL_SUN}>{l.status}</span>
                </td>
                <td class="px-4 py-3.5 text-soil-700">{l.local}</td>
                <td class="px-4 py-3.5">
                  {l.http
                    ? <span class="font-medium text-field-700">Yes</span>
                    : <span class="font-medium text-sun-700">Not yet</span>}
                </td>
                <td class="whitespace-nowrap px-4 py-3.5">
                  <a
                    href={l.docs}
                    class={LINK}
                    {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >Docs{l.external ? ' ↗' : ' →'}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="mt-9 text-xl text-soil-900">Rules of thumb</h3>
      <div class="mt-4 grid gap-3.5 sm:grid-cols-2">
        {languages.map((l) => (
          <div class={`${CARD} p-5`}>
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-soil-300 bg-soil-100 text-soil-900">
                <Icon name={l.icon} class="h-[18px] w-[18px]" />
              </span>
              <h4 class="text-[17px] text-soil-900">{l.name}</h4>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-soil-700">{l.fit}</p>
          </div>
        ))}
      </div>
      <p class={P}>
        Full descriptions, install lines, and repositories for each SDK are on the
        <a href="/vgi/languages" class={LINK}>languages page</a>. VGI is a protocol, so a language
        that isn't listed can still implement it — the
        <a href="https://vgi-rpc.query.farm/wire-protocol" target="_blank" rel="noopener" class={LINK}>wire-protocol spec</a>
        is public.
      </p>

      <!-- ── How it runs ───────────────────────────────────────── -->
      <p class={`${EYEBROW} mt-12 block border-t border-soil-300 pt-6`}>Deployment</p>
      <h2 id="how-it-runs" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">How a worker runs</h2>
      <p class={P}>
        Whatever you write it in, the worker ends up in one of two postures — and the code doesn't
        change between them, only the flag you start it with. That's worth knowing before you
        build, because it decides whether the people who use it need to run anything.
      </p>
      <div class="mt-5"><CodeBlock code={attachBothWays} lang="sql" title="DuckDB / Haybarn shell" tryable={false} /></div>
      <p class={P}>
        The first form is how you'll develop: <code class={CODE}>ATTACH</code> a command, and
        DuckDB spawns and pools the process for you. The second is how you hand it to other
        people. See <a href="/vgi/architecture" class={LINK}>Architecture</a> for the transports and
        the hosting options, and <a href="/vgi/connect-to-a-worker" class={LINK}>Connect to a worker</a>
        for what the far side of the <code class={CODE}>ATTACH</code> looks like.
      </p>

      <!-- ── Tutorials ─────────────────────────────────────────── -->
      <p class={`${EYEBROW} mt-12 block border-t border-soil-300 pt-6`}>Start writing</p>
      <h2 id="tutorials" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">Your language's tutorial</h2>
      <p class={P}>
        Each SDK carries its own tutorial, how-to guides, and API reference — the shapes above,
        written the way that language writes them. Pick yours and start there.
      </p>
      <div class="mt-6 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {languages.map((l) => (
          <a
            href={l.docs}
            class={`${CARD} block p-5 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-soil-300 bg-soil-100 text-soil-900">
                <Icon name={l.icon} class="h-[18px] w-[18px]" />
              </span>
              <h3 class="text-[17px] text-soil-900">{l.name}</h3>
            </div>
            <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
              {l.external ? 'SDK docs and tutorial ↗' : 'Tutorial, how-to guides, and full API reference →'}
            </p>
          </a>
        ))}
      </div>
      <p class={P}>
        Prefer to watch one get built? <a href="/vgi/getting-started" class={LINK}>Getting started</a>
        walks an AI coding agent through building and deploying a worker end to end.
      </p>

      <!-- ── Then share it ─────────────────────────────────────── -->
      <p class={`${EYEBROW} mt-12 block border-t border-soil-300 pt-6`}>Next</p>
      <h2 id="share" class="mt-3 scroll-mt-32 text-2xl md:text-3xl text-soil-900">Then share it</h2>
      <p class={P}>
        A worker that only runs on your laptop is a script. Once it works, the next decision is who
        else gets to attach it — your team, anyone with a GitHub link, or paying customers on the
        Orchard.
      </p>
      <div class={`mt-6 ${CARD} flex flex-wrap items-center justify-between gap-6 px-7 py-7`}>
        <div class="max-w-[52ch]">
          <h3 class="text-xl text-soil-900">Distributing a worker</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-soil-700">
            Publishing releases on GitHub, shipping a container people can spawn, hosting it as a
            service, or listing it on the Orchard and earning a revenue share on subscriptions.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/vgi/distributing-a-worker" variant="primary" size="md">Distributing a worker →</Button>
          <Button href="/consulting" variant="secondary" size="md">Get help building it</Button>
        </div>
      </div>
    </div>

    <aside class="hidden xl:block xl:sticky xl:top-24 xl:self-start">
      <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">On this page</h2>
      <ul class="flex flex-col gap-0.5">
        {toc.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="block border-l-2 border-soil-200 px-2.5 py-1 text-[13px] text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</PageLayout>
