---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const workerPy = `from typing import Annotated
import pyarrow as pa
import pyarrow.compute as pc
from vgi import ScalarFunction, Param, Returns, Worker


class UpperCase(ScalarFunction):
    """Convert string values to uppercase."""

    @classmethod
    def compute(
        cls,
        value: Annotated[pa.StringArray, Param(doc="String value to uppercase")],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.utf8_upper(value)


class MyWorker(Worker):
    catalog_name = "my_funcs"
    functions = [UpperCase]


if __name__ == "__main__":
    MyWorker().run()`;

const installSdk = `# Install the reference Python SDK.
pip install vgi`;

const attachQuery = `-- In DuckDB (or Haybarn) with the VGI extension loaded:
INSTALL vgi FROM community;
LOAD vgi;

-- Attach your worker. With a path, VGI launches it as a subprocess for you.
ATTACH 'my_funcs' (TYPE vgi, LOCATION './my_worker.py');

-- Its functions are now native SQL.
SELECT upper_case(name) FROM users;`;

// Each function shape a worker can implement.
const shapes = [
  { name: 'Scalar', body: 'One value in, one value out per row — like the `UpperCase` example. The everyday UDF.' },
  { name: 'Table', body: 'Returns a set of rows. The common case for wrapping an API, dataset, or service as a queryable table.' },
  { name: 'Table-in-out (streaming)', body: 'Receives rows and emits rows as it goes — for transforms that process a stream without buffering all of it.' },
  { name: 'Buffered table', body: 'Sees every input row before emitting any output — for operations that need the whole input first.' },
  { name: 'Aggregate', body: 'Combines many rows into one result, usable in `GROUP BY` like `SUM` or `COUNT`.' },
  { name: 'Windowed aggregate', body: 'An aggregate evaluated over a moving window, usable with `OVER (...)`.' },
];

const nextSteps = [
  { icon: '🌍', title: 'Other languages', body: 'TypeScript, Go, Rust, Java, C++ SDKs.', href: '/vgi/languages', external: false },
  { icon: '🚀', title: 'Getting started', body: 'Deploy a worker end-to-end (incl. an agent + Fly.io path).', href: '/vgi/getting-started', external: false },
  { icon: '🏗️', title: 'Architecture', body: 'Transports, lifecycle, and the wire format.', href: '/vgi/architecture', external: false },
  { icon: '📖', title: 'Python SDK on GitHub', body: 'README, examples, and fixtures for every shape.', href: 'https://github.com/Query-farm/vgi-python', external: true },
];
---

<PageLayout
  title="VGI — Building a Worker"
  description="Write a VGI worker: define functions in any language with the SDK, run it, and ATTACH it so DuckDB can query it as SQL."
>
  <VGISubNav />

  <Hero
    title="Building a VGI worker"
    subtitle="A worker is a small program that exposes functions and tables to DuckDB. Write it in your language, run it, and ATTACH it — that's the whole contract."
    primaryCTA={{ text: "GitHub", href: "https://github.com/Query-farm/vgi" }}
    secondaryCTA={{ text: "Other languages →", href: "/vgi/languages" }}
  />

  <!-- The contract -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wide text-harvest-700 mb-3">The contract</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-soil-900 mb-4">A worker is a small program</h2>
        <p class="text-soil-700 leading-relaxed mb-6">
          A function is a class with a typed <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">compute</code> method;
          you list your functions on a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Worker</code> and run it.
          The reference SDK is <a href="https://pypi.org/project/vgi/" class="text-harvest-700 underline">Python</a>, and
          the same shape exists in <a href="/vgi/languages" class="text-harvest-700 underline">other languages</a>.
          Its docstring becomes the function's description in DuckDB.
        </p>
        <div class="mb-6"><CodeBlock code={installSdk} lang="bash" title="terminal" /></div>
        <CodeBlock code={workerPy} lang="python" title="my_worker.py" />
        <p class="mt-6 text-soil-700 leading-relaxed">
          Types are declared with <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Annotated</code> hints, and
          <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">compute</code> receives and returns
          <a href="https://arrow.apache.org/" class="text-harvest-700 underline">Apache Arrow</a> arrays — so you work on
          whole columns at once (here, with <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">pyarrow.compute</code>)
          rather than row by row. If <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">compute</code> raises, the
          error surfaces back in the DuckDB query.
        </p>
      </div>
    </div>
  </section>

  <!-- Run, attach, query -->
  <section class="py-16 lg:py-20 bg-soil-50">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wide text-harvest-700 mb-3">Build → run → attach → query</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-soil-900 mb-4">Attach it like any worker</h2>
        <p class="text-soil-700 leading-relaxed mb-6">
          Point <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">ATTACH</code> at your script. With a local path,
          VGI launches the worker as a pooled subprocess for you; with an
          <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">http(s)://</code> URL it reaches a worker you host. Either
          way, the functions and tables it exposes are now ordinary SQL.
        </p>
        <CodeBlock code={attachQuery} lang="sql" title="DuckDB / Haybarn shell" />
        <p class="mt-6 text-soil-700 leading-relaxed">
          See <a href="/vgi/architecture" class="text-harvest-700 underline">Architecture</a> for the transport options
          (local subprocess, HTTP, Unix socket, and the launcher that keeps one warm worker shared across clients).
        </p>
      </div>
    </div>
  </section>

  <!-- Function shapes -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Beyond scalar UDFs"
        title="Every function shape"
        description="A worker isn't limited to one-value-in, one-value-out. It can implement the full range of DuckDB function shapes, all surfaced as native SQL."
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {shapes.map((s) => (
          <Card padding="lg" class="h-full">
            <h3 class="text-lg font-bold text-soil-900 mb-2">{s.name}</h3>
            <p class="text-sm text-soil-700 leading-relaxed [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-xs [&_code]:font-mono" set:html={s.body.replace(/`([^`]+)`/g, '<code>$1</code>')}></p>
          </Card>
        ))}
      </div>
      <p class="mt-10 text-center text-soil-600">
        Workers also expose <strong>schemas, tables, and views</strong> with column statistics and pushdown — see the
        <a href="https://github.com/Query-farm/vgi-python" class="text-harvest-700 underline">Python SDK examples</a> for each shape.
      </p>
    </div>
  </section>

  <!-- Next steps -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader align="center" eyebrow="Next steps" title="Where to from here" class="mb-12" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {nextSteps.map((item) => (
          <a href={item.href} class="block" {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-soil-900 mb-2">{item.title}</h3>
              <p class="text-sm text-soil-700">{item.body}</p>
            </Card>
          </a>
        ))}
      </div>
      <div class="mt-12 text-center">
        <Button href="/products/extensions/vgi" variant="secondary" size="lg">VGI extension reference →</Button>
      </div>
    </div>
  </section>
</PageLayout>
