---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const transports = [
  {
    name: 'Pipes',
    icon: 'pipes',
    tone: 'bg-duck-100',
    detail: 'OS pipes between processes on the same machine. Lowest setup cost. The default for the spawned-subprocess case.'
  },
  {
    name: 'Unix sockets',
    icon: 'socket',
    tone: 'bg-grain-100',
    detail: 'Local domain sockets when the worker is already running. Same performance envelope as pipes; survives independently of the DuckDB process.'
  },
  {
    name: 'Shared memory',
    icon: 'shm',
    tone: 'bg-harvest-100',
    detail: 'Zero-copy Arrow IPC over a memory region. Highest throughput for very large batches on the same host. Opt-in.'
  },
  {
    name: 'HTTP',
    icon: 'http',
    tone: 'bg-earth-100',
    detail: 'Workers anywhere on the network. Trades latency for reach — useful for shared inference services and remote teams.'
  }
];

const lifecycle = [
  {
    phase: 'bind',
    description: 'DuckDB asks the worker what types it returns and validates argument types. Type bounds (`type_bound=...`) are enforced here, before any data moves. Errors at this stage are reported as SQL plan errors.'
  },
  {
    phase: 'process',
    description: 'For each Arrow record batch DuckDB hands the worker, the worker runs `compute()` and returns the result batch. The vectorized engine on both sides keeps this loop tight.'
  },
  {
    phase: 'finalize',
    description: 'Aggregates and table-in/out functions get a final call to flush state — emit the running aggregate, close the cursor, release resources.'
  }
];

const pyExample = `class RowCount(AggregateFunction):
    @classmethod
    def initialize(cls) -> int:
        return 0

    @classmethod
    def update(cls, state: int, batch: pa.RecordBatch) -> int:
        return state + batch.num_rows

    @classmethod
    def finalize(cls, state: int) -> int:
        return state`;

// Animated flow diagram geometry. Sources (left) → VGI gateway (center) →
// DuckDB (right), the merge.dev orientation: many systems becoming SQL.
// Each wire is drawn in its forward-flow direction so a plain animateMotion
// carries the "response" packet; a second packet with keyPoints 1;0 carries
// the "request" the other way.
const sources = [
  { label: 'REST / gRPC APIs', cy: 63 },
  { label: 'ML models',        cy: 155 },
  { label: 'Services',         cy: 247 },
  { label: 'Python · Go · Rust', cy: 339 },
];
const fanWires = sources.map((s, i) => ({
  id: `vgi-wire-${i}`,
  d: `M240 ${s.cy} C 312 ${s.cy} 330 210 400 210`,
  begin: `${(i * 0.45).toFixed(2)}s`,
  revBegin: `${(i * 0.45 + 0.9).toFixed(2)}s`,
}));

const nextCards = [
  { icon: 'start',     title: 'Getting Started', body: 'Hands-on walkthrough.',                href: '/vgi/getting-started', external: false },
  { icon: 'languages', title: 'Languages',       body: 'SDKs in your language.',               href: '/vgi/languages',       external: false },
  { icon: 'rpc',       title: 'vgi-rpc',         body: 'Benchmarks and the full wire spec.',   href: 'https://vgi-rpc.query.farm', external: true },
];
---

<PageLayout
  title="VGI — Architecture"
  description="How VGI works: transports, the Apache Arrow IPC wire format, and the bind / process / finalize lifecycle that connects DuckDB to remote workers."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-harvest-100 via-harvest-50 to-white py-14 font-display lg:py-20">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="vgi-arch-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#vgi-arch-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
          <img src="/vgi/vgi-logo.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
          Architecture
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-normal text-soil-900 leading-tight">
          Apache Arrow over a
          <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">pluggable wire.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-soil-700 leading-relaxed">
          A DuckDB-side extension, your worker, and a transport between them — with a bind / process / finalize lifecycle that maps cleanly onto DuckDB's vectorized engine.
        </p>
        <div class="mt-8 flex justify-center">
          <Button href="https://vgi-rpc.query.farm/wire-protocol" variant="accent" size="lg" external>Wire protocol spec →</Button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- Animated flow diagram -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <SectionHeader
        eyebrow="Big picture"
        title="Your systems, arriving as SQL"
        description="DuckDB issues an Arrow IPC request through the transport; the worker dispatches to the matching method and streams an Arrow IPC response back. The wire is the same whether the worker is a subprocess or a service across the network."
        align="center"
        class="mb-12"
      />

      <div class="max-w-5xl mx-auto rounded-2xl border-2 border-soil-900 bg-white p-4 md:p-8 shadow-lg">
        <svg class="vgi-flow w-full h-auto" viewBox="0 0 1000 420" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" aria-label="Animated diagram: external APIs, models, services, and code connect through the VGI Arrow IPC gateway to a DuckDB SQL session.">
          <!-- Wires (drawn first, under the nodes) -->
          {fanWires.map(w => (
            <path id={w.id} d={w.d} fill="none" class="stroke-soil-300" stroke-width="2.5" />
          ))}
          <path id="vgi-wire-main" d="M600 210 L760 210" fill="none" class="stroke-soil-300" stroke-width="2.5" />

          <!-- Flow packets: response (→ DuckDB) and request (→ worker) -->
          {fanWires.map(w => (
            <>
              <circle r="5.5" class="fill-harvest-500">
                <animateMotion dur="2.6s" repeatCount="indefinite" begin={w.begin}>
                  <mpath xlink:href={`#${w.id}`} />
                </animateMotion>
              </circle>
              <circle r="4" class="fill-duck-500">
                <animateMotion dur="3s" repeatCount="indefinite" begin={w.revBegin} keyPoints="1;0" keyTimes="0;1" calcMode="linear">
                  <mpath xlink:href={`#${w.id}`} />
                </animateMotion>
              </circle>
            </>
          ))}
          <circle r="6" class="fill-harvest-600">
            <animateMotion dur="1.8s" repeatCount="indefinite" begin="0.3s">
              <mpath xlink:href="#vgi-wire-main" />
            </animateMotion>
          </circle>
          <circle r="4.5" class="fill-duck-500">
            <animateMotion dur="2.2s" repeatCount="indefinite" begin="1s" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
              <mpath xlink:href="#vgi-wire-main" />
            </animateMotion>
          </circle>

          <!-- Source nodes (left) -->
          {sources.map(s => (
            <g>
              <rect x="30" y={s.cy - 26} width="210" height="52" rx="12" class="fill-white stroke-soil-900" stroke-width="2.5" />
              <text x="135" y={s.cy + 5} text-anchor="middle" class="fill-soil-900 font-bold" font-size="19" font-family="inherit">{s.label}</text>
            </g>
          ))}

          <!-- VGI gateway (center) -->
          <rect x="400" y="150" width="200" height="120" rx="18" class="fill-grain-50 stroke-soil-900" stroke-width="3" />
          <text x="500" y="184" text-anchor="middle" class="fill-harvest-700 font-bold" font-size="14" font-family="inherit" letter-spacing="1.5">VGI GATEWAY</text>
          <text x="500" y="223" text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="32" font-family="inherit">Arrow IPC</text>
          <text x="500" y="249" text-anchor="middle" class="fill-soil-700 font-bold" font-size="15" font-family="inherit">over any transport</text>

          <!-- DuckDB / SQL (right) -->
          <rect x="760" y="150" width="210" height="120" rx="18" class="fill-duck-50 stroke-soil-900" stroke-width="3" />
          <text x="865" y="198" text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="30" font-family="inherit">DuckDB</text>
          <text x="865" y="226" text-anchor="middle" class="fill-soil-700 font-bold" font-size="16" font-family="inherit">SQL session · Haybarn</text>
        </svg>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <span class="inline-flex items-center gap-2 font-semibold text-soil-700">
            <span class="h-3 w-3 rounded-full bg-harvest-500"></span> Arrow response → DuckDB
          </span>
          <span class="inline-flex items-center gap-2 font-semibold text-soil-700">
            <span class="h-3 w-3 rounded-full bg-duck-500"></span> request → worker
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Transports -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <SectionHeader
        eyebrow="The transport layer"
        title="Same protocol, your choice of pipe"
        description="vgi-rpc abstracts the wire so you can switch transports without changing your worker."
        align="center"
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
        {transports.map(t => (
          <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
            <div class={`mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border-2 border-soil-900 ${t.tone} text-soil-900`}>
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {t.icon === 'pipes' && (
                  <>
                    <rect x="2.5" y="8" width="6.5" height="8" rx="1.5" stroke-width="2.1" />
                    <rect x="15" y="8" width="6.5" height="8" rx="1.5" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-width="2.1" d="M9 12h6" />
                  </>
                )}
                {t.icon === 'socket' && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M8 7V3M16 7V3M7 7h10v4a5 5 0 01-10 0V7zM12 16v5" />
                )}
                {t.icon === 'shm' && (
                  <>
                    <rect x="6.5" y="6.5" width="11" height="11" rx="1.5" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-width="2.1" d="M9.5 3v3M14.5 3v3M9.5 18v3M14.5 18v3M3 9.5h3M3 14.5h3M18 9.5h3M18 14.5h3" />
                  </>
                )}
                {t.icon === 'http' && (
                  <>
                    <circle cx="12" cy="12" r="9" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-width="2.1" d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
                  </>
                )}
              </svg>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">{t.name}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{t.detail}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-soil-600 mt-8 max-w-2xl mx-auto">
        Benchmarks and a comparison matrix live on the dedicated RPC site.
        <a href="https://vgi-rpc.query.farm" target="_blank" rel="noopener" class="text-harvest-700 underline ml-1">vgi-rpc.query.farm →</a>
      </p>
    </div>
  </section>

  <!-- Lifecycle -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          eyebrow="Function lifecycle"
          title="bind → process → finalize"
          description="Every VGI function (scalar, table, aggregate) follows the same lifecycle, just with different hooks."
          align="center"
          class="mb-12"
        />

        <div class="space-y-4">
          {lifecycle.map((step, i) => (
            <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-soil-900 bg-grain-300 text-soil-900 flex items-center justify-center font-extrabold text-lg shadow-sm">
                  {i + 1}
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-soil-900 mb-2 font-mono">{step.phase}</h3>
                  <p class="text-soil-700 leading-relaxed">{step.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10">
          <p class="text-soil-700 leading-relaxed mb-4">
            For aggregates this maps to <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">initialize</code> / <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">update</code> / <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">finalize</code> on the Python class:
          </p>
          <CodeBlock code={pyExample} lang="python" title="row_count.py" />
        </div>
      </div>
    </div>
  </section>

  <!-- Wire format -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          eyebrow="Wire format"
          title="Apache Arrow IPC, all the way down"
          align="center"
          class="mb-8"
        />
        <div class="rounded-2xl border-2 border-soil-900 bg-white p-6 md:p-8 shadow-sm">
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl border-2 border-soil-900 bg-grain-100 text-soil-900">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 7l5 5-5 5M12 7l5 5-5 5" />
            </svg>
          </div>
          <p class="text-soil-700 leading-relaxed mb-4">
            Every request and response is an Arrow IPC stream — a self-describing schema followed by record batches. That's it. There's no bespoke serialization, no JSON envelope, no language-specific wire types. If you can read Arrow, you can implement a worker.
          </p>
          <p class="text-soil-700 leading-relaxed mb-6">
            The full byte-level specification — opcodes, framing, error handling — is published on the RPC site.
          </p>
          <Button href="https://vgi-rpc.query.farm/wire-protocol" variant="primary" size="lg" external>
            Read the Wire Protocol Spec →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Next -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {nextCards.map(c => (
          <a
            href={c.href}
            class="group block rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:bg-grain-50 hover:shadow-xl"
            {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border-2 border-soil-900 bg-grain-100 text-soil-900">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {c.icon === 'start' && (
                  <>
                    <circle cx="12" cy="12" r="9" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M10 8.5l6 3.5-6 3.5z" />
                  </>
                )}
                {c.icon === 'languages' && (
                  <>
                    <circle cx="12" cy="12" r="9" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-width="2.1" d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
                  </>
                )}
                {c.icon === 'rpc' && (
                  <>
                    <circle cx="12" cy="8" r="2" stroke-width="2.1" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M12 10v10M8 20h8M7 11a7 7 0 0110 0M4.5 9a10.5 10.5 0 0115 0" />
                  </>
                )}
              </svg>
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-1">{c.title}</h3>
            <p class="text-sm text-soil-700">{c.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Respect reduced-motion: pause the SMIL packet animations.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('svg.vgi-flow').forEach((s) => {
      const svg = s as SVGSVGElement & { pauseAnimations?: () => void };
      svg.pauseAnimations?.();
    });
  }
</script>
