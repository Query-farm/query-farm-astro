    chip: 'border-cat-clay-ink/25 bg-cat-clay',
    pill: 'bg-cat-clay text-cat-clay-ink',
    formula: 'stream → [state] → stream',
    sql: 'SELECT * FROM f((SELECT …))',
    duckdb: "DuckDB's in-out function with a final flush",
