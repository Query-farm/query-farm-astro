// ── Shared shape vocabulary (brief §10) ──
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const P = 'mt-4 leading-relaxed text-soil-700';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';
// Inline <code> styling for prose rendered through set:html (the `md()` helper
// below) — the same chrome as CODE, applied from the container.
const PROSE_CODE =
  '[&_code]:rounded [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.88em] [&_code]:text-soil-900';

// Backticks → <code> so the data tables below stay readable as data rather
// than as hand-tagged HTML. Only used on strings authored in this file.
const md = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');

const CURRENT = '/vgi/architecture';

const toc = [
  { id: 'why', label: 'Why VGI exists' },
  { id: 'out-of-process', label: 'The idea' },
  { id: 'latency', label: 'Isn’t that slow?' },
  { id: 'airport', label: 'Airport → VGI' },
  { id: 'c-api', label: 'The same API' },
  { id: 'shapes', label: 'Function shapes' },
  { id: 'transports', label: 'Transports' },
  { id: 'distribution', label: 'Running a worker' },
  { id: 'catalogs', label: 'Catalogs & pushdown' },
  { id: 'wire-format', label: 'Wire format' },
  { id: 'compare', label: 'How it compares' },
  { id: 'next-steps', label: 'Where to next' },
];

// ── The two costs of a native extension. Deliberately free of API symbols:
// this is the ease-in section, and the reader who hasn't written an extension
// should still recognise both costs. The symbols show up in §c-api, where
// they're the point.
const costs = [
  {
    title: 'The cognitive load',
    body: "Most of the work isn't your logic. It's learning how DuckDB thinks: how a vector of values is laid out, how nulls are tracked beside it, which callback owns which piece of state, and what has to be freed and when. That knowledge is specific to DuckDB, and everyone who touches the code pays for it before writing anything useful.",
  },
  {
    title: 'The release latency',
    body: 'Not query latency — the wait between changing a line and everyone having it. A compiled extension is tied to one DuckDB version on one platform, so shipping means building for every platform you support, getting them signed, and publishing — then doing it again on the next DuckDB release, whether your code changed or not.',
  },
];

// ── What falls out of moving the extension out of the process. These are the
// consequences that actually change how a team works, not a feature list.
const consequences = [
  {
    title: 'One extension, installed once',
    body: "There's one VGI binary, and we maintain it. `INSTALL vgi FROM community` is the last build-and-sign cycle anyone runs — after that, your functionality ships when you ship it, with no DuckDB release to wait for.",
  },
  {
    title: 'Ordinary code, ordinary tooling',
    body: 'A worker is a normal program in a normal language. Your debugger, your test runner, your dependency manager, your CI — all of it works, and none of it is pinned to a DuckDB version.',
  },
  {
    title: 'Failure stays outside',
    body: "A segfault, a runaway allocation, or a hung third-party client takes down a worker, not the database. The worker is also a separate process with its own credentials and its own network access, which is a security boundary you don't get in-process.",
  },
  {
    title: 'An agent can write one',
    body: 'We think building a DuckDB extension should be within reach of a coding agent, and out-of-process is what puts it there. A worker is typed code with a test you can run in seconds — the loop agents are good at. Manual memory ownership, an ABI to match, and a signed cross-platform release are not.',
  },
];

// ── The objection everyone raises, answered before the details start.
const objections = [
  {
    title: 'The unit is a batch, not a row',
    body: 'DuckDB is vectorized: it hands over thousands of rows per call, not one. A round trip is amortized across the whole vector, so the boundary shows up as a fixed cost per batch rather than a tax on every row.',
  },
  {
    title: 'Arrow on both sides means no conversion',
    body: "DuckDB's execution format and the worker's are the same columnar layout, so there's no serialize / deserialize step in the middle — the buffers go on the wire as they already are. On one host, shared memory moves them with no copy at all.",
  },
  {
    title: 'Fewer calls, not just cheaper ones',
    body: 'Projection, filter, `ORDER BY` + `LIMIT`, and distinct join-key pushdown mean the worker sends back less. Catalogs load lazily instead of up front, and subprocess workers are pooled and reused rather than spawned per query.',
  },
  {
    title: 'What it measures',
    body: 'Roughly <span class="qf-figure">450 million</span> rows/second across the boundary. Fast enough that for the overwhelming majority of workloads, the hop stops being the thing you tune.',
  },
];

// ── `upper_case(VARCHAR) -> VARCHAR` in six forms. The C version is DuckDB's
// own C extension API; the five worker versions are drawn from each SDK's real
// examples (README quickstarts and the shared conformance fixtures), not
// written for this page, so they stay honest about what each SDK looks like.
const cExample = `/* DuckDB C extension API — upper_case(VARCHAR) -> VARCHAR: the
   compute callback and the registration that publishes it. */
static void upper_case(duckdb_function_info info,
                       duckdb_data_chunk input,
                       duckdb_vector output) {
  idx_t count             = duckdb_data_chunk_get_size(input);
  duckdb_vector in        = duckdb_data_chunk_get_vector(input, 0);
  duckdb_string_t *in_data = (duckdb_string_t *) duckdb_vector_get_data(in);
  uint64_t *in_valid      = duckdb_vector_get_validity(in);

  duckdb_vector_ensure_validity_writable(output);
  uint64_t *out_valid = duckdb_vector_get_validity(output);

  for (idx_t row = 0; row < count; row++) {
    if (!duckdb_validity_row_is_valid(in_valid, row)) {
      duckdb_validity_set_row_invalid(out_valid, row);
      continue;
    }

    /* Strings up to 12 bytes live inside the struct; longer ones are behind a
       pointer — you have to know which before you can read one. */
    duckdb_string_t str = in_data[row];
    const char *bytes   = duckdb_string_is_inlined(str) ? str.value.inlined.inlined
                                                        : str.value.pointer.ptr;
    uint32_t len        = duckdb_string_is_inlined(str) ? str.value.inlined.length
                                                        : str.value.pointer.length;

    char *upper = (char *) malloc(len);   /* ASCII fast path only */
    for (uint32_t i = 0; i < len; i++) {
      upper[i] = (char) toupper((unsigned char) bytes[i]);
    }
    duckdb_vector_assign_string_element_len(output, row, upper, len);
    free(upper);
  }
}

DUCKDB_EXTENSION_ENTRYPOINT(duckdb_connection conn,
                            duckdb_extension_info info,
                            struct duckdb_extension_access *access) {
  duckdb_logical_type varchar = duckdb_create_logical_type(DUCKDB_TYPE_VARCHAR);
  duckdb_scalar_function fn   = duckdb_create_scalar_function();

  duckdb_scalar_function_set_name(fn, "upper_case");
  duckdb_scalar_function_add_parameter(fn, varchar);
  duckdb_scalar_function_set_return_type(fn, varchar);
  duckdb_scalar_function_set_function(fn, upper_case);
  duckdb_register_scalar_function(conn, fn);

  duckdb_destroy_scalar_function(&fn);
  duckdb_destroy_logical_type(&varchar);
  return true;
}`;

// C leads the set as the "before" — divided off from the five worker SDKs by a
// rule in the tab strip. It's also by far the longest panel, which is exactly
// why it's a tab: nobody should have to scroll past it to reach a comparison.
const implTabs = [
  {
    id: 'c',
    label: 'C (native)',
    icon: 'simple-icons:c',
    lang: 'c',
    title: 'extension.c — a native DuckDB extension',
    code: cExample,
    dividerAfter: true,
  },
  {
    id: 'python',
    label: 'Python',
    icon: 'simple-icons:python',
    lang: 'python',
    title: 'worker.py',
    code: `from typing import Annotated

import pyarrow as pa
import pyarrow.compute as pc

from vgi import Param, Returns, ScalarFunction, Worker
from vgi.catalog import Catalog, Schema

class UpperCase(ScalarFunction):
    """Converts string values to uppercase."""

    class Meta:
        name = "upper_case"
        description = "Converts string values to uppercase"

    @classmethod
    def compute(
        cls,
        value: Annotated[pa.StringArray, Param(doc="String value to uppercase")],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.utf8_upper(value)

class DemoWorker(Worker):
    catalog = Catalog(
        name="demo",
        schemas=[Schema(name="main", functions=[UpperCase])],
    )

if __name__ == "__main__":
    DemoWorker().run()`,
  },
  {
    id: 'typescript',
    label: 'TypeScript',
    icon: 'simple-icons:typescript',
    lang: 'typescript',
    title: 'worker.ts',
    code: `import { Worker, defineScalarFunction, str } from "@query-farm/vgi";

const upperCase = defineScalarFunction({
  name: "upper_case",
  description: "Convert a string to uppercase",

  // Declares the argument types and order. DuckDB calls scalar functions
  // positionally, so inside compute you read columns by position.
  params: { value: str },
  returns: str,

  // compute runs once per input batch: one output value per row (null ok).
  compute: (batch) => {
    const values = batch.getChildAt(0)!;     // first positional argument
    return Array.from(values, (v) =>
      v == null ? null : String(v).toUpperCase(),
    );
  },
});

// Functions are served through a catalog — that's what DuckDB ATTACHes to.
new Worker({
  catalog: { name: "demo", schemas: [{ name: "main", functions: [upperCase] }] },
}).run();`,
  },
  {
    id: 'go',
    label: 'Go',
    icon: 'simple-icons:go',
    lang: 'go',
    title: 'main.go',
    code: `package main

import (
	"context"
	"strings"

	"github.com/Query-farm/vgi-go/vgi"
	"github.com/apache/arrow-go/v18/arrow"
	"github.com/apache/arrow-go/v18/arrow/array"
)

// UpperCaseFunction converts string values to uppercase.
type UpperCaseFunction struct{}

func (f *UpperCaseFunction) Name() string { return "upper_case" }

func (f *UpperCaseFunction) Metadata() vgi.FunctionMetadata {
	return vgi.FunctionMetadata{
		Description: "Converts string values to uppercase",
		Stability:   vgi.StabilityConsistent,
		ReturnType:  arrow.BinaryTypes.String,
	}
}

func (f *UpperCaseFunction) ArgumentSpecs() []vgi.ArgSpec {
	return []vgi.ArgSpec{
		{Name: "value", Position: 0, ArrowType: "varchar", Doc: "String value to uppercase"},
	}
}

func (f *UpperCaseFunction) OnBind(params *vgi.BindParams) (*vgi.BindResponse, error) {
	return vgi.BindResult(arrow.BinaryTypes.String)
}

func (f *UpperCaseFunction) Process(ctx context.Context, params *vgi.ProcessParams, batch arrow.RecordBatch) (arrow.RecordBatch, error) {
	get := vgi.StringAccessor(batch.Column(0)) // hoist the type switch out of the row loop
	return vgi.MapColumn(params, batch, 0, array.NewStringBuilder,
		func(_ arrow.Array, i int) string {
			return strings.ToUpper(get(i))
		})
}

func main() {
	w := vgi.NewWorker(vgi.WithCatalogName("demo"))
	w.RegisterScalar(&UpperCaseFunction{})
	w.RunStdio()
}`,
  },
  {
    id: 'rust',
    label: 'Rust',
    icon: 'simple-icons:rust',
    lang: 'rust',
    title: 'src/main.rs',
    code: `use std::sync::Arc;

use arrow_array::{cast::AsArray, ArrayRef, RecordBatch, StringArray};
use arrow_schema::DataType;
use vgi::{ArgSpec, FunctionMetadata, ProcessParams, ScalarFunction, Worker};
use vgi_rpc::{Result, RpcError};

/// \`upper_case(s)\` — uppercase a string column.
struct UpperCase;

impl ScalarFunction for UpperCase {
    fn name(&self) -> &str {
        "upper_case"
    }

    fn metadata(&self) -> FunctionMetadata {
        FunctionMetadata {
            description: "Convert string values to uppercase".into(),
            return_type: Some(DataType::Utf8),
            ..Default::default()
        }
    }

    fn argument_specs(&self) -> Vec<ArgSpec> {
        vec![ArgSpec::column("value", 0, "varchar", "String to uppercase")]
    }

    fn process(&self, params: &ProcessParams, batch: &RecordBatch) -> Result<RecordBatch> {
        let col = batch.column(0).as_string::<i32>();
        let upper: StringArray = col.iter().map(|v| v.map(str::to_uppercase)).collect();
        let out: ArrayRef = Arc::new(upper);
        RecordBatch::try_new(params.output_schema.clone(), vec![out])
            .map_err(|e| RpcError::runtime_error(e.to_string()))
    }
}

fn main() {
    let mut worker = Worker::new();
    worker.register_scalar(UpperCase);
    worker.run(); // serves stdio (default), --unix <path>, or --http
}`,
  },
  {
    id: 'java',
    label: 'Java',
    icon: 'simple-icons:openjdk',
    lang: 'java',
    title: 'DemoWorker.java',
    code: `import farm.query.vgi.Worker;
import farm.query.vgi.scalar.ScalarFn;
import farm.query.vgi.scalar.Vector;
import org.apache.arrow.vector.VarCharVector;

import java.nio.charset.StandardCharsets;
import java.util.Locale;

public final class DemoWorker {

    /** {@code upper_case(value: utf8) -> utf8} */
    static final class UpperCase extends ScalarFn {
        @Override public String name() { return "upper_case"; }
        @Override public String description() { return "Converts string values to uppercase"; }

        public void compute(@Vector VarCharVector value, VarCharVector result) {
            int rows = value.getValueCount();
            for (int i = 0; i < rows; i++) {
                if (value.isNull(i)) { result.setNull(i); continue; }
                byte[] up = new String(value.get(i), StandardCharsets.UTF_8)
                        .toUpperCase(Locale.ROOT)
                        .getBytes(StandardCharsets.UTF_8);
                result.setSafe(i, up, 0, up.length);
            }
        }
    }

    public static void main(String[] args) {
        Worker worker = Worker.builder()
                .catalogName("demo")
                .registerScalar(new UpperCase());
        worker.runFromArgs(args); // stdio by default; --unix / --http via flags
    }
}`,
  },
];

// The C tab is the native-extension comparison, NOT a VGI SDK — which is how
// the link below came to read "All six SDKs" while five exist: it counted the
// tabs. Derive it instead, so adding an SDK tab updates the sentence.
const sdkCountWord = countWord(implTabs.filter(t => t.id !== 'c').length);


// ── The five function shapes. Glyphs are the same SVGs the Python docs use
// (public/vgi/docs/assets/kinds/) rather than redrawn here, so the shape
// vocabulary is identical wherever a reader meets it.
//
// Each shape also carries its accent hue, and it is the *same* hue the docs
// use: the glyph fills baked into those SVGs are literally the `cat-*-ink`
// tokens (slate/field/plum/gold/clay — see starlight-kinds.css, which must
// move with the artwork). So a reader meets scalar-is-slate here and again in
// the Python how-to. Colour is carrying the shape distinction, which is the
// sanctioned use for the category tints (DESIGN_BRIEF §10); classes are
// written out in full rather than composed, since Tailwind scans source text.
const shapes = [
  {
    name: 'Scalar',
    glyph: '/vgi/docs/assets/kinds/scalar.svg',
    edge: 'border-l-[3px] border-l-cat-slate-ink',
    chip: 'border-cat-slate-ink/25 bg-cat-slate',
    pill: 'bg-cat-slate text-cat-slate-ink',
    formula: '1 row → 1 value',
    sql: 'SELECT f(col) FROM t',
    duckdb: "DuckDB's scalar function (`duckdb_create_scalar_function`)",
    body: 'Transform each row independently. You receive the whole column as an Arrow array and return one — the vectorized shape, not a per-row callback.',
    href: '/vgi/docs/python/how-to/function-patterns/#scalar',
  },
  {
    name: 'Table',
    glyph: '/vgi/docs/assets/kinds/table.svg',
    edge: 'border-l-[3px] border-l-cat-field-ink',
    chip: 'border-cat-field-ink/25 bg-cat-field',
    pill: 'bg-cat-field text-cat-field-ink',
    formula: 'args → N rows',
    sql: 'SELECT * FROM f(args)',
    duckdb: "DuckDB's table function (`duckdb_create_table_function`)",
    body: 'Generate rows from scalar arguments, with no input relation. Bind declares the schema; process is called repeatedly, so large results stream a bounded batch at a time.',
    href: '/vgi/docs/python/how-to/function-patterns/#table',
  },
  {
    name: 'Table-in-out',
    glyph: '/vgi/docs/assets/kinds/table-in-out.svg',
    edge: 'border-l-[3px] border-l-cat-plum-ink',
    chip: 'border-cat-plum-ink/25 bg-cat-plum',
    pill: 'bg-cat-plum text-cat-plum-ink',
    formula: 'N rows → M rows',
    sql: 'SELECT * FROM f((SELECT …))',
    duckdb: "DuckDB's in-out table function",
    body: 'Consume a relation and stream a transformed relation back, batch by batch. Filter, enrich, reshape — nothing is held, so input size is unbounded.',
    href: '/vgi/docs/python/how-to/function-patterns/#table-in-out',
  },
  {
    name: 'Aggregate',
    glyph: '/vgi/docs/assets/kinds/aggregate.svg',
    edge: 'border-l-[3px] border-l-cat-gold-ink',
    chip: 'border-cat-gold-ink/25 bg-cat-gold',
    pill: 'bg-cat-gold text-cat-gold-ink',
    formula: 'N rows → 1 value',
    sql: 'SELECT f(col) FROM t GROUP BY k',
    duckdb: "DuckDB's aggregate function (`duckdb_create_aggregate_function`)",
    body: 'Fold rows into per-group state, then emit a row per group. `combine` merges partial states, which is what lets DuckDB run your aggregate in parallel.',
    href: '/vgi/docs/python/how-to/function-patterns/#aggregate',
