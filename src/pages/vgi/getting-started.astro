---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const runHaybarn = `# Fastest path: run the latest Haybarn with npm / npx.
npx haybarn@latest

# Or run Haybarn with uvx / pipx.
uvx haybarn-cli
pipx run haybarn-cli`;

const installExtension = `-- Install VGI from the community extension repository.
INSTALL vgi FROM community;

-- If you need to refresh an existing install, use:
-- FORCE INSTALL vgi FROM community;

-- Load VGI into this Haybarn session.
LOAD vgi;

-- Verify it is ready. installed and loaded should both be true.
SELECT extension_name, installed, loaded
FROM duckdb_extensions()
WHERE extension_name = 'vgi';`;

const verifyVgiOutput = `┌────────────────┬───────────┬─────────┐
│ extension_name │ installed │ loaded  │
│    varchar     │  boolean  │ boolean │
├────────────────┼───────────┼─────────┤
│ vgi            │ true      │ true    │
└────────────────┴───────────┴─────────┘`;

const installPython = `# This will work once the VGI Python package is public.
pip install vgi
# or
uv add vgi`;

const attachHostedWorker = `-- Attach a hosted VGI worker.
ATTACH 'volcanos' AS volcanos (
  TYPE vgi,
  LOCATION 'https://vgi-volcanos.fly.dev/'
);`;

const queryHostedWorker = `-- See the schemas exposed by the worker.
SELECT catalog_name, schema_name
FROM information_schema.schemata
WHERE catalog_name = 'volcanos';

-- See the tables and views exposed by the worker.
SELECT table_schema, table_name, table_type
FROM information_schema.tables
WHERE table_catalog = 'volcanos'
ORDER BY table_schema, table_name;

-- Query the hosted worker like any other SQL catalog.
SELECT *
FROM volcanos.smithsonian.pleistocene_volcanoes
LIMIT 10;`;

const installHaybarnPython = `# This will work once the Haybarn Python package is public.
pip install haybarn`;

const scriptHostedWorker = `import haybarn

con = haybarn.connect()

con.sql("INSTALL vgi FROM community")
con.sql("LOAD vgi")

con.sql("""
  ATTACH 'volcanos' AS volcanos (
    TYPE vgi,
    LOCATION 'https://vgi-volcanos.fly.dev/'
  )
  """)

rows = con.sql("""
SELECT *
FROM volcanos.smithsonian.pleistocene_volcanoes
LIMIT 10
""").fetchall()

for row in rows:
    print(row)`;

const workerSource = `#!/usr/bin/env python3

from typing import Annotated

import pyarrow as pa
import pyarrow.compute as pc
from vgi import Param, Returns, ScalarFunction, Worker
from vgi.catalog import Catalog, Schema


class UpperCaseFunction(ScalarFunction):
    """Converts string values to uppercase."""

    class Meta:
        name = "upper_case"
        description = "Converts string values to uppercase"

    @classmethod
    def compute(
        cls,
        value: Annotated[pa.StringArray, Param(doc="String to uppercase")],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.utf8_upper(value)


class MyWorker(Worker):
    catalog = Catalog(
        name="my_worker",
        default_schema="main",
        schemas=[
            Schema(name="main", functions=[UpperCaseFunction]),
        ],
    )


if __name__ == "__main__":
    MyWorker().run()`;

const localWorkerHaybarn = `# From the same directory as my_worker.py, start the latest Haybarn.
pipx run haybarn-cli`;

const attachLocalWorker = `-- Attach your local worker as a catalog.
ATTACH 'my_worker' AS my_worker (
  TYPE vgi,
  LOCATION 'python3 ./my_worker.py',
  pool false
);

-- Confirm the worker registered its SQL function.
SELECT database_name, schema_name, function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'my_worker';

-- Call it from SQL.
SELECT my_worker.upper_case('hello');`;
---

<PageLayout
  title="VGI — Getting Started"
  description="Attach a hosted VGI worker, then see how to build your own SQL-accessible VGI worker."
>
  <Hero
    title="Getting Started with VGI"
    subtitle="Two paths: connect SQL to a hosted worker, or build your own worker and expose it as SQL."
    primaryCTA={{ text: "GitHub", href: "https://github.com/Query-farm/vgi" }}
    secondaryCTA={{ text: "Architecture →", href: "/vgi/architecture" }}
  />

  <!-- Guide navigation -->
  <section class="py-8 bg-white border-b border-soil-200">
    <div class="section-container">
      <nav class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-2 text-sm" aria-label="Getting started steps">
        {[
          { label: 'Attach a hosted worker', href: '#hosted-worker' },
          { label: 'Make your own worker', href: '#make-worker' },
        ].map((item) => (
          <a href={item.href} class="rounded-full border border-soil-200 bg-soil-50 px-3 py-1.5 text-soil-700 hover:border-harvest-400 hover:text-harvest-700 transition-colors">
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Attach a hosted worker -->
  <section id="hosted-worker" class="py-16 lg:py-20 bg-white scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wide text-harvest-700 mb-3">Path 1</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-soil-900 mb-4">Attach a hosted VGI worker</h2>
        <p class="text-soil-700 leading-relaxed mb-6">
          VGI lets Haybarn turn a remote service into a SQL catalog. In this example, a VGI worker at <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">https://vgi-volcanos.fly.dev/</code> wraps volcano-related datasets, including Smithsonian Global Volcanism Program data. You do not download the dataset, write ETL, or install a custom local extension. Haybarn attaches to the worker, discovers the schemas and tables it exposes, and lets you query them with ordinary SQL. If you want to expose your own API, dataset, or service this way, see <a href="#make-worker" class="text-harvest-700 underline">Make your own worker</a>.
        </p>
        <p class="text-soil-700 leading-relaxed mb-6">
          The key idea: the data access logic lives behind the VGI URL; Haybarn provides the SQL interface.
        </p>

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Run Haybarn</h3>
        <p class="text-soil-700 leading-relaxed mb-6">
          Haybarn is Query.Farm's DuckDB-compatible distribution. The commands below run the latest Haybarn release without pinning a version.
        </p>
        <CodeBlock code={runHaybarn} lang="bash" title="terminal" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          Need platform-specific binaries, provenance verification, or more install channels? See the <a href="/haybarn/install" class="text-harvest-700 underline">full Haybarn install guide</a>.
        </p>

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Install and load VGI</h3>
        <p class="text-soil-700 leading-relaxed mb-6">
          Once you are inside the Haybarn shell, install and load the <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">vgi</code> extension.
        </p>
        <CodeBlock code={installExtension} lang="sql" title="Haybarn shell" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          After the verification query, the result should show both <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">installed</code> and <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">loaded</code> as true:
        </p>
        <div class="mt-4">
          <CodeBlock code={verifyVgiOutput} lang="text" title="expected result" />
        </div>

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Attach the hosted worker</h3>
        <p class="text-soil-700 leading-relaxed mb-6">
          With VGI loaded, attach the remote worker. <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">LOCATION</code> is the worker endpoint.
        </p>
        <p class="text-soil-700 leading-relaxed mb-6">
          The alias after <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">AS</code> becomes the catalog name. Here, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">AS volcanos</code> means later queries use names like <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">volcanos.smithsonian.pleistocene_volcanoes</code>.
        </p>
        <CodeBlock code={attachHostedWorker} lang="sql" title="Haybarn shell" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          After attaching, Haybarn may open an auth screen. Log in there to continue; the check is there to limit automated traffic to the demo worker. The worker only receives the VGI requests needed to answer your SQL queries.
        </p>

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Query it with SQL</h3>
        <p class="text-soil-700 leading-relaxed mb-6">
          Once the worker is attached, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">volcanos</code> behaves like an attached database. You can inspect its schemas and tables through <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">information_schema</code>, then query worker-backed tables with normal SQL.
        </p>
        <p class="text-soil-700 leading-relaxed mb-6">
          The discovery queries show schemas such as <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">earthquakes</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">hans</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">smithsonian</code>, and <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">vsc</code>. From there, tables like <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">volcanos.smithsonian.pleistocene_volcanoes</code> are available directly in SQL.
        </p>
        <CodeBlock code={queryHostedWorker} lang="sql" title="Haybarn shell" />

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Use it from a Python script</h3>
        <div class="mb-6 rounded-lg border border-harvest-200 bg-harvest-50 p-4 text-sm text-soil-700 leading-relaxed">
          This script example assumes the Haybarn Python package is available from the public Python package index. Until that package is public, use the Haybarn shell example above.
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          Install Haybarn in the Python environment that will run your script.
        </p>
        <CodeBlock code={installHaybarnPython} lang="bash" title="terminal" />
        <p class="mt-8 text-soil-700 leading-relaxed mb-6">
          Then use the same attach and query flow from application code through the Haybarn Python API.
        </p>
        <CodeBlock code={scriptHostedWorker} lang="python" title="volcanos.py" />
      </div>
    </div>
  </section>

  <!-- Make your own worker -->
  <section id="make-worker" class="py-16 lg:py-20 bg-soil-50 scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wide text-harvest-700 mb-3">Path 2</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-soil-900 mb-4">Make your own worker</h2>
        <div class="mb-6 rounded-lg border border-harvest-200 bg-harvest-50 p-4 text-sm text-soil-700 leading-relaxed">
          This local-worker example assumes the VGI Python package is available from the public Python package index. That release is not public yet, so this section is a preview and will be updated when the package is published.
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          To make your own VGI worker, install the Python framework. The package gives you the base classes (<code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">ScalarFunction</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Worker</code>, etc.) and the runtime that speaks the wire protocol.
        </p>
        <CodeBlock code={installPython} lang="bash" title="terminal" />
        <p class="mt-8 text-soil-700 leading-relaxed mb-6">
          Then create a worker file. Declare functions as classes with a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">compute</code> method, list them on a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Worker</code>, and add a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">__main__</code> guard so the worker can run as a subprocess.
        </p>
        <CodeBlock code={workerSource} lang="python" title="my_worker.py" />
        <p class="mt-4 text-sm text-soil-600">
          Prefer a different language? See <a href="/vgi/languages" class="text-harvest-700 underline">Languages</a> for the TypeScript, Go, Rust, Java, and C++ SDKs.
        </p>

        <h3 class="text-xl font-bold text-soil-900 mt-10 mb-3">Attach your local worker</h3>
        <div class="mb-6 rounded-lg border border-harvest-200 bg-harvest-50 p-4 text-sm text-soil-700 leading-relaxed">
          This command assumes <code class="text-sm bg-white px-1.5 py-0.5 rounded">pip install vgi</code> works in the Python environment that runs <code class="text-sm bg-white px-1.5 py-0.5 rounded">my_worker.py</code>. Until the package is public, use the hosted worker example above.
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          Once you have a local worker file, attach it as a catalog from Haybarn. Its functions become first-class SQL functions you can use in <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">SELECT</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">WHERE</code>, joins, and pipelines.
        </p>
        <CodeBlock code={localWorkerHaybarn} lang="bash" title="terminal" />
        <div class="mt-6">
        <CodeBlock code={attachLocalWorker} lang="sql" title="Haybarn shell" />
        </div>
      </div>
    </div>
  </section>

  <!-- Next steps -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Next steps"
        title="Where to from here"
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/vgi/architecture" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🏗️</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Architecture</h3>
            <p class="text-sm text-soil-700">Transports, lifecycle, wire format.</p>
          </Card>
        </a>
        <a href="/vgi/languages" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🌍</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Other languages</h3>
            <p class="text-sm text-soil-700">TypeScript, Go, Rust, Java, C++ SDKs.</p>
          </Card>
        </a>
        <a href="https://github.com/Query-farm/vgi-python" class="block" target="_blank" rel="noopener noreferrer">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">📖</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Full Python docs</h3>
            <p class="text-sm text-soil-700">README, examples, fixtures on GitHub.</p>
          </Card>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Stuck or want a hand?</h2>
      <p class="text-lg md:text-xl text-harvest-50 mb-6">
        We help teams design and ship VGI-based extensions.
      </p>
      <Button href="/consulting" variant="secondary" size="lg">Talk to us</Button>
    </div>
  </section>
</PageLayout>
