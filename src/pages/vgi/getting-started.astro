---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import ResultTable from '../../components/ui/ResultTable.astro';
import PageToc from '../../components/vgi/PageToc.astro';
import { GRID, HEAD_CONTAINER } from '../../lib/vgi-layout';
import JoinPlanDiagram from '../../components/vgi/JoinPlanDiagram.astro';
import ExampleShellMounter from '../../components/repl/ExampleShellMounter.tsx';
import { cupolaLaunchUrl } from '../../data/cupola';

// ── Shared shape vocabulary (brief §10) ──
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';
const H2 = 'mt-12 scroll-mt-32 border-t border-soil-300 pt-6 text-2xl md:text-3xl text-soil-900';
const H3 = 'mt-9 scroll-mt-32 text-xl text-soil-900';
const P = 'mt-4 leading-relaxed text-soil-700';
const CODE = 'rounded bg-soil-100 px-1.5 py-0.5 font-mono text-[0.88em] text-soil-900';
const LINK = 'text-link underline decoration-link/40 underline-offset-2 hover:decoration-link';

const CURRENT = '/vgi/getting-started';

// This page is deliberately consumer-first and short. Nearly everyone meets VGI
// by attaching a worker somebody else runs, not by writing one — so the whole
// page is that path, and "build your own" is a signpost to
// /vgi/building-a-worker rather than a second walkthrough inline. It used to
// carry both, and the build half (clone the repo, prompt an agent, deploy to
// Fly.io, query an NYC dataset) now lives on that page as "Ship one with an
// agent".
//
// The workers below are two of the three the homepage's 10-second tour uses,
// and they need no auth — which is why they replaced the volcanos worker this
// page used to lead with: that one still answers `ATTACH` with an
// authentication round trip, which is a poor first sixty seconds.
//
// Every sql/result pair is VERIFIED, not illustrative: each query was run
// against the live worker in one session on 2026-08-17 via the local build at
// ~/Development/vgi/build/release/haybarn (loading the matching
// build/release/extension/vgi/vgi.duckdb_extension — stock Homebrew DuckDB is
// ABI-pinned to a different core commit and won't load it), and the tables
// below are that run's actual stdout. Both are live feeds, so a reader's
// numbers will differ; they are a sample of the shape, not a promise of values.
const toc: { id: string; label: string; sub?: boolean }[] = [
  { id: 'attach', label: 'Attach your first worker' },
  { id: 'run-haybarn', label: 'Run Haybarn', sub: true },
  { id: 'install-vgi', label: 'Load VGI', sub: true },
  { id: 'first-query', label: 'Attach and query', sub: true },
  { id: 'examples', label: 'More to query' },
  { id: 'compose', label: 'Workers compose' },
  { id: 'functions', label: 'Not just data' },
  { id: 'build', label: 'Build a worker' },
  { id: 'next-steps', label: 'Where to from here' },
];

const runHaybarn = `# Haybarn is Query.Farm's DuckDB-compatible distribution.
npx haybarn@latest

# Or with uvx / pipx:
uvx haybarn-cli
pipx run haybarn-cli`;

const installVgi = `INSTALL vgi FROM community;
LOAD vgi;`;

// `strftime` rather than the bare timestamp: the raw column is
// `timestamp with time zone`, which prints as `2026-08-14 21:58:21.564+00` under
// a `timestamp with time zone` type header — sub-second precision and a UTC
// offset nobody reads, in the widest column of the table. Formatting it to the
// minute and moving it last takes the result from 90 columns to 72, which is the
// difference between fitting the page and scrolling sideways on the first
// example a reader ever sees.
const attachEarthquakes = `ATTACH 'earthquakes' AS eq (
  TYPE vgi,
  LOCATION 'https://vgi-earthquakes.rusty-bb6.workers.dev'
);

-- eq is now an ordinary catalog. Query it with ordinary SQL.
SELECT round(mag, 1) AS mag,
       place,
       strftime(time, '%Y-%m-%d %H:%M') AS utc
FROM eq.main.recent
WHERE mag >= 6
ORDER BY mag DESC
LIMIT 6;`;

// Same worker, no terminal. The tour workers all send
// `access-control-allow-origin: *`, which is what makes a browser-side engine
// able to reach them at all.
const cupolaEarthquakes = cupolaLaunchUrl('https://vgi-earthquakes.rusty-bb6.workers.dev');

const weatherSql = `ATTACH 'open_meteo' AS m (
  TYPE vgi,
  LOCATION 'https://vgi-open-meteo.rusty-bb6.workers.dev'
);

-- Geocode the place, then LATERAL-join its coordinates straight into the
-- forecast call — one round trip per row, no separate lookup step.
SELECT strftime(w.time, '%a %H:%M')              AS hour,
       round(w.temperature_2m, 1)                AS temp_f,
       m.main.weather_code_emoji(w.weather_code) AS icon,
       m.main.weather_code_text(w.weather_code)  AS conditions
FROM m.main.geocoding('Glen Allen, VA', count := 1, country_code := 'US') AS g,
     LATERAL m.main.forecast_hourly(g.latitude, g.longitude,
                                    forecast_days := 2,
                                    temperature_unit := 'fahrenheit') AS w
WHERE w.time >= now()
ORDER BY w.time
LIMIT 5;`;

const joinSql = `ATTACH 'earthquakes' AS eq (TYPE vgi, LOCATION 'https://vgi-earthquakes.rusty-bb6.workers.dev');
ATTACH 'open_meteo'  AS m  (TYPE vgi, LOCATION 'https://vgi-open-meteo.rusty-bb6.workers.dev');

-- Two workers in one session: one wrapping the USGS feed, one the forecast
-- API. DuckDB plans across them.
SELECT round(q.mag, 1) AS mag,
       q.place,
       round(w.temperature_2m, 1) AS temp_c,
       m.main.weather_code_text(w.weather_code) AS conditions
FROM (SELECT * FROM eq.main.recent WHERE mag >= 6 ORDER BY mag DESC LIMIT 5) AS q,
     LATERAL m.main.forecast_current(q.latitude, q.longitude) AS w;`;

// Results are STRUCTURED, not the shell's box-drawing output pasted into a code
// block. That is what they used to be, and it renders badly: the `│ ├ ┼ ┘`
// glyphs are drawn to butt together at line-height 1, so at the web font's
// line-height every vertical rule breaks into dashes. As data they render
// through ResultTable.astro — real rows that wrap and scroll on a phone, with
// figures set tabular. Values are still this machine's verified output; they
// were parsed out of the transcript rather than retyped.
const earthquakesResult = {
  columns: ["mag", "place", "utc"],
  numericCols: [0],
  rows: [
    [7.7, "68 km NNW of Ende, Indonesia", "2026-08-14 21:58"],
    [7.4, "5 km S of San José del Palmar, Colombia", "2026-08-10 12:34"],
    [6.9, "15 km NNW of Pematangsiantar, Indonesia", "2026-08-15 10:54"],
    [6.8, "The 2026 Kumamoto Region, Japan Earthquake", "2026-07-28 07:27"],
    [6.3, "south of the Kermadec Islands", "2026-08-05 07:43"],
    [6.3, "32 km SW of Sarangani, Philippines", "2026-08-05 04:14"],
  ],
};

const weatherResult = {
  columns: ["hour", "temp_f", "icon", "conditions"],
  numericCols: [1],
  rows: [
    ["Mon 21:00", 90.7, "☀️", "Clear sky"],
    ["Mon 22:00", 89.0, "☀️", "Clear sky"],
    ["Mon 23:00", 86.5, "☀️", "Clear sky"],
    ["Tue 00:00", 83.9, "☁️", "Overcast"],
    ["Tue 01:00", 79.0, "☁️", "Overcast"],
  ],
};

// A worker publishes FUNCTIONS, not just tables — the point of the "more than a
// data source" section. These four are the open-meteo worker's own, called with
// no FROM clause at all, which is the cleanest way to show they are the
// worker's and not DuckDB's. Verified in the same session as everything else.
const functionsSql = `ATTACH 'open_meteo' AS m (TYPE vgi, LOCATION 'https://vgi-open-meteo.rusty-bb6.workers.dev');

-- No table, no FROM — these functions belong to the worker.
SELECT m.main.weather_code_emoji(95) AS icon,
       m.main.weather_code_text(95)  AS conditions,
       m.main.wind_compass(247)      AS wind,
       m.main.uv_index_category(8.2) AS uv;`;

const functionsResult = {
  columns: ["icon", "conditions", "wind", "uv"],
  numericCols: [],
  rows: [
    ["\u26c8\ufe0f", "Thunderstorm", "WSW", "Very High"],
  ],
};

const listFunctionsSql = `ATTACH 'open_meteo' AS m (TYPE vgi, LOCATION 'https://vgi-open-meteo.rusty-bb6.workers.dev');

-- Everything this worker publishes, by kind.
SELECT function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'm'
ORDER BY function_type, function_name;`;

const joinResult = {
  columns: ["mag", "place", "temp_c", "conditions"],
  numericCols: [0, 2],
  rows: [
    [7.7, "68 km NNW of Ende, Indonesia", 24.9, "Clear sky"],
    [7.4, "5 km S of San José del Palmar, Colombia", 20.8, "Slight rain showers"],
    [6.9, "15 km NNW of Pematangsiantar, Indonesia", 23.4, "Overcast"],
    [6.8, "The 2026 Kumamoto Region, Japan Earthquake", 24.5, "Mainly clear"],
    [6.3, "32 km SW of Sarangani, Philippines", 28.2, "Mainly clear"],
  ],
};
---

<PageLayout
  title="VGI — Getting Started"
  description="Attach a hosted VGI worker in about a minute and query it with ordinary SQL. No ETL, no connector plumbing, no native extension to build."
>
  <VGISubNav />

  {/* Puts a "Try it in your browser" button under every runnable SQL block on
      the page. It scans `pre[data-language="sql"]`, so a block that shouldn't
      get one opts out with `tryable={false}` on CodeBlock — and because each
      shell is an isolated in-memory session, every block that DOES get one
      carries its own ATTACH rather than relying on an earlier example. */}
  <ExampleShellMounter client:load extensionName="VGI" installSource="community" fixtures={null} />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    container={HEAD_CONTAINER}
    eyebrow="Guide"
    title="Query a VGI worker in a minute"
    lede="You don't have to build anything to use VGI. Attach a worker somebody else already runs, and it behaves like any other SQL catalog."
  >
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button href="#attach" variant="primary" size="md">Start querying</Button>
    </div>
  </PageHead>

  <!-- ── Docs grid: section nav / content / page TOC ──────────── -->
  <div class={GRID}>
    <PageToc items={toc} reference={[{ label: 'VGI extension', href: '/products/extensions/vgi' }]} />

    <!-- Not a landmark element: BaseLayout already renders the page's single main. -->

    <div class="min-w-0">
      <p class={LEDE}>
        A VGI worker is a program that exposes an API, dataset, model, or internal service as SQL.
        You <code class={CODE}>ATTACH</code> it by URL and query it — no download, no ETL, no
        connector to write, no custom extension to compile. Both workers used below are public
        and need no credentials.
      </p>

      <!-- ── Attach ─────────────────────────────────────────── -->
      <h2 id="attach" class="mt-10 scroll-mt-32 text-2xl md:text-3xl text-soil-900">Attach your first worker</h2>

      <h3 id="run-haybarn" class={H3}>Run Haybarn</h3>
      <p class={P}>
        Haybarn is Query.Farm's DuckDB-compatible distribution, and it ships the VGI extension.
      </p>
      <div class="mt-4"><CodeBlock code={runHaybarn} lang="bash" title="terminal" /></div>
      <p class="mt-4 text-sm leading-relaxed text-soil-700">
        Platform binaries, provenance verification and more install channels are in the
        <a href="/products/haybarn/install" class={LINK}>Haybarn install guide</a>.
      </p>

      <h3 id="install-vgi" class={H3}>Load VGI</h3>
      <p class={P}>Once, inside the Haybarn shell:</p>
      <div class="mt-4"><CodeBlock code={installVgi} lang="sql" title="Haybarn shell" tryable={false} /></div>
      <p class="mt-4 text-sm leading-relaxed text-soil-700">
        Already installed it before? <code class={CODE}>FORCE INSTALL vgi FROM community</code>
        refreshes it.
      </p>

      <h3 id="first-query" class={H3}>Attach and query</h3>
      <p class={P}>
        This worker wraps the live feed from the
        <a href="https://earthquake.usgs.gov/" class={LINK} target="_blank" rel="noopener noreferrer">USGS Earthquake Hazards Program</a>
        — the same 30-day catalog seismologists watch — and serves it as a table.
      </p>
      <div class="mt-4"><CodeBlock code={attachEarthquakes} lang="sql" title="Haybarn shell" /></div>
      <ResultTable columns={earthquakesResult.columns} rows={earthquakesResult.rows} numericCols={earthquakesResult.numericCols} />
      <p class={P}>
        That is the whole idea. The alias after <code class={CODE}>AS</code> becomes the catalog
        name, and everything downstream is ordinary SQL — joins, aggregates, window functions,
        <code class={CODE}>CREATE TABLE AS</code>.
      </p>
      <!-- Cupola: the no-install path to the same worker. Worth surfacing here
           rather than only in "where to next" — a reader who doesn't want a
           terminal has otherwise bounced by this point. -->
      <div class={`mt-8 ${CARD} flex flex-wrap items-center justify-between gap-5 px-6 py-6`}>
        <div class="max-w-[52ch]">
          <h3 class="text-xl text-soil-900">Prefer not to install anything?</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            <a href="/products/cupola" class={LINK}>Cupola</a> is a free SQL workbench that runs
            DuckDB in a browser tab — with charts, pivots and an AI analyst. This link opens it
            pointed at the same earthquake worker, no download and no setup.
          </p>
        </div>
        <Button href={cupolaEarthquakes} variant="primary" size="md" external>Open in Cupola ↗</Button>
      </div>

      <!-- ── More examples ──────────────────────────────────── -->
      <h2 id="examples" class={H2}>More things you can query</h2>
      <p class={P}>
        Same two steps — <code class={CODE}>ATTACH</code>, then SQL — against very different
        services. Neither of these is a dataset sitting in a bucket; both are live APIs a worker
        is translating on the fly.
      </p>

      <h3 class={H3}>A weather API, as table functions</h3>
      <p class={P}>
        <a href="https://open-meteo.com/" class={LINK} target="_blank" rel="noopener noreferrer">Open-Meteo</a>
        is a free, open-source weather API. This worker exposes its geocoding and hourly-forecast
        endpoints as table functions, so a place name and a forecast join in one query.
      </p>
      <div class="mt-4"><CodeBlock code={weatherSql} lang="sql" title="Haybarn shell" /></div>
      <ResultTable columns={weatherResult.columns} rows={weatherResult.rows} numericCols={weatherResult.numericCols} />
      <!-- ── Compose ────────────────────────────────────────── -->
      <h2 id="compose" class={H2}>Workers compose</h2>
      <p class={P}>
        The part that pays off: attach more than one worker in the same session and query across
        them. Neither service knows the other exists, and you did not build a pipeline to put them
        in the same place — DuckDB plans across both catalogs.
      </p>
      <p class={P}>
        Attach both, then ask what the weather is right now at the sites of the largest recent
        earthquakes — one query, two services, no pipeline in between.
      </p>
      <div class="mt-4"><CodeBlock code={joinSql} lang="sql" title="Haybarn shell" /></div>
      <ResultTable columns={joinResult.columns} rows={joinResult.rows} numericCols={joinResult.numericCols} />
      <p class="mt-4 text-sm leading-relaxed text-soil-700">
        These are live feeds, so your numbers will differ from the samples above.
      </p>

      <h3 class={H3}>What the planner does with that</h3>
      <p class={P}>
        This is not two queries stapled together. DuckDB plans the whole thing at once, and pushes
        what it can to the far side: the earthquake worker is asked for four columns with
        <code class={CODE}>mag &gt;= 6</code> already applied, rather than for the table.
      </p>
      <JoinPlanDiagram />
      <p class="mt-5 text-sm leading-relaxed text-soil-700">
        Put <code class={CODE}>EXPLAIN</code> in front of the query to see it yourself — the plan
        names <code class={CODE}>VGI_TABLE_SCAN</code> and <code class={CODE}>VGI_LATERAL_BATCH</code>,
        and prints the filter and projection list each worker was handed. Pushdown is opt-in per
        worker; see <a href="/vgi/architecture#catalogs" class={LINK}>Workers are first-class catalogs</a>.
      </p>

      <!-- ── Not just data ──────────────────────────────────── -->
      <h2 id="functions" class={H2}>Not just data — functions too</h2>
      <p class={P}>
        It is easy to read all of the above as "VGI is a way to fetch remote tables." It is not. A
        worker publishes <strong class="font-medium text-soil-900">functions</strong>, and a table is
        only one of the shapes they come in. You have already been calling them: every
        <code class={CODE}>icon</code> and <code class={CODE}>conditions</code> value above came from
        a function the weather worker exposes, not from a column in a dataset.
      </p>
      <p class={P}>
        Called on their own, with no <code class={CODE}>FROM</code> clause at all, they look like any
        other SQL function — because to DuckDB that is exactly what they are:
      </p>
      <div class="mt-4"><CodeBlock code={functionsSql} lang="sql" title="Haybarn shell" /></div>
      <ResultTable columns={functionsResult.columns} rows={functionsResult.rows} numericCols={functionsResult.numericCols} />
      <p class={P}>
        That matters because the code behind a function runs <em>in your worker</em>, in your
        language, on your machines. So a VGI function can call a model, hit an internal API, apply a
        licensing rule, or reach a library that has no business being inside a database process —
        and to the person writing SQL it is just a function.
      </p>
      <p class={P}>
        A worker can expose five shapes in total — scalar, table, table-in-out, aggregate and
        buffering — plus macros, and the tables and views you have already seen. Ask any worker what
        it publishes:
      </p>
      <div class="mt-4"><CodeBlock code={listFunctionsSql} lang="sql" title="Haybarn shell" /></div>
      <p class="mt-4 text-sm leading-relaxed text-soil-700">
        The shapes are laid out in
        <a href="/vgi/docs/concepts/" class={LINK}>Concepts</a>, and in detail in
        <a href="/vgi/docs/concepts/lifecycle/" class={LINK}>Function lifecycle</a>.
      </p>

      <!-- ── Build ──────────────────────────────────────────── -->
      <h2 id="build" class={H2}>Want to build a VGI worker?</h2>
      <p class={P}>
        Everything above was consuming a worker. Writing one is the other half: you own an API, a
        dataset, a model or an internal service, and you want SQL access to it without building a
        pipeline first. A worker is an ordinary program in Python, Go, TypeScript, Rust, Java, or C# —
        no DuckDB internals, no C++, no rebuild per DuckDB release.
      </p>
      <div class={`mt-6 ${CARD} flex flex-wrap items-center justify-between gap-5 px-6 py-6`}>
        <div class="max-w-[52ch]">
          <h3 class="text-xl text-soil-900">Building a Worker</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            Whether you should build one at all, what a worker can expose, picking a language, how
            it runs and gets hosted — then your language's tutorial.
          </p>
        </div>
        <Button href="/vgi/building-a-worker" variant="primary" size="md">Start building →</Button>
      </div>

      <!-- ── Next steps ─────────────────────────────────────── -->
      <h2 id="next-steps" class={H2}>Where to from here</h2>
      <div class="mt-6 grid gap-3.5 sm:grid-cols-3">
        <a href="/vgi/architecture" class={`${CARD} block p-5 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
          <h3 class="text-lg text-soil-900">Architecture</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">Transports, lifecycle, wire format — and what the process hop costs.</p>
        </a>
        <a href="/vgi/connect-to-a-worker" class={`${CARD} block p-5 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
          <h3 class="text-lg text-soil-900">Connect to a worker</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">Every ATTACH option, transports, and settings.</p>
        </a>
        <a href="/vgi/docs/" class={`${CARD} block p-5 no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400`}>
          <h3 class="text-lg text-soil-900">SDK documentation</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">Concepts, tutorials and API reference for all six SDKs.</p>
        </a>
      </div>

      <div class={`mt-8 ${CARD} flex flex-wrap items-center justify-between gap-5 px-6 py-6`}>
        <div class="max-w-[46ch]">
          <h3 class="text-xl text-soil-900">Stuck or want a hand?</h3>
          <p class="mt-2 text-sm leading-relaxed text-soil-700">
            We help teams design and ship VGI-based extensions.
          </p>
        </div>
        <Button href="/consulting" variant="primary" size="md">Talk to us</Button>
      </div>
    </div>

  </div>
</PageLayout>
