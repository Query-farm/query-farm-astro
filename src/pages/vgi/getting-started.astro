---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { LATEST_RC_PYPI } from '../../data/haybarn-versions';

const installHaybarn = `# Fastest path: run Haybarn with npm / npx.
npx haybarn@rc

# Or run Haybarn with uvx / pipx.
uvx haybarn-cli==${LATEST_RC_PYPI}
pipx run haybarn-cli==${LATEST_RC_PYPI}`;

const startHaybarn = `# If Haybarn is not already running, start the SQL shell.
npx haybarn@rc

# Or use the Python toolchain.
uvx haybarn-cli==${LATEST_RC_PYPI}
pipx run haybarn-cli==${LATEST_RC_PYPI}`;

const installExtension = `-- Install VGI from the community extension repository.
INSTALL vgi FROM COMMUNITY;

-- Load VGI into this Haybarn session.
LOAD vgi;

-- Verify it is ready. installed and loaded should both be true.
SELECT extension_name, installed, loaded
FROM duckdb_extensions()
WHERE extension_name = 'vgi';`;

const verifyVgiOutput = `┌────────────────┬───────────┬─────────┐
│ extension_name │ installed │ loaded  │
│    varchar     │  boolean  │ boolean │
├────────────────┼───────────┼─────────┤
│ vgi            │ true      │ true    │
└────────────────┴───────────┴─────────┘`;

const installPython = `pip install vgi
# or
uv add vgi`;

const attachHostedWorker = `-- Attach a hosted VGI worker.
ATTACH 'my_worker' (TYPE vgi, LOCATION 'https://vgi-volcanos.fly.dev/');`;

const workerSource = `# my_worker.py
from typing import Annotated
import pyarrow as pa
import pyarrow.compute as pc
from vgi import ScalarFunction, Param, Returns, Worker


class Greeting(ScalarFunction):
    """Generate a greeting for each name."""

    @classmethod
    def compute(
        cls,
        name: Annotated[pa.StringArray, Param(doc="Column containing names")],
    ) -> Annotated[pa.StringArray, Returns()]:
        return pc.binary_join_element_wise("Hello, ", name, "!")


class MyWorker(Worker):
    functions = [Greeting]


if __name__ == "__main__":
    MyWorker().run()`;

const attachLocalWorker = `-- Attach your local worker as a catalog.
ATTACH 'my_worker' (TYPE vgi, LOCATION './my_worker.py');

-- Call the function on inline data.
SELECT greeting(name)
FROM (VALUES ('Alice'), ('Bob')) AS users(name);`;

const typedExample = `class AddValues(ScalarFunction):
    """Add two integer values together."""

    @classmethod
    def compute(
        cls,
        left: Annotated[pa.Int64Array, Param(type_bound=pa.types.is_integer)],
        right: Annotated[pa.Int64Array, Param(type_bound=pa.types.is_integer)],
    ) -> Annotated[pa.Int64Array, Returns()]:
        return pc.add(left, right)`;
---

<PageLayout
  title="VGI — Getting Started"
  description="Start Haybarn, install the vgi extension, attach a hosted worker, then build your own VGI worker."
>
  <Hero
    title="Getting Started with VGI"
    subtitle="Start Haybarn, install VGI, attach a hosted worker, then see how to build your own SQL-accessible worker."
    primaryCTA={{ text: "GitHub", href: "https://github.com/Query-farm/vgi" }}
    secondaryCTA={{ text: "Architecture →", href: "/vgi/architecture" }}
  />

  <!-- Guide navigation -->
  <section class="py-8 bg-white border-b border-soil-200">
    <div class="section-container">
      <nav class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-2 text-sm" aria-label="Getting started steps">
        {[
          { label: 'Set up Haybarn', href: '#setup-haybarn' },
          { label: 'Install VGI', href: '#install-vgi' },
          { label: 'Attach hosted worker', href: '#attach-hosted-worker' },
          { label: 'Build your own worker', href: '#build-worker' },
          { label: 'Attach local worker', href: '#attach-local-worker' },
          { label: 'Type bounds', href: '#type-bounds' },
        ].map((item) => (
          <a href={item.href} class="rounded-full border border-soil-200 bg-soil-50 px-3 py-1.5 text-soil-700 hover:border-harvest-400 hover:text-harvest-700 transition-colors">
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Step 0 — Set up Haybarn -->
  <section id="setup-haybarn" class="py-16 lg:py-20 bg-white scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">0</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Run Haybarn</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          Haybarn is Query.Farm's DuckDB-compatible distribution. It gives you the same SQL experience with Query.Farm's production packaging and extension distribution path, so this guide starts there. The commands below run Haybarn without a separate install step.
        </p>
        <CodeBlock code={installHaybarn} lang="bash" title="terminal" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          Need platform-specific binaries, provenance verification, or more install channels? See the <a href="/haybarn/install" class="text-harvest-700 underline">full Haybarn install guide</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Step 1 — Install the extension -->
  <section id="install-vgi" class="py-16 lg:py-20 bg-soil-50 scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">1</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Start Haybarn and install VGI</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          If Haybarn is not already running, start the shell first. Then install and load the <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">vgi</code> extension in that Haybarn session.
        </p>
        <CodeBlock code={startHaybarn} lang="bash" title="terminal" />
        <p class="mt-8 text-soil-700 leading-relaxed mb-6">
          Once you are inside the Haybarn shell, run:
        </p>
        <CodeBlock code={installExtension} lang="sql" title="Haybarn shell" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          After the verification query, the result should show both <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">installed</code> and <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">loaded</code> as true:
        </p>
        <div class="mt-4">
          <CodeBlock code={verifyVgiOutput} lang="text" title="expected result" />
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2 — Attach a hosted worker -->
  <section id="attach-hosted-worker" class="py-16 lg:py-20 bg-white scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">2</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Attach a hosted worker</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          With VGI loaded, you can attach a remote worker directly from the Haybarn shell. This example connects to a hosted worker, so you can verify the VGI path before writing any local code.
        </p>
        <CodeBlock code={attachHostedWorker} lang="sql" title="Haybarn shell" />
        <p class="mt-4 text-sm text-soil-600">
          After this command succeeds, the hosted worker is attached as <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">my_worker</code> in your SQL session.
        </p>
      </div>
    </div>
  </section>

  <!-- Step 3 — Build a worker -->
  <section id="build-worker" class="py-16 lg:py-20 bg-soil-50 scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">3</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Build your own worker</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          To make your own VGI worker, install the Python framework. The package gives you the base classes (<code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">ScalarFunction</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Worker</code>, etc.) and the runtime that speaks the wire protocol.
        </p>
        <CodeBlock code={installPython} lang="bash" title="terminal" />
        <p class="mt-8 text-soil-700 leading-relaxed mb-6">
          Then create a worker file. Declare functions as classes with a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">compute</code> method, list them on a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Worker</code>, and add a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">__main__</code> guard so the worker can run as a subprocess.
        </p>
        <CodeBlock code={workerSource} lang="python" title="my_worker.py" />
        <p class="mt-4 text-sm text-soil-600">
          Prefer a different language? See <a href="/vgi/languages" class="text-harvest-700 underline">Languages</a> for the TypeScript, Go, Rust, Java, and C++ SDKs.
        </p>
      </div>
    </div>
  </section>

  <!-- Step 4 — Use a local worker from SQL -->
  <section id="attach-local-worker" class="py-16 lg:py-20 bg-white scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">4</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Attach your local worker</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          Once you have a local worker file, attach it as a catalog from Haybarn. Its functions become first-class SQL functions you can use in <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">SELECT</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">WHERE</code>, joins, and pipelines.
        </p>
        <CodeBlock code={attachLocalWorker} lang="sql" title="Haybarn shell" />
      </div>
    </div>
  </section>

  <!-- Step 5 — Type-safe arguments -->
  <section id="type-bounds" class="py-16 lg:py-20 bg-soil-50 scroll-mt-24">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-5xl font-bold text-harvest-600">5</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-soil-900">Add type bounds</h2>
        </div>
        <p class="text-soil-700 leading-relaxed mb-6">
          For production use you'll want bind-time validation. Add <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">type_bound</code> on a <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">Param</code> and DuckDB will reject mismatched columns before any data moves.
        </p>
        <CodeBlock code={typedExample} lang="python" title="add_values.py" />
        <p class="mt-4 text-sm text-soil-600 leading-relaxed">
          VGI also supports <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">TableFunctionGenerator</code>, <code class="text-sm bg-soil-100 px-1.5 py-0.5 rounded">TableInOutFunction</code>, and aggregates with bind / process / finalize hooks. See <a href="/vgi/architecture" class="text-harvest-700 underline">Architecture</a> for the full lifecycle.
        </p>
      </div>
    </div>
  </section>

  <!-- Next steps -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Next steps"
        title="Where to from here"
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/vgi/architecture" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🏗️</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Architecture</h3>
            <p class="text-sm text-soil-700">Transports, lifecycle, wire format.</p>
          </Card>
        </a>
        <a href="/vgi/languages" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🌍</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Other languages</h3>
            <p class="text-sm text-soil-700">TypeScript, Go, Rust, Java, C++ SDKs.</p>
          </Card>
        </a>
        <a href="https://github.com/Query-farm/vgi-python" class="block" target="_blank" rel="noopener noreferrer">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">📖</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Full Python docs</h3>
            <p class="text-sm text-soil-700">README, examples, fixtures on GitHub.</p>
          </Card>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Stuck or want a hand?</h2>
      <p class="text-lg md:text-xl text-harvest-50 mb-6">
        We help teams design and ship VGI-based extensions.
      </p>
      <Button href="/consulting" variant="secondary" size="lg">Talk to us</Button>
    </div>
  </section>
</PageLayout>
