---
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Button from '../../components/ui/Button.astro';
import AgentQuickstart from '../../components/vgi/AgentQuickstart.astro';
import IntegrationShowcase from '../../components/vgi/IntegrationShowcase.astro';
import HowVgiWorks from '../../components/vgi/HowVgiWorks.astro';
import { organization } from '../../lib/organization';
const description = 'Ask your coding agent to connect APIs, data services, local files, and libraries to DuckDB. Choose your language and build a tested VGI worker.';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'TechArticle', headline: 'Connect anything to your database', description, url: 'https://query.farm/vgi/build-with-an-agent', author: organization }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'VGI', item: 'https://query.farm/vgi/' }, { '@type': 'ListItem', position: 2, name: 'Build with an Agent', item: 'https://query.farm/vgi/build-with-an-agent' }] }];
---
<PageLayout title="Connect anything to your database with VGI" description={description} jsonLd={jsonLd}>
  <VGISubNav />
  <PageHead variant="section" eyebrow="Built by your coding agent" title="Connect anything to your database." titleClass="mt-3 text-4xl md:text-5xl text-soil-900" ledeClass="mt-4 max-w-[69ch] text-base sm:text-lg leading-relaxed text-soil-700" hairband>
    <picture slot="icon" class="block w-full flex-none sm:w-auto sm:pt-5">
      <source srcset="/vgi/vgi-hero.webp" type="image/webp" />
      <img src="/vgi/vgi-hero.png" alt="VGI — Vector Gateway Interface" width="900" height="662" fetchpriority="high" class="mx-auto block h-auto w-[180px] sm:mx-0 sm:w-[210px] lg:w-[280px]" />
    </picture>
    <Fragment slot="title">Connect anything<br /> to your database.</Fragment>
    <Fragment slot="lede">Bring APIs, data services, local files, and your own code into DuckDB. Your coding agent can build and test the integration—with the VGI skill, in the language you choose.</Fragment>
    <div class="mt-5 flex flex-wrap gap-3"><Button href="#start" variant="primary" size="md">Build with your agent →</Button></div>
    <Fragment slot="after"><HowVgiWorks /><IntegrationShowcase /></Fragment>
  </PageHead>

  <section class="section-container py-9 sm:py-11">
    <AgentQuickstart />
  </section>

  <section class="section-container py-9 sm:py-12" id="next">
    <div class="max-w-[78ch]"><h2 class="text-3xl text-soil-900">Start with the connection your project needs.</h2><p class="mt-4 leading-relaxed text-soil-700">A support system you want to join to customer data. Metadata hidden in local files. A calculation your application already owns. Describe the source, the rows or functions you want in SQL, and the results that would prove it works.</p><p class="mt-4 leading-relaxed text-soil-700">Your agent builds a <strong>VGI worker</strong> in the language you choose. VGI—the Vector Gateway Interface—is the installed DuckDB extension that connects to it. DuckDB calls the finished worker without a coding agent in the query’s runtime path.</p><p class="mt-4 leading-relaxed text-soil-700">But each integration brings its own edge cases. The skill guides the agent through SDK setup and SQL verification. Your tests should cover empty results, multiple batches, and the source’s error behavior. <a href="/vgi/building-a-worker" class="text-link underline">Explore worker functions, tables, and catalogs →</a></p></div>
    <div class="mt-9 flex flex-wrap items-center gap-5"><Button href="#start" variant="primary">Build with your agent →</Button><a href="/blog/build-vgi-workers-with-coding-agents/" class="text-sm text-link underline underline-offset-2">Read the build story</a></div>
  </section>
</PageLayout>
