<script>
  // Copy button for hand-rolled rock-900/950 code blocks (brief §3: code never
  // sits on a coloured band, so slab code blocks are built here rather than
  // reusing the shared CodeBlock component).
  function wireCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('button.qf-copy').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', async () => {
        const pre = btn.closest('div')?.parentElement?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
        } catch { /* clipboard unavailable */ }
      });
    });
  }
  wireCopyButtons();
  document.addEventListener('astro:after-swap', wireCopyButtons);
</script>

<script>
  // Hide each tab's static "Sample output" table once that tab's live WASM
  // shell opens — the shell's container lands as a sibling inside that
  // panel's .tour-code-wrapper, right after ExampleShellMounter's own
  // "Try it in your browser" bar (.example-run-bar). Reappears if the shell
  // is closed again. One wrapper/sample pair per panel now that the tour is
  // tabbed, so this wires all of them rather than a single fixed id pair.
  // Observes DOM structure ExampleShellMounter already documents as its
  // behavior, rather than reaching into its internals — nothing here
  // depends on that component's own code changing.
  function wireTourSampleToggle() {
    document.querySelectorAll<HTMLElement>('.tour-tab-panel').forEach((panel) => {
      const wrapper = panel.querySelector<HTMLElement>('.tour-code-wrapper');
      const sample = panel.querySelector<HTMLElement>('.tour-sample-output');
      if (!wrapper || !sample || wrapper.dataset.wired) return;
      wrapper.dataset.wired = '1';

      const sync = () => {
        const shellOpen = wrapper.querySelector('.example-run-bar')?.nextElementSibling != null;
        sample.style.display = shellOpen ? 'none' : '';
      };
      new MutationObserver(sync).observe(wrapper, { childList: true });
      sync();
    });
  }
  wireTourSampleToggle();
  document.addEventListener('astro:after-swap', wireTourSampleToggle);
</script>

<script>
  // Tab strip for the tour's example queries — plain show/hide. A shell left
  // running in a tab the visitor switches away from just goes along with the
  // rest of that panel's `hidden` state — no special handling needed, and
  // switching back shows it exactly as it was left.
  //
  // A previous version tried to proactively close a running shell on
  // switch-away by simulating a click on its Run/Hide button. That button's
  // own handler decides open-vs-close by checking `container.parentElement`
  // — a piece of state private to ExampleShellMounter's React closure, not
  // visible from here. This code was instead inferring the same thing from
  // a DOM proxy (whether the run bar had a next sibling), and the two checks
  // could disagree — when they did, the simulated click landed on the wrong
  // branch and *opened* a shell (booting the WASM engine) instead of closing
  // one. Simplest fix: don't guess at a state this script doesn't own —
  // hidden takes care of it either way.
  function wireTourTabs() {
    const root = document.getElementById('tour-tabs');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.tour-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.tour-tab-panel'));
    const rail = root.querySelector<HTMLElement>('[data-tour-tab-rail]');
    const railShell = rail?.parentElement;

    const updateRailEdges = () => {
      if (!rail || !railShell) return;
      const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      railShell.classList.toggle('is-away-from-start', rail.scrollLeft > 2);
      railShell.classList.toggle('is-at-end', rail.scrollLeft >= maxScroll - 2);
    };

    const revealTab = (tab: HTMLButtonElement) => {
      if (!rail) return;
      const railRect = rail.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const left = rail.scrollLeft + tabRect.left - railRect.left
        - ((rail.clientWidth - tabRect.width) / 2);
      rail.scrollTo({
        left,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    const activate = (tab: HTMLButtonElement) => {
      const id = tab.dataset.tab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('border-sun-400', active);
        t.classList.toggle('text-sun-400', active);
        t.classList.toggle('border-transparent', !active);
        t.classList.toggle('text-cream-2', !active);
        t.setAttribute('aria-selected', String(active));
        t.tabIndex = active ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.tabPanel !== id;
      });
      revealTab(tab);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        tabs[nextIndex].focus();
        activate(tabs[nextIndex]);
      });
    });

    rail?.addEventListener('scroll', updateRailEdges, { passive: true });
    requestAnimationFrame(updateRailEdges);
  }
  wireTourTabs();
  document.addEventListener('astro:after-swap', wireTourTabs);
</script>
