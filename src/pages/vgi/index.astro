---
import { Icon } from 'astro-icon/components';
import PageLayout from '../../layouts/PageLayout.astro';
import VGISubNav from '../../components/sections/VGISubNav.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import BigPictureDiagram from '../../components/vgi/BigPictureDiagram.astro';
import ExampleShellMounter from '../../components/repl/ExampleShellMounter.tsx';
import OvertureMapExample from '../../components/vgi/OvertureMapExample.tsx';
import LiveTrainBoard from '../../components/vgi/LiveTrainBoard.tsx';
import ConnectorCard from '../../components/products/ConnectorCard.astro';
import { featuredConnectors, statusLabel } from '../../data/connectors';
import { LANGUAGES, rootOf } from '../../lib/vgi-docs';

// Orchard preview for the "discover" fork below — real prototype catalog
// entries (src/data/connectors.ts), not placeholders. Orchard itself is
// still incomplete, but these are the same live cards its own pages render.
const orchardPreview = featuredConnectors.slice(0, 3);
const fmtUses = (n?: number) =>
  n == null ? '' : n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);

// Real data-source credits for the tabs below — logo + link, reused across
// whichever tabs actually query that source. Logos are each org's own
// official mark (Open-Meteo's favicon, Overture Maps Foundation's and
// USGS's GitHub org avatars — fetched from their own domains, not
// fabricated), saved to public/vgi/icons/.
const OPEN_METEO = { name: 'Open-Meteo', logo: '/vgi/icons/open-meteo.png', href: 'https://open-meteo.com' };
const USGS = { name: 'USGS', logo: '/vgi/icons/usgs.png', href: 'https://earthquake.usgs.gov' };
const OVERTURE = { name: 'Overture Maps', logo: '/vgi/icons/overture-maps.png', href: 'https://overturemaps.org' };
// NS's real brand mark and hex (#003082), from simple-icons' own source data
// (data/simple-icons.json — the package's stripped @iconify-json build omits
// hex, so this came from upstream, not guessed), rendered as a solid badge
// matching every other source logo here.
const NS = { name: 'NS (Dutch Railways)', logo: '/vgi/icons/ns.png', href: 'https://www.ns.nl' };

// The 10-second tour's live examples — three tabs, three real queries,
// three different workers, so "query it like any other catalog" doesn't
// rest on a single cherry-picked example. Every sql/result pair here is
// VERIFIED for real: ran each ATTACH + SELECT against the live worker via a
// local haybarn build (~/Development/vgi/build/release/haybarn, loading the
// matching build/release/extension/vgi/vgi.duckdb_extension — this
// machine's stock Homebrew DuckDB is ABI-pinned to a different core commit
// and won't load it). That confirms each worker is reachable and each
// query is correct; it does NOT confirm the in-browser WASM path
// specifically (CORS + a WASM/EH build of the community `vgi` extension
// both still need to work for the page's own "Try it in your browser"
// button — untested here). Every `result` below is the actual rows that run
// returned (2026-08-13), not fabricated — times trimmed to "HH:MM UTC";
// weather, the earthquake catalog, and the departure board will all drift
// from these exact values over time, which is expected and fine: they're a
// sample of the shape, not a promise of live data.
//
// Every tab's full SQL — ATTACH included — is what's shown on the page AND
// what the live shell auto-runs; there's one canonical string per tab, not
// a visible version and a separate hidden one. What changes is what the
// *shell* echoes while running it: ExampleShell's runRepl() still executes
// ATTACH (required — the rest of the query needs that catalog), it just
// doesn't print it as a typed line, so the terminal jumps straight to the
// query the reader is actually here to see. INSTALL/LOAD for the `vgi`
// extension itself are the other case runRepl() special-cases — dropped
// entirely rather than run-but-silent, since ensureExtension() already
// loaded it engine-wide and running it again would be redundant, not just
// noisy.
const tourExamples = [
  {
    id: 'weather',
    label: 'Weather forecast',
    mobileLabel: 'Weather',
    filename: 'weather.sql',
    sql: `ATTACH 'open_meteo' AS m (TYPE vgi, LOCATION 'https://vgi-open-meteo.rusty-bb6.workers.dev');

-- Geocode the place first, then LATERAL-join its coordinates straight into
-- the forecast call — one round trip per row, no separate lookup step.
SELECT w.time,
       round(w.temperature_2m, 1)                AS temp_f,
       m.main.weather_code_emoji(w.weather_code) AS icon,
       m.main.weather_code_text(w.weather_code)  AS conditions
FROM m.main.geocoding('Glen Allen, VA', count := 1, country_code := 'US') AS g,
     LATERAL m.main.forecast_hourly(g.latitude, g.longitude,
                                    forecast_days := 2,
                                    temperature_unit := 'fahrenheit') AS w
WHERE w.time >= now()
ORDER BY w.time limit 6;`,
    sources: [OPEN_METEO],
    description:
      "Open-Meteo is a free, open-source weather API — no key required for non-commercial use. This worker exposes its geocoding and hourly-forecast endpoints as ordinary SQL table functions.",
    result: {
      columns: ['time', 'temp_f', 'icon', 'conditions'],
      numericCol: 1,
      rows: [
        ['2026-08-13 19:00 UTC', 89.3, '☁️', 'Overcast'],
        ['2026-08-13 20:00 UTC', 90.1, '☁️', 'Overcast'],
        ['2026-08-13 21:00 UTC', 89.9, '☁️', 'Overcast'],
        ['2026-08-13 22:00 UTC', 88.9, '☁️', 'Overcast'],
        ['2026-08-13 23:00 UTC', 87.4, '☁️', 'Overcast'],
        ['2026-08-14 00:00 UTC', 83.6, '☁️', 'Overcast'],
      ],
    },
  },
  {
    id: 'earthquakes',
    label: 'Earthquakes',
    mobileLabel: 'Earthquakes',
    filename: 'earthquakes.sql',
    sql: `ATTACH 'earthquakes' AS eq (TYPE vgi, LOCATION 'https://vgi-earthquakes.rusty-bb6.workers.dev');

SELECT time, round(mag, 1) AS mag, place
FROM eq.main.recent
WHERE mag >= 5
ORDER BY mag DESC
LIMIT 8;`,
    sources: [USGS],
    description:
      "Live feed from the USGS Earthquake Hazards Program — the same 30-day feed seismologists and emergency responders watch, as an ordinary table.",
    result: {
      columns: ['time', 'mag', 'place'],
      numericCol: 1,
      rows: [
        ['2026-08-10 12:34 UTC', 7.4, '5 km S of San José del Palmar, Colombia'],
        ['2026-07-17 14:48 UTC', 7.3, '52 km W of Puerto Madero, Mexico'],
        ['2026-07-28 07:27 UTC', 6.8, 'The 2026 Kumamoto Region, Japan Earthquake'],
        ['2026-07-17 15:20 UTC', 6.4, '96 km SW of Puerto Madero, Mexico'],
        ['2026-08-05 04:14 UTC', 6.3, '32 km SW of Sarangani, Philippines'],
        ['2026-08-05 07:43 UTC', 6.3, 'south of the Kermadec Islands'],
        ['2026-07-24 21:37 UTC', 6.0, '55 km W of Sola, Vanuatu'],
        ['2026-08-12 11:47 UTC', 6.0, 'South Sandwich Islands region'],
      ],
    },
  },
  {
    id: 'trains',
    label: 'Amsterdam Centraal departures',
    mobileLabel: 'Trains',
    filename: 'amsterdam-departures.sql',
    // vgi-trains-ts — a brand-new worker (deployed straight to Cloudflare,
    // no earlier vgi-* naming baggage), wrapping the NS (Nederlandse
    // Spoorwegen) live departures API. 'asd' is NS's own station code for
    // Amsterdam Centraal — confirmed against the worker's own README, which
    // uses that exact station in its own quickstart example, not guessed.
    // train_departures() is a "blended" row-transform function: its
    // station_code argument is a per-row input column, so `('asd')` here is
    // shorthand for the single-station case — the same function also
    // supports a LATERAL join across many stations at once (see the
    // worker's own README for that shape).
    sql: `ATTACH 'trains' AS trains (TYPE vgi, LOCATION 'https://vgi-trains-ts.rusty-bb6.workers.dev');

SELECT strftime(planned_time, '%H:%M') AS time,
       destination,
       category,
       coalesce(actual_track, planned_track) AS track,
       delay_minutes
FROM trains.main.train_departures('asd')
ORDER BY planned_time
LIMIT 10;`,
    sources: [NS],
    description:
      'Live departure board from NS (Dutch Railways) — the same real-time data the platform boards at Amsterdam Centraal show, as an ordinary table.',
    result: {
      columns: ['time', 'destination', 'category', 'track', 'delay_minutes'],
      numericCol: 4,
      rows: [
        ['22:55', 'Haarlem', 'Sprinter', '1', 0],
        ['23:00', 'Schiphol Airport', 'Intercity', '8a', 0],
        ['23:09', 'Alkmaar', 'Intercity', '2a', 1],
        ['23:19', 'Utrecht Centraal', 'Intercity', '4a', 0],
        ['23:46', 'Rotterdam Centraal', 'Intercity', '15a', 0],
        ['00:19', 'Utrecht Centraal', 'Intercity', '5a', 0],
      ],
    },
  },
];

// A third tab, handled separately from tourExamples above: its result is a
// few hundred points, not a handful of rows, so it renders as a Leaflet map
// (OvertureMapExample.tsx) instead of the terminal's table output. Its `sql`
// (displayed AND run, one source of truth, same as the other tabs) is just
// ATTACH + the query — `setupSql` (S3 region + httpfs) runs first, silently,
// same idea as the terminal's unechoed-but-real ATTACH, applied here via an
// actual separate step since this component has no terminal transcript to
// selectively echo into. ATTACH itself stays in the visible `sql`, same as
// every other tab — it's setupSql that's pure plumbing a reader doesn't
// need to see: the region/httpfs config exists only so the CALLER's own
// DuckDB can read Overture's public S3 parquet (see the worker README note
// below), not something that helps explain what this example demonstrates.
//
// VERIFIED for real against the live overture worker via haybarn. Went
// through a few earlier scopes: all of New Jersey, a McDonald's-vs-Burger-
// King comparison over NYC, every church in Manhattan, then Washington DC.
// Settled on Charlottesville, VA — small enough to scan fast, and with
// `category` in the SELECT now (see OvertureMapExample.tsx: markers are
// color-coded by category.primary, not one flat color). Real category
// values, found by querying what the area actually has tagged near
// "church"/"religio"/"worship" rather than guessed: church_cathedral,
// catholic_church, baptist_church, pentecostal_church, evangelical_church,
// episcopal_church, anglican_church. Deliberately excludes the broader
// `religious_organization` bucket, which mixes in non-church religious
// orgs. 115 rows for this bbox (91 church_cathedral, 20 baptist_church, 3
// catholic_church, 1 anglican_church — the other three categories just
// don't have a match here, which is real, not a bug), spot-checked by name
// (Jefferson Park Baptist Church, First Baptist Church, Saint David's
// Anglican Church — genuine places). lon/lat come from the bbox midpoint —
// Overture's places are simple points, so xmin≈xmax and ymin≈ymax; no
// ST_Centroid/spatial extension needed.
const mapExample = {
  label: 'Churches in Charlottesville, VA',
  mobileLabel: 'Map',
  filename: 'charlottesville-churches.sql',
  setupSql: `SET s3_region = 'us-west-2';
INSTALL httpfs;
LOAD httpfs;`,
  sql: `ATTACH 'overture' (TYPE vgi, LOCATION 'https://vgi-overture.rusty-bb6.workers.dev');

SELECT names.primary AS name,
       categories.primary AS category,
       (bbox.xmin + bbox.xmax) / 2 AS lon,
       (bbox.ymin + bbox.ymax) / 2 AS lat
FROM overture.places.place
WHERE bbox.xmin BETWEEN -78.53 AND -78.43 AND bbox.xmax BETWEEN -78.53 AND -78.43
  AND bbox.ymin BETWEEN 37.98 AND 38.08 AND bbox.ymax BETWEEN 37.98 AND 38.08
  AND categories.primary IN ('church_cathedral', 'catholic_church', 'baptist_church',
                              'pentecostal_church', 'evangelical_church',
                              'episcopal_church', 'anglican_church');`,
  sources: [OVERTURE],
  description:
    'Overture’s places dataset, filtered to Charlottesville, VA and church categories, color-coded by denomination and rendered as real points on a map — 115 locations.',
};

// Architecture diagram is rendered offline via the d2 CLI from
// src/diagrams/vgi-architecture.d2 → public/vgi/architecture.svg.
// Re-render after edits with:  d2 src/diagrams/vgi-architecture.d2 public/vgi/architecture.svg

// ── Shared shape vocabulary (brief §10: port qf.css shapes as utilities) ──
const WRAP = 'mx-auto w-full max-w-[1200px] px-6 sm:px-7';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
const EYEBROW = 'qf-eyebrow text-sun-700';
const LEDE = 'text-[17.5px] leading-relaxed text-soil-700';

// Six recurring patterns, each hitting a different reason someone lands on
// this page. Deliberately not 15 — every pattern here is either linkable to
// real content today or general enough to stand on its own without one.
// Candidates that didn't make the cut (SaaS connectors, RAG, feature stores,
// streaming beyond the one slot below) are flavors of #1 or #2, not new
// territory — better as a future "more patterns" page than a seventh card.
// Icon values are Phosphor tokens (astro-icon `ph:` set, already the site's
// icon library via ExtensionIcon.astro) — bare regular-weight names, matching
// that component's convention rather than a `-bold`/`-duotone` suffix.
const useCases: {
  icon: string;
  title: string;
  description: string;
  href?: string;
  external?: boolean;
  linkLabel?: string;
}[] = [
  {
    icon: 'share-network',
    title: 'Data-as-a-Service',
    description: 'Wrap an API, feed, or proprietary dataset as a SQL catalog that other teams or customers attach to and query directly.',
    href: '/vgi/data-as-a-service'
  },
  {
    icon: 'robot',
    title: 'Reach AI agents, not just SQL',
    // MCP compatibility is real and already in the SDK (VGI_OAUTH_CLIENT_ID
    // etc. in the CLI reference), not aspirational. The pitch stays at the
    // idea level: one worker, two audiences, same access control either way.
    description: 'The same worker that plugs into DuckDB also speaks MCP — so the data, models, and services you expose for SQL are just as reachable by an AI agent, under the same access control.'
  },
  {
    icon: 'shield-check',
    title: 'Secure down to the row and column',
    // Verified against vgi-cedar-proxy (~/Development/vgi-cedar-proxy): Cedar
    // policies enforce object/row/column rules adversarially on the data
    // path — never trusting the worker — fail-closed by default, with JWT/
    // OAuth-derived identity driving the checks. Real and tested (pytest +
    // E2E against a built VGI), but LICENSE is proprietary/private, never
    // published to PyPI — no public repo to link this card to, unlike
    // fixedformat, so it stays a capability claim rather than a proof link.
    description: 'OAuth carries a user’s identity all the way to the worker, so access can be restricted by row and column, not just by table, with nothing allowed unless a policy says so — the control a company-wide SQL layer actually needs.'
  },
  {
    icon: 'hard-drives',
    title: 'Bridge a legacy system',
    // The COBOL/EBCDIC specifics moved behind the link rather than the card
    // face — real and checkable one click away, but the pitch itself should
    // read as "your old system," not "our mainframe-parsing worker."
    description: 'Put SQL in front of a system you can’t rewrite — an old file format, an internal service, anything that still works but was never built to speak SQL.',
    href: 'https://github.com/Query-farm/vgi-fixedformat',
    external: true,
    linkLabel: 'See a real example'
  },
  {
    icon: 'waveform',
    title: 'Query streaming and event data',
    description: 'Turn a live stream of events — a queue, a topic, a webhook — into a table SQL can query directly.'
  },
  {
    icon: 'gauge',
    title: 'Prototype fast, optimize later',
    description: 'Start fast in whatever language you already use. Reach for a native DuckDB extension later, only if you outgrow what a worker can deliver.',
    href: '/vgi/architecture#compare'
  }
];

// Icon slugs match src/pages/vgi/languages.astro's own `languages` data
// exactly (simple-icons:openjdk for Java, not simple-icons:java) — same
// brand marks, not a second icon choice for the same languages.
//
// hrefs go to each language's REAL docs where one exists — mirroring
// VGISubNav's languageDocs list — rather than only Python having somewhere
// to land and everyone else getting an anchor on the overview page. C++ is
// left out entirely — it's not a shipped SDK yet, so there's nothing real to
// link to.
// All five now land in /vgi/docs/<language>/. They used to point at the
// vgi-rpc-*.query.farm sites, which document the RPC layer underneath rather
// than the SDK — the only real destination back when Python was the one SDK
// with docs here.
const workerLanguages = LANGUAGES.map(language => ({
  name: language.name,
  href: rootOf(language),
  icon: language.icon,
  external: false,
}));


// DuckDB, VGI, and Worker all dropped from here — each is already shown in
// the big picture diagram and the VGI Protocol / VGI worker terminology
// cards above, so restating them a third time was pure repetition. The CGI
// panel is the one thing this section adds that isn't said elsewhere — a
// single card now, not a list of one. Links to the connect-to-a-worker page's
// SSH section, not just the transports section.
const cgiPanel = {
  title: 'CGI, but for databases',
  rfcHref: 'https://datatracker.ietf.org/doc/html/rfc3875',
  href: '/vgi/connect-to-a-worker#ssh',
  linkLabel: 'See how workers run remotely →',
};

const SITE_ORIGIN = 'https://query.farm';
const vgiDescription = 'VGI (Vector Gateway Interface) lets teams expose APIs, services, models, and custom code as SQL-accessible DuckDB catalogs, tables, and functions without compiling native extensions.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'VGI — Vector Gateway Interface',
    description: vgiDescription,
    url: `${SITE_ORIGIN}/vgi`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Extension Protocol',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: LANGUAGES.map(language => language.name),
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: 'https://github.com/Query-farm/vgi',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'VGI', item: SITE_ORIGIN + '/vgi' },
    ],
  },
];
---

<PageLayout
  title="VGI — Vector Gateway Interface"
  description={vgiDescription}
  ogImage="/og/vgi.jpg"
  jsonLd={jsonLd}
>
  <VGISubNav />

  <!-- ── Page header ─────────────────────────────────────────── -->
  <PageHead
    variant="section"
    title="The universal SQL interface."
    hairband
    class="vgi-page-head"
    titleClass="mt-2 text-[2.1rem] leading-[1.12] text-soil-900 sm:mt-3 sm:text-4xl md:text-5xl"
    ledeClass="mt-3 max-w-[58ch] text-base leading-relaxed text-soil-700 sm:mt-3.5 sm:text-[17.5px]"
  >
    {/* Lede moved from the prop to the slot so Haybarn can be linked. It
        deliberately avoids the word "worker" — that term is introduced and
        defined further down, in The gist, rather than in the first sentence a
        visitor reads. */}
    <Fragment slot="lede">
      The Vector Gateway Interface (VGI) lets <a href="https://duckdb.org">DuckDB</a> and
      <a href="/products/haybarn">Haybarn</a> attach a remote process as if it were a native catalog or
      extension. Your data, services, models, and code stay in their own runtime; SQL users get
      catalogs, schemas, tables, and functions they can explore, query, and join.
    </Fragment>

    {/* The badge carries the "Vector Gateway Interface" wordmark itself, so it
        replaces the eyebrow rather than sitting beside it — the name would
        otherwise appear twice within an inch. The alt text is what the eyebrow
        used to say, keeping the product name in the accessibility tree and out
        of the visual design. Source art is 1197x880; served at 900w since the
        largest render is 320 CSS px. */}
    <Fragment slot="icon">
      {/* w-full below sm: PageHead's row is flex-wrap, but the text column
          next to this is min-w-0 — which lets it shrink instead of ever
          triggering a wrap, so a fixed-width 220px image and the heading
          both stayed on one line down to the narrowest phones, squeezing the
          text column to a sliver a few characters wide. Every other page
          using PageHead's icon slot is a 56px tile, small enough this never
          came up. Making the image claim the row's full width below sm:
          leaves nothing for the text to share the line with, so it wraps
          below instead — matching the two-line phone layout the image's own
          w-[220px]→sm:w-[268px] step was already written for. */}
      <picture class="block w-full flex-none sm:w-auto">
        <source srcset="/vgi/vgi-hero.webp" type="image/webp" />
        <img
          src="/vgi/vgi-hero.png"
          alt="Vector Gateway Interface"
          width="1197"
          height="880"
          fetchpriority="high"
          class="h-auto w-[180px] sm:w-[268px] lg:w-[320px]"
        />
      </picture>
    </Fragment>

    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 sm:mt-6">
      <Button href="/vgi/getting-started" variant="primary" size="md" class="min-h-11">Get started</Button>
      <Button href="/vgi/architecture" variant="secondary" size="md" class="min-h-11">How it works</Button>
      <a
        href="https://github.com/Query-farm/vgi"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center px-1 text-sm font-medium text-link no-underline hover:underline"
      >GitHub ↗</a>
    </div>

    <div class="mt-4 inline-flex items-baseline gap-2 rounded-lg border border-soil-300 bg-white/60 px-3 py-2 lg:hidden">
      <span class="qf-figure text-xl leading-none text-sun-700">115</span>
      <span class="text-[12.5px] font-medium text-soil-700">Workers built</span>
    </div>

    <Fragment slot="aside">
      <div class="qf-figure text-4xl leading-none text-sun-700">115</div>
      <div class="mt-1.5 text-[12.5px] font-medium text-soil-700">Workers built</div>
    </Fragment>
  </PageHead>

  <!-- ── The gist ────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 lg:py-[70px]">
    <div class={WRAP}>
      <span class={EYEBROW}>The gist</span>
      <h2 class="mt-3 max-w-[26ch] text-3xl md:text-4xl text-soil-900">
        For the systems, data, and code DuckDB cannot reach by itself
      </h2>
      <p class={`mt-3.5 max-w-[68ch] ${LEDE}`}>
        VGI removes the glue. Instead of writing code to bridge two systems, you write a
        VGI-enabled process — a <em>worker</em> — that exposes an API, service, library, model,
        or dataset. DuckDB attaches to that worker, discovers what it offers, and makes all of
        it queryable in SQL.
      </p>
      <p class={`mt-3.5 max-w-[68ch] ${LEDE}`}>
        Run a worker locally over pipes or shared memory, or deploy the same worker over HTTP for
        many DuckDB sessions to share. Only the
        <a href="/vgi/architecture#transports">transport</a> changes. Because it sits behind
        DuckDB, the worker is also available through DuckDB's
        <a href="https://duckdb.org/docs/stable/clients/overview">client libraries</a>, ADBC, and
        ODBC — from whatever language your application already uses.
      </p>
      <p class={`mt-3.5 max-w-[68ch] ${LEDE}`}>
        In practice, that shows up as a handful of recurring patterns:
      </p>

      <div class="mt-8 grid gap-3.5 md:grid-cols-3">
        {useCases.map(u => {
          const Tag = u.href ? 'a' : 'div';
          const linkProps = u.href
            ? { href: u.href, ...(u.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
            : {};
          return (
            <Tag
              {...linkProps}
              class:list={[
                CARD,
                'p-4 text-left sm:p-6 sm:text-center',
                u.href && 'block no-underline transition duration-200 hover:-translate-y-1 hover:border-sun-400'
              ]}
            >
              <div class="flex items-start gap-3 sm:block">
                <Icon name={`ph:${u.icon}`} class="mt-0.5 block h-6 w-6 flex-none text-sun-700 sm:mx-auto sm:h-8 sm:w-8" aria-hidden="true" />
                <div class="min-w-0">
                  <h3 class="text-lg text-soil-900 sm:mt-4 sm:text-xl">{u.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-soil-700 sm:mt-2.5">{u.description}</p>
                  {u.href && (
