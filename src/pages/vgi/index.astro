---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

// Architecture diagram is rendered offline via the d2 CLI from
// src/diagrams/vgi-architecture.d2 → public/vgi/architecture.svg.
// Re-render after edits with:  d2 src/diagrams/vgi-architecture.d2 public/vgi/architecture.svg

const useCases = [
  {
    icon: 'api',
    title: 'Expose external APIs',
    description: 'Wrap REST, gRPC, or any HTTP service as SQL-accessible tables and functions. Query remote data alongside local tables without building connector plumbing.'
  },
  {
    icon: 'model',
    title: 'Call models from SQL',
    description: 'Score rows through PyTorch, ONNX, or any model that lives in your own runtime. Keep the model where it belongs and call it from DuckDB.'
  },
  {
    icon: 'code',
    title: 'Reuse your code',
    description: 'Make pandas transforms, Go services, TypeScript validators, and internal business logic available to SQL users without compiling native DuckDB extensions.'
  }
];

const outcomes = [
  'Expose a hosted service as a SQL catalog.',
  'Discover schemas and tables from DuckDB.',
  'Join remote workers with local files and tables.',
  'Ship workers in the language and runtime your team already uses.',
];

const architectureNodes = [
  {
    label: 'DuckDB session',
    eyebrow: 'SQL caller',
    icon: 'duckdb',
    detail: 'A query calls tables or functions exposed by an attached VGI catalog.',
    popover: 'Example: SELECT * FROM my_api.main.customers;',
    tone: 'bg-duck-50 border-duck-200',
  },
  {
    label: 'VGI extension',
    eyebrow: 'DuckDB side',
    icon: 'vgi',
    detail: 'The extension plans the call, validates types, and speaks the VGI protocol from inside DuckDB.',
    popover: 'This is the small DuckDB extension users install and load.',
    tone: 'bg-grain-50 border-grain-300',
  },
  {
    label: 'Arrow transport',
    eyebrow: 'Wire layer',
    icon: 'arrow',
    detail: 'Requests and responses move as Arrow batches over pipes, sockets, shared memory, or HTTP.',
    popover: 'The same interface works locally or over HTTP for hosted workers.',
    tone: 'bg-white border-soil-300',
  },
  {
    label: 'Worker runtime',
    eyebrow: 'Your code',
    icon: 'worker',
    detail: 'Python, TypeScript, Go, Rust, Java, or C++ code runs in its own process or service.',
    popover: 'The worker owns schemas, tables, functions, auth, and service logic.',
    tone: 'bg-harvest-50 border-harvest-200',
  },
];

const workerLanguages = [
  { name: 'Python', href: '/vgi/languages#python' },
  { name: 'TypeScript', href: '/vgi/languages#typescript' },
  { name: 'Go', href: '/vgi/languages#go' },
  { name: 'Rust', href: '/vgi/languages#rust' },
  { name: 'Java', href: '/vgi/languages#java' },
  { name: 'C++', href: '/vgi/languages#cpp' },
];

const quickStart = `-- 1. Install + load VGI
INSTALL vgi FROM community;
LOAD vgi;

-- 2. Attach a hosted worker as a SQL catalog
ATTACH 'volcanos' AS volcanos (
  TYPE vgi,
  LOCATION 'https://vgi-volcanos.fly.dev/'
);

-- 3. Query the remote service like normal tables
SELECT name, country, primary_type
FROM volcanos.smithsonian.pleistocene_volcanoes
LIMIT 10;`;

const SITE_ORIGIN = 'https://query.farm';
const vgiDescription = 'VGI (Vector Gateway Interface) lets teams expose APIs, services, models, and custom code as SQL-accessible DuckDB catalogs, tables, and functions without compiling native extensions.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'VGI — Vector Gateway Interface',
    description: vgiDescription,
    url: `${SITE_ORIGIN}/vgi`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Extension Protocol',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['Python', 'TypeScript', 'Go', 'Rust', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: 'https://github.com/Query-farm/vgi',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'VGI', item: SITE_ORIGIN + '/vgi' },
    ],
  },
];
---

<PageLayout
  title="VGI — Vector Gateway Interface"
  description={vgiDescription}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-harvest-100 via-harvest-50 to-white overflow-hidden py-14 lg:py-20 font-display">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="vgi-hero-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#vgi-hero-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.92fr_1.08fr] gap-10 lg:gap-14 items-center">
        <div>
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border-2 border-soil-900 bg-white px-4 py-2 text-sm font-bold text-soil-900 shadow-sm">
            <img src="/vgi/vgi-logo.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
            Vector Gateway Interface
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-normal text-soil-900 leading-tight">
            Turn APIs, models, and code into
            <span class="inline-block rounded-2xl border-2 border-soil-900 bg-grain-300 px-3 pb-1 text-soil-900 shadow-sm">SQL.</span>
          </h1>

          <p class="mt-6 text-lg md:text-xl text-soil-700 leading-relaxed">
            VGI lets Haybarn and DuckDB attach a remote worker as if it were a normal SQL catalog. Your data, service, model, or Python/TypeScript/Go/Rust code stays in its own runtime; SQL users get tables and functions they can discover, query, and join.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <Button href="/vgi/getting-started" variant="accent" size="lg">Get Started</Button>
            <Button href="https://github.com/Query-farm/vgi" variant="secondary" size="lg" external>GitHub</Button>
          </div>
        </div>

        <div class="rounded-2xl border-2 border-soil-900 bg-white p-3 md:p-4 shadow-2xl">
          <div class="rounded-xl border-2 border-soil-900 bg-soil-900 p-4 md:p-5 text-soil-100">
            <div class="mb-4 flex items-center justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-harvest-300">What VGI does</p>
                <h2 class="mt-1 text-lg font-bold text-white">A gateway from real systems to SQL</h2>
              </div>
              <span class="hidden sm:inline-flex rounded-full border border-harvest-400/40 bg-harvest-400/10 px-3 py-1 text-xs font-bold text-harvest-200">Arrow IPC</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_4.25rem_minmax(0,1fr)] gap-3 md:gap-6 items-stretch">
              <div class="grid gap-2">
                {['Public APIs', 'Internal services', 'ML models', 'Data libraries'].map((item) => (
                  <div class="rounded-lg border border-white/10 bg-white/10 px-3 py-2 text-sm font-semibold text-soil-100">
                    {item}
                  </div>
                ))}
              </div>

              <div class="flex md:flex-col items-center justify-center gap-2">
                <div class="h-px w-full md:h-full md:w-px bg-harvest-300/50"></div>
                <div class="shrink-0 text-center">
                  <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-harvest-300/40 bg-harvest-300/10 text-sm font-black uppercase tracking-wider text-harvest-200">
                    VGI
                  </div>
                </div>
                <div class="h-px w-full md:h-full md:w-px bg-harvest-300/50"></div>
              </div>

              <div class="rounded-lg border border-harvest-300/30 bg-harvest-300/10 p-3">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-harvest-200">DuckDB sees</p>
                <div class="space-y-2 text-sm font-semibold text-white">
                  <div class="rounded bg-white/10 px-3 py-2">schemas</div>
                  <div class="rounded bg-white/10 px-3 py-2">tables</div>
                  <div class="rounded bg-white/10 px-3 py-2">functions</div>
                </div>
              </div>
            </div>

            <pre class="mt-4 overflow-x-auto rounded-lg border border-white/10 bg-black/25 p-4 font-mono text-sm leading-relaxed text-soil-100"><code><span class="sql-keyword">ATTACH</span> <span class="sql-string">'my_api'</span> <span class="sql-keyword">AS</span> <span class="sql-object">my_api</span> (
  <span class="sql-keyword">TYPE</span> vgi,
  <span class="sql-keyword">LOCATION</span> <span class="sql-string">'https://worker.example.com'</span>
);

<span class="sql-keyword">SELECT</span> *
<span class="sql-keyword">FROM</span> <span class="sql-object">my_api.main.customers</span>;</code></pre>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- What is VGI -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="max-w-4xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="The gist"
          title="A SQL interface for the systems DuckDB cannot reach by itself"
        />
        <p class="text-lg text-soil-700 leading-relaxed mt-6">
          VGI is for the moment when your data or logic is not already a file, table, or native DuckDB extension. You write or use a worker that exposes an API, model, service, dataset, or library. Haybarn attaches to that worker, discovers what it exposes, and makes it queryable from SQL.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-5xl mx-auto">
        {outcomes.map((item) => (
          <div class="flex min-h-24 items-center gap-3 rounded-xl border-2 border-soil-900 bg-grain-50 p-5 shadow-sm">
            <div class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-grain-300 text-soil-900">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-bold leading-snug text-soil-900">{item}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 max-w-5xl mx-auto rounded-2xl border-2 border-soil-900 bg-white p-5 md:p-6 shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-5 md:gap-6 items-stretch">
          <div class="rounded-xl border border-soil-200 bg-soil-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-harvest-700">VGI</p>
            <h3 class="mt-2 text-xl font-bold text-soil-900">The DuckDB interface</h3>
            <p class="mt-3 text-sm leading-relaxed text-soil-700">
              VGI is the extension and Arrow-based protocol DuckDB uses to attach something outside DuckDB as a catalog. It handles discovery, planning, types, and moving batches back and forth.
            </p>
          </div>

          <div class="hidden md:flex items-center justify-center">
            <div class="rounded-full border-2 border-soil-900 bg-grain-300 px-3 py-1 text-xs font-bold text-soil-900">
              talks to
            </div>
          </div>

          <div class="rounded-xl border border-harvest-200 bg-harvest-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-harvest-700">VGI worker</p>
            <h3 class="mt-2 text-xl font-bold text-soil-900">The service that exposes data</h3>
            <p class="mt-3 text-sm leading-relaxed text-soil-700">
              A worker is the process or hosted service you build or reuse. It owns the API calls, model code, auth, schemas, tables, and functions that DuckDB users query through VGI.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Protocol explanation -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 lg:gap-10 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-harvest-700 mb-3">Under the hood</p>
          <h2 class="text-3xl md:text-4xl font-bold text-soil-900 mb-4">A protocol, not a framework</h2>
          <p class="text-soil-700 leading-relaxed">
            A small DuckDB extension speaks the VGI protocol from inside DuckDB. Lightweight worker libraries speak it from Python, TypeScript, Go, Rust, Java, or C++. The two sides exchange Apache Arrow batches over pipes, sockets, shared memory, or HTTP.
          </p>
          <p class="mt-4 text-soil-700 leading-relaxed">
            The important part: your code runs outside DuckDB. That means no DuckDB headers, no FFI tangle, and no native rebuild every time your runtime or DuckDB version changes.
          </p>
        </div>

        <div class="rounded-2xl border-2 border-soil-900 bg-white p-5 shadow-lg">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
            {[
              ['DuckDB', 'SQL calls tables and functions'],
              ['VGI', 'Arrow request and response'],
              ['Worker', 'Your service or code runs here'],
            ].map(([title, description]) => (
              <div class="rounded-xl border border-soil-200 bg-soil-50 p-4">
                <h3 class="font-bold text-soil-900">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-soil-700">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture diagram -->
  <section id="technical-view" class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Technical view"
        title="How the pieces fit together"
        description="DuckDB on one side, your worker on the other, Apache Arrow IPC between them. Pick the language SDK and transport that match your stack."
        class="mb-4"
      />

      <p class="mb-8 text-center text-sm font-semibold text-soil-500">
        Hover over each step to learn more.
      </p>

      <div class="max-w-6xl mx-auto overflow-visible rounded-2xl border-2 border-soil-900 bg-white p-4 md:p-6 shadow-lg">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] gap-4 items-stretch">
          {architectureNodes.map((node, index) => (
            <>
              <div tabindex="0" class={`group relative flex min-h-48 flex-col items-center justify-center rounded-xl border-2 ${node.tone} p-5 text-center shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl focus:-translate-y-1 focus:shadow-xl focus:outline-none`}>
                <div class="flex h-20 w-20 items-center justify-center rounded-2xl border-2 border-soil-900 bg-white shadow-sm">
                  {node.icon === 'duckdb' && (
                    <img src="/vgi/icons/duckdb-mark.svg" alt="" class="h-12 w-12 object-contain opacity-90" width="48" height="48" />
                  )}
                  {node.icon === 'vgi' && (
                    <span class="relative block h-16 w-16 overflow-hidden">
                      <img src="/Query_Farm_Logo_Transparent.png" alt="" class="absolute left-1/2 top-1/2 h-24 w-32 max-w-none -translate-x-[54%] -translate-y-[48%] object-contain opacity-95" width="128" height="96" />
                    </span>
                  )}
                  {node.icon === 'arrow' && (
                    <span class="flex h-12 w-12 items-center justify-center">
                      <img src="/vgi/icons/apache-arrow-chevrons.svg" alt="" class="h-10 w-12 translate-x-1 object-contain opacity-90" width="48" height="40" />
                    </span>
                  )}
                  {node.icon === 'worker' && (
                    <svg class="h-14 w-14 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="4.5" y="5" width="15" height="5.5" rx="1.5" stroke-width="2" />
                      <rect x="4.5" y="13.5" width="15" height="5.5" rx="1.5" stroke-width="2" />
                      <path stroke-linecap="round" stroke-width="2" d="M8 7.75h.01M8 16.25h.01M11 7.75h5M11 16.25h5" />
                    </svg>
                  )}
                </div>
                <p class="mt-4 text-xs font-bold uppercase tracking-wider text-harvest-700">{node.eyebrow}</p>
                <h3 class="mt-1 text-xl font-bold leading-tight text-soil-900">{node.label}</h3>
                <p class="mt-3 text-sm leading-relaxed text-soil-700 lg:hidden">{node.detail}</p>

                <div class="pointer-events-none absolute left-1/2 top-[calc(100%+0.75rem)] z-50 hidden w-72 -translate-x-1/2 rounded-xl border-2 border-soil-900 bg-white p-4 text-left shadow-xl group-hover:block group-focus:block">
                  <p class="text-xs font-bold uppercase tracking-wider text-harvest-700">{node.eyebrow}</p>
                  <p class="mt-1 text-sm font-semibold leading-relaxed text-soil-900">{node.detail}</p>
                  <p class="mt-3 rounded-lg bg-grain-50 px-3 py-2 text-xs font-semibold leading-relaxed text-soil-700">{node.popover}</p>
                </div>
              </div>

              {index < architectureNodes.length - 1 && (
                <div class="hidden lg:flex items-center justify-center">
                  <div class="flex h-full min-h-28 flex-col items-center justify-center gap-2">
                    <div class="h-px w-14 bg-soil-900"></div>
                    <div class="rounded-full border-2 border-soil-900 bg-grain-300 px-3 py-1 text-xs font-bold text-soil-900">
                      {index === 1 ? 'Arrow IPC' : 'request'}
                    </div>
                    <div class="h-px w-14 bg-soil-900"></div>
                  </div>
                </div>
              )}
            </>
          ))}
        </div>

        <div class="mt-5 grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-4">
          <div class="rounded-xl border-2 border-soil-900 bg-soil-900 p-4 text-soil-100">
            <p class="text-xs font-bold uppercase tracking-wider text-harvest-300">Supported worker runtimes</p>
            <p class="mt-1 text-xs font-semibold text-soil-300">Click a language to see examples.</p>
            <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2">
              {workerLanguages.map((language) => (
                <a
                  href={language.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-center text-sm font-semibold text-white transition-colors hover:border-harvest-300/50 hover:bg-harvest-300/15"
                >
                  {language.name}
                </a>
              ))}
            </div>
          </div>
          <div class="rounded-xl border-2 border-soil-900 bg-grain-50 p-4">
            <p class="text-xs font-bold uppercase tracking-wider text-harvest-700">Transports</p>
            <p class="mt-2 text-sm leading-relaxed text-soil-700">
              Use pipes for spawned local workers, Unix sockets for local services, shared memory for high-throughput co-located workloads, or HTTP for hosted workers.
            </p>
          </div>
        </div>
      </div>

      <p class="mt-8 text-center text-sm text-soil-600 max-w-3xl mx-auto leading-relaxed">
        The DuckDB-side is a small C++ extension. Your code lives in a separate process, written in any of the supported languages. The two ends speak Apache Arrow IPC over a transport you choose — pipes for the spawned-subprocess case, Unix sockets for an existing local worker, shared memory for high-throughput co-located workloads, HTTP for remote ones.
      </p>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 lg:py-24 bg-soil-50 font-display">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="What you can build"
        title="Use cases"
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {useCases.map(u => (
          <Card padding="lg" class="text-center border-2 border-soil-900 shadow-sm">
            <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center text-harvest-700">
              {u.icon === 'api' && (
                <svg class="h-11 w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M4 18V8.5L12 5l8 3.5V18" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M7 18v-5h10v5M9 10h.01M12 9h.01M15 10h.01M3 18h18" />
                </svg>
              )}
              {u.icon === 'model' && (
                <svg class="h-11 w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M5 17c4.2 0 7-2.8 7-7 0 4.2 2.8 7 7 7" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M12 5v14M7 8c1.6.2 3.3.8 5 2 1.7-1.2 3.4-1.8 5-2" />
                  <circle cx="12" cy="10" r="1.5" fill="currentColor" stroke="none" />
                </svg>
              )}
              {u.icon === 'code' && (
                <svg class="h-11 w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M5 18h14M7 18v-7l5-3 5 3v7" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M10 13l-2 2 2 2M14 13l2 2-2 2" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-soil-900 mb-3">{u.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{u.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick start preview -->
  <section class="py-16 lg:py-24 bg-white font-display">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="The 10-second tour"
          title="From hosted worker to SQL catalog"
          class="mb-8"
        />
        <div class="rounded-xl border-2 border-soil-900 bg-white p-4 shadow-sm">
          <CodeBlock code={quickStart} lang="sql" title="quickstart.sql" />
        </div>
