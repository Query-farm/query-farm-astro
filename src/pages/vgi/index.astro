---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

// Architecture diagram is rendered offline via the d2 CLI from
// src/diagrams/vgi-architecture.d2 → public/vgi/architecture.svg.
// Re-render after edits with:  d2 src/diagrams/vgi-architecture.d2 public/vgi/architecture.svg

const useCases = [
  {
    icon: '🌐',
    title: 'External APIs',
    description: 'Wrap REST, gRPC, or any HTTP service as a SQL function. Query remote data alongside your local tables — no ETL, no FFI.'
  },
  {
    icon: '🤖',
    title: 'ML inference',
    description: 'Score rows through PyTorch, ONNX, or any model that lives in your Python environment. Stay in SQL; let the worker handle the GPU.'
  },
  {
    icon: '🛠️',
    title: 'Custom logic in your language',
    description: 'Reuse the libraries your team already knows — pandas transforms, Go services, TypeScript validators — directly from DuckDB.'
  }
];

const quickStart = `-- 1. Install + load the extension
INSTALL vgi FROM community;
LOAD vgi;

-- 2. Attach a Python worker (server side: pip install vgi)
ATTACH 'my_worker.py' (TYPE 'vgi', LOCATION './my_worker.py');

-- 3. Use its functions like any other SQL function
SELECT greeting(name) FROM users;`;

const SITE_ORIGIN = 'https://query.farm';
const vgiDescription = 'VGI (Vector Gateway Interface) is an Apache Arrow-based protocol that lets you extend DuckDB with functionality written in Python, TypeScript, Go, Rust, Java, or C++ — no compilation, no FFI, no version locking.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'VGI — Vector Gateway Interface',
    description: vgiDescription,
    url: `${SITE_ORIGIN}/vgi`,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'DuckDB Extension Protocol',
    operatingSystem: 'Linux, macOS, Windows',
    programmingLanguage: ['Python', 'TypeScript', 'Go', 'Rust', 'Java', 'C++'],
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: 'https://github.com/Query-farm/vgi',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Query.Farm',
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'VGI', item: SITE_ORIGIN + '/vgi' },
    ],
  },
];
---

<PageLayout
  title="VGI — Vector Gateway Interface"
  description={vgiDescription}
  jsonLd={jsonLd}
>
  <!-- Hero — logo carries the brand; h1 stays for SEO + a11y. -->
  <section class="relative bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 overflow-hidden py-16 lg:py-24">
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="vgi-hero-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
            <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
            <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#vgi-hero-pattern)" />
      </svg>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <img
          src="/vgi/vgi-logo.png"
          alt="VGI — The Vector Gateway Interface"
          class="mx-auto w-48 md:w-56 lg:w-64 h-auto mb-8 drop-shadow-md"
          width="400"
          height="400"
        />
        <h1 class="sr-only">VGI — Vector Gateway Interface</h1>

        <p class="text-lg md:text-xl lg:text-2xl text-soil-700 mb-8 lg:mb-12 leading-relaxed max-w-3xl mx-auto">
          Extend DuckDB with functionality written in Python, TypeScript, Go, Rust, Java, or C++. Apache Arrow is the cross-language glue — call it from SQL like any native function.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/vgi/getting-started" variant="accent" size="lg">Get Started</Button>
          <Button href="https://github.com/Query-farm/vgi" variant="secondary" size="lg">GitHub</Button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
      </svg>
    </div>
  </section>

  <!-- What is VGI -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          align="center"
          eyebrow="The gist"
          title="A protocol, not a framework"
        />
        <p class="text-lg text-soil-700 leading-relaxed mt-6">
          VGI is an <strong>Apache Arrow-based RPC protocol</strong> for DuckDB. A small DuckDB C++ extension speaks the VGI protocol from inside DuckDB; lightweight libraries speak it from the language of your choice. Your code runs in its own process — no DuckDB headers, no shared memory model, no rebuilds when DuckDB upgrades.
        </p>
        <p class="text-lg text-soil-700 leading-relaxed mt-4">
          You get the ergonomics of a native UDF and the freedom of a microservice.
        </p>
      </div>
    </div>
  </section>

  <!-- Architecture diagram -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Architecture"
        title="How it fits together"
        description="DuckDB on one side, your code on the other, Apache Arrow IPC between them. Pick the language SDK that matches your stack."
        class="mb-12"
      />

      <figure class="max-w-5xl mx-auto bg-white rounded-xl border border-soil-200 p-6 lg:p-10">
        <img
          src="/vgi/architecture.svg"
          alt="Architecture diagram: a DuckDB session loads the vgi C++ extension, which speaks Apache Arrow IPC over a transport (pipes, Unix sockets, shared memory, or HTTP) to a worker process implementing the server end in Python, TypeScript, Go, Rust, Java, or C++."
          class="w-full h-auto"
        />
      </figure>

      <p class="mt-8 text-center text-sm text-soil-600 max-w-3xl mx-auto leading-relaxed">
        The DuckDB-side is a small C++ extension. Your code lives in a separate process, written in any of the supported languages. The two ends speak Apache Arrow IPC over a transport you choose — pipes for the spawned-subprocess case, Unix sockets for an existing local worker, shared memory for high-throughput co-located workloads, HTTP for remote ones.
      </p>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="What you can build"
        title="Use cases"
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {useCases.map(u => (
          <Card padding="lg" class="text-center">
            <div class="text-4xl mb-4">{u.icon}</div>
            <h3 class="text-lg font-bold text-soil-900 mb-3">{u.title}</h3>
            <p class="text-sm text-soil-700 leading-relaxed">{u.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick start preview -->
  <section class="py-16 lg:py-24 bg-soil-50">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          align="center"
          eyebrow="The 10-second tour"
          title="Three steps from zero to remote function"
          class="mb-8"
        />
        <CodeBlock code={quickStart} lang="sql" title="quickstart.sql" />
        <div class="mt-8 text-center">
          <Button href="/vgi/getting-started" variant="primary" size="lg">
            Full Getting Started Guide →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-page navigation -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-container">
      <SectionHeader
        align="center"
        eyebrow="Dive deeper"
        title="Where to next"
        class="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/vgi/getting-started" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🚀</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Getting Started</h3>
            <p class="text-sm text-soil-700">Install the extension, write your first worker, and run it end-to-end.</p>
          </Card>
        </a>
        <a href="/vgi/architecture" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🏗️</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Architecture</h3>
            <p class="text-sm text-soil-700">Transports, lifecycle, wire format, and how it integrates with the DuckDB execution engine.</p>
          </Card>
        </a>
        <a href="/vgi/languages" class="block">
          <Card padding="lg" class="h-full hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-3">🌍</div>
            <h3 class="text-lg font-bold text-soil-900 mb-2">Languages</h3>
            <p class="text-sm text-soil-700">SDKs for Python, TypeScript, Go, Rust, Java, and C++ — pick yours and start building.</p>
          </Card>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-harvest-600 to-grain-600 text-white">
    <div class="section-container text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Building something with VGI?
      </h2>
      <p class="text-xl md:text-2xl text-harvest-50 mb-8 max-w-3xl mx-auto">
        We help teams design, build, and ship VGI-based extensions. From a one-day spike to a long-term engagement.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/consulting" variant="secondary" size="lg">
          Consulting & Custom Development
        </Button>
        <Button href="/company/schedule" variant="ghost" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/30">
          Schedule a Call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
