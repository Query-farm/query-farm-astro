---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import VisionSplitTour from '../components/vision/VisionSplitTour.astro';
import { publicExtensions } from '../data/extensions';
import { usageSummary } from '../data/usage-summary';

const extensionCount = publicExtensions.length;
const annualizedLoads = usageSummary?.annualizedLoads ?? 0;
const compactCount = (value: number) => {
  if (value >= 1_000_000) return `${Math.round(value / 1_000_000)}M+`;
  if (value >= 1_000) return `${Math.round(value / 1_000)}K+`;
  return `${value}+`;
};

const tourSteps = [
  {
    stage: 0,
    label: 'Query surface',
    title: 'Questions start wherever people work.',
    status: 'Available entry points',
    body: 'Query.Farm does not require everyone to adopt one interface. Analysts can work directly in Cupola; applications and BI tools can connect through DuckDB’s existing drivers; engineers can use notebooks and the CLI; and agents can reach governed data tools through MCP.',
    capabilities: [
      'Cupola runs a complete SQL workbench in the browser—with pivots, charts, and a built-in AI analyst.',
      'ADBC and ODBC connect applications and BI tools through standard database interfaces.',
      'MCP, Jupyter, Python, dbt, and the CLI support agents, exploration, and automated workflows.',
    ],
    payoff: 'One integration, without forcing one user experience.',
    horizon: 'Available entry points',
    leadership: 'Give each team an interface that fits its work without funding a separate integration for each one.',
    builders: 'Keep using familiar DuckDB clients and tools; the capability appears as SQL rather than a new application API.',
    links: [
      { label: 'Explore Cupola', href: '/products/cupola' },
      { label: 'See VGI use cases', href: '/vgi#use-cases' },
    ],
  },
  {
    stage: 1,
    label: 'SQL engines',
    title: 'The capability should outlive the engine choice.',
    status: 'DuckDB today · an open path forward',
    body: 'DuckDB is the engine where Query.Farm’s integration model works today. Haybarn packages that foundation as an independently released distribution with signed binaries, rebuilt extensions, supply-chain review, and compatibility with ordinary DuckDB SQL and database files.',
    capabilities: [
      'Use upstream DuckDB directly, or choose Haybarn for Query.Farm-controlled releases and extension channels.',
      'Haybarn remains ABI- and file-format-compatible with DuckDB and uses familiar INSTALL and LOAD commands.',
      'VGI separates capabilities from engine internals, creating a path to other query engines without claiming those integrations exist today.',
    ],
    payoff: 'Adopt what works now without making today’s engine tomorrow’s boundary.',
    horizon: 'DuckDB today · more engines ahead',
    leadership: 'Start with a proven embedded engine while preserving leverage over distribution, release cadence, and future architecture.',
    builders: 'Choose the DuckDB distribution that fits deployment and supply-chain requirements without rewriting SQL or moving database files.',
    links: [
      { label: 'Meet Haybarn', href: '/products/haybarn' },
      { label: 'Install Haybarn', href: '/products/haybarn/install' },
    ],
  },
  {
    stage: 2,
    label: 'Engine integration',
    title: 'Put each capability on the right side of the process boundary.',
    status: 'Extensions and VGI available today',
    body: 'Query.Farm offers two complementary ways to add capability. Native DuckDB extensions put installable SQL functions and connectors inside the engine. The Vector Gateway Interface exposes ordinary programs as SQL-visible catalogs and functions across a process or network boundary.',
    capabilities: [
      `Choose from ${extensionCount} published extensions for connectors, transformations, sketches, scripting, and specialized SQL functions.`,
      'Build VGI workers in Python, TypeScript, Go, Rust, or Java without FFI, engine rebuilds, or version locking.',
      'Move typed data through Apache Arrow IPC over pipes, Unix sockets, TCP, or HTTP.',
    ],
    payoff: 'Use in-process speed where it matters and service boundaries where they help.',
    horizon: 'Extensions + open VGI protocol',
    leadership: 'Turn one-off connector work into a reusable capability with an explicit deployment and ownership boundary.',
    builders: 'Use a native extension for engine-local work; use VGI when the best library, runtime, hardware, or security boundary lives elsewhere.',
    links: [
      { label: 'Browse extensions', href: '/products/extensions' },
      { label: 'Understand VGI', href: '/vgi' },
      { label: 'Build a worker', href: '/vgi/building-a-worker' },
    ],
  },
  {
    stage: 3,
    label: 'Access control',
    title: 'Add policy when the data demands it.',
    status: 'Optional governance layer',
    body: 'Rowfence is a policy-driven authorization service that can sit between a query engine and any VGI worker. It decides on every query which rows, columns, schemas, and functions a caller may use—without making each worker implement its own policy engine.',
    capabilities: [
      'Carry caller identity through the VGI request and evaluate authorization before the worker returns data.',
      'Apply policy below the table level, including row filters, column visibility, schemas, and functions.',
      'Deploy the policy service only where shared or sensitive capabilities require it; direct worker connections remain valid.',
    ],
    payoff: 'Keep experimentation light and make the same path credible for enterprise access.',
    horizon: 'Optional governance layer',
    leadership: 'Create a credible path from a useful prototype to a shared service without waiting to solve every governance problem on day one.',
    builders: 'Keep policy, identity, and audit decisions outside application workers so capability code stays focused on the underlying system.',
    links: [
      { label: 'Explore Rowfence', href: '/products/rowfence' },
      { label: 'Review VGI security', href: '/vgi/row-column-security' },
    ],
  },
  {
    stage: 4,
    label: 'VGI execution',
    title: 'Run the code where the code belongs.',
    status: 'Self-run today · managed Orchard coming soon',
    body: 'A VGI worker is a normal program that turns existing code into SQL-visible tables and functions. It can run as a child process beside DuckDB, near a private service inside your network, on a GPU host, or behind ordinary HTTP. The Orchard platform will make workers discoverable and available as managed services.',
    capabilities: [
      'Package proprietary libraries, internal APIs, models, or operational logic in the language that already supports them best.',
      'Choose local process, socket, network, or HTTP deployment without changing the SQL-facing contract.',
      'Use Orchard’s worker catalog to discover reusable integrations; managed VGI workers are coming soon.',
    ],
    payoff: 'Reuse working application code instead of rebuilding it as database infrastructure.',
    horizon: 'Self-run today · managed platform coming',
    leadership: 'Keep ownership with the team that understands the source while making the resulting capability reusable across the organization.',
    builders: 'Deploy a worker next to the system, library, or hardware it needs instead of forcing that dependency into the query engine process.',
    links: [
      { label: 'Build a VGI worker', href: '/vgi/building-a-worker' },
      { label: 'Explore Orchard', href: '/products/orchard' },
      { label: 'Compare transports', href: '/vgi/architecture' },
    ],
  },
  {
    stage: 5,
    label: 'Data & compute',
    title: 'Anything a worker can reach becomes part of the query.',
    status: 'Your systems, exposed through one query model',
    body: 'The destination can be an API, service, database, file, model, live stream, or application library. The worker owns the system-specific authentication and behavior; the engine sees typed Arrow data, SQL tables, and functions. The difficult integration is built once and reused from every supported query surface.',
    capabilities: [
      'Put SQL in front of legacy systems and proprietary formats that cannot be rewritten.',
      'Expose APIs, event streams, models, and compute as catalogs, table functions, or scalar functions.',
      'Join remote capabilities with Parquet, CSV, Iceberg, Delta Lake, databases, and in-memory data in the same query.',
    ],
    payoff: 'Build the difficult integration once, then make it useful in more places.',
    horizon: 'The long-term destination',
    leadership: 'Replace repeated point-to-point integrations with a capability that can serve analysts, products, customers, and agents.',
    builders: 'Keep source-specific complexity inside one worker and give every consumer a typed, composable SQL contract.',
    links: [
      { label: 'Explore VGI use cases', href: '/vgi#use-cases' },
      { label: 'Discuss your integration', href: '/company/schedule' },
    ],
  },
];
const audiences = [
  {
    id: 'for-ceos',
    role: 'For CEOs',
    title: 'Turn integration work into a reusable asset.',
    body: 'Start with one valuable source or workflow, prove it in a real query, and create a path to reuse it across teams and products. Query.Farm’s open foundations keep the first step useful even before a broader platform decision.',
    detail: 'Business outcome: less repeated connector work and a clearer path from prototype to product.',
    cta: 'Discuss a reusable data product',
    href: '/company/schedule',
  },
  {
    id: 'for-ctos',
    role: 'For CTOs',
    title: 'Keep architecture choices open.',
    body: 'Use Apache Arrow IPC, ordinary processes, familiar transports, and a protocol that can span engine boundaries. Deploy locally, over HTTP, or inside your own network; add policy and managed operation only where the organization needs them.',
    detail: 'Architecture outcome: a smaller integration surface with explicit security and deployment boundaries.',
    cta: 'Review the architecture',
    href: '/company/schedule',
  },
  {
    id: 'for-data-engineers',
    role: 'For data engineers',
    title: 'Expose the systems you already know through SQL.',
    body: 'Wrap an API, library, model, or internal service in a VGI worker, or choose a native extension for in-process work. Query it from DuckDB today, join it with files and databases, and use the language and tooling that fit the source.',
    detail: 'Engineering outcome: less glue code between each source and each consumer.',
    cta: 'Build your first VGI worker',
    href: '/vgi/building-a-worker',
  },
];

const roadmap = [
  {
    number: '01',
    eyebrow: 'Built foundations',
    title: 'Useful before it is a platform',
    body: 'DuckDB extensions, VGI, Haybarn, and Cupola already solve concrete problems: add SQL capabilities, reach external code, ship a controlled engine, and explore data in the browser.',
    links: [
      { label: 'Browse extensions', href: '/products/extensions' },
      { label: 'Explore VGI', href: '/vgi' },
      { label: 'Meet Haybarn', href: '/products/haybarn' },
      { label: 'Open Cupola', href: '/products/cupola' },
    ],
  },
  {
    number: '02',
    eyebrow: 'Productizing the path',
    title: 'Govern and operate what teams share',
    body: 'Rowfence adds optional row-, column-, schema-, and function-level policy. Orchard is the coming managed home for VGI workers. Together they turn a useful worker into an operable, governable organizational capability.',
    links: [
      { label: 'Understand Rowfence', href: '/products/rowfence' },
      { label: 'Explore Orchard', href: '/products/orchard' },
    ],
  },
  {
    number: '03',
    eyebrow: 'The open-engine future',
    title: 'Make your capabilities queryable from anywhere',
    body: 'DuckDB is the proving ground, not the limit. The long-term direction is for VGI-backed capabilities to meet teams in the engine they choose—DataFusion, Trino, Spark, SQLite, Polars, and what comes next.',
    links: [
      { label: 'Discuss your architecture', href: '/company/schedule' },
    ],
  },
];

const WRAP = 'mx-auto max-w-[1280px] px-6 sm:px-7';
---

<PageLayout
  title="Our Vision — Make Anything Queryable from Anywhere"
  description="Explore Query.Farm's product vision: connect people, agents, and query engines to APIs, services, data, models, and code through extensions and the Vector Gateway Interface."
  ogImage="/og/vision.jpg"
>
  <main class="vision-page">
    <section class="vision-hero overflow-hidden border-b border-soil-300">
      <div class={`${WRAP} relative py-16 md:py-20 lg:py-24`}>
        <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
        <div class="relative max-w-[1000px]">
          <p class="qf-eyebrow text-sun-700">The Query.Farm vision</p>
          <h1 class="vision-title mt-4 max-w-[15ch] font-semibold leading-[0.98] tracking-[-0.045em] text-soil-900">
            Make every capability queryable from anywhere.
          </h1>
          <p class="mt-6 max-w-[74ch] text-[clamp(1.08rem,1.7vw,1.3rem)] leading-relaxed text-soil-700">
            Connect the data and code you already run to people, applications, and agents—without
            rebuilding the integration for every consumer. Query.Farm does this in DuckDB today
            through open extensions and VGI, with a path to more engines over time.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="#guided-tour" variant="primary" size="lg">Start the guided tour <span aria-hidden="true">↓</span></Button>
            <Button href="/company/schedule" variant="secondary" size="lg">Talk through your architecture <span aria-hidden="true">↗</span></Button>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-2" aria-label="This page is written for">
            <span class="mr-1 text-sm font-medium text-soil-600">Choose your altitude:</span>
            {[
              { label: 'CEO', href: '#for-ceos' },
              { label: 'CTO', href: '#for-ctos' },
              { label: 'Data engineering', href: '#for-data-engineers' },
            ].map((audience) => (
              <a href={audience.href} class="rounded-full border border-soil-300 bg-white/70 px-3 py-1.5 text-sm text-soil-700 transition hover:border-sun-600 hover:text-soil-900">{audience.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-soil-300 bg-[#fffdf7]">
      <div class={`${WRAP} grid grid-cols-2 divide-x divide-y divide-soil-300 md:grid-cols-4 md:divide-y-0`}>
        <div class="proof-cell">
          <strong>{extensionCount}</strong>
          <span>published extensions</span>
        </div>
        <div class="proof-cell">
          <strong>{compactCount(annualizedLoads)}</strong>
          <span>annualized extension run rate</span>
        </div>
        <div class="proof-cell">
          <strong>64</strong>
          <span>founder-authored DuckDB core PRs merged</span>
        </div>
        <div class="proof-cell">
          <strong>5</strong>
          <span>VGI language SDKs</span>
        </div>
      </div>
    </section>

    <section id="guided-tour" class="scroll-mt-20 border-b border-soil-300 py-16 lg:py-24">
      <div class={WRAP}>
        <div class="max-w-[820px]">
          <p class="qf-eyebrow text-sun-700">The Query.Farm product system</p>
          <h2 class="mt-3 text-3xl text-soil-900 md:text-5xl">Connect every place a question starts to the capability that answers it.</h2>
          <p class="mt-4 max-w-[68ch] text-[17.5px] leading-relaxed text-soil-700">
            Query.Farm connects the tools people use to query engines, extensions, authorization,
            distributed workers, and the data or compute behind them. Explore the six layers to see
            what works today, what can be added when needed, and where the platform is heading.
          </p>
        </div>

        <div class="map-key mt-8" aria-label="Product map status key">
          <div>
            <span class="map-key-dot is-live"></span>
            <p><strong>Working today</strong><span>Extensions, VGI for DuckDB, Haybarn, and Cupola</span></p>
          </div>
          <div>
            <span class="map-key-dot is-optional"></span>
            <p><strong>Optional when needed</strong><span>Rowfence authorization and policy</span></p>
          </div>
          <div>
            <span class="map-key-dot is-next"></span>
            <p><strong>Coming next</strong><span>Managed Orchard workers and more engine integrations</span></p>
          </div>
        </div>
      </div>

      <VisionSplitTour steps={tourSteps} />
    </section>

    <section id="what-it-means" class="scroll-mt-20 border-b border-soil-300 bg-soil-100 py-16 lg:py-24">
      <div class={WRAP}>
        <div class="max-w-[760px]">
          <p class="qf-eyebrow text-sun-700">What it means for you</p>
          <h2 class="mt-3 text-3xl text-soil-900 md:text-5xl">One architecture, three ways to evaluate it</h2>
        </div>
        <div class="mt-9 grid gap-4 lg:grid-cols-3">
          {audiences.map((audience, index) => (
            <article id={audience.id} class="audience-card scroll-mt-24">
              <div class="flex items-center justify-between gap-4">
                <span class="qf-eyebrow text-field-700">{audience.role}</span>
                <span class="qf-figure text-2xl text-sun-700">0{index + 1}</span>
              </div>
              <h3 class="mt-8 text-2xl leading-tight text-soil-900">{audience.title}</h3>
              <p class="mt-4 text-[15.5px] leading-relaxed text-soil-700">{audience.body}</p>
              <div class="mt-auto border-t border-soil-300 pt-5">
                <p class="text-sm font-medium leading-relaxed text-soil-800">{audience.detail}</p>
                <Button href={audience.href} variant="ghost" size="sm" class="mt-5">{audience.cta} <span aria-hidden="true">→</span></Button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-soil-300 py-16 lg:py-24">
      <div class={WRAP}>
        <div class="grid gap-6 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
          <div>
            <p class="qf-eyebrow text-sun-700">Built, building, becoming</p>
            <h2 class="mt-3 text-3xl text-soil-900 md:text-5xl">The vision compounds from working parts</h2>
            <p class="mt-4 max-w-[46ch] text-[17px] leading-relaxed text-soil-700">
              This is not a promise that begins after a platform is finished. Each layer has to be
              useful on its own, then become more valuable as the neighboring layers arrive.
            </p>
          </div>
          <div class="roadmap-list">
            {roadmap.map((item) => (
              <article class="roadmap-item">
                <div class="roadmap-number">{item.number}</div>
                <div>
                  <p class="qf-eyebrow text-field-700">{item.eyebrow}</p>
                  <h3 class="mt-2 text-2xl text-soil-900">{item.title}</h3>
                  <p class="mt-3 text-[15.5px] leading-relaxed text-soil-700">{item.body}</p>
                  <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
                    {item.links.map((link) => (
                      <a href={link.href} class="font-medium text-link underline decoration-link/35 underline-offset-4 hover:decoration-link">{link.label} <span aria-hidden="true">→</span></a>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-rock-900 py-16 text-cream lg:py-24">
      <div class={`${WRAP} grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end`}>
        <div>
          <p class="qf-eyebrow text-sun-400">Start with the stubborn thing</p>
          <h2 class="mt-3 max-w-[17ch] text-3xl text-cream md:text-5xl">Bring us the data, API, or code your team cannot query cleanly.</h2>
          <p class="mt-5 max-w-[68ch] text-[17px] leading-relaxed text-cream/75">
            In thirty minutes, we can place it on the map: what should run in-process, what belongs
            in a worker, where policy matters, and whether Query.Farm already has the piece you need.
            No deck, and no platform prerequisite.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <Button href="/company/schedule" variant="accent" size="lg" onDark>Book a 30-minute integration fit check</Button>
          <Button href="/products" variant="secondary" size="lg" onDark>Explore the products</Button>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .vision-page { width: 100%; max-width: 100vw; overflow-x: clip; }

  .vision-hero {
    background:
      radial-gradient(circle at 78% 18%, color-mix(in srgb, var(--color-sun-400) 20%, transparent), transparent 28rem),
      linear-gradient(145deg, var(--color-soil-50), var(--color-soil-100));
  }

  .vision-title { font-size: clamp(2.55rem, 7vw, 6.3rem); }

  .hero-orbit {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--color-field-600) 24%, transparent);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-orbit::after {
    content: '';
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: var(--color-sun-600);
    transform: rotate(45deg);
    animation: orbit-pulse 4.8s ease-in-out infinite;
  }

  .hero-orbit-one { width: 36rem; height: 36rem; right: -10rem; top: -17rem; }
  .hero-orbit-one::after { left: 8rem; bottom: 2.5rem; }
  .hero-orbit-two { width: 20rem; height: 20rem; right: 3rem; top: -8rem; }
  .hero-orbit-two::after { left: 1.8rem; bottom: 4rem; animation-delay: -2.1s; }

  @keyframes orbit-pulse {
    0%, 100% { opacity: .28; transform: rotate(45deg) scale(.72); }
    50% { opacity: 1; transform: rotate(45deg) scale(1); }
  }

  .proof-cell {
    display: flex;
    min-height: 112px;
    flex-direction: column;
    justify-content: center;
    gap: .35rem;
    padding: 1.25rem;
  }

  .proof-cell strong { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.55rem); line-height: 1; color: var(--color-soil-900); }
  .proof-cell span { font-size: .79rem; font-weight: 650; letter-spacing: .04em; color: var(--color-soil-600); }

  .map-key {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-soil-300);
    border-radius: 12px;
    background: #fffdf7;
  }

  .map-key > div { display: grid; grid-template-columns: 12px 1fr; gap: .75rem; padding: 1rem; border-bottom: 1px solid var(--color-soil-300); }
  .map-key > div:last-child { border-bottom: 0; }
  .map-key p { display: flex; flex-direction: column; gap: .15rem; font-size: .8rem; line-height: 1.45; color: var(--color-soil-600); }
  .map-key strong { color: var(--color-soil-900); }
  .map-key-dot { width: 9px; height: 9px; margin-top: .25rem; border-radius: 2px; transform: rotate(45deg); }
  .map-key-dot.is-live { background: var(--color-field-600); }
  .map-key-dot.is-optional { border: 2px solid var(--color-sun-600); }
  .map-key-dot.is-next { background: var(--color-soil-400); opacity: .65; }

  .audience-card {
    display: flex;
    min-height: 400px;
    flex-direction: column;
    padding: 1.6rem;
    border: 1px solid var(--color-soil-300);
    border-radius: 14px;
    background: #fffdf7;
    box-shadow: 0 14px 36px rgb(48 37 23 / .055);
  }

  .roadmap-list { border-top: 1px solid var(--color-soil-300); }
  .roadmap-item { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 2rem 0; border-bottom: 1px solid var(--color-soil-300); }
  .roadmap-number { font-family: var(--font-display); font-size: 1.65rem; color: var(--color-sun-700); }

  @media (min-width: 1100px) {
    .map-key { grid-template-columns: repeat(3, 1fr); }
    .map-key > div { border-right: 1px solid var(--color-soil-300); border-bottom: 0; }
    .map-key > div:last-child { border-right: 0; }
  }

  @media (max-width: 767px) {
    .hero-orbit { opacity: .55; }
    .proof-cell:nth-child(3) { border-left: 0; }
    .audience-card { min-height: 350px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orbit::after { animation: none; }
  }
</style>
