[
  {
    "id": "tsid_to_timestamp(VARCHAR)",
    "name": "tsid_to_timestamp",
    "type": "scalar",
    "returnType": "TIMESTAMP",
    "parameters": [
      {
        "name": "tsid",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Extracts the embedded timestamp (microsecond precision) from a TSID string. Accepts 32 hex digits or the dashed 8-4-4-4-12 form; anything else raises a conversion error.",
    "examples": [
      {
        "description": "",
        "code": "SELECT tsid_to_timestamp('65d4a2b6000000004000800000000000');",
        "outputTable": {
          "columns": [
