              "name": "tsid_to_timestamp('65d4a2b6000000004000800000000000')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "2024-02-20 13:01:42"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT tsid_to_timestamp('65d4a2b6-0000-0000-4000-800000000000');",
        "outputTable": {
          "columns": [
            {
              "name": "tsid_to_timestamp('65d4a2b6-0000-0000-4000-800000000000')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "2024-02-20 13:01:42"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "tsid",
    "name": "tsid",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [],
    "description": "Generates a new time-sorted unique identifier (TSID) as 32 lowercase hex digits. The first 64 bits encode the current time (seconds and nanoseconds since the Unix epoch), so TSIDs sort chronologically; the remaining bits are random. The bit layout is UUID v4 compatible.",
    "examples": [
      {
        "description": "",
        "code": "SELECT tsid();",
        "outputTable": {
          "columns": [
            {
              "name": "tsid()",
              "align": "left"
            }
          ],
          "rows": [
            [
              "6aef76a8cde14fe6962d2cbcce4dd72e"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT tsid() AS id FROM range(3) ORDER BY id;",
        "outputTable": {
          "columns": [
            {
              "name": "id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "6aef76a8cdf44cae80491218ed9cae1f"
            ],
            [
              "6aef76a8cdf44caeb01c7164d02bc669"
            ],
            [
              "6aef76a8cdf44da8a6ad7331abe748e0"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "tsid(TIMESTAMP)",
    "name": "tsid",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "ts",
        "type": "TIMESTAMP",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Generates a TSID whose embedded time is the given timestamp (1970-01-01 to 2106-02-07); the remaining bits are random. Useful for backfilling or for building range bounds.",
    "examples": [
      {
        "description": "",
        "code": "SELECT tsid(TIMESTAMP '2024-06-01 12:00:00');",
        "outputTable": {
          "columns": [
            {
              "name": "tsid(CAST('2024-06-01 12:00:00' AS TIMESTAMP))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "665b0d40000040009a664a7015dbf257"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT tsid_to_timestamp(tsid(TIMESTAMP '2024-06-01 12:00:00.123456'));",
        "outputTable": {
          "columns": [
            {
              "name": "tsid_to_timestamp(tsid(CAST('2024-06-01 12:00:00.123456' AS TIMESTAMP)))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "2024-06-01 12:00:00.123456"
            ]
          ]
        }
      }
    ]
  },
