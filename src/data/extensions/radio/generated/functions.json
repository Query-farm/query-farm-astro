  {
    "id": "radio_listen(BOOLEAN,INTERVAL)",
    "name": "radio_listen",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "wait_for_messages",
        "type": "BOOLEAN",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "timeout",
        "type": "INTERVAL",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns the subscriptions (id and URL) that hold received messages no query has read yet. When wait_for_messages is true and there are none, blocks until a message arrives or the timeout passes; the wait can be interrupted. Reading the messages, e.g. with radio_received_messages(), marks them as seen.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_listen(true, INTERVAL '10 seconds');",
        "outputTable": {
          "columns": [
            {
              "name": "subscription_id",
              "align": "left"
            },
            {
              "name": "subscription_url",
              "align": "left"
            }
          ],
          "rows": []
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM radio_listen(false, INTERVAL '0 seconds');",
        "outputTable": {
          "columns": [
            {
              "name": "subscription_id",
              "align": "left"
            },
            {
              "name": "subscription_url",
              "align": "left"
            }
          ],
          "rows": []
        }
      }
    ]
  },
