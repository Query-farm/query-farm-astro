[
  {
    "id": "radio_sleep(INTERVAL)",
    "name": "radio_sleep",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "duration",
        "type": "INTERVAL",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Sleeps for the given interval and returns true; the sleep can be interrupted. Useful in scripts that wait for messages to arrive.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_sleep(INTERVAL '1 second');",
        "outputTable": {
          "columns": [
            {
              "name": "finished",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "radio_subscription_transmit_message_delete(VARCHAR,UBIGINT)",
    "name": "radio_subscription_transmit_message_delete",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "message_id",
        "type": "UBIGINT",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Removes one message, by id, from a subscription's transmit queue (cancelling it if it has not been sent) and returns true.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_subscription_transmit_message_delete('ws://localhost:8080/events', 1001);",
        "outputTable": {
          "columns": [
            {
              "name": "ok",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "radio_flush(INTERVAL)",
    "name": "radio_flush",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "timeout",
        "type": "INTERVAL",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Waits up to the timeout for every subscription's transmit queue to finish sending (or give up on) its pending messages. Returns true if all were flushed in time, false otherwise.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_flush(INTERVAL '5 seconds');",
        "outputTable": {
          "columns": [
            {
              "name": "all_messages_flushed",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "radio_subscription_received_message_add(VARCHAR,VARCHAR,BLOB)",
    "name": "radio_subscription_received_message_add",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "channel",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "message",
        "type": "BLOB",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Adds a message to a subscription's receive queue as if it had arrived from the network, and returns its message id. The channel may be NULL and the message may be VARCHAR or BLOB. Useful for testing message handling without a server.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_subscription_received_message_add('ws://localhost:8080/events', NULL, 'hello');"
      }
    ]
  },
  {
    "id": "radio_transmit_message(VARCHAR,VARCHAR,BLOB,INTEGER,INTERVAL)",
    "name": "radio_transmit_message",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "channel",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "message",
        "type": "BLOB",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "max_attempts",
        "type": "INTEGER",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "expire_duration",
        "type": "INTERVAL",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Queues a message for sending on a subscription and returns its message id. A background sender retries with exponential backoff until it is sent, max_attempts is reached or expire_duration passes. VARCHAR messages are sent as WebSocket text frames, BLOB messages as binary frames; Redis subscriptions publish to the given channel (required for Redis, ignored for WebSocket); loopback:// subscriptions receive their own messages. Refuses network URLs when enable_external_access is false.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_transmit_message('ws://localhost:8080/events', NULL, '{\"type\":\"ping\"}', 3, INTERVAL '10 seconds');",
        "outputTable": {
          "columns": [
            {
              "name": "message_id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "1001"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM radio_transmit_message('redis://localhost:6379?channel=alerts', 'alerts', 'disk full', 5, INTERVAL '1 minute');",
        "outputTable": {
          "columns": [
            {
              "name": "message_id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "1002"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "radio_subscription_received_messages(VARCHAR)",
    "name": "radio_subscription_received_messages",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns the messages held in one subscription's receive queue with their id, receive time, seen count, channel and payload. Each read increments the messages' seen_count.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_subscription_received_messages('ws://localhost:8080/events');"
      }
    ]
  },
  {
    "id": "radio_subscription_transmit_messages_delete_finished(VARCHAR)",
    "name": "radio_subscription_transmit_messages_delete_finished",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Removes the transmit messages of a subscription that are finished (sent, retries exhausted or expired) and returns true.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_subscription_transmit_messages_delete_finished('ws://localhost:8080/events');"
      }
    ]
  },
  {
    "id": "radio_received_messages",
    "name": "radio_received_messages",
    "type": "table",
    "returnType": "None",
    "parameters": [],
    "description": "Returns the messages held in the receive queues of all subscriptions: message, connection, disconnection and error events, with their receive time, channel and payload. Each read increments the messages' seen_count.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_received_messages();"
      },
      {
        "description": "",
        "code": "SELECT message::VARCHAR FROM radio_received_messages() WHERE message_type = 'message';",
        "outputTable": {
          "columns": [
            {
              "name": "CAST(message AS VARCHAR)",
              "align": "left"
            }
          ],
          "rows": []
        }
      }
    ]
  },
  {
    "id": "radio_subscription_transmit_messages(VARCHAR)",
    "name": "radio_subscription_transmit_messages",
