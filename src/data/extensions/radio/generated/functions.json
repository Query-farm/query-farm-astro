  {
    "id": "radio_subscribe(VARCHAR,INTEGER,INTEGER,DOUBLE,INTEGER)",
    "name": "radio_subscribe",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "url",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "receive_message_capacity",
        "type": "INTEGER",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "transmit_retry_initial_delay_ms",
        "type": "INTEGER",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "transmit_retry_multiplier",
        "type": "DOUBLE",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "transmit_retry_max_delay_ms",
        "type": "INTEGER",
        "paramType": "named",
        "description": ""
      }
    ],
    "description": "Subscribes to a WebSocket (ws://, wss://) or Redis pub/sub (redis://host:port?channel=name) URL and returns the subscription id. A loopback://name URL needs no server: messages transmitted on it are received by the same subscription. The connection is made in the background; subscribing to a URL that is already subscribed returns the existing subscription. Optional named parameters: receive_message_capacity (default 1000; the oldest message is dropped when the receive queue is full), transmit_retry_initial_delay_ms (default 100), transmit_retry_multiplier (default 1.5) and transmit_retry_max_delay_ms (default 10000). Refuses network URLs when enable_external_access is false.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM radio_subscribe('ws://localhost:8080/events');",
        "outputTable": {
          "columns": [
            {
              "name": "subscription_id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "0"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM radio_subscribe('loopback://test');",
        "outputTable": {
          "columns": [
            {
              "name": "subscription_id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "1"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM radio_subscribe('redis://localhost:6379?channel=alerts', receive_message_capacity := 10000);",
        "outputTable": {
          "columns": [
            {
              "name": "subscription_id",
              "align": "left"
            }
          ],
          "rows": [
            [
              "2"
            ]
          ]
        }
      }
    ]
  },
