[
  {
    "id": "geosilo_decode(BLOB)",
    "name": "geosilo_decode",
    "type": "scalar",
    "returnType": "GEOMETRY",
    "parameters": [
      {
        "name": "blob",
        "type": "BLOB",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Decodes a raw GEOSILO-formatted BLOB into a GEOMETRY. Provided for backward compatibility with values stored as BLOB rather than the GEOSILO type.",
    "examples": [
      {
        "description": "",
        "code": "SELECT geosilo_decode(blob_col) FROM (SELECT geosilo_encode(ST_Point(1, 2)) AS blob_col) t;",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_decode(blob_col)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "0101000000000000000000f03f0000000000000040"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "geosilo_metadata(GEOSILO)",
    "name": "geosilo_metadata",
    "type": "scalar",
    "returnType": "STRUCT(geometry_type VARCHAR, vertex_type VARCHAR, scale BIGINT)",
    "parameters": [
      {
        "name": "geom",
        "type": "GEOSILO",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Reads the GEOSILO header without decoding the geometry. Returns a STRUCT with geometry_type (POINT, LINESTRING, ...), vertex_type (XY, XYZ, XYM, XYZM), and scale (the integer scale factor used at encode time).",
    "examples": [
      {
        "description": "",
        "code": "SELECT geosilo_metadata(geosilo_encode(ST_Point(1, 2))::GEOSILO);",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_metadata(CAST(geosilo_encode(st_point(1, 2)) AS GEOSILO))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "{'geometry_type': 'POINT', 'vertex_type': 'XY', 'scale': 10000000}"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "ST_Perimeter(GEOSILO)",
    "name": "ST_Perimeter",
    "type": "scalar",
    "returnType": "DOUBLE",
    "parameters": [
      {
        "name": "geom",
        "type": "GEOSILO",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns the planar perimeter of a (MULTI)POLYGON, summed across all rings. Returns 0 for non-areal geometries.",
    "examples": [
      {
        "description": "",
        "code": "SELECT ST_Perimeter(geosilo_encode(ST_GeomFromText('POLYGON((0 0, 4 0, 4 3, 0 3, 0 0))'))::GEOSILO);"
      }
    ]
  },
  {
    "id": "ST_XMax(GEOSILO)",
    "name": "ST_XMax",
    "type": "scalar",
    "returnType": "DOUBLE",
    "parameters": [
      {
        "name": "geom",
        "type": "GEOSILO",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns the maximum X coordinate of the geometry's bounding box.",
    "examples": [
