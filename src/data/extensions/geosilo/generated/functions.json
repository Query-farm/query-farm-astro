  {
    "id": "geosilo_decode(GEOSILO)",
    "name": "geosilo_decode",
    "type": "scalar",
    "returnType": "GEOMETRY",
    "parameters": [
      {
        "name": "geom",
        "type": "GEOSILO",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Decodes a GEOSILO value back into a DuckDB GEOMETRY. Round-trips losslessly when the original was encoded at sufficient scale.",
    "examples": [
      {
        "description": "",
        "code": "SELECT geosilo_decode(geosilo_encode(ST_Point(1, 2))::GEOSILO);",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_decode(CAST(geosilo_encode(st_point(1, 2)) AS GEOSILO))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "0101000000000000000000f03f0000000000000040"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT geosilo_decode(silo_col) FROM (SELECT ST_Point(1, 2)::GEOSILO AS silo_col) t;",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_decode(silo_col)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "0101000000000000000000f03f0000000000000040"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "geosilo_encode(GEOMETRY)",
    "name": "geosilo_encode",
    "type": "scalar",
    "returnType": "BLOB",
    "parameters": [
      {
        "name": "geometry",
        "type": "GEOMETRY",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Encodes a GEOMETRY value into the compact GEOSILO binary format. When the GEOMETRY carries CRS metadata, an appropriate integer scale is derived from the CRS (e.g. degree-based CRSes get higher precision than projected meter-based ones); otherwise a default scale of 10,000,000 (1e7) is used. Returns a BLOB; cast it to GEOSILO (`geosilo_encode(...)::GEOSILO`, which validates the header) to use it with the GEOSILO ST_* overloads. geosilo_decode and geosilo_metadata also accept the BLOB directly.",
    "examples": [
      {
        "description": "",
        "code": "SELECT geosilo_encode(ST_Point(1, 2));",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_encode(st_point(1, 2))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "5080969800002d3101"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'));",
        "outputTable": {
          "columns": [
            {
              "name": "geosilo_encode(st_geomfromtext('LINESTRING(0 0, 1 1, 2 2)'))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "54030000000000000000000000008080969800008080969800008080969800008080969800"
            ]
          ]
        }
      }
    ]
  },
