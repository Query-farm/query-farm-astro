[
  {
    "id": "cron_jobs",
    "name": "cron_jobs",
    "type": "table",
    "returnType": "None",
    "parameters": [],
    "description": "Lists the cron jobs scheduled in this database with their query, schedule, next and last run time (TIMESTAMPTZ), status, last result, run and error counts and creation time.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM cron_jobs();"
      },
      {
        "description": "",
        "code": "SELECT job_id, next_run, last_result FROM cron_jobs();"
      }
    ]
  },
  {
    "id": "cron(VARCHAR,VARCHAR)",
    "name": "cron",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "query",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "schedule",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Schedules a SQL query to run in the background on a six-field cron schedule (second minute hour day-of-month month day-of-week, evaluated in UTC) and returns the new job's id. The query is checked for syntax errors and the schedule must match at least one real date. Returns NULL (and schedules nothing) when either argument is NULL.",
    "examples": [
      {
        "description": "",
        "code": "SELECT cron('INSERT INTO heartbeat VALUES (now())', '*/10 * * * * *');",
        "outputTable": {
          "columns": [
            {
              "name": "cron('INSERT INTO heartbeat VALUES (now())', '*/10 * * * * *')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "task_0"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT cron('CHECKPOINT', '0 0 3 * * *');",
        "outputTable": {
          "columns": [
            {
              "name": "cron('CHECKPOINT', '0 0 3 * * *')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "task_1"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "cron_delete(VARCHAR)",
    "name": "cron_delete",
    "type": "scalar",
    "returnType": "BOOLEAN",
    "parameters": [
      {
        "name": "job_id",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Deletes a scheduled cron job by id and returns true. A run that is already in progress finishes; no further runs start. Raises an error if the job does not exist.",
    "examples": [
      {
        "description": "",
        "code": "SELECT cron_delete('task_0');",
        "outputTable": {
          "columns": [
            {
              "name": "cron_delete('task_0')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "cron_job_history",
    "name": "cron_job_history",
    "type": "table",
    "returnType": "None",
    "parameters": [],
    "description": "Lists the most recent runs (up to 100 per job) of every scheduled cron job, with start and finish time, whether the run succeeded and its result or error message.",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM cron_job_history();",
        "outputTable": {
          "columns": [
            {
              "name": "job_id",
              "align": "left"
            },
            {
              "name": "started_at",
              "align": "left"
            },
            {
              "name": "finished_at",
              "align": "left"
            },
            {
              "name": "success",
              "align": "left"
            },
            {
              "name": "result",
              "align": "left"
            }
          ],
          "rows": []
        }
      },
      {
        "description": "",
        "code": "SELECT job_id, started_at, result FROM cron_job_history() WHERE NOT success;",
        "outputTable": {
          "columns": [
            {
              "name": "job_id",
              "align": "left"
            },
            {
              "name": "started_at",
              "align": "left"
            },
            {
              "name": "result",
              "align": "left"
            }
          ],
          "rows": []
        }
      }
    ]
  }
]
