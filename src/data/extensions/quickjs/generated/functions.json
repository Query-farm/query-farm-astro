[
  {
    "id": "quickjs(VARCHAR)",
    "name": "quickjs",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "code",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Execute JavaScript code in a fresh QuickJS context and return the completion value (the value of the last expression) converted to a string.",
    "examples": [
      {
        "description": "",
        "code": "SELECT quickjs('1 + 2');",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs('1 + 2')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "3"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT quickjs('\"hello\".toUpperCase()');",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs('\"hello\".toUpperCase()')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "HELLO"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT quickjs('let a = [3, 1, 2]; a.sort().join(\",\")');",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs('let a = [3, 1, 2]; a.sort().join(\",\")')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "1,2,3"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "quickjs(VARCHAR)",
    "name": "quickjs",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "code",
        "type": "VARCHAR",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "varargs",
        "type": "ANY",
        "paramType": "positional",
        "description": "",
        "varargs": true
      }
    ],
    "description": "Execute JavaScript code that evaluates to an array; each element becomes a row of the JSON column 'result'. Extra arguments are available as arg0, arg1, ... and parsed_arg0 (arg0 parsed as JSON when it is a JSON string).",
    "examples": [
      {
        "description": "",
        "code": "SELECT * FROM quickjs('[1, 2, 3].map(x => x * 2)');",
        "outputTable": {
          "columns": [
            {
              "name": "result",
              "align": "left"
            }
          ],
          "rows": [
            [
              "2"
            ],
            [
              "4"
            ],
            [
              "6"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM quickjs('parsed_arg0.map(x => x * arg1)', '[1, 2, 3]', 10);",
        "outputTable": {
          "columns": [
            {
              "name": "result",
              "align": "left"
            }
          ],
          "rows": [
            [
              "10"
            ],
            [
              "20"
            ],
            [
              "30"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "quickjs_eval(VARCHAR)",
    "name": "quickjs_eval",
    "type": "scalar",
    "returnType": "JSON",
    "parameters": [
      {
        "name": "function",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "varargs",
        "type": "ANY",
        "paramType": "positional",
        "description": "",
        "varargs": true
      }
    ],
    "description": "Call a JavaScript function with the provided arguments and return its result as JSON (SQL NULL when the result is undefined). Arguments are converted to native JavaScript values: numbers, strings, booleans, BigInt (integers beyond 2^53), Date (DATE/TIMESTAMP), Uint8Array (BLOB), arrays (LIST/ARRAY) and objects (STRUCT/MAP).",
    "examples": [
      {
        "description": "",
        "code": "SELECT quickjs_eval('(a, b) => a + b', 1, 2);",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs_eval('(a, b) => a + b', 1, 2)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "3"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT quickjs_eval('(x) => x * 2', 21);",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs_eval('(x) => x * 2', 21)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "42"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT quickjs_eval('(l) => l.map(x => x * x)', [1, 2, 3]);",
        "outputTable": {
          "columns": [
            {
              "name": "quickjs_eval('(l) => l.map(x => x * x)', list_value(1, 2, 3))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "[1,4,9]"
            ]
          ]
        }
      }
    ]
  }
]
