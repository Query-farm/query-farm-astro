[
  {
    "id": "sql_auto_complete(VARCHAR,UBIGINT,UBIGINT,UBIGINT)",
    "name": "sql_auto_complete",
    "type": "table",
    "returnType": "None",
    "parameters": [
      {
        "name": "sql",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "max_suggestion_count",
        "type": "UBIGINT",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "max_file_suggestion_count",
        "type": "UBIGINT",
        "paramType": "named",
        "description": ""
      },
      {
        "name": "max_exact_suggestion_count",
        "type": "UBIGINT",
        "paramType": "named",
        "description": ""
      }
    ],
    "description": "Fuzzy auto-completion for the DuckDB shell: returns the keywords, tables, columns, functions or file names that fuzzy match the last word of sql (e.g. 'cstmr' finds 'customer'), best match first. Replaces the autocomplete extension's sql_auto_complete. Optional max_suggestion_count and max_file_suggestion_count (default 20) limit the number of suggestions; max_exact_suggestion_count is accepted for compatibility and ignored.",
    "examples": [
      {
        "description": "",
        "code": "SELECT suggestion, suggestion_type FROM sql_auto_complete('SELECT * FROM duckdb_tbl');",
        "outputTable": {
          "columns": [
            {
              "name": "suggestion",
              "align": "left"
            },
            {
              "name": "suggestion_type",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\"system\".main.duckdb_tables",
              "table"
            ],
            [
              "\"system\".main.duckdb_table_sample",
              "table_function"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT * FROM sql_auto_complete('SLCT', max_suggestion_count := 5);",
        "outputTable": {
          "columns": [
            {
              "name": "suggestion",
              "align": "left"
            },
            {
              "name": "suggestion_start",
              "align": "left"
            },
            {
              "name": "suggestion_type",
              "align": "left"
            },
            {
              "name": "suggestion_score",
              "align": "left"
            },
            {
              "name": "extra_char",
              "align": "left"
            }
          ],
          "rows": [
            [
              "SELECT ",
              "0",
              "keyword",
              "0",
              " "
            ]
          ]
        }
      }
    ]
  }
]
