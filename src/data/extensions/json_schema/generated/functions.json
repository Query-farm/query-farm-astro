[
  {
    "id": "json_schema_validate_schema(JSON)",
    "name": "json_schema_validate_schema",
    "type": "scalar",
    "returnType": "BOOLEAN",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Checks that a JSON schema is well formed and returns true; raises an error describing the problem otherwise. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_validate_schema('{\"type\": \"object\", \"required\": [\"id\"]}');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_validate_schema('{\"type\": \"object\", \"required\": [\"id\"]}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "json_schema_validate(JSON,JSON)",
    "name": "json_schema_validate",
    "type": "scalar",
    "returnType": "BOOLEAN",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_data",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Validates a JSON document against a JSON schema and returns true; raises an error listing the first validation errors otherwise. Use json_schema_is_valid() for a true/false result. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_validate('{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"integer\"}}}', '{\"id\": 5}');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_validate('{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"integer\"}}}', '{\"id\": 5}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "json_schema_update(JSON,JSON)",
    "name": "json_schema_update",
    "type": "scalar",
    "returnType": "JSON",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_data",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Validates a JSON document against a JSON schema and returns the document with the schema's default values filled in for missing properties. Raises an error if the document does not validate. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_update('{\"properties\": {\"id\": {\"type\": \"integer\", \"default\": 5}}}', '{\"name\": \"George\"}');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_update('{\"properties\": {\"id\": {\"type\": \"integer\", \"default\": 5}}}', '{\"name\": \"George\"}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "{\"id\":5,\"name\":\"George\"}"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "json_schema_patch(JSON,JSON)",
    "name": "json_schema_patch",
    "type": "scalar",
    "returnType": "JSON",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_data",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Validates a JSON document against a JSON schema and returns the JSON Patch (RFC 6902) that adds the schema's default values for missing properties. Raises an error if the document does not validate. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_patch('{\"properties\": {\"id\": {\"type\": \"integer\", \"default\": 5}}}', '{\"name\": \"George\"}');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_patch('{\"properties\": {\"id\": {\"type\": \"integer\", \"default\": 5}}}', '{\"name\": \"George\"}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "[{\"op\":\"add\",\"path\":\"/id\",\"value\":5}]"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "json_schema_errors(JSON,JSON)",
    "name": "json_schema_errors",
    "type": "scalar",
    "returnType": "STRUCT(path VARCHAR, keyword VARCHAR, message VARCHAR)[]",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_data",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns every validation error of a JSON document against a JSON schema as a list of {path, keyword, message} structs, where path is a JSON Pointer into the document (empty for the root). Returns an empty list for a conforming document. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_errors('{\"type\": \"object\", \"required\": [\"id\", \"name\"]}', '{\"id\": 1}');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_errors('{\"type\": \"object\", \"required\": [\"id\", \"name\"]}', '{\"id\": 1}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "[{'path': '', 'keyword': 'required', 'message': \"Required property 'name' not found.\"}]"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT json_schema_errors('{\"type\": \"array\", \"items\": {\"type\": \"integer\"}}', '[1, \"two\", 3]');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_errors('{\"type\": \"array\", \"items\": {\"type\": \"integer\"}}', '[1, \"two\", 3]')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "[{'path': '/1', 'keyword': 'type', 'message': 'Expected integer, found string'}]"
            ]
          ]
        }
      }
    ]
  },
  {
    "id": "json_schema_is_valid(JSON,JSON)",
    "name": "json_schema_is_valid",
    "type": "scalar",
    "returnType": "BOOLEAN",
    "parameters": [
      {
        "name": "schema",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_data",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Returns whether a JSON document conforms to a JSON schema (false for a document that is not valid JSON). Raises an error only when the schema itself is invalid. Supports JSON Schema draft 4, 6, 7, 2019-09 and 2020-12 (chosen by \"$schema\"; 2020-12 when absent), validates \"format\", and refuses remote $refs.",
    "examples": [
      {
        "description": "",
        "code": "SELECT json_schema_is_valid('{\"type\": \"integer\", \"minimum\": 0}', '-1');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_is_valid('{\"type\": \"integer\", \"minimum\": 0}', '-1')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "false"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT json_schema_is_valid('{\"prefixItems\": [{\"type\": \"string\"}]}', '[\"a\", 1]');",
        "outputTable": {
          "columns": [
            {
              "name": "json_schema_is_valid('{\"prefixItems\": [{\"type\": \"string\"}]}', '[\"a\", 1]')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "true"
            ]
          ]
        }
      }
    ]
  }
]
