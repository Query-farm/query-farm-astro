  {
    "id": "parseURL",
    "name": "parseURL",
    "definition": "CASE  WHEN ((part = 'protocol')) THEN (regexp_extract(url, '^(\\w+)://')) WHEN ((part = 'domain')) THEN (regexp_extract(url, '://([^/:]+)')) WHEN ((part = 'port')) THEN (regexp_extract(url, ':(\\d+)')) WHEN ((part = 'path')) THEN (regexp_extract(url, '://[^/]+(/.+?)(\\?|#|$)')) WHEN ((part = 'query')) THEN (regexp_extract(url, '\\?([^#]+)')) WHEN ((part = 'fragment')) THEN (regexp_extract(url, '#(.+)$')) ELSE NULL END",
    "description": "",
    "examples": []
