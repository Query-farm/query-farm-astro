[
  {
    "id": "open_prompt(VARCHAR,VARCHAR,VARCHAR,VARCHAR)",
    "name": "open_prompt",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "prompt",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "model",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "json_schema",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "system_prompt",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Send a prompt to an OpenAI-compatible LLM API and return the response. The model, a JSON schema for structured output and a system prompt are optional and can be passed by position or by name",
    "examples": [
      {
        "description": "",
        "code": "SELECT open_prompt('What is DuckDB?');"
      },
      {
        "description": "",
        "code": "SELECT open_prompt('Explain SQL', 'gpt-4');"
      },
      {
        "description": "",
        "code": "SELECT open_prompt('Extract name', 'gpt-4', '{\"type\":\"object\"}');"
      },
      {
        "description": "",
        "code": "SELECT open_prompt('Hello', 'gpt-4', '{}', 'You are helpful');"
      },
      {
        "description": "",
        "code": "SELECT open_prompt('I want ice cream', json_schema := '{\"type\":\"object\"}');"
      }
    ]
  },
