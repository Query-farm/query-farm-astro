  {
    "name": "a5_migrate",
    "categories": ["Utilities"],
    "relatedFunctions": ["a5_is_valid_cell", "a5_lonlat_to_cell"],
    "description": "Converts a cell ID created by a pre-1.0 version of A5 (this extension built on the a5 crate 0.10 or earlier) to the ID of the same cell in the A5 1.0 index. A5 1.0 orders cells along a new curve, so stored IDs at resolution 2 and finer still look valid but silently name *different* cells until migrated. Apply it exactly once, and only to pre-1.0 IDs — nothing in an ID says which index it belongs to. Resolution-1 IDs pass through unchanged, but the resolution-1 cells themselves were redefined, so re-index resolution-1 data from its source coordinates instead."
  },

  { "name": "a5_cell_to_geometry",   "categories": ["Geometry Integration"],  "relatedFunctions": ["a5_cell_to_point", "a5_cell_to_boundary", "a5_geometry_to_cells"] },
