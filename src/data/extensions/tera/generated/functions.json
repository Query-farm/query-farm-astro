      },
      {
        "name": "autoescape_extensions",
        "type": "VARCHAR[]",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Renders a Tera template string with JSON context variables. Options are passed by name: autoescape (default true), template_path (a glob of template files to load, default none; the template argument is then a template name) and autoescape_extensions (default [])",
    "examples": [
      {
        "description": "",
        "code": "SELECT tera_render('Hello {{ name }}!', '{\"name\": \"World\"}');",
        "outputTable": {
          "columns": [
            {
              "name": "tera_render('Hello {{ name }}!', '{\"name\": \"World\"}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "Hello World!"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT tera_render('{{ value | upper }}', '{\"value\": \"hello\"}');",
        "outputTable": {
          "columns": [
            {
              "name": "tera_render('{{ value | upper }}', '{\"value\": \"hello\"}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "HELLO"
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT tera_render('{{ v }}', '{\"v\": \"B&O\"}', autoescape := false);",
        "outputTable": {
          "columns": [
            {
              "name": "tera_render('{{ v }}', '{\"v\": \"B&O\"}', autoescape := false)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "B&O"
            ]
          ]
        }
      }
    ]
  },
