    "id": "tera_render(VARCHAR,JSON,BOOLEAN,VARCHAR,VARCHAR[])",
    "name": "tera_render",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "template",
