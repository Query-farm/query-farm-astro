        "description": ""
      },
      {
        "name": "bindings",
        "type": "JSON",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Evaluates a JSONata expression against JSON data with external variable bindings. The bindings parameter is a JSON object where keys become variable names accessible in the expression using $variable_name syntax.",
    "examples": [
      {
        "description": "",
        "code": "SELECT jsonata('$name', '{}', '{\"name\": \"Alice\"}');",
        "outputTable": {
          "columns": [
            {
              "name": "jsonata('$name', '{}', '{\"name\": \"Alice\"}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\"Alice\""
            ]
          ]
        }
      },
      {
        "description": "",
        "code": "SELECT jsonata('$x + $y', '{}', '{\"x\": 10, \"y\": 20}');",
        "outputTable": {
          "columns": [
            {
              "name": "jsonata('$x + $y', '{}', '{\"x\": 10, \"y\": 20}')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "30"
            ]
          ]
        }
      },
      {
        "description": "",
