    "id": "crypto_equals(BLOB,BLOB)",
    "name": "crypto_equals",
    "type": "scalar",
    "returnType": "BOOLEAN",
    "parameters": [
      {
        "name": "a",
        "type": "BLOB",
        "paramType": "positional",
