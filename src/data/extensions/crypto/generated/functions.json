  {
    "id": "crypto_hash_agg(VARCHAR,ANY)",
    "name": "crypto_hash_agg",
    "type": "aggregate",
    "returnType": "BLOB",
    "parameters": [
      {
        "name": "algorithm",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "value",
        "type": "ANY",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Computes a cryptographic hash over multiple rows using the specified algorithm. ORDER BY is required to ensure deterministic results. Returns the same hash as crypto_hash() would for an equivalent ordered list. Returns NULL for empty result sets and errors on NULL values.",
    "examples": [
      {
        "description": "",
        "code": "SELECT crypto_hash_agg('sha2-256', column_name ORDER BY id);"
      },
      {
        "description": "",
        "code": "SELECT crypto_hash_agg('blake3', data ORDER BY timestamp);"
      }
    ]
  },
