[
  {
    "id": "crypto_random_bytes(BIGINT)",
    "name": "crypto_random_bytes",
    "type": "scalar",
    "returnType": "BLOB",
    "parameters": [
      {
        "name": "length",
        "type": "BIGINT",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Generates cryptographically secure random bytes using OpenSSL's RAND_bytes(). Length must be between 1 and 4,294,967,295 bytes. Each call produces different random bytes.",
    "examples": [
      {
        "description": "",
        "code": "SELECT crypto_random_bytes(16);"
      },
      {
        "description": "",
        "code": "SELECT crypto_random_bytes(32);"
      }
    ]
  },
  {
    "id": "crypto_hmac(VARCHAR,VARCHAR,VARCHAR)",
    "name": "crypto_hmac",
    "type": "scalar",
    "returnType": "BLOB",
    "parameters": [
      {
        "name": "algorithm",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "key",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "message",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Computes an HMAC (Hash-based Message Authentication Code) of the message using the specified algorithm and key. Key and message may be VARCHAR or BLOB. blake3 uses its keyed mode, which requires exactly 32 bytes for the key; shake128 and shake256 are not supported.",
    "examples": [
      {
        "description": "",
        "code": "SELECT crypto_hmac('sha2-256', 'secret_key', 'message to authenticate');"
      }
    ]
  },
  {
    "id": "crypto_hash(VARCHAR,ANY)",
    "name": "crypto_hash",
    "type": "scalar",
    "returnType": "BLOB",
    "parameters": [
      {
        "name": "algorithm",
        "type": "VARCHAR",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "value",
        "type": "ANY",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Computes a cryptographic hash of the input value using the specified algorithm. Run crypto_algorithms() for the supported algorithms. Accepts strings, numbers, decimals, enums, dates, timestamps, intervals, UUIDs, and lists or arrays of those.",
    "examples": [
      {
        "description": "",
        "code": "SELECT crypto_hash('sha2-256', 'hello world');"
      },
      {
        "description": "",
        "code": "SELECT crypto_hash('blake3', 42);"
      },
      {
        "description": "",
        "code": "SELECT crypto_hash('sha2-256', [1, 2, 3]);"
      }
    ]
  },
