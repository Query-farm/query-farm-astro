      },
      {
        "name": "b",
        "type": "BLOB",
        "paramType": "positional",
        "description": ""
      }
    ],
    "description": "Compares two values in constant time, so the comparison does not leak how many leading bytes match. Use it to verify HMACs and other secrets.",
    "examples": [
      {
        "description": "",
        "code": "SELECT crypto_equals(crypto_hmac('sha2-256', 'key', 'message'), expected_mac);"
      }
    ]
