  {
    "id": "tp_density(DOUBLE[])",
    "name": "tp_density",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "values",
        "type": "DOUBLE[]",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "varargs",
        "type": "ANY",
        "paramType": "positional",
        "description": "",
        "varargs": true
      }
    ],
    "description": "Creates a density plot (histogram) visualization from an array of numeric values. Supports multiple styles: shaded, dots, ascii, height, circles, safety, rainbow_circle, rainbow_square, moon, sparse, and white.",
    "examples": [
      {
        "description": "",
        "code": "SELECT tp_density(list(value));"
      },
      {
        "description": "",
        "code": "SELECT tp_density(array_agg(score), width := 40);"
      },
      {
        "description": "",
        "code": "SELECT tp_density(data, style := 'height');"
      },
      {
        "description": "",
        "code": "SELECT tp_density(temps, style := 'rainbow_square', width := 30);"
      }
    ]
  },
  {
    "id": "tp_sparkline(DOUBLE[])",
    "name": "tp_sparkline",
    "type": "scalar",
    "returnType": "VARCHAR",
    "parameters": [
      {
        "name": "values",
        "type": "DOUBLE[]",
        "paramType": "positional",
        "description": ""
      },
      {
        "name": "varargs",
        "type": "ANY",
        "paramType": "positional",
        "description": "",
        "varargs": true
      }
    ],
    "description": "Creates a sparkline visualization from an array of numeric values. Supports three modes: 'absolute' (height-based), 'delta' (up/down/same direction), and 'trend' (direction with magnitude). Multiple themes available per mode.",
    "examples": [
      {
        "description": "",
        "code": "SELECT tp_sparkline(list(value));"
      },
      {
        "description": "",
        "code": "SELECT tp_sparkline(array_agg(price), width := 20);"
      },
      {
        "description": "",
        "code": "SELECT tp_sparkline(data, mode := 'delta', theme := 'arrows');"
      },
      {
        "description": "",
        "code": "SELECT tp_sparkline(temps, mode := 'absolute', theme := 'utf8_blocks');"
      },
      {
        "description": "",
        "code": "SELECT tp_sparkline(stocks, mode := 'trend', theme := 'faces');"
      }
    ]
  }
]
