[
  {
    "name": "tp_bar",
    "categories": [
      "Charts"
    ],
    "description": "Render a horizontal bar showing a numeric value as a fraction of a min/max range. Configurable width, shape (square/circle/heart), foreground/background colors, custom characters, and threshold-based coloring. Returns a VARCHAR you can drop into any SELECT. The first argument is positional; every option is a keyword-only named parameter with a default.",
    "parameters": [
      {
        "name": "value",
        "type": "DOUBLE",
        "paramType": "positional",
        "description": "Numeric value to visualize. The only positional argument."
      },
      {
        "name": "min",
        "type": "DOUBLE",
        "paramType": "named",
        "default": "0",
        "description": "Minimum of the value range. Must be less than `max`."
      },
      {
        "name": "max",
        "type": "DOUBLE",
        "paramType": "named",
        "default": "1",
        "description": "Maximum of the value range."
      },
      {
        "name": "width",
        "type": "BIGINT",
        "paramType": "named",
        "default": "10",
        "description": "Bar width in characters."
      },
      {
        "name": "on",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Custom string for filled blocks; the default `''` uses the colored `shape` glyph. Must be quoted in SQL \u2014 `\"on\"` \u2014 because `on` is a reserved keyword.",
        "default": "''"
      },
      {
        "name": "off",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Custom string for unfilled blocks; the default `''` uses the colored `shape` glyph. Must be quoted as `\"off\"`.",
        "default": "''"
      },
      {
        "name": "on_color",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Color name for filled portion (e.g. 'red', 'green', 'blue', 'yellow').",
        "default": "'red'"
      },
      {
        "name": "off_color",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Color name for unfilled portion.",
        "default": "'white'"
      },
      {
        "name": "shape",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "'square'",
        "description": "Block shape: 'square', 'circle', or 'heart'."
      },
      {
        "name": "filled",
        "type": "BOOLEAN",
        "paramType": "named",
        "default": "true",
        "description": "Fill all blocks up to the value (true) or just mark the endpoint (false)."
      },
      {
        "name": "thresholds",
        "type": "ANY",
        "paramType": "named",
        "description": "List of two-field structs `(threshold, color)` for value-dependent coloring; each block uses the highest threshold \u2264 value. Field names don't matter \u2014 `[(90, 'red'), (0, 'green')]` and `[{'threshold': 90, 'color': 'red'}]` both work. The default `[]` means no thresholds.",
        "default": "[]"
      }
    ],
    "examples": [
      {
        "description": "Simple progress bar (50% filled)",
        "code": "SELECT tp_bar(0.5);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(0.5)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\u2b1c\u2b1c\u2b1c\u2b1c\u2b1c"
            ]
          ]
        }
      },
      {
        "description": "Custom width and range \u2014 75 out of 100",
        "code": "SELECT tp_bar(75, min := 0, max := 100, width := 20);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(75, min := 0, max := 100, width := 20)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\ud83d\udfe5\u2b1c\u2b1c\u2b1c\u2b1c\u2b1c"
            ]
          ]
        }
      },
      {
        "description": "Circle shape with explicit colors",
        "code": "SELECT tp_bar(0.8, shape := 'circle', on_color := 'green', off_color := 'white');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(0.8, shape := 'circle', on_color := 'green', off_color := 'white')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\ud83d\udfe2\u26aa\u26aa"
            ]
          ]
        }
      },
      {
        "description": "Threshold-based coloring (85 out of 100 \u2192 yellow zone)",
        "code": "SELECT tp_bar(85, min := 0, max := 100, thresholds := [{'threshold': 90, 'color': 'red'}, {'threshold': 70, 'color': 'yellow'}, {'threshold': 0, 'color': 'green'}]);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(85, min := 0, max := 100, thresholds := list_value(struct_pack(threshold := 90, color := 'red'), struct_pack(threshold := 70, color := 'yellow'), struct_pack(threshold := 0, color := 'green')))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\ud83d\udfe8\u2b1c"
            ]
          ]
        }
      },
      {
        "description": "Custom characters (\"on\" and \"off\" must be quoted)",
        "code": "SELECT tp_bar(0.7, \"on\" := '\u2588', \"off\" := '\u2591', width := 15);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(0.7, \"on\" := '\u2588', \"off\" := '\u2591', width := 15)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2591\u2591\u2591\u2591"
            ]
          ]
        }
      },
      {
        "description": "Heart shape",
        "code": "SELECT tp_bar(0.6, shape := 'heart', on_color := 'red');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_bar(0.6, shape := 'heart', on_color := 'red')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d"
            ]
          ]
        }
      }
    ],
    "relatedFunctions": [
      "tp_density",
      "tp_sparkline"
    ]
  },
  {
    "name": "tp_density",
    "categories": [
      "Charts"
    ],
    "description": "Render an array of numeric values as a density plot \u2014 a compact distribution visualization where the character intensity at each x-position reflects how many input values fall in that bin. Multiple character-set styles, including ASCII for terminal compat and emoji for visual punch. The first argument is positional; every option is a keyword-only named parameter with a default.",
    "parameters": [
      {
        "name": "values",
        "type": "DOUBLE[]",
        "paramType": "positional",
        "description": "Array of numeric values to plot the distribution of."
      },
      {
        "name": "width",
        "type": "BIGINT",
        "paramType": "named",
        "default": "20",
        "description": "Plot width in characters."
      },
      {
        "name": "style",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "''",
        "description": "Character-set style. The default `''` means 'shaded' unless `graph_chars` is given (the two are mutually exclusive): 'shaded' (default ` \u2591\u2592\u2593\u2588`), 'ascii' (` .:+#@`), 'dots' (` .\u2022\u25cf`), 'height' (` \u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588`), 'circles' (`\u26ab\u26aa\ud83d\udfe1\ud83d\udfe0\ud83d\udd34`), 'safety', 'rainbow_circle' (`\u26ab\ud83d\udfe4\ud83d\udfe3\ud83d\udd35\ud83d\udfe2\ud83d\udfe1\ud83d\udfe0\ud83d\udd34\u26aa`), 'rainbow_square', 'moon', 'sparse', or 'white'."
      },
      {
        "name": "marker",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Character drawn at the bin containing `marker_value`. Requires `marker_value`; when only `marker_value` is given it defaults to `\u25bc`.",
        "default": "''"
      },
      {
        "name": "marker_value",
        "type": "DOUBLE",
        "paramType": "named",
        "default": "NaN",
        "description": "Value to highlight with `marker`. Must be finite; the default NaN means \"no marker\", so `marker_value := 'nan'::DOUBLE` is the same as leaving it out."
      },
      {
        "name": "graph_chars",
        "type": "VARCHAR[]",
        "paramType": "named",
        "description": "Custom list of characters for density levels, lowest to highest. Mutually exclusive with `style`. The default `[]` means \"use `style`\".",
        "default": "[]"
      }
    ],
    "examples": [
      {
        "description": "Default shaded style",
        "code": "SELECT tp_density([1, 2, 3, 4, 5, 4, 3, 2, 1]);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 2, 3, 4, 5, 4, 3, 2, 1))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2588    \u2588    \u2588    \u2588   \u2592"
            ]
          ]
        }
      },
      {
        "description": "Wide height-style plot",
        "code": "SELECT tp_density([1, 2, 3, 2, 1], width := 30, style := 'height');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 2, 3, 2, 1), width := 30, style := 'height')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2588              \u2588             \u2584"
            ]
          ]
        }
      },
      {
        "description": "ASCII style for terminals without Unicode",
        "code": "SELECT tp_density([1, 5, 3, 8, 2], style := 'ascii');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 5, 3, 8, 2), style := 'ascii')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "@ @  @     @       @"
            ]
          ]
        }
      },
      {
        "description": "Dot style for subtle visualization",
        "code": "SELECT tp_density([1, 5, 3, 8, 2], style := 'dots');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 5, 3, 8, 2), style := 'dots')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u25cf \u25cf  \u25cf     \u25cf       \u25cf"
            ]
          ]
        }
      },
      {
        "description": "Rainbow emoji style",
        "code": "SELECT tp_density([1, 5, 3, 8, 2], style := 'rainbow_circle');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 5, 3, 8, 2), style := 'rainbow_circle')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u26aa\u26ab\u26aa\u26ab\u26ab\u26aa\u26ab\u26ab\u26ab\u26ab\u26ab\u26aa\u26ab\u26ab\u26ab\u26ab\u26ab\u26ab\u26ab\u26aa"
            ]
          ]
        }
      },
      {
        "description": "Highlight a value with the default \u25bc marker",
        "code": "SELECT tp_density([1, 2, 2, 3, 3, 3, 4, 4, 5], width := 20, marker_value := 4.5);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 2, 2, 3, 3, 3, 4, 4, 5), width := 20, marker_value := 4.5)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2591    \u2593    \u2588    \u2593 \u25bc \u2591"
            ]
          ]
        }
      },
      {
        "description": "Custom density characters with graph_chars",
        "code": "SELECT tp_density([1, 5, 3, 8, 2], graph_chars := ['.', 'o', 'O'], width := 16);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_density(list_value(1, 5, 3, 8, 2), graph_chars := list_value('.', 'o', 'O'), width := 16)",
              "align": "left"
            }
          ],
          "rows": [
            [
              "O.O.O....O.....O"
            ]
          ]
        }
      }
    ],
    "relatedFunctions": [
      "tp_sparkline",
      "tp_bar"
    ]
  },
  {
    "name": "tp_sparkline",
    "categories": [
      "Charts"
    ],
    "description": "Render an array of numeric values as a sparkline \u2014 a compact one-line trend chart. Three modes: `absolute` (height \u221d value), `delta` (direction of change), `trend` (direction with magnitude). Each mode has multiple themes: arrows, faces, slopes, hearts, and more. The first argument is positional; every option is a keyword-only named parameter with a default.",
    "parameters": [
      {
        "name": "values",
        "type": "DOUBLE[]",
        "paramType": "positional",
        "description": "Array of numeric values, ordered (typically by time)."
      },
      {
        "name": "width",
        "type": "BIGINT",
        "paramType": "named",
        "default": "20",
        "description": "Sparkline width in characters."
      },
      {
        "name": "mode",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "'absolute'",
        "description": "Visualization mode: 'absolute' (height \u221d value), 'delta' (up/same/down), or 'trend' (signed magnitude)."
      },
      {
        "name": "theme",
        "type": "VARCHAR",
        "paramType": "named",
        "description": "Character-set theme. The default `''` picks the mode's default theme: `utf8_blocks` for absolute, `arrows` for delta and trend. Options vary by mode \u2014 absolute: utf8_blocks, ascii_basic, hearts, faces. delta: arrows, triangles, ascii_arrows, math, faces, thumbs, trends, simple. trend: arrows, ascii, slopes, intensity, faces, chart.",
        "default": "''"
      }
    ],
    "examples": [
      {
        "description": "Absolute mode (default)",
        "code": "SELECT tp_sparkline([1, 3, 2, 5, 4, 6, 2, 1]);",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(1, 3, 2, 5, 4, 6, 2, 1))",
              "align": "left"
            }
          ],
          "rows": [
            [
              "   \u2583\u2583\u2582\u2582\u2582\u2586\u2586\u2585\u2585\u2585\u2588\u2588\u2582\u2582\u2582  "
            ]
          ]
        }
      },
      {
        "description": "Stock prices with explicit theme and width",
        "code": "SELECT tp_sparkline([45.2, 47.1, 46.8, 49.3, 52.1, 48.7], width := 20, theme := 'utf8_blocks');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(45.2, 47.1, 46.8, 49.3, 52.1, 48.7), width := 20, theme := 'utf8_blocks')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "    \u2582\u2582\u2582\u2582\u2582\u2582\u2585\u2585\u2585\u2585\u2588\u2588\u2588\u2584\u2584\u2584"
            ]
          ]
        }
      },
      {
        "description": "Delta mode with arrow theme",
        "code": "SELECT tp_sparkline([100, 105, 102, 108, 95], mode := 'delta');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(100, 105, 102, 108, 95), \"mode\" := 'delta')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\u2191\u2191\u2191\u2191\u2191\u2193\u2193\u2193\u2193\u2193\u2191\u2191\u2191\u2191\u2191\u2193\u2193\u2193\u2193\u2193"
            ]
          ]
        }
      },
      {
        "description": "Delta mode with face theme",
        "code": "SELECT tp_sparkline([72, 75, 75, 78, 71], mode := 'delta', theme := 'faces');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(72, 75, 75, 78, 71), \"mode\" := 'delta', theme := 'faces')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude10\ud83d\ude10\ud83d\ude10\ud83d\ude10\ud83d\ude10\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a\ud83d\ude1e\ud83d\ude1e\ud83d\ude1e\ud83d\ude1e\ud83d\ude1e"
            ]
          ]
        }
      },
      {
        "description": "Trend mode with slope theme",
        "code": "SELECT tp_sparkline([10, 12, 11, 15, 8], mode := 'trend', theme := 'slopes');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(10, 12, 11, 15, 8), \"mode\" := 'trend', theme := 'slopes')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "/////\\\\\\\\\\/////\\\\\\\\\\\\\\\\\\\\"
            ]
          ]
        }
      },
      {
        "description": "Trend mode with intensity theme",
        "code": "SELECT tp_sparkline([100, 110, 105, 125, 90], mode := 'trend', theme := 'intensity');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_sparkline(list_value(100, 110, 105, 125, 90), \"mode\" := 'trend', theme := 'intensity')",
              "align": "left"
            }
          ],
          "rows": [
            [
              "+++++-----+++++----------"
            ]
          ]
        }
      }
    ],
    "relatedFunctions": [
      "tp_density",
      "tp_bar"
    ]
  },
  {
    "name": "tp_qr",
    "categories": [
      "QR Codes"
    ],
    "description": "Encode a string or BLOB as a QR code rendered with Unicode block characters. Configurable error-correction level and custom on/off characters for styling. The first argument is positional; the options are keyword-only named parameters with defaults.",
    "parameters": [
      {
        "name": "data",
        "type": "VARCHAR | BLOB",
        "paramType": "positional",
        "description": "Data to encode. VARCHAR may use the denser QR text modes; BLOB is always encoded in byte mode."
      },
      {
        "name": "ecc",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "'low'",
        "description": "Error correction level: 'low', 'medium', 'quartile', or 'high'. Higher levels can survive more damage at the cost of larger QR codes."
      },
      {
        "name": "on",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "''",
        "description": "Character for filled modules; the default `''` renders `\u2b1b`. Must be quoted as `\"on\"` (reserved keyword)."
      },
      {
        "name": "off",
        "type": "VARCHAR",
        "paramType": "named",
        "default": "''",
        "description": "Character for empty modules; the default `''` renders `\u2b1c`. Must be quoted as `\"off\"`."
      }
    ],
    "examples": [
      {
        "description": "Basic QR code",
        "code": "SELECT tp_qr('Hello, World!');",
        "outputTable": {
          "columns": [
            {
              "name": "tp_qr('Hello, World!')",
              "align": "left"
            }
          ],
