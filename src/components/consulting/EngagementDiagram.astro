---
import { publicExtensions } from '../../data/extensions';

const extensionCount = publicExtensions.length;
const VB_W = 1100;
const VB_H = 860;
const RAIL_W = 174;
const LABEL_X = 144;
const CONTENT_X = 206;
const COMPONENT_X = 224;
const COMPONENT_W = 330;
const ENGAGEMENT_X = 654;
const ENGAGEMENT_W = 396;
const CARD_H = 112;

const layers = [
  { label: 'Any layer', y: 28, height: 110 },
  { label: 'SQL engines', y: 164, height: 150 },
  { label: 'Engine integration', y: 326, height: 150 },
  { label: 'Access control', y: 488, height: 150 },
  { label: 'VGI execution', y: 650, height: 150 },
];

interface Row {
  label: string;
  component: { title: string; sub: string; href: string; mark: string };
  engagement: { title: string; meta: string; lines: string[]; prose: string };
}

const rows: Row[] = [
  {
    label: 'SQL engines',
    component: {
      title: 'Haybarn or DuckDB',
      sub: 'The engine your team already runs',
      href: '/products/haybarn',
      mark: '/products/haybarn/haybarn-mark.svg',
    },
    engagement: {
      title: 'Production readiness',
      meta: '2–3 weeks · $22,500 fixed',
      lines: ['Signed builds, a pinned extension set,', 'upgrade policy, and review packet.'],
      prose: 'Signed builds, a pinned extension set, upgrade policy, and review packet.',
    },
  },
  {
    label: 'Engine integration',
    component: {
      title: 'DuckDB extensions',
      sub: `${extensionCount} published · loaded in-process`,
      href: '/products/extensions',
      mark: '/images/duckdb-icon.svg',
    },
    engagement: {
      title: 'A native extension',
      meta: '3–6 weeks · $27–67.5K',
      lines: ['For work that genuinely needs C++:', 'custom types, storage, or optimizer changes.'],
      prose: 'For work that genuinely needs C++: custom types, storage, or optimizer changes.',
    },
  },
  {
    label: 'Access control',
    component: {
      title: 'Rowfence',
      sub: 'Row-, column-, schema-, and function-level policy',
      href: '/products/rowfence',
      mark: '/rowfence/rowfence-icon.svg',
    },
    engagement: {
      title: 'Policy design',
      meta: 'Design partner · discounted',
      lines: ['An entitlement model and policies built', 'against your real access rules.'],
      prose: 'An entitlement model and policies built against your real access rules.',
    },
  },
  {
    label: 'VGI execution',
    component: {
      title: 'VGI workers',
      sub: 'Your APIs, services, databases, and models',
      href: '/vgi',
      mark: '/vgi/vgi-emblem.png',
    },
    engagement: {
      title: 'A worker in your language',
      meta: '2–8 weeks · $18–54K',
      lines: ['The right answer for most connectors—', 'without C++ or a release build matrix.'],
      prose: 'The right answer for most connectors—without C++ or a release build matrix.',
    },
  },
];

const bracePath = (y: number, height: number) => {
  const top = y + 10;
  const bottom = y + height - 10;
  const middle = (top + bottom) / 2;
  const shoulder = Math.min(18, (bottom - top) * 0.16);
  return [
    `M169 ${top}`,
    `C163 ${top} 160 ${top + 5} 160 ${top + shoulder}`,
    `C160 ${middle - 13} 158 ${middle - 6} 152 ${middle}`,
    `C158 ${middle + 6} 160 ${middle + 13} 160 ${bottom - shoulder}`,
    `C160 ${bottom - 5} 163 ${bottom} 169 ${bottom}`,
  ].join(' ');
};

const ariaLabel =
  'Consulting engagement map. A seven-thousand-five-hundred-dollar feasibility review can begin at any layer and is credited against a build. ' +
  'At the SQL engine layer, Haybarn or DuckDB connects to a two-to-three-week production-readiness engagement priced at twenty-two thousand five hundred dollars. ' +
  `At engine integration, ${extensionCount} DuckDB extensions connect to a three-to-six-week native extension engagement priced from twenty-seven to sixty-seven thousand five hundred dollars. ` +
  'At access control, Rowfence connects to discounted design-partner policy work. ' +
  'At VGI execution, workers connect to a two-to-eight-week build priced from eighteen to fifty-four thousand dollars.';
---

<div class="engagement-shell">
  <div class="canvas-scroll">
    <svg class="engagement-map" viewBox={`0 0 ${VB_W} ${VB_H}`} xmlns="http://www.w3.org/2000/svg" aria-labelledby="engagement-map-title">
      <title id="engagement-map-title">{ariaLabel}</title>
      <defs>
        <pattern id="consulting-columns" width="28" height={VB_H} patternUnits="userSpaceOnUse">
          <path d={`M28 0V${VB_H}`} class="grid-line" />
        </pattern>
        <filter id="consulting-card-shadow" x="-20%" y="-20%" width="150%" height="160%">
          <feDropShadow dx="5" dy="5" stdDeviation="0" flood-color="#cfc4ad" flood-opacity=".58" />
        </filter>
      </defs>

      <rect x="0" y="0" width={RAIL_W} height={VB_H} class="label-rail" />
      <rect x={RAIL_W} y="0" width={VB_W - RAIL_W} height={VB_H} fill="url(#consulting-columns)" />
      {layers.map((layer, index) => (
        <rect x={RAIL_W} y={layer.y} width={VB_W - RAIL_W} height={layer.height} class:list={['layer-band', `layer-band-${index}`]} />
      ))}
      <path d={`M${RAIL_W} 0V${VB_H}`} class="label-divider" />

      {layers.map((layer) => (
        <g class="layer-marker">
          <text x={LABEL_X} y={layer.y + layer.height / 2 + (layer.label === 'Engine integration' ? -4 : 4)} text-anchor="end">
            {layer.label === 'Engine integration' ? (
              <>
                <tspan x={LABEL_X}>ENGINE</tspan>
                <tspan x={LABEL_X} dy="15">INTEGRATION</tspan>
              </>
            ) : layer.label.toUpperCase()}
          </text>
          <path d={bracePath(layer.y, layer.height)} />
        </g>
      ))}

      {layers.slice(0, -1).map((layer) => (
        <path d={`M${RAIL_W} ${layer.y + layer.height}H1072`} class="layer-separator" />
      ))}

      <a href="#offers" class="card-link">
        <rect x={COMPONENT_X} y="38" width={ENGAGEMENT_X + ENGAGEMENT_W - COMPONENT_X} height="90" rx="5" class="review-card" />
        <g transform="translate(247 61)">
          <path d="M0 9 9 0l9 9-9 9Z" class="review-diamond" />
        </g>
        <text x="280" y="72" class="card-title">Start with a feasibility review</text>
        <text x="280" y="98" class="card-copy">Its job is to establish which layer the problem belongs in.</text>
        <text x="1026" y="72" text-anchor="end" class="price-copy">$7,500 FIXED</text>
        <text x="1026" y="98" text-anchor="end" class="credit-copy">CREDITED AGAINST THE BUILD</text>
      </a>

      {rows.map((row, index) => {
        const layer = layers[index + 1];
        const cardY = layer.y + 19;
        const centerY = cardY + CARD_H / 2;
        const connectorStart = COMPONENT_X + COMPONENT_W;
        const connectorEnd = ENGAGEMENT_X;
        const connectorId = `consulting-connection-${index}`;
        const markSize = row.component.title === 'VGI workers' ? 50 : 42;
        const markColumnCenter = COMPONENT_X + 47;
        const copyX = COMPONENT_X + 88;
        return (
          <g>
            <a href={row.component.href} class="card-link">
              <rect x={COMPONENT_X} y={cardY} width={COMPONENT_W} height={CARD_H} rx="5" class="component-card" />
              <image
                href={row.component.mark}
                x={markColumnCenter - markSize / 2}
                y={cardY + CARD_H / 2 - markSize / 2}
                width={markSize}
                height={markSize}
                preserveAspectRatio="xMidYMid meet"
              />
              <text x={copyX} y={cardY + 42} class="card-title">{row.component.title}</text>
              <text x={copyX} y={cardY + 69} class="card-copy">{row.component.sub}</text>
              <text x={COMPONENT_X + COMPONENT_W - 18} y={cardY + 94} text-anchor="end" class="learn-more">Learn more  ●</text>
            </a>

            <path id={connectorId} d={`M${connectorStart} ${centerY}H${connectorEnd}`} class="work-connector" />
            <path d={`M${connectorEnd - 8} ${centerY - 5}L${connectorEnd} ${centerY}L${connectorEnd - 8} ${centerY + 5}`} class="connector-arrow" />
            <text x={(connectorStart + connectorEnd) / 2} y={centerY - 12} text-anchor="middle" class="connector-label">WE BUILD</text>
            <path d="M-5 0 0-5 5 0 0 5Z" class="work-packet">
              <animateMotion dur={`${6.8 + index * .45}s`} repeatCount="indefinite" begin={`${index * 1.2}s`}>
                <mpath href={`#${connectorId}`} />
              </animateMotion>
            </path>

            <a href="#offers" class="card-link">
              <rect x={ENGAGEMENT_X} y={cardY} width={ENGAGEMENT_W} height={CARD_H} rx="5" class="engagement-card" />
              <text x={ENGAGEMENT_X + 22} y={cardY + 34} class="card-title">{row.engagement.title}</text>
              <text x={ENGAGEMENT_X + 22} y={cardY + 58} class="price-copy">{row.engagement.meta}</text>
              {row.engagement.lines.map((line, lineIndex) => (
                <text x={ENGAGEMENT_X + 22} y={cardY + 82 + lineIndex * 17} class="card-copy">{line}</text>
              ))}
            </a>
          </g>
        );
      })}

      <g transform="translate(370 827)" class="diagram-legend">
        <rect x="0" y="-19" width="360" height="38" rx="8" />
        <path d="M18 0H63" class="work-connector" />
        <path d="M-4 0 0-4 4 0 0 4Z" class="work-packet" transform="translate(41 0)" />
        <text x="78" y="4">Platform component → consulting engagement</text>
      </g>
    </svg>
  </div>

  <div class="mobile-stack">
    <a href="#offers" class="mobile-review">
      <span class="qf-eyebrow text-sun-700">Any layer</span>
      <strong>Start with a feasibility review</strong>
      <span class="qf-figure text-sun-700">$7,500 fixed · credited against the build</span>
      <p>Establish which layer the problem belongs in before committing to a build.</p>
    </a>
    {rows.map((row) => (
      <section class="mobile-layer">
        <p class="mobile-layer-name">{row.label}</p>
        <a href={row.component.href} class="mobile-card component">
          <span class="tool-heading">
            <img src={row.component.mark} alt="" />
            <strong>{row.component.title}</strong>
          </span>
          <span>{row.component.sub}</span>
        </a>
        <div class="mobile-connector"><span>WE BUILD</span><i></i></div>
        <a href="#offers" class="mobile-card engagement">
          <strong>{row.engagement.title}</strong>
          <span class="qf-figure text-sun-700">{row.engagement.meta}</span>
          <p>{row.engagement.prose}</p>
        </a>
      </section>
    ))}
  </div>
</div>

<style>
  .engagement-shell { overflow: hidden; border: 1px solid var(--color-soil-300); border-radius: 22px; background: #fffdf7; box-shadow: 0 30px 70px -55px rgb(33 26 18 / .9); }
  .canvas-scroll { overflow-x: auto; }
  .engagement-map { display: none; width: 100%; min-width: 900px; height: auto; }
  .grid-line { fill: none; stroke: color-mix(in srgb, var(--color-soil-300) 34%, transparent); stroke-width: 1; }
  .label-rail { fill: #fffdf7; }
  .label-divider { fill: none; stroke: var(--color-soil-300); stroke-width: 1.5; }
  .layer-band-0, .layer-band-2 { fill: var(--color-sun-200); opacity: .16; }
  .layer-band-1, .layer-band-4 { fill: var(--color-soil-100); opacity: .58; }
  .layer-band-3 { fill: var(--color-field-400); opacity: .075; }
  .layer-separator { fill: none; stroke: var(--color-soil-300); stroke-width: 1.5; opacity: .72; }
  .layer-marker text { fill: var(--color-soil-600); font-size: 12px; font-weight: 750; letter-spacing: .105em; }
  .layer-marker path { fill: none; stroke: var(--color-sun-600); stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .component-card, .engagement-card, .review-card { filter: url(#consulting-card-shadow); vector-effect: non-scaling-stroke; }
  .component-card { fill: var(--color-soil-100); stroke: var(--color-soil-300); stroke-width: 2; }
  .engagement-card { fill: #fffdf7; stroke: var(--color-sun-600); stroke-width: 2.5; }
  .review-card { fill: color-mix(in srgb, var(--color-sun-200) 25%, #fffdf7); stroke: var(--color-sun-600); stroke-width: 2.5; stroke-dasharray: 8 6; }
  .review-diamond, .work-packet { fill: var(--color-sun-500); }
  .card-title { fill: var(--color-soil-900); font-size: 18px; font-weight: 780; }
  .card-copy { fill: var(--color-soil-700); font-size: 13px; }
  .price-copy { fill: var(--color-sun-700); font-size: 13px; font-weight: 800; letter-spacing: .025em; }
  .credit-copy { fill: var(--color-soil-600); font-size: 10px; font-weight: 800; letter-spacing: .08em; }
  .learn-more { fill: var(--color-field-700); font-size: 10.5px; font-weight: 800; }
  .work-connector { fill: none; stroke: var(--color-field-700); stroke-width: 3.5; stroke-linecap: round; }
  .connector-arrow { fill: none; stroke: var(--color-field-700); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .connector-label { fill: var(--color-soil-600); font-size: 9px; font-weight: 800; letter-spacing: .08em; }
  .diagram-legend rect { fill: #fffdf7; stroke: var(--color-soil-300); stroke-width: 1.25; }
  .diagram-legend text { fill: var(--color-soil-700); font-size: 11px; font-weight: 700; }
  .card-link:hover .component-card, .card-link:hover .engagement-card, .card-link:hover .review-card { stroke: var(--color-field-700); }
  .card-link:focus-visible { outline: none; }
  .card-link:focus-visible rect { stroke: var(--color-field-700); stroke-width: 5; }

  .mobile-stack { display: flex; flex-direction: column; gap: .75rem; padding: 1rem; }
  .mobile-review, .mobile-card { display: flex; flex-direction: column; text-decoration: none; }
  .mobile-review { gap: .35rem; padding: 1rem; border: 2px dashed var(--color-sun-600); border-radius: 10px; background: color-mix(in srgb, var(--color-sun-200) 25%, #fffdf7); }
  .mobile-review strong { color: var(--color-soil-900); font-size: 1.08rem; }
  .mobile-review p, .mobile-card p { color: var(--color-soil-700); font-size: .82rem; line-height: 1.55; }
  .mobile-layer { padding: 1rem; border: 1px solid var(--color-soil-300); border-radius: 10px; background: var(--color-soil-100); }
  .mobile-layer-name { margin-bottom: .7rem; color: var(--color-soil-600); font-size: .69rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .mobile-card { gap: .45rem; padding: 1rem; border-radius: 8px; }
  .mobile-card.component { border: 1px solid var(--color-soil-300); background: var(--color-soil-50); }
  .mobile-card.engagement { border: 2px solid var(--color-sun-600); background: #fffdf7; }
  .tool-heading { display: grid; grid-template-columns: 52px 1fr; align-items: center; gap: .75rem; }
  .mobile-card img { width: 44px; height: 44px; justify-self: center; object-fit: contain; }
  .mobile-card strong { color: var(--color-soil-900); font-size: 1rem; }
  .mobile-card > span:not(.qf-figure) { color: var(--color-soil-700); font-size: .8rem; }
  .mobile-connector { display: flex; height: 46px; flex-direction: column; align-items: center; justify-content: center; color: var(--color-soil-600); font-size: .62rem; font-weight: 800; letter-spacing: .08em; }
  .mobile-connector i { display: block; width: 8px; height: 8px; margin-top: 5px; background: var(--color-sun-500); transform: rotate(45deg); }

  @media (min-width: 768px) {
    .engagement-map { display: block; }
    .mobile-stack { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-packet { display: none; }
  }
</style>
