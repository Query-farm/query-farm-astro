---
/**
 * EngagementDiagram — where in the stack an engagement attaches.
 *
 * The consulting page's problem was that it described services in the
 * abstract while the platform page described a stack. This diagram is the
 * join: the same top-to-bottom stack PlatformDiagram draws, with the work we
 * sell attached to the layer it actually happens at.
 *
 * Two structural decisions:
 *
 *  1. **The feasibility review spans the whole stack rather than sitting in a
 *     row.** It isn't work at one layer — its output is *which layer you're
 *     in*. Drawing it as a fifth peer row would have said the opposite.
 *  2. **Rowfence's row is marked preview and priced differently.** It is the
 *     one layer where the honest offer is a design partnership, not a fixed
 *     bid, and the diagram should not flatten that into a price band.
 *
 * Same drawing idiom as PlatformDiagram and the VGI diagrams: fixed-viewBox
 * SVG on a cream card, ink strokes for context boxes, gold stroke for the
 * Query.Farm side, derived geometry (ROW_H + ROW_GAP produce every y and the
 * viewBox height), and an HTML fallback below `md` walking the same array —
 * a 1000-unit viewBox on a phone puts these labels at ~5px.
 */
import { publicExtensions } from '../../data/extensions';

const extensionCount = publicExtensions.length;

// ── Canvas ────────────────────────────────────────────────────────────────
const VB_W = 1000;
const TOP = 16;

const BAND_H = 78; // the feasibility band across the top
const BAND_GAP = 36;

const COMP_X = 152;
const COMP_W = 396;
const ENG_X = 610;
const ENG_W = 358;
const RAIL_R = 128; // rail labels right-aligned to here

const ROW_H = 106;
const ROW_GAP = 18;
const ROWS_TOP = TOP + BAND_H + BAND_GAP;

const rowY = (i: number) => ROWS_TOP + i * (ROW_H + ROW_GAP);
const VB_H = rowY(3) + ROW_H + TOP;

// Text rhythm inside a box, from its own top-left corner.
const T_X = 22;
const TITLE_DY = 34;
const META_DY = 56;
const BODY_DY = [78, 96];

interface Row {
  rail: string;
  /** The component as it exists in the platform — context, ink stroke. */
  component: { title: string; sub: string; href: string; mark?: string; badge?: string };
  /** What we build there — the Query.Farm side, gold stroke. */
  engagement: { title: string; meta: string; lines: string[]; prose: string };
}

const rows: Row[] = [
  {
    rail: 'Engine',
    component: {
      title: 'Haybarn or DuckDB',
      sub: 'The engine your team already runs',
      href: '/haybarn',
      mark: '/haybarn/haybarn-mark.svg',
    },
    engagement: {
      title: 'Production readiness',
      meta: '2–3 weeks · $15,000 fixed',
      lines: ['Pin an extension set, sign the build, write the', 'upgrade policy, hand over the review packet.'],
      prose: 'Pin an extension set, sign the build, write the upgrade policy, hand over the review packet.',
    },
  },
  {
    rail: 'Extensions',
    component: {
      title: 'DuckDB extensions',
      sub: `${extensionCount} published · loaded in-process`,
      href: '/products/extensions',
      mark: '/images/duckdb-icon.svg',
    },
    engagement: {
      title: 'A native extension',
      meta: '3–6 weeks · $18–45K',
      lines: ['For the cases that genuinely need C++ — custom', 'types, storage, or optimizer work.'],
      prose: 'For the cases that genuinely need C++ — custom types, storage, or optimizer work.',
    },
  },
  {
    rail: 'Access control',
    component: {
      title: 'Rowfence',
      sub: 'Which rows and columns a caller sees',
      href: '/products/rowfence',
      mark: '/rowfence/rowfence-icon.svg',
      badge: 'Preview',
    },
    engagement: {
      title: 'Policy design',
      meta: 'Design partner · discounted',
      lines: ['An entitlement model, row filters, and column', 'rules built against your real access rules.'],
      prose: 'An entitlement model, row filters, and column rules built against your real access rules.',
    },
  },
  {
    rail: 'Workers',
    component: {
      title: 'VGI workers',
      sub: 'Your APIs, services, databases, and models',
      href: '/vgi',
      mark: '/vgi/vgi-logo.png',
    },
    engagement: {
      title: 'Workers, in your language',
      meta: '2–8 weeks · $12–60K',
      lines: ['The cheaper answer for most connectors. No C++,', 'no build matrix, no per-release rebuilds.'],
      prose: 'The cheaper answer for most connectors — no C++, no build matrix, and no per-release rebuilds.',
    },
  },
];

// Connector from the component box to the engagement box, with a rounded elbow
// that matches the curve radius used elsewhere in the diagram family.
const connector = (y: number) => {
  const cy = y + ROW_H / 2;
  return `M${COMP_X + COMP_W} ${cy} L${ENG_X - 8} ${cy}`;
};

const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';

const ariaLabel =
  'Diagram: a five thousand dollar feasibility review spans the whole stack and establishes which layer a problem sits in. ' +
  'Below it, four layers each pair a platform component with the engagement that happens there. ' +
  'The engine layer — Haybarn or DuckDB — pairs with a two to three week production-readiness engagement at fifteen thousand dollars. ' +
  `The extension layer — ${extensionCount} published DuckDB extensions — pairs with a three to six week native extension build at eighteen to forty-five thousand dollars, for cases that genuinely need C++. ` +
  'The access-control layer — Rowfence, in preview — pairs with a discounted design-partner policy engagement. ' +
  'The worker layer — VGI workers reaching your APIs, services, databases and models — pairs with a two to eight week worker build at twelve to sixty thousand dollars, which is the cheaper answer for most connectors.';
---

<div class={`${CARD} p-4 md:p-6`}>
  <!-- ── The diagram (md and up) ────────────────────────────────────── -->
  <svg
    class="hidden h-auto w-full md:block"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-labelledby="eng-diagram-title"
  >
    <title id="eng-diagram-title">{ariaLabel}</title>

    <!-- ── The feasibility review, spanning the stack ──────────────── -->
    <g>
      <rect
        x={COMP_X} y={TOP} width={ENG_X + ENG_W - COMP_X} height={BAND_H}
        rx="12"
        class="fill-sun-400/10 stroke-sun-700"
        stroke-width="2"
        stroke-dasharray="7 5"
      />
      <text x={COMP_X + T_X} y={TOP + 32} class="fill-soil-900 text-[19px] font-semibold">
        Start with a feasibility review
      </text>
      <text x={COMP_X + T_X} y={TOP + 56} class="fill-soil-700 text-[14px]">
        $5,000 fixed. Its job is to establish which row below you are actually in.
      </text>
      <text x={ENG_X + ENG_W - T_X} y={TOP + 32} text-anchor="end" class="fill-sun-700 text-[14px] font-medium">
        Credited against the build
      </text>
      <text x={RAIL_R} y={TOP + 44} text-anchor="end" class="fill-soil-500 text-[13px]">
        Any layer
      </text>
    </g>

    <!-- Bracket from the band down the left edge of the rows -->
    <path
      d={`M${COMP_X - 18} ${TOP + BAND_H} L${COMP_X - 18} ${rowY(3) + ROW_H - 14}`}
      fill="none" class="stroke-sun-700/40" stroke-width="2" stroke-dasharray="5 5"
    />

    <!-- ── The four layers ────────────────────────────────────────── -->
    {rows.map((row, i) => {
      const y = rowY(i);
      return (
        <g>
          {/* rail label */}
          <text x={RAIL_R} y={y + ROW_H / 2 + 5} text-anchor="end" class="fill-soil-500 text-[13px]">
            {row.rail}
          </text>

          {/* the component — context, ink stroke */}
          <a href={row.component.href}>
            <rect
              x={COMP_X} y={y} width={COMP_W} height={ROW_H}
              rx="12" class="fill-soil-50 stroke-soil-300" stroke-width="2"
            />
            {row.component.mark && (
              <image
                href={row.component.mark} x={COMP_X + T_X} y={y + 20} width="26" height="26"
                preserveAspectRatio="xMidYMid meet"
              />
            )}
            <text x={COMP_X + T_X + 38} y={y + TITLE_DY + 4} class="fill-soil-900 text-[18px] font-semibold">
              {row.component.title}
            </text>
            <text x={COMP_X + T_X} y={y + META_DY + 18} class="fill-soil-700 text-[14px]">
              {row.component.sub}
            </text>
            {row.component.badge && (
              <>
                <rect
                  x={COMP_X + COMP_W - 90} y={y + 18} width="70" height="24" rx="12"
                  class="fill-sun-400/15 stroke-sun-400" stroke-width="1.5"
                />
                <text x={COMP_X + COMP_W - 55} y={y + 34} text-anchor="middle" class="fill-sun-700 text-[12px] font-medium">
                  {row.component.badge}
                </text>
              </>
            )}
          </a>

          {/* connector */}
          <path d={connector(y)} fill="none" class="stroke-soil-300" stroke-width="2.5" />
          <circle cx={ENG_X - 8} cy={y + ROW_H / 2} r="4" class="fill-sun-700" />
          <text
            x={(COMP_X + COMP_W + ENG_X) / 2} y={y + ROW_H / 2 - 10}
            text-anchor="middle" class="fill-soil-500 text-[12px]"
          >
            we build
          </text>

          {/* the engagement — ours, gold stroke */}
          <a href="#offers">
            <rect
              x={ENG_X} y={y} width={ENG_W} height={ROW_H}
              rx="12" class="fill-[#fffdf7] stroke-sun-700" stroke-width="2"
            />
            <text x={ENG_X + T_X} y={y + TITLE_DY} class="fill-soil-900 text-[18px] font-semibold">
              {row.engagement.title}
            </text>
            <text x={ENG_X + T_X} y={y + META_DY} class="fill-sun-700 text-[13.5px] font-medium qf-figure">
              {row.engagement.meta}
            </text>
            {row.engagement.lines.map((line, li) => (
              <text x={ENG_X + T_X} y={y + BODY_DY[li]} class="fill-soil-700 text-[13.5px]">
                {line}
              </text>
            ))}
          </a>
        </g>
      );
    })}
  </svg>

  <!-- ── Stacked fallback (below md) ────────────────────────────────── -->
  <div class="flex flex-col gap-3 md:hidden">
    <div class="rounded-xl border-2 border-dashed border-sun-700 bg-sun-400/10 p-4">
      <div class="text-[17px] font-semibold text-soil-900">Start with a feasibility review</div>
      <div class="qf-figure mt-1 text-[13.5px] font-medium text-sun-700">$5,000 fixed</div>
      <p class="mt-2 text-sm leading-relaxed text-soil-700">
        Establishes which of the four below you are actually in, and whether a worker would do the
        job more cheaply than an extension. Credited against the build.
      </p>
    </div>

    {rows.map((row) => (
      <div class="rounded-xl border border-soil-300 bg-soil-50 p-4">
        <div class="text-[12.5px] font-medium text-soil-500">{row.rail}</div>
        <a href={row.component.href} class="mt-1.5 flex items-center gap-2.5 no-underline">
          {row.component.mark && (
            <img src={row.component.mark} alt="" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
          )}
          <span class="text-[16px] font-semibold text-soil-900">{row.component.title}</span>
          {row.component.badge && (
            <span class="rounded-full border border-sun-400 bg-sun-400/12 px-2 py-0.5 text-[11.5px] font-medium text-sun-700">
              {row.component.badge}
            </span>
          )}
        </a>
        <p class="mt-1 text-[13.5px] text-soil-700">{row.component.sub}</p>

        <div class="mt-3.5 rounded-lg border border-sun-700 bg-[#fffdf7] p-3.5">
          <div class="text-[12px] text-soil-500">we build</div>
          <div class="mt-0.5 text-[15.5px] font-semibold text-soil-900">{row.engagement.title}</div>
          <div class="qf-figure mt-1 text-[13px] font-medium text-sun-700">{row.engagement.meta}</div>
          <p class="mt-2 text-[13.5px] leading-relaxed text-soil-700">{row.engagement.prose}</p>
        </div>
      </div>
    ))}
  </div>
</div>
