---
import type { Scenario } from '../../data/crossfield-scenarios';
interface Props { scenario: Scenario; }
const { scenario } = Astro.props;
---
<div class="reporting-outcome" data-reporting-outcome={scenario.id}>
  <figure class="interpretations" aria-labelledby={`interpretations-${scenario.id}`}>
    <h4 id={`interpretations-${scenario.id}`}>What each report means</h4>
    <dl>
      {scenario.interpretations.map(item => <div class="interpretation"><dt>{item.label}</dt><dd class="meaning">{item.meaning}</dd><dd class="answer qf-figure">{item.result}</dd></div>)}
    </dl>
    <figcaption>{scenario.comparisonCaption}</figcaption>
  </figure>
  <div class="agreed-definition">
    <h4>With Crossfield, agree on the definition and reuse it.</h4>
    <p>{scenario.outcomeRule}</p>
    <div class="agreed-result"><strong class="qf-figure">{scenario.outcomeValue}</strong><span>{scenario.outcomeLabel}</span></div>
    <p>{scenario.outcomeImpact}</p>
    <p class="boundary">The business chooses the meaning. Crossfield makes its calculation reusable and validates queries against the model’s rules.</p>
  </div>
</div>
<style>
  .reporting-outcome { display:grid; gap:2rem; margin-top:2rem; }
  .reporting-outcome > * { min-width:0; }
  figure { margin:0; }
  h4 { margin:0; font-family:var(--font-display); font-size:1.55rem; line-height:1.3; }
  dl { margin-top:1.25rem; border-top:1px solid var(--color-soil-300); }
  .interpretation { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.35rem 1rem; padding:1.2rem 0; border-bottom:1px solid var(--color-soil-300); }
  dt { font-size:.9375rem; font-weight:600; }
  dd { margin:0; }
  .meaning { grid-column:1; color:var(--color-soil-700); font-size:.875rem; line-height:1.65; }
  .answer { grid-column:2; grid-row:1 / 3; align-self:center; font-size:clamp(1.6rem,3vw,2.3rem); color:var(--color-soil-900); }
  figcaption { margin-top:1rem; color:var(--color-soil-700); font-size:.8125rem; line-height:1.7; }
  .agreed-definition { align-self:start; border-top:4px solid var(--color-field-700); padding:1.6rem; background:#f0f3e9; }
  .agreed-definition p { color:var(--color-soil-700); font-size:.9375rem; line-height:1.8; margin-top:1rem; }
  .agreed-result { display:flex; align-items:center; gap:1.25rem; margin-top:1.5rem; padding-block:1.2rem; border-block:1px solid #b7c4a4; }
  .agreed-result strong { font-size:2.75rem; line-height:1.1; color:var(--color-field-700); }
  .agreed-result > span { max-width:23ch; font-size:.9375rem; line-height:1.6; font-weight:600; }
  .agreed-definition .boundary { font-size:.8125rem; }
  @media(min-width:900px) { .reporting-outcome { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:3.5rem; } }
  @media(max-width:450px) { .agreed-definition { padding:1.2rem; } .agreed-result { flex-direction:column; align-items:start; gap:.7rem; } .interpretation { gap:.4rem .75rem; } }
</style>
