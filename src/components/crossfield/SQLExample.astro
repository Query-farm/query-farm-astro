---
interface Props { summary: string; purpose: string; language?: string; }
const { summary, purpose, language = 'SQL' } = Astro.props;
---
<details class="sql-example">
  <summary>{summary}<span aria-hidden="true">{language}</span></summary>
  <div class="sql-example-body"><p class="sql-purpose">{purpose}</p><slot /></div>
</details>
<style>
  .sql-example { border-block: 1px solid var(--color-soil-300); margin-block: 1.3rem; min-width: 0; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; color: var(--color-field-700); padding-block: 1rem; font-size: .875rem; font-weight: 500; }
  summary::before { content: '+'; font-family: var(--font-mono); }
  details[open] summary::before { content: '−'; }
  summary span { margin-left: auto; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .06em; color: var(--color-soil-700); }
  summary:focus-visible { outline: 2px solid var(--color-field-700); outline-offset: 4px; }
  .sql-example-body { padding-bottom: 1.1rem; }
  .sql-purpose { font-size: .875rem; line-height: 1.75; color: var(--color-soil-700); margin: 0 0 1rem; }
  .sql-example-body :global(pre) { max-height: 38rem; overflow: auto; }
  @media(max-width:640px) {
    .sql-example-body :global(.code-toolbar-button) { min-width: 44px; min-height: 44px; }
    .sql-example-body :global(.code-block-controls) { flex-shrink: 0; }
  }
</style>
