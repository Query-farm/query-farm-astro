---
interface Props { kind: 'composition' | 'revision' | 'explain'; }
const { kind } = Astro.props;
const content = {
  composition: {
    label: 'Portfolio exposure and risk limits are computed separately and joined by issuer',
    source: 'Two teams. One shared issuer identity.',
    left: ['Portfolio model', 'Gross exposure', 'Select the approved positions. Aggregate by issuer.'],
    right: ['Limits model', 'Gross exposure limit', 'Select the applicable limits. Aggregate by issuer.'],
    result: 'Issuer · gross exposure · gross limit',
    note: 'Join the computed results through an explicitly shared dimension. Missing limits remain NULL.',
  },
  revision: {
    label: 'Two model revisions over identical positions: current gross exposure 23 million, proposed gross exposure 28 million',
    source: 'Identical position records · January 31 close',
    left: ['Current · revision 1', '$23m gross', 'Include Book A and Book B.'],
    right: ['Proposed · revision 2', '$28m gross', 'Also include the Expansion book.'],
    result: '+$5m from the proposed reporting scope',
    note: 'The formula and source rows stay the same. The model revision changes which book is included.',
  },
  explain: {
    label: 'Select the approved January 31 positions, then compute gross and net exposure by issuer',
    source: 'Positions · January 31 close · Book A and Book B',
    left: ['Gross exposure', 'Sum absolute values', 'Atlas: |+$12m| + |−$8m|'],
    right: ['Net exposure', 'Sum signed values', 'Atlas: +$12m − $8m'],
    result: 'Atlas · $20m gross · $4m net',
    note: 'The expanded SQL shows the date and book filter, both formulas, and the grouping by issuer.',
  },
}[kind];
---
<figure class="finance-flow" aria-label={content.label}>
  <div class="source">{content.source}</div>
  <div class="fork" aria-hidden="true"><span></span><span></span></div>
  <div class="branches">
    {[content.left, content.right].map(branch => <div class="branch"><span class="label">{branch[0]}</span><strong>{branch[1]}</strong><p>{branch[2]}</p></div>)}
  </div>
  <div class="fork merge" aria-hidden="true"><span></span><span></span></div>
  <div class="result">{content.result}</div>
  <figcaption>{content.note}</figcaption>
</figure>
<style>
  .finance-flow { min-width: 0; margin: 0; font-family: var(--font-sans); }
  .source,.result { padding: 1.1rem; border: 1px solid var(--color-field-700); border-radius: .5rem; background: #f0f3e9; text-align: center; font-size: .9375rem; line-height: 1.6; }
  .source { background: #fffdf7; }
  .branches { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .branch { min-width: 0; border: 1px solid var(--color-soil-300); border-top: 3px solid var(--color-field-700); border-radius: .35rem; padding: 1.15rem; background: #fffdf7; }
  .branch + .branch { border-top-color: var(--color-sun-700); }
  .label { color: var(--color-soil-700); font-size: .8125rem; }
  strong { display: block; margin-top: .6rem; font-family: var(--font-display); font-size: 1.45rem; line-height: 1.3; }
  p,figcaption { margin: .7rem 0 0; font-size: .8125rem; line-height: 1.7; color: var(--color-soil-700); }
  .fork { display: flex; width: 52%; height: 2rem; margin-inline: auto; }
  .fork span { width: 50%; border-left: 1px solid var(--color-field-700); border-bottom: 1px solid var(--color-field-700); height: 1rem; transform: scaleY(-1); margin-top: 1rem; }
  .fork span + span { border-left: 0; border-right: 1px solid var(--color-field-700); }
  .merge { transform: rotate(180deg); }
  @media(max-width:380px) { .branches { gap: .5rem; } .branch { padding: .8rem; } strong { font-size: 1.2rem; } }
</style>
