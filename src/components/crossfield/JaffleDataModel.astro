---
interface Props {
  showKeys?: boolean;
}
const { showKeys = false } = Astro.props;
const tables = [
  { name: 'orders', meaning: 'One customer purchase, with a date, store, subtotal, tax, and total.' },
  { name: 'items', meaning: 'One line on an order, identifying a product. An order can have several lines.' },
  { name: 'stores', meaning: 'One store, with its ID and name.' },
  { name: 'customers', meaning: 'One customer, with their ID and name.' },
  { name: 'products', meaning: 'One product, with its SKU, name, category, and price.' },
];
---

<div class="shop-data" data-jaffle-data-model>
  <table>
    <caption>The shop’s five source tables</caption>
    <thead>
      <tr><th scope="col">Table</th><th scope="col">What one row represents</th></tr>
    </thead>
    <tbody>
      {tables.map(table => (
        <tr><th scope="row"><code>{table.name}</code></th><td>{table.meaning}</td></tr>
      ))}
    </tbody>
  </table>
  {showKeys && (
    <p class="shop-keys">
      Each order points to a store through <code>orders.store_id → stores.id</code>
      and a customer through <code>orders.customer_id → customers.id</code>.
      Each line points to its order through <code>items.order_id → orders.id</code>
      and a product through <code>items.sku → products.sku</code>.
    </p>
  )}
</div>

<style>
  .shop-data { min-width: 0; }
  .shop-data table { display: table; width: 100%; margin-block: 1.25rem 0; border-collapse: collapse; font-size: .875rem; line-height: 1.6; }
  .shop-data caption { padding-bottom: .65rem; color: var(--color-soil-700); font-size: .75rem; text-align: left; }
  .shop-data th, .shop-data td { min-width: 0; padding: .7rem .65rem; border: 0; border-bottom: 1px solid var(--color-soil-300); vertical-align: top; text-align: left; }
  .shop-data thead th { background: var(--color-soil-100); font-size: .75rem; font-weight: 500; }
  .shop-data tbody th { width: 7rem; background: transparent; font-weight: 400; }
  .shop-data td { color: var(--color-soil-700); }
  .shop-data code { padding: 0; background: transparent; font-size: .85em; overflow-wrap: anywhere; }
  .shop-keys { margin-top: 1.1rem; color: var(--color-soil-700); font-size: .875rem; line-height: 1.8; }
</style>
