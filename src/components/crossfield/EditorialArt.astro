---
interface Props {
  variant: 'connected-fields' | 'definition-revisions' | 'governed-paths';
}
const { variant } = Astro.props;
---
<div class:list={['editorial-art', variant]} aria-hidden="true">
  <img src={`/crossfield/art/${variant}.webp`} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
</div>
<style>
  .editorial-art { width: 100%; min-width: 0; overflow: hidden; }
  .editorial-art img { display: block; width: 100%; height: auto; }
  .connected-fields { border-radius: 50% 50% 0 0 / 10% 10% 0 0; }
  .definition-revisions { border-radius: .3rem; }
  .governed-paths { border-radius: 50% 50% 0 0 / 15% 15% 0 0; }
</style>
