---
import type { Scenario } from '../../data/crossfield-scenarios';
interface Props { scenario: Scenario; }
const { scenario: s } = Astro.props;
---
      <figure class="revision-diagram" aria-labelledby={`revision-caption-${s.id}`}>
        <div class="diagram-heading"><strong>Two model revisions. One DuckDB connection.</strong><span>{s.label} · Checked example</span></div>
        <div class="source-snapshot">
          <svg viewBox="0 0 56 64" aria-hidden="true" focusable="false"><path d="M7 13v36c0 6 42 6 42 0V13M7 31c0 6 42 6 42 0M7 43c0 6 42 6 42 0"/><ellipse cx="28" cy="13" rx="21" ry="7"/></svg>
          <div><strong>{s.revision.source}</strong><span>{s.revision.sourceDetail}</span></div>
        </div>
        <div class="fork" aria-hidden="true"><svg viewBox="0 0 1000 48" preserveAspectRatio="none"><path d="M500 0V20H245V46M500 20H755V46M239 38l6 8 6-8M749 38l6 8 6-8"/></svg></div>
        <div class="catalog-pair">
          <div class="catalog current">
            <div class="catalog-header"><span>Current definition</span><span class="revision-label">Revision <span class="qf-figure">1</span></span></div>
            <div class="catalog-body"><code>{s.attachment}.<wbr />{s.model}</code><h3>{s.revision.current.rule}</h3><p>{s.revision.current.detail}</p></div>
            <div class="catalog-result"><strong class="qf-figure">{s.revision.current.result}</strong><span>{s.revision.current.resultDetail}</span></div>
          </div>
          <div class="catalog proposed">
            <div class="catalog-header"><span>Proposed definition</span><span class="revision-label">Revision <span class="qf-figure">2</span></span></div>
            <div class="catalog-body"><code>{s.revision.proposed.catalog}.<wbr />{s.model}</code><h3>{s.revision.proposed.rule}</h3><p>{s.revision.proposed.detail}</p></div>
            <div class="catalog-result"><strong class="qf-figure">{s.revision.proposed.result}</strong><span>{s.revision.proposed.resultDetail}</span></div>
          </div>
        </div>
        <div class="merge" aria-hidden="true"><svg viewBox="0 0 1000 40" preserveAspectRatio="none"><path d="M245 0V18H755V0M500 18V38M494 30l6 8 6-8"/></svg></div>
        <div class="revision-impact"><div><strong class="qf-figure">{s.revision.change}</strong><span>{s.revision.changeUnit}</span></div><p>{s.revision.impact}</p></div>
        <figcaption id={`revision-caption-${s.id}`}>Both definitions remain queryable under separate catalog names. Compare their results with ordinary SQL in semantic mode. <a href={`${s.guide}#review-a-model-revision`}>Run this revision comparison →</a></figcaption>
      </figure>
<style>
  a { color:var(--color-link); text-decoration:underline; text-underline-offset:4px; }
  .revision-diagram { margin:2.5rem 0 0; padding:1.75rem; border:1px solid var(--color-soil-300); border-radius:.5rem; background:#fffdf7; }
  .diagram-heading { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:.5rem 1rem; padding-bottom:1.25rem; border-bottom:1px solid var(--color-soil-300); }
  .diagram-heading strong { font-size:1rem; font-weight:600; }
  .diagram-heading > span { font-size:.75rem; color:var(--color-soil-700); }
  .source-snapshot { display:flex; justify-content:center; align-items:center; gap:1rem; margin:1.5rem auto 0; max-width:760px; }
  .source-snapshot svg { width:48px; height:56px; flex:none; stroke:var(--color-field-700); stroke-width:1.6; fill:#edf0e5; }
  .source-snapshot strong { display:block; font-size:1rem; line-height:1.6; font-weight:600; }
  .source-snapshot span { display:block; margin-top:.25rem; font-size:.8125rem; line-height:1.7; color:var(--color-soil-700); }
  .fork { height:48px; }
  .merge { height:40px; }
  .fork svg,.merge svg { width:100%; height:100%; fill:none; stroke:var(--color-field-700); }
  .fork path,.merge path { stroke-width:1.5; vector-effect:non-scaling-stroke; }
  .catalog-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; }
  .catalog { min-width:0; display:flex; flex-direction:column; border:1px solid var(--color-field-700); border-radius:.35rem; overflow:hidden; }
  .proposed { border-color:var(--color-sun-700); }
  .catalog-header { display:flex; justify-content:space-between; flex-wrap:wrap; gap:.5rem; padding:.85rem 1.25rem; background:#edf0e5; border-bottom:1px solid var(--color-field-700); font-size:.8125rem; font-weight:600; }
  .proposed .catalog-header { background:#f7edda; border-color:var(--color-sun-700); }
  .revision-label { font-weight:400; }
  .catalog-body { padding:1.25rem; flex:1; }
  .catalog-body code { font-size:.8125rem; overflow-wrap:anywhere; color:var(--color-soil-700); }
  .catalog-body h3 { margin-top:.75rem; font-size:1.5rem; line-height:1.25; }
  .catalog-body p { margin-top:.6rem; font-size:.875rem; line-height:1.75; color:var(--color-soil-700); }
  .catalog-result { display:flex; align-items:center; gap:1rem; padding:1rem 1.25rem; border-top:1px solid var(--color-soil-300); }
  .catalog-result strong { font-size:clamp(2rem,3.5vw,3rem); line-height:1.2; }
  .catalog-result span { max-width:22ch; font-size:.8125rem; line-height:1.6; color:var(--color-soil-700); }
  .revision-impact { display:flex; align-items:center; gap:2rem; padding:1.25rem 1.5rem; background:#edf0e5; border:1px solid var(--color-field-700); border-radius:.35rem; }
  .revision-impact > div { min-width:150px; }
  .revision-impact strong { display:block; font-size:2.5rem; line-height:1.25; }
  .revision-impact span { font-size:.8125rem; }
  .revision-impact p { font-size:.9375rem; line-height:1.75; max-width:70ch; }
  figcaption { margin-top:1.25rem; font-size:.8125rem; line-height:1.8; color:var(--color-soil-700); }
  figcaption a { display:inline-block; }
  @media(max-width:600px) {
    .revision-diagram { padding:1rem; }
    .catalog-pair { grid-template-columns:1fr; margin-top:1.5rem; gap:1rem; border-left:1px solid var(--color-field-700); padding-left:.75rem; }
    .fork,.merge { display:none; }
    .source-snapshot { align-items:start; gap:.75rem; }
    .source-snapshot svg { width:36px; height:46px; }
    .catalog-header,.catalog-body,.catalog-result { padding:1rem; }
    .catalog-result { flex-wrap:wrap; gap:.5rem 1rem; }
    .catalog-body h3 { font-size:1.35rem; }
    .revision-impact { display:block; padding:1rem; margin-top:1rem; }
    .revision-impact p { margin-top:.75rem; }
  }
</style>
