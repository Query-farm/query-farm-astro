---
const steps = [
  ['Original request', 'Resolve approved definitions and retain the semantic intent.', 'Parse and prepare the statement.'],
  ['Binding', 'Check selected scalar definitions, casts and the resulting plan.', 'Resolve tables, functions, overloads and types.'],
  ['Execution', 'Validate the governing context and data-dependent contracts.', 'Optimize and run native operators against live sources.'],
  ['Prepared reuse', 'Reject stale attachment identity or require revalidation.', 'Reuse or rebind the prepared statement through native APIs.'],
];
---
<figure class="lifecycle" aria-label="Crossfield and DuckDB responsibilities across the query lifecycle">
  <div class="lane-head"><span>Boundary</span><strong>Crossfield extension</strong><strong>DuckDB engine</strong></div>
  {steps.map(([name, semantic, engine]) => <div class="lane"><span>{name}</span><p>{semantic}</p><p>{engine}</p></div>)}
  <figcaption>Generic hooks connect the two. Business definitions and approval rules stay in Crossfield; DuckDB supplies native query processing.</figcaption>
</figure>
<style>
  .lifecycle { border: 1px solid var(--color-soil-300); border-radius: .65rem; overflow: hidden; }
  .lane-head,.lane { display: grid; grid-template-columns: minmax(0,.65fr) minmax(0,1fr) minmax(0,1fr); gap: 1.1rem; padding: 1rem 1.25rem; }
  .lane-head { background: var(--color-soil-200); font-size: .85rem; }
  .lane { border-top: 1px solid var(--color-soil-300); align-items: start; font-size: .85rem; line-height: 1.7; }
  .lane > span { font-weight: 600; color: var(--color-field-700); }
  .lane p { margin: 0; }
  figcaption { padding: 1rem 1.25rem; background: var(--color-soil-100); font-size: .75rem; line-height: 1.7; color: var(--color-soil-700); }
  @media(max-width:600px) { .lane-head { grid-template-columns: 1fr 1fr; } .lane-head > span { display: none; } .lane { grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .5rem 1rem; } .lane > span { grid-column: 1/-1; } }
</style>
