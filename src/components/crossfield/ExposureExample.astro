  .position-name { display: flex; align-items: center; gap: .75rem; font-size: .875rem; line-height: 1.5; }
  .position-name strong { font-weight: 600; }
  .position-name small { display: block; color: var(--color-soil-700); font-size: .8125rem; }
  .position-mark { display: block; flex: 0 0 auto; width: .7rem; height: 1.7rem; }
  .long { background: var(--color-field-700); }
  .short { background: var(--color-sun-700); }
  .position-value { flex: 0 0 auto; font-size: 1.55rem; line-height: 1.2; }
  .exposure-measures { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; margin-top: 1.2rem; }
  .measure { min-width: 0; padding: 1.15rem; border: 1px solid var(--color-soil-300); border-radius: .4rem; background: var(--color-soil-100); }
  .measure-name { display: block; font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; letter-spacing: -.022em; line-height: 1.3; }
  .measure-value { display: block; margin-top: .55rem; font-size: 2.35rem; line-height: 1.15; }
  .measure-bar { display: flex; height: .7rem; margin-block: 1rem; background: #fffdf7; outline: 1px solid var(--color-soil-300); }
  .gross-long { width: 60%; background: var(--color-field-700); }
  .gross-short { width: 40%; background: var(--color-sun-700); border-left: 2px solid var(--color-soil-100); }
  .net-long { width: 20%; background: var(--color-field-700); }
  .measure-formula { display: block; font-size: .9375rem; line-height: 1.6; }
  .exposure-example .measure p { margin: .6rem 0 0; color: var(--color-soil-700); font-size: .8125rem; line-height: 1.65; }
