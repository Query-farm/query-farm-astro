---
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const steps = [
  { title: 'Discover', detail: 'Read approved definitions and accepted inputs.', icon: 'discover' },
  { title: 'Ask', detail: 'Choose metrics, dimensions and a scope.', icon: 'ask' },
  { title: 'Check', detail: 'Validate the request and inspect its meaning.', icon: 'check' },
  { title: 'Execute', detail: 'Run the approved request through DuckDB.', icon: 'execute' },
];
---

<figure class:list={['agent-workflow', { 'on-dark': dark }]} aria-label="AI agent workflow: discover definitions, ask a question, check its meaning, and execute the approved request; rejected requests return for review">
  <ol class="workflow-path">
    {steps.map((step, index) => <li>
      <div class="workflow-stop" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          {step.icon === 'discover' && <><path d="M10 10H22C25 10 27 12 27 15V38C27 35 25 33 22 33H10Z" /><path d="M27 15C27 12 29 10 32 10H39V33H32C29 33 27 35 27 38" /><path d="M14 17H21M14 23H21M32 17H35M32 23H35" /></>}
          {step.icon === 'ask' && <><path d="M10 10H38V31H24L16 39V31H10Z" /><path d="M16 17H32M16 23H27" /></>}
          {step.icon === 'check' && <><circle cx="22" cy="22" r="12" /><path d="M31 31L39 39M16 22L20 26L28 18" /></>}
          {step.icon === 'execute' && <><path d="M10 9H38V39H10Z" /><path d="M10 18H38M20 18V39M10 28H38" /><path d="M15 13H33" /></>}
        </svg>
        <span class="stop-number qf-figure">{index + 1}</span>
      </div>
      <div class="workflow-copy"><strong>{step.title}</strong><span>{step.detail}</span></div>
    </li>)}
  </ol>
  <div class="workflow-repair">
    <svg class="repair-path" viewBox="0 0 800 74" preserveAspectRatio="none" aria-hidden="true" fill="none"><path d="M500 0V29Q500 44 485 44H315Q300 44 300 29V5" /><path d="M294 13L300 5L306 13" /></svg>
    <p><span class="repair-symbol" aria-hidden="true">↶</span><strong>If the request is rejected:</strong> revise it without changing the question, or ask the model owner for a definition.</p>
  </div>
  <figcaption>The model supplies a contract the AI agent can inspect. Repair requires a supported alternative; a rejection does not authorize changing the business meaning.</figcaption>
</figure>

<style>
  .agent-workflow { --workflow-ink: var(--color-soil-900); --workflow-muted: var(--color-soil-700); --workflow-line: var(--color-soil-400); --workflow-accent: var(--color-field-700); --workflow-paper: #fffdf7; --workflow-note: var(--color-soil-100); container-type: inline-size; margin: 0; color: var(--workflow-ink); font-family: var(--font-sans); }
  .agent-workflow.on-dark { --workflow-ink: #f4ece0; --workflow-muted: #d1c8b7; --workflow-line: #8f9b79; --workflow-accent: #c6d6b1; --workflow-paper: #28341f; --workflow-note: #26301e; }
  .workflow-path { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1.25rem; list-style: none !important; padding: 0 !important; margin: 0 !important; }
  .workflow-path li { position: relative; min-width: 0; margin: 0 !important; padding: 0 !important; }
  .workflow-path li:not(:last-child)::after { content: ''; position: absolute; width: calc(100% - 4rem); height: 1px; top: 2.4rem; left: 5.25rem; background: var(--workflow-line); }
  .workflow-path li:not(:last-child)::before { content: ''; position: absolute; top: 2.22rem; right: -.55rem; width: .4rem; height: .4rem; border-right: 1px solid var(--workflow-line); border-top: 1px solid var(--workflow-line); transform: rotate(45deg); }
  .workflow-stop { position: relative; display: grid; place-items: center; width: 4.75rem; height: 4.75rem; border: 1px solid var(--workflow-line); border-radius: 50%; background: var(--workflow-paper); }
  .workflow-stop svg { width: 2.8rem; height: 2.8rem; stroke: var(--workflow-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .stop-number { position: absolute; bottom: -.1rem; right: -.05rem; width: 1.3rem; height: 1.3rem; border-radius: 50%; display: grid; place-items: center; background: var(--workflow-accent); color: var(--workflow-paper); font-size: .65rem; }
  .workflow-copy { margin-top: 1rem; }
  .workflow-copy strong { display: block; color: var(--workflow-ink); font-size: 1rem; line-height: 1.4; }
  .workflow-copy > span { display: block; margin-top: .5rem; color: var(--workflow-muted); font-size: .8125rem; line-height: 1.7; }
  .workflow-repair { position: relative; margin-top: .8rem; }
  .repair-path { width: 100%; height: 3.2rem; stroke: var(--workflow-line); stroke-width: 1.25; stroke-dasharray: 4 4; }
  .repair-path path + path { stroke-dasharray: none; }
  .workflow-repair p { margin: 0 !important; padding: 1rem 1.2rem; border: 1px dashed var(--workflow-line); background: var(--workflow-note); border-radius: .45rem; color: var(--workflow-muted); font-size: .8125rem; line-height: 1.75; }
  .workflow-repair strong { color: var(--workflow-ink); font-weight: 600; }
  .repair-symbol { color: var(--workflow-accent); font-size: 1.25rem; margin-right: .45rem; }
  figcaption { margin-top: 1rem; color: var(--workflow-muted); font-size: .75rem; line-height: 1.7; }
  @container(max-width:600px) {
    .workflow-path { grid-template-columns: 1fr; gap: 1.4rem; }
    .workflow-path li { display: grid; grid-template-columns: 3.6rem minmax(0,1fr); gap: 1rem; align-items: start; }
    .workflow-stop { width: 3.5rem; height: 3.5rem; }
    .workflow-stop svg { width: 2.2rem; height: 2.2rem; }
    .workflow-copy { margin-top: .15rem; }
    .workflow-copy > span { margin-top: .25rem; }
    .workflow-path li:not(:last-child)::after { width: 1px; height: calc(100% - 2.6rem); top: 3.85rem; left: 1.75rem; }
    .workflow-path li:not(:last-child)::before { top: auto; bottom: -.75rem; left: 1.57rem; right: auto; transform: rotate(135deg); }
    .workflow-repair { margin-top: 1.6rem; }
    .repair-path { display: none; }
  }
</style>
