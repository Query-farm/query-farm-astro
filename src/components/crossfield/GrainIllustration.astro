---
const lines = ['A', 'B', 'C'];
---

<figure class="grain-figure" aria-label="Illustrative order: a thirty-dollar subtotal must count once even when the order has three receipt lines">
  <div class="grain-origin">
    <div class="order-ticket">
      <span class="ticket-label">One purchase</span>
      <strong class="qf-figure">$30</strong>
      <span class="ticket-foot">Order subtotal</span>
      <span class="ticket-perforation" aria-hidden="true"></span>
    </div>
    <div class="origin-connection" aria-hidden="true">
      <svg viewBox="0 0 120 76" fill="none"><path d="M4 38H48M48 12V64M48 12H115M48 38H115M48 64H115" /><circle cx="48" cy="38" r="4" /></svg>
    </div>
    <div class="receipt-lines" aria-label="Three receipt lines belonging to that order">
      {lines.map(line => <div class="receipt-line"><span class="receipt-mark" aria-hidden="true"></span><span>Receipt line {line}</span></div>)}
    </div>
  </div>

  <div class="grain-fork" aria-hidden="true"><span></span><span></span></div>

  <div class="grain-outcomes">
    <div class="grain-path repeated">
      <p class="path-label">Sum after a raw join</p>
      <div class="repeated-rows" aria-label="The same thirty-dollar subtotal is repeated on all three joined rows">
        {lines.map(line => <div class="joined-row"><span class="amount qf-figure">$30</span><span class="row-link" aria-hidden="true"></span><span>Line {line}</span></div>)}
      </div>
      <div class="path-answer"><strong class="qf-figure">$90</strong><span>The subtotal counted three times.</span></div>
    </div>
    <div class="grain-path preserved">
      <p class="path-label">Keep each measure’s grain</p>
      <div class="preserved-values">
        <div class="revenue-value"><span>Order revenue</span><strong class="qf-figure">$30</strong><span class="revenue-bar" aria-hidden="true"></span></div>
        <div class="line-value"><span>Receipt-line count</span><div class="line-dots" aria-hidden="true"><i></i><i></i><i></i></div><strong class="qf-figure">3</strong></div>
      </div>
      <div class="path-answer"><strong class="qf-figure">$30</strong><span>Revenue counted once; lines counted separately.</span></div>
    </div>
  </div>
  <figcaption>Illustrative single order, separate from the shop dataset. The model records what each row represents so an item count does not multiply order revenue.</figcaption>
</figure>

<style>
  .grain-figure { container-type: inline-size; margin: 0; color: var(--color-soil-900); font-family: var(--font-sans); }
  .grain-origin { display: grid; grid-template-columns: minmax(0,1fr) minmax(3rem,.65fr) minmax(0,1fr); align-items: center; max-width: 570px; margin-inline: auto; }
  .order-ticket { position: relative; padding: 1.2rem 1rem 1.5rem; border: 1px solid var(--color-soil-300); background: #fffdf7; box-shadow: .35rem .35rem 0 var(--color-soil-200); text-align: center; }
  .ticket-label,.ticket-foot { display: block; font-size: .75rem; line-height: 1.5; color: var(--color-soil-700); }
  .order-ticket strong { display: block; margin-block: .45rem; font-size: 2.1rem; line-height: 1.15; }
  .ticket-perforation { position: absolute; bottom: .55rem; left: .6rem; right: .6rem; border-bottom: 2px dotted var(--color-soil-300); }
  .origin-connection svg { width: 100%; height: auto; stroke: var(--color-soil-400); stroke-width: 1.5; }
  .origin-connection circle { fill: var(--color-field-700); stroke: none; }
  .receipt-lines { display: grid; gap: .45rem; }
  .receipt-line { display: flex; align-items: center; gap: .55rem; border: 1px solid var(--color-soil-300); background: var(--color-soil-100); padding: .6rem .7rem; font-size: .75rem; line-height: 1.4; }
  .receipt-mark { width: .85rem; height: .85rem; flex: 0 0 auto; border: 1px solid var(--color-sun-700); background: #e9d5aa; }
  .grain-fork { display: grid; grid-template-columns: 1fr 1fr; margin: 1.4rem 25% 0; height: 1.75rem; }
  .grain-fork span { border-top: 1px solid var(--color-soil-400); }
  .grain-fork span:first-child { border-left: 1px solid var(--color-soil-400); }
  .grain-fork span:last-child { border-right: 1px solid var(--color-soil-400); }
  .grain-outcomes { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.25rem; }
  .grain-path { padding: 1.1rem 1.2rem; border: 1px solid var(--color-soil-300); border-radius: .5rem; background: #fffdf7; }
  .preserved { border-color: var(--color-field-700); background: #f0f3e9; }
  .path-label { margin: 0 0 1rem; font-size: .8125rem; font-weight: 600; line-height: 1.5; }
  .repeated-rows { display: grid; gap: .4rem; }
  .joined-row { display: grid; grid-template-columns: minmax(0,1fr) .75rem minmax(0,1fr); align-items: center; font-size: .75rem; }
  .joined-row > span:first-child,.joined-row > span:last-child { padding: .4rem; border: 1px solid var(--color-soil-300); background: var(--color-soil-100); text-align: center; }
  .joined-row .amount { border-color: var(--color-soil-400) !important; background: #e9d5aa !important; font-weight: 600; }
  .row-link { height: 1px; background: var(--color-soil-400); }
  .preserved-values { min-height: 7.15rem; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 1rem; align-items: center; }
  .preserved-values > div { min-width: 0; }
  .preserved-values span { display: block; font-size: .7rem; line-height: 1.45; }
  .preserved-values strong { display: block; margin-top: .45rem; font-size: 1.55rem; line-height: 1.3; }
  .revenue-bar { height: .55rem; width: 100%; max-width: 5rem; background: var(--color-field-700); margin-top: .6rem; }
  .line-value { padding-left: 1rem; border-left: 1px solid var(--color-soil-300); }
  .line-dots { display: flex; gap: .3rem; margin-top: .6rem; }
  .line-dots i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-field-700); }
  .line-value strong { font-size: 1.05rem; }
  .path-answer { display: flex; align-items: center; gap: 1rem; padding-top: 1rem; margin-top: 1rem; border-top: 1px solid var(--color-soil-300); }
  .path-answer strong { flex: 0 0 auto; font-size: 1.8rem; line-height: 1.2; }
  .preserved .path-answer strong { color: var(--color-field-700); }
  .path-answer > span { color: var(--color-soil-700); font-size: .75rem; line-height: 1.6; }
  figcaption { margin-top: 1.1rem; color: var(--color-soil-700); font-size: .75rem; line-height: 1.7; }
  @container(max-width:520px) { .grain-outcomes { gap: .65rem; } .grain-path { padding: .85rem .65rem; } .path-label { min-height: 2.5rem; font-size: .75rem; } .path-answer { display: block; } .path-answer > span { display: block; margin-top: .45rem; } .preserved-values { gap: .5rem; } .line-value { padding-left: .5rem; } .preserved-values span { font-size: .65rem; } .line-dots { gap: .2rem; } .receipt-line { padding: .5rem .4rem; font-size: .65rem; gap: .35rem; } .order-ticket { padding-inline: .55rem; } }
  @container(max-width:420px) {
    .grain-origin { grid-template-columns: 6rem 2rem minmax(0,1fr); }
    .receipt-line { font-size: .8125rem; padding: .6rem .5rem; }
    .grain-fork { display: none; }
    .grain-outcomes { grid-template-columns: 1fr; gap: 1rem; margin-top: 1.5rem; }
    .grain-path { padding: 1.15rem; }
    .path-label { min-height: 0; font-size: .875rem; }
    .joined-row { font-size: .8125rem; }
    .preserved-values span,.path-answer > span { font-size: .8125rem; }
    .path-answer { display: flex; }
    .path-answer > span { margin-top: 0; }
  }
</style>
