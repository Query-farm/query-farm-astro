---
import { topicCurves } from '../../lib/blog-curves';

interface Props {
  /** A stable section identity gives every placement its own drawing. */
  section: string;
}
const { section } = Astro.props;
const seed = Array.from(section).reduce((value, character) =>
  (Math.imul(value, 31) + character.charCodeAt(0)) >>> 0, 0);
// Reuse the site's seeded contour generator. Parallel offsets keep the furrows
// from crossing, while each section gets its own phases and accent placement.
const contour = topicCurves(`crossfield-${section}`, {
  width: 640, height: 28, count: 1, amplitude: 0.7,
})[0].d;
const count = 3 + ((seed >>> 8) % 2);
const offsets = Array.from({ length: count }, (_, i) => 20 + i * 12 / (count - 1));
const accentStart = 0.05 + (seed % 60) / 100;
const accentLength = 0.18 + ((seed >>> 16) % 13) / 100;
---
<svg class="chapter-ornament" viewBox="0 0 640 64" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="accent" fill="none" d={contour} transform="translate(0 6)" pathLength="1"
    stroke-dasharray={`0 ${accentStart} ${accentLength} 1`} stroke-width={6 + ((seed >>> 24) % 3)} />
  <g class="furrows" fill="none" stroke-width="1.5">
    {offsets.map(offset => <path d={contour} transform={`translate(0 ${offset})`} />)}
  </g>
</svg>
<style>
  .chapter-ornament { display: block; width: 100%; height: 3.5rem; margin-bottom: 1.5rem; overflow: visible; }
  path { fill: none; }
  .furrows path { vector-effect: non-scaling-stroke; }
  .furrows { stroke: var(--color-field-700); }
  .accent { stroke: var(--color-sun-400); }
</style>
