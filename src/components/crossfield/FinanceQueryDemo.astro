---
import CodeBlock from '../ui/CodeBlock.astro';
import SQLExample from './SQLExample.astro';
import queries from '../../../public/crossfield/examples/finance/queries.json';
const views = [
  { id: 'issuer', label: 'By issuer', headers: ['issuer', 'gross_exposure', 'net_exposure'], rows: [['Atlas','20,000,000','4,000,000'],['Boreal','3,000,000','3,000,000']], sql: queries.issuer },
  { id: 'total', label: 'Overall totals', headers: ['gross_exposure','net_exposure'], rows: [['23,000,000','7,000,000']], sql: queries.total },
];
---
<div class="finance-demo" data-finance-demo>
  <div class="demo-heading"><span>Cash-equity portfolio · Precomputed results</span><p>The same definitions, by issuer or overall.</p></div>
  <p class="demo-note">January 31 close · Book A and Book B · USD.<br /><a href="/products/crossfield/docs/trading">View the source rows and runnable setup →</a></p>
  <div class="demo-controls" data-finance-controls hidden role="group" aria-label="Choose example grouping">
    {views.map((view,i) => <button type="button" data-finance-view={view.id} aria-pressed={i===0?'true':'false'} aria-controls={`finance-${view.id}-example`}>{view.label}</button>)}
  </div>
  {views.map((view,i) => <div id={`finance-${view.id}-example`} class="demo-panel" data-finance-panel={view.id} hidden={i!==0}>
    <p class="table-hint" hidden>Scroll the table sideways to see all columns.</p>
    <div class="result-scroll" tabindex="0" role="region" aria-label={`Expected results: ${view.label}`}>
      <table><caption>Independently checked results · USD</caption><thead><tr>{view.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{view.rows.map(row=><tr>{row.map((v,j)=>j===0&&view.id==='issuer'?<th scope="row">{v}</th>:<td class="qf-figure">{v}</td>)}</tr>)}</tbody></table>
    </div>
    <SQLExample summary={`See the ${view.id === 'issuer' ? 'issuer' : 'totals'} query`} purpose="Choose approved metrics and a grouping. The model retains the exposure formulas, valuation date, and included books."><CodeBlock code={view.sql} title={`SQL · ${view.label}`} tryable={false}/></SQLExample>
  </div>)}
  <p class="demo-note">Synthetic data. Results checked in the native engine, not calculated in this browser.</p>
  <p class="sr-only" role="status" aria-live="polite" data-finance-status></p>
</div>
<script>
  function setupFinanceDemos() {
    document.querySelectorAll<HTMLElement>('[data-finance-demo]').forEach(demo => {
      if (demo.dataset.ready) return;
      const controls = demo.querySelector<HTMLElement>('[data-finance-controls]');
      const buttons = demo.querySelectorAll<HTMLButtonElement>('[data-finance-view]');
      const panels = demo.querySelectorAll<HTMLElement>('[data-finance-panel]');
      if (!controls) return;
      panels.forEach(panel => {
        const scroll = panel.querySelector<HTMLElement>('.result-scroll');
        const hint = panel.querySelector<HTMLElement>('.table-hint');
        if (!scroll || !hint) return;
        const update = () => { hint.hidden = scroll.scrollWidth <= scroll.clientWidth + 1; };
        new ResizeObserver(update).observe(scroll); update();
      });
      buttons.forEach(button => button.addEventListener('click', () => {
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        panels.forEach(p => { p.hidden = p.dataset.financePanel !== button.dataset.financeView; });
        const status = demo.querySelector<HTMLElement>('[data-finance-status]');
        if (status) status.textContent = `Showing precomputed results: ${button.textContent}.`;
      }));
      controls.hidden = false; demo.dataset.ready = 'true';
    });
  }
  setupFinanceDemos(); document.addEventListener('astro:page-load', setupFinanceDemos);
</script>
<style>
  .finance-demo { min-width: 0; overflow: hidden; border: 1px solid var(--color-soil-300); border-radius: .75rem; background: #fffdf7; }
  .demo-heading { padding: 1.5rem 1.5rem 0; }
  .demo-heading span { color: var(--color-soil-700); font-size: .75rem; }
  .demo-heading p { margin-top: .5rem; font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; }
  .demo-note { margin: 1rem 1.5rem; font-size: .8125rem; line-height: 1.7; color: var(--color-soil-700); }
  .demo-note a { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }
  .demo-controls { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0 1.5rem .75rem; }
  .demo-controls[hidden],.demo-panel[hidden],.table-hint[hidden] { display: none; }
  button { min-height: 44px; padding: .5rem .85rem; border: 1px solid var(--color-soil-300); border-radius: .4rem; color: var(--color-soil-700); font-size: .8125rem; cursor: pointer; }
  button[aria-pressed=true] { background: var(--color-soil-900); color: var(--color-cream); border-color: var(--color-soil-900); }
  button:focus-visible,.result-scroll:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
  .result-scroll { overflow-x: auto; margin: 0 1.5rem; }
  table { width: 100%; border-collapse: collapse; white-space: nowrap; font-size: .8125rem; }
  caption { text-align: left; color: var(--color-soil-700); font-size: .75rem; padding: .75rem 0; }
  th,td { text-align: right; padding: .8rem .7rem; border-bottom: 1px solid var(--color-soil-300); }
  th:first-child { text-align: left; } th { font-weight: 500; }
  .table-hint { font-size: .75rem; color: var(--color-soil-700); margin: .4rem 1.5rem; }
  .demo-panel :global(.sql-example) { margin-inline: 1.5rem; }
  @media(max-width:640px) { .demo-heading { padding: 1rem 1rem 0; } .demo-note { margin-inline: 1rem; } .demo-controls { padding-inline: 1rem; } .result-scroll { margin-inline: 1rem; } .demo-panel :global(.sql-example) { margin-inline: 1rem; } }
</style>
