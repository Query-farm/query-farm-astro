---
// The examples one catalog object (or schema) declares, inside the catalog explorer:
// description and highlighted, formatted SQL with a copy button.
import QueryResult from './QueryResult.astro';
import { sampleResult, type ObjectExample } from '../../data/vgi-workers';
import { formatExampleSql } from '../../data/vgi-workers/format-sql';

interface Props {
  examples: ObjectExample[];
  /** The worker's repo, to show each example's captured result under it. */
  repo?: string;
  /** Show this many, fold the rest behind "N more". */
  limit?: number;
}
const { examples, limit = 3, repo } = Astro.props;
const result = (sql: string) => (repo ? sampleResult({ repo }, sql) : undefined);
const shown = examples.slice(0, limit);
const rest = examples.slice(limit);
---

{examples.length > 0 && (
  <div class="vex">
    <div class="vlabel">{examples.length === 1 ? 'Example' : `Examples (${examples.length})`}</div>
    <div class="vex-list">
      {shown.map(e => (
        <div class="vex-item">
          {e.description && <p class="vex-desc">{e.description}</p>}
          <QueryResult code={formatExampleSql(e.sql)} result={result(e.sql)} />
        </div>
      ))}
    </div>
    {rest.length > 0 && (
      <details class="vex-more">
        <summary>{rest.length} more example{rest.length === 1 ? '' : 's'}</summary>
        <div class="vex-list">
          {rest.map(e => (
            <div class="vex-item">
              {e.description && <p class="vex-desc">{e.description}</p>}
              <QueryResult code={formatExampleSql(e.sql)} result={result(e.sql)} />
            </div>
          ))}
        </div>
      </details>
    )}
  </div>
)}

<style>
  .vex { margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--color-soil-300); }
  .vlabel { font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-soil-600); font-weight: 700; margin: 0 0 10px; }
  .vex-list { display: flex; flex-direction: column; gap: 18px; }
  .vex-desc { margin: 0 0 8px; font-size: 13.5px; line-height: 1.5; color: var(--color-soil-700); }
  .vex-item :global(pre) { font-size: 13px; line-height: 1.55; }
  .vex-more { margin-top: 14px; }
  .vex-more > summary { cursor: pointer; font-size: 13px; color: var(--color-link); width: fit-content; }
  .vex-more[open] > summary { margin-bottom: 14px; }
</style>
