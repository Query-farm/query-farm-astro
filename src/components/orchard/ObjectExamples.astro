---
// The examples one catalog object (or schema) declares, inside the catalog explorer:
// description, SQL, and a copy button (handled by the explorer's `.vcopy` script).
import type { ObjectExample } from '../../data/vgi-workers';

interface Props {
  examples: ObjectExample[];
  /** Show this many, fold the rest behind "N more". */
  limit?: number;
}
const { examples, limit = 3 } = Astro.props;
const shown = examples.slice(0, limit);
const rest = examples.slice(limit);
---

{examples.length > 0 && (
  <div class="vex">
    <div class="vlabel">{examples.length === 1 ? 'Example' : `Examples (${examples.length})`}</div>
    {[shown, rest].map((list, i) =>
      list.length === 0 ? null : i === 0 ? (
        list.map(e => (
          <div class="vex-item">
            {e.description && <p class="vex-desc">{e.description}</p>}
            <div class="vex-code"><pre><code>{e.sql}</code></pre><button type="button" class="vcopy vex-copy" data-sql={e.sql}>Copy</button></div>
          </div>
        ))
      ) : (
        <details class="vex-more">
          <summary>{rest.length} more example{rest.length === 1 ? '' : 's'}</summary>
          {list.map(e => (
            <div class="vex-item">
              {e.description && <p class="vex-desc">{e.description}</p>}
              <div class="vex-code"><pre><code>{e.sql}</code></pre><button type="button" class="vcopy vex-copy" data-sql={e.sql}>Copy</button></div>
            </div>
          ))}
        </details>
      ),
    )}
  </div>
)}

<style>
  .vex { margin-top: 10px; }
  .vlabel { font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-soil-600); font-weight: 700; margin: 10px 0 6px; }
  .vex-item + .vex-item, .vex-more .vex-item { margin-top: 10px; }
  .vex-desc { margin: 0 0 4px; font-size: 13px; line-height: 1.45; color: var(--color-soil-700); }
  .vex-code { position: relative; }
  .vex-code pre {
    margin: 0; padding: 9px 64px 9px 12px; border-radius: 8px; background: var(--color-rock-900, #1f1b16);
    color: #e9e1d3; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5;
    white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;
  }
  .vex-code :global(.vex-copy) {
    position: absolute; top: 6px; right: 6px; font-size: 11px; padding: 2px 8px; border-radius: 6px;
    background: rgb(255 255 255 / 0.08); color: #e9e1d3; border: 1px solid rgb(255 255 255 / 0.18); cursor: pointer;
  }
  .vex-code :global(.vex-copy:hover) { background: rgb(255 255 255 / 0.16); }
  .vex-more { margin-top: 8px; }
  .vex-more > summary { cursor: pointer; font-size: 12.5px; color: var(--color-link); width: fit-content; }
</style>
