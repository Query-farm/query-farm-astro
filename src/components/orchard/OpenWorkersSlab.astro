---
// The page's one dark slab (brief §5): how an open worker runs. Nothing is
// hosted — the worker is a local process the vgi extension spawns.
const steps = [
  { title: 'Download', body: 'A signed binary, jar, Python source or Docker image — each with a SHA-256 checksum and a cosign bundle.' },
  { title: 'Attach', body: 'INSTALL vgi FROM community, then ATTACH with the worker as the LOCATION. The extension starts it as a subprocess.' },
  { title: 'Query', body: 'Its tables, table functions and scalar functions appear as an ordinary catalog. Your data never leaves your machine.' },
];
---

<section class="bg-pipe-6 py-16 text-cream">
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
    <span class="qf-eyebrow text-sun-400">How open workers run</span>
    <h2 class="mt-3 text-3xl md:text-4xl text-cream">On your machine, under your control</h2>
    <p class="mt-3 max-w-[60ch] text-[17.5px] leading-relaxed text-cream-2">
      Open workers are free. There is no service to sign up for and no token: the worker runs wherever DuckDB or
      Haybarn runs, talking VGI over stdin and stdout.
    </p>
    <div class="mt-8 grid gap-3.5 md:grid-cols-3">
      {steps.map((s, i) => (
        <div class="rounded-xl border border-white/15 px-5 py-5">
          <div class="qf-figure text-2xl leading-none text-sun-400">{i + 1}</div>
          <h3 class="mt-3 text-lg text-cream">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream-2">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
