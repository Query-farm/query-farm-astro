---
// The Orchard worker directory: category rail (real links, so every category
// is a static, crawlable page), facet chips, full-text search and the grid.
// Search and facets are progressive enhancement over server-rendered cards —
// see src/scripts/orchard-worker-search.ts.
import { Icon } from 'astro-icon/components';
import WorkerCard from './WorkerCard.astro';
import { categories, groups, familyFor, workers as allWorkers, workersInCategory, type Worker } from '../../data/vgi-workers';

interface Props {
  workers: Worker[];
  activeCategory?: string;
}
const { workers, activeCategory } = Astro.props;

const railCat = (c: (typeof categories)[number]) => ({
  id: c.id, name: c.name, icon: c.icon, count: workersInCategory(c.id).length, href: `/products/orchard/connectors/category/${c.id}`,
});
// The rail: "All", then each group's categories under its heading.
const railGroups = groups
  .map(g => ({ ...g, items: categories.filter(c => c.group === g.id).map(railCat).filter(c => c.count > 0) }))
  .filter(g => g.items.length > 0);

const byName = (a: Worker, b: Worker) => a.name.localeCompare(b.name);

// Idle view (no search or filter) on the directory home: grouped by category, one row
// of cards per category (primary category only, so each worker appears once) and a link
// to the rest.
const OVERVIEW_SHOWN = 3; // one row per category at desktop width
const overview = activeCategory
  ? null
  : groups
      .map(g => ({
        ...g,
        sections: categories
          .filter(c => c.group === g.id)
          .map(c => ({ cat: c, workers: workersInCategory(c.id).filter(w => w.primaryCategory?.id === c.id).sort(byName) }))
          .filter(s => s.workers.length > 0),
      }))
      .filter(g => g.sections.length > 0);

// A category page: a family (one product line split per service or issuer, e.g. the
// Azure connectors) gets its own subheading with its members' cards beneath; the rest
// follow A–Z.
type Block = { family?: NonNullable<ReturnType<typeof familyFor>>; workers: Worker[] };
function blocksFor(list: Worker[]): Block[] {
  const fams = new Map<string, Block>();
  const rest: Worker[] = [];
  for (const w of [...list].sort(byName)) {
    const fam = familyFor(w.slug);
    const n = fam ? list.filter(m => fam.members.includes(m.slug)).length : 0;
    if (fam && n >= 2) {
      if (!fams.has(fam.id)) fams.set(fam.id, { family: fam, workers: [] });
      fams.get(fam.id)!.workers.push(w);
    } else rest.push(w);
  }
  return [...fams.values(), ...(rest.length ? [{ workers: rest }] : [])];
}
const categoryBlocks = activeCategory ? blocksFor(workers) : null;

const surfaceOpts = [
  { id: 'tables', label: 'Tables' },
  { id: 'table functions', label: 'Table functions' },
  { id: 'scalar functions', label: 'Scalar functions' },
  { id: 'macros', label: 'Macros' },
  { id: 'copy formats', label: 'COPY formats' },
];
const platformOpts = [
  { id: 'osx_arm64', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
  { id: 'windows_amd64', label: 'Windows' },
  { id: 'docker', label: 'Docker' },
  { id: 'wasm', label: 'WebAssembly' },
];
// Category names for "matches in other categories" (category pages only).
const categoryNames = Object.fromEntries(categories.map(c => [c.id, c.name]));
const activeName = activeCategory ? categoryNames[activeCategory] : undefined;

const platformsOf = (w: Worker) => {
  const p = new Set<string>(w.platforms);
  if (w.platforms.some(x => x.startsWith('linux')) || w.language === 'Python' || w.language === 'Java') p.add('linux');
  if (w.language === 'Python' || w.language === 'Java') { p.add('osx_arm64'); p.add('windows_amd64'); }
  if (w.image) p.add('docker');
  return [...p].join(' ');
};
---

<div class="orchard-dir" data-category={activeCategory ?? ''} data-category-names={activeCategory ? JSON.stringify(categoryNames) : undefined}>
  <!-- Search -->
  <div class="max-w-2xl">
    <label for="ow-search" class="sr-only">Search connectors, tables and functions</label>
    <div class="relative">
      <Icon name="ph:magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-soil-500" aria-hidden="true" />
      <input
        id="ow-search"
        type="search"
        placeholder="Search connectors, tables, functions, columns…  e.g. “IBAN”, “delta_e”, “holdings”"
        autocomplete="off"
        class="w-full rounded-lg border border-soil-300 bg-[#fffdf7] py-3 pl-12 pr-4 text-base text-soil-900 transition placeholder:text-soil-500 focus:border-link focus:outline-none focus:ring-[3px] focus:ring-link/20"
      />
    </div>
    <p class="mt-2 text-[13px] text-soil-500">Full-text search covers each connector's description and every table, column and function in the catalog it attaches.</p>
  </div>

  <div class="mt-8 lg:grid lg:grid-cols-[15.5rem_1fr] lg:gap-9">
    <!-- Category rail: compact rows under each group heading; a swipeable chip row on phones -->
    <nav aria-label="Worker categories" class="mb-8 lg:mb-0">
      <div class="ow-rail lg:sticky lg:top-28">
        <a href="/products/orchard/connectors" class:list={['ow-cat', { 'is-active': !activeCategory }]} aria-current={!activeCategory ? 'page' : undefined}>
          <Icon name="ph:squares-four" class="ow-cat__icon" aria-hidden="true" />
          <span class="ow-cat__name">All connectors</span>
          <span class="ow-cat__count qf-figure">{allWorkers.length}</span>
        </a>
        {railGroups.map(g => (
          <>
            <h2 class="ow-rail__group">{g.name}</h2>
            {g.items.map(c => (
              <a href={c.href} class:list={['ow-cat', { 'is-active': activeCategory === c.id }]} aria-current={activeCategory === c.id ? 'page' : undefined}>
                <Icon name={c.icon} class="ow-cat__icon" aria-hidden="true" />
                <span class="ow-cat__name" title={c.name}>{c.name}</span>
                <span class="ow-cat__count qf-figure">{c.count}</span>
              </a>
            ))}
          </>
        ))}
      </div>
    </nav>

    <div class="min-w-0">
      <!-- Object hits (filled by search) -->
      <section id="ow-objects" class="mb-6 hidden rounded-xl border border-soil-300 bg-[#fffdf7] p-4" aria-live="polite">
        <h2 class="text-[13px] font-semibold text-soil-700">Matching tables &amp; functions</h2>
        <ul id="ow-objects-list" class="mt-2 divide-y divide-soil-200"></ul>
      </section>

      <!-- Idle view: grouped by category (home), or this category's connectors with families under their own subheading.
           Search and filters switch to the flat grid below. -->
      <div id="ow-overview">
        {overview && overview.map((g, gi) => (
          <div class:list={['ow-group', { 'mt-14': gi > 0 }]}>
            <div class="border-b border-soil-300 pb-3">
              <h2 class="text-2xl text-soil-900">{g.name}</h2>
              <p class="mt-1 text-[15px] text-soil-600">{g.description}</p>
            </div>
            {g.sections.map(s => {
              const shown = s.workers.slice(0, OVERVIEW_SHOWN);
              const total = workersInCategory(s.cat.id).length;
              return (
                <section class="mt-8" aria-labelledby={`ow-sec-${s.cat.id}`}>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 id={`ow-sec-${s.cat.id}`} class="flex items-center gap-2 text-lg font-semibold text-soil-900">
                      <Icon name={s.cat.icon} class="h-5 w-5 text-soil-500" aria-hidden="true" />
                      <a href={`/products/orchard/connectors/category/${s.cat.id}`} class="no-underline hover:text-link">{s.cat.name}</a>
                    </h3>
                    <a href={`/products/orchard/connectors/category/${s.cat.id}`} class="text-sm font-medium text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">
                      {shown.length < total ? `See all ${total} →` : `${total} ${total === 1 ? 'connector' : 'connectors'} →`}
                    </a>
                  </div>
                  <p class="mt-1 text-sm text-soil-600">{s.cat.description}</p>
                  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    {shown.map(w => <WorkerCard worker={w} showCategory={false} />)}
                  </div>
                </section>
              );
            })}
          </div>
        ))}
        {categoryBlocks && categoryBlocks.map((b, i) => (
          <section class:list={[{ 'mt-10': i > 0 }]} aria-label={b.family?.name}>
            {b.family ? (
              <div class="mb-4">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-soil-900">
                  <Icon name={b.family.icon} class="h-5 w-5 text-soil-500" aria-hidden="true" />
                  {b.family.name}
                  <span class="text-sm font-normal text-soil-500">· {b.workers.length} connectors</span>
                </h2>
                <p class="mt-1 text-sm text-soil-600">{b.family.description}</p>
              </div>
            ) : categoryBlocks.length > 1 && (
              <h2 class="mb-4 text-lg font-semibold text-soil-900">More connectors</h2>
            )}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {b.workers.map(w => <WorkerCard worker={w} showCategory={false} />)}
            </div>
          </section>
        ))}
      </div>

      <div id="ow-grid" class="hidden grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {workers.map(w => (
          <div
            class="ow-item flex flex-col"
            data-slug={w.slug}
            data-language={w.language}
            data-surface={w.facets.surfaces.join('|')}
            data-platform={platformsOf(w)}
            data-access={w.facets.needsCredentials ? 'credentials' : 'offline'}
          >
            <div class="min-h-0 flex-1"><WorkerCard worker={w} /></div>
            <p class="ow-match mt-1.5 hidden px-1 text-[12.5px] leading-snug text-soil-600 [overflow-wrap:anywhere]"></p>
          </div>
        ))}
      </div>

      <div id="ow-empty" class="hidden py-16 text-center text-soil-700">
        {activeName ? <>No {activeName} connectors match.</> : 'No connectors match.'}
        <button type="button" id="ow-reset" class="text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">Clear filters</button>
      </div>
      <p id="ow-count" class="mt-8 hidden text-center text-[13px] font-medium text-soil-500">{workers.length} connectors</p>

      {/* A search on a category page also looks across every connector. */}
      {activeCategory && (
        <section id="ow-elsewhere" class="mt-10 hidden border-t border-soil-300 pt-8" aria-live="polite">
          <h2 class="text-[15px] font-semibold text-soil-900">Matches in other categories</h2>
          <ul id="ow-elsewhere-list" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2"></ul>
          <a id="ow-all-link" href="/products/orchard/connectors" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-link underline decoration-link/40 underline-offset-2 hover:decoration-link">
            Search all connectors
            <Icon name="ph:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </section>
      )}
    </div>
  </div>
</div>

<style>
  .ow-facet-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; }
  .ow-facet-label { width: 5.5rem; flex: none; font-size: 12.5px; font-weight: 600; color: var(--color-soil-500); }
  @media (max-width: 639px) { .ow-facet-label { width: 100%; } }
  .ow-chip {
    border-radius: 9999px; border: 1px solid var(--color-soil-300); background: #fffdf7;
    padding: 0.2rem 0.7rem; font-size: 13px; color: var(--color-soil-700); cursor: pointer;
    transition: background 0.14s, color 0.14s, border-color 0.14s;
  }
  .ow-chip:hover { border-color: var(--color-sun-400); color: var(--color-soil-900); }
  .ow-chip[aria-pressed='true'] { background: var(--color-soil-900); border-color: var(--color-soil-900); color: var(--color-cream); }
  .ow-chip:focus-visible, .ow-cat:focus-visible { outline: none; border-color: var(--color-link); box-shadow: 0 0 0 3px rgb(69 99 47 / 0.25); }
  /* Rail: plain rows on desktop; one swipeable row of chips on phones and tablets. */
  .ow-rail { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; scrollbar-width: none; }
  .ow-rail::-webkit-scrollbar { display: none; }
  .ow-rail__group { display: none; }
  .ow-cat {
    display: flex; flex: none; align-items: center; gap: 0.5rem; border-radius: 9999px; border: 1px solid var(--color-soil-300);
    background: #fffdf7; padding: 0.3rem 0.8rem; font-size: 0.875rem; color: var(--color-soil-700); text-decoration: none; white-space: nowrap;
    transition: background 0.14s, color 0.14s, border-color 0.14s;
  }
  .ow-cat:hover { border-color: var(--color-sun-400); color: var(--color-soil-900); }
  .ow-cat__icon { width: 1rem; height: 1rem; flex: none; opacity: 0.65; }
  .ow-cat__count { font-size: 0.72rem; color: var(--color-soil-500); }
  .ow-cat.is-active { background: var(--color-soil-900); border-color: var(--color-soil-900); color: var(--color-cream); }
  .ow-cat.is-active .ow-cat__count { color: var(--color-cream-2); }
  @media (min-width: 1024px) {
    .ow-rail { flex-direction: column; gap: 0; overflow: visible; padding: 0; max-height: calc(100vh - 8rem); overflow-y: auto; }
    .ow-rail__group {
      display: block; margin: 1.1rem 0 0.35rem; padding: 0 0.6rem; font-size: 11.5px; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-soil-500);
    }
    .ow-cat { border: 0; border-radius: 0.375rem; background: transparent; padding: 0.32rem 0.6rem; white-space: nowrap; }
    .ow-cat:hover { background: var(--color-soil-200); }
    .ow-cat__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .ow-cat__count { flex: none; }
  }
</style>

<script>
  import { initWorkerDirectory } from '../../scripts/orchard-worker-search';
  initWorkerDirectory();
  document.addEventListener('astro:after-swap', initWorkerDirectory);
</script>
