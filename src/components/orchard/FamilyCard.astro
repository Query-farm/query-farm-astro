---
// One product line split into several connectors (all of Azure, every ETF issuer),
// shown as a single card that lists its members, so the directory reads it as one
// choice. Each member keeps its own page; the chips link straight to them.
import { Icon } from 'astro-icon/components';
import type { Worker } from '../../data/vgi-workers';

interface Props {
  family: { id: string; name: string; icon: string; description: string };
  members: Worker[];
  /** Off inside a category section, where the heading already names it. */
  showCategory?: boolean;
}
const { family, members, showCategory = true } = Astro.props;
const tint = members[0]?.tint;
const cat = members[0]?.primaryCategory;
// "Azure sign-ins" → "Sign-ins", "Vanguard ETFs" → "Vanguard": the family name already says the rest.
const short = (name: string) => {
  const s = name.replace(/^Azure\s+/i, '').replace(/\s+ETFs?$/i, '');
  // "cost" → "Cost", but leave names that are already cased ("iShares").
  return /^[a-z]+(?:[\s-]|$)/.test(s) ? s.charAt(0).toUpperCase() + s.slice(1) : s;
};
const needsCredentials = members.some(m => m.facets.needsCredentials);
---

<div class="flex h-full flex-col rounded-xl border border-soil-300 bg-white p-5" data-family={family.id}>
  <div class="flex items-start gap-3.5">
    <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-soil-300/70 ${tint?.tile ?? ''} ${tint?.ink ?? ''}`}>
      <Icon name={family.icon} class="h-6 w-6" aria-hidden="true" />
    </div>
    <div class="min-w-0">
      <h3 class="text-[16px] font-semibold text-soil-900">{family.name}</h3>
      <p class="mt-0.5 text-[12.5px] font-medium text-sun-700">{members.length} connectors{showCategory && cat && ` · ${cat.name}`}</p>
    </div>
  </div>

  <p class="mt-3.5 text-sm leading-relaxed text-soil-700">{family.description}</p>

  <ul class="mt-3.5 flex flex-1 flex-wrap content-start gap-1.5" aria-label={`${family.name} connectors`}>
    {members.map(m => (
      <li>
        <a
          href={`/products/orchard/connectors/${m.slug}`}
          class="inline-block rounded-md border border-soil-300 bg-soil-100/60 px-2 py-0.5 text-[13px] text-soil-800 no-underline transition hover:border-sun-400 hover:text-link"
        >{short(m.name)}</a>
      </li>
    ))}
  </ul>

  {needsCredentials && (
    <div class="mt-4 flex items-center gap-2 border-t border-soil-200 pt-3 text-xs text-soil-600">
      <Icon name="ph:key" class="h-3.5 w-3.5" aria-hidden="true" />Needs credentials
    </div>
  )}
</div>
