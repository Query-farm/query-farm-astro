---
// Custom COPY formats a worker registers on ATTACH (vgi_copy_formats()): readers for
// `COPY <table> FROM` and writers for `COPY (<query>) TO`. One card per format.
import { marked } from 'marked';
import CodeBlock from '../ui/CodeBlock.astro';
import type { CopyFormat } from '../../data/vgi-workers';

interface Props {
  formats: CopyFormat[];
}
const { formats } = Astro.props;

// The format's doc_md is written as a standalone page: drop a heading that just
// repeats the COPY syntax, and demote the rest below this card's h3.
function renderDoc(src: string): string {
  const body = src.replace(/^\s*#{1,3}\s+COPY[^\n]*\n+/, '');
  const demoted = body.replace(/^(#{1,4})(\s)/gm, (_m, h: string, sp: string) => '#'.repeat(Math.min(h.length + 3, 6)) + sp);
  return marked.parse(demoted) as string;
}

// Used when the worker ships no example for the format.
function skeleton(f: CopyFormat): string {
  const ext = f.name.replace(/_(out|in)$/, '');
  const lines: string[] = [];
  if (f.reads) lines.push(`-- Load a file into an existing local table\nCOPY my_table FROM 'data.${ext}' (FORMAT '${f.format}');`);
  if (f.writes) lines.push(`-- Write a query's rows out to a file\nCOPY (SELECT * FROM my_table) TO 'out.${ext}' (FORMAT '${f.format}');`);
  return lines.join('\n\n');
}

const badge = 'inline-flex items-center rounded-full border px-2 py-0.5 text-[11.5px] font-semibold';
---

<div class="flex flex-col gap-5">
  {formats.map(f => (
    <article id={f.anchor} class="scroll-mt-32 rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-mono text-[16px] font-semibold text-soil-900 [overflow-wrap:anywhere]">FORMAT '{f.format}'</h3>
        {f.reads && <span class={`${badge} border-field-600/45 bg-field-600/10 text-field-700`}>COPY … FROM · import</span>}
        {f.writes && <span class={`${badge} border-sun-400 bg-sun-400/12 text-sun-700`}>COPY … TO · export</span>}
      </div>
      {(f.title || f.summary) && (
        <p class="mt-2 text-[15px] text-soil-700">
          {f.title && <strong class="font-semibold text-soil-900">{f.title}. </strong>}{f.summary}
        </p>
      )}

      <div class="mt-4 flex flex-col gap-3">
        {f.examples.length > 0
          ? f.examples.map(e => <CodeBlock code={e.description ? `-- ${e.description}\n${e.sql}` : e.sql} lang="sql" title="copy.sql" tryable={false} />)
          : <CodeBlock code={skeleton(f)} lang="sql" title="copy.sql" tryable={false} />}
      </div>

      {f.options.length > 0 && (
        <div class="mt-4">
          <h4 class="text-[14px] font-semibold text-soil-900">Options</h4>
          <p class="mt-0.5 text-[13px] text-soil-600">Pass these inside the COPY statement's parentheses, after <code class="font-mono">FORMAT</code>. Unknown options are rejected.</p>
          <dl class="mt-2 grid grid-cols-1 gap-x-4 gap-y-1.5 text-sm sm:grid-cols-[auto_1fr] [&>dd]:min-w-0 [&>dd]:[overflow-wrap:anywhere] [&>dd]:mb-1.5 sm:[&>dd]:mb-0">
            {f.options.map(o => (
              <>
                <dt class="font-mono text-soil-900">{o.name}{o.type && <span class="ml-1.5 text-[12px] text-soil-500">{o.type}</span>}</dt>
                <dd class="text-soil-700">{o.description}</dd>
              </>
            ))}
          </dl>
        </div>
      )}

      {f.docMd && (
        <details class="mt-4 group">
          <summary class="cursor-pointer text-sm font-medium text-link underline decoration-link/40 underline-offset-2">Full reference</summary>
          <div class="prose mt-3 max-w-none text-[14.5px] [&_code]:[overflow-wrap:anywhere] prose-headings:text-soil-900 prose-p:text-soil-700 prose-li:text-soil-700 prose-strong:text-soil-900 prose-code:text-soil-900 prose-code:bg-soil-100 prose-code:font-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[13px] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-pre:bg-rock-900 prose-pre:text-[#e9e1d3]" set:html={renderDoc(f.docMd)} />
        </details>
      )}
    </article>
  ))}
</div>
