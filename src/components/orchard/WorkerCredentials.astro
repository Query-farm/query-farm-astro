---
// Credentials a worker needs, rendered entirely from what it declares: each
// secret type's description, a ready-to-fill CREATE SECRET, its keys and the
// functions that need it (vgi_secret_types()). Nothing here is hand-written per
// worker — a key without vgi_doc reads "Not documented by the worker".
import { Icon } from 'astro-icon/components';
import CodeBlock from '../ui/CodeBlock.astro';
import type { Credential } from '../../data/vgi-workers';

interface Props {
  credentials: Credential[];
  catalog: string;
}
const { credentials, catalog } = Astro.props;
const anyRequired = credentials.some(c => c.params.some(p => p.required));
// vgi-github's token is needed by ~800 REST functions; list a few, count the rest.
const NEEDED_BY_SHOWN = 12;
---

<div class="flex flex-col gap-6">
  {credentials.map(c => (
    <article id={`secret-${c.type}`} class="scroll-mt-32 rounded-xl border border-soil-300 bg-[#fffdf7] p-5">
      <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="flex items-center gap-2 text-[17px] font-semibold text-soil-900">
          <Icon name="ph:key" class="h-4 w-4 flex-none text-sun-700" aria-hidden="true" />
          <span class="font-mono">{c.type}</span>
        </h3>
        {c.docUrl && (
          <a href={c.docUrl} class="inline-flex items-center gap-1 text-sm text-link underline decoration-link/40 underline-offset-2" rel="noopener">
            How to get these credentials
            <Icon name="ph:arrow-up-right" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        )}
      </header>
      {c.description && <p class="mt-2 text-[15px] leading-relaxed text-soil-700">{c.description}</p>}

      <div class="mt-4">
        <CodeBlock code={c.createSql} lang="sql" title="secret.sql" tryable={false} />
      </div>

      {c.params.length > 0 && (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-soil-300 text-[12px] font-semibold text-soil-500">
                <th class="py-1.5 pr-4 font-semibold">Key</th>
                <th class="py-1.5 pr-4 font-semibold">Type</th>
                <th class="py-1.5 pr-4 font-semibold">Required</th>
                <th class="py-1.5 font-semibold">Description</th>
              </tr>
            </thead>
            <tbody>
              {c.params.map(p => (
                <tr class="border-b border-soil-200 align-top last:border-0">
                  <td class="py-2 pr-4 font-mono text-soil-900">
                    {p.name}
                    {p.redact && (
                      <span class="ml-1.5 inline-flex items-center gap-0.5 rounded border border-soil-300 bg-soil-100 px-1 py-px font-sans text-[11px] text-soil-600" title="Masked in duckdb_secrets() and SHOW SECRETS">
                        <Icon name="ph:eye-slash" class="h-3 w-3" aria-hidden="true" />secret
                      </span>
                    )}
                  </td>
                  <td class="py-2 pr-4 font-mono text-[13px] text-soil-600">{p.type ?? '—'}</td>
                  <td class="py-2 pr-4 text-soil-700">{p.required ? 'Yes' : anyRequired ? 'No' : '—'}</td>
                  <td class={p.description ? 'py-2 text-soil-700' : 'py-2 text-soil-400 italic'}>
                    {p.description ?? 'Not documented by the worker'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {!anyRequired && (
            <p class="mt-2 text-[12.5px] text-soil-500">The worker doesn't mark which keys are required.</p>
          )}
        </div>
      )}

      {c.neededBy.length > 0 && (
        <p class="mt-4 flex flex-wrap items-center gap-1.5 text-[13px] text-soil-600">
          Needed by
          {c.neededBy.slice(0, NEEDED_BY_SHOWN).map(f =>
            f.anchor ? (
              <a href={`#${f.anchor}`} class="max-w-full [overflow-wrap:anywhere] rounded-md border border-soil-300 bg-soil-100/60 px-1.5 py-0.5 font-mono text-[12px] text-link hover:border-sun-400">{f.name}</a>
            ) : (
              <span class="max-w-full [overflow-wrap:anywhere] rounded-md border border-soil-300 bg-soil-100/60 px-1.5 py-0.5 font-mono text-[12px] text-soil-700">{f.name}</span>
            ),
          )}
          {c.neededBy.length > NEEDED_BY_SHOWN && (
            <span class="text-soil-600">and {c.neededBy.length - NEEDED_BY_SHOWN} more functions</span>
          )}
        </p>
      )}
    </article>
  ))}
  <p class="text-[13px] leading-relaxed text-soil-600">
    Create the secret in the same session, after attaching <code class="rounded bg-soil-100 px-1 py-0.5 font-mono text-[12.5px] text-soil-900">{catalog}</code>
    — the worker registers its secret types at <code class="rounded bg-soil-100 px-1 py-0.5 font-mono text-[12.5px] text-soil-900">ATTACH</code>.
    Keys marked <em>secret</em> are masked in <code class="rounded bg-soil-100 px-1 py-0.5 font-mono text-[12.5px] text-soil-900">duckdb_secrets()</code>;
    reading them with <code class="rounded bg-soil-100 px-1 py-0.5 font-mono text-[12.5px] text-soil-900">getenv()</code> keeps them out of your SQL and history.
  </p>
</div>
