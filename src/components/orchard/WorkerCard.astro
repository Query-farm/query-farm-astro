---
// One worker in the Orchard directory grid. Shape follows ConnectorCard so the
// open workers and the managed connectors read as one catalog.
import { Icon } from 'astro-icon/components';
import type { Worker } from '../../data/vgi-workers';
import { LANGUAGE_ICON } from '../../data/vgi-workers';

interface Props {
  worker: Worker;
}
const { worker: w } = Astro.props;
const cat = w.primaryCategory;
const counts = [
  w.totals.tables && `${w.totals.tables} table${w.totals.tables === 1 ? '' : 's'}`,
  w.totals.tableFunctions && `${w.totals.tableFunctions} table fn${w.totals.tableFunctions === 1 ? '' : 's'}`,
  w.totals.functions && `${w.totals.functions} function${w.totals.functions === 1 ? '' : 's'}`,
  w.totals.macros && `${w.totals.macros} macro${w.totals.macros === 1 ? '' : 's'}`,
].filter(Boolean);
---

<a
  href={`/products/orchard/workers/${w.slug}`}
  class="group relative flex h-full flex-col rounded-xl border border-soil-300 bg-white p-5 transition duration-[260ms] ease-[cubic-bezier(.2,.8,.3,1)] hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_20px_40px_-28px_rgba(33,26,18,.55)]"
>
  <div class="flex items-start gap-3.5">
    <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-soil-300/70 ${w.tint.tile} ${w.tint.ink}`}>
      <Icon name={cat?.icon ?? 'ph:cube'} class="h-6 w-6" aria-hidden="true" />
    </div>
    <div class="min-w-0">
      <h3 class="truncate font-mono text-[15px] font-semibold text-soil-900 group-hover:text-link">{w.repo}</h3>
      <p class="mt-0.5 text-[12.5px] font-medium text-sun-700">{cat?.name}</p>
    </div>
  </div>

  <p class="mt-3.5 line-clamp-3 flex-1 text-sm leading-relaxed text-soil-700">{w.blurb}</p>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    <span class="inline-flex items-center rounded-full border border-field-600/45 bg-field-600/10 px-2.5 py-0.5 text-[12px] font-medium text-field-700">
      {w.offering.pricing === 'open' ? 'Open · run it yourself' : 'Managed'}
    </span>
    {w.facets.needsCredentials && (
      <span class="inline-flex items-center rounded-full border border-soil-300 bg-soil-100/70 px-2.5 py-0.5 text-[12px] font-medium text-soil-700">Needs credentials</span>
    )}
  </div>

  <div class="mt-3 flex items-center gap-2 border-t border-soil-200 pt-3 text-xs text-soil-500">
    <Icon name={LANGUAGE_ICON[w.language] ?? 'ph:code'} class="h-3.5 w-3.5" aria-hidden="true" />
    <span>{w.language}</span>
    <span class="ml-auto truncate">{counts.length ? counts.join(' · ') : w.facets.indexed ? '' : 'catalog not indexed'}</span>
  </div>
</a>
