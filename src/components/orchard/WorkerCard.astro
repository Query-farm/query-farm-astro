---
// One connector in the Orchard directory grid.
import { Icon } from 'astro-icon/components';
import type { Worker } from '../../data/vgi-workers';
import { LANGUAGE_ICON } from '../../data/vgi-workers';

interface Props {
  worker: Worker;
  /** Off inside a category section, where the heading already names it. */
  showCategory?: boolean;
}
const { worker: w, showCategory = true } = Astro.props;
const cat = w.primaryCategory;
---

<a
  href={`/products/orchard/connectors/${w.slug}`}
  class="group relative flex h-full flex-col rounded-xl border border-soil-300 bg-white p-5 transition duration-[260ms] ease-[cubic-bezier(.2,.8,.3,1)] hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_20px_40px_-28px_rgba(33,26,18,.55)]"
>
  <div class="flex items-start gap-3.5">
    <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-soil-300/70 ${w.tint.tile} ${w.tint.ink}`}>
      <Icon name={cat?.icon ?? 'ph:cube'} class="h-6 w-6" aria-hidden="true" />
    </div>
    <div class="min-w-0">
      <h3 class="truncate text-[16px] font-semibold text-soil-900 group-hover:text-link">{w.name}</h3>
      {showCategory && <p class="mt-0.5 text-[12.5px] font-medium text-sun-700">{cat?.name}</p>}
    </div>
  </div>

  <p class="mt-3.5 line-clamp-3 flex-1 text-sm leading-relaxed text-soil-700">{w.blurb}</p>

  <div class="mt-4 flex items-center gap-2 border-t border-soil-200 pt-3 text-xs text-soil-500">
    <Icon name={LANGUAGE_ICON[w.language] ?? 'ph:code'} class="h-3.5 w-3.5" aria-hidden="true" />
    <span class="whitespace-nowrap">{w.language}</span>
    {w.facets.needsCredentials ? (
      <span class="ml-auto inline-flex items-center gap-1 whitespace-nowrap text-soil-600" title="Create a secret with your own credentials before querying">
        <Icon name="ph:key" class="h-3.5 w-3.5" aria-hidden="true" />Needs credentials
      </span>
    ) : !w.facets.indexed && <span class="ml-auto whitespace-nowrap">Catalog not indexed</span>}
  </div>
</a>
