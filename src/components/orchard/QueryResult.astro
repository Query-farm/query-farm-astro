---
// A query and its captured result in one panel: the dark code on top, the result on
// light paper attached underneath, so the pair reads as one unit and it's always
// clear which part is the query and which is the answer.
import CodeBlock from '../ui/CodeBlock.astro';
import ExampleResult from './ExampleResult.astro';
import type { SampleResult } from '../../data/vgi-workers';

interface Props {
  code: string;
  result?: SampleResult;
  title?: string;
}
const { code, result, title } = Astro.props;
---

<div class:list={['qr', { 'qr--joined': Boolean(result) }]}>
  <CodeBlock code={code} lang="sql" tryable={false} title={title} />
  {result && <ExampleResult result={result} />}
</div>

<style>
  .qr--joined :global(.code-block-wrapper) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  /* The light result hangs directly off the dark query: same width, no gap, square
     top corners, so the two read as one unit in two tones. */
  .qr--joined :global(.ow-result > div:first-child) {
    margin-top: 0;
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
</style>
