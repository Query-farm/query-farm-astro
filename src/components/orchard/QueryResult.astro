---
// A query and its captured result in one panel: the code on top, the result table
// attached underneath with a hairline between them, so the pair reads as one thing.
import CodeBlock from '../ui/CodeBlock.astro';
import ExampleResult from './ExampleResult.astro';
import type { SampleResult } from '../../data/vgi-workers';

interface Props {
  code: string;
  result?: SampleResult;
  title?: string;
}
const { code, result, title } = Astro.props;
---

<div class:list={['qr', { 'qr--joined': Boolean(result) }]}>
  <CodeBlock code={code} lang="sql" tryable={false} title={title} />
  {result && <ExampleResult result={result} />}
</div>

<style>
  .qr--joined :global(.code-block-wrapper) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .qr--joined :global(.ow-result > div:first-child) {
    margin-top: 0;
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
</style>
