---
/**
 * Starlight `ThemeProvider` override.
 *
 * Starlight's own provider defaults to the OS preference. The rest of
 * query.farm is light-only, so a visitor on a dark-OS machine walking from a
 * light marketing page into /vgi/docs/python/ watched the site change colour
 * under them. That reads as a bug, not a feature.
 *
 * So: the *initial* default is pinned to light. Light / dark / auto all remain
 * selectable in the picker, and an explicit choice is remembered — this only
 * changes what a first-time visitor with no stored preference gets.
 *
 * The inline script must run before first paint (no FOUC) and must define
 * `window.StarlightThemeProvider`, which `ThemeSelect` calls into. Both are
 * preserved by delegating to Starlight's provider and seeding storage ahead of
 * it. Drop the seeding block to go back to OS-following.
 */
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

<script is:inline>
  // Seed a light default for first-time visitors, before Starlight's provider
  // reads storage. An existing choice (including 'auto') is never overwritten.
  (() => {
    try {
      const KEY = 'starlight-theme';
      if (!localStorage.getItem(KEY)) localStorage.setItem(KEY, 'light');
    } catch {
      /* storage unavailable (private mode, embedded) — fall through to Starlight's default */
    }
  })();
</script>

<Default {...Astro.props} />
