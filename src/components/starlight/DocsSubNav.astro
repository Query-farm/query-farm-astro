---
// Section subnav for the VGI Python docs, styled to match HaybarnSubNav /
// OrchardSubNav: a white sticky bar (below the global header) with the VGI mark +
// "VGI Python" wordmark on the left, followed by breadcrumb pills derived from the
// Starlight sidebar (section group → current page), and a GitHub link on the right.
import type { SidebarEntry } from '@astrojs/starlight/utils/navigation';

const route = (Astro.locals as { starlightRoute?: { sidebar: SidebarEntry[]; entry: { data: { title: string } } } }).starlightRoute;
const sidebar = route?.sidebar ?? [];

// Walk the sidebar tree to the current entry, collecting the enclosing group labels.
function findTrail(entries: SidebarEntry[], groups: string[] = []): { groups: string[]; label: string } | null {
  for (const e of entries) {
    if (e.type === 'group') {
      const hit = findTrail(e.entries, [...groups, e.label]);
      if (hit) return hit;
    } else if (e.isCurrent) {
      return { groups, label: e.label };
    }
  }
  return null;
}

const ROOT = '/vgi/docs/python/';
const path = Astro.url.pathname;
const isRoot = path === ROOT || path === ROOT.slice(0, -1);
const trail = findTrail(sidebar);
// Breadcrumb crumbs after the "VGI Python" root: enclosing groups, then the page.
const crumbs = isRoot ? [] : [...(trail?.groups ?? []), trail?.label ?? route?.entry?.data?.title ?? ''];
const REPO = 'https://github.com/Query-farm/vgi-python';
---

<div class="vgi-docs-subnav sticky top-16 lg:top-20 z-40 bg-white border-b border-soil-200">
  <!-- Centered content container, matching the Orchard/Haybarn subnavs. -->
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: VGI mark + wordmark + breadcrumbs -->
      <nav class="flex items-center gap-2 min-w-0 overflow-x-auto vgi-docs-subnav__bar" aria-label="Breadcrumb">
        <a href={ROOT} class="flex items-center gap-2.5 flex-shrink-0 group">
          <img src="/vgi/vgi-logo.png" alt="" class="w-8 h-8 rounded-md object-contain" width="32" height="32" />
          <span class="font-display font-bold text-soil-900 group-hover:text-harvest-700 transition-colors whitespace-nowrap">VGI&nbsp;Python</span>
        </a>
        {crumbs.map((crumb, i) => (
          <>
            <svg class="w-4 h-4 text-soil-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span
              class:list={[
                'whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium',
                i === crumbs.length - 1 ? 'bg-harvest-50 text-harvest-700' : 'text-soil-500',
              ]}
              aria-current={i === crumbs.length - 1 ? 'page' : undefined}
            >
              {crumb}
            </span>
          </>
        ))}
      </nav>

      <!-- Right: GitHub -->
      <a
        href={REPO}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="vgi-python on GitHub"
        title="View source on GitHub"
        class="flex items-center justify-center rounded-md p-1.5 text-soil-600 transition-colors hover:bg-soil-50 hover:text-soil-900 flex-shrink-0"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .vgi-docs-subnav__bar {
    scrollbar-width: none;
  }
  .vgi-docs-subnav__bar::-webkit-scrollbar {
    display: none;
  }
</style>
