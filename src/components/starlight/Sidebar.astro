---
/**
 * Starlight `Sidebar` override — language switcher, then the scoped tree.
 *
 * The tree itself is Starlight's own `SidebarSublist`, rendering whatever
 * src/starlightRouteData.ts left in `starlightRoute.sidebar` (Concepts plus one
 * SDK). What this file adds is the switcher above it: without it, scoping the
 * sidebar would strand a reader inside one language with no way across.
 *
 * It's a grid of chips rather than a dropdown, for three reasons: it needs no
 * JavaScript, every destination is a real crawlable link, and the language marks
 * are the fastest thing on the page to recognise — which is the point. Each chip
 * lands on that language's docs root; there is no attempt to map the current
 * page across languages, because the sections aren't page-for-page parallel.
 *
 * The styling lives in starlight-shell.css rather than in a scoped style block
 * here. These chips are anchors inside `#starlight__sidebar`, and that file
 * styles sidebar links through an ID selector — which outranks any scoped class,
 * so a local `display: flex` silently lost to `display: block` and every chip
 * stacked its icon above its label. The rules have to sit at that specificity
 * to win.
 */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import { Icon } from 'astro-icon/components';
import { DOCS_ROOT, LANGUAGES, rootOf, sectionFor } from '../../lib/vgi-docs';

const { sidebar } = Astro.locals.starlightRoute;
const current = sectionFor(Astro.url.pathname);
---

<nav class="vgi-lang-switch" aria-label="SDK language">
  <a class="vgi-lang-switch__home" href={DOCS_ROOT}>
    <Icon name="ph:books-bold" />
    <span>All VGI documentation</span>
  </a>
  <ul class="vgi-lang-switch__grid">
    {
      LANGUAGES.map((l) => (
        <li>
          <a
            href={rootOf(l)}
            class:list={['vgi-lang-chip', current?.slug === l.slug && 'vgi-lang-chip--current']}
            aria-current={current?.slug === l.slug ? 'true' : undefined}
          >
            <Icon name={l.icon} />
            <span>{l.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
