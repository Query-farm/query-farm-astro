---
/**
 * The /vgi/docs/ directory: Concepts first, then one card per SDK.
 *
 * It exists because the docs shell now has a real root. Scoping the sidebar to
 * one language (src/starlightRouteData.ts) means "every language" has to be a
 * place you can go rather than a list you scroll past, and this is it — the
 * target of the subnav brand and of the sidebar switcher's "All VGI
 * documentation" link.
 *
 * The language table is src/lib/vgi-docs.ts; adding a language is a row there.
 *
 * The SDK cards are deliberately a plain navigation grid — mark and name, no
 * per-language pitch. "Which SDK should I pick, and how do I install it?" is
 * /vgi/languages' job, and it answers it with install commands, parity status,
 * repo and RPC-layer links that were never going to live here. This page
 * answers the narrower question a reader already inside the docs has: take me
 * to my language.
 */
import { Icon } from 'astro-icon/components';
import { CONCEPTS, LANGUAGES, rootOf } from '../../lib/vgi-docs';
---

<a class="docs-home-concepts" href={rootOf(CONCEPTS)}>
  <Icon name={CONCEPTS.icon} class="docs-home-concepts__icon" />
  <span class="docs-home-concepts__body">
    <span class="docs-home-concepts__title">Concepts</span>
    <span class="docs-home-concepts__blurb">{CONCEPTS.blurb}</span>
  </span>
</a>

<ul class="docs-home-grid">
  {
    LANGUAGES.map((l) => (
      <li>
        <a class="docs-home-card" href={rootOf(l)}>
          <Icon name={l.icon} class="docs-home-card__icon" />
          <span class="docs-home-card__title">{l.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Concepts is the one section that isn't a language, and the one every reader
     should pass through — so it gets a wide banner above the grid rather than a
     sixth equal card. */
  .docs-home-concepts {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin: 1.75rem 0 1.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--qf-accent);
    border-radius: 12px;
    background: var(--qf-accent-tint-soft);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .docs-home-concepts:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px -26px var(--qf-shadow);
  }
  .docs-home-concepts__icon {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--qf-accent);
  }
  .docs-home-concepts__body {
    display: block;
  }
  .docs-home-concepts__title {
    display: block;
    font-family: var(--qf-font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--qf-ink);
  }
  .docs-home-concepts__blurb {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--qf-ink-2);
  }

  .docs-home-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.6rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  /* A row of destinations, not a row of arguments — so the card is just the
     mark and the name, sized to be an easy target rather than to hold copy. */
  .docs-home-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--qf-rule);
    border-radius: 10px;
    background: var(--qf-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .docs-home-card:hover {
    border-color: var(--qf-accent);
    transform: translateY(-2px);
    box-shadow: 0 16px 34px -26px var(--qf-shadow);
  }
  .docs-home-card__icon {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    color: var(--qf-ink-2);
  }
  .docs-home-card:hover .docs-home-card__icon {
    color: var(--qf-accent);
  }
  .docs-home-card__title {
    font-family: var(--qf-font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--qf-ink);
  }

</style>
