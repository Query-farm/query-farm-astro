---
// Starlight "On this page" override: render the default TOC, then enhance API-reference
// entries with a kind icon. Each API heading is prefixed with a kind word
// ("class" / "function" / "method" / "attribute"); we read that word from the TOC link
// text, swap it for the matching colour-coded glyph (reusing the .api-icon styles), and
// keep the symbol name. Non-API pages are untouched.
import Default from '@astrojs/starlight/components/TableOfContents.astro';
---

<Default {...Astro.props} />

<script>
  const KINDS = ['class', 'function', 'method', 'attribute'];
  function kindifyToc() {
    document.querySelectorAll('starlight-toc a, mobile-starlight-toc a').forEach((a) => {
      const el = a as HTMLElement;
      if (el.dataset.kindified) return;
      const text = el.textContent?.trim() ?? '';
      const sp = text.indexOf(' ');
      const kind = sp > 0 ? text.slice(0, sp) : '';
      if (!KINDS.includes(kind)) return;
      el.dataset.kindified = '1';
      const icon = document.createElement('span');
      icon.className = `api-icon api-icon--${kind} toc-kind-icon`;
      el.textContent = text.slice(sp + 1);
      el.prepend(icon);
    });
  }
  kindifyToc();
  document.addEventListener('astro:page-load', kindifyToc);
</script>
