---
/**
 * Starlight `Header` override — the Query.Farm bar that sits above the docs.
 *
 * Starlight renders this inside its own fixed `header.header`, which is exactly
 * `--sl-nav-height` tall. That number is set in starlight-shell.css as
 * (--qf-nav-h + --qf-subnav-h), so the two bars below MUST keep those heights or
 * the sidebar, TOC and mobile bars overlap the content (VGI_DOCS_GUIDE §4.5).
 *
 * This is deliberately a small, self-contained bar rather than the site-wide
 * `layout/Header.astro`: the docs are the only part of the site with a dark
 * theme, and the marketing header's mega-menu is authored in light-only Tailwind
 * utilities. Keeping it local means the docs shell is theme-correct and the
 * nav-height contract can't be broken from outside.
 *
 * Everything else about it is a faithful copy of the marketing bar, because a
 * visitor crossing from /vgi into /vgi/docs/python should not see the site
 * chrome change shape. That means: the same `.section-container` column (so the
 * lockup sits on the same left edge as every other page's first column rather
 * than at the viewport edge), the same `StrataSun` mark at 30px, the same
 * Petrona 700 / 21px wordmark, the same 14px links on a 17px rhythm in the link
 * green, and the same "Talk with Us" CTA. The CTA and link colours are
 * hand-rolled on the --qf-* bridge vars instead of `Button`/Tailwind utilities,
 * which are light-only.
 */
import SearchWidget from '../layout/SearchWidget.astro';
import { platformComponents } from '../../data/products';
import StrataSun from '../ui/StrataSun.astro';
import ThemeSelect from './ThemeSelect.astro';
import DocsSubNav from './DocsSubNav.astro';

const path = Astro.url.pathname;

// The SAME three items, in the same order, as layout/Header.astro — because a
// reader crossing from /vgi into /vgi/docs/rust should not find the site's
// top-level navigation rearranged under them. This bar used to carry a flat
// row of seven product links, which is what the marketing header looked like
// before those were consolidated into one Products dropdown; the marketing bar
// moved on and this copy didn't, so the docs advertised an information
// architecture the rest of the site had retired.
//
// The dropdown's contents come from `platformComponents`, the same list
// /products and layout/Header.astro render, so a new product appears in all
// three from one edit.
const links: { name: string; href: string; panel?: boolean }[] = [
  { name: 'Products', href: '/products', panel: true },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' },
];

// Longest-prefix match, so /vgi/docs/python/* marks Products (not Blog).
const active = links
  .filter((l) => path === l.href || path.startsWith(l.href + '/'))
  .sort((a, b) => b.href.length - a.href.length)[0];

// A docs page under a product (e.g. /vgi/docs/rust/) is "Products" as far as
// the bar is concerned, even though its path shares no prefix with /products.
const inProduct = platformComponents.some((pc) => path === pc.href || path.startsWith(pc.href + '/'));
---

<div class="qf-docs-nav" data-pagefind-ignore>
  <div class="section-container qf-docs-nav__inner">
    <a class="qf-lock" href="/" aria-label="Query.Farm home">
      <StrataSun size={30} />
      <span class="qf-wordmark-text">Query<span class="dot">.</span>Farm</span>
    </a>

    <nav class="qf-links" aria-label="Site">
      {
        links.map((l) => {
          const current = (active && active.href === l.href) || (l.panel && inProduct);
          return (
            <div class="qf-link-wrap">
              <a href={l.href} aria-current={current ? 'page' : undefined}>
                {l.name}
              </a>
              {l.panel && (
                <div class="qf-panel-anchor">
                  <div class="qf-panel">
                    <p class="qf-panel__label">The data farm</p>
                    <ul class="qf-panel__grid">
                      {platformComponents.map((pc) => (
                        <li>
                          <a class="qf-panel__item" href={pc.href}>
                            <span class="qf-panel__icon">
                              {pc.img && <img src={pc.img} alt="" width="16" height="16" />}
                              {pc.emoji && <span aria-hidden="true">{pc.emoji}</span>}
                            </span>
                            <span class="qf-panel__text">
                              <span class="qf-panel__name">
                                {pc.title}
                                {pc.status !== 'available' && (
                                  <span class={`qf-panel__pill qf-panel__pill--${pc.status}`}>
                                    {pc.status === 'preview' ? 'Preview' : 'In development'}
                                  </span>
                                )}
                              </span>
                              <span class="qf-panel__outcome">{pc.outcome}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a class="qf-panel__more" href="/products">See how it all fits together →</a>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="qf-nav-right">
      <SearchWidget />
      <ThemeSelect />
      <a class="qf-cta" href="/company/schedule">Talk with Us</a>
    </div>
  </div>
</div>

<DocsSubNav />

<style>
  .qf-docs-nav {
    height: var(--qf-nav-h, 58px);
    /* The Products panel hangs out of this bar and over the subnav below it.
       DocsSubNav is a LATER sibling inside Starlight's fixed header, so without
       a stacking context here it paints on top of the open dropdown — the
       breadcrumb's language mark showed through the panel. */
    position: relative;
    z-index: 60;
    /* Opaque, NOT blurred: `backdrop-filter` would make this bar a containing
       block for fixed-position descendants, which traps SearchWidget's modal
       inside the 58px header. */
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--qf-rule);
  }

  /* The shared marketing column. `.section-container` supplies max-width,
     mx-auto and the responsive gutters; everything here is the flex row on top
     of it. Starlight's header reset kills the `mx-auto` — starlight-shell.css
     puts it back. */
  .qf-docs-nav__inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Reserve room for Starlight's fixed hamburger on narrow viewports, on top
       of the container's own gutter. */
    padding-inline-end: calc(1rem + var(--sl-menu-button-size, 2rem) + 0.75rem);
  }
  /* 50rem is Starlight's `md` breakpoint — the hamburger disappears there, so
     the reserved gutter can go too and the column is symmetric again. */
  @media (min-width: 50rem) {
    .qf-docs-nav__inner {
      padding-inline-end: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .qf-docs-nav__inner {
      padding-inline-end: 2rem;
    }
  }

  /* ── lock: mark + wordmark ── */
  .qf-lock {
    display: flex;
    align-items: center;
    gap: 0.32em;
    text-decoration: none;
    color: var(--sl-color-white);
    flex: none;
  }

  /* `.qf-wordmark` in global.css, restated locally: the utility is authored for
     the light marketing pages and this bar is the one place it has to sit on a
     dark ground too. Petrona 700 at 21px — same as layout/Header.astro. */
  .qf-wordmark-text {
    font-family: var(--qf-font-display);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1;
    white-space: nowrap;
    font-size: 21px;
  }
  .qf-wordmark-text .dot {
    color: var(--qf-accent);
  }


  /* ── Products dropdown ──────────────────────────────────────────────────
     Same shape and same data as layout/Header.astro's panel, restated on the
     --qf-* bridge vars: that one is authored in light-only Tailwind utilities
     (bg-white, soil-*), which is precisely why this bar was a fork in the
     first place. On the bridge vars it is correct in both docs themes. */
  .qf-link-wrap {
    position: relative;
  }
  .qf-panel-anchor {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 560px;
    transform: translateX(-50%);
    padding-top: 1rem;
    z-index: 60;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.15s, visibility 0.15s;
  }
  .qf-link-wrap:hover .qf-panel-anchor,
  .qf-link-wrap:focus-within .qf-panel-anchor {
    visibility: visible;
    opacity: 1;
  }
  .qf-panel {
    border: 1px solid var(--qf-rule);
    border-radius: 12px;
    background: var(--qf-surface);
    padding: 1rem;
    box-shadow: 0 20px 40px -18px var(--qf-shadow);
  }
  .qf-panel__label {
    margin: 0 0.5rem 0.35rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--qf-ink-3);
  }
  .qf-panel__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .qf-panel__item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s;
  }
  .qf-panel__item:hover {
    background: var(--qf-accent-tint-soft);
  }
  .qf-panel__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    overflow: hidden;
    border: 1px solid var(--qf-rule);
    border-radius: 6px;
    background: var(--qf-surface-2);
    font-size: 13px;
  }
  .qf-panel__icon img {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }
  .qf-panel__text {
    min-width: 0;
  }
  .qf-panel__name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
    color: var(--qf-ink);
  }
  .qf-panel__outcome {
    display: block;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--qf-ink-2);
  }
  .qf-panel__pill {
    border-radius: 999px;
    border: 1px solid var(--qf-rule);
    padding: 0 0.35rem;
    font-size: 10px;
    font-weight: 500;
    color: var(--qf-ink-3);
  }
  .qf-panel__pill--preview {
    border-color: var(--qf-accent);
    color: var(--qf-accent);
  }
  .qf-panel__more {
    display: block;
    margin-top: 0.5rem;
    padding: 0.6rem 0.5rem 0;
    border-top: 1px solid var(--qf-rule);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-link);
    text-decoration: none;
  }
  :global([data-theme='dark']) .qf-panel__more {
    color: var(--color-link-dark);
  }

  /* ── links ── */
  .qf-links {
    display: none;
    align-items: center;
    gap: 17px;
    font-size: 14px;
    color: var(--qf-ink-2);
  }
  @media (min-width: 48rem) {
    .qf-links {
      display: flex;
    }
  }
  @media (min-width: 96rem) {
    .qf-links {
      gap: 22px;
      font-size: 14.5px;
    }
  }
  .qf-links a {
    text-decoration: none;
    color: inherit;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  /* The marketing bar marks hover/current in the link green, not the gold
     accent — the gold is the docs *body's* accent (sidebar, breadcrumbs). Both
     values come from global.css so the two bars can't drift. */
  .qf-links a:hover,
  .qf-links a[aria-current='page'] {
    color: var(--color-link);
    border-bottom-color: var(--color-link);
  }
  :global([data-theme='dark']) .qf-links a:hover,
  :global([data-theme='dark']) .qf-links a[aria-current='page'] {
    color: var(--color-link-dark);
    border-bottom-color: var(--color-link-dark);
  }

  /* ── right cluster ── */
  .qf-nav-right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 48rem) {
    .qf-nav-right {
      gap: 0.75rem;
    }
  }
  /* The theme picker is a Starlight <Select>; it inherits --sl-color-gray-2. */
  .qf-nav-right :global(starlight-theme-select) {
    display: none;
  }
  @media (min-width: 50rem) {
    .qf-nav-right :global(starlight-theme-select) {
      display: block;
    }
  }

  /* `Button variant="primary" size="sm"`, restated for a bar that can be dark.
     Light: field-700 fill, darkening on hover. Dark: field-600, lightening on
     hover with the label flipping to ink (white on field-400 is 3.19:1). */
  .qf-cta {
    display: none;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border-radius: 0.5rem;
    border: 1px solid var(--color-field-700);
    background: var(--color-field-700);
    color: #fff;
    padding: 7px 15px;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  @media (min-width: 64rem) {
    .qf-cta {
      display: inline-flex;
    }
  }
  .qf-cta:hover {
    background: var(--color-field-800);
    border-color: var(--color-field-800);
  }
  :global([data-theme='dark']) .qf-cta {
    background: var(--color-field-600);
    border-color: var(--color-field-600);
  }
  :global([data-theme='dark']) .qf-cta:hover {
    background: var(--color-field-400);
    border-color: var(--color-field-400);
    color: var(--color-rock-900);
  }
</style>
