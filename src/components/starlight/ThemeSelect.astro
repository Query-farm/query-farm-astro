---
/**
 * Starlight `ThemeSelect` override — the light/dark/auto picker.
 *
 * Renders Starlight's own select (its inline script calls
 * `StarlightThemeProvider.updatePickers()`, which our ThemeProvider override
 * defines, so the two must stay paired) and only restyles the control to sit
 * quietly in the Query.Farm docs bar.
 *
 * It appears twice: in the header on ≥50rem, and in the mobile menu footer
 * below that — Starlight renders both from this component.
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
---

<Default {...Astro.props} />

<style is:global>
  starlight-theme-select label {
    color: var(--qf-ink-2);
    font-family: var(--__sl-font);
  }
  starlight-theme-select label:hover {
    color: var(--qf-accent);
  }
  starlight-theme-select select {
    font-size: 0.8125rem;
  }
  starlight-theme-select option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
  }
</style>
