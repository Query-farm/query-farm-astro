---
import { Icon } from 'astro-icon/components';
import { platformSummary, directoryPagePath } from '../../data/haybarn-extensions/pagination.mjs';
import { categories } from '../../data/haybarn-extensions/taxonomy.mjs';
interface Props {
  extension?: {
    name: string; displayName: string; href: string; description: string;
    queryFarm: boolean; icon?: string; categories: string[];
    availability: { version: string; platform: string }[];
  };
}
const { extension } = Astro.props;
---
<article class="extension-result" data-extension={extension?.name}>
  <div class="extension-glyph" aria-hidden="true"><Icon name={`ph:${extension?.icon || 'puzzle-piece'}`} is:inline /></div>
  <div class="extension-summary">
    <div class="extension-title">
      <h2><a href={extension?.href}>{extension?.displayName}</a></h2>
      <span class="publisher-label" hidden={!extension?.queryFarm}><img src="/media-kit/logo/mark-2-band.svg" alt="" width="18" height="18" />Query Farm</span>
    </div>
    <p class="extension-description">{extension?.description}</p>
    <div class="extension-topics">{extension?.categories.map(id => <a href={directoryPagePath(1, id)} data-category={id}>{categories.find(category => category.id === id)?.name}</a>)}</div>
    <div class="extension-availability">
      <span class="release-label">{extension && `Haybarn ${[...new Set(extension.availability.map(item => item.version))].join(' · ')}`}</span>
      <span class="platform-label">{extension && platformSummary(extension.availability)}</span>
    </div>
  </div>
</article>

<style>
  .extension-result { display:grid; grid-template-columns:36px minmax(0,1fr); gap:16px; min-width:0; padding:24px 0; border-bottom:1px solid var(--color-soil-300); }
  .extension-glyph { color:var(--color-sun-700); padding-top:5px; font-size:29px; }
  .extension-glyph :global(svg) { width:1em; height:1em; }
  .extension-summary { min-width:0; }
  .extension-title { display:flex; align-items:center; flex-wrap:wrap; gap:10px 12px; }
  h2 { font-family:var(--font-display); font-size:24px; font-weight:600; line-height:1.3; overflow-wrap:anywhere; }
  h2 a { color:var(--color-soil-900); text-decoration:none; }
  h2 a:hover { color:var(--color-link); text-decoration:underline; text-underline-offset:3px; }
  .publisher-label { display:inline-flex; align-items:center; gap:6px; padding:3px 8px; border:1px solid var(--color-soil-300); border-radius:6px; color:var(--color-link); white-space:nowrap; font-size:12px; }
  .publisher-label img { width:18px; height:18px; }
  .extension-description { margin-top:7px; font-size:17px; line-height:1.55; color:var(--color-soil-700); overflow-wrap:anywhere; }
  .extension-topics { display:flex; flex-wrap:wrap; gap:8px 14px; margin-top:11px; font-size:12px; }
  .extension-topics :global(a) { color:var(--color-soil-600); text-decoration:underline; text-decoration-color:var(--color-soil-300); text-underline-offset:3px; }
  .extension-availability { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:12px; font-size:12px; color:var(--color-soil-500); }
  [hidden] { display:none; }
  @media(max-width:700px) { .extension-result { grid-template-columns:27px minmax(0,1fr); gap:11px; } .extension-glyph { font-size:24px; } }
</style>
