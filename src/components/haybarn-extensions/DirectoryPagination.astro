---
import { directoryPagePath, pageNumbers } from '../../data/haybarn-extensions/pagination.mjs';
interface Props { page: number; total: number; category: string; }
const { page, total, category } = Astro.props;
---
<nav class="directory-pagination" aria-label="Extension result pages" hidden={total <= 1}>
  {page > 1 && <a href={directoryPagePath(page - 1, category)} rel="prev">← Previous</a>}
  {pageNumbers(page, total).map(number => number === null ? <span aria-hidden="true">…</span> : <a href={directoryPagePath(number, category)} aria-label={`Page ${number}`} aria-current={number === page ? 'page' : undefined}>{number}</a>)}
  {page < total && <a href={directoryPagePath(page + 1, category)} rel="next">Next →</a>}
</nav>

<style is:global>
  .directory-pagination { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:6px; padding-top:24px; }
  .directory-pagination[hidden] { display:none; }
  .directory-pagination a { display:inline-flex; min-width:36px; min-height:40px; align-items:center; justify-content:center; border:1px solid var(--color-soil-300); border-radius:5px; padding:7px 10px; color:var(--color-link); font-size:14px; text-decoration:none; }
  .directory-pagination a:hover { background:var(--color-soil-100); }
  .directory-pagination a[aria-current="page"] { background:var(--color-field-700); border-color:var(--color-field-700); color:white; }
  .directory-pagination span { padding-inline:2px; color:var(--color-soil-500); }
  @media(max-width:400px) { .directory-pagination a { min-width:32px; padding-inline:8px; } .directory-pagination a[rel] { font-size:12px; } }
</style>
