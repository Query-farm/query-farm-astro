---
import PageLayout from '../../layouts/PageLayout.astro';
import HaybarnSubNav from '../sections/HaybarnSubNav.astro';
import PageHead from '../ui/PageHead.astro';
import ExtensionIcon from '../products/ExtensionIcon.astro';
import { Icon } from 'astro-icon/components';
import { catalog, categories, categoryPath, directoryPath, extensions, platformLabel } from '../../data/haybarn-extensions';
import { directoryPage, categoryPage } from '../../data/haybarn-extensions/sharing.mjs';

interface Props { category?: string; }
const { category = '' } = Astro.props;
const selected = categories.find(item => item.id === category);
const metadata = selected ? categoryPage(selected) : directoryPage;
const { name: title, description } = metadata;
const counts = new Map(categories.map(item => [item.id, extensions.filter(extension => extension.categories.includes(item.id)).length]));
const visible = extensions.filter(extension => !category || extension.categories.includes(category));
const initialData = extensions.map(extension => ({ name: extension.name, categories: extension.categories, queryFarm: extension.queryFarm, searchText: extension.searchText, availability: extension.availability.map(item => ({ version: item.version, platform: item.platform })) }));
---

<PageLayout title={metadata.title} description={description} ogImage={metadata.ogImage}>
  <HaybarnSubNav />
  <PageHead title={title} lede={description} />
  <div class="extension-directory section-container" data-extension-directory data-initial-category={category}>
    <aside class="directory-sidebar" data-pagefind-ignore>
      <details class="category-disclosure" open>
      <summary class="category-summary">Browse by category <span>{selected?.name ?? 'All extensions'}</span></summary>
      <nav aria-label="Extension categories">
        <a href={directoryPath} data-category="" class:list={['category-link', { active: !category }]} aria-current={!category ? 'page' : undefined}><Icon name="ph:squares-four" /><span>All extensions</span><span class="category-count">{extensions.length}</span></a>
        {categories.filter(item => counts.get(item.id)).map(item => (
          <a href={categoryPath(item.id)} data-category={item.id} class:list={['category-link', { active: category === item.id }]} aria-current={category === item.id ? 'page' : undefined}><Icon name={`ph:${item.icon}`} /><span>{item.name}</span><span class="category-count">{counts.get(item.id)}</span></a>
        ))}
      </nav>
      </details>
      <div class="directory-links"><a href={`${directoryPath}/install`}>Installing extensions <span aria-hidden="true">↗</span></a><a href="/products/haybarn/community-extensions">Publish an extension <span aria-hidden="true">↗</span></a></div>
    </aside>

    <section class="directory-main" aria-label="Find an extension">
      <form class="directory-search" role="search" data-pagefind-ignore>
        <label for="extension-query">What do you want to do?</label>
        <div class="search-field"><Icon name="ph:magnifying-glass" /><input id="extension-query" name="q" type="search" placeholder="Try Excel, fuzzy matching, or a database name" autocomplete="off" /><kbd aria-hidden="true">/</kbd></div>
        <div class="search-suggestions"><span>Try</span>{['Read Excel', 'Google Sheets', 'Fuzzy matching', 'Geospatial'].map(query => <a href={`${directoryPath}?q=${encodeURIComponent(query)}`} data-query={query}>{query}</a>)}</div>
        <div class="directory-filters">
          <label>Platform<select name="platform" id="extension-platform"><option value="">All platforms</option>{catalog.platforms.map(platform => <option value={platform}>{platformLabel(platform)}</option>)}</select></label>
          <label>Publisher<select name="publisher" id="extension-publisher"><option value="">All publishers</option><option value="query-farm">Query Farm</option><option value="community">Other maintainers</option></select></label>
        </div>
      </form>
      <div class="directory-results-bar" data-pagefind-ignore><p id="extension-result-count" role="status" aria-live="polite">{visible.length} extensions</p><button type="button" class="clear-filters" hidden>Clear filters</button></div>
      <p class="directory-empty" hidden>No extensions match these filters. Try another term, platform, or publisher.</p>
      <div class="extension-results" data-pagefind-ignore>
        {extensions.map(extension => (
          <article class="extension-result" data-extension={extension.name} hidden={!!category && !extension.categories.includes(category)}>
            <div class="extension-glyph"><ExtensionIcon icon={extension.icon} /></div>
            <div class="extension-summary">
              <div class="extension-title"><h2><a href={extension.href}>{extension.displayName}{extension.external && <span aria-label="External documentation" class="external-mark">↗</span>}</a></h2>{extension.queryFarm && <span class="publisher-label"><img src="/media-kit/logo/mark-2-band.svg" alt="" aria-hidden="true" width="18" height="18" />Query Farm</span>}</div>
              <p>{extension.description}</p>
              <div class="extension-topics">{extension.categories.map(id => <a href={categoryPath(id)} data-category={id}>{categories.find(item => item.id === id)?.name}</a>)}</div>
            </div>
            <div class="extension-availability"><span class="release-label">Haybarn {[...new Set(extension.availability.map(item => item.version))].join(' · ')}</span><span class="platform-label">{[...new Set(extension.availability.map(item => item.platform.split('_')[0]))].map(id => ({ linux: 'Linux', osx: 'macOS', windows: 'Windows', wasm: 'WASM' }[id])).join(' · ')}</span></div>
          </article>
        ))}
      </div>
      <noscript><p class="directory-note">Every extension is listed above. Use the category links or your browser’s Find command to explore the catalog.</p></noscript>
      <p class="directory-note">Availability checked {new Date(catalog.fetchedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}. WASM availability means a binary is published; individual features may require a native environment.</p>
    </section>
  </div>
  <script is:inline type="application/json" id="extension-directory-data" set:html={JSON.stringify(initialData).replace(/</g, '\\u003c')} />
</PageLayout>

<script>
  import '../../scripts/haybarn-extension-discovery';
</script>

<style>
  .extension-directory { display:grid; grid-template-columns:245px minmax(0,1fr); gap:40px; padding-top:38px; padding-bottom:72px; }
  .directory-sidebar { align-self:start; }
  .category-summary { display:none; }
  .category-disclosure:not([open]) > nav { display:grid; }
  .directory-sidebar nav { display:grid; gap:4px; }
  .category-link { display:flex; align-items:center; gap:10px; padding:10px 9px; border-radius:6px; color:var(--color-soil-700); font-size:15px; line-height:1.35; text-decoration:none; }
  .category-link svg { width:20px; height:20px; flex:none; }
  .category-link.active { background:var(--color-soil-100); color:var(--color-link); font-weight:650; }
  .category-link:hover { background:var(--color-soil-50); color:var(--color-link); }
  .category-count { margin-left:auto; font-size:12px; color:var(--color-soil-500); font-variant-numeric:tabular-nums; }
  .directory-links { display:grid; gap:12px; border-top:1px solid var(--color-soil-300); margin-top:23px; padding:22px 9px; font-size:14px; }
  .directory-links a { display:flex; justify-content:space-between; gap:6px; }
  .directory-main { min-width:0; }
  .directory-search > label { display:block; font-family:var(--font-display); font-size:25px; font-weight:600; margin-bottom:13px; color:var(--color-soil-900); }
  .search-field { display:flex; align-items:center; gap:12px; border:1px solid var(--color-soil-400); background:white; border-radius:8px; padding:13px 15px; }
  .search-field:focus-within { outline:2px solid var(--color-link); outline-offset:2px; }
  .search-field svg { width:23px; height:23px; flex:none; color:var(--color-soil-500); }
  .search-field input { width:100%; min-width:0; font-size:17px; outline:none; background:transparent; }
  .search-field kbd { color:var(--color-soil-500); border:1px solid var(--color-soil-300); border-radius:3px; font-size:12px; padding:0 5px; }
  .search-suggestions { display:flex; flex-wrap:wrap; gap:8px 13px; font-size:13px; margin:12px 0 23px; color:var(--color-soil-500); }
  .search-suggestions a { color:var(--color-link); text-decoration:underline; text-underline-offset:3px; }
  .directory-filters { display:flex; flex-wrap:wrap; gap:16px; }
  .directory-filters label { display:grid; gap:6px; font-size:12px; color:var(--color-soil-600); flex:1; min-width:150px; }
  .directory-filters select { width:100%; min-width:0; max-width:100%; padding:9px 26px 9px 10px; border:1px solid var(--color-soil-300); border-radius:5px; font-size:14px; color:var(--color-soil-900); background:white; }
  .directory-results-bar { display:flex; justify-content:space-between; margin-top:28px; padding:0 0 12px; border-bottom:1px solid var(--color-soil-300); font-size:13px; color:var(--color-soil-600); }
  .clear-filters { color:var(--color-link); text-decoration:underline; cursor:pointer; }
  .extension-result { display:grid; grid-template-columns:36px minmax(0,1fr); column-gap:16px; padding:24px 0; border-bottom:1px solid var(--color-soil-300); }
  .extension-result[hidden], [hidden] { display:none; }
  .extension-glyph { color:var(--color-sun-700); padding-top:5px; font-size:29px; }
  .extension-title { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
  .extension-title h2 { font-family:var(--font-display); font-size:24px; font-weight:600; line-height:1.3; overflow-wrap:anywhere; }
  .extension-title h2 a { color:var(--color-soil-900); text-decoration:none; }
  .extension-title h2 a:hover { color:var(--color-link); }
  .external-mark { font-family:var(--font-sans); margin-left:7px; font-size:17px; color:var(--color-soil-400); }
  .publisher-label { display:inline-flex; align-items:center; gap:6px; padding:3px 8px; border:1px solid var(--color-soil-300); border-radius:6px; white-space:nowrap; font-size:12px; font-weight:600; color:var(--color-link); }
  .publisher-label img { width:18px; height:18px; flex:none; }
  .extension-summary p { margin-top:7px; font-size:17px; line-height:1.55; color:var(--color-soil-700); overflow-wrap:anywhere; }
  .extension-topics { display:flex; flex-wrap:wrap; gap:8px 14px; margin-top:11px; font-size:12px; }
  .extension-topics a { color:var(--color-soil-600); text-decoration:underline; text-decoration-color:var(--color-soil-300); text-underline-offset:3px; }
  .extension-availability { grid-column:2; display:flex; gap:8px 18px; flex-wrap:wrap; margin-top:12px; font-size:12px; color:var(--color-soil-500); }
  .directory-note { margin-top:25px; font-size:13px; line-height:1.6; color:var(--color-soil-500); }
  .directory-empty { margin:32px 0; font-size:18px; line-height:1.6; }
  @media (max-width:900px) { .extension-directory { grid-template-columns:205px minmax(0,1fr); gap:24px; } .category-link { font-size:14px; padding-inline:4px; gap:7px; } }
  @media (max-width:700px) {
    .extension-directory { display:grid; grid-template-columns:minmax(0,1fr); gap:18px; padding-top:25px; }
    .directory-main { display:contents; }
    .directory-search { grid-row:1; }
    .directory-sidebar { width:100%; grid-row:2; }
    .category-summary { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:14px; cursor:pointer; padding:12px 0; border-block:1px solid var(--color-soil-300); }
    .category-summary span { font-size:12px; color:var(--color-link); }
    .category-summary span::after { content:' ⌄'; margin-left:4px; }
    .category-disclosure:not([open]) > nav { display:none; }
    .directory-sidebar nav { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
    .category-link { border:1px solid var(--color-soil-300); padding:7px 9px; font-size:13px; }
    .category-link svg { width:15px; height:15px; }
    .category-count, .directory-links { display:none; }
    .directory-search > label { font-size:23px; }
    .search-field input { font-size:16px; }
    .search-field { gap:9px; padding:12px; }
    .directory-filters { gap:10px; }
    .directory-filters label { min-width:130px; }
    .directory-results-bar { margin-top:0; }
    .extension-result { gap:11px; grid-template-columns:27px minmax(0,1fr); }
    .extension-glyph { font-size:24px; }
  }
</style>
