---
import PageLayout from '../../layouts/PageLayout.astro';
import HaybarnSubNav from '../sections/HaybarnSubNav.astro';
import PageHead from '../ui/PageHead.astro';
import DirectoryResult from './DirectoryResult.astro';
import DirectoryPagination from './DirectoryPagination.astro';
import { Icon } from 'astro-icon/components';
import { catalog, categories, categoryPath, directoryPath, extensions } from '../../data/haybarn-extensions';
import { directoryPage, categoryPage } from '../../data/haybarn-extensions/sharing.mjs';
import { categoryGuides } from '../../data/haybarn-extensions/guides.mjs';
import { PAGE_SIZE, pageCount, directoryPagePath } from '../../data/haybarn-extensions/pagination.mjs';

interface Props { category?: string; page?: number; }
const { category = '', page = 1 } = Astro.props;
const selected = categories.find(item => item.id === category);
const metadata = selected ? categoryPage(selected) : directoryPage;
const { name: title, description } = metadata;
const pageTitle = `${metadata.title}${page > 1 ? ` — Page ${page}` : ''}`;
const counts = new Map(categories.map(item => [item.id, extensions.filter(extension => extension.categories.includes(item.id)).length]));
const scope = extensions.filter(extension => !category || extension.categories.includes(category));
const totalPages = pageCount(scope.length);
const offset = (page - 1) * PAGE_SIZE;
const visible = scope.slice(offset, offset + PAGE_SIZE);
const guide = selected ? categoryGuides[selected.id as keyof typeof categoryGuides] : undefined;
const suggestions = guide?.examples.flatMap(name => {
  const extension = scope.find(item => item.name === name);
  return extension ? [extension] : [];
}) ?? [];
// Keep the complete publisher list on category pages so an active publisher
// survives category navigation, even when the new category has no matches.
const publishers = [...new Map(extensions.map(extension => [extension.publisherId, extension.publisher])).entries()]
  .sort(([a, aLabel], [b, bLabel]) => a === 'query-farm' ? -1 : b === 'query-farm' ? 1 : aLabel.localeCompare(bLabel));
const initialData = scope.map(extension => ({ name: extension.name, displayName: extension.displayName, href: extension.href, description: extension.description, icon: extension.icon || 'puzzle-piece', categories: extension.categories, topics: extension.categories.map(id => ({ id, name: categories.find(category => category.id === id)!.name })), queryFarm: extension.queryFarm, publisherId: extension.publisherId, searchText: extension.searchText, availability: extension.availability.map(item => ({ version: item.version, platform: item.platform })) }));
const icons = [...new Set(initialData.map(extension => extension.icon))];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: pageTitle, description,
  url: new URL(`${directoryPagePath(page, category)}/`, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: visible.length,
    itemListElement: visible.map((extension, index) => ({
      '@type': 'ListItem', position: offset + index + 1, name: extension.displayName,
      url: new URL(`${extension.href}/`, Astro.site).href,
    })),
  },
};
---

<PageLayout title={pageTitle} description={description} ogImage={metadata.ogImage} jsonLd={jsonLd}>
  <HaybarnSubNav />
  <PageHead variant="section" title={title} lede={selected?.description ?? `Browse ${extensions.length} DuckDB extensions rebuilt for Haybarn ${catalog.latestVersion}. Search by task or name, or browse by publisher.`} class="!py-6" hairband />
  <div class="extension-directory section-container" data-extension-directory data-initial-category={category} data-page={page} data-title={metadata.title}>
    <aside class="directory-sidebar" data-pagefind-ignore>
      <details class="category-disclosure" open>
      <summary class="category-summary">Browse by category <span>{selected?.name ?? 'All extensions'}</span></summary>
      <nav aria-label="Extension categories">
        <a href={directoryPath} data-category="" class:list={['category-link', { active: !category }]} aria-current={!category ? 'page' : undefined}><Icon name="ph:squares-four" /><span>All extensions</span><span class="category-count">{extensions.length}</span></a>
        {categories.filter(item => counts.get(item.id)).map(item => (
          <a href={categoryPath(item.id)} data-category={item.id} class:list={['category-link', { active: category === item.id }]} aria-current={category === item.id ? 'page' : undefined}><Icon name={`ph:${item.icon}`} /><span>{item.name}</span><span class="category-count">{counts.get(item.id)}</span></a>
        ))}
      </nav>
      </details>
      <div class="directory-links"><a href={`${directoryPath}/install`}>Installing extensions <span aria-hidden="true">↗</span></a><a href="/products/haybarn/community-extensions">Publish an extension <span aria-hidden="true">↗</span></a></div>
    </aside>

    <section class="directory-main" aria-label="Find an extension">
      <form class="directory-search" role="search" data-pagefind-ignore>
        <label for="extension-query">What do you want to do?</label>
        <div class="search-field"><Icon name="ph:magnifying-glass" /><input id="extension-query" name="q" type="search" placeholder="Try Excel, fuzzy matching, or a database name" autocomplete="off" /><kbd aria-hidden="true">/</kbd></div>
        <div class="search-suggestions"><span>Try</span>{['Read Excel', 'Fuzzy matching', 'Geospatial'].map(query => <a href={`${directoryPath}?q=${encodeURIComponent(query)}`} data-query={query}>{query}</a>)}</div>
        <div class="directory-filters">
          <label>Publisher<select name="publisher" id="extension-publisher"><option value="">All publishers</option>{publishers.map(([id, name]) => <option value={id}>{name}</option>)}</select></label>
        </div>
        <div class="active-filters" role="group" aria-label="Active filters" hidden></div>
      </form>
      <div class="directory-results-bar" data-pagefind-ignore><p id="extension-result-count" role="status" aria-live="polite">{scope.length ? `${offset + 1}–${offset + visible.length} of ${scope.length} extensions` : '0 extensions'}</p><span>Haybarn {catalog.latestVersion}</span><button type="button" class="clear-filters" hidden>Clear filters</button></div>
      <p class="directory-empty" hidden>No extensions match these filters. Try another term or publisher.</p>
      <div class="extension-results" data-pagefind-ignore>
        {visible.map(extension => <DirectoryResult extension={extension} />)}
      </div>
      <template id="extension-result-template"><DirectoryResult /></template>
      {icons.map(icon => <template data-extension-icon={icon}><Icon name={`ph:${icon}`} is:inline aria-hidden="true" /></template>)}
      <DirectoryPagination page={page} total={totalPages} category={category} />
      <noscript><p class="directory-note">Use the numbered pages and category links to browse every extension. Search and publisher filters require JavaScript.</p></noscript>
      <p class="directory-note">Availability checked {new Date(catalog.fetchedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}. WASM availability means a binary is published; individual features may require a native environment.</p>
      {page === 1 && <section class="directory-guidance" aria-labelledby="using-extensions">
        {guide ? <>
          <h2 id="using-extensions">Choose an extension for your workflow</h2>
          <p>{guide.intro}</p>
          <ul>{guide.considerations.map(item => <li>{item}</li>)}</ul>
          {suggestions.length > 0 && <p class="starting-points">Explore {suggestions.map((extension, index) => <>{index > 0 && (index === suggestions.length - 1 ? ' or ' : ', ')}<a href={extension.href}>{extension.displayName}</a></>)}.</p>}
        </> : <>
          <h2 id="using-extensions">Using DuckDB extensions in Haybarn</h2>
          <p><a href="/products/haybarn">Haybarn</a> is Query Farm’s distribution of DuckDB, with its own signed extension builds. Open a guide for installation and platform support, or see <a href={`${directoryPath}/install`}>how extension installation works</a> for core extensions such as HTTPFS.</p>
        </>}
      </section>}
    </section>
  </div>
  <script is:inline type="application/json" id="extension-directory-data" set:html={JSON.stringify(initialData).replace(/</g, '\\u003c')} />
</PageLayout>

<script>
  import '../../scripts/haybarn-extension-discovery';
</script>

<style>
  .extension-directory { display:grid; grid-template-columns:245px minmax(0,1fr); gap:40px; padding-top:38px; padding-bottom:72px; }
  .directory-sidebar { align-self:start; }
  .category-summary { display:none; }
  .category-disclosure:not([open]) > nav { display:grid; }
  .directory-sidebar nav { display:grid; gap:4px; }
  .category-link { display:flex; align-items:center; gap:10px; padding:10px 9px; border-radius:6px; color:var(--color-soil-700); font-size:15px; line-height:1.35; text-decoration:none; }
  .category-link svg { width:20px; height:20px; flex:none; }
  .category-link.active { background:var(--color-soil-100); color:var(--color-link); font-weight:650; }
  .category-link:hover { background:var(--color-soil-50); color:var(--color-link); }
  .category-count { margin-left:auto; font-size:12px; color:var(--color-soil-500); font-variant-numeric:tabular-nums; }
  .directory-links { display:grid; gap:12px; border-top:1px solid var(--color-soil-300); margin-top:23px; padding:22px 9px; font-size:14px; }
  .directory-links a { display:flex; justify-content:space-between; gap:6px; }
  .directory-main { min-width:0; }
  .directory-guidance h2 { font-size:24px; color:var(--color-soil-900); margin-bottom:14px; }
  .directory-guidance p, .directory-guidance li { font-size:15px; line-height:1.7; color:var(--color-soil-700); max-width:75ch; }
  .directory-guidance ul { list-style:disc; padding-left:22px; margin-top:14px; }
  .directory-guidance li + li { margin-top:7px; }
  .directory-guidance a { color:var(--color-link); text-decoration:underline; text-underline-offset:3px; }
  .directory-guidance .starting-points { margin-top:14px; }
  .directory-guidance { border-top:1px solid var(--color-soil-300); margin-top:30px; padding-top:26px; }
  .directory-search > label { display:block; font-family:var(--font-display); font-size:25px; font-weight:600; margin-bottom:13px; color:var(--color-soil-900); }
  .search-field { display:flex; align-items:center; gap:12px; border:1px solid var(--color-soil-400); background:white; border-radius:8px; padding:13px 15px; }
  .search-field:focus-within { outline:2px solid var(--color-link); outline-offset:2px; }
  .search-field svg { width:23px; height:23px; flex:none; color:var(--color-soil-500); }
  .search-field input { width:100%; min-width:0; font-size:17px; outline:none; background:transparent; }
  .search-field kbd { color:var(--color-soil-500); border:1px solid var(--color-soil-300); border-radius:3px; font-size:12px; padding:0 5px; }
  .search-suggestions { display:flex; flex-wrap:wrap; gap:8px 13px; font-size:13px; margin:12px 0 23px; color:var(--color-soil-500); }
  .search-suggestions a { color:var(--color-link); text-decoration:underline; text-underline-offset:3px; }
  .directory-filters { max-width:360px; }
  .directory-filters label { display:grid; gap:6px; font-size:12px; color:var(--color-soil-600); }
  .directory-filters select { width:100%; min-width:0; max-width:100%; padding:9px 26px 9px 10px; border:1px solid var(--color-soil-300); border-radius:5px; font-size:14px; color:var(--color-soil-900); background:white; }
  .directory-results-bar { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; margin-top:22px; padding:0 0 12px; border-bottom:1px solid var(--color-soil-300); font-size:13px; color:var(--color-soil-600); }
  .clear-filters { color:var(--color-link); text-decoration:underline; cursor:pointer; }
  .extension-results { display:grid; grid-template-columns:minmax(0,1fr); }
  .active-filters { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
  .active-filters :global(button) { display:inline-flex; align-items:center; gap:8px; max-width:100%; padding:6px 10px; border:1px solid var(--color-soil-300); border-radius:5px; background:var(--color-soil-100); color:var(--color-soil-900); font-size:13px; text-align:left; overflow-wrap:anywhere; cursor:pointer; }
  .active-filters :global(button:hover) { border-color:var(--color-link); }
  [hidden] { display:none; }
  .directory-note { margin-top:25px; font-size:13px; line-height:1.6; color:var(--color-soil-500); }
  .directory-empty { margin:32px 0; font-size:18px; line-height:1.6; }
  @media (max-width:900px) { .extension-directory { grid-template-columns:205px minmax(0,1fr); gap:24px; } .category-link { font-size:14px; padding-inline:4px; gap:7px; } }
  @media (max-width:700px) {
    .extension-directory { display:grid; grid-template-columns:minmax(0,1fr); gap:18px; padding-top:25px; }
    .directory-main { display:contents; }
    .directory-search { grid-row:1; }
    .directory-sidebar { width:100%; grid-row:2; }
    .category-summary { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:14px; cursor:pointer; padding:12px 0; border-block:1px solid var(--color-soil-300); }
    .category-summary span { font-size:12px; color:var(--color-link); }
    .category-summary span::after { content:' ⌄'; margin-left:4px; }
    .category-disclosure:not([open]) > nav { display:none; }
    .directory-sidebar nav { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
    .category-link { border:1px solid var(--color-soil-300); padding:7px 9px; font-size:13px; }
    .category-link svg { width:15px; height:15px; }
    .category-count, .directory-links { display:none; }
    .directory-search > label { font-size:23px; }
    .search-field input { font-size:16px; }
    .search-field { gap:9px; padding:12px; }
    .directory-results-bar { margin-top:0; }
    .extension-results { grid-template-columns:minmax(0,1fr); }
  }
</style>
