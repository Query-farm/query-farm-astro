---
import { Icon } from 'astro-icon/components';
import SectionSubNav from '../sections/SectionSubNav.astro';
import { getTagGroups } from '../../lib/blog-tags';

const groups = await getTagGroups();
const path = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { name: 'All posts', href: '/blog', active: path === '/blog' },
  { name: 'Topics', href: '/blog', active: path.startsWith('/blog/tags/'), items: groups.map(group => ({ name: group.label, href: '/blog/tags/' + group.slug, count: group.posts.length })) },
  { name: 'Subscribe', href: '/company/newsletter' },
];
---

<SectionSubNav name="Blog" href="/blog" tabs={tabs} class="blog-subnav">
  <Icon slot="icon" name="ph:newspaper" class="h-[22px] w-[22px] text-soil-600" aria-hidden="true" />
</SectionSubNav>

<style is:global>
  html:has(.blog-subnav) {
    --qf-blog-nav-h: 48px;
    scroll-padding-top: calc(var(--qf-nav-h) + var(--qf-blog-nav-h) + 16px);
  }
</style>
