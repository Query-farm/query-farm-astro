---
interface Props {
  text: string;
}

const { text } = Astro.props;
// Monospace SQL keywords and scoped npm package names (e.g. @duckdb/duckdb-wasm).
// A trailing sentence period is left out of the package match.
const pattern = /(\bLATERAL\b|@[a-z0-9-]+\/[a-z0-9-]+(?:\.[a-z0-9-]+)*)/g;
const parts = text.split(pattern);
---

{parts.map((part, i) => i % 2 === 1
  ? <code class="font-mono text-[0.9em] tracking-normal">{part}</code>
  : part
)}
