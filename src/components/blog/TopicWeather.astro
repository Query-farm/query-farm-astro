---
import type { BlogPost } from '../../lib/blog-tags';
import { tagSlug } from '../../lib/blog-tags';

interface Props { posts: BlogPost[] }
const { posts } = Astro.props;
const today = new Date();
const day = Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate());
const dayMs = 86_400_000;
// These are topic locations on an imaginary farm, not geographic coordinates.
const stations = [
  { topic: 'WebAssembly', label: 'WASM', x: 90, y: 69 },
  { topic: 'SQL', label: 'SQL', x: 236, y: 56 },
  { topic: 'Haybarn', label: 'Haybarn', x: 79, y: 172 },
  { topic: 'VGI', label: 'VGI', x: 292, y: 159 },
  { topic: 'Arrow', label: 'Arrow', x: 195, y: 240 },
].map(station => {
  const matching = posts.filter(post => !post.data.draft && post.data.pubDate.valueOf() <= day && post.data.tags.some(tag => tagSlug(tag) === tagSlug(station.topic)));
  const latest = Math.max(...matching.map(post => post.data.pubDate.valueOf()));
  const age = matching.length ? Math.floor((day - latest) / dayMs) : Infinity;
  const recent = matching.filter(post => day - post.data.pubDate.valueOf() <= 30 * dayMs).length;
  const weather = age <= 14 ? 'sun' : age <= 45 ? 'haze' : 'cloud';
  const last = age === 0 ? 'today' : age === 1 ? '1 day ago' : Number.isFinite(age) ? `${age} days ago` : 'no posts yet';
  return { ...station, matching, recent, weather, last };
}).filter(station => station.matching.length > 0);
const asOf = today.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const boundary = 'M35 56C45 33 68 23 98 29S139 24 161 20 193 34 219 24 257 28 265 45 303 42 324 67 344 95 338 115 355 147 339 173 340 209 312 224 286 248 253 249 225 282 194 282 163 264 148 252 118 253 107 235 73 231 51 206 28 181 38 157 22 127 30 105 21 79 35 56Z';
---

<figure class="topic-weather" aria-labelledby="weather-heading">
  <div class="weather-heading"><h3 id="weather-heading">Weather on the farm</h3><span>{asOf}</span></div>
  <p class="weather-deck">A field guide to our recent writing.</p>
  <svg class="weather-map" viewBox="0 0 380 318" aria-labelledby="weather-map-title">
    <title id="weather-map-title">Topic activity map. Sunshine means a post within fourteen days, haze within forty-five days, and clouds a longer quiet spell. Select a topic to read its posts.</title>
    <defs>
      <clipPath id="weather-land"><path d={boundary} /></clipPath>
      <radialGradient id="weather-warm"><stop stop-color="var(--color-sun-300)" stop-opacity=".48" /><stop offset="1" stop-color="var(--color-sun-300)" stop-opacity="0" /></radialGradient>
      <radialGradient id="weather-cool"><stop stop-color="var(--color-cat-slate)" stop-opacity=".8" /><stop offset="1" stop-color="var(--color-cat-slate)" stop-opacity="0" /></radialGradient>
      <pattern id="weather-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="var(--color-soil-300)" stroke-width=".4" opacity=".5" /></pattern>
      <symbol id="topic-sun" viewBox="0 0 40 32">
        <g fill="none" stroke="var(--color-sun-700)" stroke-width="1.3" stroke-linecap="round">
          <path d="M20 2v3m0 22v3M6 16H3m34 0h-3M10 6l2 2m16 16 2 2M30 6l-2 2M12 24l-2 2" />
          <circle cx="20" cy="16" r="7.5" fill="var(--color-sun-300)" />
        </g>
      </symbol>
      <symbol id="topic-cloud" viewBox="0 0 40 32">
        <path d="M9 26C0 26 1 15 9 15c0-13 20-15 23-1 10 0 10 12 1 12Z" fill="var(--color-soil-100)" stroke="var(--color-soil-600)" stroke-width="1.3" stroke-linejoin="round" />
        <path d="M9 29h22" stroke="var(--color-soil-300)" stroke-width="1.3" />
      </symbol>
      <symbol id="topic-haze" viewBox="0 0 40 32">
        <circle cx="25" cy="11" r="7" fill="var(--color-sun-300)" stroke="var(--color-sun-700)" stroke-width="1.2" />
        <path d="M6 28C0 28 0 20 7 20c0-10 15-12 18-2 10-1 12 10 3 10Z" fill="var(--color-soil-100)" stroke="var(--color-soil-600)" stroke-width="1.3" />
      </symbol>
    </defs>
    <g aria-hidden="true" fill="none" stroke="var(--color-soil-300)" stroke-width=".9">
      <path d={boundary} fill="var(--color-soil-100)" fill-opacity=".6" />
      <g clip-path="url(#weather-land)" stroke="none">
        {stations.map(station => <ellipse cx={station.x} cy={station.y} rx="103" ry="87" fill={station.weather === 'cloud' ? 'url(#weather-cool)' : 'url(#weather-warm)'} opacity={station.weather === 'haze' ? '.4' : '1'} />)}
        <rect width="380" height="318" fill="url(#weather-grid)" />
        <g fill="none" stroke="var(--color-soil-400)" stroke-width=".65" opacity=".35">
          {[0, 1, 2, 3, 4].map(i => <path d={`M${-5 + i * 7} 10C${44 + i * 9} 0 ${162 + i * 4} 5 ${164 + i * 7} 53S${132 + i * 6} 116 ${181 + i * 9} 135 ${253 + i * 8} 192 ${235 + i * 8} 232 262 276 310 ${279 + i * 8}`} />)}
          {[0, 1, 2].map(i => <path d={`M-10 ${210 + i * 9}C54 ${181 + i * 9} 74 ${226 + i * 9} 119 ${204 + i * 9}S156 ${158 + i * 9} 187 ${168 + i * 9}`} />)}
        </g>
        <path d="M138 5C173 46 109 99 148 122S186 149 164 179 150 227 176 254 165 297 181 327" fill="none" stroke="var(--color-cat-slate-ink)" stroke-width="2" opacity=".27" />
        <path d="M140 5C175 46 111 99 150 122S188 149 166 179 152 227 178 254 167 297 183 327" fill="none" stroke="var(--color-soil-50)" stroke-width="1" />
        <path d="M31 123C77 116 115 148 150 122m0 0c56-38 80-15 189-7m-175 64c37 33 77 37 161 27" fill="none" stroke="var(--color-soil-500)" stroke-dasharray="2 5" stroke-width=".8" opacity=".5" />
      </g>
      <path d={boundary} stroke="var(--color-soil-400)" stroke-opacity=".6" />
      <g transform="translate(349 35)" stroke="var(--color-soil-600)" stroke-width=".8">
        <circle r="12" /><path d="M0-19V19M-19 0H19" /><path d="M0-14 4 0 0 14-4 0Z" fill="var(--color-soil-50)" /><path d="M0-14V0H-4Z" fill="var(--color-soil-600)" />
        <text y="-24" text-anchor="middle" fill="var(--color-soil-600)" stroke="none" font-size="9">N</text>
      </g>
      <g stroke="var(--color-soil-400)" stroke-width=".7" opacity=".7">
        <path d="M21 272c24-12 49 23 81 10m-80-3c24-11 48 21 79 10m-78-3c23-10 46 18 76 10" />
        <path d="m297 268 5-9 5 9m-5-9v17m10 3 5-9 5 9m-5-9v17m-28-8 4-7 4 7m-4-7v14" />
      </g>
    </g>
    {stations.map(station => <a href={`/blog/tags/${tagSlug(station.topic)}`} class="station" aria-label={`${station.topic}: latest post ${station.last}; ${station.recent} ${station.recent === 1 ? 'post' : 'posts'} in the past 30 days. Browse ${station.topic}.`}>
      <title>{station.topic}: latest {station.last}. {station.recent} {station.recent === 1 ? 'post' : 'posts'} in the past 30 days.</title>
      <g transform={`translate(${station.x} ${station.y})`}>
        <rect x="-47" y="-23" width="94" height="76" rx="8" class="station-hit" />
        <use href={`#topic-${station.weather}`} x="-20" y="-23" width="40" height="32" />
        <text class="station-name" y="26" text-anchor="middle">{station.label}</text>
        <text class="station-count" y="42" text-anchor="middle">{station.recent} {station.recent === 1 ? 'post' : 'posts'} / 30d</text>
      </g>
    </a>)}
  </svg>
  <figcaption>
    <span><svg viewBox="0 0 40 32" aria-hidden="true"><use href="#topic-sun" /></svg>Fresh</span>
    <span><svg viewBox="0 0 40 32" aria-hidden="true"><use href="#topic-haze" /></svg>Recent</span>
    <span><svg viewBox="0 0 40 32" aria-hidden="true"><use href="#topic-cloud" /></svg>Quiet</span>
  </figcaption>
  <details class="weather-key">
    <summary>How’s the weather?</summary>
    <p>Sun: a post in the last 14 days. Haze: 15–45 days. Cloud: more than 45 days. Counts show posts in the last 30 days; a post can cover several topics. A snapshot of our writing as of {asOf}, not a prediction of what comes next.</p>
  </details>
</figure>

<style>
  .topic-weather { margin: 0; width: 100%; color: var(--color-soil-700); }
  .weather-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .weather-heading h3 { font-family: var(--font-display); font-size: 24px; font-style: italic; font-weight: 500; }
  .weather-heading > span { font-size: 10px; font-variant-numeric: tabular-nums; }
  .weather-deck { margin-top: 5px; font-size: 12px; }
  .weather-map { display: block; width: 100%; height: auto; margin-top: 16px; overflow: visible; }
  .station { text-decoration: none; }
  .station-hit { fill: transparent; stroke: transparent; }
  .station-name { font-family: var(--font-display); font-weight: 600; font-size: 19px; fill: var(--color-soil-900); paint-order: stroke; stroke: var(--color-soil-50); stroke-width: 3px; stroke-linejoin: round; }
  .station-count { font-family: var(--font-sans); font-size: 12px; fill: var(--color-soil-700); font-variant-numeric: tabular-nums; paint-order: stroke; stroke: var(--color-soil-50); stroke-width: 3px; stroke-linejoin: round; }
  .station:hover .station-hit, .station:focus-visible .station-hit { fill: var(--color-soil-50); stroke: var(--color-soil-400); }
  .station:focus-visible { outline: none; }
  figcaption { display: flex; justify-content: center; gap: 20px; border-top: 1px solid var(--color-soil-300); padding-top: 12px; font-size: 11px; }
  figcaption span { display: flex; align-items: center; gap: 4px; }
  figcaption svg { width: 25px; height: 20px; }
  .weather-key { margin-top: 10px; text-align: center; font-size: 11px; }
  .weather-key summary { display: inline-block; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .weather-key summary:focus-visible { outline: 2px solid var(--color-field-700); outline-offset: 3px; }
  .weather-key p { margin-top: 8px; text-align: left; line-height: 1.6; font-size: 12px; }
</style>
