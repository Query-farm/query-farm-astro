---
import snapshot from '../../data/upstream-contribution-lists.json';

const items = snapshot.items as Record<string, {
  title: string;
  repository: string;
  number: number;
  kind: string;
  status: string;
}>;
const labels: Record<string, string> = {
  merged: 'Merged', open: 'Open', draft: 'Draft', closed: 'Closed without merge',
};
const asOf = new Date(`${snapshot.asOf}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

{snapshot.groups.map(group => (
  <div
    id={group.id}
    class="contribution-list"
    popover="auto"
    role="dialog"
    aria-labelledby={`${group.id}-title`}
    data-pagefind-ignore
  >
    <header>
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <button type="button" popovertarget={group.id} popovertargetaction="hide" autofocus>Close</button>
    </header>
    <p class="snapshot-note">Status on {asOf}. Links open the items on GitHub.</p>
    <ul>
      {group.itemUrls.map(url => {
        const item = items[url];
        return (
          <li>
            <a href={url}>{item.title}</a>
            <span class="item-detail">{item.repository} #{item.number} · {labels[item.status]}</span>
          </li>
        );
      })}
    </ul>
  </div>
))}

<style>
  .contribution-list {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(42rem, calc(100dvh - 3rem));
    margin: auto;
    padding: 24px;
    overflow: auto;
    border: 1px solid var(--color-soil-300);
    border-radius: 14px;
    color: var(--color-soil-900);
    background: var(--color-soil-50);
    box-shadow: 0 12px 48px #211a1226;
  }
  .contribution-list::backdrop { background: #211a1240; }
  header { display: flex; align-items: start; justify-content: space-between; gap: 16px; }
  h2 { margin: 0; font-size: 1.5rem; line-height: 1.2; }
  button {
    flex: none;
    min-height: 36px;
    padding: 5px 12px;
    border: 1px solid var(--color-soil-300);
    border-radius: 6px;
    background: var(--color-soil-100);
    color: var(--color-soil-900);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { background: var(--color-soil-200); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
  .snapshot-note { margin: 12px 0 18px; color: var(--color-soil-700); font-size: 13px; line-height: 1.5; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 14px 0; border-top: 1px solid var(--color-soil-200); }
  li:last-child { padding-bottom: 0; }
  a { color: var(--color-link); font-weight: 500; line-height: 1.5; text-decoration: underline; text-underline-offset: 3px; }
  a:hover { color: var(--color-link-hover); }
  .item-detail { display: block; margin-top: 5px; color: var(--color-soil-700); font-size: 12px; overflow-wrap: anywhere; }
  @media (max-width: 480px) {
    .contribution-list { padding: 20px; }
    h2 { font-size: 1.25rem; }
  }
</style>
