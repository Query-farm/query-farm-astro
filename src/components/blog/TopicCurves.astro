---
/**
 * The topic's contour signature. Decorative — always aria-hidden.
 *
 * `preserveAspectRatio="none"` lets one viewBox stretch to any card width; the
 * lines are stroked, so they stay hairline-thin under the horizontal scale
 * (`vector-effect: non-scaling-stroke` would fight that, not help it, because
 * the height is fixed and only x scales).
 */
import { topicCurves, type CurveOptions } from '../../lib/blog-curves';

interface Props extends CurveOptions {
  topic?: string;
  class?: string;
}

const {
  topic,
  class: className = '',
  width = 1200,
  height = 100,
  count = 6,
  phase = 0,
  vertical = false,
} = Astro.props;

const curves = topicCurves(topic, { width, height, count, phase, vertical });

// width/height describe the run and the bundle's thickness; the viewBox has to
// swap them when the flow is vertical.
const box = vertical ? `0 0 ${height} ${width}` : `0 0 ${width} ${height}`;
---

<svg
  class={className}
  viewBox={box}
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {curves.map(curve => (
    <path
      d={curve.d}
      stroke={curve.stroke}
      stroke-width={curve.width}
      stroke-opacity={curve.opacity}
      stroke-linecap="round"
    />
  ))}
</svg>
