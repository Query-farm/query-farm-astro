---
/**
 * Archive row under the lead card on /blog.
 *
 * Replaced a 3-up PostCard grid, which clamped every excerpt to three lines
 * mid-sentence and made a five-post archive look thin. A full-width row carries
 * roughly twice the excerpt and lands the clamp on a phrase — which is what
 * duckdb.org/news, MotherDuck, PlanetScale and Tinybird all do with the same
 * content shape.
 *
 * No byline: four of six posts are authored "Query.Farm Team", so a byline
 * column reads as three repetitions of the company name rather than as the
 * credibility signal it is on blogs with named authors. Worth revisiting when
 * posts carry real names.
 */
import { topicTheme } from '../../lib/blog-topics';
import TopicCurves from './TopicCurves.astro';
import SqlKeywordText from './SqlKeywordText.astro';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  tags?: string[];
  slug: string;
  readingTime?: number;
}

const { title, excerpt, date, tags = [], slug, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const isoDate = date.toISOString().slice(0, 10);

const theme = topicTheme(tags[0]);
---

<article class="group relative -mx-4 flex gap-5 rounded-lg px-4 py-6 transition-colors duration-300 hover:bg-[#fffdf7] motion-reduce:transition-none">
  {/* The lead card's contour bundle at row scale, axes swapped — same seed, so
      the topic is recognisably the same figure, just three lines of it running
      down the edge. `phase` shifts the family so the row isn't a literal crop
      of the card. */}
  <TopicCurves
    topic={tags[0]}
    class="hidden w-7 shrink-0 self-stretch sm:block"
    width={260}
    height={44}
    count={3}
    phase={0.35}
    amplitude={0.85}
    vertical
  />

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1 text-[13px] font-medium text-soil-500">
      {theme && <span class={theme.ink}>{theme.label}</span>}
      <time datetime={isoDate} class="qf-figure">{formattedDate}</time>
      {readingTime && <span class="qf-figure">{readingTime} min read</span>}
    </div>

    <h3 class="mt-2 text-[clamp(1.25rem,2.1vw,1.6rem)] leading-[1.18] tracking-[-0.022em]">
      <a
        href={`/blog/${slug}`}
        class="text-soil-900 no-underline transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-link"
      >
        <SqlKeywordText text={title} />
      </a>
    </h3>

    {/* Two lines at full width carries roughly twice the excerpt the 3-up card
        could show, and the clamp lands on a sentence far more often. */}
    <p class="mt-2 line-clamp-2 max-w-[76ch] text-[15.5px] leading-relaxed text-soil-700">
      <SqlKeywordText text={excerpt} />
    </p>

    <div class="mt-3 text-[13px] text-soil-500">
      <span class="text-link opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
        Read →
      </span>
    </div>
  </div>
</article>
