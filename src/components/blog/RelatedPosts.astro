---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  posts: { id: string; description: string }[];
}

const { title, description, posts } = Astro.props;
const entries = new Map((await getCollection('blog')).map(post => [post.id, post]));
// Curate for the page, while keeping titles, dates, and publication status in
// the blog collection. A renamed or mistyped post must not become a dead link.
const stories = posts.flatMap(selection => {
  const post = entries.get(selection.id);
  if (!post) throw new Error(`Unknown related blog post: ${selection.id}`);
  return post.data.draft ? [] : [{ post, description: selection.description }];
});
const dateFor = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

{stories.length > 0 && (
  <section id="stories" aria-labelledby="stories-heading" class="scroll-mt-32 border-t border-soil-300 py-12 sm:py-16 lg:py-[70px]" data-related-posts>
    <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-7">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-[64ch]">
          <p class="qf-eyebrow text-sun-700">From the blog</p>
          <h2 id="stories-heading" class="mt-3 text-3xl text-soil-900 md:text-4xl">{title}</h2>
          <p class="mt-3 text-[17.5px] leading-relaxed text-soil-700">{description}</p>
        </div>
        <a href="/blog/" class="text-sm text-link underline underline-offset-4 hover:text-link-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">All posts <span aria-hidden="true">→</span></a>
      </div>
      <ul role="list" class="mt-8 grid gap-x-12 md:grid-cols-2">
        {stories.map(({ post, description: context }) => (
          <li class="border-t border-soil-300 py-6">
            <p class="mb-3 text-xs text-soil-700">
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)} class="qf-figure">{dateFor(post.data.pubDate)}</time>
            </p>
            <h3 class="text-2xl leading-tight text-soil-900">
              <a href={`/blog/${post.id}/`} class="text-soil-900 underline decoration-soil-400 underline-offset-4 hover:text-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">{post.data.title}</a>
            </h3>
            <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-soil-700">{context}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
