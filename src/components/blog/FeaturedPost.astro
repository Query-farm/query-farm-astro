---
/**
 * The lead post on /blog.
 *
 * Replaced an unbounded block of prose on the page ground whose headline was
 * styled as a heading (`no-underline`, colour on hover only) and whose only CTA
 * was set at 12.5px — smaller than the lede above it. The cards below carried a
 * border, a strip and a hover lift, so the post we most wanted opened looked
 * *less* clickable than the three ranked under it.
 *
 * The fix is a stretched link (`after:absolute after:inset-0`) on the headline:
 * the whole card is one target with one tab stop, and the `group` hover moves
 * the entire card the way PostCard already does. The right column carries the
 * post's own H2s, which is content rather than decoration — it answers "why
 * would I open this" in a way an excerpt can't, and it earns the card's width
 * instead of leaving 40% of it empty.
 */
import { topicTheme } from '../../lib/blog-topics';
import TopicCurves from './TopicCurves.astro';
import SqlKeywordText from './SqlKeywordText.astro';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  tags?: string[];
  slug: string;
  readingTime: number;
  /** The post's H2s, for the contents list. */
  headings?: { text: string }[];
}

const { title, excerpt, date, tags = [], slug, readingTime, headings = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const isoDate = date.toISOString().slice(0, 10);

const theme = topicTheme(tags[0]);

// Four is the most that fits beside the headline at md without the contents
// column running longer than the type it sits next to.
const contents = headings.slice(0, 4);

// "Latest" over "Featured": position already implies the editorial claim, and
// recency is a fact the reader can act on.
const EYEBROW = 'Latest';
---

<article class="group relative overflow-hidden rounded-xl border border-soil-300 bg-[#fffdf7] transition duration-300 ease-out hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_24px_48px_-30px_rgba(33,26,18,0.55)] motion-reduce:transition-none motion-reduce:hover:translate-y-0">
  {/* The card's only artwork, and the reason this index needs no thumbnails:
      a contour bundle drawn from the post's topic, identical every time that
      topic appears. A cropped social card or a lifted figure reads as
      decoration out of context — this reads as a category. */}
  <TopicCurves topic={tags[0]} class="h-28 w-full md:h-32" width={900} height={160} count={3} amplitude={1} />

  <div class="grid gap-x-10 gap-y-6 px-7 py-7 md:grid-cols-[1.4fr_1fr] md:px-9 md:py-9">
    <div>
      <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1.5 text-[13px] font-medium text-soil-500">
        <span class="text-sun-700">{EYEBROW}</span>
        {theme && <span class={theme.ink}>{theme.label}</span>}
        <span class="qf-figure">{readingTime} min read</span>
        <time datetime={isoDate} class="qf-figure">{formattedDate}</time>
      </div>

      <h2 class="mt-3 text-[clamp(1.6rem,3.1vw,2.35rem)] leading-[1.12] tracking-[-0.028em]">
        <a
          href={`/blog/${slug}`}
          class="text-soil-900 no-underline transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-link"
        >
          <SqlKeywordText text={title} />
        </a>
      </h2>

      <p class="mt-3.5 max-w-[52ch] text-[17px] leading-relaxed text-soil-700">
        <SqlKeywordText text={excerpt} />
      </p>

      {/* Not a <button>/<a>: the stretched link above already covers this area,
          so a real control here would be a second tab stop to the same place. */}
      <span
        class="mt-6 inline-block rounded-lg bg-field-700 px-4 py-2 text-[13.5px] font-medium text-white transition-colors group-hover:bg-field-800"
      >
        Read the post →
      </span>
    </div>

    {contents.length > 0 && (
      <div class="md:border-l md:border-soil-200 md:pl-9">
        <h3 class="qf-eyebrow text-soil-500">In this post</h3>
        <ul class="mt-3 space-y-2.5">
          {contents.map(h => (
            <li class="flex gap-2.5 text-[14.5px] leading-snug text-soil-700">
              <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-soil-400" aria-hidden="true"></span>
              <span>{h.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>
