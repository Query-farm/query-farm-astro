---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  author?: string;
  tags?: string[];
  slug: string;
  heroImage?: string;
}

const { title, excerpt, date, author, tags = [], slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Branded header band — a consistent farm-palette gradient keyed to the post's
// topic, instead of cropping OG/social share images into a thumbnail. Every
// card shares one visual system; the full gradient class strings appear as
// literals here so Tailwind's scanner emits them.
const THEMES = [
  { keys: ['webassembly', 'wasm'], label: 'WebAssembly', icon: 'mdi:web',                grad: 'from-duck-400 to-duck-600' },
  { keys: ['rpc'],                 label: 'RPC',         icon: 'mdi:lan-connect',         grad: 'from-earth-500 to-earth-700' },
  { keys: ['distribution'],        label: 'Distribution', icon: 'mdi:truck-fast-outline', grad: 'from-harvest-500 to-harvest-700' },
  { keys: ['testing'],             label: 'Testing',     icon: 'mdi:test-tube',           grad: 'from-harvest-600 to-earth-700' },
  { keys: ['quack'],               label: 'Quack',       icon: 'mdi:duck',                grad: 'from-duck-500 to-earth-600' },
];
const lower = tags.map(t => t.toLowerCase());
const theme = THEMES.find(t => t.keys.some(k => lower.includes(k)));
const band = {
  label: theme ? `DuckDB · ${theme.label}` : 'DuckDB',
  icon: theme?.icon ?? 'mdi:duck',
  grad: theme?.grad ?? 'from-soil-600 to-soil-800',
};
---

<Card href={`/blog/${slug}`} padding="md" class="h-full flex flex-col group overflow-hidden">
  <div class={`relative -m-6 mb-5 h-28 flex items-center px-6 bg-gradient-to-br ${band.grad}`}>
    <Icon name={band.icon} class="absolute -right-3 -bottom-5 w-28 h-28 text-white/15" />
    <div class="relative flex items-center gap-2 text-white">
      <Icon name={band.icon} class="w-5 h-5" />
      <span class="text-sm font-semibold uppercase tracking-wider">{band.label}</span>
    </div>
  </div>

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.slice(0, 3).map(tag => (
        <Badge variant="default" size="sm">
          {tag}
        </Badge>
      ))}
    </div>
  )}

  <h3 class="text-xl font-bold text-soil-900 mb-2 group-hover:text-earth-700 transition-colors">
    {title}
  </h3>

  <p class="text-soil-700 text-sm leading-relaxed mb-4 flex-1 line-clamp-3">
    {excerpt}
  </p>

  <div class="flex items-center gap-4 text-xs text-soil-500 pt-3 border-t border-soil-200">
    {author && (
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        {author}
      </div>
    )}
    <div class="flex items-center">
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      {formattedDate}
    </div>
  </div>

  <div class="mt-3">
    <span class="text-earth-600 text-sm font-medium group-hover:text-earth-700 transition-colors inline-flex items-center">
      Read more
      <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</Card>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
