---
// Editorial card (brief §6, family E). The 6px strip across the top is this
// card's ONLY artwork — no hero crops, no icon wells.
import { topicTheme } from '../../lib/blog-topics';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  author?: string;
  tags?: string[];
  slug: string;
  /** Accepted for API compatibility; cards deliberately show the band strip instead. */
  heroImage?: string;
  /** Minutes, rendered in tabular Commissioner. Omitted on surfaces that don't compute it. */
  readingTime?: number;
}

const { title, excerpt, date, tags = [], slug, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const isoDate = date.toISOString().slice(0, 10);

// The strip is keyed to the post's topic, not to its slug: same topic, same
// colour, every time. See src/lib/blog-topics.ts for the mapping and why the
// old slug-hash version encoded nothing.
const topic = tags[0];
const theme = topicTheme(topic);
---

<a
  href={`/blog/${slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-soil-300 bg-[#fffdf7] no-underline transition duration-300 ease-out hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_20px_40px_-28px_rgba(33,26,18,0.55)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <div class="grid h-1.5 grid-cols-6" aria-hidden="true">
    {(theme?.bands ?? []).map(band => <i style={`background:${band}`}></i>)}
  </div>

  <div class="flex flex-1 flex-col px-5 pt-5 pb-4.5">
    {theme && (
      <span class={`text-[13px] font-medium ${theme.ink}`}>{theme.label}</span>
    )}

    <h3 class="mt-2 text-[21px] leading-[1.16] tracking-[-0.02em] text-soil-900 transition-colors group-hover:text-link">
      {title}
    </h3>

    <p class="mt-2.5 line-clamp-3 flex-1 text-sm leading-relaxed text-soil-700">
      {excerpt}
    </p>

    <div class="mt-4 flex items-baseline justify-between gap-3 border-t border-soil-200 pt-3">
      <time datetime={isoDate} class="qf-figure text-xs text-soil-500">{formattedDate}</time>
      {readingTime && <span class="qf-figure text-xs text-soil-500">{readingTime} min read</span>}
    </div>
  </div>
</a>
