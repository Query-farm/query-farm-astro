---
const paths = [
  { id: 'proxy', label: 'PROXY AN EXISTING DATABASE', title: 'Grainlift server', subtitle: 'Runs the downstream ADBC driver', detail: 'Existing database', sources: 'PostgreSQL · DuckDB · SQLite · more' },
  { id: 'build', label: 'BUILD A NEW DATA SERVICE', title: 'Your Grainlift service', subtitle: 'Built with a Grainlift framework', detail: 'Your code, your data', sources: 'APIs · files · models · business logic' },
];
---
<figure class="architecture" data-grainlift-architecture>
  <div class="drawing-head"><span>FIG. 01 / THE GRAINLIFT ARCHITECTURE</span><div class="flow-legend"><span><i class="request-key" aria-hidden="true"></i> Request ↓</span><span><i class="batch-key" aria-hidden="true"></i> Arrow batch ↑</span><button type="button" data-flow-toggle hidden>Pause flow</button></div></div>
  <svg class="flow-overlay" aria-hidden="true" focusable="false" data-flow-overlay>
    {paths.map((path, index) => <g data-flow-route={path.id}>
      <circle r="4" class="request-dot" opacity="0">
        <animateMotion data-request-motion dur="12s" begin={`${index * 6}s`} repeatCount="indefinite" keyPoints="0;0;1;1" keyTimes="0;0.08;0.32;1" calcMode="linear" />
        <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.079;0.08;0.319;0.32;1" dur="12s" begin={`${index * 6}s`} repeatCount="indefinite" />
      </circle>
      <rect x="-4" y="-4" width="8" height="8" rx="1.5" class="batch-dot" opacity="0">
        <animateMotion data-response-motion dur="12s" begin={`${index * 6}s`} repeatCount="indefinite" keyPoints="1;1;0;0" keyTimes="0;0.48;0.76;1" calcMode="linear" />
        <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.479;0.48;0.759;0.76;1" dur="12s" begin={`${index * 6}s`} repeatCount="indefinite" />
      </rect>
    </g>)}
  </svg>
  <div class="client-apps"><span>Notebooks</span><span>Applications</span><span>Data pipelines</span></div>
  <div class="client-stem" aria-hidden="true"></div>
  <div class="driver"><span class="driver-overline">ORDINARY ADBC OPERATIONS</span><strong>Grainlift ADBC driver</strong><small>One client interface for either path</small></div>
  <div class="transport"><span><strong>VGI-RPC</strong> / Arrow IPC<small>↓ operations & parameters &nbsp; ↑ typed Arrow batches</small></span></div>
  <div class="branches">
    {paths.map(path => <div class={`branch ${path.id}`}>
      <div class="branch-inlet" aria-hidden="true"></div>
      <span class="path-label">{path.label}</span>
      <div class="service">
        <svg viewBox="0 0 76 70" width="76" height="70" fill="none" aria-hidden="true">
          {path.id === 'proxy' ? <>
            <path d="M10 20v32c0 7 12 11 28 11s28-4 28-11V20" fill="#e6daca" stroke="#795b41" stroke-width="1.8"/>
            <ellipse cx="38" cy="20" rx="28" ry="11" fill="#f7f3e8" stroke="#795b41" stroke-width="1.8"/>
            <path d="M10 36c0 7 12 11 28 11s28-4 28-11M10 48c0 7 12 11 28 11s28-4 28-11" stroke="#795b41" stroke-width="1.5"/>
            <path d="M20 35h6m-6 12h6" stroke="#b58530" stroke-width="3"/>
          </> : <>
            <path d="m8 17 45-8 15 11v39l-46 6L8 53Z" fill="#e0e5d3" stroke="#52623d" stroke-width="1.8"/>
            <path d="m8 17 14 10 46-7M22 27v38" stroke="#52623d" stroke-width="1.8"/>
            <path d="m37 37-7 8 7 5m15-15 7 5-7 8m-6-15-4 20" stroke="#52623d" stroke-width="2" stroke-linecap="round"/>
          </>}
        </svg>
        <div><strong>{path.title}</strong><p>{path.subtitle}</p></div>
      </div>
      <div class="policy">Authentication · sessions · limits · cleanup</div>
      <div class="backend-langs">{path.id === 'build' ? 'Rust · Go · Python · TypeScript' : 'Database credentials stay on the server'}</div>
      <div class="source-arrow" aria-hidden="true">↓</div>
      <div class="source"><strong>{path.detail}</strong><small>{path.sources}</small></div>
    </div>)}
  </div>
  <figcaption>Follow a request down either path, then an Arrow batch back to the client. Results are pulled one batch at a time.</figcaption>
</figure>
<style>
  .architecture { position:relative;border:1px solid var(--color-soil-300);border-radius:4px;background:#fffdf7;overflow:hidden; }
  .drawing-head { padding:15px 24px;border-bottom:1px solid var(--color-soil-300);display:flex;align-items:center;justify-content:space-between;gap:16px; }
  .drawing-head>span { font:10px var(--font-mono);letter-spacing:.08em;color:var(--color-soil-600); }
  .flow-legend { display:flex;align-items:center;flex-wrap:wrap;justify-content:center;gap:14px;color:var(--color-soil-700);font-size:11px; }.flow-legend>span { display:flex;align-items:center;gap:6px; }.flow-legend i { display:inline-block;width:8px;height:8px; }.request-key { border-radius:50%;background:var(--color-sun-700); }.batch-key { border-radius:1.5px;background:var(--color-field-700); }
  .flow-legend button { cursor:pointer;padding:5px 9px;border:1px solid var(--color-soil-300);border-radius:4px;color:var(--color-soil-700);font-size:11px; }.flow-legend button:focus-visible { outline:2px solid var(--color-field-700);outline-offset:3px; }
  .flow-overlay { position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1; }.request-dot { fill:var(--color-sun-700);stroke:#fffdf7;stroke-width:1.5; }.batch-dot { fill:var(--color-field-700);stroke:#fffdf7;stroke-width:1.5; }
  .transport>span,.path-label { z-index:2;position:relative;background:#fffdf7; }
  .client-apps { display:flex;justify-content:center;gap:40px;padding:30px 20px 0;color:var(--color-soil-700);font-size:13px; }.client-stem { height:20px;width:1px;margin:auto;background:var(--color-soil-400); }
  .driver { width:min(340px,85%);text-align:center;margin:auto;padding:15px;border:1px solid var(--color-soil-400);box-shadow:4px 4px 0 var(--color-soil-100); }.driver-overline { display:block;font:9px var(--font-mono);letter-spacing:.06em;color:var(--color-soil-600); }.driver strong { display:block;font:600 23px var(--font-display);margin:5px 0; }.driver small { font-size:11px;color:var(--color-soil-600); }
  .transport { height:95px;position:relative;display:flex;justify-content:center;align-items:center;text-align:center; }.transport:before { content:'';position:absolute;inset:0 50%;border-left:1px dashed var(--color-soil-400); }.transport>span { position:relative;background:#fffdf7;padding:8px 14px;font-size:12px;color:var(--color-soil-700); }.transport strong { color:var(--color-field-700);font-weight:500; }.transport small { display:block;font-size:10px;margin-top:5px; }
  .branches { display:grid;grid-template-columns:1fr 1fr;gap:60px;margin:0 55px 30px; }.branch { position:relative;transition:opacity .2s; }.branch-inlet { height:28px;border-top:1px solid var(--color-soil-400);position:relative; }.proxy .branch-inlet { margin-left:50%;margin-right:-30px; }.build .branch-inlet { margin-right:50%;margin-left:-30px; }.branch-inlet:after { content:'';position:absolute;top:0;height:28px;border-left:1px solid var(--color-soil-400); }.proxy .branch-inlet:after { left:0; }.build .branch-inlet:after { right:0; }
  .path-label { display:block;font:10px var(--font-mono);letter-spacing:.07em;color:var(--color-sun-700);margin-bottom:14px;text-align:center; }.build .path-label { color:var(--color-field-700); }.service { border:1px solid var(--color-soil-300);background:var(--color-soil-50);display:flex;align-items:center;gap:16px;padding:16px; }.service svg { flex-shrink:0; }.service strong { font:600 23px var(--font-display); }.service p { font-size:12px;color:var(--color-soil-700);margin-top:5px; }.policy { padding:9px;border:1px solid var(--color-soil-300);border-top:0;font-size:10px;color:var(--color-soil-700);text-align:center;background:var(--color-soil-100); }.backend-langs { min-height:36px;padding-top:12px;text-align:center;font-size:11px;color:var(--color-soil-700); }.source-arrow { text-align:center;color:var(--color-soil-400);font-size:24px;line-height:1.3; }.source { text-align:center;padding-top:4px; }.source strong { display:block;font:600 21px var(--font-display); }.source small { display:block;font-size:11px;color:var(--color-soil-600);margin-top:5px; }
  figcaption { border-top:1px solid var(--color-soil-300);padding:16px 24px;color:var(--color-soil-700);font-size:12px;text-align:center;min-height:53px; }
  @media(prefers-reduced-motion:reduce) { .flow-overlay { display:none; } }
  @media(max-width:700px) { .drawing-head { flex-direction:column;padding:14px; }.client-apps { gap:15px;font-size:11px; }.branches { gap:20px;margin-inline:16px; }.proxy .branch-inlet { margin-right:-10px; }.build .branch-inlet { margin-left:-10px; }.service { flex-direction:column;text-align:center;gap:6px;padding:10px 5px; }.service strong { font-size:19px; }.service p { min-height:34px;font-size:11px; }.policy { min-height:48px;font-size:9px;padding:8px 4px; }.path-label { font-size:9px;min-height:25px; }.backend-langs { min-height:48px;font-size:10px; }.source strong { font-size:18px; }.source small { font-size:10px; }.source { min-height:68px; }figcaption { font-size:11px; } }
</style>
<script>
  const figure = document.querySelector<HTMLElement>('[data-grainlift-architecture]');
  if (figure) {
    const svg = figure.querySelector<SVGSVGElement>('[data-flow-overlay]')!;
    const toggle = figure.querySelector<HTMLButtonElement>('[data-flow-toggle]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let pausedByUser = false;
    let visible = false;
    const updatePlayback = () => {
      toggle.hidden = reducedMotion.matches;
      toggle.textContent = pausedByUser ? 'Play flow' : 'Pause flow';
      if (pausedByUser || reducedMotion.matches || !visible || document.hidden) svg.pauseAnimations();
      else svg.unpauseAnimations();
    };
    const updateRoutes = () => {
      const bounds = svg.getBoundingClientRect();
      const driver = figure.querySelector('.driver')!.getBoundingClientRect();
      const startX = driver.left + driver.width / 2 - bounds.left;
      const startY = driver.bottom - bounds.top;
      svg.querySelectorAll<SVGGElement>('[data-flow-route]').forEach(group => {
        const branch = figure.querySelector(`.branch.${group.dataset.flowRoute}`)!;
        const inlet = branch.querySelector('.branch-inlet')!.getBoundingClientRect();
        const service = branch.querySelector('.service')!.getBoundingClientRect();
        const endX = service.left + service.width / 2 - bounds.left;
        const endY = service.top - bounds.top;
        const junctionY = inlet.top - bounds.top;
        const route = `M ${startX} ${startY} V ${junctionY} H ${endX} V ${endY}`;
        group.querySelectorAll('animateMotion').forEach(motion => motion.setAttribute('path', route));
      });
    };
    svg.pauseAnimations();
    new ResizeObserver(updateRoutes).observe(figure);
    new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      updatePlayback();
    }).observe(figure);
    toggle.addEventListener('click', () => { pausedByUser = !pausedByUser; updatePlayback(); });
    reducedMotion.addEventListener('change', () => { updateRoutes(); updatePlayback(); });
    document.addEventListener('visibilitychange', updatePlayback);
    updateRoutes();
    updatePlayback();
  }
</script>
