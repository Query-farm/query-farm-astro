---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from '../docs/ExtensionSection.astro';
import { Icon } from 'astro-icon/components';
import { HAYBARN_VERSION_TAGS } from '../../data/haybarn-versions';

// A Haybarn release is cut per DuckDB version — Haybarn v1.5.5 ships DuckDB
// 1.5.5 — so an extension's supported DuckDB versions name the Haybarn releases
// that carry it. The map holds only the featured release, so older versions
// resolve to null and the row just omits the line rather than guessing a tag.
const haybarnFor = (duckdbVersion: string): { rc: string; href: string } | null => {
  const key = `v${duckdbVersion}`;
  const tag = HAYBARN_VERSION_TAGS[key];
  return tag ? { rc: tag.replace(/^haybarn-v/, ''), href: `/haybarn/status/${key}` } : null;
};

// Platform with architecture support
interface PlatformInfo {
  platform: string;
  architectures: string[];
}

interface Props {
  githubUrl: string;
  githubStars?: number;
  usageStats?: {
    count: number;
    period: string; // e.g., "last 60 days"
  };
  license?: string; // e.g., "MIT", "Apache 2.0"
  licenseHref?: string; // Optional link to the license's full text / explainer page
  pricing?: 'free' | 'paid' | 'freemium';
  firstRelease?: string; // ISO date string (e.g., '2024-03-01')
  lastRelease?: string; // ISO date string (e.g., '2025-01-15')
  binarySize?: string; // Human-readable size (e.g., '2.4 MB')
  writtenIn?: string; // Programming language (e.g., 'C++', 'Rust')
  sourceAvailable?: boolean | string; // true/false or URL to source
  dependencies?: string[]; // List of required extension names
  platforms?: PlatformInfo[]; // Platform with architectures
  duckdbVersions?: string[]; // Supported versions (e.g., ['1.1.0', '1.1.1', '1.1.2', '1.1.3'])
  binarySizes?: { platform: string; architecture: string; bytes: number }[];
}

const {
  githubUrl,
  githubStars,
  usageStats,
  license,
  licenseHref,
  pricing = 'free',
  firstRelease,
  lastRelease,
  binarySize,
  writtenIn,
  sourceAvailable,
  dependencies,
  platforms = [],
  duckdbVersions = [],
  binarySizes
} = Astro.props;

// Never fabricate compatibility. When the extension reports no platform or
// version data, show an honest "not recorded" state rather than inventing a
// platform matrix or a list of DuckDB versions the extension was never tested
// against.
const hasPlatforms = platforms.length > 0;
const hasVersions = duckdbVersions.length > 0;

function formatBytes(n: number): string {
  if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(2) + ' MB';
  if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
  return n + ' B';
}

// Format date for display
function formatReleaseDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Pricing badge config
const pricingConfig = {
  free: { bg: 'bg-field-600/10', text: 'text-field-700', border: 'border-field-600/45', label: 'Free' },
  paid: { bg: 'bg-sun-400/12', text: 'text-sun-700', border: 'border-sun-400', label: 'Paid' },
  freemium: { bg: 'bg-sun-400/12', text: 'text-sun-700', border: 'border-sun-400', label: 'Freemium' }
};

// Platform icons mapping to Simple Icons
const platformIcons: Record<string, string> = {
  'Linux': 'simple-icons:linux',
  'Linux (musl)': 'simple-icons:linux',
  'Windows': 'simple-icons:windows',
  'macOS': 'simple-icons:apple',
  'WASM': 'simple-icons:webassembly'
};

// Canonical list — render every row even if the extension doesn't ship for
// some of them. Unsupported rows render greyed-out so the user can see at a
// glance "this extension is not available on WASM" rather than wondering why
// WASM is just missing from the list.
const CANONICAL_PLATFORMS = ['Linux', 'Linux (musl)', 'macOS', 'Windows', 'WASM'] as const;
const supportedByName = new Map(platforms.map((p) => [p.platform, p]));
type DisplayPlatform = { platform: string; architectures: string[]; supported: boolean };
const displayPlatforms: DisplayPlatform[] = CANONICAL_PLATFORMS.map((name) => {
  const hit = supportedByName.get(name);
  return hit
    ? { platform: hit.platform, architectures: hit.architectures, supported: true }
    : { platform: name, architectures: [], supported: false };
});
// Surface anything the extension reports that isn't in the canonical set
// (so we don't silently drop e.g. a future "FreeBSD" row).
for (const p of platforms) {
  if (!CANONICAL_PLATFORMS.includes(p.platform as (typeof CANONICAL_PLATFORMS)[number])) {
    displayPlatforms.push({ platform: p.platform, architectures: p.architectures, supported: true });
  }
}
---

<ExtensionSection id="compatibility" background="soil" class="border-y border-soil-200">
  <SectionHeader
    eyebrow="Platform Support"
    title="Compatibility"
    description="Extension availability may vary by platform and DuckDB version. Check below to ensure this extension supports your environment before installation."
    class="mb-12"
  />
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Info & Links -->
        <Card padding="lg" class="flex flex-col">
          <h3 class="text-lg font-semibold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-sun-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Quick Facts
          </h3>

          <!-- Extension Details -->
          <div class="mb-4 space-y-2.5">
            <!-- License -->
            <div class="flex items-start justify-between gap-4 text-sm">
              <span class="text-soil-600 shrink-0">Software License</span>
              {license ? (
                licenseHref
                  ? <a href={licenseHref} class="flex-1 text-right font-medium text-link hover:text-link-hover underline underline-offset-2 break-words">{license}</a>
                  : <span class="flex-1 text-right font-medium text-soil-900 break-words">{license}</span>
              ) : (
                <span class="flex-1 text-right font-medium text-soil-400 italic break-words">Not specified</span>
              )}
            </div>
            <!-- Pricing -->
            <div class="flex items-center justify-between text-sm">
              <span class="text-soil-600">Pricing</span>
              {pricing === 'free' ? (
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[12.5px] font-medium border ${pricingConfig[pricing].bg} ${pricingConfig[pricing].text} ${pricingConfig[pricing].border}`}>
                  {pricingConfig[pricing].label}
                </span>
              ) : (
                <a href="#pricing" class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[12.5px] font-medium border ${pricingConfig[pricing].bg} ${pricingConfig[pricing].text} ${pricingConfig[pricing].border} hover:opacity-80 transition-opacity`}>
                  {pricingConfig[pricing].label}
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              )}
            </div>
            <!-- First Release -->
            {firstRelease && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">First Released</span>
                <span class="font-medium text-soil-900">{formatReleaseDate(firstRelease)}</span>
              </div>
            )}
            <!-- Last Release -->
            {lastRelease && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Last Release</span>
                <span class="font-medium text-soil-900">{formatReleaseDate(lastRelease)}</span>
              </div>
            )}
            <!-- Binary Size -->
            {binarySize && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Binary Size</span>
                <span class="qf-figure text-soil-900">~{binarySize}</span>
              </div>
            )}
            <!-- Written In -->
            {writtenIn && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Written In</span>
                <span class="font-medium text-soil-900">{writtenIn}</span>
              </div>
            )}
            <!-- Source Available -->
            {sourceAvailable !== undefined && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Source Available</span>
                {typeof sourceAvailable === 'string' ? (
                  <a href={sourceAvailable} target="_blank" rel="noopener noreferrer" class="font-medium text-link hover:text-link-hover flex items-center gap-1">
                    Yes
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                  <span class={`font-medium ${sourceAvailable ? 'text-field-700' : 'text-soil-500'}`}>
                    {sourceAvailable ? 'Yes' : 'No'}
                  </span>
                )}
              </div>
            )}
            <!-- Dependencies -->
            {dependencies && dependencies.length > 0 && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Dependencies</span>
                <span class="font-mono font-medium text-soil-900">{dependencies.join(', ')}</span>
              </div>
            )}
          </div>

          <div class="border-t border-soil-200 pt-4 mb-4"></div>

          <!-- Links -->
          <div class="space-y-3 flex-1">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 bg-soil-50 hover:bg-soil-100 rounded-lg border border-soil-200 hover:border-sun-400 transition-all group"
            >
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-soil-700" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span class="font-medium text-soil-900 group-hover:text-link">View on GitHub</span>
              </div>
              {githubStars && (
                <div class="flex items-center gap-1 text-sm text-soil-600">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span class="qf-figure">{githubStars.toLocaleString()}</span>
                </div>
              )}
            </a>

            {usageStats && (
              <div class="rounded-lg border border-soil-300 bg-soil-50 p-3">
                <div class="text-[12.5px] font-medium text-soil-500">Usage</div>
                <div class="load-count mt-1 text-2xl leading-none text-sun-700">
                  {usageStats.count.toLocaleString()}
                </div>
                <div class="mt-1.5 text-[12.5px] font-medium text-soil-600">
                  loads · {usageStats.period}
                </div>
              </div>
            )}
          </div>
        </Card>

        <!-- Platforms & Versions -->
        <div class="flex flex-col gap-6">
          <!-- Platforms -->
          <Card padding="lg" class="flex flex-col">
            <h3 class="text-lg font-semibold text-soil-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-sun-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
              Platforms
            </h3>

            {!hasPlatforms && (
              <p class="text-sm text-soil-500 italic">Platform availability hasn't been recorded for this extension yet.</p>
            )}

            {/* One row per platform: name on the left, what you actually get on
                the right. This replaces a cell grid whose auto-fill left a
                ragged blank tail — there are only ever three or four platforms,
                so the grid never filled its last row. Folding the architectures
                in as the row's value also retires the "Supported platform
                architectures" disclosure: it was hiding the one fact the row
                had room to show. */}
            {hasPlatforms && (
              <ul class="divide-y divide-soil-200 overflow-hidden rounded-lg border border-soil-300">
                {displayPlatforms.map((platformInfo) => {
                  const iconName = platformIcons[platformInfo.platform];
                  // Each architecture is its own chip in field green — the same
                  // "this is available" green the Supported row uses below, so
                  // availability reads down the card in one colour. Unsupported
                  // rows stay uncoloured on purpose: absence should recede.
                  const archs = platformInfo.architectures.length > 0
                    ? platformInfo.architectures
                    : ['Browser-based'];
                  return (
                    <li class="flex items-center justify-between gap-3 bg-white px-3 py-2.5">
                      <span class={`flex items-center gap-2 text-[14px] ${platformInfo.supported ? 'text-soil-700' : 'text-soil-400'}`}>
                        {iconName && <Icon name={iconName} class={`w-4 h-4 flex-none ${platformInfo.supported ? 'text-cat-field-ink' : 'text-soil-300'}`} />}
                        {platformInfo.platform}
                      </span>
                      {platformInfo.supported ? (
                        <span class="flex flex-wrap justify-end gap-1">
                          {archs.map((arch) => (
                            <span class="rounded-full border border-cat-field-ink/40 bg-cat-field px-2 py-0.5 font-mono text-[11px] text-cat-field-ink">
                              {arch}
                            </span>
                          ))}
                        </span>
                      ) : (
                        <span class="text-right text-[12.5px] italic text-soil-400">Not available</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}

            {binarySizes && binarySizes.length > 0 && (
              <details class="group mt-2">
                <summary class="flex items-center gap-2 cursor-pointer text-sm font-medium text-soil-500 hover:text-soil-700 transition-colors">
                  <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span>Compiled binary sizes</span>
                </summary>
                <div class="mt-3 pt-3 border-t border-soil-200">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="text-left text-[12.5px] text-soil-500">
                        <th class="font-medium pb-2">Platform</th>
                        <th class="font-medium pb-2">Architecture</th>
                        <th data-numeric class="font-medium pb-2 text-right">Size</th>
                      </tr>
                    </thead>
                    <tbody>
                      {binarySizes.map((s) => (
                        <tr class="border-t border-soil-200">
                          <td class="py-1.5 text-soil-700 font-medium">{s.platform}</td>
                          <td class="py-1.5 text-soil-600">{s.architecture}</td>
                          <td data-numeric class="py-1.5 text-right text-soil-700">{formatBytes(s.bytes)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="text-[12.5px] text-soil-500 mt-2">Compressed download size from the Haybarn extension repository.</p>
                </div>
              </details>
            )}
          </Card>

          <!-- DuckDB Versions -->
          <Card padding="lg" class="flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-soil-900 flex items-center gap-2">
                <svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                  <circle cx="50" cy="50" r="48" fill="#111111"/>
                  <circle cx="40" cy="50" r="18" fill="#FFF000"/>
                  <ellipse cx="68" cy="50" rx="8" ry="6" fill="#FFF000"/>
                </svg>
                DuckDB &amp; Haybarn
              </h3>
              <a
                href="https://duckdb.org/docs/dev/release_calendar"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[12.5px] text-soil-500 hover:text-link flex items-center gap-1 transition-colors"
              >
                Release calendar
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            {/* Rows, matching the platform list above. The old grid put a ✓
                under every version, which said nothing — `duckdbVersions` only
                ever lists versions that are supported — while its auto-fill
                stretched a lone version across the full card. */}
            {hasVersions ? (
              <ul class="divide-y divide-soil-200 overflow-hidden rounded-lg border border-soil-300">
                {duckdbVersions.map((version) => {
                  const haybarn = haybarnFor(version);
                  return (
                    <li class="flex items-center justify-between gap-3 bg-white px-3 py-2.5">
                      <span class="min-w-0">
                        <span class="qf-figure block text-[14px] text-soil-700">DuckDB v{version}</span>
                        {haybarn && (
                          <a
                            href={haybarn.href}
                            class="mt-0.5 block text-[12.5px] text-soil-500 no-underline transition-colors hover:text-link"
                          >
                            Haybarn <span class="qf-figure">{haybarn.rc}</span>
                          </a>
                        )}
                      </span>
                      <span class="inline-flex flex-none items-center gap-1.5 rounded-full border border-cat-field-ink/40 bg-cat-field px-2 py-0.5 text-[12.5px] font-medium text-cat-field-ink">
                        <svg class="h-3 w-3 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="4 12.5 9.5 18 20 6" />
                        </svg>
                        Supported
                      </span>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <span class="text-sm italic text-soil-500">Not recorded for this extension.</span>
            )}
          </Card>
        </div>
      </div>
</ExtensionSection>
