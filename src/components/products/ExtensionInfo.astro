---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from '../docs/ExtensionSection.astro';
import { Icon } from 'astro-icon/components';

// Platform with architecture support
interface PlatformInfo {
  platform: string;
  architectures: string[];
}

interface Props {
  githubUrl: string;
  githubStars?: number;
  usageStats?: {
    count: number;
    period: string; // e.g., "last 60 days"
  };
  license?: string; // e.g., "MIT", "Apache 2.0"
  pricing?: 'free' | 'paid' | 'freemium';
  firstRelease?: string; // ISO date string (e.g., '2024-03-01')
  lastRelease?: string; // ISO date string (e.g., '2025-01-15')
  binarySize?: string; // Human-readable size (e.g., '2.4 MB')
  writtenIn?: string; // Programming language (e.g., 'C++', 'Rust')
  sourceAvailable?: boolean | string; // true/false or URL to source
  dependencies?: string[]; // List of required extension names
  platforms?: PlatformInfo[]; // Platform with architectures
  duckdbVersions?: string[]; // Supported versions (e.g., ['1.1.0', '1.1.1', '1.1.2', '1.1.3'])
  binarySizes?: { platform: string; architecture: string; bytes: number }[];
}

const defaultPlatforms: PlatformInfo[] = [
  { platform: 'Linux', architectures: ['x86_64', 'aarch64'] },
  { platform: 'macOS', architectures: ['Apple Silicon', 'Intel'] },
  { platform: 'Windows', architectures: ['x86_64'] },
  { platform: 'WASM', architectures: [] }
];

const {
  githubUrl,
  githubStars,
  usageStats,
  license = 'MIT',
  pricing = 'free',
  firstRelease,
  lastRelease,
  binarySize,
  writtenIn,
  sourceAvailable,
  dependencies,
  platforms = defaultPlatforms,
  duckdbVersions = ['1.1.0', '1.1.1', '1.1.2', '1.1.3'],
  binarySizes
} = Astro.props;

function formatBytes(n: number): string {
  if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(2) + ' MB';
  if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
  return n + ' B';
}

// Format date for display
function formatReleaseDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Generate progressive OKLCH colors for versions (green -> blue gradient)
// Versions are expected to be in order from oldest to newest
function getVersionColor(index: number, total: number) {
  // Progress from green (140) to blue (240) as versions get newer
  const startHue = 140; // Green
  const endHue = 240;   // Blue
  const progress = total > 1 ? index / (total - 1) : 0.5;
  const hue = startHue + (endHue - startHue) * progress;

  // Use OKLCH for perceptually uniform colors
  const bgColor = `oklch(0.90 0.12 ${hue})`;
  const textColor = `oklch(0.30 0.20 ${hue})`;
  const borderColor = `oklch(0.65 0.18 ${hue})`;

  return { bgColor, textColor, borderColor };
}

// Pricing badge config
const pricingConfig = {
  free: { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-300', label: 'Free' },
  paid: { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-300', label: 'Paid' },
  freemium: { bg: 'bg-purple-100', text: 'text-purple-800', border: 'border-purple-300', label: 'Freemium' }
};

// Platform icons mapping to Simple Icons
const platformIcons: Record<string, string> = {
  'Linux': 'simple-icons:linux',
  'Linux (musl)': 'simple-icons:linux',
  'Windows': 'simple-icons:windows',
  'macOS': 'simple-icons:apple',
  'WASM': 'simple-icons:webassembly'
};

// Canonical list — render every row even if the extension doesn't ship for
// some of them. Unsupported rows render greyed-out so the user can see at a
// glance "this extension is not available on WASM" rather than wondering why
// WASM is just missing from the list.
const CANONICAL_PLATFORMS = ['Linux', 'Linux (musl)', 'macOS', 'Windows', 'WASM'] as const;
const supportedByName = new Map(platforms.map((p) => [p.platform, p]));
type DisplayPlatform = { platform: string; architectures: string[]; supported: boolean };
const displayPlatforms: DisplayPlatform[] = CANONICAL_PLATFORMS.map((name) => {
  const hit = supportedByName.get(name);
  return hit
    ? { platform: hit.platform, architectures: hit.architectures, supported: true }
    : { platform: name, architectures: [], supported: false };
});
// Surface anything the extension reports that isn't in the canonical set
// (so we don't silently drop e.g. a future "FreeBSD" row).
for (const p of platforms) {
  if (!CANONICAL_PLATFORMS.includes(p.platform as (typeof CANONICAL_PLATFORMS)[number])) {
    displayPlatforms.push({ platform: p.platform, architectures: p.architectures, supported: true });
  }
}
---

<ExtensionSection id="compatibility" background="soil" class="border-y border-soil-200">
  <SectionHeader
    eyebrow="Platform Support"
    title="Compatibility"
    description="Extension availability may vary by platform and DuckDB version. Check below to ensure this extension supports your environment before installation."
    class="mb-12"
  />
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Info & Links -->
        <Card padding="lg" class="flex flex-col">
          <h3 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Quick Facts
          </h3>

          <!-- Extension Details -->
          <div class="mb-4 space-y-2.5">
            <!-- License -->
            <div class="flex items-center justify-between text-sm">
              <span class="text-soil-600">Software License</span>
              <span class="font-mono font-medium text-soil-900">{license}</span>
            </div>
            <!-- Pricing -->
            <div class="flex items-center justify-between text-sm">
              <span class="text-soil-600">Pricing</span>
              {pricing === 'free' ? (
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border ${pricingConfig[pricing].bg} ${pricingConfig[pricing].text} ${pricingConfig[pricing].border}`}>
                  {pricingConfig[pricing].label}
                </span>
              ) : (
                <a href="#pricing" class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium border ${pricingConfig[pricing].bg} ${pricingConfig[pricing].text} ${pricingConfig[pricing].border} hover:opacity-80 transition-opacity`}>
                  {pricingConfig[pricing].label}
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              )}
            </div>
            <!-- First Release -->
            {firstRelease && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">First Released</span>
                <span class="font-medium text-soil-900">{formatReleaseDate(firstRelease)}</span>
              </div>
            )}
            <!-- Last Release -->
            {lastRelease && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Last Release</span>
                <span class="font-medium text-soil-900">{formatReleaseDate(lastRelease)}</span>
              </div>
            )}
            <!-- Binary Size -->
            {binarySize && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Binary Size</span>
                <span class="font-mono font-medium text-soil-900">~{binarySize}</span>
              </div>
            )}
            <!-- Written In -->
            {writtenIn && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Written In</span>
                <span class="font-medium text-soil-900">{writtenIn}</span>
              </div>
            )}
            <!-- Source Available -->
            {sourceAvailable !== undefined && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Source Available</span>
                {typeof sourceAvailable === 'string' ? (
                  <a href={sourceAvailable} target="_blank" rel="noopener noreferrer" class="font-medium text-harvest-700 hover:text-harvest-800 flex items-center gap-1">
                    Yes
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                  <span class={`font-medium ${sourceAvailable ? 'text-green-700' : 'text-soil-500'}`}>
                    {sourceAvailable ? 'Yes' : 'No'}
                  </span>
                )}
              </div>
            )}
            <!-- Dependencies -->
            {dependencies && dependencies.length > 0 && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-soil-600">Dependencies</span>
                <span class="font-mono font-medium text-soil-900">{dependencies.join(', ')}</span>
              </div>
            )}
          </div>

          <div class="border-t border-soil-200 pt-4 mb-4"></div>

          <!-- Links -->
          <div class="space-y-3 flex-1">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 bg-soil-50 hover:bg-soil-100 rounded-lg border border-soil-200 hover:border-harvest-400 transition-all group"
            >
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-soil-700" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span class="font-medium text-soil-900 group-hover:text-harvest-700">View on GitHub</span>
              </div>
              {githubStars && (
                <div class="flex items-center gap-1 text-sm text-soil-600">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span class="font-semibold">{githubStars.toLocaleString()}</span>
                </div>
              )}
            </a>

            {usageStats && (
              <div class="p-3 bg-gradient-to-br from-harvest-50 to-grain-50 rounded-lg border border-harvest-200">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="w-4 h-4 text-harvest-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                  <span class="text-xs font-medium text-harvest-700 uppercase tracking-wide">Usage</span>
                </div>
                <div class="text-2xl font-bold text-soil-900">
                  {usageStats.count.toLocaleString()}+
                </div>
                <div class="text-xs text-soil-600 mt-1">
                  loads in {usageStats.period}
                </div>
              </div>
            )}
          </div>
        </Card>

        <!-- Platforms & Versions -->
        <div class="flex flex-col gap-6">
          <!-- Platforms -->
          <Card padding="lg" class="flex flex-col">
            <h3 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
              Platforms
            </h3>

            <!-- Platform Icons Row -->
            <div class="flex flex-wrap gap-3 mb-4">
              {displayPlatforms.map((platformInfo) => {
                const iconName = platformIcons[platformInfo.platform];
                return platformInfo.supported ? (
                  <div class="flex items-center gap-2 px-3 py-2 bg-white border border-soil-200 rounded-lg">
                    {iconName && <Icon name={iconName} class="w-5 h-5 text-soil-700" />}
                    <span class="font-medium text-soil-900 text-sm">{platformInfo.platform}</span>
                  </div>
                ) : (
                  <div
                    class="flex items-center gap-2 px-3 py-2 bg-soil-50 border border-soil-200 rounded-lg opacity-60"
                    aria-disabled="true"
                    title={`${platformInfo.platform} is not available for this extension`}
                  >
                    {iconName && <Icon name={iconName} class="w-5 h-5 text-soil-400" />}
                    <span class="font-medium text-soil-400 text-sm">{platformInfo.platform}</span>
                  </div>
                );
              })}
            </div>

            <!-- Supported Platform Architectures (Collapsible) -->
            <details class="group">
              <summary class="flex items-center gap-2 cursor-pointer text-sm font-medium text-soil-500 hover:text-soil-700 transition-colors">
                <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span>Supported platform architectures</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-soil-200">
                <div class="grid grid-cols-2 gap-2">
                  {displayPlatforms.map((platformInfo) => (
                    <div class={`text-sm ${platformInfo.supported ? '' : 'opacity-60'}`}>
                      <span class={`font-medium ${platformInfo.supported ? 'text-soil-700' : 'text-soil-400'}`}>{platformInfo.platform}:</span>
                      <span class={`ml-1 ${platformInfo.supported ? 'text-soil-600' : 'text-soil-400 italic'}`}>
                        {platformInfo.supported
                          ? (platformInfo.architectures.length > 0
                              ? platformInfo.architectures.join(', ')
                              : 'Browser-based')
                          : 'Not available'}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </details>

            {binarySizes && binarySizes.length > 0 && (
              <details class="group mt-2">
                <summary class="flex items-center gap-2 cursor-pointer text-sm font-medium text-soil-500 hover:text-soil-700 transition-colors">
                  <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span>Compiled binary sizes</span>
                </summary>
                <div class="mt-3 pt-3 border-t border-soil-200">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="text-left text-xs uppercase tracking-wide text-soil-500">
                        <th class="font-medium pb-2">Platform</th>
                        <th class="font-medium pb-2">Architecture</th>
                        <th class="font-medium pb-2 text-right">Size</th>
                      </tr>
                    </thead>
                    <tbody>
                      {binarySizes.map((s) => (
                        <tr class="border-t border-soil-200">
                          <td class="py-1.5 text-soil-700 font-medium">{s.platform}</td>
                          <td class="py-1.5 text-soil-600">{s.architecture}</td>
                          <td class="py-1.5 text-soil-700 text-right font-mono tabular-nums">{formatBytes(s.bytes)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="text-xs text-soil-500 mt-2">Gzipped download size from the DuckDB community-extensions registry.</p>
                </div>
              </details>
            )}
          </Card>

          <!-- DuckDB Versions -->
          <Card padding="lg" class="flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-soil-900 flex items-center gap-2">
                <svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                  <circle cx="50" cy="50" r="48" fill="#111111"/>
                  <circle cx="40" cy="50" r="18" fill="#FFF000"/>
                  <ellipse cx="68" cy="50" rx="8" ry="6" fill="#FFF000"/>
                </svg>
                DuckDB Versions
              </h3>
              <a
                href="https://duckdb.org/docs/dev/release_calendar"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-soil-500 hover:text-harvest-700 flex items-center gap-1 transition-colors"
              >
                Release calendar
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <!-- Supported Versions -->
            <div class="mb-2">
              <span class="text-xs font-medium text-soil-500 tracking-wide">Supported</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {duckdbVersions.map((version, index) => {
                const colors = getVersionColor(index, duckdbVersions.length);
                return (
                  <span
                    class="inline-flex items-center px-3 py-2 rounded-md text-base font-semibold font-mono border"
                    style={`background-color: ${colors.bgColor}; color: ${colors.textColor}; border-color: ${colors.borderColor};`}
                  >
                    v{version}
                  </span>
                );
              })}
            </div>
          </Card>
        </div>
      </div>
</ExtensionSection>
