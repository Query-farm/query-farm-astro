---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  githubUrl: string;
  githubStars?: number;
  usageStats?: {
    count: number;
    period: string; // e.g., "last 60 days"
  };
  license?: string; // e.g., "MIT", "Apache 2.0"
  pricing?: 'free' | 'paid' | 'freemium';
  platforms?: string[];
  duckdbVersions?: string[];
}

const {
  githubUrl,
  githubStars,
  usageStats,
  license = 'MIT',
  pricing = 'free',
  platforms = ['Linux', 'Windows', 'macOS', 'WASM'],
  duckdbVersions = ['1.4', '1.5']
} = Astro.props;

// Pricing badge config
const pricingConfig = {
  free: { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-300', label: 'Free' },
  paid: { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-300', label: 'Paid' },
  freemium: { bg: 'bg-purple-100', text: 'text-purple-800', border: 'border-purple-300', label: 'Freemium' }
};

// Platform icons mapping to Simple Icons
const platformIcons: Record<string, string> = {
  'Linux': 'simple-icons:linux',
  'Windows': 'simple-icons:windows',
  'macOS': 'simple-icons:apple',
  'WASM': 'simple-icons:webassembly'
};
---

<section class="py-12 bg-soil-50 border-y border-soil-200">
  <div class="section-container">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-4 gap-6">
        <!-- Info & Links -->
        <Card padding="lg" class="flex flex-col md:col-span-2">
          <h3 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Extension Info
          </h3>

          <!-- License & Pricing -->
          <div class="mb-4 space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-soil-600">License</span>
              <span class="font-mono font-medium text-soil-900">{license}</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-soil-600">Pricing</span>
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border ${pricingConfig[pricing].bg} ${pricingConfig[pricing].text} ${pricingConfig[pricing].border}`}>
                {pricingConfig[pricing].label}
              </span>
            </div>
          </div>

          <div class="border-t border-soil-200 pt-4 mb-4"></div>

          <!-- Links -->
          <div class="space-y-3 flex-1">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 bg-soil-50 hover:bg-soil-100 rounded-lg border border-soil-200 hover:border-harvest-400 transition-all group"
            >
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-soil-700" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span class="font-medium text-soil-900 group-hover:text-harvest-700">View on GitHub</span>
              </div>
              {githubStars && (
                <div class="flex items-center gap-1 text-sm text-soil-600">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span class="font-semibold">{githubStars.toLocaleString()}</span>
                </div>
              )}
            </a>

            {usageStats && (
              <div class="p-3 bg-gradient-to-br from-harvest-50 to-grain-50 rounded-lg border border-harvest-200">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="w-4 h-4 text-harvest-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                  <span class="text-xs font-medium text-harvest-700 uppercase tracking-wide">Usage</span>
                </div>
                <div class="text-2xl font-bold text-soil-900">
                  {usageStats.count.toLocaleString()}+
                </div>
                <div class="text-xs text-soil-600 mt-1">
                  uses in {usageStats.period}
                </div>
              </div>
            )}
          </div>
        </Card>

        <!-- Supported Platforms -->
        <Card padding="lg" class="flex flex-col">
          <h3 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
            Supported Platforms
          </h3>
          <div class="flex flex-wrap gap-2">
            {platforms.map((platform) => (
              <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-soil-200 rounded-md text-sm font-medium text-soil-900">
                <Icon name={platformIcons[platform] || platformIcons['WASM']} class="w-4 h-4 text-soil-700" />
                <span>{platform}</span>
              </div>
            ))}
          </div>
        </Card>

        <!-- DuckDB Versions -->
        <Card padding="lg" class="flex flex-col">
          <h3 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            DuckDB Versions
          </h3>
          <div class="flex flex-wrap gap-2">
            {duckdbVersions.map((version) => (
              <Badge variant="success" size="md" class="font-mono">
                v{version}
              </Badge>
            ))}
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
