---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface ChangelogEntry {
  version: string;
  date: string;
  type?: 'major' | 'minor' | 'patch';
  changes: {
    category: 'added' | 'changed' | 'deprecated' | 'removed' | 'fixed' | 'security';
    items: string[];
  }[];
}

interface Props {
  entries: ChangelogEntry[];
  showAll?: boolean; // If false, only show latest 3 releases
}

const { entries, showAll = false } = Astro.props;

const displayEntries = showAll ? entries : entries.slice(0, 3);

// Category styling
const categoryConfig = {
  added: { bg: 'bg-green-100', text: 'text-green-800', icon: '✨', label: 'Added' },
  changed: { bg: 'bg-blue-100', text: 'text-blue-800', icon: '🔄', label: 'Changed' },
  deprecated: { bg: 'bg-orange-100', text: 'text-orange-800', icon: '⚠️', label: 'Deprecated' },
  removed: { bg: 'bg-red-100', text: 'text-red-800', icon: '🗑️', label: 'Removed' },
  fixed: { bg: 'bg-purple-100', text: 'text-purple-800', icon: '🐛', label: 'Fixed' },
  security: { bg: 'bg-red-100', text: 'text-red-900', icon: '🔒', label: 'Security' }
};

// Version badge styling
const versionTypeConfig = {
  major: { bg: 'bg-red-100', text: 'text-red-800', border: 'border-red-300' },
  minor: { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-300' },
  patch: { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-300' }
};
---

<section class="py-16 lg:py-24 bg-white">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <SectionHeader
        eyebrow="Changelog"
        title="Release Notes"
        description="Track the latest updates, improvements, and bug fixes."
        class="mb-12"
      />

      <div class="space-y-8">
        {displayEntries.map((entry, index) => (
          <Card padding="lg" class={index === 0 ? 'border-2 border-harvest-400' : ''}>
            <!-- Version Header -->
            <div class="flex items-start justify-between mb-6">
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-2xl font-bold text-soil-900 font-mono">
                    v{entry.version}
                  </h3>
                  {index === 0 && (
                    <span class="px-2 py-1 bg-harvest-100 text-harvest-800 border border-harvest-300 rounded text-xs font-semibold uppercase tracking-wide">
                      Latest
                    </span>
                  )}
                  {entry.type && (
                    <span class={`px-2 py-0.5 rounded text-xs font-medium border ${versionTypeConfig[entry.type].bg} ${versionTypeConfig[entry.type].text} ${versionTypeConfig[entry.type].border}`}>
                      {entry.type}
                    </span>
                  )}
                </div>
                <div class="text-sm text-soil-600">
                  Released on {new Date(entry.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </div>
              </div>
            </div>

            <!-- Changes by Category -->
            <div class="space-y-6">
              {entry.changes.map((changeGroup) => (
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold ${categoryConfig[changeGroup.category].bg} ${categoryConfig[changeGroup.category].text}`}>
                      <span>{categoryConfig[changeGroup.category].icon}</span>
                      {categoryConfig[changeGroup.category].label}
                    </span>
                  </div>
                  <ul class="space-y-2 ml-4">
                    {changeGroup.items.map((item) => (
                      <li class="text-sm text-soil-700 flex items-start gap-2">
                        <span class="text-soil-400 mt-1">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </Card>
        ))}
      </div>

      {!showAll && entries.length > 3 && (
        <div class="mt-8 text-center">
          <a
            href="#"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white hover:bg-soil-50 border-2 border-soil-300 hover:border-harvest-500 rounded-lg font-medium text-soil-900 hover:text-harvest-800 transition-all"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            View Full Changelog
          </a>
        </div>
      )}
    </div>
  </div>
</section>
