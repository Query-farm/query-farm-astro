---
import Card from '../ui/Card.astro';
import { parseInline } from 'marked';

interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  status?: 'stable' | 'beta' | 'experimental';
  icon?: string;
  features?: string[];
  usageCount?: number;
  usagePeriod?: string;
}

const {
  id,
  name,
  description,
  icon,
  features,
  usageCount,
  usagePeriod,
} = Astro.props;

const usageLabel = typeof usageCount === 'number'
  ? usageCount.toLocaleString()
  : null;

// Descriptions may contain inline markdown — `code`, **bold**, *em*, and
// [links](url). Render as inline-only — no block-level <p> wrapping — so
// it slots into the existing <p class="..."> without nesting.
//
// The whole card is wrapped in <a href={...}>, so any inline links in
// the description would create nested <a> elements (invalid HTML — the
// browser auto-closes the outer <a> when it sees the inner one, breaking
// the card layout). Unwrap markdown anchors to plain text. Code, bold,
// italic, etc. all pass through.
const descriptionHtml = parseInline(description).replace(
  /<a\b[^>]*>(.*?)<\/a>/gi,
  '$1',
);
---

<a href={`/products/extensions/${id}`} class="block h-full group">
  <Card padding="md" class="h-full flex flex-col transition-colors group-hover:border-harvest-400">
    <div class="flex items-start gap-3 mb-3">
      {icon && (
        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-earth-100 flex items-center justify-center text-2xl">
          {icon}
        </div>
      )}
      <div class="min-w-0">
        <h3 class="font-display font-semibold text-lg text-soil-900 group-hover:text-harvest-700 transition-colors">
          {name}
        </h3>
        <code class="text-xs text-soil-500 font-mono truncate block">{id}</code>
      </div>
    </div>

    <p class="text-soil-700 text-sm leading-relaxed mb-4 flex-1 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-xs [&_code]:font-mono" set:html={descriptionHtml}></p>

    {features && features.length > 0 && (
      <ul class="space-y-2 mb-4">
        {features.map(feature => (
          <li class="flex items-start text-xs text-soil-600">
            <svg class="w-4 h-4 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-auto pt-3 border-t border-soil-200">
      {usageLabel ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gradient-to-r from-harvest-100 to-grain-100 text-harvest-800 text-xs font-medium ring-1 ring-harvest-200">
          <svg class="w-3.5 h-3.5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <strong class="font-bold tabular-nums">{usageLabel}</strong>
          <span class="text-harvest-700/80">loads{usagePeriod ? ` · ${usagePeriod}` : ''}</span>
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gradient-to-r from-duck-100 to-sky-100 text-sky-800 text-xs font-medium ring-1 ring-sky-200">
          <svg class="w-3.5 h-3.5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          <strong class="font-bold">New</strong>
          <span class="text-sky-700/80">· just released</span>
        </span>
      )}
    </div>
  </Card>
</a>
