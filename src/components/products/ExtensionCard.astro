---
import { parseInline } from 'marked';
import ExtensionIcon from './ExtensionIcon.astro';
import type { ExtensionCategory } from '../../data/extensions';

/**
 * Catalog card for one extension (family B). Icon, name, category, blurb, and
 * the load count as a tabular figure with a share meter.
 *
 * The meter is the extension's load count as a fraction of the busiest
 * extension in the catalog — real measured data. Per-extension weekly series
 * don't exist in the usage snapshot, so there is no sparkline to draw and we
 * don't invent one.
 */

interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  status?: 'stable' | 'beta' | 'experimental';
  icon?: string;
  /** Accepted for call-site compatibility; the card intentionally omits them. */
  features?: string[];
  usageCount?: number;
  usagePeriod?: string;
  /** 1-based position in the catalog ordering, shown as a corner figure. */
  rank?: number;
  /** Load count of the busiest extension, for the share meter. */
  maxUsageCount?: number;
}

const {
  id,
  name,
  description,
  category,
  status,
  icon,
  usageCount,
  usagePeriod,
  rank,
  maxUsageCount,
} = Astro.props;

const CATEGORY_LABEL: Record<string, string> = {
  connectors: 'Connector',
  transformation: 'Transformation',
  analytics: 'Analytics',
  performance: 'Performance',
  devtools: 'Developer tools',
  quality: 'Data quality',
};
const categoryLabel = CATEGORY_LABEL[category] ?? category;

// Load counts print in full, with separators. Compacting them to "265K" vs
// "1.2M" made the one thing this row exists for — comparing extensions — a
// mental arithmetic exercise, and rounded away the difference between 265K and
// 349K entirely. `.load-count` is Commissioner tabular, so full figures still
// align down the column (DESIGN_BRIEF §2).
const fullCount = (n: number): string => n.toLocaleString('en-US');

// The meter is log-scaled. Loads span roughly four orders of magnitude across
// the catalogue, so a linear share pinned all but the top few extensions to the
// 3% floor: every bar looked empty and identical, which is worse than no bar.
// Log turns "how many times bigger" into a readable length.
//
// Anchored at 1,000 loads rather than at zero — log10(0) is -Infinity, and
// below ~1K the differences are noise. An extension under the anchor still gets
// a visible stub via the 4% floor.
const LOAD_ANCHOR = 1_000;
const logShare = (count: number, max: number): number => {
  const top = Math.log10(Math.max(max, LOAD_ANCHOR * 10));
  const base = Math.log10(LOAD_ANCHOR);
  const value = Math.log10(Math.max(count, 1));
  return Math.min(1, Math.max(0.04, (value - base) / (top - base)));
};

// Meter fill vs track has to be far apart on the scale. soil-300 on soil-200
// measured 1.26:1 and the bar read as empty; soil-600 is 4.96:1. Hover goes to
// sun-700 (4.71:1) rather than sun-400 — gold that light is 1.64:1 on the
// track, so hovering would have made the bar less visible, not more.
const share =
  typeof usageCount === 'number' && typeof maxUsageCount === 'number' && maxUsageCount > 0
    ? logShare(usageCount, maxUsageCount)
    : null;

// Descriptions may contain inline markdown — `code`, **bold**, *em*, and
// [links](url). Render as inline-only — no block-level <p> wrapping — so
// it slots into the existing <p class="..."> without nesting.
//
// The whole card is wrapped in <a href={...}>, so any inline links in
// the description would create nested <a> elements (invalid HTML — the
// browser auto-closes the outer <a> when it sees the inner one, breaking
// the card layout). Unwrap markdown anchors to plain text. Code, bold,
// italic, etc. all pass through.
const descriptionHtml = (parseInline(description, { async: false }) as string).replace(
  /<a\b[^>]*>(.*?)<\/a>/gi,
  '$1',
);
---

<a
  href={`/products/extensions/${id}`}
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-soil-300 bg-white px-5 pb-4.5 pt-5 no-underline transition duration-[260ms] ease-[cubic-bezier(.2,.8,.3,1)] hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_20px_40px_-28px_rgba(33,26,18,.55)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
>
  {typeof rank === 'number' && (
    <span class="qf-figure absolute right-0 top-0 rounded-bl-lg bg-soil-100 px-2.5 py-1.5 text-[10px] text-soil-500">
      {String(rank).padStart(2, '0')}
    </span>
  )}

  <div class="flex items-start gap-3">
    {icon && (
      <span class="flex h-9.5 w-9.5 flex-none items-center justify-center rounded-[9px] border border-soil-300 bg-soil-100 text-soil-700">
        <ExtensionIcon icon={icon} category={category as ExtensionCategory} class="text-xl" />
      </span>
    )}
    <div class="min-w-0">
      <h3 class="font-display text-xl text-soil-900 transition-colors group-hover:text-link">{name}</h3>
      <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-[12.5px] font-medium text-soil-500">
        <span>{categoryLabel}</span>
        {status && status !== 'stable' && (
          <span class:list={[
            'rounded-full border px-1.5 py-px text-[10.5px] font-semibold uppercase tracking-wide',
            status === 'experimental'
              ? 'border-sun-400 bg-sun-400/12 text-sun-700'
              : 'border-soil-300 bg-soil-100 text-soil-700',
          ]}>
            {status}
          </span>
        )}
      </div>
    </div>
  </div>

  <p
    class="mt-3 flex-1 text-sm leading-[1.55] text-soil-700 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs"
    set:html={descriptionHtml}
  ></p>

  <div class="mt-4 flex items-center gap-2.5 border-t border-soil-200 pt-3">
    {typeof usageCount === 'number' ? (
      <>
        <span class="load-count text-[15px] text-sun-700">{fullCount(usageCount)}</span>
        <span class="text-[12px] font-medium text-soil-500">
          loads{usagePeriod ? ` · ${usagePeriod.replace(/^last /, '')}` : ''}
        </span>
      </>
    ) : (
      <span class="text-[12px] font-medium text-sun-700">Just released</span>
    )}
    {share !== null && (
      <span
        class="ml-auto block h-1.5 w-14 flex-none overflow-hidden rounded-full bg-soil-200"
        title={`${fullCount(usageCount as number)} loads — bar is log-scaled against the most-loaded extension`}
        aria-hidden="true"
      >
        <span
          class="block h-full rounded-full bg-soil-600 transition-colors group-hover:bg-sun-700"
          style={`width:${(share * 100).toFixed(1)}%`}
        ></span>
      </span>
    )}
  </div>
</a>
