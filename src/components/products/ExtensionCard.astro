---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  status: 'stable' | 'beta' | 'experimental';
  icon?: string;
  githubUrl?: string;
  docsUrl?: string;
  features?: string[];
}

const {
  id,
  name,
  description,
  category,
  status,
  icon,
  githubUrl,
  docsUrl,
  features
} = Astro.props;

const statusVariant = {
  stable: 'success' as const,
  beta: 'warning' as const,
  experimental: 'info' as const
};
---

<Card padding="md" class="h-full flex flex-col group">
  <a href={`/products/extensions/${id}`} class="flex items-start justify-between mb-3">
    <div class="flex items-center gap-3">
      {icon && (
        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-earth-100 flex items-center justify-center text-2xl">
          {icon}
        </div>
      )}
      <div>
        <h3 class="font-display font-semibold text-lg text-soil-900 group-hover:text-harvest-700 transition-colors">
          {name}
        </h3>
        <p class="text-xs text-soil-500 capitalize">{category}</p>
      </div>
    </div>
    <Badge variant={statusVariant[status]} size="sm">
      {status}
    </Badge>
  </a>

  <p class="text-soil-700 text-sm leading-relaxed mb-4 flex-1">
    {description}
  </p>

  {features && features.length > 0 && (
    <ul class="space-y-2 mb-4">
      {features.map(feature => (
        <li class="flex items-start text-xs text-soil-600">
          <svg class="w-4 h-4 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          {feature}
        </li>
      ))}
    </ul>
  )}

  <div class="flex items-center gap-3 pt-3 border-t border-soil-200">
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
      >
        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        GitHub
      </a>
    )}
    {docsUrl && (
      <a
        href={docsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-soil-600 hover:text-earth-700 font-medium transition-colors flex items-center"
      >
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        Docs
      </a>
    )}
  </div>
</Card>
