---
import { platformComponents, type ProductTile } from '../../data/products';

interface Props {
  variant?: 'compact' | 'full';
  id?: string;
}

type ProductName = ProductTile['title'];
type PathStep = {
  label: string;
  title: string;
  body: string;
  state?: string;
  products: ProductName[];
  details?: string[];
  cta?: { label: string; href: string };
};

const { variant = 'full', id } = Astro.props;
const byTitle = new Map(platformComponents.map((product) => [product.title, product]));

const compactSteps: PathStep[] = [
  {
    label: 'Start here',
    title: 'Query it',
    body: 'Explore from a browser workspace or bring a production-ready DuckDB distribution to the tools your team already uses.',
    products: ['Cupola', 'Haybarn'],
  },
  {
    label: 'Add capability',
    title: 'Connect it',
    body: 'Install a DuckDB extension or turn an API, service, model, or piece of custom code into a table or function with VGI.',
    products: ['Extensions', 'VGI'],
  },
  {
    label: 'Share safely',
    title: 'Govern it',
    body: 'Apply policy when it is needed, then publish reusable workers so other people and agents can reach the same capability.',
    products: ['Rowfence', 'Orchard'],
  },
];

const fullSteps: PathStep[] = [
  {
    label: 'Question',
    title: 'Start where the work happens',
    body: 'A person or agent asks through a browser workspace, application, BI tool, notebook, command line, or MCP client.',
    state: 'Entry point',
    products: ['Cupola'],
    details: ['Apps & BI', 'Notebooks & CLI', 'Agents & MCP'],
  },
  {
    label: 'Query engine',
    title: 'Plan the work with SQL',
    body: 'DuckDB works today. Haybarn packages it for teams that need signed artifacts, curated extensions, and independent releases.',
    state: 'Available today',
    products: ['Haybarn'],
    details: ['DuckDB today', 'More engines through VGI over time'],
  },
  {
    label: 'Integration',
    title: 'Add the missing capability',
    body: 'Load a native extension or use VGI when the work belongs in another process, language, service, or machine.',
    state: 'Available today',
    products: ['Extensions', 'VGI'],
  },
  {
    label: 'Policy',
    title: 'Govern access when required',
    body: 'Rowfence can sit in front of a VGI worker and decide which rows, columns, and functions each caller may use.',
    state: 'Optional · Preview',
    products: ['Rowfence'],
  },
  {
    label: 'Worker',
    title: 'Run it yourself or reuse it',
    body: 'Workers execute close to the capability. Build and operate your own, or discover reusable connectors through Orchard.',
    state: 'Self-run or shared',
    products: ['VGI', 'Orchard'],
  },
  {
    label: 'Answer',
    title: 'Reach the data or compute',
    body: 'The worker reaches the API, service, database, file, model, or library and returns Arrow results to the query engine.',
    state: 'The outcome',
    products: [],
    details: ['APIs & services', 'Databases & files', 'Models & custom code'],
    cta: { label: 'Talk through your use case', href: '/company/schedule' },
  },
];

const steps = variant === 'compact' ? compactSteps : fullSteps;
const statusLabel: Record<ProductTile['status'], string> = {
  available: 'Available',
  preview: 'Preview',
  development: 'In development',
};
---

<section id={id} class:list={['mobile-product-path', `mobile-product-path--${variant}`]} aria-label={variant === 'compact' ? 'Choose a Query.Farm starting point' : 'Query.Farm system in six steps'}>
  <ol class="path-list">
    {steps.map((step, index) => (
      <li class="path-step">
        <div class="path-rail" aria-hidden="true">
          <span class="path-marker"><b>{String(index + 1).padStart(2, '0')}</b></span>
          {index < steps.length - 1 && <i></i>}
        </div>

        <article class="path-card">
          <div class="path-card-head">
            <div>
              <p class="path-label">{step.label}</p>
              <h3>{step.title}</h3>
            </div>
            {step.state && <span class="path-state">{step.state}</span>}
          </div>

          <p class="path-body">{step.body}</p>

          {step.details && (
            <ul class="path-details" aria-label={`${step.label} examples`}>
              {step.details.map((detail) => <li>{detail}</li>)}
            </ul>
          )}

          {step.products.length > 0 && (
            <div class="path-products" aria-label={`Products for ${step.title}`}>
              {step.products.map((name) => {
                const product = byTitle.get(name);
                if (!product) return null;
                return (
                  <a href={product.href} class="path-product">
                    <span class="path-product-mark" aria-hidden="true">
                      {product.img && <img src={product.img} alt="" width="24" height="24" />}
                      {product.emoji && <span>{product.emoji}</span>}
                    </span>
                    <span class="path-product-copy">
                      <strong>{product.title}</strong>
                      <span class:list={['path-product-status', `is-${product.status}`]}>{statusLabel[product.status]}</span>
                      <small>{product.outcome}</small>
                    </span>
                    <span class="path-product-arrow" aria-hidden="true">→</span>
                  </a>
                );
              })}
            </div>
          )}

          {step.cta && <a class="path-cta" href={step.cta.href}>{step.cta.label} <span aria-hidden="true">→</span></a>}
        </article>
      </li>
    ))}
  </ol>

  {variant === 'compact' && (
    <a class="path-overview" href="/products#product-path">
      <span>
        <small>See how it all connects</small>
        <strong>Follow the complete six-step system</strong>
      </span>
      <span aria-hidden="true">→</span>
    </a>
  )}
</section>

<style>
  .mobile-product-path { width: 100%; }
  .path-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .path-step { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: .8rem; }
  .path-rail { display: flex; min-height: 100%; flex-direction: column; align-items: center; }
  .path-marker { display: grid; width: 30px; height: 30px; flex: none; place-items: center; border: 1px solid var(--color-sun-600); border-radius: 7px; background: var(--color-sun-200); color: var(--color-soil-900); transform: rotate(45deg); box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-soil-300) 65%, transparent); }
  .path-marker b { font-family: var(--font-mono); font-size: .64rem; line-height: 1; transform: rotate(-45deg); }
  .path-rail i { width: 2px; min-height: 28px; flex: 1; margin-block: 5px; background: linear-gradient(var(--color-sun-500), var(--color-field-600)); opacity: .7; }
  .path-step:nth-child(n + 4) .path-marker { border-color: var(--color-field-600); background: color-mix(in srgb, var(--color-field-400) 38%, white); }

  .path-card { min-width: 0; margin-bottom: .85rem; padding: 1rem; border: 1px solid var(--color-soil-300); border-radius: 13px; background: #fffdf7; box-shadow: 0 12px 28px -26px rgb(48 39 26 / .7); }
  .path-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .65rem; }
  .path-label { color: var(--color-sun-700); font-size: .65rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .path-card h3 { margin-top: .25rem; color: var(--color-soil-900); font-family: var(--font-display); font-size: 1.35rem; line-height: 1.08; letter-spacing: -.02em; }
  .path-state { flex: none; max-width: 104px; padding: .27rem .48rem; border: 1px solid var(--color-soil-300); border-radius: 999px; color: var(--color-soil-600); font-size: .61rem; font-weight: 750; line-height: 1.2; text-align: center; }
  .path-body { margin-top: .7rem; color: var(--color-soil-700); font-size: .9rem; line-height: 1.55; }
  .path-details { display: flex; flex-wrap: wrap; gap: .38rem; margin: .75rem 0 0; padding: 0; list-style: none; }
  .path-details li { padding: .28rem .48rem; border: 1px solid var(--color-soil-300); border-radius: 999px; background: var(--color-soil-100); color: var(--color-soil-700); font-size: .66rem; font-weight: 650; }

  .path-products { display: grid; gap: .45rem; margin-top: .8rem; }
  .path-product { display: grid; min-height: 52px; grid-template-columns: 34px minmax(0, 1fr) 16px; align-items: center; gap: .55rem; padding: .52rem .58rem; border: 1px solid var(--color-soil-300); border-radius: 9px; background: var(--color-soil-50); color: inherit; text-decoration: none; transition: border-color .16s ease, background-color .16s ease; }
  .path-product:hover { border-color: var(--color-sun-500); background: white; }
  .path-product:focus-visible, .path-overview:focus-visible, .path-cta:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }
  .path-product-mark { display: grid; width: 34px; height: 34px; place-items: center; overflow: hidden; border: 1px solid var(--color-soil-300); border-radius: 8px; background: #fffdf7; font-size: 1rem; }
  .path-product-mark img { width: 23px; height: 23px; object-fit: contain; }
  .path-product-copy { min-width: 0; }
  .path-product-copy strong { display: block; color: var(--color-soil-900); font-size: .82rem; line-height: 1.2; }
  .path-product-copy small { display: block; margin-top: .2rem; color: var(--color-soil-600); font-size: .68rem; line-height: 1.3; }
  .path-product-status { display: inline-block; margin-top: .22rem; padding: .13rem .36rem; border: 1px solid var(--color-soil-300); border-radius: 999px; color: var(--color-soil-600); font-size: .55rem; font-weight: 750; line-height: 1.2; }
  .path-product-status.is-available { border-color: color-mix(in srgb, var(--color-field-600) 45%, transparent); background: color-mix(in srgb, var(--color-field-400) 14%, white); color: var(--color-field-700); }
  .path-product-status.is-preview { border-color: var(--color-sun-400); background: color-mix(in srgb, var(--color-sun-200) 48%, white); color: var(--color-sun-800); }
  .path-product-arrow { color: var(--color-field-700); font-size: 1rem; }
  .path-cta { display: inline-flex; min-height: 44px; align-items: center; margin-top: .85rem; color: var(--color-field-700); font-size: .84rem; font-weight: 750; text-decoration: none; }

  .path-overview { display: flex; min-height: 68px; align-items: center; justify-content: space-between; gap: 1rem; margin-left: 42px; padding: .85rem 1rem; border: 1px solid var(--color-field-600); border-radius: 12px; background: var(--color-field-700); color: white; text-decoration: none; }
  .path-overview small, .path-overview strong { display: block; }
  .path-overview small { color: var(--color-cream-2); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .path-overview strong { margin-top: .18rem; font-size: .86rem; line-height: 1.25; }
  .path-overview > span:last-child { flex: none; font-size: 1.25rem; }

  .mobile-product-path--compact .path-card { padding: 1.05rem; }
  .mobile-product-path--compact .path-marker { border-color: var(--color-sun-600); background: var(--color-sun-200); }
  .mobile-product-path--compact .path-step:last-child .path-marker { border-color: var(--color-field-600); background: color-mix(in srgb, var(--color-field-400) 38%, white); }

  @media (prefers-reduced-motion: reduce) {
    .path-product { transition: none; }
  }
</style>
