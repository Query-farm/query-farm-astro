---
import { Icon } from 'astro-icon/components';
import { categoryIconTheme } from '../../data/category-theme';
import type { ExtensionCategory } from '../../data/extensions';

interface Props {
  /** Phosphor icon token from metadata.json `icon` (e.g. "airplane-tilt"). */
  icon?: string;
  /** Drives the tint color when `tint` is on; otherwise unused. */
  category?: ExtensionCategory;
  /** Extra classes for the glyph — set size here (icons render at 1em). */
  class?: string;
  /**
   * Tint the glyph by category. Off by default: the Strata Sun palette is
   * paper + one gold accent, and thirty-four per-category hues fight it. The
   * glyph inherits `currentColor` so the caller sets the ink.
   */
  tint?: boolean;
}

const { icon, category, class: cls, tint = false } = Astro.props;
const ink = tint && category ? categoryIconTheme[category]?.ink ?? '' : '';
---
{icon && <Icon name={`ph:${icon}`} class:list={[ink, cls]} aria-hidden="true" />}
