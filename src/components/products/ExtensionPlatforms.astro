---
import { Icon } from 'astro-icon/components';
import type { PlatformInfo } from '../../data/extension-types';

interface Props { platforms: PlatformInfo[]; }
const { platforms } = Astro.props;
const icons: Record<string, string> = {
  Linux: 'simple-icons:linux',
  'Linux (musl)': 'simple-icons:linux',
  macOS: 'simple-icons:apple',
  Windows: 'simple-icons:windows',
  WASM: 'simple-icons:webassembly',
};
const canonical = ['Linux', 'Linux (musl)', 'macOS', 'Windows', 'WASM'];
const supported = new Map(platforms.map(platform => [platform.platform, platform]));
// Show missing platforms explicitly, and preserve any additional platform
// supplied by the catalog instead of silently dropping it.
const names = [...canonical, ...platforms.map(platform => platform.platform).filter(name => !canonical.includes(name))];
---

<ul class="divide-y divide-soil-200 overflow-hidden rounded-lg border border-soil-300" aria-label="Platform availability">
  {names.map(name => {
    const platform = supported.get(name);
    const architectures = platform?.architectures.length ? platform.architectures : ['Browser-based'];
    return <li class="flex items-center justify-between gap-3 bg-white px-3 py-2.5" data-platform={name}>
      <span class={`flex items-center gap-2 text-[14px] ${platform ? 'text-soil-700' : 'text-soil-400'}`}>
        {icons[name] && <Icon name={icons[name]} class={`w-4 h-4 flex-none ${platform ? 'text-cat-field-ink' : 'text-soil-300'}`} />}
        {name}
      </span>
      {platform ? <span class="flex flex-wrap justify-end gap-1">
        {architectures.map(architecture => <span class="rounded-full border border-cat-field-ink/40 bg-cat-field px-2 py-0.5 font-mono text-[11px] text-cat-field-ink">{architecture}</span>)}
      </span> : <span class="text-right text-[12.5px] italic text-soil-400">Not available</span>}
    </li>;
  })}
</ul>
