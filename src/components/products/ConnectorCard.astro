---
import type { Connector } from '../../data/connectors';
import { pricingLabel, statusLabel } from '../../data/connectors';

interface Props {
  connector: Connector;
  // Pricing is temporarily suppressed on the VGI overview page; the data is
  // still in src/data/connectors.ts, so flipping this back on restores it.
  showPricing?: boolean;
}

const { connector: c, showPricing = true } = Astro.props;

const pricingClasses: Record<string, string> = {
  free: 'border border-field-600/45 bg-field-600/10 text-field-700',
  subscription: 'bg-sun-400/20 text-sun-800',
  enterprise: 'bg-soil-200 text-soil-800',
};

// Compact usage signal for the card footer, e.g. 6900 → "6.9k".
const fmtUses = (n?: number) =>
  n == null ? '' : n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
---

<a
  href={`/products/orchard/connectors/${c.id}`}
  class="group relative flex h-full flex-col rounded-xl border border-soil-300 bg-white p-6 transition duration-[260ms] ease-[cubic-bezier(.2,.8,.3,1)] hover:-translate-y-1 hover:border-sun-400 hover:shadow-[0_20px_40px_-28px_rgba(33,26,18,.55)]"
>
  {c.popular && (
    <span class="absolute -top-3 right-4 inline-flex items-center gap-1 rounded-full border border-sun-400 bg-sun-200 px-3 py-0.5 text-[12.5px] font-medium text-sun-800">
      ★ Popular
    </span>
  )}

  <div class="flex items-start gap-4">
    <!-- Category tints sit only ~1.15:1 against paper, so the chip needs a
         hairline to read as a shape rather than a smudge. -->
    <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-soil-300/70 text-3xl ${c.theme.iconBg}`}>
      {c.icon}
    </div>
    <div class="min-w-0">
      <h3 class="font-display text-xl text-soil-900 group-hover:text-link">{c.name}</h3>
      <p class="mt-0.5 text-[12.5px] font-medium text-sun-700">{c.category}</p>
    </div>
  </div>

  <p class="mt-4 flex-1 text-sm leading-relaxed text-soil-700">{c.tagline}</p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    {showPricing && (
      <span class={`rounded-full px-2.5 py-0.5 text-[12.5px] font-medium ${pricingClasses[c.pricing]}`}>
        {pricingLabel[c.pricing]}
      </span>
    )}
    <span class="rounded-full border border-soil-300 bg-soil-50 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-600">
      {statusLabel[c.status]}
    </span>
    {showPricing && <span class="qf-figure ml-auto text-sm text-soil-900">{c.priceNote}</span>}
  </div>

  <div class="mt-3 flex items-center gap-1.5 border-t border-soil-200 pt-3 text-xs text-soil-500">
    {c.uses != null && (
      <span><span class="qf-figure text-soil-700">{fmtUses(c.uses)}</span> attaches/mo</span>
    )}
    <span class="ml-auto">by {c.provider}</span>
  </div>
</a>
