---
import type { Connector } from '../../data/connectors';
import { pricingLabel, statusLabel } from '../../data/connectors';

interface Props {
  connector: Connector;
}

const { connector: c } = Astro.props;

const pricingClasses: Record<string, string> = {
  free: 'bg-emerald-100 text-emerald-800',
  subscription: 'bg-harvest-100 text-harvest-800',
  enterprise: 'bg-soil-200 text-soil-800',
};

// Compact usage signal for the card footer, e.g. 6900 → "6.9k".
const fmtUses = (n?: number) =>
  n == null ? '' : n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
---

<a
  href={`/products/orchard/connectors/${c.id}`}
  class="group relative flex h-full flex-col rounded-2xl border-2 border-soil-900 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl"
>
  {c.popular && (
    <span class="absolute -top-3 right-4 inline-flex items-center gap-1 rounded-full border-2 border-soil-900 bg-grain-300 px-3 py-0.5 text-xs font-bold text-soil-900 shadow-sm">
      ★ Popular
    </span>
  )}

  <div class="flex items-start gap-4">
    <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl ${c.theme.iconBg}`}>
      {c.icon}
    </div>
    <div class="min-w-0">
      <h3 class="text-xl font-bold text-soil-900 group-hover:text-harvest-700">{c.name}</h3>
      <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-emerald-700">{c.category}</p>
    </div>
  </div>

  <p class="mt-4 flex-1 text-sm leading-relaxed text-soil-700">{c.tagline}</p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <span class={`rounded-full px-2.5 py-1 text-xs font-bold ${pricingClasses[c.pricing]}`}>
      {pricingLabel[c.pricing]}
    </span>
    <span class="rounded-full border border-soil-300 bg-soil-50 px-2.5 py-1 text-xs font-semibold text-soil-600">
      {statusLabel[c.status]}
    </span>
    <span class="ml-auto text-sm font-bold text-soil-900">{c.priceNote}</span>
  </div>

  <div class="mt-3 flex items-center gap-1.5 border-t border-soil-100 pt-3 text-xs text-soil-500">
    {c.uses != null && (
      <span><span class="font-bold text-soil-700">{fmtUses(c.uses)}</span> attaches/mo</span>
    )}
    <span class="ml-auto">by {c.provider}</span>
  </div>
</a>
