---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

interface Props {
  name: string;
  tagline: string;
  description: string;
  features: string[];
  benefits?: string[];
  icon?: string;
  href?: string;
  variant?: 'default' | 'featured';
}

const {
  name,
  tagline,
  description,
  features,
  benefits,
  icon,
  href,
  variant = 'default'
} = Astro.props;
---

<Card variant={variant} padding="lg" class="h-full flex flex-col">
  <div class="flex items-start gap-4 mb-4">
    {icon && (
      <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-gradient-to-br from-earth-100 to-harvest-100 flex items-center justify-center text-4xl shadow-sm">
        {icon}
      </div>
    )}
    <div class="flex-1">
      <h3 class="text-2xl font-bold text-soil-900 mb-1">
        {name}
      </h3>
      <p class="text-earth-600 font-medium">
        {tagline}
      </p>
    </div>
  </div>

  <p class="text-soil-700 leading-relaxed mb-6">
    {description}
  </p>

  {features && features.length > 0 && (
    <div class="mb-6">
      <h4 class="text-sm font-semibold text-soil-800 uppercase tracking-wider mb-3">
        Key Features
      </h4>
      <ul class="space-y-2">
        {features.map(feature => (
          <li class="flex items-start text-sm text-soil-700">
            <svg class="w-5 h-5 mr-2 text-earth-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    </div>
  )}

  {benefits && benefits.length > 0 && (
    <div class="mb-6">
      <h4 class="text-sm font-semibold text-soil-800 uppercase tracking-wider mb-3">
        Benefits
      </h4>
      <ul class="space-y-2">
        {benefits.map(benefit => (
          <li class="flex items-start text-sm text-soil-700">
            <svg class="w-5 h-5 mr-2 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            {benefit}
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="mt-auto pt-4">
    {href && (
      <Button href={href} variant={variant === 'featured' ? 'accent' : 'primary'} size="md" class="w-full justify-center">
        Learn More
      </Button>
    )}
  </div>
</Card>
