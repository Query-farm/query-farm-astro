---
import Button from '../ui/Button.astro';

interface Props {
  name: string;
  icon: string;
  description: string;
  actions?: { label: string; href: string; icon?: string }[];
  image?: string; // Optional detailed image for the extension
}

const { name, icon, description, actions = [], image } = Astro.props;

// Simple hash function to generate a consistent number from a string
function hashString(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash; // Convert to 32-bit integer
  }
  return Math.abs(hash);
}

// Generate hue from extension name (0-360)
const hash = hashString(name);
const hue = hash % 360;

// Create OKLCH colors with the generated hue
// Using OKLCH: oklch(lightness chroma hue)
// For a vibrant gradient, we'll use two shades with the same hue
const color1 = `oklch(0.65 0.15 ${hue})`; // Lighter, more saturated
const color2 = `oklch(0.55 0.12 ${(hue + 30) % 360})`; // Darker, slightly shifted hue

// Generate CSS gradient
const gradientStyle = `background: linear-gradient(135deg, ${color1}, ${color2});`;
---

<section class="py-12 lg:py-16 text-white relative overflow-hidden" style={gradientStyle}>
  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id={`pattern-${name}`} x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-white" />
          <circle cx="25" cy="75" r="1" fill="currentColor" class="text-white" />
          <circle cx="75" cy="25" r="1" fill="currentColor" class="text-white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#pattern-${name})`} />
    </svg>
  </div>

  <div class="section-container relative z-10">
    <div class="flex items-start gap-8">
      <div class="flex-shrink-0 w-72 h-72 rounded-2xl bg-white/95 backdrop-blur flex items-center justify-center shadow-lg overflow-hidden">
        {image ? (
          <img src={image} alt={`${name} icon`} class="w-full h-full object-cover" />
        ) : (
          <span class="text-[12rem]">{icon}</span>
        )}
      </div>
      <div class="flex-1">
        <h1 class="text-4xl md:text-5xl font-bold font-mono mb-4 drop-shadow-sm">
          {name}
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-6 max-w-3xl drop-shadow-sm">
          {description}
        </p>
        {actions.length > 0 && (
          <div class="flex flex-wrap items-center gap-3">
            {actions.map((action) => (
              <Button href={action.href} variant="secondary" size="md">
                {action.icon && (
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={action.icon} />
                )}
                {action.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
