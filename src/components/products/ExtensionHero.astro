---
import { parseInline } from 'marked';

/**
 * Page header for an extension detail page (family C — docs).
 *
 * No colour band: paper, a hairline rule, one gold accent. Name → badges →
 * lede, with the load count as a tabular figure in the right aside.
 *
 * Four things are deliberately absent. The trail back up the tree is the job of
 * ExtensionsSubNav, which sits directly above this header — a second textual
 * crumb here only repeated it. The repository link belongs to the Compatibility
 * section further down, which lists it alongside stars, licence, and release
 * dates. The INSTALL/LOAD SQL is a CodeBlock in the body, below the technical
 * overview: what the extension *is* earns the top of the page, and
 * INSTALL … FROM community is a step people learn once. And there is no mark
 * tile: the per-extension icons come from mixed sources at mixed weights, so a
 * 56px square of them never read as one set.
 *
 * Badges are limited to facts that change what you can do here — currently only
 * "Commercial", which links to Pricing. Category, status and licence are
 * catalogue metadata and live in Compatibility.
 *
 * The page still emits BreadcrumbList structured data from `[slug].astro`, so
 * search engines keep the trail either way.
 */

interface Badge {
  label: string;
  /** `gold` = the one accent; `field` = a positive state; default = neutral. */
  tone?: 'neutral' | 'gold' | 'field';
  href?: string;
  title?: string;
}

interface Props {
  name: string;
  /** Markdown (inline): supports links, `code`, and emphasis. */
  description: string;
  badges?: Badge[];
  /** Load count for the snapshot window (already a raw number). */
  loads?: number;
  /** Window label from the snapshot, e.g. "last 90 days". */
  loadsPeriod?: string;
}

const {
  name,
  description,
  badges = [],
  loads,
  loadsPeriod,
} = Astro.props;

// The description is authored as inline markdown (links, `code`, emphasis).
// parseInline avoids wrapping it in a block-level <p> — the markup below
// already provides the paragraph.
const descriptionHtml = await parseInline(description);

const toneClass = (tone: Badge['tone']) =>
  tone === 'gold'
    ? 'border-sun-400 text-sun-700 bg-sun-400/12'
    : tone === 'field'
      ? 'border-field-600/45 text-field-700 bg-field-600/10'
      : 'border-soil-300 text-soil-700 bg-transparent';
---

<header class="qf-pagehead border-b border-soil-300 bg-gradient-to-b from-white to-soil-50">
  <div class="mx-auto w-full max-w-[1200px] px-5 pt-10 pb-8 sm:px-7">
    <div class="flex flex-wrap items-start gap-x-8 gap-y-5">
      <div class="min-w-[16rem] flex-1">
        <h1 class="font-display text-4xl md:text-5xl text-soil-900">{name}</h1>

        {badges.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {badges.map((badge) => {
              const cls = `inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium ${toneClass(badge.tone)}`;
              return badge.href ? (
                <a href={badge.href} title={badge.title} class={`${cls} transition-colors hover:border-sun-400 hover:text-link`}>
                  {badge.label}
                </a>
              ) : (
                <span class={cls} title={badge.title}>{badge.label}</span>
              );
            })}
          </div>
        )}

        <p
          class="hero-description mt-4 max-w-[58ch] text-lg text-soil-700"
          set:html={descriptionHtml}
        ></p>
      </div>

      {typeof loads === 'number' && (
        <div class="ml-auto text-right">
          <div class="load-count text-4xl leading-none text-sun-700">
            {loads.toLocaleString()}
          </div>
          <div class="mt-1.5 text-[12.5px] font-medium text-soil-600">
            extension loads{loadsPeriod ? ` · ${loadsPeriod}` : ''}
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  /* Markdown rendered into the header lede. */
  .hero-description :global(a) {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid rgba(69, 99, 47, 0.4);
  }
  .hero-description :global(a:hover) {
    color: var(--color-link-hover);
    border-bottom-color: var(--color-link-hover);
  }
  .hero-description :global(code) {
    font-family: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: var(--color-soil-100);
    color: var(--color-soil-900);
    white-space: nowrap;
  }
</style>
