---
import { parseInline } from 'marked';
import { Icon } from 'astro-icon/components';

/**
 * Page header for an extension detail page (family C — docs).
 *
 * No colour band: paper, a hairline rule, one gold accent. Name → badges →
 * lede, with the load count as a tabular figure in the right aside.
 *
 * ExtensionsSubNav provides the trail back to the directory. Optional actions
 * link directly to the first example, function reference, and source code.
 * INSTALL/LOAD SQL stays in the page body with the examples.
 *
 * Badges are limited to facts that change what you can do here — currently only
 * "Commercial", which links to Pricing. Category, status and licence are
 * catalogue metadata and live in Compatibility.
 *
 * The page still emits BreadcrumbList structured data from `[slug].astro`, so
 * search engines keep the trail either way.
 */

interface Badge {
  label: string;
  /** `gold` = the one accent; `field` = a positive state; default = neutral. */
  tone?: 'neutral' | 'gold' | 'field';
  href?: string;
  title?: string;
}

interface Props {
  name: string;
  /** Optional product artwork with a transparent background. */
  logo?: { src: string; alt: string; width: number; height: number };
  /** Short product-kind label shown immediately above the extension name. */
  eyebrow?: string;
  /** Markdown (inline): supports links, `code`, and emphasis. */
  description: string;
  badges?: Badge[];
  /** Load count for the snapshot window (already a raw number). */
  loads?: number;
  /** Window label from the snapshot, e.g. "last 90 days". */
  loadsPeriod?: string;
  /** Published PDF asset and its page count. */
  quickReference?: { href: string; pages: number };
  actions?: { label: string; href: string }[];
  /** Use the parent section's content alignment when reusing the header. */
  containerClass?: string;
}

const {
  name,
  logo,
  eyebrow,
  description,
  badges = [],
  loads,
  loadsPeriod,
  quickReference,
  actions = [],
  containerClass = 'mx-auto w-full max-w-[1200px] px-5 sm:px-7',
} = Astro.props;

// The description is authored as inline markdown (links, `code`, emphasis).
// parseInline avoids wrapping it in a block-level <p> — the markup below
// already provides the paragraph.
const descriptionHtml = await parseInline(description);

const toneClass = (tone: Badge['tone']) =>
  tone === 'gold'
    ? 'border-sun-400 text-sun-700 bg-sun-400/12'
    : tone === 'field'
      ? 'border-field-600/45 text-field-700 bg-field-600/10'
      : 'border-soil-300 text-soil-700 bg-transparent';
---

<header class="qf-pagehead border-b border-soil-300 bg-gradient-to-b from-white to-soil-50">
  <div class:list={[containerClass, 'pt-10 pb-8']}>
    <div class="flex flex-wrap items-start gap-x-8 gap-y-5">
      <div class="min-w-[16rem] flex-1">
        <div class:list={[logo && 'flex items-center gap-5']}>
          {logo && <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} class="h-auto w-28 shrink-0 sm:w-40" />}
          <div class="min-w-0">
            {eyebrow && <p class="qf-eyebrow mb-3 text-sun-700">{eyebrow}</p>}
            <h1 class="font-display text-4xl md:text-5xl text-soil-900">{name}</h1>
          </div>
        </div>

        {badges.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {badges.map((badge) => {
              const cls = `inline-block rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium ${toneClass(badge.tone)}`;
              return badge.href ? (
                <a href={badge.href} title={badge.title} class={`${cls} transition-colors hover:border-sun-400 hover:text-link`}>
                  {badge.label}
                </a>
              ) : (
                <span class={cls} title={badge.title}>{badge.label}</span>
              );
            })}
          </div>
        )}

        <p
          class="hero-description mt-4 max-w-[58ch] text-lg text-soil-700"
          set:html={descriptionHtml}
        ></p>

        {actions.length > 0 && (
          <nav aria-label={`${name} shortcuts`} class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {actions.map(action => (
              <a href={action.href} class="rounded text-link underline decoration-link/45 underline-offset-4 hover:decoration-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">{action.label}</a>
            ))}
            {quickReference && (
              <a href={quickReference.href} type="application/pdf" class="rounded text-link underline decoration-link/45 underline-offset-4 hover:decoration-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">Quick reference PDF</a>
            )}
          </nav>
        )}

        {quickReference && actions.length === 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <a
              href={quickReference.href}
              type="application/pdf"
              aria-label={`${name} quick reference PDF, ${quickReference.pages} ${quickReference.pages === 1 ? 'page' : 'pages'}`}
              class="inline-flex min-h-10 items-center gap-2 rounded-md text-link underline decoration-link/45 underline-offset-4 transition-colors hover:text-link-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
            >
              <Icon name="ph:file-pdf" class="h-5 w-5 shrink-0" aria-hidden="true" />
              <span>Quick reference PDF</span>
            </a>
            <span class="text-xs text-soil-600">
              {quickReference.pages} {quickReference.pages === 1 ? 'page' : 'pages'} · Printable
            </span>
          </div>
        )}
      </div>

      {typeof loads === 'number' && (
        <div class="ml-auto text-right">
          <div class="load-count text-4xl leading-none text-sun-700">
            {loads.toLocaleString()}
          </div>
          <div class="mt-1.5 text-[12.5px] font-medium text-soil-600">
            extension loads{loadsPeriod ? ` · ${loadsPeriod}` : ''}
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  /* Markdown rendered into the header lede. */
  .hero-description :global(a) {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid rgba(69, 99, 47, 0.4);
  }
  .hero-description :global(a:hover) {
    color: var(--color-link-hover);
    border-bottom-color: var(--color-link-hover);
  }
  .hero-description :global(code) {
    font-family: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: var(--color-soil-100);
    color: var(--color-soil-900);
    white-space: nowrap;
  }
</style>
