---
import { parseInline } from 'marked';
import Button from '../ui/Button.astro';
import ExtensionIcon from './ExtensionIcon.astro';
import type { ExtensionCategory } from '../../data/extensions';

interface Props {
  name: string;
  icon: string;
  category?: ExtensionCategory;
  /** Markdown (inline): supports links, `code`, and emphasis. */
  description: string;
  actions?: { label: string; href: string; icon?: string }[];
  image?: string; // Optional detailed image for the extension
}

const { name, icon, category, description, actions = [], image } = Astro.props;

// The description is authored as inline markdown (links, `code`, emphasis).
// parseInline avoids wrapping it in a block-level <p> — the markup below
// already provides the paragraph.
const descriptionHtml = await parseInline(description);

// Simple hash function to generate a consistent number from a string
function hashString(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash; // Convert to 32-bit integer
  }
  return Math.abs(hash);
}

// Generate hue from extension name (0-360)
const hash = hashString(name);
const hue = hash % 360;

// Create OKLCH colors with the generated hue for the background gradient
const color1 = `oklch(0.65 0.15 ${hue})`;
const color2 = `oklch(0.55 0.12 ${(hue + 30) % 360})`;
const gradientStyle = `background: linear-gradient(135deg, ${color1}, ${color2});`;
---

<section class="text-white" style={gradientStyle}>
  <div class="section-container py-12">
    <div class="flex items-center gap-6">
      <div class="flex-shrink-0 w-24 h-24 rounded-xl bg-white/95 backdrop-blur flex items-center justify-center shadow-sm overflow-hidden">
        {image ? (
          <img src={image} alt={`${name} icon`} class="w-full h-full object-cover" />
        ) : (
          <ExtensionIcon icon={icon} category={category} class="text-5xl" />
        )}
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-3xl font-bold font-mono drop-shadow-sm">
            {name}
          </h1>
        </div>
        <p class="hero-description text-lg text-white/90 mt-2 max-w-2xl" set:html={descriptionHtml}></p>
      </div>
      {actions.length > 0 && (
        <div class="flex-shrink-0">
          {actions.map((action) => (
            <Button href={action.href} variant="primary" size="md" class="!bg-gray-900 !text-white hover:!bg-gray-800">
              {action.icon && (
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={action.icon} />
              )}
              {action.label}
            </Button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Markdown rendered into the hero description, styled to read on the colored
     gradient (white-on-color). Scoped to this component. */
  .hero-description :global(a) {
    color: white;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
    transition: text-decoration-color 120ms ease;
  }
  .hero-description :global(a:hover) {
    text-decoration-color: white;
  }
  .hero-description :global(code) {
    font-family: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }
</style>
