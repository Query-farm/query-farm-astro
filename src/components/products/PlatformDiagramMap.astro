---
import { publicExtensions } from '../../data/extensions';
import type { PlatformMapDefinition } from '../../data/platform-map';
import { PH, PH_VB, SI, SI_VB } from '../products/platform-icons';
import { icons as simpleIconSet } from '@iconify-json/simple-icons';

const { exploration } = Astro.props as { exploration: PlatformMapDefinition };
const extensionCount = publicExtensions.length;

const VB_W = 1100;
const VB_H = 1304;
const stageTop = [38, 390, 572, 754, 926, 1122];
const stageHeight = [300, 146, 126, 126, 140, 104];
const stageWidth = [290, 340, 348, 334, 348, 790];
const stageLabels = ['Query surface', 'SQL engines', 'Engine integration', 'Access control', 'VGI execution', 'Data & compute'];
const hasCircuitLabelRail = exploration.treatment === 'circuit';
const stageLabelX = hasCircuitLabelRail ? 144 : 130;
const stageCenters = stageTop.map((y, i) => y + stageHeight[i] / 2);
const queryBusY = (stageTop[0] + stageHeight[0] + stageTop[1]) / 2;
const stageBracePath = (y: number, height: number) => {
  const top = y + 10;
  const bottom = y + height - 10;
  const middle = (top + bottom) / 2;
  const shoulder = Math.min(18, (bottom - top) * 0.16);

  return [
    `M169 ${top}`,
    `C163 ${top} 160 ${top + 5} 160 ${top + shoulder}`,
    `C160 ${middle - 13} 158 ${middle - 6} 152 ${middle}`,
    `C158 ${middle + 6} 160 ${middle + 13} 160 ${bottom - shoulder}`,
    `C160 ${bottom - 5} 163 ${bottom} 169 ${bottom}`,
  ].join(' ');
};
const circuitBands = stageCenters.map((_center, i) => {
  const start = i === 0 ? 0 : (stageTop[i - 1] + stageHeight[i - 1] + stageTop[i]) / 2;
  const end = i === stageCenters.length - 1 ? VB_H : (stageTop[i] + stageHeight[i] + stageTop[i + 1]) / 2;
  return { y: start, height: end - start, index: i };
});

const LANGS = [
  { key: 'python', name: 'Python' },
  { key: 'typescript', name: 'TypeScript' },
  { key: 'go', name: 'Go' },
  { key: 'rust', name: 'Rust' },
  { key: 'openjdk', name: 'Java' },
];

type SourceMark = { label: string; body?: string; src?: string };

const SOURCE_MARKS: SourceMark[] = [
  { label: 'Parquet', body: simpleIconSet.icons.apacheparquet.body },
  {
    label: 'CSV',
    body: '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M6 2h8l4 4v16H6zM14 2v5h4M8.5 11h7M8.5 15h7M8.5 19h5"/>',
  },
  {
    label: 'Iceberg',
    src: '/images/apache-iceberg-icon.svg?v=3',
  },
  {
    label: 'Delta Lake',
    src: '/images/delta-lake-icon.svg?v=2',
  },
  {
    label: 'APIs',
    body: '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 3H8C6 3 6 5 6 7v1c0 2-1 4-3 4 2 0 3 2 3 4v1c0 2 0 4 2 4h1M15 3h1c2 0 2 2 2 4v1c0 2 1 4 3 4-2 0-3 2-3 4v1c0 2 0 4-2 4h-1"/><circle cx="12" cy="8" r="1.25" fill="currentColor"/><circle cx="12" cy="12" r="1.25" fill="currentColor"/><circle cx="12" cy="16" r="1.25" fill="currentColor"/>',
  },
];

const QUERY_SURFACE_MARKS = {
  cupola: [
    { label: 'WASM', body: simpleIconSet.icons.webassembly.body },
    {
      label: 'HTTP',
      body: '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.5" d="M3.5 12h17M12 3c2.2 2.5 3.3 5.5 3.3 9S14.2 18.5 12 21M12 3C9.8 5.5 8.7 8.5 8.7 12S9.8 18.5 12 21"/>',
    },
  ],
  apps: [
    { label: 'ADBC', body: simpleIconSet.icons.apachearrow.body },
    {
      label: 'ODBC',
      body: '<path fill="none" stroke="currentColor" stroke-width="1.8" d="M5 6c0-2 3.1-3.5 7-3.5S19 4 19 6v12c0 2-3.1 3.5-7 3.5S5 20 5 18zm0 0c0 2 3.1 3.5 7 3.5S19 8 19 6M5 12c0 2 3.1 3.5 7 3.5s7-1.5 7-3.5"/>',
    },
  ],
  cli: [
    { label: 'Jupyter', body: simpleIconSet.icons.jupyter.body },
    { label: 'Python', body: simpleIconSet.icons.python.body },
    { label: 'dbt', body: simpleIconSet.icons.dbt.body },
  ],
  agents: [
    { label: 'MCP', body: simpleIconSet.icons.modelcontextprotocol.body },
    { label: 'Claude', body: simpleIconSet.icons.claude.body },
    { label: 'Codex', body: simpleIconSet.icons.openai.body },
    { label: 'OpenRouter', body: simpleIconSet.icons.openrouter.body },
  ],
};

const ENGINE_MARKS = [
  { label: 'DataFusion', src: '/images/datafusion-icon.svg' },
  { label: 'Trino', body: simpleIconSet.icons.trino.body },
  { label: 'Spark', body: simpleIconSet.icons.apachespark.body },
  { label: 'SQLite', body: simpleIconSet.icons.sqlite.body },
  { label: 'Polars', body: simpleIconSet.icons.polars.body },
];

type Icon = { src: string; w: number; h: number } | { ph: string } | { emoji: string };
type NodeSeed = {
  id: string;
  stage: number;
  order: number;
  title: string;
  lines: string[];
  icon: Icon;
  href?: string;
  product?: boolean;
  badge?: string;
  langs?: typeof LANGS;
  external?: boolean;
};

const seeds: NodeSeed[] = [
  { id: 'cupola', stage: 0, order: 0, title: 'Cupola', lines: ['Explore and query data yourself', 'or with agents in the browser'], icon: { src: '/cupola/cupola-mark.svg', w: 27, h: 27 }, href: '/products/cupola', product: true },
  { id: 'apps', stage: 0, order: 2, title: 'Your app or BI tool', lines: ['Connect through standard database drivers'], icon: { ph: 'app-window' } },
  { id: 'cli', stage: 0, order: 3, title: 'CLI & notebooks', lines: ['Explore interactively or automate workflows'], icon: { ph: 'terminal-window' } },
  { id: 'agents', stage: 0, order: 1, title: 'Agents & MCP servers', lines: ['Connect agents and data tools through MCP'], icon: { ph: 'robot' } },
  { id: 'haybarn', stage: 1, order: 0, title: 'Haybarn', lines: ['Signed, reproducible DuckDB distribution'], icon: { src: '/haybarn/haybarn-mark.svg', w: 31, h: 31 }, href: '/haybarn', product: true },
  { id: 'future-engines', stage: 1, order: 1, title: 'More query engines', lines: ['VGI integrations are on the way'], icon: { ph: 'cube' }, badge: 'Coming soon' },
  { id: 'extensions', stage: 2, order: 0, title: 'DuckDB extensions', lines: [`Add ${extensionCount} installable SQL capabilities`, 'Runs in-process; nothing else to deploy'], icon: { src: '/images/duckdb-icon.svg', w: 28, h: 28 }, href: '/products/extensions', product: true },
  { id: 'vgi', stage: 2, order: 1, title: 'Vector Gateway Interface', lines: ['Connect query engines to remote capabilities', 'Arrow IPC over pipes, sockets, or HTTP'], icon: { src: '/vgi/vgi-emblem.png', w: 50, h: 38 }, href: '/vgi', product: true },
  { id: 'rowfence', stage: 3, order: 0, title: 'Rowfence', lines: ['Authorize access to rows and columns', 'Policies decide what each caller can use'], icon: { src: '/rowfence/rowfence-icon.svg', w: 28, h: 28 }, href: '/products/rowfence', product: true },
  { id: 'workers', stage: 4, order: 0, title: 'VGI workers', lines: ['Turn APIs, models, and custom logic into SQL'], icon: { src: '/vgi/vgi-emblem.png', w: 50, h: 38 }, href: '/vgi/building-a-worker', product: true, langs: LANGS },
  { id: 'orchard', stage: 4, order: 1, title: 'Orchard Platform', lines: ['Managed VGI workers as a service'], icon: { emoji: '🌳' }, href: '/products/orchard', product: true, badge: 'Coming soon' },
  { id: 'sources', stage: 5, order: 0, title: 'Anything a worker can reach', lines: ['APIs · services · databases · files · models · libraries'], icon: { ph: 'database' }, external: true },
];

const nodes = seeds.map((seed) => {
  const cx = exploration.centers[seed.stage][seed.order];
  const w = stageWidth[seed.stage];
  const h = seed.stage === 0 ? 138 : stageHeight[seed.stage];
  const y = seed.stage === 0
    ? stageTop[0] + Math.floor(seed.order / 2) * (h + 24)
    : stageTop[seed.stage];
  return { ...seed, cx, x: cx - w / 2, y, w, h };
});
const byId = Object.fromEntries(nodes.map((node) => [node.id, node]));

const edgeSeeds = [
  ['cupola', 'haybarn', 'shared'],
  ['apps', 'haybarn', 'shared'],
  ['apps', 'future-engines', 'shared'],
  ['cli', 'future-engines', 'shared'],
  ['agents', 'future-engines', 'shared'],
  ['haybarn', 'extensions', 'native'],
  ['haybarn', 'vgi', 'vgi'],
  ['future-engines', 'vgi', 'vgi'],
  ['vgi', 'workers', 'vgi'],
  ['vgi', 'orchard', 'vgi'],
  ['vgi', 'rowfence', 'optional'],
  ['rowfence', 'workers', 'vgi'],
  ['rowfence', 'orchard', 'vgi'],
  ['workers', 'sources', 'vgi'],
  ['orchard', 'sources', 'vgi'],
] as const;

const edgePath = (from: (typeof nodes)[number], to: (typeof nodes)[number], index: number) => {
  const x1 = from.cx;
  const y1 = from.y + from.h;
  const x2 = to.cx;
  const y2 = to.y;
  const midY = (y1 + y2) / 2;
  const bend = index % 2 === 0 ? -32 : 32;
  if (from.stage === 0 && from.y === stageTop[0]) {
    const channelX = from.cx < VB_W / 2 ? 580 : 640;
    return `M${x1} ${y1} V${stageCenters[0]} H${channelX} V${queryBusY} H${x2} V${y2}`;
  }
  if (from.stage === 0) {
    return `M${x1} ${y1} V${queryBusY} H${x2} V${y2}`;
  }
  if (from.id === 'haybarn' && to.id === 'extensions') {
    const nativePortX = from.cx - 72;
    return `M${nativePortX} ${y1} V${y2}`;
  }
  if (from.id === 'haybarn' && to.id === 'vgi') {
    const haybarnPortX = from.cx + 72;
    const vgiPortX = to.cx - 72;
    return `M${haybarnPortX} ${y1} V${y2 - 18} H${vgiPortX} V${y2}`;
  }
  if (from.id === 'future-engines' && to.id === 'vgi') {
    return `M${x1} ${y1} V${y2}`;
  }
  if (from.id === 'vgi' && (to.id === 'workers' || to.id === 'orchard')) {
    return to.id === 'orchard'
      ? `M${x1} ${y1} V${y2}`
      : `M${x1} ${y1} V${y2 - 28} H${x2} V${y2}`;
  }
  if (from.id === 'rowfence' && (to.id === 'workers' || to.id === 'orchard')) {
    return `M${x1} ${y1} V${y2 - 28} H${x2} V${y2}`;
  }
  switch (exploration.flow) {
    case 'straight':
      return `M${x1} ${y1} L${x2} ${y2}`;
    case 'orthogonal':
      return `M${x1} ${y1} V${midY} H${x2} V${y2}`;
    case 'sweep': {
      const midX = (x1 + x2) / 2 + bend;
      return `M${x1} ${y1} C${midX} ${y1 + 36} ${midX} ${y2 - 36} ${x2} ${y2}`;
    }
    case 'stepped': {
      const firstY = y1 + (y2 - y1) * 0.35;
      const secondY = y1 + (y2 - y1) * 0.68;
      return `M${x1} ${y1} V${firstY} L${x2} ${secondY} V${y2}`;
    }
    default:
      return `M${x1} ${y1} C${x1} ${midY} ${x2} ${midY} ${x2} ${y2}`;
  }
};

const edges = edgeSeeds.map(([fromId, toId, lane], index) => ({
  id: `${exploration.slug}-wire-${index}`,
  fromId,
  toId,
  lane,
  d: edgePath(byId[fromId], byId[toId], index),
  delay: (index * 0.21) % 1.7,
}));

const animatedConnections = new Map<string, 'query' | 'result'>([
  ['cupola:haybarn', 'query'],
  ['agents:future-engines', 'query'],
  ['haybarn:extensions', 'query'],
  ['future-engines:vgi', 'query'],
  ['vgi:workers', 'query'],
  ['vgi:orchard', 'result'],
  ['vgi:rowfence', 'query'],
  ['rowfence:workers', 'result'],
]);
const packetEdges = edges
  .filter((edge) => animatedConnections.has(`${edge.fromId}:${edge.toId}`))
  .map((edge, packetIndex) => ({
    ...edge,
    direction: animatedConnections.get(`${edge.fromId}:${edge.toId}`),
    packetDelay: packetIndex * 0.9,
  }));

const iconTransform = (vb: { x: number; y: number; w: number; h: number }, size: number, cx: number, cy: number) => {
  const scale = size / vb.w;
  return `translate(${(cx - (vb.w / 2) * scale - vb.x * scale).toFixed(2)},${(cy - (vb.h / 2) * scale - vb.y * scale).toFixed(2)}) scale(${scale.toFixed(5)})`;
};

const nodeRadius = exploration.treatment === 'circuit' || exploration.treatment === 'blueprint'
  ? 5
  : exploration.treatment === 'metro' || exploration.treatment === 'constellation'
    ? 36
    : exploration.treatment === 'conveyor'
      ? 11
      : 18;

const ariaLabel = `Query.Farm product map, ${exploration.name}: Cupola, apps, BI tools, command-line clients, notebooks, agents, and MCP servers connect to Haybarn or forthcoming VGI integrations for Apache DataFusion, Trino, Spark, SQLite, and Polars. Haybarn is Query.Farm's signed, reproducible distribution built on DuckDB. Haybarn loads native extensions or VGI, while the additional engines connect to VGI. VGI connects directly to self-run workers or the Orchard Platform, with Rowfence available as an optional authorization layer. Workers reach APIs, services, databases, files, models, and libraries.`;
---

<div class:list={['exploration-shell', `treatment-${exploration.treatment}`]}>
  <div class="canvas-scroll">
    <svg
      class="exploration-flow"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      aria-label={ariaLabel}
    >
      <defs>
        <pattern id={`${exploration.slug}-grid`} width="28" height="28" patternUnits="userSpaceOnUse">
          <path d="M28 0H0V28" class="grid-line" fill="none" stroke-width="1" />
        </pattern>
        <pattern id={`${exploration.slug}-columns`} width="28" height={VB_H} patternUnits="userSpaceOnUse">
          <path d={`M28 0V${VB_H}`} class="grid-line" fill="none" stroke-width="1" />
        </pattern>
        <linearGradient id={`${exploration.slug}-ribbon`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="ribbon-start" />
          <stop offset="1" class="ribbon-end" />
        </linearGradient>
      </defs>

      {exploration.treatment === 'circuit' && (
        <>
          <rect x="0" y="0" width="174" height={VB_H} class="circuit-label-rail" />
          <rect x="174" y="0" width={VB_W - 174} height={VB_H} fill={`url(#${exploration.slug}-columns)`} />
          {circuitBands.map((band) => (
            <rect
              x="174"
              y={band.y}
              width={VB_W - 174}
              height={band.height}
              class:list={['circuit-layer-band', `circuit-band-${band.index}`]}
              data-stage={band.index}
            />
          ))}
          <path d={`M174 0 V${VB_H}`} class="circuit-label-divider" />
          {stageTop.map((y, i) => (
            <path d={`M174 ${y + stageHeight[i] / 2} H1072`} class="circuit-layer-line" />
          ))}
        </>
      )}
      {exploration.treatment === 'blueprint' && (
        <rect x="0" y="0" width={VB_W} height={VB_H} fill={`url(#${exploration.slug}-grid)`} />
      )}
      {exploration.treatment === 'terraces' && stageTop.map((y, i) => (
        <rect x="148" y={y - 18} width="914" height={stageHeight[i] + 36} rx="22" class:list={['terrace', i % 2 ? 'terrace-even' : 'terrace-odd']} />
      ))}
      {exploration.treatment === 'furrows' && (
        <>
          <path d="M385 496 C385 630 385 790 390 910" class="native-furrow" />
          <path d="M815 496 C815 625 800 790 810 1040" class="vgi-furrow" />
        </>
      )}
      {exploration.treatment === 'metro' && (
        <>
          <path d="M370 500 V885" class="metro-native" />
          <path d="M830 500 V885" class="metro-vgi" />
        </>
      )}
      {exploration.treatment === 'loom' && [280, 390, 500, 610, 720, 830, 940].map((x, i) => (
        <path d={`M${x} 150 C${x + (i % 2 ? 80 : -80)} 450 ${x + (i % 2 ? -60 : 60)} 720 ${x} 1045`} class="loom-thread" />
      ))}
      {exploration.treatment === 'irrigation' && (
        <>
          <path d="M610 150 V350 C610 440 840 455 840 545 V1042" class="canal-bed" />
          <path d="M610 325 C520 375 430 380 360 400" class="canal-branch" />
        </>
      )}
      {exploration.treatment === 'cutaway' && (
        <>
          <rect x="245" y="184" width="690" height="360" rx="44" class="engine-boundary" />
          <text x="270" y="210" class="boundary-label">DUCKDB PROCESS</text>
          <path d="M810 518 V572" class="boundary-gate" />
        </>
      )}
      {exploration.treatment === 'constellation' && stageTop.slice(0, 5).map((y, i) => (
        <ellipse cx={610 + (i % 2 ? 45 : -35)} cy={y + stageHeight[i] / 2} rx={430 - i * 22} ry={72} class="orbit" />
      ))}
      {exploration.treatment === 'conveyor' && (
        <path d="M180 92 H1020 L190 272 H1010 L180 454 H1020 L190 636 H1010 L180 818 H1020 L220 996 H1000" class="conveyor-bed" />
      )}
      {exploration.treatment === 'blueprint' && (
        <path d="M610 150 V1040" class="blueprint-axis" />
      )}

      {stageLabels.map((label, i) => (
        <g class="stage-marker" data-stage={i}>
          <text
            x={stageLabelX}
            y={hasCircuitLabelRail
              ? stageTop[i] + stageHeight[i] / 2 + (label === 'Engine integration' ? -4 : 4)
              : stageTop[i] + 23}
            text-anchor="end"
          >
            {label === 'Engine integration' ? (
              <>
                <tspan x={stageLabelX}>ENGINE</tspan>
                <tspan x={stageLabelX} dy="15">INTEGRATION</tspan>
              </>
            ) : label.toUpperCase()}
          </text>
          {hasCircuitLabelRail ? (
            <path d={stageBracePath(stageTop[i], stageHeight[i])} class="stage-brace" />
          ) : (
            <path d={`M143 ${stageTop[i] + 18} H158`} />
          )}
        </g>
      ))}

      <g class="wires">
        {edges.map((edge) => (
          <path
            id={edge.id}
            d={edge.d}
            class:list={byId[edge.fromId].stage === 0 ? ['motion-path'] : ['wire', `lane-${edge.lane}`]}
            fill="none"
          />
        ))}
        <g class="query-network">
          <path d={`M${byId.cupola.cx} ${byId.cupola.y + byId.cupola.h} V${stageCenters[0]} H580 V${queryBusY}`} />
          <path d={`M${byId.agents.cx} ${byId.agents.y + byId.agents.h} V${stageCenters[0]} H640 V${queryBusY}`} />
          <path d={`M${byId.apps.cx} ${byId.apps.y + byId.apps.h} V${queryBusY}`} />
          <path d={`M${byId.cli.cx} ${byId.cli.y + byId.cli.h} V${queryBusY}`} />
          <path d={`M${Math.min(byId.haybarn.cx, byId.apps.cx)} ${queryBusY} H${Math.max(byId.cli.cx, byId['future-engines'].cx)}`} />
          <path d={`M${byId.haybarn.cx} ${queryBusY} V${byId.haybarn.y}`} />
          <path d={`M${byId['future-engines'].cx} ${queryBusY} V${byId['future-engines'].y}`} />
        </g>
      </g>

      <g class="packets" aria-hidden="true">
        {packetEdges.map((edge) => (
          edge.direction === 'query' ? (
            <path d="M0 -7L8 0 0 7 -8 0Z" class="query-packet-svg">
              <animateMotion dur="5.8s" repeatCount="indefinite" begin={`${edge.packetDelay.toFixed(2)}s`}>
                <mpath xlink:href={`#${edge.id}`} />
              </animateMotion>
            </path>
          ) : (
            <path d="M0 -6L7 0 0 6 -7 0Z" class="result-packet-svg">
              <animateMotion dur="6.4s" repeatCount="indefinite" begin={`${edge.packetDelay.toFixed(2)}s`} keyPoints="1;0" keyTimes="0;1" calcMode="linear">
                <mpath xlink:href={`#${edge.id}`} />
              </animateMotion>
            </path>
          )
        ))}
      </g>

      <g class="nodes">
        {nodes.map((node) => {
          const NodeTag = node.href ? 'a' : 'g';
          const nodeProps = node.href ? { href: node.href, class: 'node-link', 'aria-label': node.title } : {};
          const integrationMarks = QUERY_SURFACE_MARKS[node.id as keyof typeof QUERY_SURFACE_MARKS];
          const usesVgiEmblem = node.id === 'vgi' || node.id === 'workers';
          const isCupola = node.id === 'cupola';
          const iconCx = node.x + (usesVgiEmblem ? 39 : 31);
          const iconCy = node.y + 30;
          const titleX = node.x + (usesVgiEmblem ? 76 : 55);
          return (
            <NodeTag {...nodeProps} data-node={node.id} data-stage={node.stage}>
              <rect
                x={node.x}
                y={node.y}
                width={node.w}
                height={node.h}
                rx={nodeRadius}
                class:list={['node-card', node.product && 'product-node', node.external && 'external-node', node.id === 'future-engines' && 'future-engine-node']}
              />
              {'ph' in node.icon ? (
                <g class="node-icon" transform={iconTransform(PH_VB, 27, iconCx, iconCy)} set:html={PH[node.icon.ph]} />
              ) : 'emoji' in node.icon ? (
                <text x={iconCx} y={iconCy + 2} text-anchor="middle" dominant-baseline="central" class="emoji-icon">{node.icon.emoji}</text>
              ) : (
                <image href={node.icon.src} x={iconCx - node.icon.w / 2} y={iconCy - node.icon.h / 2} width={node.icon.w} height={node.icon.h} />
              )}
              <text x={titleX} y={node.y + (isCupola ? 32 : 36)} class="node-title">{node.title}</text>
              {node.badge && <text x={node.x + node.w - 18} y={node.y + 25} text-anchor="end" class="node-badge">{node.badge.toUpperCase()}</text>}
              {node.lines.map((line, lineIndex) => (
                <text
                  x={node.x + 22}
                  y={node.y + (isCupola ? 56 + lineIndex * 18 : 64 + lineIndex * 21)}
                  class="node-copy"
                >
                  {line}
                </text>
              ))}
              {node.id === 'haybarn' && (
                <g class="duckdb-foundation" aria-label="Built on DuckDB">
                  <rect x={node.x + 21} y={node.y + 82} width="137" height="30" rx="15" />
                  <image href="/images/duckdb-icon.svg" x={node.x + 29} y={node.y + 87} width="20" height="20" />
                  <text x={node.x + 57} y={node.y + 101}>BUILT ON <tspan>DuckDB</tspan></text>
                </g>
              )}
              {node.id === 'future-engines' && ENGINE_MARKS.map((mark, markIndex) => {
                const markX = node.x + 38 + markIndex * 64;
                const markY = node.y + 98;
                return (
                  <g class="engine-mark">
                    {mark.src ? (
                      <image href={mark.src} x={markX - 11} y={markY - 12} width="22" height="24" />
                    ) : (
                      <g transform={iconTransform(SI_VB, 22, markX, markY)} set:html={mark.body} />
                    )}
                    <text x={markX} y={node.y + 124} text-anchor="middle">{mark.label}</text>
                  </g>
                );
              })}
              {node.id === 'sources' && SOURCE_MARKS.map((format, formatIndex) => {
                const formatX = node.x + 405 + formatIndex * 82;
                return (
                  <g class="format-mark">
                    {format.src ? (
                      <image class="format-brand-image" href={format.src} x={formatX - 13} y={node.y + 18} width="26" height="26" />
                    ) : (
                      <g transform={iconTransform(SI_VB, 25, formatX, node.y + 31)} set:html={format.body} />
                    )}
                    <text x={formatX} y={node.y + 62} text-anchor="middle">{format.label}</text>
                  </g>
                );
              })}
              {integrationMarks?.map((mark, markIndex) => {
                const isAgentMark = node.id === 'agents';
                const markGap = isAgentMark ? 70 : node.id === 'cli' ? 80 : 108;
                const markX = node.x + (isAgentMark ? 35 : 29) + markIndex * markGap;
                const markY = node.y + (isCupola ? 96 : 91);
                return (
                  <g class="integration-mark">
                    <g transform={iconTransform(SI_VB, isAgentMark ? 20 : 21, markX, markY)} set:html={mark.body} />
                    <text
                      x={isAgentMark ? markX : markX + 16}
                      y={node.y + (isAgentMark ? 119 : isCupola ? 100 : 95)}
                      text-anchor={isAgentMark ? 'middle' : 'start'}
                    >
                      {mark.label}
                    </text>
                  </g>
                );
              })}
              {node.langs?.map((lang, langIndex) => (
                <g
                  class="language-icon"
                  transform={iconTransform(SI_VB, 26, node.x + 26 + 40 * langIndex, node.y + 94)}
                  set:html={SI[lang.key]}
                />
              ))}
              {node.langs && <text x={node.x + node.w - 17} y={node.y + 99} text-anchor="end" class="language-label">FIVE SDKs · ONE PROTOCOL</text>}
              {node.href && (
                <>
                  <text
                    x={node.x + node.w - 34}
                    y={node.y + node.h - 17}
                    text-anchor="end"
                    class="node-cta"
                  >
                    Learn more
                  </text>
                  <g class="node-cta-icon" transform={`translate(${node.x + node.w - 20} ${node.y + node.h - 21})`}>
                    <circle r="7" />
                    <path d="M-3 0H3M0-3l3 3-3 3" />
                  </g>
                </>
              )}
            </NodeTag>
          );
        })}
      </g>

      <g class="legend" transform={`translate(644 ${VB_H - 30})`}>
        <rect x="-17" y="-20" width="425" height="40" rx="20" class="legend-background" />
        <g class="legend-query" transform="translate(0 0)">
          <path d="M0 -10V9M-4 5L0 9l4-4" />
          <path d="M0 -5L5 0 0 5 -5 0Z" class="legend-packet" transform="translate(0 -3)" />
          <text x="14" y="4">SQL query travels down</text>
        </g>
        <g class="legend-result" transform="translate(218 0)">
          <path d="M0 10V-9M-4 -5L0-9l4 4" />
          <path d="M0 -4.5L4.5 0 0 4.5 -4.5 0Z" class="legend-packet" transform="translate(0 3)" />
          <text x="14" y="4">Arrow results return up</text>
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
