  /* 7 — the process boundary is part of the explanation, not a footnote. */
  .engine-boundary { fill: color-mix(in srgb, var(--color-soil-100) 68%, transparent); stroke: var(--color-soil-500); stroke-width: 3; stroke-dasharray: 11 8; }
  .boundary-label { fill: var(--color-soil-600); font-size: 11px; font-weight: 800; letter-spacing: .12em; }
  .boundary-gate { stroke: var(--color-field-700); stroke-width: 14; stroke-linecap: round; }
  .treatment-cutaway .lane-vgi { stroke: var(--color-field-700); }

  /* 8 — orbit lines turn the product family into a connected constellation. */
  .orbit { fill: none; stroke: var(--color-soil-300); stroke-width: 1.5; stroke-dasharray: 4 9; opacity: .75; }
  .treatment-constellation .wire { stroke-width: 3.5; stroke-dasharray: 8 6; }
  .treatment-constellation .node-card { fill: color-mix(in srgb, #fffdf7 92%, transparent); }

  /* 9 — one continuous folded belt passes work from stage to stage. */
  .conveyor-bed { fill: none; stroke: var(--color-sun-200); stroke-width: 54; stroke-linecap: round; stroke-linejoin: round; opacity: .38; }
  .treatment-conveyor .wire { stroke: var(--color-soil-600); stroke-width: 5; }
