---
import ExtensionCard from './ExtensionCard.astro';

interface Extension {
  id: string;
  name: string;
  description: string;
  category: string;
  status: 'stable' | 'beta' | 'experimental';
  icon?: string;
  githubUrl?: string;
  docsUrl?: string;
  features?: string[];
}

interface Props {
  title: string;
  description?: string;
  extensions: Extension[];
  icon?: string;
}

const { title, description, extensions, icon } = Astro.props;
---

<section class="mb-16">
  <div class="flex items-center gap-3 mb-6">
    {icon && (
      <div class="w-12 h-12 rounded-xl bg-earth-100 flex items-center justify-center text-3xl">
        {icon}
      </div>
    )}
    <div>
      <h2 class="text-2xl md:text-3xl font-bold text-soil-900">
        {title}
      </h2>
      {description && (
        <p class="text-soil-600 mt-1">
          {description}
        </p>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {extensions.map(extension => (
      <ExtensionCard {...extension} />
    ))}
  </div>
</section>
