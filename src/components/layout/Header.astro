---
import Button from '../ui/Button.astro';
import SearchWidget from './SearchWidget.astro';
import { LATEST_STATUS_URL } from '../../data/haybarn-versions';
import { publicExtensions } from '../../data/extensions';

const currentPath = Astro.url.pathname;

// The most-used extensions (by load count) surfaced directly in the Products
// mega-menu so they're one hover away instead of buried behind the index.
const topExtensions = [...publicExtensions]
  .sort((a, b) => (b.usageCount ?? -1) - (a.usageCount ?? -1))
  .slice(0, 6)
  .map(e => ({ name: e.name, href: `/products/extensions/${e.id}` }));

const navigation = [
  { name: 'Home', href: '/' },
  {
    name: 'Products',
    href: '/products',
    megaMenu: [
      {
        title: 'DuckDB Extensions',
        href: '/products/extensions',
        icon: '/images/duckdb-icon.svg',
        description: 'Connectors, functions, sketches, scripting, and SQL tools you can install into DuckDB.',
        items: topExtensions
      },
      {
        title: 'Vector Gateway Interface',
        href: '/vgi',
        icon: '/vgi/vgi-logo.png',
        description: 'Call any code or data anywhere from SQL.',
        items: [
          { name: 'Overview', href: '/vgi' },
          { name: 'Getting Started', href: '/vgi/getting-started' },
          { name: 'Building a Worker', href: '/vgi/building-a-worker' },
          { name: 'Architecture', href: '/vgi/architecture' },
          { name: 'Languages', href: '/vgi/languages' }
        ]
      },
      {
        title: 'Haybarn',
        href: '/haybarn',
        icon: '/haybarn/haybarn-logo.png',
        description: 'A compatible DuckDB distribution with signed builds and production extension packaging.',
        items: [
          { name: 'Overview', href: '/haybarn' },
          { name: 'Install', href: '/haybarn/install' },
          { name: 'Security', href: '/haybarn/security' },
          { name: 'Extensions', href: '/haybarn/extensions' },
          { name: 'Status', href: LATEST_STATUS_URL },
          { name: 'Contribute', href: '/haybarn/community-extensions' },
          { name: 'Compatibility & FAQ', href: '/haybarn/compatibility' }
        ]
      }
    ]
  },
  { name: 'Blog', href: '/blog' },
  {
    name: 'Company',
    href: '/company/about',
    dropdown: [
      { name: 'About', href: '/company/about' },
      { name: 'Consulting', href: '/consulting' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'Schedule Meeting', href: '/company/schedule' }
    ]
  }
];

function isActive(href: string, currentPath: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header data-pagefind-ignore class="sticky top-0 z-50 border-b border-soil-900/10 bg-white/90 shadow-sm backdrop-blur-md">
  <nav class="w-full px-4 sm:px-6 lg:px-8">
    <div class="grid h-16 grid-cols-[auto_1fr_auto] items-center gap-4 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-1 font-display font-bold text-xl lg:text-2xl text-soil-900 transition-colors hover:text-harvest-700">
        <span class="relative block h-11 w-12 overflow-hidden lg:h-12 lg:w-14">
          <img
            src="/Query_Farm_Logo_Transparent.png"
            alt=""
            width="88"
            height="56"
            class="absolute left-1/2 top-1/2 h-14 w-[5.5rem] max-w-none -translate-x-[56%] -translate-y-1/2 object-contain lg:h-16 lg:w-24"
          />
        </span>
        <span>Query.Farm</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center justify-center space-x-1">
        {navigation.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-4 py-2 font-semibold transition-colors duration-200',
                isActive(item.href, currentPath)
                  ? 'bg-grain-200 text-soil-900'
                  : 'text-soil-700 hover:bg-grain-100 hover:text-soil-900'
              ]}
            >
              {item.name}
              {(item.dropdown || item.megaMenu) && (
                <svg class="inline-block ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.dropdown && (
              <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                <div class="rounded-xl border-2 border-soil-900 bg-white py-2 shadow-xl">
                  {item.dropdown.map(subItem => (
                    <a
                      href={subItem.href}
                      class:list={[
                        'block px-4 py-2 text-sm font-semibold transition-colors duration-200',
                        isActive(subItem.href, currentPath)
                          ? 'bg-grain-100 text-soil-900'
                          : 'text-soil-700 hover:bg-grain-50 hover:text-soil-900'
                      ]}
                    >
                      {subItem.name}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {item.megaMenu && (
              <div class="absolute left-1/2 -translate-x-1/2 mt-2 w-[760px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                <div class="rounded-xl border-2 border-soil-900 bg-white p-6 shadow-xl">
                  <div class="grid grid-cols-3 gap-6">
                    {item.megaMenu.map(col => (
                      <div>
                        <a
                          href={col.href}
                          class:list={[
                            'block group/col rounded-lg px-3 py-2 -mx-3 -mt-2 transition-colors',
                            isActive(col.href, currentPath)
                              ? 'bg-grain-100'
                              : 'hover:bg-grain-50'
                          ]}
                        >
                          <div class:list={[
                            'flex items-center gap-2 font-semibold text-sm',
                            isActive(col.href, currentPath) ? 'text-soil-900' : 'text-soil-900 group-hover/col:text-harvest-700'
                          ]}>
                            {col.icon && (
                              <img src={col.icon} alt="" aria-hidden="true" width="20" height="20" class="w-5 h-5 object-contain shrink-0" />
                            )}
                            <span>{col.title}</span>
                          </div>
                          {col.description && (
                            <p class="text-xs text-soil-600 mt-1 leading-snug">{col.description}</p>
                          )}
                        </a>
                        {col.title === 'DuckDB Extensions' ? (
                          <div class="mt-2 border-l-2 border-soil-900/15 ml-3 pl-3 space-y-3">
                            <div id="nav-recent-wrap" hidden>
                              <p class="px-2 mb-0.5 text-[11px] font-semibold uppercase tracking-wider text-soil-400">Recently viewed</p>
                              <ul id="nav-recent-extensions" class="space-y-0.5"></ul>
                            </div>
                            <div>
                              <p class="px-2 mb-0.5 text-[11px] font-semibold uppercase tracking-wider text-soil-400">Most used</p>
                              <ul id="nav-top-extensions" class="space-y-0.5">
                                {col.items.map(sub => (
                                  <li>
                                    <a
                                      href={sub.href}
                                      class:list={[
                                        'block px-2 py-1 rounded text-sm transition-colors',
                                        isActive(sub.href, currentPath)
                                          ? 'bg-grain-100 text-soil-900'
                                          : 'text-soil-600 hover:bg-grain-50 hover:text-soil-900'
                                      ]}
                                    >{sub.name}</a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                            <a href="/products/extensions" class="block px-2 py-1 text-sm font-medium text-harvest-700 hover:text-harvest-800 transition-colors">Browse all extensions →</a>
                          </div>
                        ) : (
                          col.items.length > 0 && (
                          <ul class="mt-2 space-y-0.5 border-l-2 border-soil-900/15 ml-3 pl-3">
                            {col.items.map(sub => (
                              <li>
                                <a
                                  href={sub.href}
                                  class:list={[
                                    'block px-2 py-1 rounded text-sm transition-colors',
                                    isActive(sub.href, currentPath)
                                      ? 'bg-grain-100 text-soil-900'
                                      : 'text-soil-600 hover:bg-grain-50 hover:text-soil-900'
                                  ]}
                                >
                                  {sub.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                          )
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Right cluster: search (always), CTA (desktop), menu (mobile) -->
      <div class="justify-self-end flex items-center gap-2 lg:gap-3">
        <SearchWidget />
        <div class="hidden lg:flex items-center gap-3">
          <Button href="/company/schedule" variant="accent" size="sm">
            Talk with Us
          </Button>
        </div>
        <button
          id="mobile-menu-button"
          class="rounded-lg border border-soil-900/20 p-2 text-soil-700 transition-colors hover:bg-grain-50 hover:text-soil-900 lg:hidden"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Populate the "Recently viewed" extensions in the Products mega-menu from the
  // list recorded on extension detail pages (localStorage key qf:recentExtensions).
  try {
    const ul = document.getElementById('nav-recent-extensions');
    const wrap = document.getElementById('nav-recent-wrap');
    // Don't repeat an extension that's already shown under "Most used".
    const topSlugs = new Set(
      Array.from(document.querySelectorAll('#nav-top-extensions a[href^="/products/extensions/"]'))
        .map((a) => (a.getAttribute('href') || '').split('/').pop())
    );
    const recent = JSON.parse(localStorage.getItem('qf:recentExtensions') || '[]')
      .filter((e: { id?: string }) => e && e.id && !topSlugs.has(e.id));
    if (ul && wrap && Array.isArray(recent) && recent.length) {
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
      ul.innerHTML = recent.slice(0, 4).map((e: { id: string; name?: string }) =>
        `<li><a href="/products/extensions/${encodeURIComponent(e.id)}" class="block px-2 py-1 rounded text-sm text-soil-600 hover:bg-grain-50 hover:text-soil-900 transition-colors">${esc(e.name || e.id)}</a></li>`
      ).join('');
      wrap.hidden = false;
    }
  } catch { /* ignore storage/parse errors */ }
</script>
