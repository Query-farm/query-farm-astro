---
import Button from '../ui/Button.astro';
import { LATEST_STATUS_URL } from '../../data/haybarn-versions';

const currentPath = Astro.url.pathname;

const navigation = [
  { name: 'Home', href: '/' },
  {
    name: 'Products',
    href: '/products',
    megaMenu: [
      {
        title: 'DuckDB Extensions',
        href: '/products/extensions',
        description: 'Connectors, functions, sketches, scripting, and SQL tools you can install into DuckDB.',
        items: []
      },
      {
        title: 'Vector Gateway Interface',
        href: '/vgi',
        description: 'Call Python, TypeScript, Go, Rust, Java, or C++ code from DuckDB SQL.',
        items: [
          { name: 'Overview', href: '/vgi' },
          { name: 'Getting Started', href: '/vgi/getting-started' },
          { name: 'Architecture', href: '/vgi/architecture' },
          { name: 'Languages', href: '/vgi/languages' }
        ]
      },
      {
        title: 'Haybarn',
        href: '/haybarn',
        description: 'A compatible DuckDB distribution with signed builds and production extension packaging.',
        items: [
          { name: 'Overview', href: '/haybarn' },
          { name: 'Install', href: '/haybarn/install' },
          { name: 'Extensions', href: '/haybarn/extensions' },
          { name: 'Status', href: LATEST_STATUS_URL },
          { name: 'Contribute', href: '/haybarn/community-extensions' },
          { name: 'Compatibility & FAQ', href: '/haybarn/compatibility' }
        ]
      }
    ]
  },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' },
  {
    name: 'Company',
    href: '/company/about',
    dropdown: [
      { name: 'About', href: '/company/about' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'Schedule Meeting', href: '/company/schedule' }
    ]
  }
];

function isActive(href: string, currentPath: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-soil-200 shadow-sm">
  <nav class="section-container">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 font-display font-bold text-xl lg:text-2xl text-soil-900 hover:text-earth-700 transition-colors">
        <span class="text-2xl lg:text-3xl">🚜</span>
        <span>Query.Farm</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1">
        {navigation.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-4 py-2 rounded-lg font-medium transition-colors duration-200',
                isActive(item.href, currentPath)
                  ? 'text-earth-700 bg-earth-50'
                  : 'text-soil-700 hover:text-earth-700 hover:bg-soil-50'
              ]}
            >
              {item.name}
              {(item.dropdown || item.megaMenu) && (
                <svg class="inline-block ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.dropdown && (
              <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                <div class="bg-white rounded-xl shadow-lg border border-soil-200 py-2">
                  {item.dropdown.map(subItem => (
                    <a
                      href={subItem.href}
                      class:list={[
                        'block px-4 py-2 text-sm font-medium transition-colors duration-200',
                        isActive(subItem.href, currentPath)
                          ? 'text-earth-700 bg-earth-50'
                          : 'text-soil-700 hover:text-earth-700 hover:bg-soil-50'
                      ]}
                    >
                      {subItem.name}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {item.megaMenu && (
              <div class="absolute left-1/2 -translate-x-1/2 mt-2 w-[760px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                <div class="bg-white rounded-xl shadow-xl border border-soil-200 p-6">
                  <div class="grid grid-cols-3 gap-6">
                    {item.megaMenu.map(col => (
                      <div>
                        <a
                          href={col.href}
                          class:list={[
                            'block group/col rounded-lg px-3 py-2 -mx-3 -mt-2 transition-colors',
                            isActive(col.href, currentPath)
                              ? 'bg-earth-50'
                              : 'hover:bg-soil-50'
                          ]}
                        >
                          <div class:list={[
                            'font-semibold text-sm',
                            isActive(col.href, currentPath) ? 'text-earth-700' : 'text-soil-900 group-hover/col:text-earth-700'
                          ]}>{col.title}</div>
                          {col.description && (
                            <p class="text-xs text-soil-600 mt-1 leading-snug">{col.description}</p>
                          )}
                        </a>
                        {col.items.length > 0 && (
                          <ul class="mt-2 space-y-0.5 border-l border-soil-200 ml-3 pl-3">
                            {col.items.map(sub => (
                              <li>
                                <a
                                  href={sub.href}
                                  class:list={[
                                    'block px-2 py-1 rounded text-sm transition-colors',
                                    isActive(sub.href, currentPath)
                                      ? 'text-earth-700 bg-earth-50'
                                      : 'text-soil-600 hover:text-earth-700 hover:bg-soil-50'
                                  ]}
                                >
                                  {sub.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA Button (Desktop) -->
      <div class="hidden lg:block">
        <Button href="/company/schedule" variant="accent" size="md">
          Talk to an Expert
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg text-soil-700 hover:text-earth-700 hover:bg-soil-50 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
