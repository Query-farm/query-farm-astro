---
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;

const navigation = [
  { name: 'Home', href: '/' },
  {
    name: 'Products',
    href: '/products',
    dropdown: [
      { name: 'DuckDB Extensions', href: '/products/extensions' },
      { name: 'Services', href: '/products/services' },
      { name: 'Ecosystem', href: '/products/ecosystem' }
    ]
  },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' },
  {
    name: 'Company',
    href: '/company/about',
    dropdown: [
      { name: 'About', href: '/company/about' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'Schedule Meeting', href: '/company/schedule' }
    ]
  }
];

function isActive(href: string, currentPath: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-soil-200 shadow-sm">
  <nav class="section-container">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 font-display font-bold text-xl lg:text-2xl text-soil-900 hover:text-earth-700 transition-colors">
        <span class="text-2xl lg:text-3xl">🚜</span>
        <span>Query.Farm</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1">
        {navigation.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-4 py-2 rounded-lg font-medium transition-colors duration-200',
                isActive(item.href, currentPath)
                  ? 'text-earth-700 bg-earth-50'
                  : 'text-soil-700 hover:text-earth-700 hover:bg-soil-50'
              ]}
            >
              {item.name}
              {item.dropdown && (
                <svg class="inline-block ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.dropdown && (
              <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                <div class="bg-white rounded-xl shadow-lg border border-soil-200 py-2">
                  {item.dropdown.map(subItem => (
                    <a
                      href={subItem.href}
                      class:list={[
                        'block px-4 py-2 text-sm font-medium transition-colors duration-200',
                        isActive(subItem.href, currentPath)
                          ? 'text-earth-700 bg-earth-50'
                          : 'text-soil-700 hover:text-earth-700 hover:bg-soil-50'
                      ]}
                    >
                      {subItem.name}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA Button (Desktop) -->
      <div class="hidden lg:block">
        <Button href="/company/schedule" variant="accent" size="md">
          Get Started
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg text-soil-700 hover:text-earth-700 hover:bg-soil-50 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
