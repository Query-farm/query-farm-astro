---
import Button from '../ui/Button.astro';
import StrataSun from '../ui/StrataSun.astro';
import SearchWidget from './SearchWidget.astro';
import { platformComponents } from '../../data/products';

const currentPath = Astro.url.pathname;

// One "Products" dropdown instead of a flat item per product — the bar was
// growing every time a new product shipped (Rowfence was the one that made
// it obviously too long). Data comes from src/data/products.ts, the same
// list /products itself renders, so a new product only has to be added once.
// This does mean the header no longer surfaces "most used extensions" /
// "recently viewed" quick links the old Extensions/Orchard panels had —
// that level of detail belongs to those products' own pages now, not a
// global dropdown holding six products at once.
const navigation: {
  name: string;
  href: string;
  panel?: 'products';
}[] = [
  { name: 'Products', href: '/products', panel: 'products' },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' }
];

function isActive(href: string, path: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

const panelLink =
  'block rounded px-2 py-1 text-sm text-soil-700 transition-colors hover:bg-soil-100 hover:text-soil-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-link';
const panelHeading = 'px-2 mb-1 qf-eyebrow text-soil-500';
const statusPill: Record<string, string> = {
  preview: 'inline-block rounded-full border border-sun-400 bg-sun-400/12 px-1.5 py-px text-[10px] font-medium text-sun-700',
  development: 'inline-block rounded-full border border-soil-300 px-1.5 py-px text-[10px] font-medium text-soil-700',
};
---

<header
  data-pagefind-ignore
  class="sticky top-0 z-50 h-[var(--qf-nav-h)] border-b border-soil-300 bg-soil-50/92 backdrop-blur-[10px]"
>
  <!-- Same container as the subnavs and page bodies, so the lockup lines up
       with the section mark below it and with the page's first column. -->
  <nav class="section-container flex h-full items-center justify-between gap-4" aria-label="Main">
    <!-- Lockup: Strata Sun + wordmark -->
    <a
      href="/"
      class="flex flex-none items-center gap-[0.32em] text-soil-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
    >
      <StrataSun size={30} />
      <span class="qf-wordmark text-[21px]">Query<span class="text-sun-700">.</span>Farm</span>
    </a>

    <!-- Desktop navigation -->
    <div class="hidden items-center gap-[17px] text-[14px] text-soil-700 xl:flex 2xl:gap-[22px] 2xl:text-[14.5px]">
      {navigation.map(item => (
        <div class="group relative">
          <a
            href={item.href}
            aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
            class:list={[
              'block border-b-[1.5px] pb-0.5 no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link',
              isActive(item.href, currentPath)
                ? 'border-link text-link'
                : 'border-transparent hover:border-link hover:text-link'
            ]}
          >
            {item.name}
          </a>

          {item.panel === 'products' && (
            <div class="invisible absolute left-1/2 top-full w-[560px] -translate-x-1/2 pt-4 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="rounded-xl border border-soil-300 bg-white p-4 shadow-xl">
                <p class={panelHeading}>The data farm</p>
                <ul class="grid grid-cols-2 gap-1">
                  {platformComponents.map(p => (
                    <li>
                      <a href={p.href} class={`${panelLink} flex items-start gap-2.5 px-2 py-2`}>
                        <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center overflow-hidden rounded-[6px] border border-soil-300 bg-soil-100 text-[13px]">
                          {p.img && <img src={p.img} alt="" width="16" height="16" class="h-4 w-4 object-contain" />}
                          {p.emoji && <span aria-hidden="true">{p.emoji}</span>}
                        </span>
                        <span class="min-w-0">
                          <span class="flex items-center gap-1.5">
                            <span class="font-medium text-soil-900">{p.title}</span>
                            {statusPill[p.status] && <span class={statusPill[p.status]}>{p.status === 'preview' ? 'Preview' : 'In development'}</span>}
                          </span>
                          <span class="block text-[12.5px] leading-snug text-soil-600">{p.outcome}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/products" class="mt-2 block border-t border-soil-200 px-2 pt-2.5 text-sm font-medium text-link no-underline transition-colors hover:text-link-hover">
                  See how it all fits together →
                </a>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Right cluster: search (always), CTA (desktop), menu (mobile) -->
    <div class="flex flex-none items-center gap-2 xl:gap-3">
      <SearchWidget />
      <div class="hidden xl:block">
        <Button href="/company/schedule" variant="primary" size="sm">
          Talk with Us
        </Button>
      </div>
      <button
        id="mobile-menu-button"
        class="rounded-lg border border-soil-300 p-2 text-soil-700 transition-colors hover:border-soil-900 hover:text-soil-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link xl:hidden"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // The mobile drawer's open/close wiring lives in MobileNav.astro; this file
  // only owns the trigger markup. The "recently viewed" extension/connector
  // localStorage panels that used to live here moved out when Extensions and
  // Orchard were folded into the single Products dropdown — that level of
  // detail belongs to those products' own pages now.
</script>
