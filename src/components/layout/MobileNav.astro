---
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;

const navigation = [
  { name: 'Home', href: '/' },
  {
    name: 'Products',
    items: [
      { name: 'DuckDB Extensions', href: '/products/extensions' },
      { name: 'Vector Gateway Interface', href: '/vgi' },
      { name: 'Haybarn', href: '/haybarn' }
    ]
  },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' },
  {
    name: 'Company',
    items: [
      { name: 'About', href: '/company/about' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'Schedule Meeting', href: '/company/schedule' }
    ]
  }
];

function isActive(href: string, currentPath: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="hidden lg:hidden fixed inset-0 z-50 bg-soil-900/50 backdrop-blur-sm">
  <div class="fixed right-0 top-0 bottom-0 w-full max-w-sm bg-white shadow-2xl">
    <div class="flex flex-col h-full">
      <!-- Mobile Menu Header -->
      <div class="flex items-center justify-between p-4 border-b border-soil-200">
        <a href="/" class="flex items-center gap-1 font-display font-bold text-xl text-soil-900">
          <span class="relative block h-10 w-12 overflow-hidden">
            <img
              src="/Query_Farm_Logo_Transparent.png"
              alt=""
              width="72"
              height="46"
              class="absolute left-1/2 top-1/2 h-12 w-[4.5rem] max-w-none -translate-x-[56%] -translate-y-1/2 object-contain"
            />
          </span>
          <span>Query.Farm</span>
        </a>
        <button
          id="mobile-menu-close"
          class="p-2 rounded-lg text-soil-700 hover:text-earth-700 hover:bg-soil-50 transition-colors"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Content -->
      <div class="flex-1 overflow-y-auto p-4">
        <nav class="space-y-2">
          {navigation.map(item => (
            <div>
              {item.href ? (
                <a
                  href={item.href}
                  class:list={[
                    'block px-4 py-3 rounded-lg font-medium transition-colors duration-200',
                    isActive(item.href, currentPath)
                      ? 'text-earth-700 bg-earth-50'
                      : 'text-soil-700 hover:text-earth-700 hover:bg-soil-50'
                  ]}
                >
                  {item.name}
                </a>
              ) : (
                <div>
                  <button
                    class="w-full flex items-center justify-between px-4 py-3 rounded-lg font-medium text-soil-700 hover:text-earth-700 hover:bg-soil-50 transition-colors duration-200 mobile-nav-toggle"
                  >
                    <span>{item.name}</span>
                    <svg class="w-5 h-5 transform transition-transform mobile-nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div class="hidden mobile-nav-content mt-1 ml-4 space-y-1">
                    {item.items?.map(subItem => (
                      <a
                        href={subItem.href}
                        class:list={[
                          'block px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                          isActive(subItem.href, currentPath)
                            ? 'text-earth-700 bg-earth-50'
                            : 'text-soil-600 hover:text-earth-700 hover:bg-soil-50'
                        ]}
                      >
                        {subItem.name}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </nav>
      </div>

      <!-- Mobile Menu Footer -->
      <div class="p-4 border-t border-soil-200">
        <Button href="/company/schedule" variant="accent" size="lg" class="w-full justify-center">
          Talk to an Expert
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile menu functionality
  function setupMobileMenu() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const toggleButtons = document.querySelectorAll('.mobile-nav-toggle');

    // Open menu
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    // Close menu
    mobileMenuClose?.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      document.body.style.overflow = '';
    });

    // Close on overlay click
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = '';
      }
    });

    // Accordion functionality
    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const content = button.nextElementSibling;
        const arrow = button.querySelector('.mobile-nav-arrow');

        content?.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
      });
    });
  }

  // Initialize on page load
  setupMobileMenu();

  // Re-initialize after page transitions (for Astro View Transitions)
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
