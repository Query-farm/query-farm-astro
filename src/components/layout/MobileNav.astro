---
import Button from '../ui/Button.astro';
import StrataSun from '../ui/StrataSun.astro';
import { platformComponents } from '../../data/products';

const currentPath = Astro.url.pathname;

// Products list is generated from the same src/data/products.ts the desktop
// header dropdown and /products page use — one list, three places it shows up.
const navigation = [
  { name: 'Home', href: '/' },
  {
    name: 'Products',
    items: platformComponents.map(p => ({ name: p.title, href: p.href, icon: p.img, emoji: p.emoji }))
  },
  { name: 'Consulting', href: '/consulting' },
  { name: 'Blog', href: '/blog' },
  {
    name: 'Company',
    items: [
      { name: 'About', href: '/company/about' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'Schedule Meeting', href: '/company/schedule' }
    ]
  }
];

function isActive(href: string, currentPath: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="hidden xl:hidden fixed inset-0 z-[60] bg-soil-900/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" tabindex="-1">
  <div class="fixed right-0 top-0 bottom-0 w-full max-w-sm bg-soil-50 shadow-2xl">
    <div class="flex flex-col h-full">
      <!-- Mobile Menu Header -->
      <div class="flex items-center justify-between border-b border-soil-300 p-4">
        <a href="/" class="flex items-center gap-[0.32em] text-soil-900 no-underline">
          <StrataSun size={28} />
          <span id="mobile-menu-title" class="qf-wordmark text-[20px]">Query<span class="text-sun-700">.</span>Farm</span>
        </a>
        <button
          id="mobile-menu-close"
          class="rounded-lg p-2 text-soil-700 transition-colors hover:bg-soil-100 hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Content -->
      <div class="flex-1 overflow-y-auto p-4">
        <nav class="space-y-2" aria-label="Mobile">
          {navigation.map((item, index) => (
            <div>
              {item.href ? (
                <a
                  href={item.href}
                  aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-4 py-3 font-medium transition-colors duration-200',
                    isActive(item.href, currentPath)
                      ? 'bg-soil-100 text-link'
                      : 'text-soil-700 hover:bg-soil-100 hover:text-link'
                  ]}
                >
                  {item.name}
                </a>
              ) : (
                <div>
                  <button
                    class="mobile-nav-toggle flex w-full items-center justify-between rounded-lg px-4 py-3 font-medium text-soil-700 transition-colors duration-200 hover:bg-soil-100 hover:text-link"
                    aria-expanded="false"
                    aria-controls={`mobile-nav-group-${index}`}
                  >
                    <span>{item.name}</span>
                    <svg class="mobile-nav-arrow w-5 h-5 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div id={`mobile-nav-group-${index}`} class="mobile-nav-content mt-1 ml-4 hidden space-y-1">
                    {item.items?.map(subItem => (
                      <a
                        href={subItem.href}
                        aria-current={isActive(subItem.href, currentPath) ? 'page' : undefined}
                        class:list={[
                          'flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200',
                          isActive(subItem.href, currentPath)
                            ? 'bg-soil-100 text-link'
                            : 'text-soil-700 hover:bg-soil-100 hover:text-link'
                        ]}
                      >
                        {'icon' in subItem && subItem.icon ? (
                          <img src={subItem.icon} alt="" aria-hidden="true" width="20" height="20" class="w-5 h-5 object-contain shrink-0" />
                        ) : 'emoji' in subItem && subItem.emoji ? (
                          <span class="text-lg leading-none shrink-0 w-5 text-center" aria-hidden="true">{subItem.emoji}</span>
                        ) : null}
                        <span>{subItem.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </nav>
      </div>

      <!-- Mobile Menu Footer -->
      <div class="border-t border-soil-300 p-4">
        <Button href="/company/schedule" variant="primary" size="lg" class="w-full justify-center">
          Talk with Us
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile menu functionality
  function setupMobileMenu() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const toggleButtons = document.querySelectorAll('.mobile-nav-toggle');

    const closeMenu = () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      mobileMenuButton?.focus();
    };

    // Open menu
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.remove('hidden');
      mobileMenuButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      mobileMenuClose?.focus();
    });

    // Close menu
    mobileMenuClose?.addEventListener('click', () => {
      closeMenu();
    });

    // Close on overlay click
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
        closeMenu();
      } else if (e.key === 'Tab' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
        const focusable = Array.from(mobileMenu.querySelectorAll<HTMLElement>('button, a[href]'));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
      }
    });

    // Accordion functionality
    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const content = button.nextElementSibling;
        const arrow = button.querySelector('.mobile-nav-arrow');

        content?.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
        button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
      });
    });
  }

  // Initialize on page load
  setupMobileMenu();

  // Re-initialize after page transitions (for Astro View Transitions)
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
