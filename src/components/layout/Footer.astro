---
import NewsletterForm from '../forms/NewsletterForm.astro';

const currentYear = new Date().getFullYear();

const footerLinks = {
  products: [
    { name: 'DuckDB Extensions', href: '/products/extensions' },
    { name: 'Vector Gateway Interface', href: '/vgi' },
    { name: 'Haybarn', href: '/haybarn' }
  ],
  company: [
    { name: 'About', href: '/company/about' },
    { name: 'Blog', href: '/blog' },
    { name: 'Contact', href: '/company/contact' },
    { name: 'Newsletter', href: '/company/newsletter' }
  ],
  resources: [
    { name: 'Consulting', href: '/consulting' },
    { name: 'Schedule Meeting', href: '/company/schedule' },
    { name: 'GitHub', href: 'https://github.com/queryfarm', external: true }
  ],
  legal: [
    { name: 'Privacy Policy', href: '/legal/privacy' },
    { name: 'Terms of Service', href: '/legal/terms' }
  ]
};

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/queryfarm', icon: 'github' },
  { name: 'Twitter', href: 'https://twitter.com/queryfarm', icon: 'twitter' },
  { name: 'LinkedIn', href: 'https://linkedin.com/company/queryfarm', icon: 'linkedin' }
];
---

<footer class="bg-soil-900 text-soil-100">
  <!-- Main Footer Content -->
  <div class="section-container py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-2 font-display font-bold text-2xl text-white hover:text-soil-200 transition-colors">
          <img
            src="/Query_Farm_Logo_Dark_Mode.png"
            alt=""
            width="44"
            height="34"
            class="h-8 w-11 translate-x-1 object-contain"
          />
          <span>Query.Farm</span>
        </a>
        <p class="mt-4 text-soil-300 text-sm leading-relaxed">
          Extensions, secure packaging, and cross-language runtime tooling for teams shipping DuckDB-backed products.
        </p>

        <!-- Social Links -->
        <div class="mt-6 flex items-center space-x-4">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-soil-400 hover:text-white transition-colors"
              aria-label={social.name}
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                {social.icon === 'github' && (
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                )}
                {social.icon === 'twitter' && (
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                )}
                {social.icon === 'linkedin' && (
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Products -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Products</h3>
        <ul class="space-y-3">
          {footerLinks.products.map(link => (
            <li>
              <a href={link.href} class="text-soil-300 hover:text-white transition-colors text-sm">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-3">
          {footerLinks.company.map(link => (
            <li>
              <a href={link.href} class="text-soil-300 hover:text-white transition-colors text-sm">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-3">
          {footerLinks.resources.map(link => (
            <li>
              <a
                href={link.href}
                class="text-soil-300 hover:text-white transition-colors text-sm"
                {...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
              >
                {link.name}
                {link.external && (
                  <svg class="inline-block w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter Signup -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Stay Updated</h3>
        <p class="text-soil-300 text-sm mb-4">Get the latest updates on DuckDB extensions and releases.</p>
        <NewsletterForm inline class="flex-col gap-2" />
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="border-t border-soil-800">
    <div class="section-container py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-soil-400 text-sm">
          &copy; {currentYear} Query.Farm. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          {footerLinks.legal.map(link => (
            <a href={link.href} class="text-soil-400 hover:text-white transition-colors text-sm">
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
