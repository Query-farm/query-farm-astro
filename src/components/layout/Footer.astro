---
import NewsletterForm from '../forms/NewsletterForm.astro';
import StrataSun from '../ui/StrataSun.astro';

const pathways = [
  {
    label: 'Extend',
    title: 'Add a SQL capability',
    description: 'Browse installable DuckDB extensions.',
    href: '/products/extensions',
  },
  {
    label: 'Connect',
    title: 'Reach an external system',
    description: 'Turn APIs, services, models, and code into queryable tables.',
    href: '/vgi',
  },
  {
    label: 'Operate',
    title: 'Run DuckDB in production',
    description: 'Use signed builds and a production-focused distribution.',
    href: '/products/haybarn',
  },
];

const columns: {
  title: string;
  href?: string;
  links: { name: string; href: string; external?: boolean }[];
}[] = [
  {
    title: 'Products',
    href: '/products',
    links: [
      { name: 'Cupola', href: '/products/cupola' },
      { name: 'DuckDB Extensions', href: '/products/extensions' },
      { name: 'Haybarn', href: '/products/haybarn' },
      { name: 'Orchard', href: '/products/orchard' },
      { name: 'Rowfence', href: '/products/rowfence' },
      { name: 'VGI', href: '/vgi' },
    ],
  },
  {
    title: 'Company',
    links: [
      { name: 'About', href: '/company/about' },
      { name: 'Vision', href: '/vision' },
      { name: 'Consulting', href: '/consulting' },
      { name: 'Blog', href: '/blog' },
      { name: 'Media Kit', href: '/company/media-kit' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { name: 'VGI documentation', href: '/vgi/docs' },
      { name: 'Haybarn status', href: '/products/haybarn/status' },
      { name: 'Security', href: '/products/haybarn/security' },
      { name: 'Licenses', href: '/licenses/source-available' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { name: 'Schedule a meeting', href: '/company/schedule' },
      { name: 'Contact', href: '/company/contact' },
      { name: 'Newsletter', href: '/company/newsletter' },
      { name: 'GitHub', href: 'https://github.com/Query-farm', external: true },
    ],
  },
];

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/Query-farm', icon: 'github' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/query-farm/', icon: 'linkedin' },
  { name: 'Discord', href: 'https://discord.gg/MqWsK88aAr', icon: 'discord' },
];

const linkClass =
  'text-sm text-soil-700 no-underline transition-colors hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link';

const firstCopyrightYear = 2025;
const currentYear = new Date().getFullYear();
const copyrightYears = currentYear > firstCopyrightYear
  ? `${firstCopyrightYear}–${currentYear}`
  : String(firstCopyrightYear);
---

<footer data-pagefind-ignore class="mt-auto border-t border-soil-300 bg-soil-100">
  <div class="section-container">
    <!-- A closing decision point, not another copy of the site map. -->
    <div class="grid gap-10 py-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-14 lg:py-14">
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-[0.32em] text-soil-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
        >
          <StrataSun size={30} />
          <span class="qf-wordmark text-[21px]">Query<span class="text-sun-700">.</span>Farm</span>
        </a>
        <p class="qf-eyebrow mt-7 text-sun-700">Start with the outcome</p>
        <h2 class="mt-2 max-w-[15ch] text-[29px] leading-tight text-soil-900 md:text-[34px]">
          What do you need your data to do?
        </h2>
        <p class="mt-3 max-w-[42ch] text-[15.5px] leading-relaxed text-soil-700">
          Query.Farm gives DuckDB practical paths into the systems and capabilities your work
          depends on.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="/company/schedule"
            class="inline-block rounded-lg border border-field-700 bg-field-700 px-4 py-2.5 text-sm font-medium text-white no-underline transition hover:-translate-y-px motion-reduce:hover:translate-y-0"
          >
            Talk with us
          </a>
          <a
            href="/products"
            class="text-sm font-medium text-link no-underline underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
          >
            See the whole platform →
          </a>
        </div>
      </div>

      <div class="border-b border-soil-300">
        {pathways.map((pathway) => (
          <a
            href={pathway.href}
            class="group grid grid-cols-[64px_1fr_auto] items-center gap-4 border-t border-soil-300 py-4 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link sm:grid-cols-[76px_1fr_auto] sm:gap-5"
          >
            <span class="qf-eyebrow text-sun-700">{pathway.label}</span>
            <span class="min-w-0">
              <span class="block text-[17px] font-medium text-soil-900 transition-colors group-hover:text-link">
                {pathway.title}
              </span>
              <span class="mt-0.5 block text-sm leading-relaxed text-soil-600">
                {pathway.description}
              </span>
            </span>
            <span
              class="flex h-8 w-8 items-center justify-center rounded-full border border-soil-300 text-link transition group-hover:translate-x-0.5 group-hover:border-sun-400 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="grid gap-10 border-t border-soil-300 py-10 lg:grid-cols-[1.05fr_2fr] lg:gap-12">
      <!-- Dispatch gets a real home instead of sharing the brand column. -->
      <div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-5 sm:p-6">
        <h2 class="qf-eyebrow text-sun-700">Dispatch</h2>
        <p class="mt-2 text-sm leading-relaxed text-soil-700">
          New extensions, releases, and technical work from Query.Farm.
        </p>
        <NewsletterForm inline class="mt-4 flex-col gap-2" />

        <div class="mt-5 flex items-center gap-4 border-t border-soil-200 pt-4">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-soil-500 transition-colors hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
              aria-label={social.name}
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                {social.icon === 'github' && (
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                )}
                {social.icon === 'linkedin' && (
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                )}
                {social.icon === 'discord' && (
                  <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-x-7 gap-y-9 sm:grid-cols-4" aria-label="Footer">
        {columns.map(col => (
          <div>
            <h2 class="qf-eyebrow mb-3 text-soil-500">
              {col.href ? (
                <a
                  href={col.href}
                  class="text-soil-500 no-underline transition-colors hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
                >{col.title}</a>
              ) : col.title}
            </h2>
            <ul class="flex list-none flex-col gap-[7px]">
              {col.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    class={linkClass}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.name}
                    {link.external && (
                      <svg class="ml-1 inline-block h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-soil-300 py-5 pb-9 text-[13px] font-medium text-soil-500">
      <span>&copy; {copyrightYears} Query Farm LLC &middot; All rights reserved</span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/legal/privacy" class="no-underline transition-colors hover:text-link">Privacy</a>
        <a href="/legal/terms" class="no-underline transition-colors hover:text-link">Terms</a>
        <a href="mailto:hello@query.farm" class="no-underline transition-colors hover:text-link">hello@query.farm</a>
      </div>
    </div>
  </div>
</footer>
