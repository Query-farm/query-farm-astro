---
import report from '../../data/research/duckdb-2-release-activity.json';

const active = report.packages.filter(p => p.counts['2.0.0'].actual > 0);
const above = active.filter(p => {
  const c = p.counts['2.0.0'];
  return c.baselineEstablished && c.expected >= 1 && c.actual > c.expected;
});
const sparse = active.filter(p => {
  const c = p.counts['2.0.0'];
  return !c.baselineEstablished || c.expected < 1;
});
const groupRows = (packages: typeof active) => report.packageGroups.map(group => ({
  ...group, packages: packages.filter(p => p.group === group.id),
})).filter(group => group.packages.length);
const link = (repo: string) => `https://github.com/duckdb/${repo}/issues?q=${encodeURIComponent(`is:issue created:${report.releases[2].date}..${report.through}`)}`;
---
<div class="repository-directory">
  <div class="repository-column">
    <h3>Above expected activity</h3>
    <div data-repository-list="above-expected">
      {groupRows(above).map(group => <p class="repository-line"><strong>{group.label}:</strong>{' '}{group.packages.map((pkg,i) => <><a href={link(pkg.repo)} data-repository={pkg.repo}>{pkg.label}</a>{i < group.packages.length-1 ? ', ' : '.'}</>)}</p>)}
    </div>
  </div>
  <div class="repository-column">
    <h3>Sparse baseline</h3>
    <div data-repository-list="sparse">
      {groupRows(sparse).map(group => <p class="repository-line"><strong>{group.label}:</strong>{' '}{group.packages.map((pkg,i) => <><a href={link(pkg.repo)} data-repository={pkg.repo}>{pkg.label}</a>{i < group.packages.length-1 ? ', ' : '.'}</>)}</p>)}
    </div>
  </div>
  <p class="directory-note">The first list has more issues than expected and at least one expected issue. The second has less than one expected issue or no established baseline. These are descriptive groupings, not confirmed regressions.</p>
</div>
<style>
  .repository-directory { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; margin-top: 24px; padding: 20px 0 8px; border-block: 1px solid #cfc4ad; }
  .repository-directory h3 { margin: 0 0 12px !important; padding: 0 !important; border: 0 !important; font: 600 14px/1.5 var(--font-sans) !important; }
  .repository-directory .repository-line { font-size: 13px; line-height: 1.7; margin: 8px 0 !important; }
  .repository-line strong { font-weight: 500; }
  .directory-note { grid-column: 1 / -1; font-size: 11px; line-height: 1.65; color: #5d4632; margin: 12px 0 !important; }
  @media (max-width: 600px) { .repository-directory { grid-template-columns: 1fr; gap: 16px; } .directory-note { margin-top: 0 !important; } }
</style>
