---
import { Icon } from 'astro-icon/components';
import report from '../../data/research/duckdb-2-release-activity.json';

const icons: Record<string, string> = {
  core: 'ph:database', clients: 'ph:code', extensions: 'ph:plugs-connected',
  ecosystem: 'ph:graph', docs: 'ph:book-open',
};
const active = report.packages.filter(p => p.counts['2.0.0'].actual > 0);
const above = active.filter(p => {
  const c = p.counts['2.0.0'];
  return c.baselineEstablished && c.expected >= 1 && c.actual > c.expected;
});
const sparse = active.filter(p => {
  const c = p.counts['2.0.0'];
  return !c.baselineEstablished || c.expected < 1;
});
const groupRows = (packages: typeof active) => report.packageGroups.map(group => ({
  ...group, icon: icons[group.id], packages: packages.filter(p => p.group === group.id),
})).filter(group => group.packages.length);
const link = (repo: string) => `https://github.com/duckdb/${repo}/issues?q=${encodeURIComponent(`is:issue created:${report.releases[2].date}..${report.through}`)}`;
---
<div class="repository-directory">
  <div class="repository-list" data-repository-list="above-expected">
    {groupRows(above).map(group => <div class="repository-group">
      <h4><Icon name={group.icon} aria-hidden="true" /><span>{group.label}</span></h4>
      <ul role="list">{group.packages.map(pkg => <li><a href={link(pkg.repo)} data-repository={pkg.repo}>{pkg.label}<span aria-hidden="true">↗</span></a></li>)}</ul>
    </div>)}
  </div>
  <p class="directory-note">“Above expected” means more issues than the weekday-matched baseline predicts, with at least one expected issue in the window. It is a descriptive filter, not a test of significance or a list of confirmed regressions.</p>
  <div class="sparse-repositories">
    <h4>Also active, with sparse baselines</h4>
    <p>These repositories had fewer than one expected issue, or no established baseline. Their issue lists are useful places to investigate; there is not enough baseline activity for a useful “above normal” label.</p>
    <div class="repository-list" data-repository-list="sparse">
      {groupRows(sparse).map(group => <div class="repository-group">
        <h5><Icon name={group.icon} aria-hidden="true" /><span>{group.label}</span></h5>
        <ul role="list">{group.packages.map(pkg => <li><a href={link(pkg.repo)} data-repository={pkg.repo}>{pkg.label}<span aria-hidden="true">↗</span></a></li>)}</ul>
      </div>)}
    </div>
  </div>
</div>
<style>
  .repository-directory { margin-top: 26px; }
  .repository-list { border-top: 1px solid #cfc4ad; }
  .repository-group { display: grid; grid-template-columns: 240px minmax(0,1fr); gap: 26px; padding: 21px 0; border-bottom: 1px solid #ded5c5; }
  .repository-group :is(h4,h5) { display: flex; gap: 11px; align-items: center; font: 500 13px/1.5 var(--font-sans); color: #5d4632; }
  .repository-group :global(svg) { width: 23px; height: 23px; flex-shrink: 0; }
  .repository-group ul { display: flex; flex-wrap: wrap; gap: 10px 26px; list-style: none; margin: 0; padding: 0; }
  .repository-group li { margin: 0; font-size: 15px; line-height: 1.5; }
  .repository-group a { display: inline-flex; gap: 6px; align-items: baseline; text-decoration: underline; text-underline-offset: 3px; }
  .repository-group a span { font-size: 11px; }
  .directory-note { margin-top: 14px; max-width: 840px; font-size: 11px; color: #5d4632; }
  .sparse-repositories { margin-top: 34px; }
  .sparse-repositories > h4 { font-family: var(--font-display); font-size: 24px; }
  .sparse-repositories > p { max-width: 820px; margin: 12px 0 20px; font-size: 14px; color: #5d4632; }
  .sparse-repositories .repository-group li { font-size: 14px; }
  @media (max-width: 650px) {
    .repository-group { grid-template-columns: 1fr; gap: 12px; padding: 19px 0; }
    .repository-group ul { gap: 10px 22px; padding-left: 34px; }
    .repository-group :is(h4,h5) { font-size: 12px; }
  }
</style>
