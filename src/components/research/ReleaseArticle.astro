---
import report from '../../data/research/duckdb-2-release-activity.json';
---
<div id="release-report" data-report-id={report.slug}><slot /></div>
<script id="release-report-data" type="application/json" set:html={JSON.stringify(report).replace(/</g, '\\u003c')} />
<script>import '../../scripts/duckdb-release-report';</script>
<style is:global>
  .qf-prose > #release-report { max-width: 100%; }
  #release-report { min-width: 0; }
  #release-report > p, #release-report section > :is(h2,h3,p,.reading-note,.is-pullquote), #release-report .article-contact { max-width: 672px; margin-inline: auto; }
  #release-report > p + p { margin-top: 20px; }
  #release-report section { scroll-margin-top: 130px; }
  #release-report section > h2 { margin-bottom: 22px; }
  #release-report section > p + p { margin-top: 20px; }
  #release-report .section-intro { margin-block: 20px 28px; }
  #release-report .split-reading { max-width: 672px; margin-inline: auto; }
  #release-report .split-reading p + p { margin-top: 18px; }
  #release-report :is(.report-figure,.distribution) { max-width: 100%; margin: 34px 0; padding: 20px; border: 1px solid #9b9d96; border-radius: 4px; background: #fffdf7; box-sizing: border-box; }
  #release-report :is(.report-figure,.distribution) figcaption { margin: 0 0 18px; padding: 0 0 14px; border-bottom: 1px solid #deded8; color: #211a12; font-size: 15px; line-height: 1.5; }
  #release-report .figure-number { color: #4f5355; font-size: 11px; margin-right: 12px; }
  #release-report .report-fallback { display: block; width: 100%; height: auto; margin: 0; }
  #release-report .report-plot { width: 100%; height: 380px; }
  #release-report .calendar-figure .report-plot { height: 430px; }
  #release-report .figure-note { font-size: 12px; line-height: 1.65; color: #5d4632; margin-top: 12px; }
  #release-report :is(.report-figure,.distribution) > .figure-note { margin: 16px 0 0; padding-top: 14px; border-top: 1px solid #deded8; color: #4f5355; }
  #release-report .reading-note { padding-left: 18px; border-left: 2px solid #a9762e; font-size: 15px; line-height: 1.7; margin-block: 24px; }
  #release-report .figure-subtitle { display: block; font-size: 12px; color: #5d4632; margin-top: 4px; }
  #release-report .distribution-row { display: grid; grid-template-columns: 220px minmax(0,1fr) 36px 38px; gap: 12px; align-items: center; min-height: 38px; font-size: 13px; }
  #release-report .distribution-track { height: 17px; }
  #release-report .distribution-track span { height: 100%; display: block; background: #7a1fa2; }
  #release-report .distribution-row > :is(strong,.distribution-share) { text-align: right; }
  #release-report .distribution-share { font-size: 11px; color: #5d4632; }
  #release-report .migration-list { max-width: 672px; margin-inline: auto; }
  #release-report .migration-list h3 { border: 0; padding: 0; margin: 25px 0 12px; font-size: 21px; }
  #release-report .method-disclosure { max-width: 672px; margin: 36px auto; border-block: 1px solid #cfc4ad; }
  #release-report .method-disclosure[open] { padding-bottom: 20px; }
  #release-report .method-disclosure summary { padding: 16px 4px; cursor: pointer; color: #211a12; }
  #release-report .method-disclosure summary::marker { color: #4f5355; }
  #release-report .method-disclosure summary:focus-visible { outline: 2px solid #0057b8; outline-offset: 4px; }
  #release-report .method-disclosure summary h2 { display: inline; margin: 0; padding: 0; border: 0; font-size: 22px; }
  #release-report .method-columns { max-width: 672px; margin-inline: auto; }
  #release-report .method-columns p { margin-top: 18px; font-size: 14px; line-height: 1.7; }
  #release-report .data-links { display: flex; flex-wrap: wrap; gap: 8px 22px; max-width: 672px; margin: 24px auto 0; font-size: 13px; }
  #release-report .article-contact p + p { margin-top: 18px; }
  #release-report [hidden] { display: none !important; }
  @media (max-width: 650px) {
    #release-report :is(.report-figure,.distribution) { padding: 14px 10px; margin-block: 26px; }
    #release-report .report-plot { height: 350px; }
    #release-report .calendar-figure { overflow-x: auto; }
    #release-report .calendar-figure :is(.report-plot,.report-fallback) { min-width: 850px; }
    #release-report .distribution-row { grid-template-columns: 145px minmax(0,1fr) 28px; gap: 8px; font-size: 11px; }
    #release-report .distribution-share { display: none; }
  }
  @media print { #release-report .report-plot { display: none; } #release-report .report-fallback[hidden] { display: block !important; } }
</style>
