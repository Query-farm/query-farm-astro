---
interface Props {
  metric: string;
  file: string;
  title: string;
  alt: string;
  number: string;
  calendar?: boolean;
}
const { metric, file, title, alt, number, calendar = false } = Astro.props;
const id = `figure-${metric}`;
---
<figure class:list={['report-figure', { 'calendar-figure': calendar }]} data-report-chart={metric}>
  <figcaption id={id}><span class="figure-number">Fig. {number}</span><strong>{title}</strong></figcaption>
  <div class="report-plot" role="img" aria-labelledby={id} aria-describedby={`${id}-note`} hidden></div>
  <img class="report-fallback" src={`/research/duckdb-2-release-activity/${file}.svg`} width={calendar ? 1200 : 1050} height={calendar ? 480 : 450} alt={alt} loading={calendar ? 'eager' : 'lazy'} />
  <p class="figure-note" id={`${id}-note`}><slot /></p>
</figure>
