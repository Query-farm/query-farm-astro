---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import DuckDBExtensionFunctionSignature from './DuckDBExtensionFunctionSignature.astro';
import FunctionSignatureRenderer from './FunctionSignatureRenderer.astro';
import DuckDBExtensionFunctionParameters from './DuckDBExtensionFunctionParameters.astro';
import DuckDBExtensionFunctionReturns from './DuckDBExtensionFunctionReturns.astro';

interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
}

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface RelatedFunction {
  name: string;
  id: string;
  description: string;
}

interface Props {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate';
  category: string;
  signature: string; // DEPRECATED: For backwards compatibility
  returnType?: string; // NEW: Use this instead of signature
  parameters: Parameter[];
  returns?: string;
  returnsTable?: ReturnColumn[];
  description: string;
  examples: string;
  parametersTitle?: string;
  relatedFunctions?: RelatedFunction[];
}

const {
  id,
  name,
  type,
  category,
  signature,
  returnType,
  parameters,
  returns,
  returnsTable,
  description,
  examples,
  parametersTitle,
  relatedFunctions
} = Astro.props;

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

const typeBadges = {
  scalar: { variant: 'info' as const, text: 'Scalar Function' },
  table: { variant: 'success' as const, text: 'Table Function' },
  aggregate: { variant: 'default' as const, text: 'Aggregate Function', class: 'bg-orange-100 text-orange-800 border-orange-300' }
};

const badgeConfig = typeBadges[type];
---

<Card padding="lg" id={id} class="mb-8 scroll-mt-32">
  <!-- Function Header -->
  <div class="flex items-start justify-between mb-4">
    <div>
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        {type === 'aggregate' ? (
          <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-orange-100 text-orange-800 border-orange-300">
            {badgeConfig.text}
          </span>
        ) : (
          <Badge variant={badgeConfig.variant} size="sm">{badgeConfig.text}</Badge>
        )}
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-harvest-700 hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
  </div>

  <!-- Signature -->
  {returnType || returnsTable ? (
    <FunctionSignatureRenderer
      functionName={name}
      parameters={parameters}
      returnType={returnType}
      returnsTable={returnsTable ? { columns: returnsTable.map(col => ({ name: col.name, type: col.type })) } : undefined}
    />
  ) : (
    <DuckDBExtensionFunctionSignature signature={signature} />
  )}

  <!-- Parameters -->
  <DuckDBExtensionFunctionParameters parameters={parameters} title={parametersTitle} />

  <!-- Returns -->
  <DuckDBExtensionFunctionReturns description={returns} table={returnsTable} />

  <!-- Description -->
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Description</h5>
    <p class="text-sm text-soil-700">
      {description}
    </p>
  </div>

  <!-- Examples -->
  <div class="mb-6">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Examples</h5>
    <CodeBlock code={examples} lang="sql" />
  </div>

  <!-- Related Functions -->
  {relatedFunctions && relatedFunctions.length > 0 && (
    <div class="mb-6 p-4 bg-grain-50 border border-grain-200 rounded-lg">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h5 class="text-sm font-semibold text-grain-900">Related Functions</h5>
      </div>
      <ul class="space-y-2">
        {relatedFunctions.map((related) => (
          <li>
            <a
              href={`#${related.id}`}
              class="group flex items-start gap-2 text-sm hover:bg-grain-100 p-2 rounded transition-colors"
            >
              <span class="font-mono text-harvest-700 group-hover:text-harvest-800 font-medium">
                {related.name}()
              </span>
              <span class="text-soil-600 group-hover:text-soil-700">
                — {related.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Back to Functions List -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-harvest-700 hover:text-harvest-800 font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Functions List
    </a>
  </div>
</Card>
