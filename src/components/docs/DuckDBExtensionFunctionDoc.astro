---
import CodeBlock from '../ui/CodeBlock.astro';
import ShareLinkButton from '../ui/ShareLinkButton.astro';
import FunctionSignatureRenderer from './FunctionSignatureRenderer.astro';
import FunctionFormChooser from './FunctionFormChooser.astro';
import DuckDBExtensionFunctionParameters from './DuckDBExtensionFunctionParameters.astro';
import DuckDBExtensionFunctionReturns from './DuckDBExtensionFunctionReturns.astro';
import QueryResult from './QueryResult.astro';
import ExtensionKindIcon from './ExtensionKindIcon.astro';
import { kindTint, kindLabel } from '../../data/extension-kinds';
import { marked, parseInline } from 'marked';
import type { FunctionExample, FunctionForm } from '../../data/extension-types';
import { extensionNameAnchor } from '../../lib/extension-anchors';
import { extensionFunctionCategoryPath } from '../../lib/extension-reference';

// Author-supplied description supports full block-level markdown (multiple
// paragraphs, lists, links, inline code). Example descriptions and parameter
// descriptions are single-line; use parseInline for those.
const md = (s: string) => marked(s ?? '', { async: false }) as string;
const mdInline = (s: string) => parseInline(s ?? '', { async: false }) as string;
// Same code/link prose styling we use in TechnicalOverview / TechnicalDetails:
// neutral pill for plain code, gold-tinted pill for linked code, and gold
// underlined links for plain text-only links. Plus paragraph spacing
// for block descriptions.
const proseClass = '[&_p]:mb-4 [&_p:last-child]:mb-0 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:my-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:my-4 [&_li]:mb-2 [&_li]:leading-relaxed [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_a:has(>code)]:no-underline [&_a>code]:bg-link/12 [&_a>code]:text-link [&_a:hover>code]:bg-link/20 [&_a>code]:transition-colors';
const proseInlineClass = '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_a:has(>code)]:no-underline [&_a>code]:bg-link/12 [&_a>code]:text-link [&_a:hover>code]:bg-link/20 [&_a>code]:transition-colors';

interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  optional?: boolean;
  description: string;
}

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface FunctionData {
  id: string;
  name: string;
  description: string;
  href?: string;
}

interface Props {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy';
  categories: string[];
  returnType?: string;
  parameters: Parameter[];
  returns?: string;
  returnsTable?: ReturnColumn[];
  returnsTableDynamic?: boolean;
  description: string;
  examples: FunctionExample[];
  relatedFunctions?: string[]; // Array of function IDs (raw augment input)
  options?: Parameter[]; // For copy functions
  allFunctions?: FunctionData[]; // Legacy: full list for in-card lookup
  /** Pre-resolved related-function summaries (preferred — avoids per-card scan). */
  resolvedRelated?: FunctionData[];
  tags?: Record<string, string>;
  returnTypeUnion?: string[];
  forms?: FunctionForm[];
  /** Enables canonical category links and a back-link to the extension index. */
  extensionSlug?: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const {
  id,
  name,
  type,
  categories,
  returnType,
  parameters,
  returns,
  returnsTable,
  returnsTableDynamic,
  description,
  examples,
  relatedFunctions,
  options,
  allFunctions = [],
  resolvedRelated,
  tags,
  returnTypeUnion,
  forms,
  extensionSlug,
  headingLevel = 'h4',
} = Astro.props;

const hasMultipleForms = !!forms && forms.length > 1;


// Prefer precomputed list from the parent reference component. Fall back to
// the old in-card scan only when callers still pass `allFunctions` (rare).
const relatedFunctionsData = resolvedRelated ?? (
  relatedFunctions
    ? Array.from(new Map(
        relatedFunctions
          .map(ref => allFunctions.find(fn => fn.name === ref || fn.id === ref))
          .filter((fn): fn is FunctionData => fn !== undefined)
          .map(fn => [fn.name, fn])
      ).values())
    : []
);

// The kind badge is the same chip as the one in the contents index — same
// label, same tint, same glyph — so a reader who scanned the index for a
// "Scalar function" in slate meets the identical chip on the card it links to.
// Both read from src/data/extension-kinds.ts.
const typeLabel = kindLabel(type);
const typeTint = kindTint(type);
const FunctionHeading = headingLevel;
---

<div id={id} class="fnblock cv-auto mb-5 overflow-hidden rounded-xl border border-soil-300 bg-white scroll-mt-28">
  <!-- Function header bar -->
  <div class="flex flex-wrap items-center gap-3 border-b border-soil-300 bg-soil-50 px-4.5 py-3.5">
    <FunctionHeading class="font-mono text-[14px] font-semibold tracking-[-0.01em] text-soil-900">{name}</FunctionHeading>
    <span class:list={['inline-flex items-center gap-1.5 rounded-full border py-0.5 pl-1.5 pr-2.5 text-[12.5px] font-medium', typeTint]}>
      <ExtensionKindIcon kind={type} />
      {typeLabel}
    </span>
    {categories.map((cat) => (
      <a
        href={extensionSlug ? extensionFunctionCategoryPath(extensionSlug, cat) : `#functions-index-${extensionNameAnchor(cat)}`}
        title={`View ${cat} functions`}
        class="inline-flex items-center gap-1.5 rounded-full border border-sun-400 bg-sun-400/12 py-0.5 pl-1.5 pr-2.5 text-[12.5px] font-medium text-sun-700 no-underline transition-colors hover:bg-sun-400/25"
      >
        {/* A tag glyph, so a category chip is legible as a category rather than
            as one more capsule beside the kind badge. */}
        <svg class="h-3.5 w-3.5 flex-none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        {cat}
      </a>
    ))}
    <span class="ml-auto"><ShareLinkButton targetId={id} /></span>
  </div>

  <div class="px-4.5 pt-4.5 pb-4">

  <!-- Signature (not shown for copy functions) -->
  {type !== 'copy' && !hasMultipleForms && (
    <FunctionSignatureRenderer
      functionName={name}
      parameters={parameters}
      returnType={returnType}
      returnsTable={returnsTable ? { columns: returnsTable.map(col => ({ name: col.name, type: col.type })) } : undefined}
    />
  )}

  {hasMultipleForms && (
    <FunctionFormChooser functionName={name} forms={forms!} />
  )}

  <!-- Arguments -->
  {!hasMultipleForms && <DuckDBExtensionFunctionParameters parameters={parameters} />}

  <!-- Options (for copy functions) -->
  {options && options.length > 0 && (
    <div class="mb-5">
      <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Options</h5>
      <DuckDBExtensionFunctionParameters
        parameters={[...options].sort((a, b) => a.name.localeCompare(b.name))}
        title="Available Options"
      />
    </div>
  )}

  <!-- Returns -->
  <DuckDBExtensionFunctionReturns description={returns} table={returnsTable} dynamic={returnsTableDynamic} />

  {returnTypeUnion && returnTypeUnion.length > 1 && (
    <div class="mb-4 -mt-2">
      <details class="group">
        <summary class="text-xs font-medium text-soil-500 cursor-pointer hover:text-soil-700 inline-flex items-center gap-1">
          <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          Return type varies by input — {returnTypeUnion.length} concrete types
        </summary>
        <div class="mt-2 flex flex-wrap gap-1">
          {returnTypeUnion.map((t) => (
            <code class="rounded border border-soil-300 bg-soil-100 px-1.5 py-0.5 font-mono text-[10px] text-soil-700">{t}</code>
          ))}
        </div>
      </details>
    </div>
  )}

  <!-- Description -->
  <div class="mb-5">
    <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Description</h5>
    <div class:list={["text-sm text-soil-700", proseClass]} set:html={md(description)}></div>
  </div>

  <!-- Examples -->
  <div class="mb-5">
    <div class="space-y-4">
      {examples.map((example, index) => (
        <div>
          <div class="mb-2 flex items-center gap-2 text-[12.5px] font-medium text-soil-500">
            <span class="qf-figure">{index + 1}</span>
            <span class="text-[12.5px] text-soil-700">
              {example.description ? example.description : `Example ${index + 1}`}
            </span>
          </div>
          <CodeBlock code={example.code} lang="sql" />
          {example.outputTable ? (
            <QueryResult columns={example.outputTable.columns} rows={example.outputTable.rows} />
          ) : example.output ? (
            <QueryResult text={example.output} />
          ) : null}
        </div>
      ))}
    </div>
  </div>

  <!-- Related Functions -->
  {relatedFunctionsData && relatedFunctionsData.length > 0 && (
    <div class="mb-5 rounded-r-lg border-l-[3px] border-sun-400 bg-soil-50 px-4 py-3">
      <h5 class="mb-2 font-sans text-[14px] font-semibold text-sun-700">Related functions</h5>
      <ul class="space-y-1">
        {relatedFunctionsData.map((related) => (
          <li>
            <a
              href={related.href ?? `#${extensionNameAnchor(related.name)}`}
              class="flex flex-col items-start gap-0.5 rounded px-1 py-0.5 text-sm no-underline transition-colors hover:bg-sun-400/10 sm:flex-row sm:gap-2"
            >
              <span class="font-mono text-[13px] text-link">{related.name}()</span>
              <span class="text-soil-600">— {related.description.split('.')[0]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Tags -->
  {tags && Object.keys(tags).length > 0 && (
    <div class="mb-5">
      <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Tags</h5>
      <div class="flex flex-wrap gap-2">
        {Object.entries(tags).map(([key, value]) => (
          <span class="inline-flex items-center overflow-hidden rounded-md border border-soil-300 text-[12.5px]">
            <span class="bg-soil-100 px-2 py-1 text-soil-600">{key}</span>
            <span class="bg-white px-2 py-1 text-soil-800">{value}</span>
          </span>
        ))}
      </div>
    </div>
  )}
  </div>
</div>
