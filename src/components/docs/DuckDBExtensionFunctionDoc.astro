---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import ShareLinkButton from '../ui/ShareLinkButton.astro';
import FunctionSignatureRenderer from './FunctionSignatureRenderer.astro';
import DuckDBExtensionFunctionParameters from './DuckDBExtensionFunctionParameters.astro';
import DuckDBExtensionFunctionReturns from './DuckDBExtensionFunctionReturns.astro';
import QueryResult from './QueryResult.astro';
import type { FunctionExample } from '../../data/extension-types';

interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
}

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface FunctionData {
  id: string;
  name: string;
  description: string;
}

interface Props {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy';
  categories: string[];
  returnType?: string;
  parameters: Parameter[];
  returns?: string;
  returnsTable?: ReturnColumn[];
  description: string;
  examples: FunctionExample[];
  relatedFunctions?: string[]; // Array of function IDs (raw augment input)
  options?: Parameter[]; // For copy functions
  allFunctions?: FunctionData[]; // Legacy: full list for in-card lookup
  /** Pre-resolved related-function summaries (preferred — avoids per-card scan). */
  resolvedRelated?: FunctionData[];
  tags?: Record<string, string>;
  returnTypeUnion?: string[];
}

const {
  id,
  name,
  type,
  categories,
  returnType,
  parameters,
  returns,
  returnsTable,
  description,
  examples,
  relatedFunctions,
  options,
  allFunctions = [],
  resolvedRelated,
  tags,
  returnTypeUnion
} = Astro.props;

// Helper to create category ID for linking
const getCategoryId = (cat: string) => cat.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

// Prefer precomputed list from the parent reference component. Fall back to
// the old in-card scan only when callers still pass `allFunctions` (rare).
const relatedFunctionsData = resolvedRelated ?? (
  relatedFunctions
    ? Array.from(new Map(
        relatedFunctions
          .map(ref => allFunctions.find(fn => fn.name === ref || fn.id === ref))
          .filter((fn): fn is FunctionData => fn !== undefined)
          .map(fn => [fn.name, fn])
      ).values())
    : []
);

const typeBadges = {
  scalar: { variant: 'info' as const, text: 'Scalar Function' },
  table: { variant: 'success' as const, text: 'Table Function' },
  aggregate: { variant: 'default' as const, text: 'Aggregate Function', class: 'bg-orange-100 text-orange-800 border-orange-300' },
  copy: { variant: 'default' as const, text: 'Copy Function', class: 'bg-blue-100 text-blue-800 border-blue-300' }
};

const badgeConfig = typeBadges[type];
---

<Card padding="lg" id={id} class="mb-8 scroll-mt-32 cv-auto">
  <!-- Function Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        {(type === 'aggregate' || type === 'copy') ? (
          <span class={`inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs ${badgeConfig.class}`}>
            {badgeConfig.text}
          </span>
        ) : (
          <Badge variant={badgeConfig.variant} size="sm">{badgeConfig.text}</Badge>
        )}
        {categories.map((cat) => (
          <a
            href={`#functions-index-${getCategoryId(cat)}`}
            title={`Jump to ${cat} category`}
            class="group inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-harvest-700 bg-harvest-50 border border-harvest-200 rounded-full hover:bg-harvest-100 hover:border-harvest-400 hover:shadow-sm transition-all duration-150"
          >
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            <span>{cat}</span>
            <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>
    <!-- Share Button -->
    <ShareLinkButton targetId={id} />
  </div>

  <!-- Signature (not shown for copy functions) -->
  {type !== 'copy' && (
    <FunctionSignatureRenderer
      functionName={name}
      parameters={parameters}
      returnType={returnType}
      returnsTable={returnsTable ? { columns: returnsTable.map(col => ({ name: col.name, type: col.type })) } : undefined}
    />
  )}

  <!-- Parameters -->
  <DuckDBExtensionFunctionParameters parameters={parameters} />

  <!-- Options (for copy functions) -->
  {options && options.length > 0 && (
    <div class="mb-4">
      <h5 class="text-sm font-semibold text-soil-700 mb-3">Options</h5>
      <DuckDBExtensionFunctionParameters
        parameters={[...options].sort((a, b) => a.name.localeCompare(b.name))}
        title="Available Options"
      />
    </div>
  )}

  <!-- Returns -->
  <DuckDBExtensionFunctionReturns description={returns} table={returnsTable} />

  {returnTypeUnion && returnTypeUnion.length > 1 && (
    <div class="mb-4 -mt-2">
      <details class="group">
        <summary class="text-xs font-medium text-soil-500 cursor-pointer hover:text-soil-700 inline-flex items-center gap-1">
          <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          Return type varies by input — {returnTypeUnion.length} concrete types
        </summary>
        <div class="mt-2 flex flex-wrap gap-1">
          {returnTypeUnion.map((t) => (
            <code class="font-mono text-[10px] px-1.5 py-0.5 bg-blue-50 text-blue-700 rounded border border-blue-200">{t}</code>
          ))}
        </div>
      </details>
    </div>
  )}

  <!-- Description -->
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Description</h5>
    <p class="text-sm text-soil-700">
      {description}
    </p>
  </div>

  <!-- Examples -->
  <div class="mb-6">
    <h5 class="text-sm font-semibold text-soil-700 mb-3">Examples</h5>
    <div class="space-y-6">
      {examples.map((example, index) => (
        <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-600 text-white text-xs font-bold">
              {index + 1}
            </span>
            {example.description && (
              <p class="text-sm text-soil-700 font-medium">{example.description}</p>
            )}
          </div>
          <CodeBlock code={example.code} lang="sql" />
          {example.outputTable ? (
            <QueryResult columns={example.outputTable.columns} rows={example.outputTable.rows} />
          ) : example.output ? (
            <QueryResult text={example.output} />
          ) : null}
        </div>
      ))}
    </div>
  </div>

  <!-- Related Functions -->
  {relatedFunctionsData && relatedFunctionsData.length > 0 && (
    <div class="mb-6 p-4 bg-grain-50 border border-grain-200 rounded-lg">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h5 class="text-sm font-semibold text-grain-900">Related Functions</h5>
      </div>
      <ul class="space-y-2">
        {relatedFunctionsData.map((related) => (
          <li>
            <a
              href={`#${related.name}`}
              class="group flex items-start gap-2 text-sm hover:bg-grain-100 p-2 rounded transition-colors"
            >
              <span class="font-mono text-harvest-700 group-hover:text-harvest-800 font-medium">
                {related.name}()
              </span>
              <span class="text-soil-600 group-hover:text-soil-700">
                — {related.description.split('.')[0]}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Tags -->
  {tags && Object.keys(tags).length > 0 && (
    <div class="mb-6">
      <h5 class="text-sm font-semibold text-soil-700 mb-2">Tags</h5>
      <div class="flex flex-wrap gap-2">
        {Object.entries(tags).map(([key, value]) => (
          <span class="inline-flex items-center text-xs rounded-md border border-soil-200 overflow-hidden">
            <span class="px-2 py-1 bg-soil-100 text-soil-600 font-medium">{key}</span>
            <span class="px-2 py-1 bg-white text-soil-700">{value}</span>
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-harvest-700 hover:text-harvest-800 font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
