---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import ShareLinkButton from '../ui/ShareLinkButton.astro';
import FunctionSignatureRenderer from './FunctionSignatureRenderer.astro';
import DuckDBExtensionFunctionParameters from './DuckDBExtensionFunctionParameters.astro';
import DuckDBExtensionFunctionReturns from './DuckDBExtensionFunctionReturns.astro';
import type { FunctionExample } from '../../data/extension-types';

interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
}

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface FunctionData {
  id: string;
  name: string;
  description: string;
}

interface Props {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy';
  category: string;
  returnType?: string;
  parameters: Parameter[];
  returns?: string;
  returnsTable?: ReturnColumn[];
  description: string;
  examples: FunctionExample[];
  parametersTitle?: string;
  relatedFunctions?: string[]; // Array of function IDs
  options?: Parameter[]; // For copy functions
  allFunctions?: FunctionData[]; // All functions for related function lookup
}

const {
  id,
  name,
  type,
  category,
  returnType,
  parameters,
  returns,
  returnsTable,
  description,
  examples,
  parametersTitle,
  relatedFunctions,
  options,
  allFunctions = []
} = Astro.props;

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

// Look up related functions from the allFunctions array
const relatedFunctionsData = relatedFunctions
  ? relatedFunctions
      .map(relatedId => allFunctions.find(fn => fn.id === relatedId))
      .filter((fn): fn is FunctionData => fn !== undefined)
  : [];

const typeBadges = {
  scalar: { variant: 'info' as const, text: 'Scalar Function' },
  table: { variant: 'success' as const, text: 'Table Function' },
  aggregate: { variant: 'default' as const, text: 'Aggregate Function', class: 'bg-orange-100 text-orange-800 border-orange-300' },
  copy: { variant: 'default' as const, text: 'Copy Function', class: 'bg-blue-100 text-blue-800 border-blue-300' }
};

const badgeConfig = typeBadges[type];
---

<Card padding="lg" id={id} class="mb-8 scroll-mt-32">
  <!-- Function Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        {(type === 'aggregate' || type === 'copy') ? (
          <span class={`inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs ${badgeConfig.class}`}>
            {badgeConfig.text}
          </span>
        ) : (
          <Badge variant={badgeConfig.variant} size="sm">{badgeConfig.text}</Badge>
        )}
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-harvest-700 hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
    <!-- Share Button -->
    <ShareLinkButton targetId={id} />
  </div>

  <!-- Signature (not shown for copy functions) -->
  {type !== 'copy' && (
    <FunctionSignatureRenderer
      functionName={name}
      parameters={parameters}
      returnType={returnType}
      returnsTable={returnsTable ? { columns: returnsTable.map(col => ({ name: col.name, type: col.type })) } : undefined}
    />
  )}

  <!-- Parameters -->
  <DuckDBExtensionFunctionParameters parameters={parameters} title={parametersTitle} />

  <!-- Options (for copy functions) -->
  {options && options.length > 0 && (
    <div class="mb-4">
      <h5 class="text-sm font-semibold text-soil-700 mb-3">Options</h5>
      <DuckDBExtensionFunctionParameters
        parameters={[...options].sort((a, b) => a.name.localeCompare(b.name))}
        title="Available Options"
      />
    </div>
  )}

  <!-- Returns -->
  <DuckDBExtensionFunctionReturns description={returns} table={returnsTable} />

  <!-- Description -->
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Description</h5>
    <p class="text-sm text-soil-700">
      {description}
    </p>
  </div>

  <!-- Examples -->
  <div class="mb-6">
    <h5 class="text-sm font-semibold text-soil-700 mb-3">Examples</h5>
    <div class="space-y-6">
      {examples.map((example, index) => (
        <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-600 text-white text-xs font-bold">
              {index + 1}
            </span>
            {example.description && (
              <p class="text-sm text-soil-700 font-medium">{example.description}</p>
            )}
          </div>
          <CodeBlock code={example.code} lang="sql" />
          {(example.output || example.outputTable) && (
            <div class="mt-3">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-xs font-semibold text-grain-800 uppercase tracking-wide">Output</p>
              </div>
              {example.outputTable ? (
                <div class="bg-white rounded border border-grain-300 overflow-x-auto">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-soil-50 border-b border-soil-200">
                        {example.outputTable.columns.map((col) => {
                          const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                          return (
                            <th class={`px-3 py-2 ${alignClass} font-semibold text-soil-900 font-mono`}>
                              {col.name}
                            </th>
                          );
                        })}
                      </tr>
                    </thead>
                    <tbody>
                      {example.outputTable.rows.map((row, rowIndex) => (
                        <tr class={rowIndex % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                          {row.map((cell, cellIndex) => {
                            const col = example.outputTable!.columns[cellIndex];
                            const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                            return (
                              <td class={`px-3 py-2 ${alignClass} text-soil-800 font-mono border-t border-soil-200`}>
                                {typeof cell === 'boolean' ? (cell ? 'true' : 'false') : cell}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <div class="bg-white rounded px-3 py-2 font-mono text-xs text-soil-800 border border-grain-300 overflow-x-auto">
                  <pre class="whitespace-pre">{example.output}</pre>
                </div>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Related Functions -->
  {relatedFunctionsData && relatedFunctionsData.length > 0 && (
    <div class="mb-6 p-4 bg-grain-50 border border-grain-200 rounded-lg">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h5 class="text-sm font-semibold text-grain-900">Related Functions</h5>
      </div>
      <ul class="space-y-2">
        {relatedFunctionsData.map((related) => (
          <li>
            <a
              href={`#${related.id}`}
              class="group flex items-start gap-2 text-sm hover:bg-grain-100 p-2 rounded transition-colors"
            >
              <span class="font-mono text-harvest-700 group-hover:text-harvest-800 font-medium">
                {related.name}()
              </span>
              <span class="text-soil-600 group-hover:text-soil-700">
                — {related.description.split('.')[0]}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-harvest-700 hover:text-harvest-800 font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
