---
// Single canonical renderer for "result of a SQL query" — used by function
// example outputs, cookbook MDX, and anywhere else a result is shown.
type Cell = string | number | boolean | null | undefined;
type Column = string | { name: string; align?: 'left' | 'right' | 'center' };

interface Props {
  /** Tabular result. */
  columns?: Column[];
  rows?: Cell[][];
  /** Plain text result (fallback when no tabular data). */
  text?: string;
  /** Heading shown above the table. Defaults to "Output"; pass "Input" for source data. */
  label?: string;
  /** Suppress the label row (e.g. when a wrapper renders its own labels). */
  hideLabel?: boolean;
}

const { columns, rows, text, label = 'Output', hideLabel = false } = Astro.props;
const cols = (columns ?? []).map((c) =>
  typeof c === 'string' ? { name: c, align: 'left' as const } : { align: 'left' as const, ...c },
);

const formatCell = (cell: Cell): string => {
  if (cell === null || cell === undefined) return '';
  if (typeof cell === 'boolean') return cell ? 'true' : 'false';
  return String(cell);
};
---

<div class="not-prose my-4">
  {!hideLabel && (
    <p class="mb-2 text-[12.5px] font-medium text-soil-500">{label}</p>
  )}
  {cols.length > 0 && rows ? (
    <div class="overflow-x-auto rounded-lg border border-soil-300 bg-white">
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-soil-300 bg-soil-50">
            {cols.map((col) => {
              const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
              return (
                <th class={`px-3 py-2 ${alignClass} text-[12.5px] font-semibold text-soil-600`}>
                  {col.name}
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, rowIndex) => (
            <tr class="border-t border-soil-200 first:border-t-0">
              {row.map((cell, cellIndex) => {
                const col = cols[cellIndex];
                const alignClass = col?.align === 'right' ? 'text-right' : col?.align === 'center' ? 'text-center' : 'text-left';
                const text = formatCell(cell);
                // Multi-line VARCHAR results (e.g. tp_qr's QR code grid) need
                // newline preservation. Render as a <pre> so newlines and
                // alignment-sensitive Unicode block characters render right.
                const isMultiline = text.includes('\n');
                return (
                  <td class={`px-3 py-2 ${alignClass} font-mono text-soil-800`}>
                    {isMultiline
                      ? <pre class="whitespace-pre leading-tight">{text}</pre>
                      : text}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : text !== undefined ? (
    <div class="overflow-x-auto rounded-lg border border-soil-300 bg-white px-3 py-2 font-mono text-xs text-soil-800">
      <pre class="whitespace-pre">{text}</pre>
    </div>
  ) : null}
</div>
