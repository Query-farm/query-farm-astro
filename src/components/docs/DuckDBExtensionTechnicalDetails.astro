---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "Deep Dive",
  title = "Technical Details",
  description
} = Astro.props;
---

<ExtensionSection id="technical-details" background="soil">
  <SectionHeader
    eyebrow={eyebrow}
    title={title}
    description={description}
    class="mb-12"
  />

  <!-- Base `prose` (16px), not `prose-lg` (18px): the Technical Overview beside
       it is built from structured data with plain utilities and sits at the base
       16px, so prose-lg made MDX sections visibly larger than generated ones on
       the same page. Keep this in step with DuckDBExtensionCookbook. -->
  <div class="prose max-w-none
                  prose-headings:font-display prose-headings:font-semibold prose-headings:text-soil-900
                  prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-soil-200
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
                  prose-p:text-soil-700 prose-p:leading-relaxed prose-p:max-w-[725px] prose-ul:max-w-[725px] prose-ol:max-w-[725px] prose-blockquote:max-w-[725px] prose-li:max-w-[725px]
                  prose-a:text-link prose-a:underline prose-a:underline-offset-2 prose-a:decoration-link/45 hover:prose-a:decoration-link prose-a:font-medium
                  prose-strong:text-soil-900 prose-strong:font-semibold
                  prose-code:text-soil-900 prose-code:bg-soil-100 prose-code:font-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[14px] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
                  [&_a:has(>code)]:no-underline [&_a>code]:bg-sun-400/10 [&_a>code]:text-sun-800 [&_a:hover>code]:bg-link/20 [&_a:hover>code]:text-sun-800 [&_a>code]:transition-colors
                  prose-pre:bg-transparent prose-pre:p-0
                  prose-blockquote:border-l-sun-400 prose-blockquote:text-soil-700 prose-blockquote:bg-soil-100 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
                  prose-ul:text-soil-700 prose-ol:text-soil-700
                  prose-li:marker:text-sun-700
                  prose-table:w-full prose-table:text-sm
                  prose-thead:bg-soil-100 prose-thead:border-b-2 prose-thead:border-soil-300
                  prose-th:px-4 prose-th:py-3 prose-th:text-left prose-th:font-semibold prose-th:text-soil-900
                  prose-td:px-4 prose-td:py-3 prose-td:border-b prose-td:border-soil-200
                  prose-tr:hover:bg-soil-50
                  prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-soil-200">
    <slot />
  </div>
</ExtensionSection>

<style is:global>
  /* Custom code block styling for MDX content - matching farm-theme */
  .prose pre,
  .prose pre.astro-code {
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-rock-800);
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    background: var(--color-rock-900) !important;
    tab-size: 2;
    padding: 1rem;
    padding-right: 3.5rem;
  }

  .prose pre code,
  .prose pre.astro-code code {
    display: block;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #e9e1d3;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    background: transparent !important;
    white-space: pre;
    padding: 0;
  }

  /* Override Shiki's inline background color */
  .prose pre.astro-code,
  .prose pre.astro-code span {
    background-color: transparent !important;
  }

  /* Copy button for code blocks */
  .prose pre .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-cream-2);
    background: var(--color-rock-950);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.15s, background 0.15s;
    z-index: 10;
  }

  .prose pre .copy-btn:hover {
    color: #e9e1d3;
    background: var(--color-rock-950);
  }

  .prose pre .copy-btn.copied {
    color: var(--color-sun-400);
  }

  /* Strip @tailwindcss/typography's default backtick decorations on inline <code> */
  .prose :where(code):not(:where([class~="not-prose"] *))::before,
  .prose :where(code):not(:where([class~="not-prose"] *))::after {
    content: none !important;
  }

  /* Table styling for full width */
  .prose :where(table):not(:where([class~="not-prose"] *)) {
    width: 100%;
    background-color: white;
    border-radius: 0.5rem;
    border: 1px solid #d3cab9;
    border-collapse: collapse;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose :where(thead):not(:where([class~="not-prose"] *)) {
    background-color: #e8e4df;
  }

  .prose :where(th, td):not(:where([class~="not-prose"] *)) {
    white-space: normal;
  }

  .prose :where(tbody tr:last-child td):not(:where([class~="not-prose"] *)) {
    border-bottom: none;
  }

  /* Wrapper for horizontal scroll on small screens */
  .prose :where(table):not(:where([class~="not-prose"] *)) {
    display: table;
  }

  @media (max-width: 640px) {
    .prose :where(table):not(:where([class~="not-prose"] *)) {
      display: block;
      overflow-x: auto;
    }
  }

</style>

<script is:inline>
  // Add copy buttons to all code blocks
  function setupCodeCopyButtons() {
    const codeBlocks = document.querySelectorAll('.prose pre');

    codeBlocks.forEach((pre) => {
      // Skip if already has a copy button
      if (pre.querySelector('.copy-btn')) return;

      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Copy</span>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.classList.add('copied');
            button.innerHTML = `
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Copied!</span>
            `;

            setTimeout(() => {
              button.classList.remove('copied');
              button.innerHTML = `
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        }
      });

      pre.appendChild(button);
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCodeCopyButtons);
  } else {
    setupCodeCopyButtons();
  }
</script>
