---
import DuckDBExtensionFunctionList from './DuckDBExtensionFunctionList.astro';
import Button from '../ui/Button.astro';
import type { FunctionDocData } from '../../data/extension-types';

interface Props {
  category: string;
  categorySlug: string;
  description?: string;
  functions: FunctionDocData[];
  allFunctions: FunctionDocData[];
  extensionSlug: string;
}

const { category, categorySlug, description, functions, allFunctions, extensionSlug } = Astro.props;
const functionLabel = functions.length === 1 ? 'function' : 'functions';
const categoriesHref = `/products/extensions/${extensionSlug}#function-reference`;
const contentsHref = `/products/extensions/${extensionSlug}#functions-index`;
---

<section
  id={`function-category-${categorySlug}`}
  class="scroll-mt-28"
  data-function-category-fragment
  data-category-slug={categorySlug}
  aria-labelledby={`function-category-${categorySlug}-title`}
>
  <header class="mb-8 border-b border-soil-300 pb-5">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-sun-700">Function category</p>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id={`function-category-${categorySlug}-title`} class="font-display text-3xl font-semibold tracking-tight text-soil-900">
        {category}
      </h2>
      <span class="text-sm text-soil-500">{functions.length} {functionLabel}</span>
    </div>
    {description && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-soil-700">{description}</p>}
    <nav aria-label="Function reference navigation" class="mt-5 flex flex-col gap-2 sm:flex-row">
      <Button href={categoriesHref} variant="primary" size="md" class="w-full sm:w-auto">
        <span aria-hidden="true">←</span>
        All function categories
      </Button>
      <Button href={contentsHref} variant="secondary" size="md" class="w-full sm:w-auto">
        Extension contents
      </Button>
    </nav>
  </header>

  <DuckDBExtensionFunctionList
    functions={functions}
    allFunctions={allFunctions}
    extensionSlug={extensionSlug}
  />

  <nav aria-label="Function reference navigation" class="mt-10 flex flex-col gap-2 border-t border-soil-300 pt-6 sm:flex-row">
    <Button href={categoriesHref} variant="primary" size="md" class="w-full sm:w-auto">
      <span aria-hidden="true">←</span>
      All function categories
    </Button>
    <Button href={contentsHref} variant="secondary" size="md" class="w-full sm:w-auto">
      Extension contents
    </Button>
  </nav>
</section>
