---
// Native disclosure (<details>) for tucking away long-but-secondary content —
// e.g. a full source file — so a page reads lighter. Collapsed by default;
// pass `open` to start expanded.
interface Props {
  /** Text shown on the always-visible toggle. */
  summary: string;
  open?: boolean;
}
const { summary, open = false } = Astro.props;
---

<details class="collapsible" open={open}>
  <summary class="collapsible__summary">
    <svg class="collapsible__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span>{summary}</span>
  </summary>
  <div class="collapsible__body"><slot /></div>
</details>

<style>
  .collapsible {
    margin: 1rem 0;
    border: 1px solid var(--sl-color-gray-5, #d8cfbe);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-7, #f7f4ee);
    overflow: hidden;
  }
  .collapsible__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--sl-color-white, #1b1710);
    list-style: none;
    user-select: none;
  }
  .collapsible__summary::-webkit-details-marker {
    display: none;
  }
  .collapsible__chevron {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--sl-color-accent, #6b7d3a);
    transition: transform 0.15s ease;
  }
  .collapsible[open] .collapsible__chevron {
    transform: rotate(90deg);
  }
  .collapsible__body {
    padding: 0 1rem 0.5rem;
  }
  .collapsible__body :global(> :first-child) {
    margin-top: 0.25rem;
  }
</style>
