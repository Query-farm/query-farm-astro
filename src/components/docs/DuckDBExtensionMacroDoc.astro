---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import type { Macro } from '../../data/crypto-functions';

interface Props extends Macro {
  category?: string;
}

const {
  id,
  name,
  category = 'Macros',
  description,
  definition,
  examples
} = Astro.props;

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<Card padding="lg" id={id} class="mb-8 scroll-mt-32">
  <!-- Macro Header -->
  <div class="flex items-start justify-between mb-4">
    <div>
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}()</h4>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-teal-100 text-teal-800 border-teal-300">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          Macro
        </span>
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-harvest-700 hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
  </div>

  <!-- Description -->
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Description</h5>
    <p class="text-sm text-soil-700">
      {description}
    </p>
  </div>

  <!-- Definition -->
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Macro Definition</h5>
    <CodeBlock code={definition} lang="sql" />
  </div>

  <!-- Examples -->
  <div class="mb-6">
    <h5 class="text-sm font-semibold text-soil-700 mb-3">Examples</h5>
    <div class="space-y-6">
      {examples.map((example, index) => (
        <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-harvest-600 text-white text-xs font-bold">
              {index + 1}
            </span>
            {example.description && (
              <p class="text-sm text-soil-700 font-medium">{example.description}</p>
            )}
          </div>
          <CodeBlock code={example.code} lang="sql" />
          {(example.output || example.outputTable) && (
            <div class="mt-3">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-grain-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-xs font-semibold text-grain-800 uppercase tracking-wide">Output</p>
              </div>
              {example.outputTable ? (
                <div class="bg-white rounded border border-grain-300 overflow-x-auto">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-soil-50 border-b border-soil-200">
                        {example.outputTable.columns.map((col) => {
                          const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                          return (
                            <th class={`px-3 py-2 ${alignClass} font-semibold text-soil-900 font-mono`}>
                              {col.name}
                            </th>
                          );
                        })}
                      </tr>
                    </thead>
                    <tbody>
                      {example.outputTable.rows.map((row, rowIndex) => (
                        <tr class={rowIndex % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                          {row.map((cell, cellIndex) => {
                            const col = example.outputTable!.columns[cellIndex];
                            const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                            return (
                              <td class={`px-3 py-2 ${alignClass} text-soil-800 font-mono border-t border-soil-200`}>
                                {typeof cell === 'boolean' ? (cell ? 'true' : 'false') : cell}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <div class="bg-white rounded px-3 py-2 font-mono text-xs text-soil-800 border border-grain-300 overflow-x-auto">
                  <pre class="whitespace-pre">{example.output}</pre>
                </div>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-harvest-700 hover:text-harvest-800 font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
