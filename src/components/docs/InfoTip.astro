---
// Inline info tooltip: a small trigger that reveals slotted content (prose, code
// blocks, …) on hover or keyboard focus. Used to tuck secondary asides next to
// the command they relate to instead of interrupting the flow with a callout.
interface Props {
  /** Trigger text. Omit for a bare info icon. */
  label?: string;
  /** Heading shown at the top of the popover (also the trigger's accessible name). */
  title?: string;
  /** Popover width. Defaults to a comfortable reading column. */
  width?: string;
  /** Open the popover upward (use near the bottom of the page). */
  up?: boolean;
}
const { label, title, width = '26rem', up = false } = Astro.props;
const accessibleName = title ?? label ?? 'More information';
---

<span class="info-tip">
  <button type="button" class="info-tip__trigger" aria-label={accessibleName}>
    <svg class="info-tip__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
      <path stroke-linecap="round" stroke-width="2" d="M12 11v5"></path>
      <circle cx="12" cy="7.75" r="1.1" fill="currentColor" stroke="none"></circle>
    </svg>
    {label && <span class="info-tip__label">{label}</span>}
  </button>
  <span class={`info-tip__pop${up ? ' info-tip__pop--up' : ''}`} role="tooltip" style={`--tip-w:${width}`}>
    {title && <span class="info-tip__title">{title}</span>}
    <span class="info-tip__body"><slot /></span>
  </span>
</span>

<style>
  .info-tip {
    position: relative;
    display: inline-flex;
    vertical-align: baseline;
  }
  .info-tip__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0.1rem 0.1rem;
    border: 0;
    background: none;
    color: var(--sl-color-accent, #6b7d3a);
    font: inherit;
    font-size: 0.85em;
    font-weight: 600;
    line-height: 1.2;
    cursor: help;
    border-bottom: 1px dotted currentColor;
  }
  .info-tip__trigger:hover,
  .info-tip__trigger:focus-visible {
    color: var(--sl-color-accent-high, #4f5e2a);
  }
  .info-tip__icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
  .info-tip__pop {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 40;
    width: min(var(--tip-w, 26rem), 88vw);
    max-height: 70vh;
    overflow-y: auto;
    margin-top: 0.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--sl-color-gray-5, #2b2417);
    border-radius: 0.6rem;
    background: var(--sl-color-bg, #fff);
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.25);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
    text-align: left;
    font-weight: 400;
  }
  .info-tip__pop--up {
    top: auto;
    bottom: 100%;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .info-tip:hover .info-tip__pop,
  .info-tip:focus-within .info-tip__pop {
    opacity: 1;
    pointer-events: auto;
  }
  .info-tip__title {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sl-color-white, #1b1710);
  }
  .info-tip__body {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2, #4a4234);
  }
  /* The slotted content may carry its own block margins (paragraphs, code
     blocks); trim the outer ones so the popover padding stays even. */
  .info-tip__body :global(> :first-child) { margin-top: 0; }
  .info-tip__body :global(> :last-child) { margin-bottom: 0; }
  @media (max-width: 640px) {
    .info-tip__pop {
      left: auto;
      right: 0;
    }
  }
</style>
