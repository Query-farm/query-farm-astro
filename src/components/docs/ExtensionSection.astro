---
/**
 * Section wrapper for extension documentation blocks (family C — docs).
 *
 * Family C has no colour bands: paper, rules, one gold accent. Sections are
 * therefore separated by a hairline rule and vertical rhythm rather than by
 * alternating background slabs, and they carry no width container of their own
 * — the three-column `.docs-grid` on the extension page owns the measure.
 *
 * The `background` prop is retained for call-site compatibility but no longer
 * paints a slab; only `plain` (no top rule) has a visual effect.
 */

interface Props {
  id: string;
  background?: 'white' | 'soil' | 'gradient' | 'plain';
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { id, background = 'white', class: className = '', ...rest } = Astro.props;
const ruled = background !== 'plain';
---

<section
  id={id}
  class:list={[
    'qf-doc-section scroll-mt-28 pt-10 pb-12',
    ruled && 'border-t border-soil-300/70',
    className,
  ]}
  {...rest}
>
  <slot />
</section>
