---
/**
 * Base section wrapper for extension page sections.
 * Provides consistent width, padding, and layout across all extension doc sections.
 */

interface Props {
  id: string;
  background?: 'white' | 'soil' | 'gradient';
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { id, background = 'white', class: className = '', ...rest } = Astro.props;

const bgClasses = {
  white: 'bg-white',
  soil: 'bg-soil-50',
  gradient: 'bg-gradient-to-b from-soil-50 to-white'
};

const bgClass = bgClasses[background];
---

<section id={id} class:list={["py-16 lg:py-24 scroll-mt-16", bgClass, className]} {...rest}>
  <div class="section-container">
    <div class="max-w-5xl 2xl:max-w-6xl mx-auto">
      <slot />
    </div>
  </div>
</section>
