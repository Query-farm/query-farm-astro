---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import ShareLinkButton from '../ui/ShareLinkButton.astro';
import type { Filesystem } from '../../data/extension-types';

interface Props extends Filesystem {
  category?: string;
}

const {
  id,
  name,
  category = 'Filesystems',
  description
} = Astro.props;

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<Card padding="lg" id={id} class="mb-6 scroll-mt-32">
  <!-- Filesystem Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}://</h4>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center rounded-full border border-soil-300 bg-soil-100 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-600">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
          Filesystem
        </span>
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-link hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
    <ShareLinkButton targetId={id} />
  </div>

  <!-- Description -->
  <div class="mb-4">
    <p class="text-sm text-soil-700 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Usage Info -->
  <div class="bg-soil-50 rounded-lg p-4 border border-sun-400/50">
    <div class="flex items-start gap-2">
      <svg class="w-5 h-5 text-sun-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <p class="text-[12.5px] font-semibold text-soil-900 mb-1">Usage</p>
        <p class="text-sm text-soil-800">
          Access this filesystem using the <code class="px-1.5 py-0.5 bg-white rounded border border-soil-300 text-soil-900 font-mono text-xs">{name}://</code> protocol prefix in DuckDB file paths.
        </p>
      </div>
    </div>
  </div>

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200 mt-4">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-link hover:text-link-hover font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
