---
interface Props {
  id: string;
  data: any[];
  layout?: any;
  config?: any;
  height?: string;
}

const {
  id,
  data,
  layout = {},
  config = { responsive: true, displayModeBar: false },
  height = '400px'
} = Astro.props;

// Default layout with farm theme colors
const defaultLayout = {
  font: { family: 'Inter, system-ui, sans-serif', color: '#3d342a' },
  paper_bgcolor: '#f7f6f4',
  plot_bgcolor: '#f7f6f4',
  margin: { t: 40, r: 20, b: 40, l: 60 },
  ...layout
};

const chartData = JSON.stringify(data);
const chartLayout = JSON.stringify(defaultLayout);
const chartConfig = JSON.stringify(config);
---

<div id={id} class="plotly-chart" style={`width: 100%; height: ${height}; border-radius: 0.5rem; overflow: hidden;`}></div>

<script is:inline define:vars={{ id, chartData, chartLayout, chartConfig }}>
  // Load Plotly dynamically
  function loadPlotly(callback) {
    if (window.Plotly) {
      callback();
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.plot.ly/plotly-2.27.0.min.js';
    script.onload = callback;
    document.head.appendChild(script);
  }

  function renderChart() {
    loadPlotly(() => {
      const data = JSON.parse(chartData);
      const layout = JSON.parse(chartLayout);
      const config = JSON.parse(chartConfig);

      Plotly.newPlot(id, data, layout, config);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderChart);
  } else {
    renderChart();
  }
</script>
