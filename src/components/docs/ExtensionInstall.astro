---
import CodeBlock from '../ui/CodeBlock.astro';
import haybarnCatalog from '../../data/haybarn-extensions/catalog.generated.json';

interface Props {
  name: string;
}

const { name } = Astro.props;
const installSql = `SET allow_extension_repositories = 'allowed';

CREATE EXTENSION REPOSITORY IF NOT EXISTS query_farm
    WITH PREFIX 'https://duckdb-extensions.query.farm';

INSTALL ${name} FROM query_farm;
LOAD ${name} FROM query_farm;`;
const legacySql = `INSTALL ${name} FROM community;\nLOAD ${name};`;
// Haybarn builds are signed with their own key, so they have their own host.
const haybarnSql = `SET allow_extension_repositories = 'allowed';

CREATE EXTENSION REPOSITORY IF NOT EXISTS query_farm
    WITH PREFIX 'https://haybarn-extensions.query.farm';

INSTALL ${name} FROM query_farm;
LOAD ${name} FROM query_farm;`;
const onHaybarn = haybarnCatalog.extensions.some(extension => extension.name === name);
---

<div class="space-y-4">
  <p class="text-sm text-soil-700">
    For <strong>DuckDB 2.0 and later</strong>, register the Query Farm repository and install the extension:
  </p>
  <CodeBlock code={installSql} lang="sql" tryable={false} />
  <p class="text-sm text-soil-700">
    In later sessions, run <code>LOAD {name} FROM query_farm;</code>.
    Keep <code>FROM query_farm</code> on the load statement: DuckDB stores extensions from
    <a href="https://duckdb.org/docs/2.0/extensions/extension_repositories#using-a-repository" class="text-sun-700 underline hover:text-sun-600">custom repositories</a>
    separately. Set <code>allow_extension_repositories = 'allowed'</code> again in any session
    that installs an extension; loading an already installed extension does not require it.
  </p>
  {onHaybarn && (
    <details>
      <summary class="cursor-pointer text-sm font-medium text-soil-700">Haybarn</summary>
      <div class="mt-3 space-y-3">
        <p class="text-sm text-soil-700">
          Haybarn extensions are signed with a different key, so they have their own host.
        </p>
        <CodeBlock code={haybarnSql} lang="sql" tryable={false} />
      </div>
    </details>
  )}
  <details>
    <summary class="cursor-pointer text-sm font-medium text-soil-700">DuckDB versions before 2.0</summary>
    <div class="mt-3">
      <CodeBlock code={legacySql} lang="sql" tryable={false} />
    </div>
  </details>
</div>
