---
interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
}

interface Props {
  functionName: string;
  parameters: Parameter[];
  returnType?: string; // For scalar/aggregate functions
  returnsTable?: {
    columns: { name: string; type: string }[];
  }; // For table functions
}

const { functionName, parameters, returnType, returnsTable } = Astro.props;

// Build parameter string
const paramParts = parameters.map(param => {
  if (param.paramType === 'named') {
    // Named parameter: name := TYPE = default
    if (param.default) {
      return `<span class="text-purple-600">${param.name}</span> := <span class="text-blue-600">${param.type}</span> = ${param.default}`;
    } else {
      return `<span class="text-purple-600">${param.name}</span> := <span class="text-blue-600">${param.type}</span>`;
    }
  } else {
    // Positional parameter: name: TYPE
    return `<span class="text-duck-700">${param.name}</span>: <span class="text-blue-600">${param.type}</span>`;
  }
});

const paramString = paramParts.join(', ');

// Build return type string
let returnString = '';
if (returnType) {
  returnString = `<span class="text-blue-600">${returnType}</span>`;
} else if (returnsTable) {
  const columnSpecs = returnsTable.columns.map(col =>
    `${col.name} ${col.type}`
  ).join(', ');
  returnString = `TABLE(${columnSpecs})`;
}
---

<div class="mb-4">
  <h5 class="text-sm font-semibold text-soil-700 mb-2">Signature</h5>
  <div class="bg-soil-50 rounded p-3 font-mono text-sm leading-relaxed overflow-x-auto">
    <span class="text-harvest-700">{functionName}</span>(<span set:html={paramString} />) → <span set:html={returnString} />
  </div>
</div>
