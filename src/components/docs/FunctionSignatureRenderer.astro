---
interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  optional?: boolean;
}

interface Props {
  functionName: string;
  parameters: Parameter[];
  returnType?: string; // For scalar/aggregate functions
  returnsTable?: {
    columns: { name: string; type: string }[];
  }; // For table functions
}

const { functionName, parameters, returnType, returnsTable } = Astro.props;

// Positional parameters keep their declared order (it is semantically
// meaningful); named parameters are sorted alphabetically so they're easy to
// scan. Stable across both single-line and multi-line rendering below.
const sortedParameters = [
  ...parameters.filter((p) => p.paramType !== 'named'),
  ...parameters
    .filter((p) => p.paramType === 'named')
    .sort((a, b) => a.name.localeCompare(b.name)),
];

// Past two arguments a single inline signature gets hard to read, so each
// parameter goes on its own indented line.
const isMultiline = sortedParameters.length > 2;
const indent = '  ';

// Type strings can be polymorphic-family labels like `<numeric>` or `<text>`
// produced by the overload collapser. Those start with `<` and would be eaten
// by the browser as an unknown HTML tag, so escape before injecting via
// set:html.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Colour carries four distinctions in a signature: which token is the function,
// which are argument names, whether an argument is positional or named, and what
// is a type. The hues are the measured `cat-*` inks plus `sun-700` — the only
// gold that may carry text on a light ground (DESIGN_BRIEF §3) — rather than
// stock Tailwind purple/blue, and every one clears 6:1 on the soil-50 ground.
//
// Argument names deliberately reuse the same two hues as the Mode chips in the
// arguments table below: positional slate, named gold. Reading down the card,
// a name keeps its colour.
const POSITIONAL_NAME = 'text-cat-slate-ink';
const NAMED_NAME = 'text-sun-700';
const TYPE = 'text-cat-plum-ink';
const DEFAULT_VALUE = 'text-cat-clay-ink';

// Render one parameter (HTML). Optionality is handled by the assembler below.
const renderHtml = (param: Parameter) => {
  const typeHtml = escapeHtml(param.type);
  if (param.paramType === 'named') {
    return param.default
      ? `<span class="${NAMED_NAME}">${param.name}</span> <span class="text-soil-500">:=</span> <span class="${TYPE}">${typeHtml}</span> <span class="text-soil-500">=</span> <span class="${DEFAULT_VALUE}">${escapeHtml(param.default)}</span>`
      : `<span class="${NAMED_NAME}">${param.name}</span> <span class="text-soil-500">:=</span> <span class="${TYPE}">${typeHtml}</span>`;
  }
  // Positional parameter: name: TYPE
  return `<span class="${POSITIONAL_NAME}">${param.name}</span><span class="text-soil-500">:</span> <span class="${TYPE}">${typeHtml}</span>`;
};
const renderPlain = (param: Parameter) => {
  if (param.paramType === 'named') {
    return param.default ? `${param.name} := ${param.type} = ${param.default}` : `${param.name} := ${param.type}`;
  }
  return `${param.name}: ${param.type}`;
};

// Assemble the parameter list. Optional positional params are bracketed with
// the separating comma inside the bracket — e.g. `expression, json_data[, bindings]`
// — to show the function's shorter arity is also valid.
const assemble = (render: (p: Parameter) => string) =>
  sortedParameters
    .map((param, i) => {
      const core = render(param);
      if (param.optional) return i === 0 ? `[${core}]` : ` [, ${core}]`;
      return i === 0 ? core : `, ${core}`;
    })
    .join('');

const paramString = assemble(renderHtml);
const plainParamString = assemble(renderPlain);
const plainReturnString = returnType || (returnsTable ? 'TABLE' : '');
const plainSignature = `${functionName}(${plainParamString}) → ${plainReturnString}`;

// The return takes its own hue — field green — so what comes back never reads
// as just another argument type.
let returnString = '';
if (returnType) {
  returnString = `<span class="text-cat-field-ink">${escapeHtml(returnType)}</span>`;
} else if (returnsTable) {
  returnString = '<span class="text-cat-field-ink">TABLE</span>';
}

// Assemble the full signature HTML. For multi-line signatures each parameter
// sits on its own indented line, with the comma trailing the previous line.
// The function name is ink at semibold — the subject of the line, distinguished
// by weight so it stays the anchor no matter how many hues follow it.
const nameHtml = `<span class="font-semibold text-soil-900">${functionName}</span>`;
const punct = (s: string) => `<span class="text-soil-500">${s}</span>`;
let signatureHtml: string;
if (isMultiline) {
  const lines = sortedParameters
    .map((param, i) => {
      const core = renderHtml(param);
      const wrapped = param.optional ? `${punct('[')}${core}${punct(']')}` : core;
      const comma = i < sortedParameters.length - 1 ? punct(',') : '';
      return `${indent}${wrapped}${comma}`;
    })
    .join('\n');
  signatureHtml = `${nameHtml}${punct('(')}\n${lines}\n${punct(')')} ${punct('→')} ${returnString}`;
} else {
  signatureHtml = `${nameHtml}${punct('(')}${paramString}${punct(')')} ${punct('→')} ${returnString}`;
}

// Generate unique ID for this signature
const signatureId = `sig-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="mb-4">
  <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Signature</h5>
  <div class="relative group">
    {/* The span must butt directly against the tags. A multiline signature sets
        `whitespace-pre`, which preserves the template's own indentation — put
        the span on its own line and every signature renders with a blank line
        above and below it and the first line pushed in by the source indent. */}
    <div
      class:list={[
        'sig overflow-x-auto rounded-lg border border-soil-200 bg-soil-50 p-3 pr-12 font-mono text-sm leading-[1.95]',
        isMultiline && 'whitespace-pre',
      ]}
    ><span set:html={signatureHtml} /></div>
    <button
      class="signature-copy-btn absolute top-2 right-2 rounded p-1.5 text-soil-500 transition-colors opacity-0 hover:bg-soil-100 hover:text-link focus-visible:opacity-100 group-hover:opacity-100"
      data-signature={plainSignature}
      data-signature-id={signatureId}
      aria-label="Copy signature"
    >
      <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="w-4 h-4 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  // Setup signature copy buttons
  (function() {
    function setupSignatureCopyButtons() {
      document.querySelectorAll('.signature-copy-btn').forEach(button => {
        // Skip if already setup
        if (button.dataset.setupComplete) return;
        button.dataset.setupComplete = 'true';

        button.addEventListener('click', async () => {
          const signature = button.dataset.signature;
          if (!signature) return;

          try {
            await navigator.clipboard.writeText(signature);

            // Show check icon
            const copyIcon = button.querySelector('.copy-icon');
            const checkIcon = button.querySelector('.check-icon');
            if (copyIcon && checkIcon) {
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');

              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
              }, 2000);
            }
          } catch (err) {
            console.error('Failed to copy signature:', err);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSignatureCopyButtons);
    } else {
      setupSignatureCopyButtons();
    }
  })();
</script>
