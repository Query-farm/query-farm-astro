---
interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface Props {
  description?: string;
  table?: ReturnColumn[];
}

const { description, table } = Astro.props;
---

<div class="mb-4">
  <h5 class="text-sm font-semibold text-soil-700 mb-2">Returns</h5>

  {description && (
    <p class="text-sm text-soil-700">{description}</p>
  )}

  {table && (
    <>
      <p class="text-sm text-soil-700 mb-2">A table with the following columns:</p>
      <div class="bg-white rounded-lg border border-soil-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-soil-50 border-b border-soil-200">
              <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/5">Column</th>
              <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/6">Type</th>
              <th class="px-4 py-2 text-left font-semibold text-soil-900">Description</th>
            </tr>
          </thead>
          <tbody>
            {table.map((column, index) => (
              <tr class={index % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                <td class="px-4 py-2 border-t border-soil-200">
                  <code class="font-mono text-xs font-medium text-duck-700 break-words">{column.name}</code>
                </td>
                <td class="px-4 py-2 border-t border-soil-200">
                  <code class="font-mono text-xs text-blue-600 break-words">{column.type}</code>
                </td>
                <td class="px-4 py-2 text-soil-700 border-t border-soil-200">{column.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</div>
