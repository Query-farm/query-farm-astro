---
interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface Props {
  description?: string;
  table?: ReturnColumn[];
}

const { description, table } = Astro.props;
---

<div class="mb-4">
  <h5 class="text-sm font-semibold text-soil-700 mb-2">Returns</h5>

  {description && (
    <p class="text-sm text-soil-700">{description}</p>
  )}

  {table && (
    <>
      <p class="text-sm text-soil-700 mb-2">A table with the following columns:</p>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-soil-50 rounded text-sm">
          <thead>
            <tr class="border-b border-soil-200">
              <th class="px-3 py-2 text-left font-semibold text-soil-700">Column</th>
              <th class="px-3 py-2 text-left font-semibold text-soil-700">Type</th>
              <th class="px-3 py-2 text-left font-semibold text-soil-700">Description</th>
            </tr>
          </thead>
          <tbody class="font-mono">
            {table.map((column, index) => (
              <tr class:list={[index < table.length - 1 && "border-b border-soil-100"]}>
                <td class="px-3 py-2 text-duck-700">{column.name}</td>
                <td class="px-3 py-2 text-blue-600">{column.type}</td>
                <td class="px-3 py-2 font-sans text-soil-700">{column.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</div>
