---
import { marked, parseInline } from 'marked';

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface Props {
  description?: string;
  table?: ReturnColumn[];
  /** Output columns are resolved at bind time — render a note, not a table. */
  dynamic?: boolean;
}

const { description, table, dynamic } = Astro.props;

// Nothing to show when there's neither a prose return description nor a return
// column table — the scalar return type already lives in the signature
// (→ TYPE), so an empty "Returns" heading is just noise. Skip the block.
const hasContent = !!description || dynamic || (!!table && table.length > 0);

// `description` may span multiple paragraphs / contain code blocks; column
// descriptions are single-cell, inline-only.
const md = (s: string) => marked(s ?? '', { async: false }) as string;
const mdInline = (s: string) => parseInline(s ?? '', { async: false }) as string;
const proseClass = '[&_p]:mb-2 [&_p:last-child]:mb-0 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_a:has(>code)]:no-underline [&_a>code]:bg-link/12 [&_a>code]:text-link [&_a:hover>code]:bg-link/20 [&_a>code]:transition-colors';
const proseInlineClass = '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_a:has(>code)]:no-underline [&_a>code]:bg-link/12 [&_a>code]:text-link [&_a:hover>code]:bg-link/20 [&_a>code]:transition-colors';
---

{hasContent && (
  <div class="mb-4">
    <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Returns</h5>

    {description && (
      <div class:list={["text-sm text-soil-700", proseClass]} set:html={md(description)}></div>
    )}

    {dynamic && (
      <div class="mt-2 rounded-r-lg border-l-[3px] border-sun-400 bg-white px-4 py-2.5">
        <p class="text-sm text-soil-700">
          <span class="font-medium text-soil-900">Dynamic schema.</span>
          The output columns are determined at bind time and vary per call, so they aren't listed here.
        </p>
      </div>
    )}

    {table && table.length > 0 && (
      <>
        <p class="text-sm text-soil-700 mb-2">A table with the following columns:</p>
        <div>
          <table class="block w-full border-collapse text-sm sm:table">
            <thead class="hidden sm:table-header-group">
              <tr>
                <th class="w-1/5 border-b border-soil-300 py-2 pr-3 text-left text-[12.5px] font-semibold text-soil-500">Column</th>
                <th class="w-1/6 border-b border-soil-300 py-2 pr-3 text-left text-[12.5px] font-semibold text-soil-500">Type</th>
                <th class="border-b border-soil-300 py-2 text-left text-[12.5px] font-semibold text-soil-500">Description</th>
              </tr>
            </thead>
            <tbody class="block space-y-3 sm:table-row-group sm:space-y-0">
              {table.map((column) => (
                <tr class="block rounded-lg border border-soil-200 bg-white p-3 sm:table-row sm:rounded-none sm:border-0 sm:p-0">
                  <td class="grid grid-cols-[72px_minmax(0,1fr)] gap-2 py-1 align-top sm:table-cell sm:border-b sm:border-soil-200 sm:py-2.5 sm:pr-3">
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-soil-500 sm:hidden">Column</span>
                    <code class="break-words font-mono text-[13px] text-field-700">{column.name}</code>
                  </td>
                  <td class="grid grid-cols-[72px_minmax(0,1fr)] gap-2 py-1 align-top sm:table-cell sm:border-b sm:border-soil-200 sm:py-2.5 sm:pr-3">
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-soil-500 sm:hidden">Type</span>
                    <code class="break-words font-mono text-[12.5px] text-sun-700">{column.type}</code>
                  </td>
                  <td class="grid grid-cols-[72px_minmax(0,1fr)] gap-2 py-1 align-top text-soil-700 sm:table-cell sm:border-b sm:border-soil-200 sm:py-2.5">
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-soil-500 sm:hidden">Description</span>
                    <span class:list={[proseInlineClass]} set:html={mdInline(column.description)}></span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </div>
)}
