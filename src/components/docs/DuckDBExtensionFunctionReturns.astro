---
import { marked, parseInline } from 'marked';

interface ReturnColumn {
  name: string;
  type: string;
  description: string;
}

interface Props {
  description?: string;
  table?: ReturnColumn[];
  /** Output columns are resolved at bind time — render a note, not a table. */
  dynamic?: boolean;
}

const { description, table, dynamic } = Astro.props;

// Nothing to show when there's neither a prose return description nor a return
// column table — the scalar return type already lives in the signature
// (→ TYPE), so an empty "Returns" heading is just noise. Skip the block.
const hasContent = !!description || dynamic || (!!table && table.length > 0);

// `description` may span multiple paragraphs / contain code blocks; column
// descriptions are single-cell, inline-only.
const md = (s: string) => marked(s ?? '', { async: false }) as string;
const mdInline = (s: string) => parseInline(s ?? '', { async: false }) as string;
const proseClass = '[&_p]:mb-2 last:[&_p]:mb-0 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[0.9em] [&_a]:text-harvest-700 [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-harvest-300 hover:[&_a]:decoration-harvest-700 [&_a:has(>code)]:no-underline [&_a>code]:bg-harvest-50 [&_a>code]:text-harvest-800 [&_a:hover>code]:bg-harvest-100 [&_a:hover>code]:text-harvest-900 [&_a>code]:transition-colors';
const proseInlineClass = '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[0.9em] [&_a]:text-harvest-700 [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-harvest-300 hover:[&_a]:decoration-harvest-700 [&_a:has(>code)]:no-underline [&_a>code]:bg-harvest-50 [&_a>code]:text-harvest-800 [&_a:hover>code]:bg-harvest-100 [&_a:hover>code]:text-harvest-900 [&_a>code]:transition-colors';
---

{hasContent && (
  <div class="mb-4">
    <h5 class="text-sm font-semibold text-soil-700 mb-2">Returns</h5>

    {description && (
      <div class:list={["text-sm text-soil-700", proseClass]} set:html={md(description)}></div>
    )}

    {dynamic && (
      <div class="mt-2 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2">
        <svg class="w-4 h-4 mt-0.5 shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <p class="text-sm text-amber-900">
          <span class="font-semibold">Dynamic schema.</span>
          The output columns are determined at bind time and vary per call, so they aren't listed here.
        </p>
      </div>
    )}

    {table && table.length > 0 && (
      <>
        <p class="text-sm text-soil-700 mb-2">A table with the following columns:</p>
        <div class="bg-white rounded-lg border border-soil-200 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-soil-50 border-b border-soil-200">
                <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/5">Column</th>
                <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/6">Type</th>
                <th class="px-4 py-2 text-left font-semibold text-soil-900">Description</th>
              </tr>
            </thead>
            <tbody>
              {table.map((column, index) => (
                <tr class={index % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                  <td class="px-4 py-2 border-t border-soil-200">
                    <code class="font-mono text-xs font-medium text-duck-700 break-words">{column.name}</code>
                  </td>
                  <td class="px-4 py-2 border-t border-soil-200">
                    <code class="font-mono text-xs text-blue-600 break-words">{column.type}</code>
                  </td>
                  <td class:list={["px-4 py-2 text-soil-700 border-t border-soil-200", proseInlineClass]} set:html={mdInline(column.description)}></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </div>
)}
