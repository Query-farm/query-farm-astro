---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import type { RegisteredType } from '../../data/extension-types';
import { extensionNameAnchor } from '../../lib/extension-anchors';

interface Props {
  types: RegisteredType[];
}

const { types } = Astro.props;
---

<ExtensionSection id="types">
  <SectionHeader
    eyebrow="Data model"
    title="Registered Types"
    description="Logical types this extension adds to DuckDB. Functions in the reference may accept or return these names directly."
    class="mb-8"
  />
  <ul class="grid gap-3 sm:grid-cols-2">
    {types.map((type) => (
      <li id={extensionNameAnchor(type.id || type.name)} class="scroll-mt-32 rounded-xl border border-soil-300 bg-white px-4 py-3">
        <code class="font-mono text-[13px] font-semibold text-field-700">{type.name}</code>
        <p class="mt-1.5 text-sm leading-relaxed text-soil-700">
          {type.description || `Logical type registered by this extension.`}
        </p>
      </li>
    ))}
  </ul>
</ExtensionSection>
