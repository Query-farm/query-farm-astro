---
import pako from 'pako';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title?: string;
  theme?: 'default' | 'neutral' | 'dark';
  code: string;
}

const { title, theme = 'neutral', code } = Astro.props;

const cleanCode = code.trim();

function encodeForKroki(source: string): string {
  const data = new TextEncoder().encode(source);
  const compressed = pako.deflate(data, { level: 9 });
  const base64 = Buffer.from(compressed).toString('base64');
  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
}

// Content-addressed local cache so we hit Kroki at most once per unique
// diagram. Each renders adds ~30–60s otherwise (network + render queue).
const cacheDir = join(process.cwd(), '.cache', 'd2-diagrams');
const cacheKey = createHash('sha256')
  .update(theme)
  .update('|')
  .update(cleanCode)
  .digest('hex')
  .slice(0, 16);
const cachePath = join(cacheDir, `${cacheKey}.svg`);

let svgContent = '';
let error = '';

if (existsSync(cachePath)) {
  svgContent = readFileSync(cachePath, 'utf8');
} else {
  const krokiUrl = `https://kroki.io/d2/svg/${encodeForKroki(cleanCode)}`;
  // Hard timeout — Kroki sometimes returns 504 after 60s, which blocks builds.
  // Better to fail fast and render a placeholder than hang on every build.
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8_000);
  try {
    const response = await fetch(krokiUrl, { signal: controller.signal });
    if (response.ok) {
      svgContent = await response.text();
      mkdirSync(cacheDir, { recursive: true });
      writeFileSync(cachePath, svgContent);
    } else {
      const errorText = await response.text();
      error = `Failed to render diagram: ${response.status} - ${errorText}`;
    }
  } catch (e: any) {
    error = e?.name === 'AbortError'
      ? 'D2 diagram render timed out (Kroki took >8s). Check the cache or render the SVG manually.'
      : `Failed to fetch diagram: ${e}`;
  } finally {
    clearTimeout(timer);
  }
}
---

<figure class="d2-diagram my-8">
  {title && (
    <figcaption class="text-sm font-medium text-soil-700 mb-3">{title}</figcaption>
  )}
  <div class="d2-diagram-container bg-white rounded-lg border border-soil-200 p-4 overflow-x-auto">
    {error ? (
      <div class="text-red-600 text-sm p-4 bg-red-50 rounded">
        <strong>Diagram Error:</strong> {error}
        <pre class="mt-2 text-xs bg-red-100 p-2 rounded overflow-x-auto">{cleanCode}</pre>
      </div>
    ) : (
      <Fragment set:html={svgContent} />
    )}
  </div>
</figure>

<style>
  .d2-diagram-container :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
