---
import pako from 'pako';

interface Props {
  title?: string;
  theme?: 'default' | 'neutral' | 'dark';
  code: string;
}

const { title, theme = 'neutral', code } = Astro.props;

// Clean up the code
const cleanCode = code.trim();

// Encode for Kroki using deflate + base64url (their preferred method)
function encodeForKroki(source: string): string {
  const data = new TextEncoder().encode(source);
  const compressed = pako.deflate(data, { level: 9 });
  // Convert to base64url
  const base64 = Buffer.from(compressed).toString('base64');
  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
}

const encoded = encodeForKroki(cleanCode);

// Kroki endpoint for D2
const krokiUrl = `https://kroki.io/d2/svg/${encoded}`;

// Fetch the SVG at build time
let svgContent = '';
let error = '';

try {
  const response = await fetch(krokiUrl);
  if (response.ok) {
    svgContent = await response.text();
  } else {
    const errorText = await response.text();
    error = `Failed to render diagram: ${response.status} - ${errorText}`;
  }
} catch (e) {
  error = `Failed to fetch diagram: ${e}`;
}
---

<figure class="d2-diagram my-8">
  {title && (
    <figcaption class="text-sm font-medium text-soil-700 mb-3">{title}</figcaption>
  )}
  <div class="d2-diagram-container bg-white rounded-lg border border-soil-200 p-4 overflow-x-auto">
    {error ? (
      <div class="text-red-600 text-sm p-4 bg-red-50 rounded">
        <strong>Diagram Error:</strong> {error}
        <pre class="mt-2 text-xs bg-red-100 p-2 rounded overflow-x-auto">{cleanCode}</pre>
      </div>
    ) : (
      <Fragment set:html={svgContent} />
    )}
  </div>
</figure>

<style>
  .d2-diagram-container :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
