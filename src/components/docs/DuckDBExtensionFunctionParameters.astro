---
interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
}

interface Props {
  parameters: Parameter[];
  title?: string;
}

const { parameters, title = 'Parameters' } = Astro.props;
---

<div class="mb-4">
  <h5 class="text-sm font-semibold text-soil-700 mb-2">{title}</h5>
  <div class="bg-soil-50 rounded p-3 space-y-2">
    {parameters.map((param) => (
      <div class="text-sm">
        <span class:list={[
          "inline-block w-32 font-mono",
          param.paramType === 'named' ? "text-purple-600" : "text-duck-700"
        ]}>
          {param.name}
        </span>
        <span class="inline-block w-24 text-blue-600 font-mono text-xs">{param.type}</span>
        <span class:list={[
          "inline-block px-2 py-0.5 text-xs rounded mr-2",
          param.paramType === 'named' ? "bg-purple-100 text-purple-700" : "bg-soil-200 text-soil-700"
        ]}>
          {param.paramType === 'named' ? 'Named' : 'Positional'}
        </span>
        {param.default && (
          <span class="inline-block px-2 py-0.5 bg-soil-100 text-soil-600 text-xs rounded mr-2">
            Default: {param.default}
          </span>
        )}
        <span class="text-soil-700">{param.description}</span>
      </div>
    ))}
  </div>
</div>
