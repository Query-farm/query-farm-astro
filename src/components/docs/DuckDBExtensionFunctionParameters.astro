---
import { parseInline } from 'marked';

interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
  varargs?: boolean;
  typeUnion?: string[];
}

// Parameter descriptions are single-cell; render inline markdown only.
const md = (s: string) => parseInline(s ?? '', { async: false }) as string;
const proseInlineClass = '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link [&_a:has(>code)]:no-underline [&_a>code]:bg-link/12 [&_a>code]:text-link [&_a:hover>code]:bg-link/20 [&_a>code]:transition-colors';

interface Props {
  parameters: Parameter[];
  title?: string;
}

const { parameters, title } = Astro.props;

// Auto-generate title based on argument kinds if not provided. Functions are
// called with *arguments* (positional or named); "parameters" stays only as
// the internal field name in the data model.
function getAutoTitle(params: Parameter[]): string {
  if (params.length === 0) return 'Arguments';

  const hasPositional = params.some(p => p.paramType === 'positional');
  const hasNamed = params.some(p => p.paramType === 'named');

  if (hasPositional && hasNamed) return 'Arguments';
  if (hasNamed) return 'Arguments (Named)';
  return 'Arguments (Positional)';
}

const displayTitle = title ?? getAutoTitle(parameters);
---

{parameters.length > 0 && (
<div class="mb-5">
  <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">{displayTitle}</h5>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th class="w-1/5 border-b border-soil-300 py-2 pr-3 text-left text-[12.5px] font-semibold text-soil-500">Argument</th>
          <th class="w-1/6 border-b border-soil-300 py-2 pr-3 text-left text-[12.5px] font-semibold text-soil-500">Type</th>
          <th class="w-20 border-b border-soil-300 py-2 pr-3 text-left text-[12.5px] font-semibold text-soil-500">Mode</th>
          <th class="border-b border-soil-300 py-2 text-left text-[12.5px] font-semibold text-soil-500">Description</th>
        </tr>
      </thead>
      <tbody>
        {parameters.map((param) => (
          <tr>
            <td class="border-b border-soil-200 py-2.5 pr-3 align-top">
              <code class="break-words font-mono text-[13px] text-field-700">{param.name}</code>
            </td>
            <td class="border-b border-soil-200 py-2.5 pr-3 align-top">
              <code class="break-words font-mono text-[12.5px] text-sun-700">{param.type}</code>
              {param.typeUnion && param.typeUnion.length > 1 && (
                <details class="group mt-1">
                  <summary class="cursor-pointer text-[13px] font-medium text-soil-500 hover:text-soil-700">
                    {param.typeUnion.length} concrete types
                  </summary>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {param.typeUnion.map((t) => (
                      <code class="rounded border border-soil-300 bg-soil-100 px-1.5 py-0.5 font-mono text-[10px] text-soil-700">{t}</code>
                    ))}
                  </div>
                </details>
              )}
            </td>
            <td class="border-b border-soil-200 py-2.5 pr-3 align-top">
              {/* Named vs Positional is a real distinction at the call site, so
                  the two chips take different hues rather than gold-vs-grey:
                  named is the gold accent, positional the slate `cat-*` tint —
                  both -ink values clear 6:1 on their own chip (brief §3). */}
              <span class={`inline-flex items-center whitespace-nowrap rounded-full border px-2 py-0.5 text-[12.5px] font-medium ${param.paramType === 'named' ? 'border-sun-400 bg-sun-400/15 text-sun-700' : 'border-cat-slate-ink/40 bg-cat-slate text-cat-slate-ink'}`}>
                {param.paramType === 'named' ? 'Named' : 'Positional'}
              </span>
            </td>
            <td class="border-b border-soil-200 py-2.5 align-top text-soil-700">
              {param.varargs && (
                <span class="mr-2 mb-1 inline-block rounded-full border border-sun-400 bg-sun-400/12 px-2 py-0.5 text-[12.5px] font-medium text-sun-700">
                  Varargs
                </span>
              )}
              {param.default && (
                <span class="mr-2 mb-1 inline-block rounded-full border border-soil-300 bg-soil-100 px-2 py-0.5 font-mono text-[10px] text-soil-600">
                  Default: {param.default}
                </span>
              )}
              <span class:list={[proseInlineClass]} set:html={md(param.description)}></span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
)}
