---
interface Parameter {
  name: string;
  type: string;
  paramType: 'positional' | 'named';
  default?: string;
  description: string;
  varargs?: boolean;
  typeUnion?: string[];
}

interface Props {
  parameters: Parameter[];
  title?: string;
}

const { parameters, title } = Astro.props;

// Auto-generate title based on parameter types if not provided
function getAutoTitle(params: Parameter[]): string {
  if (params.length === 0) return 'Parameters';

  const hasPositional = params.some(p => p.paramType === 'positional');
  const hasNamed = params.some(p => p.paramType === 'named');

  if (hasPositional && hasNamed) return 'Parameters';
  if (hasNamed) return 'Parameters (Named)';
  return 'Parameters (Positional)';
}

const displayTitle = title ?? getAutoTitle(parameters);
---

<div class="mb-4">
  <h5 class="text-sm font-semibold text-soil-700 mb-2">{displayTitle}</h5>
  <div class="bg-white rounded-lg border border-soil-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-soil-50 border-b border-soil-200">
          <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/5">Parameter</th>
          <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/6">Type</th>
          <th class="px-4 py-2 text-left font-semibold text-soil-900 w-20">Mode</th>
          <th class="px-4 py-2 text-left font-semibold text-soil-900">Description</th>
        </tr>
      </thead>
      <tbody>
        {parameters.map((param, index) => (
          <tr class={index % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
            <td class="px-4 py-2 border-t border-soil-200">
              <code class={`font-mono text-xs font-medium break-words ${param.paramType === 'named' ? 'text-purple-600' : 'text-duck-700'}`}>
                {param.name}
              </code>
            </td>
            <td class="px-4 py-2 border-t border-soil-200">
              <code class="font-mono text-xs text-blue-600 break-words">{param.type}</code>
              {param.typeUnion && param.typeUnion.length > 1 && (
                <details class="mt-1 group">
                  <summary class="text-[10px] uppercase tracking-wide text-soil-500 cursor-pointer hover:text-soil-700">
                    {param.typeUnion.length} concrete types
                  </summary>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {param.typeUnion.map((t) => (
                      <code class="font-mono text-[10px] px-1.5 py-0.5 bg-blue-50 text-blue-700 rounded border border-blue-200">{t}</code>
                    ))}
                  </div>
                </details>
              )}
            </td>
            <td class="px-4 py-2 border-t border-soil-200">
              <span class={`inline-flex items-center px-2 py-0.5 text-xs rounded whitespace-nowrap ${param.paramType === 'named' ? 'bg-purple-100 text-purple-700' : 'bg-soil-200 text-soil-700'}`}>
                {param.paramType === 'named' ? 'Named' : 'Positional'}
              </span>
            </td>
            <td class="px-4 py-2 text-soil-700 border-t border-soil-200">
              {param.varargs && (
                <span class="inline-block px-2 py-0.5 bg-amber-100 text-amber-700 text-xs rounded mr-2 mb-1">
                  Varargs
                </span>
              )}
              {param.default && (
                <span class="inline-block px-2 py-0.5 bg-soil-100 text-soil-600 text-xs rounded mr-2 mb-1">
                  Default: {param.default}
                </span>
              )}
              <span>{param.description}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
