---
// Input → Output pair: shows the source data a function receives next to the
// result it produces, so the shape (1→1, args→N, N→M, N→1, …) is visible at a
// glance. Wraps two <QueryResult>s with a connecting arrow.
import QueryResult from './QueryResult.astro';

type Cell = string | number | boolean | null | undefined;
type Column = string | { name: string; align?: 'left' | 'right' | 'center' };

interface Props {
  /** Input (source) table. */
  inColumns?: Column[];
  inRows?: Cell[][];
  inText?: string;
  /** Label for the input side. Defaults to "Input"; use e.g. "Argument" for table generators. */
  inLabel?: string;
  /** Output (result) table. */
  outColumns?: Column[];
  outRows?: Cell[][];
  outText?: string;
  outLabel?: string;
}

const {
  inColumns,
  inRows,
  inText,
  inLabel = 'Input',
  outColumns,
  outRows,
  outText,
  outLabel = 'Output',
} = Astro.props;
---

<div class="query-io not-prose my-4">
  <div class="query-io__cell">
    <QueryResult label={inLabel} columns={inColumns} rows={inRows} text={inText} />
  </div>
  <div class="query-io__arrow" aria-hidden="true">→</div>
  <div class="query-io__cell">
    <QueryResult label={outLabel} columns={outColumns} rows={outRows} text={outText} />
  </div>
</div>

<style>
  .query-io {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }
  /* The child QueryResult already supplies its own vertical margin; drop it so
     the two tables line up tightly inside the grid. */
  .query-io__cell :global(> div) {
    margin-top: 0;
    margin-bottom: 0;
  }
  .query-io__arrow {
    align-self: center;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--sl-color-gray-3, #9a8c7a);
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .query-io {
      grid-template-columns: minmax(0, 1fr);
    }
    .query-io__arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
</style>
