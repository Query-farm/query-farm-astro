---
// Input → Output pair: shows the source data a function receives next to the
// result it produces, so the shape (1→1, args→N, N→M, N→1, …) is visible at a
// glance. Wraps two <QueryResult>s with a connecting arrow.
import QueryResult from './QueryResult.astro';

type Cell = string | number | boolean | null | undefined;
type Column = string | { name: string; align?: 'left' | 'right' | 'center' };

interface Props {
  /** Input (source) table. */
  inColumns?: Column[];
  inRows?: Cell[][];
  inText?: string;
  /** Label for the input side. Defaults to "Input". */
  inLabel?: string;
  /** Output (result) table. */
  outColumns?: Column[];
  outRows?: Cell[][];
  outText?: string;
  outLabel?: string;
}

const {
  inColumns,
  inRows,
  inText,
  inLabel = 'Input',
  outColumns,
  outRows,
  outText,
  outLabel = 'Output',
} = Astro.props;
---

<div class="query-io not-prose my-4">
  <div class="query-io__col">
    <span class="query-io__label">{inLabel}</span>
    <div class="query-io__table">
      <QueryResult hideLabel columns={inColumns} rows={inRows} text={inText} />
    </div>
  </div>
  <div class="query-io__arrow" aria-hidden="true">→</div>
  <div class="query-io__col">
    <span class="query-io__label">{outLabel}</span>
    <div class="query-io__table">
      <QueryResult hideLabel columns={outColumns} rows={outRows} text={outText} />
    </div>
  </div>
</div>

<style>
  .query-io {
    display: grid;
    grid-template-columns: minmax(0, max-content) auto minmax(0, max-content);
    grid-template-areas:
      "in-label . out-label"
      "in-table arrow out-table";
    align-items: center;
    gap: 0.42rem 0.95rem;
    width: max-content;
    max-width: 100%;
  }
  .query-io__col {
    display: contents;
  }
  .query-io__col:first-child .query-io__label {
    grid-area: in-label;
    --query-io-accent: #8a7d6b;
  }
  .query-io__col:first-child .query-io__table {
    grid-area: in-table;
  }
  .query-io__col:last-child .query-io__label {
    grid-area: out-label;
    --query-io-accent: #0d9488;
  }
  .query-io__col:last-child .query-io__table {
    grid-area: out-table;
  }
  .query-io__label {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    align-self: end;
    padding-bottom: 0.24rem;
    border-bottom: 2px solid color-mix(in srgb, var(--query-io-accent) 62%, transparent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    color: #6b6253;
  }
  .query-io__table {
    min-width: 0;
    max-width: 100%;
    align-self: center;
  }
  /* The child QueryResult already supplies its own vertical margin; drop it so
     the two tables line up tightly, tops aligned (so the labels share a line). */
  .query-io__table :global(> div) {
    margin-top: 0;
    margin-bottom: 0;
  }
  .query-io__table :global(> div > div) {
    border-color: #e8e4df;
    box-shadow: 0 10px 24px -22px rgba(61, 52, 42, 0.36);
  }
  /* Drop QueryResult's label icon here — in the compact pair it's just noise. */
  .query-io__table :global(svg) {
    display: none;
  }
  .query-io__arrow {
    grid-area: arrow;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    align-self: center;
    justify-self: center;
    min-width: 2.75rem;
    font-size: 1.15rem;
    line-height: 1;
    color: #9a8c7a;
    font-weight: 700;
  }
  .query-io__arrow::before,
  .query-io__arrow::after {
    content: "";
    width: 0.55rem;
    height: 1px;
    background: #ddd6cc;
  }
  @media (max-width: 640px) {
    .query-io {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .query-io__col {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 100%;
    }
    .query-io__arrow {
      transform: rotate(90deg);
    }
  }
</style>
