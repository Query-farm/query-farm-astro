---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import ExtensionKindIcon from './ExtensionKindIcon.astro';
import { kindTint, kindLabel } from '../../data/extension-kinds';
import { parseInline } from 'marked';

interface ExtensionContent {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy' | 'macro' | 'pragma' | 'secret' | 'filesystem' | 'storage' | 'logtype' | 'logstorage';
  category: string;
  description: string;
  href: string;
}

interface Props {
  contents: ExtensionContent[];
  categoryOrder?: string[];
  categoryDescriptions?: Record<string, string>;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  contents,
  categoryOrder = [],
  categoryDescriptions = {},
  eyebrow = "Reference",
  title = "Extension Contents",
  description = "Quick reference to all available functions and settings organized by category."
} = Astro.props;

// Render inline markdown (bold, italic, `code`, [text](url), and links whose
// text is itself code like [`fn`](#fn)) via the same parser the rest of the
// site uses. The previous hand-rolled regex renderer broke on code-in-link
// because it injected a class containing `]` before the link regex ran.
// Styling of the resulting <code>/<a> is applied by the [&_code]/[&_a] wrapper
// classes at each call site.
function renderInline(s: string): string {
  return parseInline(s ?? '', { async: false }) as string;
}

// Kind label + tint come from the shared lookup, so a scalar function wears
// the same slate here and on its function-reference card. See the rationale for
// the assignment in src/data/extension-kinds.ts.

// Group contents by category
const contentCategories = contents.reduce((acc, item) => {
  if (!acc[item.category]) {
    acc[item.category] = [];
  }
  acc[item.category].push(item);
  return acc;
}, {} as Record<string, ExtensionContent[]>);

// Get all categories in order
const allCategories = Object.keys(contentCategories);
const sortedContentCategories = [
  ...categoryOrder.filter(cat => contentCategories[cat]),
  ...allCategories.filter(cat => !categoryOrder.includes(cat))
];
---

<ExtensionSection id="functions-index" background="soil">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      class="mb-12"
    />
      <!-- Search Box -->
      <div class="mb-4">
        <div class="relative">
          <input
            type="text"
            id="extension-contents-search"
            placeholder="Search by name, type, or description..."
            class="w-full rounded-lg border border-soil-300 bg-white py-2.5 pl-10 pr-10 text-sm text-soil-900 placeholder:text-soil-500 focus:border-link focus:outline-none focus:ring-3 focus:ring-link/20"
          />
          <svg class="absolute left-3 top-3 w-4 h-4 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            id="clear-search-btn"
            class="absolute right-2 top-2 hidden rounded-md p-1.5 transition-colors hover:bg-soil-100"
            title="Clear search"
            aria-label="Clear search"
          >
            <svg class="w-4 h-4 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p id="search-results-count" class="mt-2 text-xs text-soil-600"></p>
      </div>

      <div class="overflow-hidden rounded-xl border border-soil-300 bg-white">
        <div class="overflow-x-auto">
          <table id="extension-contents-table" class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th class="w-[120px] border-b border-soil-300 bg-soil-50 px-2 py-2.5 text-left text-[12.5px] font-semibold text-soil-600 sm:w-[180px] sm:px-4 md:w-auto">Name</th>
                <th class="hidden border-b border-soil-300 bg-soil-50 px-2 py-2.5 text-left text-[12.5px] font-semibold text-soil-600 sm:table-cell sm:px-4">Type</th>
                <th class="border-b border-soil-300 bg-soil-50 px-2 py-2.5 text-left text-[12.5px] font-semibold text-soil-600 sm:px-4">Description</th>
              </tr>
            </thead>
            <tbody>
              {sortedContentCategories.map((categoryName, catIndex) => {
                const categoryId = categoryName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
                const items = contentCategories[categoryName];

                return (
                  <>
                    {/* Category Header Row (spans all columns) */}
                    <tr id={`functions-index-${categoryId}`} class="category-row scroll-mt-32" data-category={categoryName}>
                      <td colspan="3" class="border-y border-soil-300 bg-soil-100 px-2 py-2.5 sm:px-4">
                        {/* 16px, not the table's inherited 14px: the display
                            face needs the size to hold its shape (brief §1 —
                            band count drops to 2 at 16px), and below it the
                            category row read as tiny serif rather than a
                            heading. */}
                        <div class="font-display text-base font-semibold text-soil-900">{categoryName}</div>
                        {categoryDescriptions[categoryName] && (
                          <p
                            class="text-[12.5px] text-soil-700 font-normal mt-1 leading-snug max-w-3xl [&_code]:font-mono [&_code]:text-[11px] [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_a]:text-link [&_a]:underline hover:[&_a]:decoration-link"
                            set:html={renderInline(categoryDescriptions[categoryName])}
                          />
                        )}
                      </td>
                    </tr>

                    {/* Content Rows */}
                    {items.map((item, itemIndex) => (
                      <tr
                        class={`content-row cursor-pointer border-b border-soil-200 last:border-b-0 hover:bg-soil-50 ${itemIndex === items.length - 1 && catIndex !== sortedContentCategories.length - 1 ? 'border-b-soil-300' : ''}`}
                        data-name={item.name.toLowerCase()}
                        data-type={item.type}
                        data-description={item.description.toLowerCase()}
                        data-category={categoryName}
                        onclick={`window.location.hash='${item.id}'`}
                      >
                        <td class="px-2 sm:px-4 py-3 max-w-[120px] sm:max-w-[180px] md:max-w-none">
                          <a href={item.href} class="block truncate font-mono text-[13px] text-link no-underline hover:underline" title={item.name}>
                            {item.name}
                          </a>
                        </td>
                        <td class="px-2 sm:px-4 py-3 hidden sm:table-cell">
                          <span class:list={[
                            'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border py-0.5 pl-1.5 pr-2.5 text-[12.5px] font-medium',
                            kindTint(item.type),
                          ]}>
                            <ExtensionKindIcon kind={item.type} />
                            {kindLabel(item.type)}
                          </span>
                        </td>
                        <td class="px-2 sm:px-4 py-3 text-soil-700">
                          <span class="block truncate sm:whitespace-normal [&_code]:font-mono [&_code]:text-[11px] [&_code]:bg-soil-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_a]:text-link [&_a]:underline hover:[&_a]:decoration-link" title={item.description} set:html={renderInline(item.description)}></span>
                        </td>
                      </tr>
                    ))}
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    <!-- Search Filtering Script -->
    <script is:inline>
      (function() {
        const searchInput = document.getElementById('extension-contents-search');
        const clearBtn = document.getElementById('clear-search-btn');
        const resultsCount = document.getElementById('search-results-count');
        const table = document.getElementById('extension-contents-table');

        if (!searchInput || !table || !clearBtn) return;

        const contentRows = Array.from(table.querySelectorAll('.content-row'));
        const categoryRows = Array.from(table.querySelectorAll('.category-row'));
        const totalItems = contentRows.length;

        function updateClearButton() {
          if (searchInput.value.trim() === '') {
            clearBtn.classList.add('hidden');
          } else {
            clearBtn.classList.remove('hidden');
          }
        }

        function updateResultsCount(visibleCount) {
          if (searchInput.value.trim() === '') {
            resultsCount.textContent = '';
          } else {
            resultsCount.textContent = `Showing ${visibleCount} of ${totalItems} items`;
          }
        }

        function filterTable() {
          const searchTerm = searchInput.value.toLowerCase().trim();
          updateClearButton();

          if (searchTerm === '') {
            // Show all rows
            contentRows.forEach(row => row.style.display = '');
            categoryRows.forEach(row => row.style.display = '');
            updateResultsCount(totalItems);
            return;
          }

          // Track which categories have visible items
          const visibleCategories = new Set();
          let visibleCount = 0;

          // Filter content rows
          contentRows.forEach(row => {
            const name = row.dataset.name || '';
            const type = row.dataset.type || '';
            const description = row.dataset.description || '';
            const category = row.dataset.category || '';

            // Get type text from badge
            const typeText = getTypeText(type).toLowerCase();

            const matches =
              name.includes(searchTerm) ||
              type.includes(searchTerm) ||
              typeText.includes(searchTerm) ||
              description.includes(searchTerm);

            if (matches) {
              row.style.display = '';
              visibleCategories.add(category);
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          // Show/hide category headers based on whether they have visible items
          categoryRows.forEach(row => {
            const category = row.dataset.category || '';
            row.style.display = visibleCategories.has(category) ? '' : 'none';
          });

          updateResultsCount(visibleCount);
        }

        function clearSearch() {
          searchInput.value = '';
          filterTable();
          searchInput.focus();
        }

        function getTypeText(type) {
          const typeMap = {
            'scalar': 'Scalar Function',
            'table': 'Table Function',
            'aggregate': 'Aggregate Function',
            'copy': 'Copy Function',
            'macro': 'Macro',
            'pragma': 'Setting',
            'secret': 'Secret',
            'filesystem': 'Filesystem',
            'storage': 'Catalog',
            'logtype': 'Log Type',
            'logstorage': 'Log Storage'
          };
          return typeMap[type] || type;
        }

        // Add event listeners
        searchInput.addEventListener('input', filterTable);
        clearBtn.addEventListener('click', clearSearch);

        // Initialize
        updateResultsCount(totalItems);
        updateClearButton();
      })();
    </script>
</ExtensionSection>
