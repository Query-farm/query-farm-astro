---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface ExtensionContent {
  id: string;
  name: string;
  type: 'scalar' | 'table' | 'aggregate' | 'copy' | 'macro' | 'pragma' | 'secret' | 'filesystem' | 'storage' | 'logtype' | 'logstorage';
  category: string;
  description: string;
  href: string;
}

interface Props {
  contents: ExtensionContent[];
  categoryOrder?: string[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  contents,
  categoryOrder = [],
  eyebrow = "Reference",
  title = "Extension Contents",
  description = "Quick reference to all available functions and settings organized by category."
} = Astro.props;

// Group contents by category
const contentCategories = contents.reduce((acc, item) => {
  if (!acc[item.category]) {
    acc[item.category] = [];
  }
  acc[item.category].push(item);
  return acc;
}, {} as Record<string, ExtensionContent[]>);

// Get all categories in order
const allCategories = Object.keys(contentCategories);
const sortedContentCategories = [
  ...categoryOrder.filter(cat => contentCategories[cat]),
  ...allCategories.filter(cat => !categoryOrder.includes(cat))
];
---

<section id="functions-index" class="py-16 lg:py-24 bg-soil-50">
  <div class="section-container">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      class="mb-12"
    />

    <div class="max-w-6xl mx-auto">
      <!-- Search Box -->
      <div class="mb-4">
        <div class="relative">
          <input
            type="text"
            id="extension-contents-search"
            placeholder="Search by name, type, or description..."
            class="w-full px-4 py-3 pl-11 pr-10 bg-white border border-soil-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-harvest-500 focus:border-transparent text-sm"
          />
          <svg class="absolute left-3 top-3.5 w-5 h-5 text-soil-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            id="clear-search-btn"
            class="absolute right-2 top-2.5 p-1.5 rounded-md hover:bg-soil-100 transition-colors hidden"
            title="Clear search"
            aria-label="Clear search"
          >
            <svg class="w-4 h-4 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p id="search-results-count" class="mt-2 text-xs text-soil-600"></p>
      </div>

      <Card padding="none" class="overflow-hidden">
        <div class="overflow-x-auto">
          <table id="extension-contents-table" class="w-full text-sm">
            <thead class="bg-soil-100 border-b-2 border-soil-300">
              <tr>
                <th class="px-4 py-3 text-left font-semibold text-soil-900">Name</th>
                <th class="px-4 py-3 text-left font-semibold text-soil-900">Type</th>
                <th class="px-4 py-3 text-left font-semibold text-soil-900">Description</th>
              </tr>
            </thead>
            <tbody>
              {sortedContentCategories.map((categoryName, catIndex) => {
                const categoryId = categoryName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
                const items = contentCategories[categoryName];

                return (
                  <>
                    {/* Category Header Row (spans all columns) */}
                    <tr id={`functions-index-${categoryId}`} class="category-row scroll-mt-32" data-category={categoryName}>
                      <td colspan="3" class="px-4 py-3 bg-earth-200 border-y border-earth-400">
                        <span class="font-bold text-soil-900">{categoryName}</span>
                      </td>
                    </tr>

                    {/* Content Rows */}
                    {items.map((item, itemIndex) => (
                      <tr
                        class={`content-row hover:bg-soil-50 cursor-pointer ${itemIndex === items.length - 1 && catIndex !== sortedContentCategories.length - 1 ? 'border-b border-soil-300' : ''}`}
                        data-name={item.name.toLowerCase()}
                        data-type={item.type}
                        data-description={item.description.toLowerCase()}
                        data-category={categoryName}
                        onclick={`window.location.hash='${item.id}'`}
                      >
                        <td class="px-4 py-3">
                          <a href={item.href} class="font-mono text-harvest-700 hover:text-harvest-800 font-medium">
                            {item.name}
                          </a>
                        </td>
                        <td class="px-4 py-3">
                          {item.type === 'scalar' && <Badge variant="info" size="sm">Scalar Function</Badge>}
                          {item.type === 'table' && <Badge variant="success" size="sm">Table Function</Badge>}
                          {item.type === 'aggregate' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-orange-100 text-orange-800 border-orange-300">
                              Aggregate Function
                            </span>
                          )}
                          {item.type === 'copy' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-blue-100 text-blue-800 border-blue-300">
                              Copy Function
                            </span>
                          )}
                          {item.type === 'macro' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-teal-100 text-teal-800 border-teal-300">
                              Macro
                            </span>
                          )}
                          {item.type === 'pragma' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-purple-100 text-purple-800 border-purple-300">
                              Pragma
                            </span>
                          )}
                          {item.type === 'secret' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-indigo-100 text-indigo-800 border-indigo-300">
                              Secret
                            </span>
                          )}
                          {item.type === 'filesystem' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-cyan-100 text-cyan-800 border-cyan-300">
                              Filesystem
                            </span>
                          )}
                          {item.type === 'storage' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-emerald-100 text-emerald-800 border-emerald-300">
                              Storage Extension
                            </span>
                          )}
                          {item.type === 'logtype' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-amber-100 text-amber-800 border-amber-300">
                              Log Type
                            </span>
                          )}
                          {item.type === 'logstorage' && (
                            <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-rose-100 text-rose-800 border-rose-300">
                              Log Storage
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-soil-700">{item.description}</td>
                      </tr>
                    ))}
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Search Filtering Script -->
    <script is:inline>
      (function() {
        const searchInput = document.getElementById('extension-contents-search');
        const clearBtn = document.getElementById('clear-search-btn');
        const resultsCount = document.getElementById('search-results-count');
        const table = document.getElementById('extension-contents-table');

        if (!searchInput || !table || !clearBtn) return;

        const contentRows = Array.from(table.querySelectorAll('.content-row'));
        const categoryRows = Array.from(table.querySelectorAll('.category-row'));
        const totalItems = contentRows.length;

        function updateClearButton() {
          if (searchInput.value.trim() === '') {
            clearBtn.classList.add('hidden');
          } else {
            clearBtn.classList.remove('hidden');
          }
        }

        function updateResultsCount(visibleCount) {
          if (searchInput.value.trim() === '') {
            resultsCount.textContent = '';
          } else {
            resultsCount.textContent = `Showing ${visibleCount} of ${totalItems} items`;
          }
        }

        function filterTable() {
          const searchTerm = searchInput.value.toLowerCase().trim();
          updateClearButton();

          if (searchTerm === '') {
            // Show all rows
            contentRows.forEach(row => row.style.display = '');
            categoryRows.forEach(row => row.style.display = '');
            updateResultsCount(totalItems);
            return;
          }

          // Track which categories have visible items
          const visibleCategories = new Set();
          let visibleCount = 0;

          // Filter content rows
          contentRows.forEach(row => {
            const name = row.dataset.name || '';
            const type = row.dataset.type || '';
            const description = row.dataset.description || '';
            const category = row.dataset.category || '';

            // Get type text from badge
            const typeText = getTypeText(type).toLowerCase();

            const matches =
              name.includes(searchTerm) ||
              type.includes(searchTerm) ||
              typeText.includes(searchTerm) ||
              description.includes(searchTerm);

            if (matches) {
              row.style.display = '';
              visibleCategories.add(category);
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          // Show/hide category headers based on whether they have visible items
          categoryRows.forEach(row => {
            const category = row.dataset.category || '';
            row.style.display = visibleCategories.has(category) ? '' : 'none';
          });

          updateResultsCount(visibleCount);
        }

        function clearSearch() {
          searchInput.value = '';
          filterTable();
          searchInput.focus();
        }

        function getTypeText(type) {
          const typeMap = {
            'scalar': 'Scalar Function',
            'table': 'Table Function',
            'aggregate': 'Aggregate Function',
            'copy': 'Copy Function',
            'macro': 'Macro',
            'pragma': 'Pragma',
            'secret': 'Secret',
            'filesystem': 'Filesystem',
            'storage': 'Storage Extension',
            'logtype': 'Log Type',
            'logstorage': 'Log Storage'
          };
          return typeMap[type] || type;
        }

        // Add event listeners
        searchInput.addEventListener('input', filterTable);
        clearBtn.addEventListener('click', clearSearch);

        // Initialize
        updateResultsCount(totalItems);
        updateClearButton();
      })();
    </script>
  </div>
</section>
