---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import { parseInline } from 'marked';

// Author-supplied prose may contain inline markdown (`code`, links, *em*).
// Render as inline-only — no <p> wrap — so it slots into existing block tags.
const md = (s: string) => parseInline(s ?? '') as string;
const inlineCodeClass = [
  // Plain inline code: neutral gray pill — monospace carries the "this is code" signal.
  '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-medium [&_code]:text-[0.9em] [&_code]:font-mono',
  // Inline text-only links: brand green + underline.
  '[&_a]:text-harvest-700 [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-harvest-300 [&_a:hover]:decoration-harvest-700',
  // Linked code (an `<a>` wrapping a `<code>`): drop the underline and tint
  // the pill itself so the affordance lives in the pill, not as a stray line
  // beneath it. Matches Stripe / React / Vercel / Tailwind docs convention.
  '[&_a:has(>code)]:no-underline [&_a>code]:bg-harvest-50 [&_a>code]:text-harvest-800 [&_a:hover>code]:bg-harvest-100 [&_a:hover>code]:text-harvest-900 [&_a>code]:transition-colors',
].join(' ');

interface BulletPoint {
  label: string;
  description: string;
}

interface UseCase {
  title: string;
  description: string;
}

interface OverviewSection {
  icon: string;
  title: string;
  description: string;
  bulletPoints?: BulletPoint[];
  useCases?: UseCase[];
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  sections: OverviewSection[];
}

// Color palette for section styling - cycles through these colors by index
const sectionColors = [
  { iconBg: 'bg-harvest-100', iconText: 'text-harvest-700', bullet: 'text-harvest-600' },
  { iconBg: 'bg-grain-100', iconText: 'text-grain-700', bullet: 'text-grain-600' },
  { iconBg: 'bg-duck-100', iconText: 'text-duck-700', bullet: 'text-duck-600' },
  { iconBg: 'bg-soil-200', iconText: 'text-soil-700', bullet: 'text-soil-600' },
];

const getColorForIndex = (index: number) => sectionColors[index % sectionColors.length];

const {
  eyebrow = "Technical Overview",
  title,
  description,
  sections
} = Astro.props;
---

<ExtensionSection id="overview" background="white">
  <div class="mb-12 space-y-4">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wider text-harvest-600">{eyebrow}</p>
    )}
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-soil-900">{title}</h2>
    {description && (
      <p
        class:list={["text-lg md:text-xl text-soil-600 max-w-3xl", inlineCodeClass]}
        set:html={md(description)}
      ></p>
    )}
  </div>

  <div class="space-y-12">
        {sections.map((section, index) => {
          const colors = getColorForIndex(index);
          return (
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class={`flex-shrink-0 w-10 h-10 rounded-lg ${colors.iconBg} ${colors.iconText} flex items-center justify-center text-xl`}>
                {section.icon}
              </span>
              {section.title}
            </h3>
            <p class:list={["text-soil-700 leading-relaxed mb-4", inlineCodeClass]} set:html={md(section.description)}></p>

            {section.bulletPoints && section.bulletPoints.length > 0 && (
              <ul class="space-y-2 text-soil-700">
                {section.bulletPoints.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class={`${colors.bullet} font-bold`}>•</span>
                    <span class:list={[inlineCodeClass]}>
                      <strong set:html={md(bullet.label)}></strong>{': '}<span set:html={md(bullet.description)}></span>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {section.useCases && section.useCases.length > 0 && (
              <div class="grid sm:grid-cols-2 gap-4">
                {section.useCases.map((useCase) => (
                  <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                    <h4 class:list={["font-semibold text-soil-900 mb-2", inlineCodeClass]} set:html={md(useCase.title)}></h4>
                    <p class:list={["text-sm text-soil-700", inlineCodeClass]} set:html={md(useCase.description)}></p>
                  </div>
                ))}
              </div>
            )}
          </div>
        )})}
  </div>
</ExtensionSection>
