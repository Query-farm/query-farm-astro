---
import SectionHeader from '../ui/SectionHeader.astro';

interface BulletPoint {
  label: string;
  description: string;
}

interface UseCase {
  title: string;
  description: string;
}

interface OverviewSection {
  icon: string;
  title: string;
  description: string;
  bulletPoints?: BulletPoint[];
  useCases?: UseCase[];
  iconBgColor?: string; // Tailwind class like 'bg-harvest-100'
  iconTextColor?: string; // Tailwind class like 'text-harvest-700'
  bulletColor?: string; // Tailwind class like 'text-harvest-600'
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  sections: OverviewSection[];
}

const {
  eyebrow = "Technical Overview",
  title,
  description,
  sections
} = Astro.props;
---

<section class="py-16 lg:py-24 bg-white">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
        class="mb-12"
      />

      <div class="space-y-12">
        {sections.map((section) => (
          <div>
            <h3 class="text-2xl font-bold text-soil-900 mb-4 flex items-center gap-3">
              <span class={`flex-shrink-0 w-10 h-10 rounded-lg ${section.iconBgColor || 'bg-soil-200'} ${section.iconTextColor || 'text-soil-700'} flex items-center justify-center text-xl`}>
                {section.icon}
              </span>
              {section.title}
            </h3>
            <p class="text-soil-700 leading-relaxed mb-4">
              {section.description}
            </p>

            {section.bulletPoints && section.bulletPoints.length > 0 && (
              <ul class="space-y-2 text-soil-700">
                {section.bulletPoints.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class={`${section.bulletColor || 'text-soil-600'} font-bold`}>•</span>
                    <span>
                      <strong>{bullet.label}:</strong> {bullet.description}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {section.useCases && section.useCases.length > 0 && (
              <div class="grid sm:grid-cols-2 gap-4">
                {section.useCases.map((useCase) => (
                  <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
                    <h4 class="font-semibold text-soil-900 mb-2">{useCase.title}</h4>
                    <p class="text-sm text-soil-700">{useCase.description}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
