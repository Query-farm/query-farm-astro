---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import { parseInline } from 'marked';

// Author-supplied prose may contain inline markdown (`code`, links, *em*).
// Render as inline-only — no <p> wrap — so it slots into existing block tags.
const md = (s: string) => parseInline(s ?? '') as string;
const inlineCodeClass = [
  // Plain inline code: neutral gray pill — monospace carries the "this is code" signal.
  '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-medium [&_code]:text-[14px] [&_code]:font-mono',
  // Inline text-only links: brand green + underline.
  '[&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 [&_a:hover]:decoration-link',
  // Linked code (an `<a>` wrapping a `<code>`): drop the underline and tint
  // the pill itself so the affordance lives in the pill, not as a stray line
  // beneath it. Matches Stripe / React / Vercel / Tailwind docs convention.
  '[&_a:has(>code)]:no-underline [&_a>code]:bg-sun-400/10 [&_a>code]:text-sun-800 [&_a:hover>code]:bg-link/20 [&_a:hover>code]:text-sun-800 [&_a>code]:transition-colors',
].join(' ');

interface BulletPoint {
  label: string;
  description: string;
}

interface UseCase {
  title: string;
  description: string;
}

interface OverviewSection {
  icon: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
  code?: string;
  codeLanguage?: string;
  codeTitle?: string;
  bulletPoints?: BulletPoint[];
  useCases?: UseCase[];
  callout?: { title?: string; body: string };
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  sections: OverviewSection[];
}

// Color palette for section styling - cycles through these colors by index.
// `bar` is the slim accent rule above each section title; `bullet` colors the
// list markers.
// One accent, not a rotation: family C is paper, rules, and a single gold.
const sectionColors = [{ bar: 'bg-sun-400', bullet: 'text-sun-700' }];

const getColorForIndex = (index: number) => sectionColors[index % sectionColors.length];

const {
  eyebrow = "Technical Overview",
  title,
  description,
  sections
} = Astro.props;
---

<ExtensionSection id="overview" background="white">
  <div class="mb-12 space-y-4">
    {eyebrow && (
      <p class="qf-eyebrow text-sun-700">{eyebrow}</p>
    )}
    <h2 class="text-[clamp(1.55rem,3.4vw,2.5rem)] text-soil-900">{title}</h2>
    {description && (
      <p
        class:list={["max-w-[725px] text-lg text-soil-700", inlineCodeClass]}
        set:html={md(description)}
      ></p>
    )}
  </div>

  <div class="space-y-14">
        {sections.map((section, index) => {
          const colors = getColorForIndex(index);
          return (
          <div>
            <div class={`h-1 w-10 rounded-full ${colors.bar} mb-4`} aria-hidden="true"></div>
            <h3 class="mb-4 font-display text-2xl text-soil-900">
              {section.title}
            </h3>
            <p class:list={["max-w-[725px] text-soil-700 leading-relaxed mb-4", inlineCodeClass]} set:html={md(section.description)}></p>

            {section.code && (
              <div class="mb-5 max-w-2xl">
                <CodeBlock code={section.code} lang={section.codeLanguage ?? 'text'} title={section.codeTitle} />
              </div>
            )}

            {/* The figure sits inside the running-text measure and centres
                there, rather than stretching to the full column: an 884px-wide
                diagram beside 725px-wide prose made the section look like two
                different layouts. `max-w-[560px]` keeps it comfortably inside
                that measure — these are square diagrams, so full-measure width
                also means full-measure height. */}
            {section.image && (
              <figure class="mb-5 max-w-[725px]">
                <img
                  src={section.image}
                  alt={section.imageAlt ?? section.title}
                  loading="lazy"
                  class="mx-auto w-full max-w-[560px] rounded-lg border border-soil-200 bg-white p-4"
                />
                {section.imageCaption && (
                  <figcaption
                    class:list={["mt-2 text-center text-sm text-soil-500", inlineCodeClass]}
                    set:html={md(section.imageCaption)}
                  ></figcaption>
                )}
              </figure>
            )}

            {section.bulletPoints && section.bulletPoints.length > 0 && (
              <ul class="max-w-[725px] space-y-2 text-soil-700">
                {section.bulletPoints.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class={`${colors.bullet} font-bold`}>•</span>
                    <span class:list={[inlineCodeClass]}>
                      <strong set:html={md(bullet.label)}></strong>{': '}<span set:html={md(bullet.description)}></span>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {section.useCases && section.useCases.length > 0 && (
              <div class="grid sm:grid-cols-2 gap-4">
                {section.useCases.map((useCase) => (
                  <div class="rounded-lg border border-soil-300 bg-white p-4">
                    <h4 class:list={["font-semibold text-soil-900 mb-2", inlineCodeClass]} set:html={md(useCase.title)}></h4>
                    <p class:list={["text-sm text-soil-700", inlineCodeClass]} set:html={md(useCase.description)}></p>
                  </div>
                ))}
              </div>
            )}

            {section.callout && (
              <div class="mt-6 rounded-r-lg border-l-[3px] border-sun-400 bg-white px-5 py-4">
                {section.callout.title && (
                  <p class="mb-1.5 flex items-center gap-2 text-[12.5px] font-medium text-sun-700">
                    <span aria-hidden="true">📣</span><span>{section.callout.title}</span>
                  </p>
                )}
                <p class:list={["max-w-[725px] text-soil-700 leading-relaxed", inlineCodeClass]} set:html={md(section.callout.body)}></p>
              </div>
            )}
          </div>
        )})}
  </div>
</ExtensionSection>
