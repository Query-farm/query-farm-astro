---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import type { PricingInfo, PricingTier } from '../../data/extension-types';

interface Props extends PricingInfo {
  extensionName?: string;
}

const {
  eyebrow = "Commercial Extension",
  title = "Pricing",
  description,
  tiers,
  trialDays,
  registrationRequired,
  registrationUrl,
  termsMarkdown,
  extensionName = "this extension"
} = Astro.props;

// Generate license activation SQL code
const extNameLower = extensionName.toLowerCase();
const licenseCode = `-- Option 1: Set via SQL
SET ${extNameLower}_license_key = 'YOUR_LICENSE_KEY';

-- Option 2: Create a persistent secret
CREATE SECRET ${extNameLower}_license (
    TYPE ${extNameLower}_license,
    KEY 'YOUR_LICENSE_KEY'
);`;

const getPeriodLabel = (period: PricingTier['period']) => {
  switch (period) {
    case 'monthly': return '/month';
    case 'yearly': return '/year';
    case 'one-time': return ' one-time';
  }
};
---

<ExtensionSection id="pricing" background="gradient">
  <SectionHeader
    eyebrow={eyebrow}
    title={title}
    description={description}
    class="mb-12"
  />
      <!-- Trial Banner -->
      {trialDays && (
        <div class="mb-8 text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-harvest-100 border border-harvest-300 rounded-full">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-medium text-harvest-800">
              Start with a <strong>{trialDays}-day free trial</strong> — no credit card required
            </span>
          </div>
        </div>
      )}

      <!-- Pricing Tiers -->
      <div class={`grid gap-6 ${tiers.length === 1 ? 'max-w-lg mx-auto' : tiers.length === 2 ? 'md:grid-cols-2 max-w-3xl mx-auto' : tiers.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2 lg:grid-cols-4'}`}>
        {tiers.map((tier) => (
          <div class={`relative rounded-2xl border-2 transition-all ${tier.highlighted ? 'border-harvest-500 shadow-xl shadow-harvest-500/10' : 'border-soil-200 bg-white'}`}>
            {tier.highlighted && (
              <div class="absolute top-3 right-3 z-10">
                <Badge variant="primary" size="sm">Most Popular</Badge>
              </div>
            )}
            <div class={`p-6 ${tier.highlighted ? 'bg-white rounded-2xl' : ''}`}>
              <h3 class="text-lg font-bold text-soil-900 mb-1">{tier.name}</h3>
              {tier.description && (
                <p class="text-sm text-soil-600 mb-4">{tier.description}</p>
              )}
              <div class="mb-6">
                <span class="text-4xl font-bold text-soil-900">{tier.price}</span>
                <span class="text-soil-500">{getPeriodLabel(tier.period)}</span>
              </div>
              {tier.features && tier.features.length > 0 && (
                <ul class="space-y-3 mb-6">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2 text-sm text-soil-700">
                      <svg class="w-5 h-5 text-harvest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              )}
              <Button
                href={registrationUrl || '#'}
                variant={tier.highlighted ? 'primary' : 'secondary'}
                size="md"
                class="w-full justify-center"
              >
                {trialDays ? 'Start Free Trial' : 'Get Started'}
              </Button>
            </div>
          </div>
        ))}
      </div>

      <!-- Registration Notice -->
      {registrationRequired && (
        <div class="mt-8 text-center">
          <div class="inline-flex items-center gap-2 text-sm text-soil-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Registration required. You'll receive a license key to activate {extensionName}.</span>
          </div>
        </div>
      )}

      <!-- DuckDB Labs Revenue Sharing -->
      <div class="mt-12">
        <div class="flex items-center gap-6 p-6 bg-white rounded-xl border border-soil-200">
          <div class="flex-shrink-0">
            <svg width="64" height="64" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="48" fill="#111111"/>
              <circle cx="40" cy="50" r="18" fill="#FFF000"/>
              <ellipse cx="68" cy="50" rx="8" ry="6" fill="#FFF000"/>
            </svg>
          </div>
          <div class="flex-1">
            <h4 class="text-lg font-bold text-soil-900 mb-2">Supporting DuckDB Development</h4>
            <p class="text-sm text-soil-600 leading-relaxed">
              A portion of every purchase is shared with <a href="https://duckdblabs.com" target="_blank" rel="noopener noreferrer" class="text-harvest-700 hover:text-harvest-800 font-medium">DuckDB Labs</a> to support the continued development of DuckDB. By using this extension, you're helping sustain the open-source database that powers it.
            </p>
          </div>
        </div>
      </div>

      <!-- License Key Instructions -->
      <div class="mt-12">
        <Card class="bg-soil-50 border-soil-200">
          <h4 class="text-lg font-bold text-soil-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-harvest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            Activating Your License
          </h4>
          <div class="prose prose-sm max-w-none text-soil-700">
            <p class="mb-3">After registration, you'll receive a license key. Add it to your DuckDB configuration using one of these methods:</p>
            <CodeBlock code={licenseCode} lang="sql" />
          </div>
        </Card>
      </div>

      <!-- Terms & Conditions -->
      {termsMarkdown && (
        <div class="mt-8">
          <details class="group">
            <summary class="flex items-center gap-2 cursor-pointer text-sm font-medium text-soil-600 hover:text-soil-900 transition-colors">
              <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              View Terms & Conditions
            </summary>
            <div class="mt-4 p-6 bg-white rounded-lg border border-soil-200">
              <div class="prose prose-sm max-w-none text-soil-700" set:html={termsMarkdown} />
            </div>
          </details>
        </div>
      )}
</ExtensionSection>
