---
import Card from '../ui/Card.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import ShareLinkButton from '../ui/ShareLinkButton.astro';
import { parseInline } from 'marked';
import type { Pragma } from '../../data/extension-types';
import { extensionNameAnchor, legacyExtensionAnchor } from '../../lib/extension-anchors';

interface Props extends Pragma {
  id?: string;
  category?: string;
}

const {
  id,
  name,
  default: defaultValue,
  description,
  type = 'string',
  valueType,
  validValues,
  example,
  category = 'Configuration'
} = Astro.props;

// Generate ID from name if not provided
const pragmaId = id || extensionNameAnchor(name);
const legacyId = legacyExtensionAnchor(name);

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

// Setting descriptions frequently reference type names and internal identifiers;
// render inline markdown so `code` spans pick up a fixed-width treatment.
const md = (s: string) => parseInline(s ?? '', { async: false }) as string;
const proseInlineClass = '[&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-soil-100 [&_code]:text-soil-900 [&_code]:font-mono [&_code]:text-[13px] [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/45 hover:[&_a]:decoration-link';

// Coarse category drives the badge colour; the label shows the real DuckDB type
// (valueType) when available so the actual type is respected.
const typeStyles: Record<string, string> = {
  string: 'border-soil-300 bg-soil-100 text-soil-600',
  number: 'border-soil-300 bg-soil-100 text-soil-600',
  boolean: 'border-soil-300 bg-soil-100 text-soil-600',
  map: 'border-sun-400 bg-sun-400/12 text-sun-700',
};
const typeClass = typeStyles[type] ?? typeStyles.string;
const typeLabel = valueType ?? (type.charAt(0).toUpperCase() + type.slice(1));

// Parse a DuckDB map literal `{key=value, key=value}` into entries so a
// structured default renders as a readable key/value table, not a blob.
function parseMap(v: unknown): { key: string; value: string }[] | null {
  if (typeof v !== 'string') return null;
  const s = v.trim();
  if (!s.startsWith('{') || !s.endsWith('}')) return null;
  const body = s.slice(1, -1).trim();
  if (!body) return [];
  return body.split(',').map((pair) => {
    const eq = pair.indexOf('=');
    return eq === -1
      ? { key: pair.trim(), value: '' }
      : { key: pair.slice(0, eq).trim(), value: pair.slice(eq + 1).trim() };
  });
}
const mapEntries = type === 'map' ? parseMap(defaultValue) : null;

// Scalar default for display: booleans/numbers verbatim, strings as-is (rendered
// inside a <code>), empty → em dash.
const formattedDefault = typeof defaultValue === 'boolean' || typeof defaultValue === 'number'
  ? String(defaultValue)
  : (typeof defaultValue === 'string' && defaultValue !== '' ? defaultValue : '—');
---

{legacyId !== pragmaId && <span id={legacyId} class="block scroll-mt-32" aria-hidden="true"></span>}
<Card padding="lg" id={pragmaId} class="mb-6 scroll-mt-32">
  <!-- Pragma Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`inline-flex items-center font-mono font-medium rounded-md border px-2 py-1 text-xs ${typeClass}`}>
          {typeLabel}
        </span>
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-link hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
    <ShareLinkButton targetId={pragmaId} />
  </div>

  <!-- Description -->
  <div class="mb-4">
    <p class:list={["text-sm text-soil-700 leading-relaxed", proseInlineClass]} set:html={md(description)}></p>
  </div>

  <!-- Settings Info -->
  <div class="bg-soil-50 rounded-lg p-4 border border-soil-200 mb-4">
    {mapEntries ? (
      <div>
        <span class="text-soil-600 font-medium text-sm">Default value</span>
        <div class="mt-2 overflow-x-auto rounded border border-soil-200 bg-white max-w-md">
          <table class="w-full text-sm">
            <tbody>
              {mapEntries.map((entry, index) => (
                <tr class={index % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                  <td class="px-3 py-1.5 border-t border-soil-200"><code class="font-mono text-xs text-field-700">{entry.key}</code></td>
                  <td class="px-3 py-1.5 border-t border-soil-200 text-right"><code class="font-mono text-xs text-soil-900">{entry.value}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-soil-600 font-medium">Default Value:</span>
          <code class="ml-2 px-2 py-0.5 bg-white rounded border border-soil-300 text-soil-900 font-mono text-xs">
            {formattedDefault}
          </code>
        </div>
        {validValues && validValues.length > 0 && (
          <div>
            <span class="text-soil-600 font-medium">Valid Values:</span>
            <div class="mt-1 flex flex-wrap gap-1">
              {validValues.map((value) => (
                <code class="px-2 py-0.5 bg-white rounded border border-soil-300 text-soil-900 font-mono text-xs">
                  {value}
                </code>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Example -->
  {example && (
    <div class="mb-4">
      <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Example usage</h5>
      <CodeBlock code={example} lang="sql" />
    </div>
  )}

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-link hover:text-link-hover font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
