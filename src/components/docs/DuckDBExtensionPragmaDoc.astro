---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import type { Pragma } from '../../data/crypto-functions';

interface Props extends Pragma {
  id?: string;
  category?: string;
}

const {
  id,
  name,
  default: defaultValue,
  description,
  type = 'string',
  validValues,
  example,
  category = 'Configuration'
} = Astro.props;

// Generate ID from name if not provided
const pragmaId = id || name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

// Type badge colors
const typeBadges = {
  string: { variant: 'info' as const, text: 'String' },
  number: { variant: 'default' as const, text: 'Number', class: 'bg-purple-100 text-purple-800 border-purple-300' },
  boolean: { variant: 'success' as const, text: 'Boolean' }
};

const badgeConfig = typeBadges[type];

// Format default value for display
const formattedDefault = typeof defaultValue === 'string' ? `'${defaultValue}'` : String(defaultValue);
---

<Card padding="lg" id={pragmaId} class="mb-6 scroll-mt-32">
  <!-- Pragma Header -->
  <div class="flex items-start justify-between mb-4">
    <div>
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        {type === 'number' ? (
          <span class="inline-flex items-center font-medium rounded-md border px-2 py-1 text-xs bg-purple-100 text-purple-800 border-purple-300">
            {badgeConfig.text}
          </span>
        ) : (
          <Badge variant={badgeConfig.variant} size="sm">{badgeConfig.text}</Badge>
        )}
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-harvest-700 hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
  </div>

  <!-- Description -->
  <div class="mb-4">
    <p class="text-sm text-soil-700 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Settings Info -->
  <div class="bg-soil-50 rounded-lg p-4 border border-soil-200 mb-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div>
        <span class="text-soil-600 font-medium">Default Value:</span>
        <code class="ml-2 px-2 py-0.5 bg-white rounded border border-soil-300 text-soil-900 font-mono text-xs">
          {formattedDefault}
        </code>
      </div>
      {validValues && validValues.length > 0 && (
        <div>
          <span class="text-soil-600 font-medium">Valid Values:</span>
          <div class="mt-1 flex flex-wrap gap-1">
            {validValues.map((value) => (
              <code class="px-2 py-0.5 bg-white rounded border border-soil-300 text-soil-900 font-mono text-xs">
                {value}
              </code>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Example -->
  {example && (
    <div class="mb-4">
      <h5 class="text-sm font-semibold text-soil-700 mb-2">Example Usage</h5>
      <CodeBlock code={example} lang="sql" />
    </div>
  )}

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-harvest-700 hover:text-harvest-800 font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
