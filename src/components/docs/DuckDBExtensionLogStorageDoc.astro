---
import Card from '../ui/Card.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import type { FunctionExample } from '../../data/extension-types';

interface LogStorageParameter {
  name: string;
  type: string;
  required: boolean;
  description: string;
  default?: string;
}

interface Props {
  id: string;
  name: string;
  category: string;
  description: string;
  parameters: LogStorageParameter[];
  examples: FunctionExample[];
}

const {
  id,
  name,
  category,
  description,
  parameters,
  examples
} = Astro.props;

// Create category ID for linking
const categoryId = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<Card padding="lg" id={id} class="mb-8 scroll-mt-32">
  <!-- Log Storage Type Header -->
  <div class="flex items-start justify-between mb-4">
    <div>
      <h4 class="text-xl font-bold text-soil-900 font-mono mb-2">{name}</h4>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center rounded-full border border-soil-300 bg-soil-100 px-2.5 py-0.5 text-[12.5px] font-medium text-soil-600 gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
          Log Storage
        </span>
        <a
          href={`#functions-index-${categoryId}`}
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-soil-600 hover:text-link hover:bg-soil-50 rounded transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {category}
        </a>
      </div>
    </div>
  </div>

  <!-- Description -->
  <div class="mb-4">
    <h5 class="mb-2 font-sans text-[14px] font-semibold text-soil-500">Description</h5>
    <p class="text-sm text-soil-700">
      {description}
    </p>
  </div>

  <!-- Configuration Parameters -->
  {parameters && parameters.length > 0 && (
    <div class="mb-4">
      <h5 class="mb-3 font-sans text-[14px] font-semibold text-soil-500">Configuration parameters</h5>
      <div class="bg-white rounded-lg border border-soil-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-soil-50 border-b border-soil-200">
              <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/5">Parameter</th>
              <th class="px-4 py-2 text-left font-semibold text-soil-900 w-1/6">Type</th>
              <th class="px-4 py-2 text-left font-semibold text-soil-900 w-20">Required</th>
              <th class="px-4 py-2 text-left font-semibold text-soil-900">Description</th>
            </tr>
          </thead>
          <tbody>
            {parameters.map((param, index) => (
              <tr class={index % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                <td class="px-4 py-2 border-t border-soil-200">
                  <code class="break-words font-mono text-[13px] text-field-700">{param.name}</code>
                </td>
                <td class="px-4 py-2 border-t border-soil-200">
                  <code class="font-mono text-xs text-sun-700 break-words">{param.type}</code>
                </td>
                <td class="px-4 py-2 border-t border-soil-200">
                  {param.required ? (
                    <span class="inline-flex items-center rounded-full border border-sun-400 bg-sun-400/12 px-2.5 py-0.5 text-[12.5px] font-medium text-sun-700">
                      Required
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2 py-0.5 text-xs rounded bg-soil-100 text-soil-600">
                      Optional
                    </span>
                  )}
                </td>
                <td class="px-4 py-2 text-soil-700 border-t border-soil-200">
                  {param.default && (
                    <span class="inline-block px-2 py-0.5 bg-soil-100 text-soil-600 text-xs rounded mr-2 mb-1">
                      Default: {param.default}
                    </span>
                  )}
                  <span>{param.description}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Examples -->
  <div class="mb-6">
    <h5 class="mb-3 font-sans text-[14px] font-semibold text-soil-500">Examples</h5>
    <div class="space-y-6">
      {examples.map((example, index) => (
        <div class="bg-soil-50 rounded-lg p-4 border border-soil-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="qf-figure inline-flex h-6 w-6 items-center justify-center rounded-full bg-soil-900 text-xs text-soil-50">
              {index + 1}
            </span>
            {example.description && (
              <p class="text-sm text-soil-700 font-medium">{example.description}</p>
            )}
          </div>
          <CodeBlock code={example.code} lang="sql" />
          {(example.output || example.outputTable) && (
            <div class="mt-3">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-sun-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-[12.5px] font-semibold text-soil-800">Output</p>
              </div>
              {example.outputTable ? (
                <div class="bg-white rounded border border-soil-300 overflow-x-auto">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-soil-50 border-b border-soil-200">
                        {example.outputTable.columns.map((col) => {
                          const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                          return (
                            <th class={`px-3 py-2 ${alignClass} font-semibold text-soil-900 font-mono`}>
                              {col.name}
                            </th>
                          );
                        })}
                      </tr>
                    </thead>
                    <tbody>
                      {example.outputTable.rows.map((row, rowIndex) => (
                        <tr class={rowIndex % 2 === 0 ? 'bg-white' : 'bg-soil-50'}>
                          {row.map((cell, cellIndex) => {
                            const col = example.outputTable!.columns[cellIndex];
                            const alignClass = col.align === 'right' ? 'text-right' : col.align === 'center' ? 'text-center' : 'text-left';
                            return (
                              <td class={`px-3 py-2 ${alignClass} text-soil-800 font-mono border-t border-soil-200`}>
                                {typeof cell === 'boolean' ? (cell ? 'true' : 'false') : cell}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <div class="bg-white rounded px-3 py-2 font-mono text-xs text-soil-800 border border-soil-300 overflow-x-auto">
                  <pre class="whitespace-pre">{example.output}</pre>
                </div>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Back to Extension Contents -->
  <div class="pt-4 border-t border-soil-200">
    <a href="#functions-index" class="inline-flex items-center gap-1 text-sm text-link hover:text-link-hover font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Extension Contents
    </a>
  </div>
</Card>
