---
import CodeBlock from '../ui/CodeBlock.astro';
interface Props { sql: string; }
const { sql } = Astro.props;
---

<details class="my-6 rounded-lg border border-soil-200 p-4">
  <summary class="cursor-pointer text-sm font-semibold text-soil-700">Sample data for the examples</summary>
  <p class="my-3 text-sm text-soil-600">
    Each browser example starts with these sample tables; sample files are shared
    across examples on this page. Run this setup first when
    trying the examples in your own DuckDB session.
  </p>
  <CodeBlock code={sql} lang="sql" tryable={false} />
</details>
