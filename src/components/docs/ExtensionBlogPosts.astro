---
/**
 * "From the blog" on an extension page: published posts that name the
 * extension in their frontmatter (`extensions`, or `nextStep.extension`).
 * Populated by src/lib/blog-extensions.ts; the page renders nothing when empty.
 */
import ExtensionSection from './ExtensionSection.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import type { BlogPost } from '../../lib/blog-tags';

interface Props {
  posts: BlogPost[];
  extensionName: string;
}

const { posts, extensionName } = Astro.props;
const dateFor = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

<ExtensionSection id="blog-posts">
  <SectionHeader
    eyebrow="From the blog"
    title="Articles"
    description={`Writing about ${extensionName}: how it works, what changed, and why.`}
    class="mb-8"
  />
  <ul role="list" class="grid gap-x-12 sm:grid-cols-2">
    {posts.map((post) => (
      <li class="border-t border-soil-300 py-6">
        <p class="mb-3 text-xs text-soil-700">
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)} class="qf-figure">{dateFor(post.data.pubDate)}</time>
        </p>
        <h3 class="text-xl leading-tight text-soil-900">
          <a href={`/blog/${post.id}/`} class="text-soil-900 underline decoration-soil-400 underline-offset-4 hover:text-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">{post.data.title}</a>
        </h3>
        <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-soil-700">{post.data.description}</p>
      </li>
    ))}
  </ul>
</ExtensionSection>
