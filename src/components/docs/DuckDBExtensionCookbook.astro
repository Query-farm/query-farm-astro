---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "Practical Examples",
  title = "Cookbook",
  description = "Real-world recipes and patterns for common use cases."
} = Astro.props;
---

<ExtensionSection id="cookbook" background="white">
  <SectionHeader
    eyebrow={eyebrow}
    title={title}
    description={description}
    class="mb-12"
  />

  <div class="prose prose-lg max-w-none
                  prose-headings:font-display prose-headings:font-bold prose-headings:text-soil-900
                  prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-soil-200
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
                  prose-p:text-soil-700 prose-p:leading-relaxed
                  prose-a:text-harvest-600 prose-a:no-underline hover:prose-a:text-harvest-700 prose-a:font-medium
                  prose-strong:text-soil-900 prose-strong:font-semibold
                  prose-code:text-harvest-700 prose-code:bg-harvest-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono
                  prose-pre:bg-transparent prose-pre:p-0
                  prose-blockquote:border-l-harvest-500 prose-blockquote:text-soil-700 prose-blockquote:bg-soil-100 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
                  prose-ul:text-soil-700 prose-ol:text-soil-700
                  prose-li:marker:text-harvest-600
                  prose-table:w-full prose-table:text-sm
                  prose-thead:bg-soil-100 prose-thead:border-b-2 prose-thead:border-soil-300
                  prose-th:px-4 prose-th:py-3 prose-th:text-left prose-th:font-semibold prose-th:text-soil-900
                  prose-td:px-4 prose-td:py-3 prose-td:border-b prose-td:border-soil-200
                  prose-tr:hover:bg-soil-50
                  prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-soil-200">
    <slot />
  </div>
</ExtensionSection>

<style is:global>
  /* Cookbook-specific styling - reuse technical details styles */
  #cookbook .prose pre,
  #cookbook .prose pre.astro-code {
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgba(20, 83, 45, 0.3);
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #1a3a1a 0%, #0d2818 100%) !important;
    tab-size: 2;
    padding: 1rem;
    padding-right: 3.5rem;
  }

  #cookbook .prose pre code,
  #cookbook .prose pre.astro-code code {
    display: block;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #e8f5e9;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    background: transparent !important;
    white-space: pre;
    padding: 0;
  }

  /* Strip @tailwindcss/typography's default backtick decorations on inline <code> */
  #cookbook .prose :where(code):not(:where([class~="not-prose"] *))::before,
  #cookbook .prose :where(code):not(:where([class~="not-prose"] *))::after {
    content: none !important;
  }

  /* Override Shiki's inline background color */
  #cookbook .prose pre.astro-code,
  #cookbook .prose pre.astro-code span {
    background-color: transparent !important;
  }

  /* Copy button for code blocks */
  #cookbook .prose pre .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #a5d6a7;
    background: rgba(13, 40, 24, 0.9);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.15s, background 0.15s;
    z-index: 10;
  }

  #cookbook .prose pre .copy-btn:hover {
    color: #e8f5e9;
    background: rgba(13, 40, 24, 1);
  }

  #cookbook .prose pre .copy-btn.copied {
    color: #4ade80;
  }

  /* Recipe card styling */
  #cookbook .recipe-card {
    background: linear-gradient(135deg, #faf9f7 0%, #f5f3ef 100%);
    border: 1px solid #d3cab9;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  #cookbook .recipe-card h3 {
    margin-top: 0 !important;
  }
</style>

<script is:inline>
  // Add copy buttons to cookbook code blocks
  function setupCookbookCopyButtons() {
    const codeBlocks = document.querySelectorAll('#cookbook .prose pre');

    codeBlocks.forEach((pre) => {
      // Skip if already has a copy button
      if (pre.querySelector('.copy-btn')) return;

      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Copy</span>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.classList.add('copied');
            button.innerHTML = `
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Copied!</span>
            `;

            setTimeout(() => {
              button.classList.remove('copied');
              button.innerHTML = `
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        }
      });

      pre.appendChild(button);
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCookbookCopyButtons);
  } else {
    setupCookbookCopyButtons();
  }
</script>
