---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "Practical Examples",
  title = "Cookbook",
  description = "Real-world recipes and patterns for common use cases."
} = Astro.props;
---

<ExtensionSection id="cookbook" background="white">
  <SectionHeader
    eyebrow={eyebrow}
    title={title}
    description={description}
    class="mb-12"
  />

  <!-- Base `prose` (16px), not `prose-lg` — matches the generated sections on
       the same page. Keep this in step with DuckDBExtensionTechnicalDetails. -->
  <div class="extension-prose prose max-w-none
                  prose-headings:font-display prose-headings:font-semibold prose-headings:text-soil-900
                  prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-soil-200
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
                  prose-p:text-soil-700 prose-p:leading-relaxed prose-p:max-w-[725px] prose-ul:max-w-[725px] prose-ol:max-w-[725px] prose-blockquote:max-w-[725px] prose-li:max-w-[725px]
                  prose-a:text-link prose-a:underline prose-a:underline-offset-2 prose-a:decoration-link/45 hover:prose-a:decoration-link prose-a:font-medium
                  prose-strong:text-soil-900 prose-strong:font-semibold
                  prose-code:text-soil-900 prose-code:bg-soil-100 prose-code:font-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[14px] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
                  [&_a:has(>code)]:no-underline [&_a>code]:bg-sun-400/10 [&_a>code]:text-sun-800 [&_a:hover>code]:bg-link/20 [&_a:hover>code]:text-sun-800 [&_a>code]:transition-colors
                  prose-pre:bg-transparent prose-pre:p-0
                  prose-blockquote:border-l-sun-400 prose-blockquote:text-soil-700 prose-blockquote:bg-soil-100 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
                  prose-ul:text-soil-700 prose-ol:text-soil-700
                  prose-li:marker:text-sun-700
                  prose-table:w-full prose-table:text-sm
                  prose-thead:bg-soil-100 prose-thead:border-b-2 prose-thead:border-soil-300
                  prose-th:px-4 prose-th:py-3 prose-th:text-left prose-th:font-semibold prose-th:text-soil-900
                  prose-td:px-4 prose-td:py-3 prose-td:border-b prose-td:border-soil-200
                  prose-tr:hover:bg-soil-50
                  prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-soil-200">
    <slot />
  </div>
</ExtensionSection>

<style is:global>
  /* Cookbook-specific styling - reuse technical details styles */
  #cookbook .prose pre,
  #cookbook .prose pre.astro-code {
    position: relative;
    border-radius: 0.5rem;
    /* The scroll container lives here, not on the zero-padding <code> inside
       it (see below) — that way the 1rem padding on every side doubles as
       clearance for the horizontal scrollbar a long single-line statement
       triggers. overflow-y stays hidden: a code snippet never legitimately
       scrolls vertically (this <pre> is a plain, unconstrained block), and
       leaving overflow-y at its default lets the CSS overflow spec's
       visible→auto coupling manufacture a second, needless vertical
       scrollbar the moment the horizontal one appears. */
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid var(--color-rock-800);
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    background: var(--color-rock-900) !important;
    tab-size: 2;
    padding: 1rem;
    /* Clearance for Expressive Code's own floating "Copy to clipboard" button
       (top-right corner of the block) on extensions ExampleShellMounter never
       mounts on (no WASM build, so no toolbar to adopt that button into). */
    padding-right: 3.5rem;
  }

  #cookbook .prose pre code,
  #cookbook .prose pre.astro-code code {
    display: block;
    /* No overflow/scrolling of its own — content that doesn't fit simply
       overflows this box and scrolls via the padded <pre> above, which is
       what keeps a reserved-space horizontal scrollbar off the text itself. */
    font-size: var(--qf-code-font-size);
    line-height: var(--qf-code-line-height);
    color: #e9e1d3;
    font-family: var(--qf-code-font-family);
    background: transparent !important;
    white-space: pre;
    padding: 0;
  }

  /* Strip @tailwindcss/typography's default backtick decorations on inline <code> */
  #cookbook .prose :where(code):not(:where([class~="not-prose"] *))::before,
  #cookbook .prose :where(code):not(:where([class~="not-prose"] *))::after {
    content: none !important;
  }

  /* Override Shiki's inline background color */
  #cookbook .prose pre.astro-code,
  #cookbook .prose pre.astro-code span {
    background-color: transparent !important;
  }

  /* Recipe card styling */
  #cookbook .recipe-card {
    background: #fff;
    border: 1px solid var(--color-soil-300);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  #cookbook .recipe-card h3 {
    margin-top: 0 !important;
  }
</style>
