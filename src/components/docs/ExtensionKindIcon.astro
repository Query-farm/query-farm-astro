---
/**
 * A small glyph for each kind of thing a DuckDB extension can register.
 *
 * The five function kinds reuse the VGI docs' shape diagrams
 * (`public/vgi/docs/assets/kinds/*.svg`) — a function's icon *is* its row
 * arithmetic: one bar to one bar for scalar, three bars to a dot for aggregate,
 * and so on. Those files are 40px-tall figures with an italic ƒ and 6px bars;
 * at chip size (~14px) the ƒ turns to mud and the bars close up, so these are
 * redrawn at the same proportions with the detail that survives shrinking:
 * fatter bars, heavier arrows, no lettering.
 *
 * The object kinds (settings, secrets, filesystems…) are not row
 * transformations, so a shape diagram would say nothing about them; they get
 * conventional pictograms instead, drawn at the same stroke weight so the two
 * halves still read as one set.
 *
 * Everything is `currentColor`, so a glyph takes the ink of the chip it sits
 * in — the `cat-*-ink` values, which are the very colours the VGI originals are
 * drawn in.
 */
interface Props {
  kind: string;
  class?: string;
}

const { kind, class: className = '' } = Astro.props;

const cls = `inline-block h-3.5 w-auto shrink-0 ${className}`;
---

{kind === 'scalar' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <rect x="4" y="16" width="18" height="8" rx="4" />
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="27" y1="20" x2="39" y2="20" />
      <polyline points="33.5,14.5 39.5,20 33.5,25.5" />
    </g>
    <rect x="44" y="16" width="18" height="8" rx="4" />
  </svg>
)}

{kind === 'table' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <rect x="4" y="11" width="14" height="18" rx="3" />
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="23" y1="20" x2="35" y2="20" />
      <polyline points="29.5,14.5 35.5,20 29.5,25.5" />
    </g>
    <rect x="40" y="5" width="22" height="7" rx="3.5" />
    <rect x="40" y="16.5" width="22" height="7" rx="3.5" />
    <rect x="40" y="28" width="22" height="7" rx="3.5" />
  </svg>
)}

{kind === 'aggregate' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <rect x="3" y="5" width="18" height="7" rx="3.5" />
    <rect x="3" y="16.5" width="18" height="7" rx="3.5" />
    <rect x="3" y="28" width="18" height="7" rx="3.5" />
    <path d="M25,8.5 L43,20 M25,20 L43,20 M25,31.5 L43,20" fill="none" stroke="currentColor" stroke-width="2.2" opacity="0.55" />
    <circle cx="53" cy="20" r="9" />
  </svg>
)}

{kind === 'copy' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <rect x="3" y="5" width="17" height="7" rx="3.5" />
    <rect x="3" y="16.5" width="17" height="7" rx="3.5" />
    <rect x="3" y="28" width="17" height="7" rx="3.5" />
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="25" y1="20" x2="37" y2="20" />
      <polyline points="31.5,14.5 37.5,20 31.5,25.5" />
      <rect x="43.5" y="6.5" width="19" height="27" rx="3" />
    </g>
    <rect x="48" y="14" width="10" height="3.5" rx="1.75" />
    <rect x="48" y="22" width="10" height="3.5" rx="1.75" />
  </svg>
)}

{kind === 'type' && (
  <svg class={cls} viewBox="0 0 66 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 9h46M33 9v24M22 33h22" />
  </svg>
)}

{kind === 'macro' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18,6 C11,6 14,17 7,20 C14,23 11,34 18,34" />
      <path d="M48,6 C55,6 52,17 59,20 C52,23 55,34 48,34" />
    </g>
    <rect x="24" y="12" width="18" height="6.5" rx="3.25" />
    <rect x="24" y="22" width="18" height="6.5" rx="3.25" />
  </svg>
)}

{kind === 'pragma' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <line x1="6" y1="13" x2="60" y2="13" />
      <line x1="6" y1="27" x2="60" y2="27" />
    </g>
    <circle cx="23" cy="13" r="6" />
    <circle cx="45" cy="27" r="6" />
  </svg>
)}

{kind === 'secret' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
      <circle cx="17" cy="20" r="9.5" />
      <line x1="28" y1="20" x2="60" y2="20" />
      <line x1="48" y1="20" x2="48" y2="29" />
      <line x1="57" y1="20" x2="57" y2="26" />
    </g>
  </svg>
)}

{kind === 'filesystem' && (
  <svg class={cls} viewBox="0 0 66 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
    <path d="M6,33 L6,10 L24,10 L29.5,16.5 L60,16.5 L60,33 Z" />
  </svg>
)}

{kind === 'storage' && (
  <svg class={cls} viewBox="0 0 66 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true">
    <ellipse cx="33" cy="9" rx="16" ry="5.5" />
    <path d="M17,9 L17,31 A16,5.5 0 0 0 49,31 L49,9" />
    <path d="M17,20 A16,5.5 0 0 0 49,20" />
  </svg>
)}

{kind === 'logtype' && (
  <svg class={cls} viewBox="0 0 66 40" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
    <rect x="14" y="5" width="38" height="30" rx="3.5" stroke-width="3.2" />
    <g stroke-width="2.8">
      <line x1="22" y1="14" x2="44" y2="14" />
      <line x1="22" y1="20" x2="44" y2="20" />
      <line x1="22" y1="26" x2="36" y2="26" />
    </g>
  </svg>
)}

{kind === 'logstorage' && (
  <svg class={cls} viewBox="0 0 66 40" fill="currentColor" aria-hidden="true">
    <rect x="8" y="5" width="50" height="10" rx="3" />
    <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13,19 L13,35 L53,35 L53,19" />
      <line x1="25" y1="26" x2="41" y2="26" />
    </g>
  </svg>
)}
