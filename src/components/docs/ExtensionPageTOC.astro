---
/**
 * The docs family's only page rail: "On this page", on the left. It is a sticky
 * grid cell, not a floating overlay — the extension page places it in the first
 * column of the two-column docs grid.
 *
 * Sections only. Per-object links (functions, macros, secrets) belong to the
 * Extension Contents index in the body, which stays legible at any count.
 *
 * The items carry `no-underline` on purpose. global.css underlines running-text
 * links via `main :is(p, li, …) > a[href]`, and means to leave navigation alone
 * — but a rail is a `ul > li > a`, so it matches that selector by accident and
 * would otherwise render as a column of underlined gold body links.
 */
interface TOCItem {
  id: string;
  label: string;
  icon?: string;
}

interface Props {
  items: TOCItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<aside
  id="extension-toc"
  aria-label="On this page"
  class:list={[
    'sticky self-start overflow-y-auto',
    'top-[calc(var(--qf-nav-h)+62px)] max-h-[calc(100vh-var(--qf-nav-h)-84px)]',
    className,
  ]}
>
  <h2 class="mb-2.5 font-sans text-[12.5px] font-semibold text-soil-500">
    On this page
  </h2>
  <ul class="flex flex-col gap-0.5">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          data-section={item.id}
          class="toc-link block border-l-2 border-soil-200 px-2.5 py-1 text-[13px] text-soil-600 no-underline transition-colors hover:border-soil-300 hover:text-soil-900"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* Active state lives in CSS so the scroll-spy only has to toggle one attr. */
  .toc-link[aria-current='true'] {
    color: var(--color-link);
    border-left-color: var(--color-link);
    background: rgba(69, 99, 47, 0.07);
  }
</style>

<script>
  // Scroll-spy for the page rail.
  // Plain scroll math rather than IntersectionObserver: sections here are very
  // tall (hundreds of function cards), so "which heading did I last pass" is
  // the behaviour people expect, and IO thresholds get that wrong.
  function initExtensionTOC() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-section]'),
    );
    if (links.length === 0) return;

    const ids = [...new Set(links.map((l) => l.dataset.section!).filter(Boolean))];

    function update() {
      const probe = window.scrollY + window.innerHeight / 3;
      let activeId: string | null = null;
      for (const id of ids) {
        const el = document.getElementById(id);
        if (!el) continue;
        if (probe >= el.getBoundingClientRect().top + window.scrollY) activeId = id;
      }
      for (const link of links) {
        if (link.dataset.section === activeId) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  initExtensionTOC();
  document.addEventListener('astro:page-load', initExtensionTOC);
</script>
