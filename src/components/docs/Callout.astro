---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger' | 'info';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const icons: Record<string, string> = {
  note: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
  </svg>`,
  tip: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
  </svg>`,
  warning: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
  </svg>`,
  danger: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`,
  info: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`
};

const defaultTitles: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  danger: 'Danger',
  info: 'Info'
};

const displayTitle = title || defaultTitles[type];
---

<div class={`callout callout-${type}`}>
  <div class="callout-title">
    <Fragment set:html={icons[type]} />
    <span>{displayTitle}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style is:global>
  /* Callout styles — family C is paper, rules, one gold accent. Warnings and
     danger take the single warm rust; everything else takes the gold. */
  .callout {
    padding: 0.875rem 1.125rem;
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 1.5rem 0;
    border-left: 3px solid var(--color-sun-400);
    background: #fff;
  }

  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0;
    color: var(--color-sun-700);
    margin-bottom: 0.4rem;
  }

  .callout-title svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .callout-content p:last-child {
    margin-bottom: 0;
  }

  .callout-note,
  .callout-tip {
    border-color: var(--color-sun-400);
  }

  .callout-warning {
    border-color: var(--color-sun-600);
    background: #fdfaf3;
  }
  .callout-warning .callout-title { color: var(--color-sun-800); }

  .callout-danger {
    border-color: #a8412a;
    background: #fdf4f1;
  }
  .callout-danger .callout-title { color: #a8412a; }

  .callout-info {
    border-color: var(--color-sun-400);
  }
</style>
