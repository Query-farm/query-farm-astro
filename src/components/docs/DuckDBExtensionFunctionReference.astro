---
import SectionHeader from '../ui/SectionHeader.astro';
import DuckDBExtensionFunctionDoc from './DuckDBExtensionFunctionDoc.astro';
import type { FunctionDocData } from '../../data/extension-types';

interface Props {
  functions: FunctionDocData[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  functions,
  eyebrow = "API Reference",
  title = "Function Documentation",
  description = "Detailed documentation for each function including signatures, parameters, and examples."
} = Astro.props;

// Only render if there are functions
if (!functions || functions.length === 0) {
  return null;
}
---

<section id="function-reference" class="py-16 lg:py-24 bg-white scroll-mt-16">
  <div class="section-container">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      class="mb-12"
    />

    <div class="max-w-6xl 2xl:max-w-7xl mx-auto">
      {functions.map((fn) => (
        <DuckDBExtensionFunctionDoc {...fn} allFunctions={functions} />
      ))}
    </div>
  </div>
</section>
