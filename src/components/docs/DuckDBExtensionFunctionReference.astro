---
import SectionHeader from '../ui/SectionHeader.astro';
import ExtensionSection from './ExtensionSection.astro';
import type { FunctionDocData } from '../../data/extension-types';
import { extensionNameAnchor } from '../../lib/extension-anchors';
import {
  extensionFunctionCategoryPath,
  groupExtensionFunctions,
} from '../../lib/extension-reference';

interface Props {
  functions: FunctionDocData[];
  slug: string;
  categoryDescriptions?: Record<string, string>;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  functions,
  slug,
  categoryDescriptions = {},
  eyebrow = 'API Reference',
  title = 'Function Documentation',
  description,
} = Astro.props;

if (!functions || functions.length === 0) return null;

const categories = groupExtensionFunctions(functions);
const categorySlugs = new Set(categories.map(category => category.slug));
if (categorySlugs.size !== categories.length) {
  throw new Error(`Function category slugs must be unique for extension "${slug}".`);
}

const anchorCategoryEntries: [string, string][] = [];
const assignedAnchors = new Set<string>();
for (const category of categories) {
  for (const fn of category.functions) {
    for (const anchor of [fn.id, extensionNameAnchor(fn.name)]) {
      if (!assignedAnchors.has(anchor)) {
        assignedAnchors.add(anchor);
        anchorCategoryEntries.push([anchor, category.slug]);
      }
    }
  }
}
---

<ExtensionSection id="function-reference" background="white" data-pagefind-ignore>
  <SectionHeader eyebrow={eyebrow} title={title} description={description} class="mb-8" />

  <nav aria-label="Function categories" class="mb-10 border-t border-soil-300">
    {categories.map(category => (
      <a
        href={extensionFunctionCategoryPath(slug, category.name)}
        class="group grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 gap-y-2 border-b border-soil-300 px-1 py-5 text-soil-900 no-underline transition hover:bg-sun-400/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link aria-[current=true]:bg-sun-400/10 md:grid-cols-[minmax(11rem,0.4fr)_minmax(0,1fr)_auto] md:items-center md:px-3"
        data-function-category-link
        data-category-slug={category.slug}
        aria-controls="function-category-region"
        aria-expanded="false"
      >
        <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-display text-xl font-semibold group-hover:text-link">{category.name}</span>
          <span class="whitespace-nowrap text-sm tabular-nums text-soil-500">
            {category.functions.length} {category.functions.length === 1 ? 'function' : 'functions'}
          </span>
        </span>
        {categoryDescriptions[category.name] && (
          <span class="col-span-2 block max-w-3xl text-[15px] leading-relaxed text-soil-700 md:col-span-1 md:col-start-2 md:row-start-1">
            {categoryDescriptions[category.name]}
          </span>
        )}
        <span class="col-start-2 row-start-1 text-xl text-link transition-transform group-hover:translate-x-0.5 md:col-start-3" aria-hidden="true">
          →
        </span>
      </a>
    ))}
  </nav>

  <p id="function-category-status" class="sr-only" role="status" aria-live="polite"></p>
  <div
    id="function-category-region"
    class="scroll-mt-28 outline-none"
    tabindex="-1"
    aria-busy="false"
  ></div>

  <script is:inline define:vars={{ anchorCategoryEntries }}>
    (() => {
      const links = [...document.querySelectorAll('[data-function-category-link]')];
      const region = document.getElementById('function-category-region');
      const status = document.getElementById('function-category-status');
      if (!links.length || !region || !status) return;

      const anchorCategories = new Map(anchorCategoryEntries);
      const cache = new Map();
      let activeSlug = '';
      let requestNumber = 0;

      const linkForSlug = slug => links.find(link => link.dataset.categorySlug === slug);
      const categoryName = link => link.querySelector('.font-display')?.textContent?.trim() || 'category';

      async function fetchCategory(link) {
        const url = link.href;
        if (!cache.has(url)) {
          cache.set(url, fetch(url, { headers: { 'X-Requested-With': 'progressive-category' } })
            .then(response => {
              if (!response.ok) throw new Error(`Category request failed with ${response.status}`);
              return response.text();
            })
            .then(html => {
              const page = new DOMParser().parseFromString(html, 'text/html');
              const fragment = page.querySelector('[data-function-category-fragment]');
              if (!fragment) throw new Error('Category response did not contain a function fragment');
              return fragment;
            })
            .catch(error => {
              cache.delete(url);
              throw error;
            }));
        }
        return cache.get(url);
      }

      function setActiveLink(link) {
        for (const item of links) {
          const active = item === link;
          item.setAttribute('aria-expanded', String(active));
          if (active) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        }
      }

      function announce(message) {
        status.textContent = '';
        requestAnimationFrame(() => { status.textContent = message; });
      }

      async function activate(link, options = {}) {
        const { updateHistory = true, focus = true, targetId = '' } = options;
        const slug = link.dataset.categorySlug;
        if (!slug) return;
        const currentRequest = ++requestNumber;

        region.setAttribute('aria-busy', 'true');
        announce(`Loading ${categoryName(link)} functions…`);

        try {
          const source = await fetchCategory(link);
          if (currentRequest !== requestNumber) return;

          document.dispatchEvent(new CustomEvent('qf:content-will-unload', {
            detail: { root: region },
          }));
          region.replaceChildren(source.cloneNode(true));
          region.setAttribute('aria-busy', 'false');
          activeSlug = slug;
          setActiveLink(link);

          if (updateHistory) history.pushState(null, '', `#function-category-${slug}`);

          document.dispatchEvent(new CustomEvent('qf:content-loaded', {
            detail: { root: region },
          }));
          if (window.Prism?.highlightAllUnder) window.Prism.highlightAllUnder(region);

          const target = targetId ? document.getElementById(targetId) : null;
          const scrollTarget = target || region.querySelector('[data-function-category-fragment]') || region;
          const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          scrollTarget.scrollIntoView({ behavior, block: 'start' });
          if (focus) region.focus({ preventScroll: true });
          announce(`${categoryName(link)} functions loaded.`);
        } catch (error) {
          region.setAttribute('aria-busy', 'false');
          announce(`Could not load ${categoryName(link)} functions. Opening the category page instead.`);
          window.location.assign(link.href);
        }
      }

      function clearCategory() {
        requestNumber += 1;
        activeSlug = '';
        setActiveLink(null);
        document.dispatchEvent(new CustomEvent('qf:content-will-unload', {
          detail: { root: region },
        }));
        region.replaceChildren();
      }

      function restoreFromHash({ focus = false } = {}) {
        const anchor = decodeURIComponent(location.hash.slice(1));
        const categoryPrefix = 'function-category-';
        const slug = anchor.startsWith(categoryPrefix)
          ? anchor.slice(categoryPrefix.length)
          : anchorCategories.get(anchor);
        const link = slug ? linkForSlug(slug) : null;
        if (!link) {
          if (activeSlug) clearCategory();
          return;
        }
        if (activeSlug === slug) {
          const target = document.getElementById(anchor);
          if (target) target.scrollIntoView({ block: 'start' });
          return;
        }
        activate(link, {
          updateHistory: false,
          focus,
          targetId: anchor.startsWith(categoryPrefix) ? '' : anchor,
        });
      }

      for (const link of links) {
        link.addEventListener('click', event => {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          activate(link);
        });
        link.addEventListener('pointerenter', () => { fetchCategory(link).catch(() => {}); }, { once: true });
        link.addEventListener('focus', () => { fetchCategory(link).catch(() => {}); }, { once: true });
      }

      window.addEventListener('popstate', () => restoreFromHash());
      restoreFromHash();
    })();
  </script>
  <script>
    // The main page starts without function cards, so it opts into the shared
    // runtime that enhances Share buttons when a category fragment arrives.
    import '../../scripts/share-links';
  </script>
</ExtensionSection>
