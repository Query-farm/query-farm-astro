---
import PlatformMap from '../products/PlatformMap.astro';

type TourStep = {
  label: string;
  title: string;
  status: string;
  body: string;
  capabilities: string[];
  payoff: string;
  leadership: string;
  builders: string;
  links: Array<{ label: string; href: string }>;
};

const { steps } = Astro.props as { steps: TourStep[] };
---

<div class="vision-split-tour" data-vision-split-tour data-active="0">
  <div class="split-chapters">
    {steps.map((step, index) => (
      <article id={`tour-step-${index + 1}`} class="split-chapter" data-tour-sentinel={index}>
        <div class="split-chapter-index"><i></i><span>0{index + 1} / 0{steps.length}</span></div>
        <p class="split-layer">{step.label}</p>
        <h3>{step.title}</h3>
        <p class="split-status">{step.status}</p>
        <p class="split-body">{step.body}</p>
        <ul class="split-capabilities">
          {step.capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
        <div class="split-payoff">
          <span>Why it matters</span>
          <p>{step.payoff}</p>
        </div>
        <div class="split-audiences">
          <div><span>For leadership</span><p>{step.leadership}</p></div>
          <div><span>For builders</span><p>{step.builders}</p></div>
        </div>
        <nav class="split-links" aria-label={`${step.label} resources`}>
          {step.links.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
        </nav>
      </article>
    ))}

  </div>

  <div class="split-stage-wrap">
    <div class="split-stage-head">
      <div>
        <span>Query.Farm product map</span>
        <strong data-split-stage-name>{steps[0]?.label}</strong>
      </div>
      <div class="split-progress" aria-hidden="true">
        {steps.map((_, index) => <i data-progress={index}></i>)}
      </div>
    </div>
    <div class="split-map-window" data-pan-window>
      <div class="map-pan vision-tour-map" data-pan-map><PlatformMap /></div>
    </div>
    <p class="split-stage-cue"><span aria-hidden="true">↕</span> Scroll to explore each layer</p>
  </div>
</div>

<style>
  .vision-split-tour {
    --tour-accent: var(--color-sun-600);
    display: grid;
    width: min(100% - 32px, 1480px);
    grid-template-columns: minmax(320px, 36%) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: start;
    margin: 2rem auto 0;
  }

  .split-chapters { min-width: 0; }
  .split-chapter { display: flex; min-height: 112svh; scroll-margin-top: calc(var(--qf-nav-h) + 2rem); flex-direction: column; justify-content: flex-start; padding: 5rem 0; border-bottom: 1px solid var(--color-soil-300); opacity: .25; transition: opacity .4s ease, transform .4s ease; }
  .split-chapter:first-child { padding-top: 1.5rem; }
  .split-chapter.is-active { opacity: 1; transform: translateX(10px); }
  .split-chapter-index { display: flex; align-items: center; gap: .7rem; color: var(--tour-accent); font-size: .68rem; font-weight: 800; letter-spacing: .11em; }
  .split-chapter-index i { width: 10px; height: 10px; border-radius: 2px; background: currentColor; transform: rotate(45deg); }
  .split-layer { margin-top: 1.25rem; color: var(--tour-accent); font-size: .7rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .split-chapter h3 { max-width: 14ch; margin-top: .7rem; color: var(--color-soil-900); font-size: clamp(2rem, 3.5vw, 3.8rem); line-height: .98; letter-spacing: -.035em; }
  .split-status { width: fit-content; margin-top: 1rem; padding: .4rem .65rem; border: 1px solid color-mix(in srgb, var(--tour-accent) 45%, var(--color-soil-300)); border-radius: 999px; color: var(--tour-accent); font-size: .68rem; font-weight: 750; }
  .split-body { margin-top: 1.25rem; color: var(--color-soil-700); font-size: 1rem; line-height: 1.7; }
  .split-capabilities { display: grid; gap: .7rem; margin-top: 1.25rem; padding: 0; list-style: none; }
  .split-capabilities li { position: relative; padding-left: 1.25rem; color: var(--color-soil-800); font-size: .84rem; line-height: 1.55; }
  .split-capabilities li::before { position: absolute; left: .1rem; top: .52rem; width: 7px; height: 7px; border-radius: 2px; background: var(--tour-accent); content: ''; transform: rotate(45deg); }
  .split-payoff { margin-top: 1.4rem; padding: 1rem 1.1rem; border-left: 5px solid var(--tour-accent); background: color-mix(in srgb, var(--tour-accent) 7%, #fffdf7); }
  .split-payoff span { color: var(--tour-accent); font-size: .64rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .split-payoff p { margin-top: .35rem; color: var(--color-soil-800); font-size: .83rem; line-height: 1.5; }
  .split-audiences { display: grid; grid-template-columns: 1fr 1fr; margin-top: 1.15rem; border: 1px solid var(--color-soil-300); border-radius: 10px; background: #fffdf7; }
  .split-audiences > div { padding: .85rem; }
  .split-audiences > div + div { border-left: 1px solid var(--color-soil-300); }
  .split-audiences span { color: var(--color-soil-500); font-size: .62rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .split-audiences p { margin-top: .35rem; color: var(--color-soil-700); font-size: .73rem; line-height: 1.48; }
  .split-links { display: flex; flex-wrap: wrap; gap: .55rem 1rem; margin-top: 1.15rem; }
  .split-links a { color: var(--color-field-700); font-size: .78rem; font-weight: 750; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-field-700) 35%, transparent); text-underline-offset: 4px; }
  .split-links a:hover { text-decoration-color: currentColor; }

  .split-stage-wrap { position: sticky; top: calc(var(--qf-nav-h) + 12px); display: grid; height: calc(100svh - var(--qf-nav-h) - 24px); min-height: 620px; grid-template-rows: auto minmax(0, 1fr) auto; overflow: hidden; border: 1px solid var(--color-soil-300); border-radius: 16px; background: #fffdf7; box-shadow: 0 24px 60px rgb(48 39 26 / .1); }
  .split-stage-head { display: flex; position: relative; z-index: 2; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; border-bottom: 1px solid var(--color-soil-300); background: #fffdf7; }
  .split-stage-head > div:first-child { display: flex; flex-direction: column; gap: .2rem; }
  .split-stage-head span { color: var(--color-soil-500); font-size: .63rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .split-stage-head strong { color: var(--tour-accent); font-size: .76rem; text-transform: uppercase; }
  .split-progress { display: flex; gap: .55rem; }
  .split-progress i { width: 8px; height: 8px; border: 1px solid var(--color-soil-400); border-radius: 2px; transform: rotate(45deg); }
  .split-progress i.is-active { border-color: var(--tour-accent); background: var(--tour-accent); transform: rotate(45deg) scale(1.35); }
  .split-map-window { min-height: 0; overflow: hidden; background: linear-gradient(90deg, var(--color-soil-50), #fffdf7); }
  .map-pan { width: 100%; margin: 0 auto; will-change: transform; transition: transform .7s cubic-bezier(.16, 1, .3, 1); }
  .split-stage-cue { display: flex; position: relative; z-index: 2; align-items: center; gap: .6rem; padding: .7rem 1.2rem; border-top: 1px solid var(--color-soil-300); background: #fffdf7; color: var(--color-soil-600); font-size: .7rem; font-weight: 700; }
  .split-stage-cue span { color: var(--tour-accent); font-size: 1rem; }

  .vision-tour-map.is-guiding :global(.nodes [data-stage]),
  .vision-tour-map.is-guiding :global(.stage-marker[data-stage]),
  .vision-tour-map.is-guiding :global(.circuit-layer-band[data-stage]) { opacity: .14; transition: opacity .45s ease; }
  .vision-tour-map.is-guiding :global([data-stage].tour-active) { opacity: 1 !important; }
  .vision-tour-map.is-guiding :global(.wires),
  .vision-tour-map.is-guiding :global(.packets) { opacity: .34; transition: opacity .45s ease; }

  @media (max-width: 900px) {
    .vision-split-tour { display: flex; width: min(100% - 24px, 680px); flex-direction: column; gap: 0; }
    .split-stage-wrap { top: var(--qf-nav-h); z-index: 7; order: -1; width: 100%; height: 44svh; min-height: 330px; border-radius: 12px; }
    .split-stage-head { padding: .7rem .85rem; }
    .split-stage-cue { display: none; }
    .split-chapter { min-height: 115svh; padding: 5rem .35rem; }
    .split-chapter h3 { font-size: clamp(2rem, 10vw, 3.2rem); }
    .split-audiences { grid-template-columns: 1fr; }
    .split-audiences > div + div { border-top: 1px solid var(--color-soil-300); border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .split-chapter, .map-pan { transition: none; }
  }
</style>

<script>
  const stagePositions = [.144, .355, .487, .627, .764, .9];
  const stageNames = ['Query surface', 'SQL engines', 'Engine integration', 'Access control', 'VGI execution', 'Data & compute'];

  const initializeVisionSplitTours = () => {
    document.querySelectorAll('[data-vision-split-tour]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const sentinels = Array.from(root.querySelectorAll('[data-tour-sentinel]'));
      const map = root.querySelector('[data-pan-map]');
      const mapWindow = root.querySelector('[data-pan-window]');
      const stage = root.querySelector('.split-stage-wrap');
      const stageName = root.querySelector('[data-split-stage-name]');
      let active = -1;
      let frame = 0;

      const panMap = (index: number) => {
        const svg = map?.querySelector('svg');
        if (!(map instanceof HTMLElement) || !(mapWindow instanceof HTMLElement) || !(svg instanceof SVGElement)) return;
        const mapHeight = svg.clientHeight;
        const desired = mapWindow.clientHeight * .5 - mapHeight * stagePositions[index];
        const minimum = Math.min(0, mapWindow.clientHeight - mapHeight);
        map.style.transform = `translateY(${Math.max(minimum, Math.min(0, desired))}px)`;
      };

      const show = (index: number) => {
        if (index === active || index < 0 || index >= stagePositions.length) return;
        active = index;
        root.dataset.active = String(index);
        root.style.setProperty('--tour-accent', index === 1 ? 'var(--color-soil-700)' : index >= 4 ? 'var(--color-field-700)' : 'var(--color-sun-600)');
        sentinels.forEach((sentinel, sentinelIndex) => sentinel.classList.toggle('is-active', sentinelIndex === index));
        root.querySelectorAll('[data-progress]').forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
        if (stageName) stageName.textContent = stageNames[index];
        if (map instanceof HTMLElement) {
          map.classList.add('is-guiding');
          map.querySelectorAll('[data-stage]').forEach((element) => {
            if (element instanceof SVGElement) element.classList.toggle('tour-active', element.dataset.stage === String(index));
          });
        }
        panMap(index);
      };

      const update = () => {
        frame = 0;
        const narrow = window.matchMedia('(max-width: 900px)').matches;
        const navHeight = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--qf-nav-h')) || 64;
        const readingLine = narrow && stage instanceof HTMLElement
          ? Math.min(stage.getBoundingClientRect().bottom + 28, window.innerHeight - 80)
          : navHeight + 28;
        let current = 0;
        sentinels.forEach((sentinel, index) => {
          if (sentinel.getBoundingClientRect().top <= readingLine) current = index;
        });
        if (current === active) panMap(current);
        else show(current);
      };
      const requestUpdate = () => {
        if (!frame) frame = window.requestAnimationFrame(update);
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });
      show(0);
      requestUpdate();
    });
  };

  document.addEventListener('astro:page-load', initializeVisionSplitTours);
  initializeVisionSplitTours();
</script>
