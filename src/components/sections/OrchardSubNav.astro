---
// Section bar for the Orchard area — the `.subnav` shape: sticky beneath the
// global nav, soil-100 ground, section mark + name behind a rule, then tabs.
//
// Pass the same breadcrumb array PageLayout would have received; the trailing
// crumb (the current connector or guide) becomes the active tab, unless it's
// the section index itself.

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  breadcrumbs?: Crumb[];
}
const { breadcrumbs = [] } = Astro.props;

const currentPath = Astro.url.pathname;
const SECTION = '/products/orchard';
const norm = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);

const last = breadcrumbs[breadcrumbs.length - 1];
const current = last && norm(last.href) !== SECTION ? last.name : null;
const currentHref = current ? norm(last!.href) : null;

const tabs = [
  { name: 'Connectors', href: '/products/orchard' },
  { name: 'Subscribe', href: '/products/orchard/subscribe' },
  { name: 'Publish', href: '/products/orchard/submit' }
];

// A tab is active when its own route is current AND it isn't superseded by a
// deeper crumb (e.g. a connector detail page).
function isActive(href: string): boolean {
  if (currentHref && norm(currentHref) === href) return true;
  if (current) return false;
  return norm(currentPath) === href;
}

const tabClass = 'whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
const tabActive = 'border-link text-link';
const tabIdle = 'border-transparent text-soil-700 hover:text-soil-900';

// Only surface the trailing crumb when it isn't already one of the tabs.
const showCrumbTab = Boolean(current) && !tabs.some(t => t.href === currentHref);
---

<div class="sticky z-40 border-b border-soil-300 bg-soil-100" style="top: var(--qf-nav-h)">
  <div class="section-container">
    <nav class="qf-subnav-row flex items-center overflow-x-auto" aria-label="Orchard section">
      <a
        href="/products/orchard"
        class="mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link"
      >
        <span class="flex h-[22px] w-[22px] items-center justify-center text-[17px] leading-none" aria-hidden="true">🌳</span>
        <span>Orchard</span>
      </a>

      {tabs.map(tab => (
        <a
          href={tab.href}
          class:list={[tabClass, isActive(tab.href) ? tabActive : tabIdle]}
          aria-current={isActive(tab.href) ? 'page' : undefined}
        >
          {tab.name}
        </a>
      ))}

      {showCrumbTab && (
        <span class:list={[tabClass, tabActive]} aria-current="page">{current}</span>
      )}
    </nav>
  </div>
</div>

<style>
  .qf-subnav-row {
    scrollbar-width: none;
  }
  .qf-subnav-row::-webkit-scrollbar {
    display: none;
  }
</style>
