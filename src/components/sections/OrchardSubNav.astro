---
// Section bar for the Orchard area, styled to match ExtensionsSubNav /
// HaybarnSubNav: a white bar with the Orchard mark + "Orchard" wordmark on the
// left, followed by the current page as an emerald-toned breadcrumb pill.
// Replaces the generic gray breadcrumb on the Orchard index, connector, and
// guide pages.
//
// Pass the same breadcrumb array PageLayout would have received; the trailing
// crumb (the current page) is shown after the wordmark, unless it's the section
// index itself (then the wordmark alone represents the page).

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  breadcrumbs?: Crumb[];
}
const { breadcrumbs = [] } = Astro.props;

const SECTION = '/products/orchard';
const norm = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);

const last = breadcrumbs[breadcrumbs.length - 1];
const current = last && norm(last.href) !== SECTION ? last.name : null;
---

<div class="sticky top-16 lg:top-20 z-40 bg-white border-b border-soil-200">
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: Orchard mark + section wordmark + current page -->
      <div class="flex items-center gap-2 min-w-0 overflow-x-auto orchard-subnav-bar">
        <a href="/products/orchard" class="flex items-center gap-3 flex-shrink-0 group">
          <span class="flex h-8 w-8 items-center justify-center rounded-md bg-emerald-100 text-xl leading-none" aria-hidden="true">🌳</span>
          <span class="font-display font-bold text-soil-900 group-hover:text-emerald-700 transition-colors whitespace-nowrap">
            Orchard
          </span>
        </a>

        {current && (
          <>
            <svg class="w-4 h-4 text-soil-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span
              class="whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium bg-emerald-50 text-emerald-700"
              aria-current="page"
            >
              {current}
            </span>
          </>
        )}
      </div>

      <!-- Right: section quick links -->
      <nav class="flex items-center gap-1 flex-shrink-0" aria-label="Orchard section">
        <a href="/products/orchard/subscribe" class="hidden sm:inline whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium text-soil-600 hover:text-emerald-700 hover:bg-soil-50 transition-colors">
          Subscribe
        </a>
        <a href="/products/orchard/submit" class="hidden sm:inline whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium text-soil-600 hover:text-emerald-700 hover:bg-soil-50 transition-colors">
          Publish
        </a>
      </nav>
    </div>
  </div>
</div>

<style>
  .orchard-subnav-bar {
    scrollbar-width: none;
  }
  .orchard-subnav-bar::-webkit-scrollbar {
    display: none;
  }
</style>
