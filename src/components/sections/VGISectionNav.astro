---
/**
 * The "In this section" nav every Family-C VGI page renders inside its own
 * left sidebar. Previously every page kept its own copy of this list — nine
 * files hand-edited in lockstep on every add/rename/remove, which is exactly
 * how pages drifted out of sync with each other earlier in this project. One
 * canonical list, one place to update it.
 *
 * Deliberately renders just the <nav>, not the surrounding <aside> — some
 * pages (getting-started, building-a-worker, architecture, languages) pack a
 * second, page-specific list (a "Reference" or "Jump to a language" section)
 * into the same sidebar, below this one. The page owns the <aside> wrapper
 * so it can add that second list; this component owns only the part that's
 * identical everywhere.
 */
export interface Props {
  current: string;
}
const { current } = Astro.props;

const sectionPages = [
  { name: 'Overview', href: '/vgi' },
  { name: 'Getting Started', href: '/vgi/getting-started' },
  { name: 'Building a Worker', href: '/vgi/building-a-worker' },
  { name: 'Distributing a Worker', href: '/vgi/distributing-a-worker' },
  { name: 'Connect to a Worker', href: '/vgi/connect-to-a-worker' },
  { name: 'Architecture', href: '/vgi/architecture' },
  { name: 'Data-as-a-Service', href: '/vgi/data-as-a-service' },
  { name: 'Authentication', href: '/vgi/authentication' },
  { name: 'Row & Column Security', href: '/vgi/row-column-security' },
  { name: 'Language SDKs', href: '/vgi/languages' },
];

const NAV_LINK = 'block border-l-2 px-2.5 py-1 text-sm no-underline transition';
---

<nav aria-label="VGI documentation">
  <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">In this section</h2>
  <ul class="flex flex-col gap-0.5">
    {sectionPages.map((page) => (
      <li>
        <a
          href={page.href}
          aria-current={page.href === current ? 'page' : undefined}
          class:list={[
            NAV_LINK,
            page.href === current
              ? 'border-link bg-link/8 text-link'
              : 'border-soil-200 text-soil-700 hover:border-soil-300 hover:text-soil-900',
          ]}
        >{page.name}</a>
      </li>
    ))}
  </ul>
</nav>
