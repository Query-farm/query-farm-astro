---
// Shared section bar, extracted from the existing product subnavigation.
interface Item { name: string; href: string; count?: number }
interface Tab extends Item { active?: boolean; items?: Item[] }
interface Props {
  name: string;
  href: string;
  tabs: Tab[];
  class?: string;
}
const { name, href, tabs, class: className } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const tabClass = 'section-tab whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
const activeClass = 'border-link text-link';
const idleClass = 'border-transparent text-soil-700 hover:text-soil-900';
---

<div class:list={['sticky z-40 border-b border-soil-300 bg-soil-100', className]} style="top: var(--qf-nav-h)" data-section-subnav>
  <div class="section-container">
    <nav class="qf-subnav-row relative flex flex-wrap items-center" aria-label={`${name} section`}>
      <a href={href} class="section-identity mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link">
        <slot name="icon" />
        <span>{name}</span>
      </a>
      {tabs.map(tab => tab.items ? (
        <details class="section-menu">
          <summary class:list={[tabClass, 'flex cursor-pointer list-none items-center gap-1.5', tab.active ? activeClass : idleClass]}>
            {tab.name}
            <svg class="chevron h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="section-panel absolute z-50 mt-px rounded-xl border border-soil-300 bg-white p-2 shadow-[0_10px_28px_rgba(33,26,18,0.14)]">
            <ul>
              {tab.items.map(item => <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined} class="flex items-center justify-between gap-4 rounded px-2 py-2 text-sm text-soil-700 no-underline hover:bg-soil-100 hover:text-soil-900 focus-visible:outline-2 focus-visible:outline-link">
                <span>{item.name}</span>{item.count !== undefined && <span class="text-xs tabular-nums">{item.count}</span>}
              </a></li>)}
            </ul>
          </div>
        </details>
      ) : (
        <a href={tab.href} class:list={[tabClass, tab.active ? activeClass : idleClass]} aria-current={tab.active ? 'page' : undefined}>{tab.name}</a>
      ))}
      {Astro.slots.has('action') && <span class="ml-auto flex flex-none items-center pl-4"><slot name="action" /></span>}
    </nav>
  </div>
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  details[open] .chevron { transform: rotate(180deg); }
  .section-panel { width: min(360px, calc(100vw - 32px)); max-height: min(65vh, 480px); overflow-y: auto; }
  .section-panel ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 8px; }
  .section-panel [aria-current='page'] { background: var(--color-soil-100); color: var(--color-field-700); }
  @media (min-width: 480px) and (max-width: 639px) {
    .section-panel { right: 0; }
  }
  @media (max-width: 479px) {
    .section-tab { padding-inline: 8px; font-size: 12px; }
    .section-identity { padding-right: 12px; }
    .section-panel { left: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-section-subnav]').forEach(nav => {
    const menus = nav.querySelectorAll<HTMLDetailsElement>('.section-menu');
    for (const menu of menus) {
      menu.addEventListener('toggle', () => {
        if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
      });
      menu.addEventListener('keydown', event => {
        if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
    }
    document.addEventListener('click', event => {
      for (const menu of menus) if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('focusin', event => {
      for (const menu of menus) if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    if (nav.classList.contains('blog-subnav')) {
      const updateHeight = () => document.documentElement.style.setProperty('--qf-blog-nav-h', `${nav.getBoundingClientRect().height}px`);
      new ResizeObserver(updateHeight).observe(nav);
      updateHeight();
    }
  });
</script>
