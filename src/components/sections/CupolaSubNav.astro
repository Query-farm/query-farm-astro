---
import { CUPOLA_APP, CUPOLA_REPO } from '../../data/cupola';

const currentPath = Astro.url.pathname;

// Cupola is a single product page, so most tabs are in-page anchors. Only
// "Overview" maps to a route for active-state purposes.
const tabs = [
  { name: 'Overview', href: '/products/cupola' },
  { name: 'Features', href: '/products/cupola#features' },
  { name: 'AI analyst', href: '/products/cupola#ai-analyst' },
  { name: 'Try it', href: '/products/cupola#quickstart' },
];

function isActive(href: string): boolean {
  if (href === '/products/cupola') {
    return currentPath === '/products/cupola' || currentPath === '/products/cupola/';
  }
  return false;
}
---

<div class="bg-white border-b border-soil-200">
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: icon + wordmark + open-source pill -->
      <a href="/products/cupola" class="flex items-center gap-3 flex-shrink-0 group">
        <img
          src="/cupola/cupola-icon-96.png"
          alt=""
          class="w-8 h-8 rounded-md object-cover"
          width="32"
          height="32"
        />
        <span class="hidden sm:flex items-center gap-2">
          <span class="font-display font-bold text-soil-900 group-hover:text-sky-700 transition-colors">Cupola</span>
          <span class="hidden md:inline rounded-full border border-emerald-300 bg-emerald-50 px-2 py-0.5 text-[11px] font-bold text-emerald-700">Open source</span>
        </span>
      </a>

      <!-- Right: tabs + launch/github -->
      <nav class="flex items-center gap-1 overflow-x-auto -mx-2 px-2 cupola-subnav-tabs" aria-label="Cupola section">
        {tabs.map(tab => (
          <a
            href={tab.href}
            class:list={[
              'whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium transition-colors',
              isActive(tab.href)
                ? 'bg-sky-50 text-sky-700'
                : 'text-soil-600 hover:text-sky-700 hover:bg-soil-50'
            ]}
            aria-current={isActive(tab.href) ? 'page' : undefined}
          >
            {tab.name}
          </a>
        ))}

        <span class="mx-1 hidden h-5 w-px bg-soil-200 sm:block"></span>

        <a
          href={CUPOLA_APP}
          target="_blank"
          rel="noopener noreferrer"
          class="whitespace-nowrap rounded-md bg-sky-600 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-sky-700"
        >
          Launch ↗
        </a>
        <a
          href={CUPOLA_REPO}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cupola on GitHub"
          title="View source on GitHub"
          class="flex items-center justify-center rounded-md p-1.5 text-soil-600 transition-colors hover:bg-soil-50 hover:text-soil-900"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
          </svg>
        </a>
      </nav>
    </div>
  </div>
</div>

<style>
  .cupola-subnav-tabs {
    scrollbar-width: none;
  }
  .cupola-subnav-tabs::-webkit-scrollbar {
    display: none;
  }
</style>
