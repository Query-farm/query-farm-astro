---
// Section bar for the Cupola area — the `.subnav` shape: sticky beneath the
// global nav, soil-100 ground, section mark + name behind a rule, then tabs.
// Cupola is a single product page, so most tabs are in-page anchors.
import { CUPOLA_APP, CUPOLA_REPO } from '../../data/cupola';

const currentPath = Astro.url.pathname;

const tabs = [
  { name: 'Overview', href: '/products/cupola' },
  { name: 'Features', href: '/products/cupola#features' },
  { name: 'AI analyst', href: '/products/cupola#ai-analyst' },
  { name: 'Try it', href: '/products/cupola#quickstart' },
];

function isActive(href: string): boolean {
  if (href === '/products/cupola') {
    return currentPath === '/products/cupola' || currentPath === '/products/cupola/';
  }
  return false;
}

const tabClass = 'whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
---

<div class="sticky z-40 border-b border-soil-300 bg-soil-100" style="top: var(--qf-nav-h)">
  <div class="section-container">
    <nav class="qf-subnav-row flex items-center overflow-x-auto" aria-label="Cupola section">
      <a
        href="/products/cupola"
        class="mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link"
      >
        <img src="/cupola/cupola-icon-96.png" alt="" aria-hidden="true" width="22" height="22" class="h-[22px] w-[22px] rounded-[4px] object-cover" />
        <span>Cupola</span>
      </a>

      {tabs.map(tab => (
        <a
          href={tab.href}
          class:list={[
            tabClass,
            isActive(tab.href) ? 'border-link text-link' : 'border-transparent text-soil-700 hover:text-soil-900'
          ]}
          aria-current={isActive(tab.href) ? 'page' : undefined}
        >
          {tab.name}
        </a>
      ))}

      <span class="ml-auto flex flex-none items-center gap-2 pl-4">
        <a
          href={CUPOLA_APP}
          target="_blank"
          rel="noopener noreferrer"
          class="whitespace-nowrap rounded-lg border border-field-700 bg-field-700 px-[15px] py-[7px] text-[12.5px] font-medium text-white no-underline transition-colors hover:bg-field-600 hover:border-field-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
        >
          Launch ↗
        </a>
        <a
          href={CUPOLA_REPO}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cupola on GitHub"
          title="View source on GitHub"
          class="flex items-center justify-center rounded-md p-1.5 text-soil-600 transition-colors hover:bg-soil-200 hover:text-soil-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.66 5.57.66 11.85c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.48 3.14-1.17 3.14-1.17.63 1.57.24 2.73.12 3.02.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.34 5.57 18.27.5 12 .5z"/>
          </svg>
        </a>
      </span>
    </nav>
  </div>
</div>

<style>
  .qf-subnav-row {
    scrollbar-width: none;
  }
  .qf-subnav-row::-webkit-scrollbar {
    display: none;
  }
</style>
