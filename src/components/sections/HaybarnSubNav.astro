---
// Section bar for the Haybarn area — the `.subnav` shape: sticky beneath the
// global nav, soil-100 ground, section mark + name behind a rule, then tabs.
import { LATEST_STATUS_URL, LATEST_RC } from '../../data/haybarn-versions';

const currentPath = Astro.url.pathname;

const tabs = [
  { name: 'Overview', href: '/haybarn' },
  { name: 'Install', href: '/haybarn/install' },
  { name: 'Security', href: '/haybarn/security' },
  { name: 'Extensions', href: '/haybarn/extensions' },
  // Status is the one version-scoped page. The link points at the latest
  // versioned URL; /haybarn/status (without a version) redirects there.
  { name: 'Status', href: LATEST_STATUS_URL, prefix: '/haybarn/status' },
  { name: 'Contribute', href: '/haybarn/community-extensions' },
  { name: 'Compatibility & FAQ', href: '/haybarn/compatibility' }
];

function isActive(tab: { href: string; prefix?: string }): boolean {
  const href = tab.href;
  if (href === '/haybarn') return currentPath === '/haybarn' || currentPath === '/haybarn/';
  // Use the optional prefix to keep the Status tab highlighted across
  // every version variant (e.g. /haybarn/status/v1.5.2 and future ones).
  if (tab.prefix) return currentPath === tab.prefix || currentPath.startsWith(tab.prefix + '/');
  return currentPath === href || currentPath === href + '/';
}

const tabClass = 'whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
---

<div class="sticky z-40 border-b border-soil-300 bg-soil-100" style="top: var(--qf-nav-h)">
  <div class="section-container">
    <nav class="qf-subnav-row flex items-center overflow-x-auto" aria-label="Haybarn section">
      <a
        href="/haybarn"
        class="mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link"
      >
        <img src="/haybarn/haybarn-logo.png" alt="" aria-hidden="true" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
        <span>Haybarn</span>
        <span class="hidden font-mono text-[10px] font-normal tracking-[0.06em] text-soil-500 md:inline">v{LATEST_RC}</span>
      </a>

      {tabs.map(tab => (
        <a
          href={tab.href}
          class:list={[
            tabClass,
            isActive(tab) ? 'border-link text-link' : 'border-transparent text-soil-700 hover:text-soil-900'
          ]}
          aria-current={isActive(tab) ? 'page' : undefined}
        >
          {tab.name}
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .qf-subnav-row {
    scrollbar-width: none;
  }
  .qf-subnav-row::-webkit-scrollbar {
    display: none;
  }
</style>
