---
import { LATEST_STATUS_URL } from '../../data/haybarn-versions';

const currentPath = Astro.url.pathname;

const tabs = [
  { name: 'Overview', href: '/haybarn' },
  { name: 'Install', href: '/haybarn/install' },
  { name: 'Extensions', href: '/haybarn/extensions' },
  // Status is the one version-scoped page. The link points at the latest
  // versioned URL; /haybarn/status (without a version) redirects there.
  { name: 'Status', href: LATEST_STATUS_URL, prefix: '/haybarn/status' },
  { name: 'Contribute', href: '/haybarn/community-extensions' },
  { name: 'Compatibility & FAQ', href: '/haybarn/compatibility' }
];

function isActive(tab: { href: string; prefix?: string }): boolean {
  const href = tab.href;
  if (href === '/haybarn') return currentPath === '/haybarn' || currentPath === '/haybarn/';
  // Use the optional prefix to keep the Status tab highlighted across
  // every version variant (e.g. /haybarn/status/v1.5.2 and future ones).
  if (tab.prefix) return currentPath === tab.prefix || currentPath.startsWith(tab.prefix + '/');
  return currentPath === href || currentPath === href + '/';
}
---

<div class="bg-white border-b border-soil-200">
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: logo + wordmark + RC pill -->
      <a href="/haybarn" class="flex items-center gap-3 flex-shrink-0 group">
        <img
          src="/haybarn/haybarn-logo.png"
          alt=""
          class="w-8 h-8 rounded-md object-contain"
          width="32"
          height="32"
        />
        <span class="hidden sm:flex items-center gap-2">
          <span class="font-display font-bold text-soil-900 group-hover:text-earth-700 transition-colors">Haybarn</span>
          <span class="hidden md:inline text-xs text-soil-500 font-mono">v1.5.2-rc13</span>
        </span>
      </a>

      <!-- Right: tabs (horizontally scrollable on narrow screens) -->
      <nav class="flex items-center gap-1 overflow-x-auto -mx-2 px-2 haybarn-subnav-tabs" aria-label="Haybarn section">
        {tabs.map(tab => (
          <a
            href={tab.href}
            class:list={[
              'whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium transition-colors',
              isActive(tab)
                ? 'bg-earth-50 text-earth-700'
                : 'text-soil-600 hover:text-earth-700 hover:bg-soil-50'
            ]}
            aria-current={isActive(tab) ? 'page' : undefined}
          >
            {tab.name}
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<style>
  .haybarn-subnav-tabs {
    scrollbar-width: none;
  }
  .haybarn-subnav-tabs::-webkit-scrollbar {
    display: none;
  }
</style>
