---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  subtitle?: string;
  primaryCTA?: { text: string; href: string };
  secondaryCTA?: { text: string; href: string };
  fullHeight?: boolean;
  /** Optional logo/mark rendered above the title. */
  logo?: { src: string; alt: string };
  class?: string;
}

const {
  title,
  subtitle,
  primaryCTA,
  secondaryCTA,
  fullHeight = false,
  logo,
  class: className = ''
} = Astro.props;

const heightClass = fullHeight ? 'min-h-[600px] lg:min-h-[700px]' : 'py-16 lg:py-24';
---

<section class={`relative bg-gradient-to-br from-soil-50 via-earth-50 to-soil-100 overflow-hidden ${heightClass} ${className}`}>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-40">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="farm-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <circle cx="50" cy="50" r="1.5" fill="currentColor" class="text-earth-300" />
          <circle cx="25" cy="75" r="1" fill="currentColor" class="text-soil-300" />
          <circle cx="75" cy="25" r="1" fill="currentColor" class="text-soil-300" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#farm-pattern)" />
    </svg>
  </div>

  <div class={`section-container relative z-10 ${fullHeight ? 'h-full flex items-center' : ''}`}>
    <div class="max-w-4xl mx-auto text-center">
      {logo && (
        <img
          src={logo.src}
          alt={logo.alt}
          class="h-20 md:h-24 w-auto mx-auto mb-6"
          width="500"
          height="500"
        />
      )}
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-soil-900 mb-6 leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="text-lg md:text-xl lg:text-2xl text-soil-700 mb-8 lg:mb-12 leading-relaxed max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}

      {(primaryCTA || secondaryCTA) && (
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          {primaryCTA && (
            <Button href={primaryCTA.href} variant="accent" size="lg">
              {primaryCTA.text}
            </Button>
          )}
          {secondaryCTA && (
            <Button href={secondaryCTA.href} variant="secondary" size="lg">
              {secondaryCTA.text}
            </Button>
          )}
        </div>
      )}

      <slot />
    </div>
  </div>

  <!-- Bottom Wave Decoration -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white" fill-opacity="0.5"/>
    </svg>
  </div>
</section>
