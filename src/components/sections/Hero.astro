---
import Button from '../ui/Button.astro';

/**
 * Hero — the opening block for section landings and utility pages.
 *
 * Paper ground only. The stage bands are a homepage device (DESIGN_BRIEF §5);
 * the most a hero may carry is the 5px hairband, and only when the page family
 * calls for it — hence `hairband`, off by default.
 */
interface Props {
  title: string;
  subtitle?: string;
  primaryCTA?: { text: string; href: string };
  secondaryCTA?: { text: string; href: string };
  fullHeight?: boolean;
  /** Optional logo/mark rendered above the title. */
  logo?: { src: string; alt: string };
  /** Mono eyebrow above the title. */
  eyebrow?: string;
  /** Render the six-colour hairband beneath the hero (families B, D, F). */
  hairband?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  primaryCTA,
  secondaryCTA,
  fullHeight = false,
  logo,
  eyebrow,
  hairband = false,
  class: className = ''
} = Astro.props;

const heightClass = fullHeight ? 'min-h-[560px] lg:min-h-[640px]' : 'py-16 lg:py-24';
---

<section
  class:list={[
    'relative border-b border-soil-300 bg-gradient-to-b from-[#faf7ef] to-soil-50',
    heightClass,
    className
  ]}
>
  <div class:list={['section-container relative z-10', fullHeight && 'flex h-full items-center py-16']}>
    <div class="mx-auto max-w-3xl text-center">
      {logo && (
        <img
          src={logo.src}
          alt={logo.alt}
          class="mx-auto mb-6 h-20 w-auto md:h-24"
          width="500"
          height="500"
        />
      )}

      {eyebrow && <p class="qf-eyebrow mb-4 text-sun-700">{eyebrow}</p>}

      <h1 class="mb-6 text-[clamp(2.35rem,5.8vw,4.4rem)] leading-[1.02] tracking-[-0.03em] text-soil-900">
        {title}
      </h1>

      {subtitle && (
        <p class="mx-auto mb-8 max-w-[58ch] text-[17.5px] text-soil-700 md:text-[19px] lg:mb-12">
          {subtitle}
        </p>
      )}

      {(primaryCTA || secondaryCTA) && (
        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          {primaryCTA && (
            <Button href={primaryCTA.href} variant="primary" size="lg">
              {primaryCTA.text}
            </Button>
          )}
          {secondaryCTA && (
            <Button href={secondaryCTA.href} variant="secondary" size="lg">
              {secondaryCTA.text}
            </Button>
          )}
        </div>
      )}

      <slot />
    </div>
  </div>
</section>

{hairband && (
  <div class="hairband" aria-hidden="true">
    <i class="block bg-pipe-1"></i>
    <i class="block bg-pipe-2"></i>
    <i class="block bg-pipe-3"></i>
    <i class="block bg-pipe-4"></i>
    <i class="block bg-pipe-5"></i>
    <i class="block bg-pipe-6"></i>
  </div>
)}
