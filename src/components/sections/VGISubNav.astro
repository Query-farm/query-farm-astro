---
// Section subnav for the VGI area, styled to match HaybarnSubNav: a white,
// sticky bar with the VGI logo + wordmark on the left and the section's pages
// as earth-toned pill tabs on the right. Sticks below the global header so the
// in-section navigation stays available while scrolling long pages.
const currentPath = Astro.url.pathname;

const tabs = [
  { name: 'Overview', href: '/vgi' },
  { name: 'Getting Started', href: '/vgi/getting-started' },
  { name: 'Building a Worker', href: '/vgi/building-a-worker' },
  { name: 'Architecture', href: '/vgi/architecture' },
  { name: 'Languages', href: '/vgi/languages' }
];

function isActive(tab: { href: string }): boolean {
  const href = tab.href;
  // Overview is the section root — match it exactly so it isn't highlighted on
  // every /vgi/* page.
  if (href === '/vgi') return currentPath === '/vgi' || currentPath === '/vgi/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<div class="sticky top-16 lg:top-20 z-40 bg-white border-b border-soil-200">
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: logo + wordmark -->
      <a href="/vgi" class="flex items-center gap-3 flex-shrink-0 group">
        <img
          src="/vgi/vgi-logo.png"
          alt=""
          class="w-8 h-8 rounded-md object-contain"
          width="32"
          height="32"
        />
        <span class="hidden sm:flex items-center gap-2">
          <span class="font-display font-bold text-soil-900 group-hover:text-earth-700 transition-colors">VGI</span>
          <span class="hidden md:inline text-xs text-soil-500">Vector Gateway Interface</span>
        </span>
      </a>

      <!-- Right: section tabs (horizontally scrollable on narrow screens) -->
      <nav class="flex items-center gap-1 overflow-x-auto -mx-2 px-2 vgi-subnav-tabs" aria-label="VGI section">
        {tabs.map(tab => (
          <a
            href={tab.href}
            class:list={[
              'whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium transition-colors',
              isActive(tab)
                ? 'bg-earth-50 text-earth-700'
                : 'text-soil-600 hover:text-earth-700 hover:bg-soil-50'
            ]}
            aria-current={isActive(tab) ? 'page' : undefined}
          >
            {tab.name}
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<style>
  .vgi-subnav-tabs {
    scrollbar-width: none;
  }
  .vgi-subnav-tabs::-webkit-scrollbar {
    display: none;
  }
</style>
