---
// Section bar for the DuckDB Extensions area, styled to match HaybarnSubNav:
// a white bar with the DuckDB logo + "DuckDB Extensions" wordmark on the left,
// followed by the current extension as an earth-toned pill. Replaces the
// generic gray breadcrumb on the extensions index and detail pages.
//
// Pass the same breadcrumb array PageLayout would have received; the trailing
// crumb (the current extension) is shown after the wordmark, unless it's the
// section index itself (then the wordmark alone represents the page).
//
// `highlightLoads` surfaces the site-wide annualized extension-load run-rate as
// a badge on the right (same style as the per-card "loads" badge) — used on the
// index page as a proof point.
import { usageSummary } from '../../data/usage-summary';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  breadcrumbs?: Crumb[];
  highlightLoads?: boolean;
}
const { breadcrumbs = [], highlightLoads = false } = Astro.props;

const SECTION = '/products/extensions';
const norm = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);

const last = breadcrumbs[breadcrumbs.length - 1];
const current = last && norm(last.href) !== SECTION ? last.name : null;

const compactCount = (n: number): string => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(n >= 10_000 ? 0 : 1)}K`;
  return String(n);
};
const annualLoads = usageSummary?.annualizedLoads;
const showLoads = highlightLoads && typeof annualLoads === 'number';
---

<div class="sticky top-16 lg:top-20 z-40 bg-white border-b border-soil-200">
  <div class="section-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <!-- Left: DuckDB logo + section wordmark + current extension -->
      <div class="flex items-center gap-2 min-w-0 overflow-x-auto ext-subnav-bar">
        <a href="/products/extensions" class="flex items-center gap-3 flex-shrink-0 group">
          <img
            src="/images/duckdb-icon.svg"
            alt=""
            class="w-8 h-8 rounded-md"
            width="32"
            height="32"
          />
          <span class="font-display font-bold text-soil-900 group-hover:text-earth-700 transition-colors whitespace-nowrap">
            DuckDB Extensions
          </span>
        </a>

        {current && (
          <>
            <svg class="w-4 h-4 text-soil-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span
              class="whitespace-nowrap px-3 py-1.5 rounded-md text-sm font-medium bg-earth-50 text-earth-700"
              aria-current="page"
            >
              {current}
            </span>
          </>
        )}
      </div>

      <!-- Right: annualized load count (proof point) -->
      {showLoads && (
        <span class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gradient-to-r from-harvest-100 to-grain-100 text-harvest-800 text-sm font-medium ring-1 ring-harvest-200">
          <svg class="w-4 h-4 text-harvest-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <strong class="font-bold tabular-nums">{compactCount(annualLoads as number)}+</strong>
          <span class="hidden sm:inline text-harvest-700/80">loads a year</span>
          <span class="sm:hidden text-harvest-700/80">loads/yr</span>
        </span>
      )}
    </div>
  </div>
</div>

<style>
  .ext-subnav-bar {
    scrollbar-width: none;
  }
  .ext-subnav-bar::-webkit-scrollbar {
    display: none;
  }
</style>
