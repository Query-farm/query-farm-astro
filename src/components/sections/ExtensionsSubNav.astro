---
// Section bar for the DuckDB Extensions area — the `.subnav` shape from the
// Strata Sun system: sticky beneath the global nav, soil-100 ground, the
// section mark + name on the left behind a rule, then tabs.
//
// Pass the same breadcrumb array PageLayout would have received; the trailing
// crumb (the current extension) becomes the active tab, unless it's the section
// index itself (then "All extensions" is active).
//

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  breadcrumbs?: Crumb[];
  /**
   * Which container to sit in. Defaults to `narrow` — `.section-container`, the
   * same one Header.astro uses — so the section mark lands directly beneath the
   * Query.Farm logotype, which is what the Haybarn and VGI bars do. That anchor
   * is the global nav, not the page body: the two Extensions pages lay out at
   * different widths (1360 catalog, 1200 docs), so aligning to the content
   * instead would make the bar jump when you move between them.
   */
  layout?: 'catalog' | 'docs' | 'narrow';
}
const { breadcrumbs = [], layout = 'narrow' } = Astro.props;

const CONTAINER = {
  catalog: 'mx-auto w-full max-w-[1360px] px-5 sm:px-7',
  docs: 'mx-auto w-full max-w-[1200px] px-5 sm:px-7',
  narrow: 'section-container',
} as const;

const SECTION = '/products/extensions';
const norm = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);

const last = breadcrumbs[breadcrumbs.length - 1];
const current = last && norm(last.href) !== SECTION ? last.name : null;


const tab = 'whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
const tabIdle = 'border-transparent text-soil-700 hover:text-soil-900';
const tabActive = 'border-link text-link';
---

<div class="sticky z-40 border-b border-soil-300 bg-soil-100" style="top: var(--qf-nav-h)">
  <div class={CONTAINER[layout]}>
    <div class="qf-subnav-row flex flex-wrap items-center">
      <a
        href="/products/extensions"
        class="mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link"
      >
        <img src="/images/duckdb-icon.svg" alt="" aria-hidden="true" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
        DuckDB Extensions
      </a>

      <a
        href="/products/extensions"
        class:list={[tab, current ? tabIdle : tabActive, current && 'qf-all-tab']}
        aria-current={current ? undefined : 'page'}
      >
        All extensions
      </a>

      {current && (
        <>
          <svg
            class="h-3.5 w-3.5 flex-none text-soil-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
          <span class:list={[tab, tabActive, 'qf-current-tab']} aria-current="page">{current}</span>
        </>
      )}

    </div>
  </div>
</div>

<style>
  @media (max-width: 479px) {
    .qf-all-tab:has(+ svg) {
      display: none;
    }
  }
</style>
