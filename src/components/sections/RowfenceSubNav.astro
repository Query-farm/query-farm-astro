---
// Section bar for the Rowfence product page — the `.subnav` shape: sticky
// beneath the global nav, soil-100 ground, section mark + name behind a
// rule, then tabs. Like Cupola, Rowfence is a single product page today, so
// tabs are in-page anchors rather than separate routes. Unlike Cupola,
// there's no self-serve "Launch" — the primary action is always contact,
// since this is sold hosted or on-prem, not something you spin up yourself.
const currentPath = Astro.url.pathname;

const tabs = [
  { name: 'Overview', href: '/products/rowfence' },
  { name: 'Features', href: '/products/rowfence#features' },
  { name: 'Scenarios', href: '/products/rowfence#scenarios' },
  { name: 'Deployment', href: '/products/rowfence#deployment' },
  { name: 'Compare', href: '/products/rowfence#compare' },
];

function isActive(href: string): boolean {
  if (href === '/products/rowfence') {
    return currentPath === '/products/rowfence' || currentPath === '/products/rowfence/';
  }
  return false;
}

const tabClass = 'whitespace-nowrap border-b-2 px-3.5 py-[11px] text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-link';
---

<div class="sticky z-40 border-b border-soil-300 bg-soil-100" style="top: var(--qf-nav-h)">
  <div class="section-container">
    <nav class="qf-subnav-row flex flex-wrap items-center" aria-label="Rowfence section">
      <a
        href="/products/rowfence"
        class="mr-1.5 flex flex-none items-center gap-[9px] whitespace-nowrap border-r border-soil-300 py-[11px] pr-[18px] font-display text-[17px] font-semibold tracking-[-0.018em] text-soil-900 no-underline transition-colors hover:text-link"
      >
        <img src="/rowfence/rowfence-icon.svg" alt="" aria-hidden="true" width="26" height="26" class="h-[26px] w-[26px] object-contain" />
        <span>Rowfence</span>
      </a>

      {tabs.map(tab => (
        <a
          href={tab.href}
          class:list={[
            tabClass,
            isActive(tab.href) ? 'border-link text-link' : 'border-transparent text-soil-700 hover:text-soil-900'
          ]}
          aria-current={isActive(tab.href) ? 'page' : undefined}
        >
          {tab.name}
        </a>
      ))}

      <span class="ml-auto flex flex-none items-center pl-4">
        <a
          href="/company/contact"
          class="whitespace-nowrap rounded-lg border border-field-700 bg-field-700 px-[15px] py-[7px] text-[12.5px] font-medium text-white no-underline transition-colors hover:bg-field-600 hover:border-field-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
        >
          Talk to us →
        </a>
      </span>
    </nav>
  </div>
</div>
