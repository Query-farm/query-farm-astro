---
import SectionSubNav from './SectionSubNav.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { name: 'Overview', href: '/products/rowfence', active: path === '/products/rowfence' },
  { name: 'Features', href: '/products/rowfence#features' },
  { name: 'Scenarios', href: '/products/rowfence#scenarios' },
  { name: 'Deployment', href: '/products/rowfence#deployment' },
  { name: 'Compare', href: '/products/rowfence#compare' },
];
---

<SectionSubNav name="Rowfence" href="/products/rowfence" tabs={tabs}>
  <img slot="icon" src="/rowfence/rowfence-icon.svg" alt="" aria-hidden="true" width="26" height="26" class="h-[26px] w-[26px] object-contain" />
  <a slot="action" href="/company/contact" class="whitespace-nowrap rounded-lg border border-field-700 bg-field-700 px-[15px] py-[7px] text-[12.5px] font-medium text-white no-underline transition-colors hover:bg-field-600 hover:border-field-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link">Talk to us →</a>
</SectionSubNav>
