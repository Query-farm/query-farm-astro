---
import SectionSubNav from './SectionSubNav.astro';
import { crossfieldRoot, crossfieldDocs, crossfieldPages } from '../../data/crossfield';

const current = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { name: 'Overview', href: crossfieldRoot, active: current === crossfieldRoot },
  { name: 'How it works', href: `${crossfieldRoot}/how-it-works`, active: ['how-it-works', 'ossie', 'engine'].some(page => current === `${crossfieldRoot}/${page}`), items: [
    { name: 'How it works', href: `${crossfieldRoot}/how-it-works` },
    { name: 'Apache Ossie', href: `${crossfieldRoot}/ossie` },
    { name: 'Inside the engine', href: `${crossfieldRoot}/engine` },
  ] },
  { name: 'For AI agents', href: `${crossfieldRoot}/agents`, active: current === `${crossfieldRoot}/agents` },
  {
    name: 'Documentation', href: crossfieldDocs, active: current.startsWith(crossfieldDocs),
    items: crossfieldPages.map(page => ({ name: page.title, href: page.href })),
  },
];
---

<SectionSubNav name="Crossfield" href={crossfieldRoot} tabs={tabs} compactOnMobile>
  <img slot="icon" src="/crossfield/crossfield-mark.svg" alt="" width="26" height="26" />
  <a slot="action" href="/company/contact" class="hidden whitespace-nowrap text-sm text-link underline underline-offset-4 md:inline">Talk to Query.Farm →</a>
</SectionSubNav>
