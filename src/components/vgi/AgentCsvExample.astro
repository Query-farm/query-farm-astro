---
import story from '../../data/vgi-agent-story.json';
import CodeBlock from '../ui/CodeBlock.astro';
import { vgiSkillsFile } from '../../lib/vgi-agents';
interface Props { heading?: boolean; }
const { heading = true } = Astro.props;
---
<div class="csv-example not-prose" data-csv-example>
  {heading && <><p class="qf-eyebrow text-sun-700">One function. A whole column.</p><h2>Now give it your article titles.</h2></>}
  <p>The first query proves the function works. But you have a file of titles to prepare. Use the same worker on the CSV’s <code>title</code> column:</p>
  <CodeBlock code={story.csv.sql + ';'} lang="sql" tryable={false} />
  <div class="table-wrap"><table aria-label="Article titles and verified slugs"><thead><tr><th scope="col">title</th><th scope="col">slug</th></tr></thead><tbody>{story.csv.rows.map(row => <tr><td>{row[0]}</td><td><code>{row[1]}</code></td></tr>)}</tbody></table></div>
  <p class="csv-note">Actual results from stock DuckDB {story.engine}. This CSV example was added after the recorded build; the generated worker is unchanged. Slugs are candidates—your application still handles uniqueness and routing.</p>
  <div class="csv-links"><a href="/vgi/agents/articles.csv" download>Download the CSV</a><a href={vgiSkillsFile('examples/agent-duckdb-typescript-slugify/README.md')}>Get the worker and rerun the tests →</a></div>
</div>
<style>
  .csv-example { color:var(--color-soil-900); max-width:85ch; }.csv-example h2 { font-size:clamp(1.65rem,3vw,2.1rem); margin:.6rem 0 1rem; line-height:1.3; }.csv-example p { font-size:.95rem; line-height:1.8; margin:1rem 0; }.table-wrap { overflow-x:auto; border:1px solid var(--color-soil-300); border-radius:.6rem; margin:1.2rem 0; }table { width:100%; border-collapse:collapse; text-align:left; font-size:.86rem; }th,td { padding:.85rem 1rem; }th { font-weight:600; background:var(--color-soil-100); }td { border-top:1px solid var(--color-soil-300); }td code { font-size:.83em; }.csv-example .csv-note { font-size:.77rem; color:var(--color-soil-600); }.csv-links { display:flex; gap:1.3rem; flex-wrap:wrap; font-size:.8rem; }.csv-links a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; }
</style>
