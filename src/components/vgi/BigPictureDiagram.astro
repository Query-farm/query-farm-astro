// transform placing a viewBox-relative icon's own origin at (0,0), scaled to
// `size`, then positioned so it's centered at (cx, cy) on the diagram canvas.
const iconTransform = (vb: { x: number; y: number; w: number; h: number }, size: number, cx: number, cy: number) => {
  const s = size / vb.w;
  const tx = cx - (vb.w / 2) * s - vb.x * s;
  const ty = cy - (vb.h / 2) * s - vb.y * s;
  return `translate(${tx.toFixed(2)},${ty.toFixed(2)}) scale(${s.toFixed(5)})`;
};

// ── Sources (fan in from one side). All four rotate through the same shared
// pool of real systems, each starting at a different offset (a quarter of
// the pool apart) so the four boxes never show the same brand at once, and
// together cycle through every entry in the pool over time.
const SOURCE_COUNT = 4;
const sourceStarts = Array.from({ length: SOURCE_COUNT }, (_, i) =>
  Math.round((i * ROTATING_SOURCES.length) / SOURCE_COUNT),
);

// Vertical rhythm derived from the source count, not hand-placed per item.
const BOX_H = 52;
const BOX_GAP = 40;
const MARGIN_Y = 40;
const contentH = SOURCE_COUNT * BOX_H + (SOURCE_COUNT - 1) * BOX_GAP;
const VB_H = contentH + MARGIN_Y * 2;
const centerY = VB_H / 2;
const sourceRows = sourceStarts.map((startIndex, i) => ({
  startIndex,
  cy: MARGIN_Y + BOX_H / 2 + i * (BOX_H + BOX_GAP),
}));

const SRC_X = 30;
const BOX_W = 210;
const ICON_S = 20;
const ICON_PAD = 12;
const TEXT_GAP = 8;
// Both relative to a box's own left edge, so they're correct whichever side
// rectX() puts that edge on.
const ICON_CENTER_OFFSET = ICON_PAD + ICON_S / 2;
const TEXT_OFFSET = ICON_PAD + ICON_S + TEXT_GAP;

const fanWires = sourceRows.map((s, i) => ({
  id: `vgi-wire-${flip ? 'r' : 'f'}-${i}`,
  d: `M${mx(SRC_X + BOX_W)} ${s.cy} C ${mx(312)} ${s.cy} ${mx(330)} ${centerY} ${mx(400)} ${centerY}`,
  begin: `${(i * 0.45).toFixed(2)}s`,
  revBegin: `${(i * 0.45 + 0.9).toFixed(2)}s`,
}));
const mainWireId = `vgi-wire-main-${flip ? 'r' : 'f'}`;

// The VGI extension box (center — symmetric about the viewBox, so it never
// moves) grew tall to fit a large VGI logo above its existing three text
// lines. DuckDB shrank: it no longer names Haybarn, just DuckDB + the mark.
const GW_X = 400;
const GW_W = 200;
const GW_H = 255;
const GW_Y = centerY - GW_H / 2;
const LOGO_W = 170;
const LOGO_H = Math.round((LOGO_W * 437) / 600); // vgi-logo.png's real aspect ratio
const LOGO_X = GW_X + (GW_W - LOGO_W) / 2;
const LOGO_Y = GW_Y + 14;

const DDB_X = rectX(760, 210);
const DDB_W = 210;
const DDB_H = 130;
const DDB_Y = centerY - DDB_H / 2;
const ddbCenterX = mx(865);

// The wire always reaches whichever DuckDB edge faces the gateway — derived
// from DDB_X/DDB_W rather than a second literal that would only coincidentally
// match it (source and DuckDB boxes are equal width, so it's tempting to
// reuse the raw "760", but that fact shouldn't have to be re-derived by eye
// every time either box's width changes).
const mainWireD = `M${mx(600)} ${centerY} L${flip ? DDB_X + DDB_W : DDB_X} ${centerY}`;

const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
---

<div class={`${CARD} p-4 md:p-6`}>
  <div class="flex flex-col items-center sm:hidden" role="img" aria-label={ariaLabel}>
    <div class="inline-flex items-center gap-2 rounded-lg border border-soil-900 bg-soil-100 px-4 py-2.5 font-semibold text-soil-900">
      <img src="/vgi/icons/duckdb-mark.svg" alt="" aria-hidden="true" class="h-7 w-7" />
      <span>DuckDB</span>
    </div>

    <div class="flex flex-col items-center py-2" aria-hidden="true">
      <span class="h-4 w-px bg-soil-400"></span>
      <span class="rounded-full bg-sun-200 px-2.5 py-1 font-mono text-[11px] font-semibold text-sun-800">Arrow IPC</span>
      <span class="h-4 w-px bg-soil-400"></span>
    </div>

    <div class="w-full rounded-xl border-2 border-soil-900 bg-[#fffdf7] px-4 py-3 text-center">
      <img src="/vgi/vgi-logo.webp" alt="" aria-hidden="true" class="mx-auto h-auto w-24" />
      <p class="mt-1 text-[12px] font-semibold tracking-[0.08em] text-sun-700">VGI EXTENSION</p>
      <p class="mt-1 font-display text-xl font-semibold text-soil-900">One protocol</p>
      <p class="text-[12.5px] text-soil-600">over pipes, sockets, shared memory, or HTTP</p>
    </div>

    <div class="flex flex-col items-center py-2" aria-hidden="true">
      <span class="h-5 w-px bg-soil-400"></span>
      <span class="text-lg leading-none text-sun-700">↕</span>
    </div>

    <div class="w-full">
      <p class="mb-2 text-center text-[12px] font-semibold text-soil-600">YOUR SYSTEMS, DATA, AND CODE</p>
      <div class="grid grid-cols-2 gap-2 text-center text-[13px] font-medium text-soil-800">
        <span class="rounded-lg border border-soil-300 bg-white px-2 py-2">APIs &amp; services</span>
        <span class="rounded-lg border border-soil-300 bg-white px-2 py-2">Models &amp; libraries</span>
        <span class="rounded-lg border border-soil-300 bg-white px-2 py-2">Streams &amp; events</span>
        <span class="rounded-lg border border-soil-300 bg-white px-2 py-2">Legacy data</span>
      </div>
    </div>
  </div>

  <svg
    class="vgi-flow hidden h-auto w-full sm:block"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    role="img"
    aria-label={ariaLabel}
  >
    <!-- Wires (drawn first, under the nodes) -->
    {fanWires.map(w => (
      <path id={w.id} d={w.d} fill="none" class="stroke-soil-300" stroke-width="2.5" />
    ))}
    <path id={mainWireId} d={mainWireD} fill="none" class="stroke-soil-300" stroke-width="2.5" />

    <!-- Flow packets: response (→ DuckDB) and request (→ worker) -->
    {fanWires.map(w => (
      <>
        <circle r="5.5" class="fill-sun-500">
          <animateMotion dur="2.6s" repeatCount="indefinite" begin={w.begin}>
            <mpath xlink:href={`#${w.id}`} />
          </animateMotion>
        </circle>
        <circle r="4" class="fill-field-600">
          <animateMotion dur="3s" repeatCount="indefinite" begin={w.revBegin} keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath xlink:href={`#${w.id}`} />
          </animateMotion>
        </circle>
      </>
    ))}
    <circle r="6" class="fill-sun-400">
      <animateMotion dur="1.8s" repeatCount="indefinite" begin="0.3s">
        <mpath xlink:href={`#${mainWireId}`} />
      </animateMotion>
    </circle>
    <circle r="4.5" class="fill-field-600">
      <animateMotion dur="2.2s" repeatCount="indefinite" begin="1s" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
        <mpath xlink:href={`#${mainWireId}`} />
      </animateMotion>
    </circle>

    <!-- Source nodes — every box rotates through ROTATING_SOURCES, each
         starting `startIndex` entries into the shared pool. -->
    {sourceRows.map((s, i) => {
      const boxLeft = rectX(SRC_X, BOX_W);
      const iconCx = boxLeft + ICON_CENTER_OFFSET;
      return (
        <g>
          <rect x={boxLeft} y={s.cy - BOX_H / 2} width={BOX_W} height={BOX_H} rx="12" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2.5" />
          <g id={`vgi-rotator-${flip ? 'r' : 'f'}-${i}`} data-interval="4200">
            {ROTATING_SOURCES.map((r, ri) => (
              <g class="vgi-rotator-frame" data-active={ri === s.startIndex ? 'true' : 'false'}>
                <g class="text-soil-700" transform={iconTransform(SI_VB, ICON_S, iconCx, s.cy)} set:html={r.body} />
                <text x={boxLeft + TEXT_OFFSET} y={s.cy + 5} text-anchor="start" class="fill-soil-900 font-bold" font-size="14" font-family="inherit">{r.name}</text>
              </g>
            ))}
          </g>
        </g>
      );
    })}

    <!-- VGI extension -->
    <rect x={GW_X} y={GW_Y} width={GW_W} height={GW_H} rx="18" class="fill-[#fffdf7] stroke-soil-900" stroke-width="3" />
    <image href="/vgi/vgi-logo.png" x={LOGO_X} y={LOGO_Y} width={LOGO_W} height={LOGO_H} />
    <text x="500" y={GW_Y + 164} text-anchor="middle" class="fill-sun-700 font-bold" font-size="14" font-family="inherit" letter-spacing="1.5">VGI EXTENSION</text>
    <text x="500" y={GW_Y + 204} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="32" font-family="inherit">Arrow IPC</text>
    <text x="500" y={GW_Y + 225} text-anchor="middle" class="fill-soil-700 font-bold" font-size="15" font-family="inherit">over any transport</text>

    <!-- DuckDB -->
    <rect x={DDB_X} y={DDB_Y} width={DDB_W} height={DDB_H} rx="18" class="fill-soil-100 stroke-soil-900" stroke-width="3" />
    <g transform={iconTransform(DUCKDB_MARK.vb, 46, ddbCenterX, DDB_Y + 41)} set:html={DUCKDB_MARK.body} />
    <text x={ddbCenterX} y={DDB_Y + 104} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="30" font-family="inherit">DuckDB</text>
  </svg>
</div>

<style>
  .vgi-rotator-frame {
    opacity: 0;
    transition: opacity 700ms ease;
  }
  .vgi-rotator-frame[data-active='true'] {
    opacity: 1;
  }
</style>

<script>
  // Respect reduced-motion: pause the SMIL packet animations and freeze the
  // rotators on their first frame. Runs once per page regardless of how many
  // BigPictureDiagram instances it renders — Astro dedupes identical inline
  // <script> bodies within a page.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    document.querySelectorAll('svg.vgi-flow').forEach((s) => {
      const svg = s as SVGSVGElement & { pauseAnimations?: () => void };
      svg.pauseAnimations?.();
    });
  } else {
    // Four independent rotators now, not one — staggering each one's first
    // tick (rather than starting all four on the same setInterval instant)
    // makes them ripple across the boxes instead of snapping in unison.
    document.querySelectorAll<SVGGElement>('[id^="vgi-rotator-"]').forEach((rotator, slotIndex) => {
      const frames = Array.from(rotator.querySelectorAll<SVGGElement>('.vgi-rotator-frame'));
      if (frames.length < 2) return;
      const interval = Number(rotator.dataset.interval) || 4200;
      let active = frames.findIndex((f) => f.dataset.active === 'true');
      if (active < 0) active = 0;
      setTimeout(() => {
        setInterval(() => {
          frames[active].dataset.active = 'false';
          active = (active + 1) % frames.length;
          frames[active].dataset.active = 'true';
        }, interval);
      }, slotIndex * 700);
    });
  }
</script>
