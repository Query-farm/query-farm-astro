    <path fill="#fff100" d="M474.2,152.2h-32.8v49.5h32.8c13.7,0,24.9-11.3,24.9-24.9S487.9,152.2,474.2,152.2"/>
    <path fill="#fff100" d="M280.7,177.1c0,38.2,31.1,69.3,69.3,69.3c38.2,0,69.3-31.1,69.3-69.3s-31.1-69.3-69.3-69.3 C311.8,107.8,280.7,138.9,280.7,177.1L280.7,177.1"/>
  `,
};

// ── Rotating sources: real systems, cycling through all four source
// positions. Marks from @iconify-json/simple-icons, normalized to
// currentColor rather than each brand's own hue — a dozen different colors
// flashing through four boxes would look chaotic; consistent ink keeps them
// feeling like one coherent set rather than four unrelated logos.
