---
/**
 * The animated flow diagram — sources fanning into the VGI extension, then a
 * single wire into DuckDB. Shared between /vgi and /vgi/architecture, both of
 * which pass `flip` — the reading order that stuck is DuckDB-first, with the
 * sources fanning in from the right. `flip` mirrors the whole geometry
 * left-to-right; the unflipped default is the original orientation, kept
 * because the mirror is what makes both directions provably consistent.
 *
 * All x-coordinates route through `mx()`/`rectX()` rather than existing as a
 * second hand-written copy — the two orientations must stay exact mirrors of
 * each other, and a duplicated literal set is how that quietly drifts.
 *
 * Vertical layout is derived from `sources.length` rather than hardcoded, so
 * adding/removing a source recomputes spacing and the viewBox height instead
 * of needing hand-tuned coordinates.
 *
 * The fourth source is a rotating slot: several real, recognizable systems
 * cycle through the same icon+label position (plain CSS opacity transition +
 * a setInterval — no animation library; see the code-review note on this
 * page for why one wasn't worth adding for this).
 */
interface Props {
  /** Mirror horizontally: DuckDB on the left, sources fanning in from the right. */
  flip?: boolean;
  ariaLabel?: string;
}

const {
  flip = false,
  ariaLabel = 'Animated diagram: external systems connect through the VGI extension to a DuckDB SQL session.',
} = Astro.props;

const VB_W = 1000;

// Mirror a point x-coordinate about the viewBox's horizontal center.
const mx = (x: number) => (flip ? VB_W - x : x);
// Mirror a rect's left-edge x, accounting for width (the right edge is what
// actually mirrors to `mx()`).
const rectX = (x: number, w: number) => (flip ? VB_W - x - w : x);

// ── The DuckDB mark — real brand colors, never re-tinted ──
const DUCKDB_MARK = {
  vb: { x: 217.6, y: 10, w: 334.4, h: 334.4 },
  body: `
