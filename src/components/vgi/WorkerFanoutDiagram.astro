---
/**
 * The parallelism story on each side of "local vs. distributed," paired
 * with connect-to-a-worker.astro's local/distributed paragraphs. Both
 * variants share the same shape — one DuckDB on the left, three worker
 * processes stacked on the right — because the underlying idea is the same
 * one (a single query can fan out across more than one worker process for
 * throughput); only what sits between them differs. `local` wires DuckDB
 * directly to each subprocess it spawned itself. `distributed` puts a load
 * balancer in between: DuckDB only ever sees one HTTP endpoint, and the
 * balancer is what's actually routing across replicas behind it.
 */
interface Props {
  variant: 'local' | 'distributed';
}
const { variant } = Astro.props;

const DUCKDB_MARK = {
  vb: { x: 217.6, y: 10, w: 334.4, h: 334.4 },
  body: `
    <path fill="#000" d="M384.8,344.4L384.8,344.4c-92.5,0-167.2-74.7-167.2-167.2l0,0C217.6,84.7,292.3,10,384.8,10l0,0 C477.3,10,552,84.7,552,177.2l0,0C552,269.6,477.3,344.4,384.8,344.4z"/>
    <path fill="#fff100" d="M474.2,152.2h-32.8v49.5h32.8c13.7,0,24.9-11.3,24.9-24.9S487.9,152.2,474.2,152.2"/>
    <path fill="#fff100" d="M280.7,177.1c0,38.2,31.1,69.3,69.3,69.3c38.2,0,69.3-31.1,69.3-69.3s-31.1-69.3-69.3-69.3 C311.8,107.8,280.7,138.9,280.7,177.1L280.7,177.1"/>
  `,
};
const ICON_VB = { x: 0, y: 0, w: 256, h: 256 };
const CUBE_BODY =
  '<path fill="currentColor" d="m223.68 66.15l-88-48.15a15.88 15.88 0 0 0-15.36 0l-88 48.17a16 16 0 0 0-8.32 14v95.64a16 16 0 0 0 8.32 14l88 48.17a15.88 15.88 0 0 0 15.36 0l88-48.17a16 16 0 0 0 8.32-14V80.18a16 16 0 0 0-8.32-14.03M128 32l80.34 44L128 120L47.66 76ZM40 90l80 43.78v85.79l-80-43.75Zm96 129.57v-85.75L216 90v85.78Z"/>';
// Phosphor "git-fork" — a single line splitting into branches, standing in
// for a load balancer routing one incoming connection across N backends.
const FORK_BODY =
  '<path fill="currentColor" d="M224 64a32 32 0 1 0-40 31v17a8 8 0 0 1-8 8H80a8 8 0 0 1-8-8V95a32 32 0 1 0-16 0v17a24 24 0 0 0 24 24h40v25a32 32 0 1 0 16 0v-25h40a24 24 0 0 0 24-24V95a32.06 32.06 0 0 0 24-31M48 64a16 16 0 1 1 16 16a16 16 0 0 1-16-16m96 128a16 16 0 1 1-16-16a16 16 0 0 1 16 16m48-112a16 16 0 1 1 16-16a16 16 0 0 1-16 16"/>';

const iconTransform = (vb: { x: number; y: number; w: number; h: number }, size: number, cx: number, cy: number) => {
  const s = size / vb.w;
  const tx = cx - (vb.w / 2) * s - vb.x * s;
  const ty = cy - (vb.h / 2) * s - vb.y * s;
  return `translate(${tx.toFixed(2)},${ty.toFixed(2)}) scale(${s.toFixed(5)})`;
};

// ── Fixed geometry — DuckDB left, three workers stacked right, identical
// in both variants; only the middle (nothing, or a load balancer) differs.
const DDB_W = 150, DDB_H = 90;
const WRK_W = 150, WRK_H = 56;
const WRK_Y = [20, 94, 168];
const DDB_X = 20;
const ddbCenterY = (WRK_Y[0] + WRK_Y[2] + WRK_H) / 2;
const ddbCy = ddbCenterY;
const ddbCx = DDB_X + DDB_W / 2;

const LB_W = 110, LB_H = 70;

const isDistributed = variant === 'distributed';
const WRK_X = isDistributed ? 460 : 310;
const LB_X = 260;
const lbCy = ddbCenterY;
const lbCx = LB_X + LB_W / 2;

const VB_W = WRK_X + WRK_W + 20;
const VB_H = WRK_Y[2] + WRK_H + 20;

const workers = WRK_Y.map(y => ({
  y,
  cy: y + WRK_H / 2,
}));

const ariaLabel = isDistributed
  ? 'Diagram: DuckDB connects over HTTP to a load balancer, which routes the request across three worker replicas behind it.'
  : 'Diagram: DuckDB spawns and connects directly to three local worker processes in parallel.';
---

<div class="rounded-xl border border-soil-300 bg-[#fffdf7] p-4">
  <svg
    class="w-full h-auto"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={ariaLabel}
  >
    {isDistributed ? (
      <>
        <path d={`M${DDB_X + DDB_W} ${ddbCy} L${LB_X} ${lbCy}`} fill="none" class="stroke-soil-300" stroke-width="2.5" />
        <text x={(DDB_X + DDB_W + LB_X) / 2} y={ddbCy - 12} text-anchor="middle" class="fill-soil-500 font-bold" font-size="11" font-family="inherit">HTTP</text>
        {workers.map(w => (
          <path d={`M${LB_X + LB_W} ${lbCy} L${WRK_X} ${w.cy}`} fill="none" class="stroke-soil-300" stroke-width="2" />
        ))}
      </>
    ) : (
      workers.map(w => (
        <path d={`M${DDB_X + DDB_W} ${ddbCy} L${WRK_X} ${w.cy}`} fill="none" class="stroke-soil-300" stroke-width="2" />
      ))
    )}

    <!-- DuckDB -->
    <rect x={DDB_X} y={ddbCy - DDB_H / 2} width={DDB_W} height={DDB_H} rx="14" class="fill-soil-100 stroke-soil-900" stroke-width="2.5" />
    <g transform={iconTransform(DUCKDB_MARK.vb, 28, ddbCx, ddbCy - 14)} set:html={DUCKDB_MARK.body} />
    <text x={ddbCx} y={ddbCy + 26} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="14" font-family="inherit">DuckDB</text>

    <!-- Load balancer, distributed only -->
    {isDistributed && (
      <>
        <rect x={LB_X} y={lbCy - LB_H / 2} width={LB_W} height={LB_H} rx="12" class="fill-sun-200 stroke-soil-900" stroke-width="2.5" />
        <g class="text-sun-700" transform={iconTransform(ICON_VB, 22, lbCx, lbCy - 10)} set:html={FORK_BODY} />
        <text x={lbCx} y={lbCy + 22} text-anchor="middle" class="fill-soil-900 font-bold" font-size="11" font-family="inherit">Load balancer</text>
      </>
    )}

    <!-- Worker replicas -->
    {workers.map(w => (
      <>
        <rect x={WRK_X} y={w.y} width={WRK_W} height={WRK_H} rx="12" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2" />
        <g class="text-soil-700" transform={iconTransform(ICON_VB, 20, WRK_X + 26, w.cy)} set:html={CUBE_BODY} />
        <text x={WRK_X + 44} y={w.cy + 4} text-anchor="start" class="fill-soil-900 font-bold" font-size="12" font-family="inherit">Worker</text>
      </>
    ))}
  </svg>
</div>
