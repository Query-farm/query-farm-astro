---
import BrandMark from './BrandMark.astro';
import { vgiSkillsFile } from '../../lib/vgi-agents';
---
<figure class="agent-proof not-prose" data-agent-proof data-step="0">
  <div class="proof-grid">
    <section data-proof-step="0">
      <p class="proof-label"><span>01</span> You ask</p>
      <p class="request">Build a TypeScript VGI worker exposing <code>slugify</code>. Preserve SQL NULL. Run it through DuckDB and add repeatable tests.</p>
      <small>Recorded request, summarized</small>
    </section>
    <section data-proof-step="1">
      <p class="proof-label"><BrandMark name="claude-code" size={20} /> Your agent builds</p>
      <div class="file-list"><span><BrandMark name="typescript" size={17} /> worker.ts</span><span>src/slugify.ts</span><span>test/slugify.test.ts</span></div>
      <p class="source-note">Written and tested by Claude Code.</p>
      <a href={vgiSkillsFile('examples/agent-duckdb-typescript-slugify/README.md')}>Inspect the generated project →</a>
    </section>
    <section data-proof-step="2">
      <p class="proof-label"><BrandMark name="duckdb" size={20} /> DuckDB runs</p>
      <pre tabindex="0"><code>SELECT demo.main.slugify(
  'Hello, VGI!'
);</code></pre>
      <div class="query-answer"><span aria-hidden="true">✓</span><code>hello-vgi</code></div>
      <small>Actual result from the generated worker</small>
    </section>
  </div>
  <figcaption>
    <span><strong>A real build:</strong> Claude Code · TypeScript · 1m 38s, plus 1.0s independent SQL verification. <a href="#proof">See the evidence</a>.</span>
    <button type="button" data-proof-play>Replay the build flow <span aria-hidden="true">↻</span></button>
  </figcaption>
  <p class="flow-description" data-proof-description aria-live="polite">You describe the function and choose its language.</p>
</figure>
<script>
  function setupProofs() {
    document.querySelectorAll<HTMLElement>('[data-agent-proof]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const button = root.querySelector<HTMLButtonElement>('[data-proof-play]')!;
      const description = root.querySelector<HTMLElement>('[data-proof-description]')!;
      const messages = ['You describe the function and choose its language.', 'Your agent writes the worker, dependencies, and tests.', 'The agent runs DuckDB queries and checks the actual answers.'];
      let timer: ReturnType<typeof setTimeout> | undefined;
      const show = (step: number) => { root.dataset.step = String(step); description.textContent = messages[step]; };
      const stop = () => { clearTimeout(timer); delete root.dataset.playing; button.textContent = 'Replay the build flow ↻'; };
      button.addEventListener('click', () => {
        if (root.dataset.playing) { stop(); return; }
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { show((Number(root.dataset.step) + 1) % 3); return; }
        show(0); root.dataset.playing = 'true'; button.textContent = 'Pause the build flow';
        const next = () => {
          if (!root.isConnected || document.hidden) { stop(); return; }
          const step = Number(root.dataset.step) + 1;
          if (step > 2) { stop(); return; }
          show(step); timer = setTimeout(next, 2200);
        };
        timer = setTimeout(next, 2200);
      });
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    });
  }
  setupProofs(); document.addEventListener('astro:page-load', setupProofs);
</script>
<style>
  .agent-proof { container-type:inline-size; margin:2rem 0 0; color:var(--color-soil-900); }
  .proof-grid { display:grid; grid-template-columns:1fr 1fr 1.12fr; border:1px solid var(--color-soil-300); border-radius:.8rem; overflow:hidden; background:#fffdf7; }
  .proof-grid section { min-width:0; padding:1.2rem 1.4rem; border-top:3px solid transparent; transition:background .25s,border-color .25s; }
  .proof-grid section + section { border-left:1px solid var(--color-soil-300); }
  [data-step="0"] [data-proof-step="0"], [data-step="1"] [data-proof-step="1"], [data-step="2"] [data-proof-step="2"] { border-top-color:var(--color-field-700); background:var(--color-soil-100); }
  .proof-label { display:flex; align-items:center; gap:.65rem; font-size:.86rem; font-weight:600; margin:0 0 1rem; }.proof-label>span { color:var(--color-sun-700); }
  .request { font-size:.88rem; line-height:1.8; margin:0 0 .7rem; max-width:34ch; }.request code { font-size:.85em; }
  .file-list { display:flex; flex-direction:column; gap:.6rem; font-family:var(--qf-code-font-family); font-size:.8rem; }.file-list>span { display:flex; align-items:center; gap:.5rem; }
  .source-note { font-size:.8rem; line-height:1.6; margin:.9rem 0 .4rem; }
  a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; font-size:.78rem; }
  pre { background:var(--color-rock-900); color:#f4ece0; border-radius:.4rem; padding:.8rem 1rem; font-size:.79rem; line-height:1.7; overflow:auto; margin:0; }
  .query-answer { display:flex; align-items:center; gap:.65rem; margin:.7rem 0; font-size:.94rem; }.query-answer>span { color:var(--color-field-700); }
  small { display:block; color:var(--color-soil-600); font-size:.69rem; line-height:1.6; }
  figcaption { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-top:.9rem; font-size:.73rem; line-height:1.7; color:var(--color-soil-700); } figcaption a { font-size:inherit; }
  button { flex-shrink:0; cursor:pointer; text-decoration:underline; text-underline-offset:3px; color:var(--color-field-700); font-size:.75rem; }button:focus-visible { outline:2px solid var(--color-field-700); outline-offset:4px; }
  .flow-description { font-size:.75rem; margin:.4rem 0 0; color:var(--color-soil-600); }
  @container(max-width:700px) { .proof-grid { grid-template-columns:1fr; }.proof-grid section + section { border-left:0; border-top:1px solid var(--color-soil-300); }.proof-grid section { border-left:3px solid transparent; padding:1.1rem; }[data-step="0"] [data-proof-step="0"], [data-step="1"] [data-proof-step="1"], [data-step="2"] [data-proof-step="2"] { border-left-color:var(--color-field-700); border-top-color:var(--color-soil-300); }.request { max-width:none; }figcaption { flex-direction:column; gap:.4rem; } }
  @media(prefers-reduced-motion:reduce) { .proof-grid section { transition:none; } }
</style>
