---
/**
 * A numbered step-sequence diagram — for a flow like PKCE, device-code, or a
 * token refresh cycle, where the useful thing to show is "what happens in
 * what order," not a topology. Deliberately not a full actor/swimlane
 * diagram (DuckDB / browser / IdP as separate lanes): that's a much bigger
 * diagram to hand-build correctly, and a numbered sequence communicates the
 * same ordering with far less to get wrong. Wraps to multiple rows on
 * narrow viewports via plain flexbox — no SVG involved, unlike the other
 * VGI diagrams, since a step list is really just styled HTML.
 */
interface Step {
  label: string;
  detail: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
---

<div class={`${CARD} p-5 md:p-6`}>
  <ol class="flex flex-col gap-0">
    {steps.map((step, i) => (
      <li class="flex gap-4">
        <div class="flex flex-none flex-col items-center">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full border-2 border-soil-900 bg-sun-400 text-[13px] font-extrabold text-soil-900">
            {i + 1}
          </span>
          {i < steps.length - 1 && <span class="my-1 w-[2px] flex-1 bg-soil-300" aria-hidden="true" />}
        </div>
        <div class:list={['min-w-0', i < steps.length - 1 ? 'pb-5' : '']}>
          <p class="text-[15px] font-medium text-soil-900">{step.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-soil-700">{step.detail}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
