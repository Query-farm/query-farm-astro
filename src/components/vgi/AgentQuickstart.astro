---
import { VGI_AGENTS, VGI_AGENT_LANGUAGES, VGI_AGENT_RECIPES, VGI_SKILLS_SOURCE } from '../../lib/vgi-agents';
import BrandMark from './BrandMark.astro';
---

<div class="agent-quickstart" data-agent-quickstart data-source={VGI_SKILLS_SOURCE}>
  <div class="quickstart-heading">
    <span class="qf-eyebrow text-sun-700">Your starting point</span>
    <h2 id="start" class="mt-2 scroll-mt-32 text-3xl text-soil-900">Build one with your agent.</h2>
    <p class="mt-3 max-w-[65ch] leading-relaxed text-soil-700">Choose your tools, install the skill, and paste the request. Your agent builds the integration you choose, in your language.</p>
  </div>

  <fieldset class="mt-8">
    <legend class="text-sm font-semibold text-soil-900">1. Your coding agent</legend>
    <div class="agent-options mt-3">
      {VGI_AGENTS.map((agent, index) => (
        <label class="agent-option">
          <input type="radio" name="vgi-agent" value={agent.id} checked={index === 0} />
          <span><BrandMark name={agent.id} size={22} />{agent.name}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="install-panel mt-5">
    <div class="code-panel-bar"><span>Run in your project directory</span><button type="button" data-copy-install aria-label="Copy skill installation command">Copy command</button></div>
    <pre tabindex="0"><code data-install-command>{`npx skills add ${VGI_SKILLS_SOURCE} --skill vgi-worker --agent codex`}</code></pre>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-soil-600">The installer lets you add the skill to your project. Prefer a manual install? Copy the skill folder into <code data-skill-directory>.agents/skills/</code>. <a href="https://github.com/Query-farm/vgi-skills#installation" class="text-link underline underline-offset-2">Installation guide →</a></p>

  <div class="mt-8 space-y-5">
    <fieldset>
      <legend class="text-sm font-semibold text-soil-900">2. Your worker language</legend>
      <div class="language-options mt-3">
        {VGI_AGENT_LANGUAGES.map(language => <label class="agent-option"><input type="radio" name="vgi-language" value={language.id} /><span><BrandMark name={language.id} size={22} />{language.name}</span></label>)}
      </div>
      <p class="mt-3 min-h-12 text-sm leading-relaxed text-soil-600" data-language-requirements>Select a language to prepare your prompt and see its runtime requirements.</p>
    </fieldset>
    <div class="mt-1">
      <label for="worker-recipe" class="text-sm font-semibold text-soil-900">3. What should it build?</label>
      <select id="worker-recipe" name="worker-recipe" class="language-select mt-3">
        {VGI_AGENT_RECIPES.map(recipe => <option value={recipe.id}>{recipe.name}</option>)}
      </select>
      <p class="mt-3 text-sm leading-relaxed text-soil-600" data-recipe-description>{VGI_AGENT_RECIPES[0].description}</p>
    </div>
  </div>

  <div class="prompt-panel mt-5">
    <div class="prompt-panel-bar"><label for="worker-prompt">Your agent prompt · edit it to fit your project</label><button type="button" data-copy-prompt disabled>Copy prompt</button></div>
    <textarea id="worker-prompt" rows="9" spellcheck="false" placeholder="Choose your language above to prepare a prompt." aria-describedby="prompt-help"></textarea>
  </div>
  <p id="prompt-help" class="mt-3 text-sm text-soil-600">Paste this into your coding agent after installing the skill. It builds, runs, tests, and returns the SQL you can use.</p>
  <p class="mt-2 min-h-5 text-sm text-field-700" role="status" aria-live="polite" data-copy-status></p>
  <noscript><p class="mt-4">Choose a language in your prompt: “Use the vgi-worker skill to build and test a VGI worker in [your language].” <a href="https://github.com/Query-farm/vgi-skills">Read the installation guide and examples.</a></p></noscript>
</div>

<script>
  import { VGI_AGENTS, VGI_AGENT_LANGUAGES, VGI_AGENT_RECIPES, workerPrompt } from '../../lib/vgi-agents';
  function setupAgentQuickstarts() {
    document.querySelectorAll<HTMLElement>('[data-agent-quickstart]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const languageId = () => root.querySelector<HTMLInputElement>('input[name="vgi-language"]:checked')?.value || '';
      const recipe = root.querySelector<HTMLSelectElement>('#worker-recipe')!;
      const prompt = root.querySelector<HTMLTextAreaElement>('#worker-prompt')!;
      const copyPrompt = root.querySelector<HTMLButtonElement>('[data-copy-prompt]')!;
      const status = root.querySelector<HTMLElement>('[data-copy-status]')!;
      const agentId = () => root.querySelector<HTMLInputElement>('input[name="vgi-agent"]:checked')!.value;
      const refresh = () => {
        const agent = VGI_AGENTS.find(item => item.id === agentId())!;
        const selected = VGI_AGENT_LANGUAGES.find(item => item.id === languageId());
        root.querySelector('[data-install-command]')!.textContent = `npx skills add ${root.dataset.source} --skill vgi-worker --agent ${agent.id}`;
        root.querySelector('[data-skill-directory]')!.textContent = agent.directory;
        root.querySelector('[data-language-requirements]')!.textContent = selected ? `${selected.runtime}. The skill uses ${selected.sdk} and tests your worker through stock DuckDB 2.0.0 with VGI from query_farm.` : 'Select a language to prepare your prompt and see its runtime requirements.';
        root.querySelector('[data-recipe-description]')!.textContent = VGI_AGENT_RECIPES.find(item => item.id === recipe.value)!.description;
        prompt.value = workerPrompt(languageId(), recipe.value, agent.id);
        copyPrompt.disabled = !prompt.value;
        status.textContent = '';
      };
      root.querySelectorAll<HTMLInputElement>('input[name="vgi-agent"]').forEach(input => input.addEventListener('change', refresh));
      root.querySelectorAll<HTMLInputElement>('input[name="vgi-language"]').forEach(input => input.addEventListener('change', refresh));
      recipe.addEventListener('change', refresh);
      document.addEventListener('vgi:recipe', ((event: CustomEvent<string>) => {
        if (VGI_AGENT_RECIPES.some(item => item.id === event.detail)) {
          recipe.value = event.detail; refresh();
        }
      }) as EventListener);
      prompt.addEventListener('input', () => { copyPrompt.disabled = !prompt.value.trim(); });
      async function copy(text: string, message: string) {
        try { await navigator.clipboard.writeText(text); status.textContent = message; }
        catch { status.textContent = 'Select the text and copy it with your keyboard.'; }
      }
      root.querySelector('[data-copy-install]')!.addEventListener('click', () => void copy(root.querySelector('[data-install-command]')!.textContent!, 'Installation command copied.'));
      copyPrompt.addEventListener('click', () => void copy(prompt.value, 'Prompt copied. Paste it into your coding agent.'));
      refresh();
    });
  }
  setupAgentQuickstarts();
  document.addEventListener('astro:page-load', setupAgentQuickstarts);
</script>

<style>
  .agent-quickstart { container-type:inline-size; padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--color-soil-300); border-radius: 1rem; background: #fffdf7; }
  .agent-options { display: flex; flex-wrap: wrap; gap: .5rem; }
  .agent-option { position: relative; cursor: pointer; }
  .agent-option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .agent-option > span { display: flex; align-items: center; gap:.5rem; border: 1px solid var(--color-soil-300); border-radius: .5rem; padding: .65rem .9rem; color: var(--color-soil-700); font-size: .875rem; }
  .agent-option input:checked + span { background: var(--color-soil-900); color: #f4ece0; border-color: var(--color-soil-900); }
  .agent-option input:focus-visible + span { outline: 2px solid var(--color-field-600); outline-offset: 3px; }
  .language-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem; }
  .install-panel { background: #1a1512; color: #f4ece0; border-radius: .75rem; overflow: hidden; }
  .code-panel-bar, .prompt-panel-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; font-size: .75rem; }
  .code-panel-bar { border-bottom: 1px solid #44382d; color: #d5cabc; }
  .code-panel-bar button, .prompt-panel-bar button { flex-shrink: 0; border: 1px solid currentColor; border-radius: .3rem; padding: .3rem .55rem; font-weight: 600; cursor: pointer; }
  button:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--color-field-600); outline-offset: 3px; }
  .install-panel pre { overflow-x: auto; padding: 1.15rem; margin: 0; font-size: .8rem; line-height: 1.7; }
  .language-select { display: block; width: 100%; min-height: 3rem; border: 1px solid var(--color-soil-400); border-radius: .5rem; background: #fffdf7; color: #211a12; padding: .7rem 2rem .7rem .85rem; font-size: .9rem; }
  .prompt-panel { border: 1px solid var(--color-soil-300); border-radius: .75rem; overflow: hidden; }
  .prompt-panel-bar { background: var(--color-soil-100); color: var(--color-soil-800); }
  .prompt-panel textarea { display: block; width: 100%; padding: 1rem; background: #fffdf7; color: #211a12; resize: vertical; font-family: var(--qf-code-font-family); font-size: .8rem; line-height: 1.8; border: 0; }
  button:disabled { opacity: .45; cursor: not-allowed; }
  @container (min-width: 720px) { .language-options { grid-template-columns:repeat(6,minmax(0,1fr)); } .agent-option > span { padding:.65rem .65rem; } }
  @media (max-width: 520px) { .prompt-panel-bar { align-items: flex-start; } .prompt-panel-bar label { max-width: 19ch; } }
</style>
