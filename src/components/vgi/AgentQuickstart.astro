---
import { Icon } from 'astro-icon/components';
import { VGI_AGENTS, VGI_AGENT_LANGUAGES, VGI_AGENT_REQUESTS, VGI_CUSTOM_REQUEST, VGI_SKILLS_SOURCE, vgiSkillsFile } from '../../lib/vgi-agents';
import BrandMark from './BrandMark.astro';
---

<div class="agent-quickstart" data-agent-quickstart data-source={VGI_SKILLS_SOURCE}>
  <div class="quickstart-heading">
    <span class="qf-eyebrow text-sun-700">Your starting point</span>
    <h2 id="start" class="mt-2 scroll-mt-32 text-3xl text-soil-900">Tell your agent what you want to connect.</h2>
    <p class="mt-3 max-w-[65ch] leading-relaxed text-soil-700">The VGI skill teaches it how to build a worker and test it in DuckDB. You bring the idea.</p>
  </div>

  <section class="setup-step" aria-labelledby="install-skill">
    <h3 id="install-skill" class="step-heading"><span class="step-number" aria-hidden="true">1</span>Give your agent the VGI skill</h3>
    <div class="setup-panel">
      <fieldset class="agent-picker">
        <legend class="sr-only">Your coding agent</legend>
        <div class="agent-options">
          {VGI_AGENTS.map((agent, index) => (
            <label class={`agent-option agent-${agent.id}`}>
              <input type="radio" name="vgi-agent" value={agent.id} checked={index === 0} />
              <span><BrandMark name={agent.id} size={22} />{agent.name}</span>
            </label>
          ))}
          <label class="agent-option"><input type="radio" name="vgi-agent" value="other" /><span><Icon name="mdi:code-tags" size={22} />Other agents</span></label>
        </div>
      </fieldset>
      <div class="install-panel">
        <div class="code-panel-bar"><span>Run in your project’s terminal</span><button type="button" data-copy-install aria-label="Copy skill installation command" hidden>Copy command</button></div>
        <pre tabindex="0"><code data-install-command>{`npx skills add ${VGI_SKILLS_SOURCE} --skill vgi-worker --agent codex`}</code></pre>
      </div>
      <p class="install-note">Install once per project. After installation, open your agent in that project and use a request below.</p>
      <details class="install-help">
        <summary>Installation help &amp; compatibility</summary>
        <div class="help-copy">
          <p>The installer uses Node.js. The skill’s SQL verifier uses <a href="https://docs.astral.sh/uv/">uv</a> and stock DuckDB. Your worker also needs the runtime for the language you choose.</p>
          <p data-manual-help>For a manual install, copy the complete <code>vgi-worker</code> skill folder into <code data-skill-directory>.agents/skills/</code>. <a href="https://github.com/Query-farm/vgi-skills#installation">Installation guide →</a></p>
          <p data-other-help hidden>The installer lets you select from its supported agents. For another agent that reads skills, follow its instructions for adding a complete skill folder. <a href="https://github.com/Query-farm/vgi-skills#installation">Installation guide →</a></p>
          <p>If a running agent doesn’t find the new skill, restart or reload it. Cloud agents need the skill and tools installed in their own environment.</p>
          <p>Live builds have been tested with Codex and Claude Code. Cursor, Copilot, and OpenCode have installation checks. <a href={vgiSkillsFile('evals/RESULTS.md')}>Compatibility details →</a></p>
        </div>
      </details>
    </div>
    <p class="copy-status" role="status" aria-live="polite" data-install-status></p>
  </section>

  <section class="request-step" aria-labelledby="ask-your-agent">
    <h3 id="ask-your-agent" class="step-heading"><span class="step-number" aria-hidden="true">2</span>Ask for the connection you need</h3>
    <p class="step-intro">Copy a request into your agent and make it your own. Name your language, or let the agent ask before it writes code.</p>
    <ul class="language-list" aria-label="Worker languages">
      {VGI_AGENT_LANGUAGES.map(language => <li class={`language-${language.id}`}><BrandMark name={language.id} size={19} /><span>{language.name}</span></li>)}
    </ul>
    <div class="request-grid">
      {VGI_AGENT_REQUESTS.map(request => (
        <article class={`request-card request-${request.id}`} id={`request-${request.id}`} aria-labelledby={`request-title-${request.id}`} data-request-card>
          <div class="request-icon"><Icon name={request.icon} size={25} /></div>
          <h4 id={`request-title-${request.id}`}>{request.name}</h4>
          <p class="request-examples">{request.examples}</p>
          <p class="request-text" data-request-text>{request.prompt}</p>
          <button type="button" data-copy-request aria-label={`Copy request: ${request.name}`} hidden>Copy request <Icon name="mdi:content-copy" size={16} /></button>
          <p class="copy-status" role="status" aria-live="polite" data-request-status></p>
          {request.id === 'files' && <a class="worked-example-link" href="/vgi/photo-catalog-with-an-agent/">Follow a worked example →</a>}
        </article>
      ))}
    </div>
    <details class="custom-request" data-request-card>
      <summary>Describe your own integration</summary>
      <p class="custom-intro">Tell your agent what you want to bring into SQL and what a useful result would look like. Start a conversation with this request:</p>
      <p class="request-text" data-request-text>{VGI_CUSTOM_REQUEST}</p>
      <button type="button" data-copy-request aria-label="Copy request: Your own integration" hidden>Copy request <Icon name="mdi:content-copy" size={16} /></button>
      <p class="copy-status" role="status" aria-live="polite" data-request-status></p>
    </details>
    <div class="handoff">
      <p>Ask your agent to leave you with</p>
      <ul><li><Icon name="mdi:check-circle-outline" size={18} />Worker source</li><li><Icon name="mdi:check-circle-outline" size={18} />Passing SQL tests</li><li><Icon name="mdi:check-circle-outline" size={18} /><span><code>ATTACH</code> + a query to run</span></li></ul>
    </div>
  </section>
  <noscript><p class="mt-4">The requests above are ready to select and copy. The command shown installs for Codex; see the <a href="https://github.com/Query-farm/vgi-skills#installation">installation guide for other agents</a>.</p></noscript>
</div>

<script>
  import { VGI_AGENTS } from '../../lib/vgi-agents';
  function setupAgentQuickstarts() {
    document.querySelectorAll<HTMLElement>('[data-agent-quickstart]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const command = root.querySelector<HTMLElement>('[data-install-command]')!;
      const installStatus = root.querySelector<HTMLElement>('[data-install-status]')!;
      const refreshInstall = () => {
        const selected = root.querySelector<HTMLInputElement>('input[name="vgi-agent"]:checked')!.value;
        const agent = VGI_AGENTS.find(item => item.id === selected);
        command.textContent = `npx skills add ${root.dataset.source} --skill vgi-worker${agent ? ` --agent ${agent.id}` : ''}`;
        if (agent) root.querySelector('[data-skill-directory]')!.textContent = agent.directory;
        root.querySelector<HTMLElement>('[data-manual-help]')!.hidden = !agent;
        root.querySelector<HTMLElement>('[data-other-help]')!.hidden = !!agent;
        installStatus.textContent = '';
      };
      root.querySelectorAll<HTMLInputElement>('input[name="vgi-agent"]').forEach(input => input.addEventListener('change', refreshInstall));
      async function copy(text: string, button: HTMLButtonElement, status: HTMLElement, message: string) {
        try {
          await navigator.clipboard.writeText(text);
          status.textContent = message;
          button.dataset.copied = 'true';
          window.setTimeout(() => { delete button.dataset.copied; }, 2000);
        } catch {
          status.textContent = 'Select the text above and copy it with your keyboard or touch menu.';
        }
      }
      const installButton = root.querySelector<HTMLButtonElement>('[data-copy-install]')!;
      installButton.hidden = false;
      installButton.addEventListener('click', () => void copy(command.textContent!, installButton, installStatus, 'Installation command copied.'));
      root.querySelectorAll<HTMLElement>('[data-request-card]').forEach(card => {
        const button = card.querySelector<HTMLButtonElement>('[data-copy-request]')!;
        button.hidden = false;
        button.addEventListener('click', () => void copy(card.querySelector('[data-request-text]')!.textContent!, button, card.querySelector<HTMLElement>('[data-request-status]')!, 'Copied. Paste this into your coding agent.'));
      });
      refreshInstall();
    });
  }
  setupAgentQuickstarts();
  document.addEventListener('astro:page-load', setupAgentQuickstarts);
</script>

<style>
  .agent-quickstart { container-type:inline-size; color:var(--color-soil-900); }
  .setup-step { margin-top:2rem; }
  .step-heading { display:flex; align-items:center; gap:.7rem; font-size:1.15rem; line-height:1.4; }
  .step-number { display:flex; align-items:center; justify-content:center; width:1.7rem; height:1.7rem; flex-shrink:0; background:var(--color-sun-600); color:white; border-radius:50%; font-family:var(--qf-code-font-family); font-size:.8rem; }
  .setup-panel { border:1px solid var(--color-soil-300); border-radius:.8rem; background:#fffdf7; margin-top:1rem; overflow:hidden; }
  .agent-picker { padding:.7rem; }
  .agent-options { display:flex; flex-wrap:wrap; gap:.35rem; }
  .agent-option { position:relative; cursor:pointer; --agent-color:var(--color-soil-700); }
  .agent-option input { position:absolute; opacity:0; width:1px; height:1px; }
  .agent-option > span { display:flex; align-items:center; gap:.5rem; border:1px solid transparent; border-radius:.45rem; padding:.65rem .8rem; color:var(--color-soil-700); font-size:.85rem; }
  .agent-option :global(.brand-mark) { color:var(--agent-color); }
  .agent-codex { --agent-color:#087f8c; }.agent-claude-code { --agent-color:#b95031; }.agent-cursor { --agent-color:#6843af; }.agent-github-copilot { --agent-color:#3759b6; }.agent-opencode { --agent-color:#95600c; }
  .agent-option input:checked + span { background:var(--color-soil-100); border-color:var(--color-soil-400); color:var(--color-soil-900); }
  .agent-option input:focus-visible + span, button:focus-visible, summary:focus-visible, pre:focus-visible { outline:2px solid var(--color-field-600); outline-offset:3px; }
  .install-panel { background:#1a1512; color:#f4ece0; }
  .code-panel-bar { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.75rem 1rem; font-size:.75rem; border-bottom:1px solid #44382d; color:#d5cabc; }
  .code-panel-bar button { flex-shrink:0; border:1px solid currentColor; border-radius:.3rem; padding:.35rem .6rem; font-weight:600; cursor:pointer; }
  .install-panel pre { overflow-x:auto; padding:1.15rem; margin:0; font-size:.8rem; line-height:1.7; }
  .install-note { padding:1rem 1.15rem .7rem; color:var(--color-soil-700); font-size:.85rem; line-height:1.7; }
  .install-help { margin:0 1.15rem 1rem; font-size:.8rem; }
  summary { cursor:pointer; color:var(--color-field-700); font-weight:600; }
  .help-copy { max-width:85ch; color:var(--color-soil-700); line-height:1.8; }
  .help-copy p { margin-top:.8rem; }
  .help-copy a { text-decoration:underline; text-underline-offset:3px; }
  .copy-status { min-height:1.4em; font-size:.75rem; line-height:1.4; color:var(--color-field-700); margin-top:.6rem; }
  .request-step { margin-top:1.7rem; }
  .step-intro { font-size:.9rem; line-height:1.7; color:var(--color-soil-700); margin-top:.75rem; }
  .language-list { display:flex; flex-wrap:wrap; gap:.6rem 1.3rem; list-style:none; margin:1rem 0 1.4rem; padding:0; }
  .language-list li { display:flex; align-items:center; gap:.4rem; font-size:.75rem; color:var(--color-soil-700); }
  .language-csharp :global(.brand-mark) { color:#7b3ca3; }.language-go :global(.brand-mark) { color:#00859b; }.language-java :global(.brand-mark) { color:#bf4c2b; }.language-python :global(.brand-mark) { color:#3776ab; }.language-rust :global(.brand-mark) { color:#a84d2a; }.language-typescript :global(.brand-mark) { color:#3178c6; }
  .request-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .request-card { --request-color:#087f8c; --request-ground:#e3f4f0; display:flex; flex-direction:column; border:1px solid var(--color-soil-300); border-top:3px solid var(--request-color); border-radius:.6rem; padding:1.25rem; background:#fffdf7; scroll-margin-top:8rem; }
  .request-files { --request-color:#b95031; --request-ground:#fae8df; }.request-library { --request-color:#6843af; --request-ground:#ede6f7; }
  .request-icon { width:2.7rem; height:2.7rem; display:flex; align-items:center; justify-content:center; border-radius:.6rem; background:var(--request-ground); color:var(--request-color); margin-bottom:.85rem; }
  .request-card h4 { font-size:1.2rem; line-height:1.35; }
  .request-examples { font-size:.75rem; color:var(--color-soil-600); line-height:1.6; margin-top:.5rem; }
  .request-text { font-size:.88rem; line-height:1.8; margin:1rem 0 1.25rem; }
  [data-copy-request] { display:flex; align-items:center; justify-content:space-between; gap:1rem; color:var(--color-field-700); background:transparent; border:1px solid var(--color-soil-300); border-radius:.35rem; padding:.6rem .75rem; font-size:.8rem; font-weight:600; cursor:pointer; margin-top:auto; }
  [data-copy-request]:hover, [data-copied] { background:#e3f4e5; }
  [hidden] { display:none !important; }
  .worked-example-link { font-size:.78rem; color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; margin-top:.2rem; }
  .custom-request { border-bottom:1px solid var(--color-soil-300); padding:1.2rem 0; }
  .custom-request summary { font-size:.95rem; }
  .custom-request .request-text, .custom-intro { max-width:85ch; }
  .custom-intro { margin-top:1rem; font-size:.85rem; line-height:1.7; color:var(--color-soil-700); }
  .custom-request button { margin-top:0; }
  .handoff { display:flex; flex-wrap:wrap; align-items:center; gap:.7rem 1.5rem; padding:1.3rem 0 0; }
  .handoff p { font-size:.8rem; color:var(--color-soil-600); }
  .handoff ul { display:flex; flex-wrap:wrap; gap:.7rem 1.5rem; list-style:none; padding:0; margin:0; }
  .handoff li { display:flex; align-items:center; gap:.45rem; font-size:.8rem; }
  .handoff li :global(svg) { color:var(--color-field-700); }
  @container (max-width:760px) { .request-grid { grid-template-columns:1fr; }.request-card { padding:1.25rem; }.request-card .request-text { max-width:75ch; }.request-card button { align-self:flex-start; }.agent-option > span { padding:.55rem .6rem; } }
</style>
