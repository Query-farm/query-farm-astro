---
interface Props { compact?: boolean; full?: boolean; }
const { compact = false, full = false } = Astro.props;
---
<figure class="walkthrough-video not-prose">
  {!compact && <><p class="video-eyebrow">Watch the coding agent running</p><h2>Codex builds the connection. DuckDB runs the query.</h2><p class="video-intro">A fresh project, the VGI skill, and a request to join GitHub’s releases API to a local inventory. This is a screen recording of the actual Codex CLI session.</p></>}
  <video controls playsinline preload="none" poster="/vgi/agents/github-build-poster.png" aria-label={full ? 'Full screen recording of Codex building the GitHub VGI integration' : 'Screen recording: Codex builds and tests a GitHub VGI integration'}>
    <source src={full ? '/vgi/agents/github-build-full.mp4' : '/vgi/agents/github-build.mp4'} type="video/mp4" />
    {!full && <track kind="captions" src="/vgi/agents/github-build.vtt" srclang="en" label="English" default />}
  </video>
  <figcaption>{full ? 'Full capture at its original speed, including setup and waiting. The terminal is connected to the running Codex CLI.' : 'An 86-second edit of the live screen capture. Cuts and accelerated footage are labeled. Codex reported 7m 11s of work in this run. The agent writes the code, runs the tests, and executes the live query. The local inventory is fictional sample data.'}</figcaption>
  <div class="video-links"><a href={full ? '/vgi/build-with-an-agent/#watch' : '/vgi/agent-build-recording/'}>{full ? 'Back to the quickstart →' : 'Watch the full capture at original speed →'}</a></div>
</figure>
<style>
  .walkthrough-video { margin:0; color:var(--color-soil-900); }.video-eyebrow { font-size:.8rem; font-weight:600; color:var(--color-sun-700); margin:0 0 .65rem; }.walkthrough-video h2 { font-size:clamp(1.6rem,3vw,2.1rem); margin:0 0 1rem; line-height:1.3; }.video-intro { font-size:.95rem; line-height:1.8; max-width:80ch; margin:0 0 1.4rem; }.walkthrough-video video { display:block; width:100%; max-width:1100px; aspect-ratio:1440/1000; border-radius:.75rem; border:1px solid var(--color-soil-300); background:#121212; }.walkthrough-video figcaption { font-size:.8rem; line-height:1.7; margin-top:1rem; color:var(--color-soil-600); max-width:95ch; }.video-links { margin:1rem 0; font-size:.8rem; }.video-links a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; }
</style>
