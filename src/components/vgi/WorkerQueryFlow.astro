---
import BrandMark from './BrandMark.astro';
---
<figure class="worker-flow not-prose" data-worker-flow data-phase="0">
  <div class="flow-heading"><span>What happens when you run the query</span><span class="flow-label">SQL → your code → SQL results</span></div>
  <div class="flow-nodes" role="img" aria-label="DuckDB sends columns through its VGI extension to a separate worker. The worker runs the shipping library and returns prices. DuckDB combines those prices with the order table.">
    <div class="flow-node database"><BrandMark name="duckdb" size={32} /><strong>DuckDB</strong><span>Your orders<br />Your SQL query</span><code>5 orders</code></div>
    <div class="flow-wire" aria-hidden="true"><span class="wire-label">columns</span><span class="wire-out">→</span><span class="wire-in">←</span><i class="packet"></i></div>
    <div class="flow-node extension"><span class="extension-mark" aria-hidden="true">VGI</span><strong>The VGI extension</strong><span>Connects SQL to<br />the worker’s functions</span><code>typed Arrow data</code></div>
    <div class="flow-wire" aria-hidden="true"><span class="wire-label">function call</span><span class="wire-out">→</span><span class="wire-in">←</span><i class="packet"></i></div>
    <div class="flow-node worker"><BrandMark name="typescript" size={30} /><strong>Your worker</strong><span>A separate program<br />in your chosen language</span><div class="library"><span>Shipping library</span><code>quote_cents(…)</code></div></div>
  </div>
  <div class="flow-caption" aria-live="polite" aria-atomic="true" data-flow-caption>DuckDB has the orders. Your worker has the shipping logic. VGI lets the query use both.</div>
  <div class="flow-controls"><button type="button" data-flow-play>Play the query</button><button type="button" data-flow-next>Next step →</button><span data-flow-step>Overview</span></div>
  <figcaption>Animation of the request path. The worker runs on your machine in this example; VGI can also connect to a hosted worker. The coding agent builds the program—it is not needed to answer each query.</figcaption>
</figure>
<script>
  function setupWorkerFlows() {
    document.querySelectorAll<HTMLElement>('[data-worker-flow]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const captions = [
        'DuckDB has the orders. Your worker has the shipping logic. VGI lets the query use both.',
        'DuckDB sends the destination and weight columns through VGI. It does not ask the coding agent to calculate a price.',
        'The worker calls its shipping library for the input rows. That code can use the language’s existing packages and tools.',
        'The worker returns a column of prices. An unsupported destination returns NULL, so a missing quote stays visible.',
        'Back in DuckDB, SQL subtracts shipping from each margin and selects the orders that need attention.',
      ];
      let phase = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      const play = root.querySelector<HTMLButtonElement>('[data-flow-play]')!;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const stop = () => { clearInterval(timer); timer = undefined; root.removeAttribute('data-playing'); play.textContent = phase === 4 ? 'Replay the query' : 'Play the query'; };
      const show = (next: number) => {
        phase = next;
        root.dataset.phase = String(phase);
        root.querySelector('[data-flow-caption]')!.textContent = captions[phase];
        root.querySelector('[data-flow-step]')!.textContent = phase ? `Step ${phase} of 4` : 'Overview';
        if (phase === 4) stop();
      };
      root.querySelector('[data-flow-next]')!.addEventListener('click', () => { stop(); show((phase + 1) % 5); });
      play.addEventListener('click', () => {
        if (timer) { stop(); return; }
        show(phase === 4 ? 1 : phase + 1);
        if (motion.matches || phase === 4) return;
        root.dataset.playing = 'true'; play.textContent = 'Pause animation';
        timer = setInterval(() => { if (!root.isConnected || document.hidden) { stop(); return; } show(phase + 1); }, 2800);
      });
      motion.addEventListener('change', () => { if (motion.matches) stop(); });
    });
  }
  setupWorkerFlows();
  document.addEventListener('astro:page-load', setupWorkerFlows);
</script>
<style>
  .worker-flow { margin:2rem 0; border:1px solid var(--color-soil-300); border-radius:1rem; padding:clamp(1rem,3vw,2rem); background:#fffdf7; }
  .flow-heading { display:flex; justify-content:space-between; flex-wrap:wrap; gap:.5rem; font-size:.85rem; font-weight:600; color:var(--color-soil-900); }
  .flow-label { font-size:.75rem; font-weight:400; color:var(--color-soil-600); }
  .flow-nodes { display:grid; grid-template-columns:1fr 54px 1fr 54px 1.25fr; align-items:center; margin:1.75rem 0; }
  .flow-node { min-width:0; min-height:205px; padding:1.2rem .65rem; border:1px solid var(--color-soil-300); border-radius:.75rem; display:flex; flex-direction:column; align-items:center; text-align:center; gap:.6rem; color:var(--color-soil-900); transition:border-color .25s, background .25s, box-shadow .25s; }
  .flow-node strong { font-size:.95rem; }.flow-node>span:not(.extension-mark) { font-size:.8rem; line-height:1.6; color:var(--color-soil-700); }
  .flow-node code { font-size:.7rem; color:var(--color-soil-700); }.extension-mark { font-family:var(--font-display); font-size:1.3rem; font-weight:700; height:32px; }
  .library { border-top:1px solid var(--color-soil-300); width:100%; padding-top:.65rem; display:grid; gap:.3rem; font-size:.8rem; }
  .flow-wire { position:relative; display:grid; text-align:center; color:var(--color-soil-600); font-size:1.8rem; line-height:1; }.wire-label { position:absolute; top:-25px; left:50%; transform:translateX(-50%); font-size:.6rem; white-space:nowrap; }
  .wire-in { color:var(--color-field-700); }.packet { position:absolute; top:10px; left:0; width:6px; height:6px; border-radius:50%; background:var(--color-field-700); opacity:0; }
  [data-phase='1'] .database, [data-phase='1'] .extension, [data-phase='2'] .worker, [data-phase='3'] .worker, [data-phase='4'] .database { border-color:var(--color-field-700); box-shadow:0 0 0 2px var(--color-field-700); background:#f3f5ec; }
  [data-playing][data-phase='1'] .packet, [data-playing][data-phase='2'] .packet { opacity:1; animation:packet-out 1.2s ease-in-out infinite; }
  [data-playing][data-phase='3'] .packet { opacity:1; top:38px; animation:packet-out 1.2s ease-in-out infinite reverse; }
  @keyframes packet-out { from { transform:translateX(0); } to { transform:translateX(48px); } }
  .flow-caption { min-height:3.4em; font-size:.9rem; line-height:1.7; color:var(--color-soil-900); }.flow-controls { display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; margin-top:1rem; }
  .flow-controls button { border:1px solid var(--color-soil-400); border-radius:.4rem; padding:.5rem .75rem; background:#fffdf7; color:var(--color-soil-900); font-size:.8rem; cursor:pointer; }.flow-controls button:first-child { background:var(--color-field-700); color:white; border-color:var(--color-field-700); }.flow-controls button:focus-visible { outline:2px solid var(--color-field-600); outline-offset:3px; }.flow-controls>span { font-size:.75rem; color:var(--color-soil-600); }
  figcaption { margin-top:1.2rem; font-size:.75rem; line-height:1.7; color:var(--color-soil-600); }
  @media(max-width:600px) { .flow-nodes { grid-template-columns:1fr; margin:1.5rem 0; }.flow-node { min-height:0; padding:1rem; }.flow-wire { display:flex; height:45px; align-items:center; justify-content:center; gap:1rem; }.wire-out { transform:rotate(90deg); }.wire-in { transform:rotate(90deg); }.wire-label { top:16px; left:calc(50% + 58px); transform:none; }.packet { display:none; }.flow-node>span br { display:none; }.flow-caption { min-height:5.2em; } }
  @media(prefers-reduced-motion:reduce) { .flow-node { transition:none; }.packet { animation:none!important; display:none; } }
</style>
