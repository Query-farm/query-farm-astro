---
/**
 * The starting picture for the Authentication page: who's actually involved
 * before any protocol detail (PKCE vs. device-code) matters. Four actors —
 * User, DuckDB Client, OAuth Provider, VGI Worker — with the OAuth Provider
 * doing double duty: it's the thing the user logs into AND the thing the
 * worker independently checks a token against. That's the point being
 * illustrated — VGI never becomes the identity provider itself, it just
 * carries a token from one existing trust relationship to another.
 */
const USER_VB = { x: 0, y: 0, w: 256, h: 256 };
const USER_BODY =
  '<path fill="currentColor" d="M230.92 212c-15.23-26.33-38.7-45.21-66.09-54.16a72 72 0 1 0-73.66 0c-27.39 8.94-50.86 27.82-66.09 54.16a8 8 0 1 0 13.85 8c18.84-32.56 52.14-52 89.07-52s70.23 19.44 89.07 52a8 8 0 1 0 13.85-8M72 96a56 56 0 1 1 56 56a56.06 56.06 0 0 1-56-56"/>';
const KEY_BODY =
  '<path fill="currentColor" d="M216.57 39.43a80 80 0 0 0-132.66 81.35L28.69 176A15.86 15.86 0 0 0 24 187.31V216a16 16 0 0 0 16 16h32a8 8 0 0 0 8-8v-16h16a8 8 0 0 0 8-8v-16h16a8 8 0 0 0 5.66-2.34l9.56-9.57A79.7 79.7 0 0 0 160 176h.1a80 80 0 0 0 56.47-136.57M224 98.1c-1.09 34.09-29.75 61.86-63.89 61.9H160a63.7 63.7 0 0 1-23.65-4.51a8 8 0 0 0-8.84 1.68L116.69 168H96a8 8 0 0 0-8 8v16H72a8 8 0 0 0-8 8v16H40v-28.69l58.83-58.82a8 8 0 0 0 1.68-8.84A63.7 63.7 0 0 1 96 95.92c0-34.14 27.81-62.8 61.9-63.89A64 64 0 0 1 224 98.1M192 76a12 12 0 1 1-12-12a12 12 0 0 1 12 12"/>';
// The real VGI mark (public/vgi/vgi-logo.png), not a generic worker icon —
// this box specifically represents a VGI worker, not any process. Raster,
// not flat paths like the others, so it's placed via <image> rather than
// iconTransform; sized to the same 600:437 aspect ratio as the source file.
const WRK_LOGO = { w: 41, h: 30 };
const DUCKDB_MARK = {
  vb: { x: 217.6, y: 10, w: 334.4, h: 334.4 },
  body: `
    <path fill="#000" d="M384.8,344.4L384.8,344.4c-92.5,0-167.2-74.7-167.2-167.2l0,0C217.6,84.7,292.3,10,384.8,10l0,0 C477.3,10,552,84.7,552,177.2l0,0C552,269.6,477.3,344.4,384.8,344.4z"/>
    <path fill="#fff100" d="M474.2,152.2h-32.8v49.5h32.8c13.7,0,24.9-11.3,24.9-24.9S487.9,152.2,474.2,152.2"/>
    <path fill="#fff100" d="M280.7,177.1c0,38.2,31.1,69.3,69.3,69.3c38.2,0,69.3-31.1,69.3-69.3s-31.1-69.3-69.3-69.3 C311.8,107.8,280.7,138.9,280.7,177.1L280.7,177.1"/>
  `,
};

const iconTransform = (vb: { x: number; y: number; w: number; h: number }, size: number, cx: number, cy: number) => {
  const s = size / vb.w;
  const tx = cx - (vb.w / 2) * s - vb.x * s;
  const ty = cy - (vb.h / 2) * s - vb.y * s;
  return `translate(${tx.toFixed(2)},${ty.toFixed(2)}) scale(${s.toFixed(5)})`;
};

// ── Fixed geometry ──
const VB_W = 700, VB_H = 300;
const PRV_X = 280, PRV_Y = 20, PRV_W = 140, PRV_H = 80;
const ROW_Y = 200, ROW_H = 80;
const USR_X = 20, USR_W = 140;
const DDB_X = 280, DDB_W = 140;
const WRK_X = 540, WRK_W = 140;

const prvCx = PRV_X + PRV_W / 2, prvCy = PRV_Y + PRV_H / 2;
const usrCx = USR_X + USR_W / 2, usrCy = ROW_Y + ROW_H / 2;
const ddbCx = DDB_X + DDB_W / 2, ddbCy = ROW_Y + ROW_H / 2;
const wrkCx = WRK_X + WRK_W / 2, wrkCy = ROW_Y + ROW_H / 2;
const wrkLogoX = wrkCx - WRK_LOGO.w / 2;
const wrkLogoY = wrkCy - 12 - WRK_LOGO.h / 2;

// Four numbered wires — a login, a token handed to the client, that token
// carried to the worker, and the worker independently checking it against
// the same provider it came from.
const wires = [
  { d: `M${usrCx} ${ROW_Y} L${PRV_X + 26} ${PRV_Y + PRV_H}`, label: '1. Logs in', lx: 150, ly: 150 },
  { d: `M${prvCx} ${PRV_Y + PRV_H} L${ddbCx} ${ROW_Y}`, label: '2. Issues token', lx: prvCx + 8, ly: (PRV_Y + PRV_H + ROW_Y) / 2, anchor: 'start' },
  { d: `M${DDB_X + DDB_W} ${ddbCy} L${WRK_X} ${wrkCy}`, label: '3. Query + token', lx: (DDB_X + DDB_W + WRK_X) / 2, ly: ddbCy - 12 },
  { d: `M${WRK_X + WRK_W - 26} ${ROW_Y} L${PRV_X + PRV_W - 26} ${PRV_Y + PRV_H}`, label: '4. Validates token', lx: 545, ly: 150, anchor: 'end' },
];

const ariaLabel =
  'Diagram: the user logs into an OAuth provider, which issues a token to the DuckDB client. DuckDB sends that token along with its query to the VGI worker, which independently validates the token against the same OAuth provider.';

const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
---

<div class={`${CARD} p-4`}>
  <svg
    class="w-full h-auto"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={ariaLabel}
  >
    <defs>
      <marker id="auth-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="fill-soil-400" />
      </marker>
    </defs>

    {wires.map(w => (
      <>
        <path d={w.d} fill="none" class="stroke-soil-300" stroke-width="2.5" marker-end="url(#auth-arrow)" />
        <text x={w.lx} y={w.ly} text-anchor={w.anchor ?? 'middle'} class="fill-soil-500 font-bold" font-size="11" font-family="inherit">{w.label}</text>
      </>
    ))}

    <!-- OAuth Provider -->
    <rect x={PRV_X} y={PRV_Y} width={PRV_W} height={PRV_H} rx="14" class="fill-sun-200 stroke-soil-900" stroke-width="2.5" />
    <g class="text-sun-700" transform={iconTransform(USER_VB, 24, prvCx, prvCy - 12)} set:html={KEY_BODY} />
    <text x={prvCx} y={prvCy + 24} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="13" font-family="inherit">OAuth Provider</text>

    <!-- User -->
    <rect x={USR_X} y={ROW_Y} width={USR_W} height={ROW_H} rx="14" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2.5" />
    <g class="text-soil-700" transform={iconTransform(USER_VB, 24, usrCx, usrCy - 12)} set:html={USER_BODY} />
    <text x={usrCx} y={usrCy + 24} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="14" font-family="inherit">User</text>

    <!-- DuckDB Client -->
    <rect x={DDB_X} y={ROW_Y} width={DDB_W} height={ROW_H} rx="14" class="fill-soil-100 stroke-soil-900" stroke-width="2.5" />
    <g transform={iconTransform(DUCKDB_MARK.vb, 26, ddbCx, ddbCy - 12)} set:html={DUCKDB_MARK.body} />
    <text x={ddbCx} y={ddbCy + 24} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="13" font-family="inherit">DuckDB Client</text>

    <!-- VGI Worker -->
    <rect x={WRK_X} y={ROW_Y} width={WRK_W} height={ROW_H} rx="14" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2.5" />
    <image href="/vgi/vgi-logo.png" x={wrkLogoX} y={wrkLogoY} width={WRK_LOGO.w} height={WRK_LOGO.h} preserveAspectRatio="xMidYMid meet" />
    <text x={wrkCx} y={wrkCy + 24} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="14" font-family="inherit">VGI Worker</text>
  </svg>
</div>
