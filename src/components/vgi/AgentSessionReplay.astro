---
import story from '../../data/vgi-agent-story.json';
import BrandMark from './BrandMark.astro';
---
<div class="session-replay not-prose" data-session-replay data-chapter="0">
  <div class="session-top"><span><BrandMark name="claude-code" size={24} /> Claude Code <span class="divider">/</span><BrandMark name="typescript" size={20} /> TypeScript</span><small>Recorded tool transcript · edited replay</small></div>
  <div class="session-progress" aria-hidden="true">{story.frames.map((_, i) => <span data-progress={i}></span>)}</div>
  {story.frames.map((frame, i) => <section class="session-frame" data-frame={i} hidden={i !== 0} aria-label={`Chapter ${i + 1}: ${frame.title}`}>
    <h2>{frame.title}</h2><p class="frame-label">{frame.label}</p>
    <pre tabindex="0"><code>{frame.code}</code></pre>
    <p class="frame-footer">{frame.footer}</p>
  </section>)}
  <div class="session-controls"><button type="button" data-previous aria-label="Previous chapter">← Previous</button><span data-chapter-label>1 / {story.frames.length}</span><button type="button" data-next aria-label="Next chapter">Next →</button></div>
</div>
<script>
  function setupSessionReplays() {
    document.querySelectorAll<HTMLElement>('[data-session-replay]').forEach(root => {
      if (root.dataset.ready) return; root.dataset.ready = 'true';
      const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
      const show = (index: number) => {
        const selected = (index + frames.length) % frames.length; root.dataset.chapter = String(selected);
        frames.forEach((frame, i) => frame.hidden = i !== selected);
        root.querySelector('[data-chapter-label]')!.textContent = `${selected + 1} / ${frames.length}`;
        root.querySelectorAll<HTMLElement>('[data-progress]').forEach((part, i) => part.classList.toggle('complete', i <= selected));
      };
      root.querySelector('[data-previous]')!.addEventListener('click', () => show(Number(root.dataset.chapter) - 1));
      root.querySelector('[data-next]')!.addEventListener('click', () => show(Number(root.dataset.chapter) + 1));
      show(0);
    });
  }
  setupSessionReplays(); document.addEventListener('astro:page-load', setupSessionReplays);
</script>
<style>
  .session-replay { color:#f4ece0; background:#1a1512; border:1px solid #5e4e3d; border-radius:1rem; overflow:hidden; }
  .session-top { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1.2rem 2rem; border-bottom:1px solid #44382d; }.session-top>span { display:flex; gap:.7rem; align-items:center; font-size:.95rem; }.divider { color:#9e8b77; }.session-top small { font-size:.75rem; color:#d5cabc; }
  .session-progress { display:flex; gap:4px; padding:0 2rem; }.session-progress>span { height:3px; background:#44382d; flex:1; }.session-progress>.complete { background:#cead71; }
  .session-frame { padding:2rem; min-height:500px; }.session-frame[hidden] { display:none; }.session-frame h2 { color:#f4ece0; font-size:clamp(1.7rem,3vw,2.7rem); margin:0 0 1.2rem; line-height:1.2; }.frame-label { text-transform:uppercase; letter-spacing:.06em; font-size:.7rem; color:#d5cabc; margin:0 0 1rem; }.session-frame pre { background:#1a1512; color:#f4ece0; font-family:var(--qf-code-font-family); font-size:clamp(.72rem,1.45vw,1.04rem); line-height:1.7; margin:0; white-space:pre-wrap; overflow-wrap:anywhere; }.frame-footer { color:#d5cabc; font-size:.78rem; line-height:1.7; margin:1.7rem 0 0; max-width:90ch; }
  .session-controls { display:flex; align-items:center; justify-content:space-between; padding:1rem 2rem; border-top:1px solid #44382d; font-size:.8rem; color:#d5cabc; }.session-controls button { cursor:pointer; padding:.4rem .6rem; border:1px solid #9e8b77; border-radius:.3rem; color:#f4ece0; }.session-controls button:focus-visible { outline:2px solid #cead71; outline-offset:4px; }
  @media(max-width:600px) { .session-top { align-items:flex-start; flex-direction:column; padding:1rem; }.session-frame { padding:1.2rem; min-height:500px; }.session-controls { padding:1rem; } }
</style>
