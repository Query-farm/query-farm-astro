---
/**
 * The "On this page" rail for VGI family-C pages.
 *
 * It sits in the FIRST column now, where "In this section" used to. That list
 * was a second copy of the subnav directly above it — same section, same
 * routes — and every VGI route is reachable from the subnav's tabs and hover
 * panels, so it was duplication rather than a second affordance. Dropping it
 * frees a column: the TOC moves out of the 200px right rail it was cramped in,
 * and the prose gets the difference.
 *
 * Nine pages each had their own copy of this markup. One component means the
 * rail can't drift page to page again.
 */
import { TOC_ASIDE } from '../../lib/vgi-layout';

export interface TocItem {
  /** Target element id, without the `#`. */
  id: string;
  label: string;
  /** Nested one level under the preceding top-level item. */
  sub?: boolean;
}

interface Props {
  items: TocItem[];
  /** Extra links below the TOC (e.g. a reference page). */
  reference?: { label: string; href: string }[];
}

const { items, reference = [] } = Astro.props;

const LINK = 'block border-l-2 border-soil-200 py-1 text-[13px] text-soil-700 no-underline transition hover:border-soil-300 hover:text-soil-900';
---

<aside class={TOC_ASIDE}>
  <h2 class="mb-2.5 text-[12.5px] font-semibold text-soil-500">On this page</h2>
  <ul class="flex flex-col gap-0.5">
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} class:list={[LINK, item.sub ? 'pl-5 pr-2.5' : 'px-2.5']}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  {
    reference.length > 0 && (
      <>
        <h2 class="mt-7 mb-2.5 text-[12.5px] font-semibold text-soil-500">Reference</h2>
        <ul class="flex flex-col gap-0.5">
          {reference.map((r) => (
            <li>
              <a href={r.href} class:list={[LINK, 'px-2.5']}>
                {r.label}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</aside>
