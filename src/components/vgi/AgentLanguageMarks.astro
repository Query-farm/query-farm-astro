---
import BrandMark from './BrandMark.astro';
import { VGI_AGENTS, VGI_AGENT_LANGUAGES } from '../../lib/vgi-agents';
interface Props { kind?: 'agents' | 'languages'; }
const { kind = 'agents' } = Astro.props;
const items = kind === 'agents' ? VGI_AGENTS : VGI_AGENT_LANGUAGES;
---
<ul class="brand-list not-prose" aria-label={kind === 'agents' ? 'Coding agents' : 'Worker languages'}>
  {items.map(item => <li><BrandMark name={item.id} size={22} /><span>{item.name}</span></li>)}
</ul>
<style>
  .brand-list { display:flex; flex-wrap:wrap; gap:1rem 1.5rem; list-style:none; padding:0; margin:1.25rem 0; }
  .brand-list li { display:flex; align-items:center; gap:.55rem; color:var(--color-soil-900); font-size:.875rem; margin:0; padding:0; }
</style>
