---
import { Icon } from 'astro-icon/components';
const examples = [
  { id:'github', target:'api', icon:'mdi:github', label:'Connect an API', ask:'Put GitHub releases in a table. Join them to my project inventory.', payoff:'Live release data + a local CSV → one query.' },
  { id:'files', target:'files', icon:'mdi:folder-image', label:'Gather local data', ask:'Scan my photo folder. Let me query the camera, date, and GPS metadata.', payoff:'Files on disk → rows you can filter and group.' },
  { id:'api', target:'api', icon:'mdi:cloud-outline', label:'Bring in a data service', ask:'Join our support tickets to the customer data in this CSV.', payoff:'Your service + your data → answers across both.' },
  { id:'library', target:'library', icon:'mdi:code-braces', label:'Use your existing code', ask:'Use our validation library to find invalid records in DuckDB.', payoff:'The rules your app uses → the same rules in SQL.' },
];
---
<div class="integration-showcase not-prose" data-integration-showcase>
  <div class="audience" data-audience>
    <div class="audience-tabs" role="tablist" aria-label="Choose your introduction">
      <button id="audience-new" role="tab" aria-selected="true" aria-controls="intro-new" tabindex="0" data-audience-tab="new">New to database extensions?</button>
      <button id="audience-dev" role="tab" aria-selected="false" aria-controls="intro-dev" tabindex="-1" data-audience-tab="dev">Familiar with extensions?</button>
    </div>
    <div id="intro-new" role="tabpanel" aria-labelledby="audience-new" data-audience-panel="new">
      <p><strong>Give your database a new ability.</strong> An extension adds capabilities to DuckDB. VGI lets it call a separate program—a worker—that fetches data or runs your code. Your coding agent can build that program, so your next query can reach an API, a service, or data on your computer.</p>
    </div>
    <div id="intro-dev" role="tabpanel" aria-labelledby="audience-dev" data-audience-panel="dev" hidden>
      <p><strong>Build a worker behind the VGI extension.</strong> Install VGI in stock DuckDB, then ask your agent to expose typed scalar functions, table functions, or a catalog using one of six language SDKs. The worker is a separate process; your deliverable is its source and SQL tests. <a href="/vgi/architecture/">See the protocol and execution model →</a></p>
    </div>
  </div>
  <div class="ideas-heading"><h2>What would you ask your agent to build?</h2><p>Start with one of these ideas, or bring your own. Your agent will ask which language you want to use.</p></div>
  <div class="ideas-grid">
    {examples.map(example => <a class="idea" href={`#request-${example.target}`} data-integration-idea={example.id}>
      <span class="idea-label"><Icon name={example.icon} size={23} />{example.label}</span>
      <span class="idea-ask">“{example.ask}”</span>
      <span class="idea-payoff">{example.payoff}</span>
      <span class="idea-action">Get a starting request <span aria-hidden="true">↗</span></span>
    </a>)}
  </div>

</div>
<script>
  function setupShowcases() {
    document.querySelectorAll<HTMLElement>('[data-integration-showcase]').forEach(root => {
      if (root.dataset.ready) return; root.dataset.ready = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-audience-tab]')];
      const activate = (tab: HTMLButtonElement) => {
        tabs.forEach(item => { const active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
        root.querySelectorAll<HTMLElement>('[data-audience-panel]').forEach(panel => panel.hidden = panel.dataset.audiencePanel !== tab.dataset.audienceTab);
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activate(tab));
        tab.addEventListener('keydown', event => {
          if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
          event.preventDefault(); const next = event.key === 'Home' ? tabs[0] : event.key === 'End' ? tabs.at(-1)! : tabs[(i + 1) % tabs.length]; activate(next); next.focus();
        });
      });
    });
  }
  setupShowcases(); document.addEventListener('astro:page-load', setupShowcases);
</script>
<style>
  .integration-showcase { color:var(--color-soil-900); margin-top:2rem; }.audience-tabs { display:flex; gap:1.5rem; border-bottom:1px solid var(--color-soil-300); }.audience-tabs button { padding:.7rem 0; font-size:.85rem; cursor:pointer; border-bottom:3px solid transparent; color:var(--color-soil-700); }.audience-tabs [aria-selected="true"] { color:var(--color-soil-900); border-color:var(--color-field-700); font-weight:600; }.audience [role="tabpanel"] { max-width:95ch; font-size:.9rem; line-height:1.8; padding:1rem 0; }.audience a { color:var(--color-field-700); text-decoration:underline; }.ideas-heading { margin:1.3rem 0 1rem; }.ideas-heading h2 { font-size:1.6rem; line-height:1.3; margin:0; }.ideas-heading p { margin:.5rem 0 0; color:var(--color-soil-700); font-size:.85rem; }
  .ideas-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }.idea { display:flex; flex-direction:column; text-align:left; border:1px solid var(--color-soil-300); border-radius:.7rem; padding:1.3rem 1.5rem; background:#fffdf7; cursor:pointer; transition:border-color .2s,transform .2s; }.idea:hover { border-color:var(--color-field-700); transform:translateY(-2px); }.idea-label { display:flex; gap:.6rem; align-items:center; color:var(--color-sun-700); font-size:.78rem; font-weight:600; }.idea-ask { display:block; font-size:1.03rem; line-height:1.65; margin:.8rem 0; max-width:44ch; }.idea-payoff { display:block; font-size:.77rem; line-height:1.7; color:var(--color-soil-600); margin-top:auto; }.idea-action { display:flex; align-items:center; justify-content:space-between; font-size:.77rem; color:var(--color-field-700); margin-top:1rem; }button:focus-visible, .idea:focus-visible { outline:2px solid var(--color-field-700); outline-offset:4px; }
  @media(max-width:650px) { .ideas-grid { grid-template-columns:1fr; }.audience-tabs { gap:1rem; }.audience-tabs button { text-align:left; font-size:.8rem; } }
  @media(prefers-reduced-motion:reduce) { .idea { transition:none; }.idea:hover { transform:none; } }
</style>
