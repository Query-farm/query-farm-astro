---
/**
 * The Data-as-a-Service diagram — a four-column flow, unlike BigPictureDiagram's
 * two-sided fan (which this file borrows its visual language from: same box
 * style, same DuckDB mark, same animated-packet wires, same `iconTransform`
 * helper). Reading order is fixed left-to-right and never mirrored — unlike
 * BigPictureDiagram, this one only ever appears on this one page, so there's
 * no second orientation to keep in sync.
 *
 *   [Consumers]  →  [DuckDB]  →  [VGI]  →  [Your services]
 *
 * Consumers (SQL, Excel, ODBC, Browser) reach DuckDB directly, over whatever
 * protocol DuckDB itself already speaks — nothing here is VGI-specific, it's
 * the point that any of DuckDB's existing client ecosystem becomes a DaaS
 * front door for free. VGI is strictly the DuckDB-to-backend leg. The three
 * service boxes are illustrative (earthquake/finance/sales — the examples
 * used in the page copy around this diagram), not a claim that pre-built
 * workers exist for them.
 */

// ── The DuckDB mark — identical to BigPictureDiagram's, real brand colors ──
const DUCKDB_MARK = {
  vb: { x: 217.6, y: 10, w: 334.4, h: 334.4 },
  body: `
    <path fill="#000" d="M384.8,344.4L384.8,344.4c-92.5,0-167.2-74.7-167.2-167.2l0,0C217.6,84.7,292.3,10,384.8,10l0,0 C477.3,10,552,84.7,552,177.2l0,0C552,269.6,477.3,344.4,384.8,344.4z"/>
    <path fill="#fff100" d="M474.2,152.2h-32.8v49.5h32.8c13.7,0,24.9-11.3,24.9-24.9S487.9,152.2,474.2,152.2"/>
    <path fill="#fff100" d="M280.7,177.1c0,38.2,31.1,69.3,69.3,69.3c38.2,0,69.3-31.1,69.3-69.3s-31.1-69.3-69.3-69.3 C311.8,107.8,280.7,138.9,280.7,177.1L280.7,177.1"/>
  `,
};

// Phosphor (256x256) and simple-icons (24x24) both used here, each icon
// carrying its own viewBox rather than assuming one — the two sets don't share
// a coordinate space.
const PH_VB = { x: 0, y: 0, w: 256, h: 256 };
const SI_VB = { x: 0, y: 0, w: 24, h: 24 };

// Consumers reach DuckDB itself — real DuckDB client surfaces, not VGI's
// concern. "SQL" stands in for any SQL client/CLI (ph:terminal-window); ODBC
// has no brand mark of its own, so a generic plug icon stands in for "a
// driver," which is what ODBC actually is.
const CONSUMERS = [
  {
    name: 'SQL',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M128 128a8 8 0 0 1-3 6.25l-40 32a8 8 0 1 1-10-12.5L107.19 128L75 102.25a8 8 0 1 1 10-12.5l40 32a8 8 0 0 1 3 6.25m48 24h-40a8 8 0 0 0 0 16h40a8 8 0 0 0 0-16m56-96v144a16 16 0 0 1-16 16H40a16 16 0 0 1-16-16V56a16 16 0 0 1 16-16h176a16 16 0 0 1 16 16m-16 144V56H40v144z"/>',
  },
  {
    name: 'Excel',
    vb: SI_VB,
    body: '<path fill="currentColor" d="M23 1.5q.41 0 .7.3q.3.29.3.7v19q0 .41-.3.7q-.29.3-.7.3H7q-.41 0-.7-.3q-.3-.29-.3-.7V18H1q-.41 0-.7-.3q-.3-.29-.3-.7V7q0-.41.3-.7Q.58 6 1 6h5V2.5q0-.41.3-.7q.29-.3.7-.3zM6 13.28l1.42 2.66h2.14l-2.38-3.87l2.34-3.8H7.46l-1.3 2.4l-.05.08l-.04.09l-.64-1.28l-.66-1.29H2.59l2.27 3.82l-2.48 3.85h2.16zM14.25 21v-3H7.5v3zm0-4.5v-3.75H12v3.75zm0-5.25V7.5H12v3.75zm0-5.25V3H7.5v3zm8.25 15v-3h-6.75v3zm0-4.5v-3.75h-6.75v3.75zm0-5.25V7.5h-6.75v3.75zm0-5.25V3h-6.75v3Z"/>',
  },
  {
    name: 'ODBC',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M237.66 66.34a8 8 0 0 0-11.32 0L192 100.69L155.31 64l34.35-34.34a8 8 0 1 0-11.32-11.32L144 52.69l-26.34-26.35a8 8 0 0 0-11.32 11.32l6.35 6.34l-53 53a40 40 0 0 0 0 56.57l15.71 15.71l-49.06 49.06a8 8 0 0 0 11.32 11.32l49.09-49.09l15.71 15.71a40 40 0 0 0 56.57 0l53-53l6.34 6.35a8 8 0 0 0 11.32-11.32L203.31 112l34.35-34.34a8 8 0 0 0 0-11.32M147.72 185a24 24 0 0 1-33.95 0L71 142.23a24 24 0 0 1 0-33.95l53-53L200.69 132Z"/>',
  },
  {
    name: 'Browser',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16m0 16v32H40V56Zm0 144H40v-96h176z"/>',
  },
];

// Illustrative only — these three exist to echo the earthquake/finance/sales
// examples in the page copy right around this diagram, not to claim a
// pre-built worker for any of them.
const SERVICES = [
  {
    name: 'Earthquake data',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M164 80a28 28 0 1 0-28-28a28 28 0 0 0 28 28m0-40a12 12 0 1 1-12 12a12 12 0 0 1 12-12m90.88 155.92l-54.56-92.08A15.87 15.87 0 0 0 186.55 96a15.85 15.85 0 0 0-13.76 7.84L146.63 148l-44.84-76.1a16 16 0 0 0-27.58 0L1.11 195.94A8 8 0 0 0 8 208h240a8 8 0 0 0 6.88-12.08M88 80l23.57 40H64.43ZM22 192l33-56h66l18.74 31.8L154 192Zm150.57 0l-16.66-28.28L186.55 112L234 192Z"/>',
  },
  {
    name: 'Finance data',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M152 120h-16V56h8a32 32 0 0 1 32 32a8 8 0 0 0 16 0a48.05 48.05 0 0 0-48-48h-8V24a8 8 0 0 0-16 0v16h-8a48 48 0 0 0 0 96h8v64h-16a32 32 0 0 1-32-32a8 8 0 0 0-16 0a48.05 48.05 0 0 0 48 48h16v16a8 8 0 0 0 16 0v-16h16a48 48 0 0 0 0-96m-40 0a32 32 0 0 1 0-64h8v64Zm40 80h-16v-64h16a32 32 0 0 1 0 64"/>',
  },
  {
    name: 'Sales data',
    vb: PH_VB,
    body: '<path fill="currentColor" d="M240 56v64a8 8 0 0 1-16 0V75.31l-82.34 82.35a8 8 0 0 1-11.32 0L96 123.31l-66.34 66.35a8 8 0 0 1-11.32-11.32l72-72a8 8 0 0 1 11.32 0L136 140.69L212.69 64H168a8 8 0 0 1 0-16h64a8 8 0 0 1 8 8"/>',
  },
];

// transform placing a viewBox-relative icon's own origin at (0,0), scaled to
// `size`, then positioned so it's centered at (cx, cy) — identical helper to
// BigPictureDiagram's, duplicated rather than imported since Astro components
// don't share a script scope and this is four lines.
const iconTransform = (vb: { x: number; y: number; w: number; h: number }, size: number, cx: number, cy: number) => {
  const s = size / vb.w;
  const tx = cx - (vb.w / 2) * s - vb.x * s;
  const ty = cy - (vb.h / 2) * s - vb.y * s;
  return `translate(${tx.toFixed(2)},${ty.toFixed(2)}) scale(${s.toFixed(5)})`;
};

// ── Layout — vertical rhythm derived from the larger side (4 consumers),
// matching BigPictureDiagram's own BOX_H/BOX_GAP/MARGIN_Y exactly so this
// diagram reads as the same visual system, not a reskin. The 3-item service
// column distributes evenly across the same height rather than getting its
// own (smaller) rhythm, so it stays vertically centered against the 4-item
// side instead of clustering oddly.
const BOX_H = 52;
const BOX_GAP = 40;
const MARGIN_Y = 40;
const contentH = CONSUMERS.length * BOX_H + (CONSUMERS.length - 1) * BOX_GAP;
const VB_H = contentH + MARGIN_Y * 2;
const centerY = VB_H / 2;

const consumerRows = CONSUMERS.map((c, i) => ({
  ...c,
  cy: MARGIN_Y + BOX_H / 2 + i * (BOX_H + BOX_GAP),
}));
const serviceContentH = SERVICES.length * BOX_H + (SERVICES.length - 1) * BOX_GAP;
const serviceStartY = (VB_H - serviceContentH) / 2;
const serviceRows = SERVICES.map((s, i) => ({
  ...s,
  cy: serviceStartY + BOX_H / 2 + i * (BOX_H + BOX_GAP),
}));

const MARGIN_X = 30;
const CONSUMER_X = MARGIN_X;
const CONSUMER_W = 160;
const ICON_S = 20;
const ICON_PAD = 12;
const TEXT_GAP = 8;
const ICON_CENTER_OFFSET = ICON_PAD + ICON_S / 2;
const TEXT_OFFSET = ICON_PAD + ICON_S + TEXT_GAP;

const DDB_X = CONSUMER_X + CONSUMER_W + 90;
const DDB_W = 190;
const DDB_H = 130;
const DDB_Y = centerY - DDB_H / 2;
const ddbCenterX = DDB_X + DDB_W / 2;

const GW_X = DDB_X + DDB_W + 80;
const GW_W = 190;
const GW_H = 200;
const GW_Y = centerY - GW_H / 2;
const LOGO_W = 130;
const LOGO_H = Math.round((LOGO_W * 437) / 600); // vgi-logo.png's real aspect ratio
const LOGO_X = GW_X + (GW_W - LOGO_W) / 2;
const LOGO_Y = GW_Y + 12;

const SERVICE_X = GW_X + GW_W + 90;
const SERVICE_W = 200;

const VB_W = SERVICE_X + SERVICE_W + MARGIN_X;

// Wires: consumers fan into DuckDB's left edge; one straight wire from
// DuckDB to VGI; VGI fans out to the three service boxes.
const consumerWires = consumerRows.map((c, i) => ({
  id: `daas-wire-in-${i}`,
  d: `M${CONSUMER_X + CONSUMER_W} ${c.cy} C ${DDB_X - 70} ${c.cy} ${DDB_X - 40} ${centerY} ${DDB_X} ${centerY}`,
  begin: `${(i * 0.4).toFixed(2)}s`,
}));
const mainWireD = `M${DDB_X + DDB_W} ${centerY} L${GW_X} ${centerY}`;
const serviceWires = serviceRows.map((s, i) => ({
  id: `daas-wire-out-${i}`,
  d: `M${GW_X + GW_W} ${centerY} C ${SERVICE_X - 40} ${centerY} ${SERVICE_X - 70} ${s.cy} ${SERVICE_X} ${s.cy}`,
  begin: `${(i * 0.4).toFixed(2)}s`,
}));

const ariaLabel =
  'Diagram: SQL, Excel, ODBC, and browser clients connect to DuckDB directly; DuckDB reaches your own services through the VGI extension.';
const CARD = 'rounded-xl border border-soil-300 bg-[#fffdf7]';
---

<div class={`${CARD} p-4 md:p-6`}>
  <svg
    class="daas-flow w-full h-auto"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    role="img"
    aria-label={ariaLabel}
  >
    <!-- Wires (drawn first, under the nodes) -->
    {consumerWires.map(w => <path id={w.id} d={w.d} fill="none" class="stroke-soil-300" stroke-width="2.5" />)}
    <path id="daas-wire-main" d={mainWireD} fill="none" class="stroke-soil-300" stroke-width="2.5" />
    {serviceWires.map(w => <path id={w.id} d={w.d} fill="none" class="stroke-soil-300" stroke-width="2.5" />)}

    <!-- Flow packets -->
    {consumerWires.map(w => (
      <circle r="5" class="fill-sun-500">
        <animateMotion dur="2.4s" repeatCount="indefinite" begin={w.begin}>
          <mpath xlink:href={`#${w.id}`} />
        </animateMotion>
      </circle>
    ))}
    <circle r="6" class="fill-sun-400">
      <animateMotion dur="1.6s" repeatCount="indefinite" begin="0.3s">
        <mpath xlink:href="#daas-wire-main" />
      </animateMotion>
    </circle>
    <circle r="4.5" class="fill-field-600">
      <animateMotion dur="2s" repeatCount="indefinite" begin="1s" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
        <mpath xlink:href="#daas-wire-main" />
      </animateMotion>
    </circle>
    {serviceWires.map(w => (
      <circle r="4" class="fill-field-600">
        <animateMotion dur="2.6s" repeatCount="indefinite" begin={w.begin} keyPoints="1;0" keyTimes="0;1" calcMode="linear">
          <mpath xlink:href={`#${w.id}`} />
        </animateMotion>
      </circle>
    ))}

    <!-- Consumers -->
    {consumerRows.map(c => {
      const iconCx = CONSUMER_X + ICON_CENTER_OFFSET;
      return (
        <g>
          <rect x={CONSUMER_X} y={c.cy - BOX_H / 2} width={CONSUMER_W} height={BOX_H} rx="12" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2.5" />
          <g class="text-soil-700" transform={iconTransform(c.vb, ICON_S, iconCx, c.cy)} set:html={c.body} />
          <text x={CONSUMER_X + TEXT_OFFSET} y={c.cy + 5} text-anchor="start" class="fill-soil-900 font-bold" font-size="14" font-family="inherit">{c.name}</text>
        </g>
      );
    })}

    <!-- DuckDB -->
    <rect x={DDB_X} y={DDB_Y} width={DDB_W} height={DDB_H} rx="18" class="fill-soil-100 stroke-soil-900" stroke-width="3" />
    <g transform={iconTransform(DUCKDB_MARK.vb, 46, ddbCenterX, DDB_Y + 41)} set:html={DUCKDB_MARK.body} />
    <text x={ddbCenterX} y={DDB_Y + 104} text-anchor="middle" class="fill-soil-900 font-extrabold" font-size="26" font-family="inherit">DuckDB</text>

    <!-- VGI extension -->
    <rect x={GW_X} y={GW_Y} width={GW_W} height={GW_H} rx="18" class="fill-[#fffdf7] stroke-soil-900" stroke-width="3" />
    <image href="/vgi/vgi-logo.png" x={LOGO_X} y={LOGO_Y} width={LOGO_W} height={LOGO_H} />
    <text x={GW_X + GW_W / 2} y={GW_Y + 132} text-anchor="middle" class="fill-sun-700 font-bold" font-size="13" font-family="inherit" letter-spacing="1.5">VGI EXTENSION</text>
    <text x={GW_X + GW_W / 2} y={GW_Y + 163} text-anchor="middle" class="fill-soil-700 font-bold" font-size="12" font-family="inherit">Your access control</text>
    <text x={GW_X + GW_W / 2} y={GW_Y + 180} text-anchor="middle" class="fill-soil-700 font-bold" font-size="12" font-family="inherit">policies here</text>

    <!-- Services -->
    {serviceRows.map(s => {
      const iconCx = SERVICE_X + ICON_CENTER_OFFSET;
      return (
        <g>
          <rect x={SERVICE_X} y={s.cy - BOX_H / 2} width={SERVICE_W} height={BOX_H} rx="12" class="fill-[#fffdf7] stroke-soil-900" stroke-width="2.5" />
          <g class="text-soil-700" transform={iconTransform(s.vb, ICON_S, iconCx, s.cy)} set:html={s.body} />
          <text x={SERVICE_X + TEXT_OFFSET} y={s.cy + 5} text-anchor="start" class="fill-soil-900 font-bold" font-size="14" font-family="inherit">{s.name}</text>
        </g>
      );
    })}
  </svg>
</div>

<script>
  // Same reduced-motion contract as BigPictureDiagram — pause the SMIL packet
  // animations, nothing here needs the rotator logic since every box is fixed.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('svg.daas-flow').forEach((s) => {
      const svg = s as SVGSVGElement & { pauseAnimations?: () => void };
      svg.pauseAnimations?.();
    });
  }
</script>
