---
// Click-to-play YouTube embed. The page ships only a poster and a link; the
// player (~1 MB of YouTube script, plus its cookies) loads from
// youtube-nocookie.com when someone presses play. Without JavaScript the
// poster is an ordinary link to the video on YouTube.
interface Props {
  /** YouTube video id, e.g. "J2E51PTZn6o" */
  id: string;
  title: string;
  /** local poster image; 16:9 */
  poster: string;
  /** shown under the player, e.g. "2:36" */
  duration?: string;
}
const { id, title, poster, duration } = Astro.props;
const watch = `https://youtu.be/${id}`;
---

<figure class="yt not-content">
  <div class="yt__frame" data-yt-id={id} data-yt-title={title}>
    <a class="yt__link" href={watch} aria-label={`Play video: ${title}`}>
      <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
      <span class="yt__play" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M7 4.5v15l12.5-7.5z"></path></svg>
      </span>
    </a>
  </div>
  <figcaption class="yt__caption">
    {title}{duration && <> · <span class="yt__duration">{duration}</span></>} · <a href={watch}>YouTube</a>
  </figcaption>
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('.yt__frame')) {
    frame.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      // rel=0 limits the end-screen suggestions to this channel's own videos
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.ytTitle ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .yt {
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }
  .yt__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--qf-rule);
    /* code ground: the player area is dark before and after it loads */
    background: #1a1512;
    box-shadow: 0 18px 40px -24px var(--qf-shadow);
  }
  .yt__link,
  .yt__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .yt__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* sun-400 disc with an ink glyph: the brand's one gold, on a dark poster */
  .yt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    border-radius: 50%;
    background: #d9a441;
    box-shadow: 0 14px 30px -10px rgb(16 13 10 / 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }
  .yt__play svg {
    width: 36px;
    height: 36px;
    margin-left: 5px;
    fill: #211a12;
  }
  .yt__link:hover .yt__play,
  .yt__link:focus-visible .yt__play {
    transform: scale(1.08);
  }
  .yt__link:focus-visible {
    outline: 3px solid var(--qf-accent);
    outline-offset: -3px;
  }
  .yt__caption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--qf-ink-3);
  }
  /* a duration is a figure: tabular sans (brief §2) */
  .yt__duration {
    font-variant-numeric: tabular-nums;
  }
  .yt__caption a {
    color: inherit;
  }
  @media (max-width: 480px) {
    .yt__play {
      width: 60px;
      height: 60px;
      margin: -30px 0 0 -30px;
    }
    .yt__play svg {
      width: 26px;
      height: 26px;
      margin-left: 4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .yt__play {
      transition: none;
    }
  }
</style>
