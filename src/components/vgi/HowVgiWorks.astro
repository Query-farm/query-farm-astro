---
import { Icon } from 'astro-icon/components';
import BrandMark from './BrandMark.astro';
const steps = [
  { label: 'Your agent builds', title: 'Describe the connection you need.', text: 'Your coding agent uses the VGI skill to write a worker and test it with real SQL. You choose the language; you keep the code.' },
  { label: 'ATTACH the worker', title: 'Bring a database into your session.', text: 'ATTACH connects to the worker and registers its catalog—named github in this example. DuckDB can discover its schemas, tables, and functions alongside your other databases.' },
  { label: 'Query its catalog', title: 'Query the catalog you just attached.', text: 'GitHub releases live behind an API, but now github.main.releases(...) is a table function in your attached catalog. Your SQL calls the worker through VGI.' },
  { label: 'The worker fetches', title: 'Your worker connects to what you need.', text: 'This example calls GitHub. Your worker can connect to other APIs and data services, read local files, or use your own libraries. The coding agent’s job is already done.' },
  { label: 'Rows come back', title: 'Now the data is part of your query.', text: 'The worker returns typed rows in Arrow batches through VGI. Therefore DuckDB can filter, aggregate, and join those rows with your local project inventory.' },
];
const agents = [
  { id: 'codex', label: 'Codex' }, { id: 'claude-code', label: 'Claude Code' },
  { id: 'cursor', label: 'Cursor' }, { id: 'github-copilot', label: 'Copilot' },
  { id: 'opencode', label: 'OpenCode' },
];
const sources = [
  { id: 'github', name: 'GitHub', detail: 'Example shown', icon: null },
  { id: 'apis', name: 'APIs', detail: 'Your external endpoints', icon: 'mdi:api' },
  { id: 'services', name: 'Data services', detail: 'Support, analytics, finance', icon: 'mdi:cloud-outline' },
  { id: 'files', name: 'Local files', detail: 'Photos, documents, logs', icon: 'mdi:folder-open-outline' },
  { id: 'libraries', name: 'Your libraries', detail: 'The code you already use', icon: 'mdi:code-braces' },
];
const branches = [
  'M0 126 H22 Q42 126 42 106 V42 Q42 22 62 22 H100',
  'M0 126 H22 Q42 126 42 106 V94 Q42 74 62 74 H100',
  'M0 126 H100',
  'M0 126 H22 Q42 126 42 146 V158 Q42 178 62 178 H100',
  'M0 126 H22 Q42 126 42 146 V210 Q42 230 62 230 H100',
];
---
<section class="vgi-explainer not-prose" aria-labelledby="vgi-explainer-title" data-vgi-explainer data-step="0" data-playing="false">
  <div class="explainer-heading">
    <div><p class="eyebrow">How VGI works</p><h2 id="vgi-explainer-title">From an API to a SQL catalog with tables.</h2></div>
    <button class="playback" type="button" data-playback hidden><span class="play-icon"><Icon name="mdi:play-circle-outline" size={19} /></span><span class="pause-icon"><Icon name="mdi:pause-circle-outline" size={19} /></span><span data-playback-label>Play animation</span></button>
  </div>
  <p class="intro">You <strong>ATTACH a VGI worker as a database</strong> in your DuckDB session. Its catalog exposes schemas, tables, and functions backed by your APIs, files, or code.</p>

  <div class="diagram" role="group" aria-label="Your coding agent builds the VGI worker. ATTACH adds its catalog as a database in DuckDB. The worker connects your queries to APIs, data services, local files, or libraries. GitHub is the example shown.">
    <div class="builder">
      <span class="builder-heading">Your coding agent builds the worker</span>
      <div class="agent-options" aria-label="Coding agents">
        {agents.map(agent => <span class={`agent-option agent-${agent.id}`}><span class="agent-icon"><BrandMark name={agent.id} size={32} /></span><span>{agent.label}</span></span>)}
      </div>
      <span class="build-link"><span>Builds + tests</span><i aria-hidden="true"></i></span>
    </div>
    <div class="runtime">
      <div class="node database">
        <div class="database-heading"><BrandMark name="duckdb" size={31} /><strong>DuckDB session</strong><span class="extension">VGI extension</span></div>
        <div class="session-catalogs">
          <p class="session-label">Databases</p>
          <div class="local-database"><Icon name="mdi:database-outline" size={16} /><span>memory</span><small>local</small></div>
          <div class="attached-catalog" data-attached-catalog>
            <div class="catalog-name"><Icon name="mdi:database-check-outline" size={17} /><strong>github</strong><small>attached</small></div>
            <div class="catalog-schema"><Icon name="mdi:folder-outline" size={14} /><span>main</span><small>schema</small></div>
            <div class="catalog-function"><Icon name="mdi:table" size={14} /><span>releases(…)</span></div>
            <span class="function-kind">table function → rows</span>
          </div>
          <span class="attach-placeholder">Your worker’s catalog appears here.</span>
        </div>
        <span class="returned" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="connection vgi-link" aria-hidden="true"><span class="outbound"><span class="call-label">Call</span><span class="attach-label">ATTACH</span></span><span class="inbound">Rows</span><div class="track"><i class="packet"></i><i class="packet"></i><i class="packet"></i></div></div>
      <div class="node worker">
        <picture class="worker-emblem">
          <source srcset="/vgi/vgi-hero.webp" type="image/webp" />
          <img src="/vgi/vgi-hero.png" alt="VGI worker" width="900" height="662" loading="lazy" />
        </picture>
        <strong>Your VGI worker</strong>
      </div>
      <div class="source-branches" aria-hidden="true">
        <svg viewBox="0 0 100 252" preserveAspectRatio="none" fill="none">
          {branches.map((path, i) => <path d={path} class:list={['branch', i === 0 && 'example-branch']} vector-effect="non-scaling-stroke" />)}
          <path d={branches[0]} class="branch-signal" pathLength="100" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
      <div class="source">
        <h3 class="source-heading">Your data &amp; code</h3>
        <ul class="source-list" role="list" aria-label="Possible worker connections">
          {sources.map(source => <li class={`source-option source-${source.id}`}>
            <span class="source-icon">{source.icon ? <Icon name={source.icon} size={21} /> : <BrandMark name="github" size={22} />}</span>
            <span class="source-copy"><strong>{source.name}</strong><span>{source.detail}</span></span>
          </li>)}
        </ul>
      </div>
    </div>
    <div class="query-strip">
      <div class="sql-line attach-sql"><span class="query-label">Attach a database</span><code><span class="sql-keyword">ATTACH</span> 'github' <span class="sql-keyword">AS</span> github<br />  (TYPE vgi, LOCATION '&lt;worker command&gt;');</code></div>
      <div class="sql-line select-sql"><span class="query-label">Query its catalog</span><code><span class="sql-keyword">SELECT</span> * <span class="sql-keyword">FROM</span> github.main.releases('duckdb', 'duckdb');</code></div>
      <p class="command-note">GitHub is the example here. Your agent supplies the catalog and worker command for your integration.</p>
    </div>
  </div>

  <div class="step-controls" role="group" aria-label="Animation steps" hidden>
    {steps.map((step, i) => <button type="button" data-step-button={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`vgi-explainer-step-${i}`}><span class="step-number" aria-hidden="true">{i + 1}</span><span>{step.label}</span></button>)}
  </div>
  <div class="captions">
    {steps.map((step, i) => <div id={`vgi-explainer-step-${i}`} data-step-caption={i}><h3>{step.title}</h3><p>{step.text}</p></div>)}
  </div>
  <p class="sr-only" role="status" data-step-status></p>
  <p class="explainer-footer">Choose the source your project needs. <a href="#watch">Watch the actual GitHub integration being built →</a></p>
</section>

<script>
  function setupVgiExplainers() {
    document.querySelectorAll<HTMLElement>('[data-vgi-explainer]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-step-button]')];
      const captions = [...root.querySelectorAll<HTMLElement>('[data-step-caption]')];
      const playback = root.querySelector<HTMLButtonElement>('[data-playback]')!;
      const label = root.querySelector<HTMLElement>('[data-playback-label]')!;
      const status = root.querySelector<HTMLElement>('[data-step-status]')!;
      const durations = [5000, 6000, 5200, 5200, 6000];
      let step = reducedMotion.matches ? buttons.length - 1 : 0;
      let remaining = durations[step];
      let startedAt = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let wantsPlayback = !reducedMotion.matches;
      let inView = false;
      let finished = reducedMotion.matches;

      const render = () => {
        root.dataset.step = String(step);
        playback.dataset.action = wantsPlayback ? 'pause' : 'play';
        buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === step)));
        captions.forEach((caption, i) => caption.hidden = i !== step);
        label.textContent = wantsPlayback ? 'Pause animation' : finished ? 'Replay animation' : 'Play animation';
      };
      const stopTimer = () => {
        if (timer !== undefined) {
          clearTimeout(timer);
          remaining = Math.max(0, remaining - (performance.now() - startedAt));
          timer = undefined;
        }
        root.dataset.playing = 'false';
      };
      const syncPlayback = () => {
        stopTimer();
        if (!wantsPlayback || !inView || document.hidden) return;
        root.dataset.playing = 'true';
        startedAt = performance.now();
        timer = setTimeout(() => {
          timer = undefined;
          if (step === buttons.length - 1) {
            wantsPlayback = false;
            finished = true;
            root.dataset.playing = 'false';
          } else {
            step += 1;
            remaining = durations[step];
            syncPlayback();
          }
          render();
        }, remaining);
      };
      playback.hidden = false;
      root.querySelector<HTMLElement>('.step-controls')!.hidden = false;
      playback.addEventListener('click', () => {
        if (finished) {
          stopTimer(); step = 0; remaining = durations[0]; finished = false;
        }
        wantsPlayback = !wantsPlayback;
        render(); syncPlayback();
      });
      buttons.forEach((button, i) => button.addEventListener('click', () => {
        stopTimer(); wantsPlayback = false; finished = false;
        step = i; remaining = durations[i]; render();
        status.textContent = `Step ${i + 1}. ${captions[i].textContent}`;
      }));
      const observer = new IntersectionObserver(entries => {
        inView = entries[0].isIntersecting;
        syncPlayback();
      }, { threshold: 0.25 });
      observer.observe(root);
      const visibilityChanged = () => syncPlayback();
      const motionChanged = () => {
        if (reducedMotion.matches) { stopTimer(); wantsPlayback = false; render(); }
      };
      document.addEventListener('visibilitychange', visibilityChanged);
      reducedMotion.addEventListener('change', motionChanged);
      document.addEventListener('astro:before-swap', () => {
        stopTimer(); observer.disconnect();
        document.removeEventListener('visibilitychange', visibilityChanged);
        reducedMotion.removeEventListener('change', motionChanged);
      }, { once: true });
      render();
    });
  }
  setupVgiExplainers();
  document.addEventListener('astro:page-load', setupVgiExplainers);
</script>

<style>
  .vgi-explainer { margin-top:3rem; padding:1.6rem 1.8rem 1.25rem; border:1px solid var(--color-soil-300); border-radius:1rem; background:linear-gradient(145deg,#fffdf7,#f9f7f0); color:var(--color-soil-900); }
  .explainer-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .eyebrow { font-size:.75rem; font-weight:600; color:var(--color-sun-700); margin:0 0 .35rem; }
  h2 { font-size:clamp(1.5rem,3vw,2rem); line-height:1.2; margin:0; }
  .intro { font-size:.9rem; line-height:1.75; max-width:88ch; margin:.8rem 0 0; color:var(--color-soil-700); }
  .playback { display:flex; flex:none; align-items:center; gap:.4rem; padding:.6rem .7rem; border:1px solid var(--color-soil-300); border-radius:.4rem; font-size:.76rem; cursor:pointer; color:var(--color-field-700); min-height:44px; }
  .play-icon,.pause-icon { display:flex; }.pause-icon,[data-action="pause"] .play-icon { display:none; }[data-action="pause"] .pause-icon { display:flex; }
  [hidden] { display:none!important; }
  button:focus-visible,a:focus-visible { outline:2px solid var(--color-field-700); outline-offset:4px; }
  .diagram { max-width:1040px; margin:1.7rem auto 0; }
  .builder { display:flex; align-items:center; flex-direction:column; }
  .builder-heading { font-size:.78rem; font-weight:600; margin-bottom:.8rem; }
  .agent-options { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:1rem; max-width:480px; width:100%; }
  .agent-option { display:flex; flex-direction:column; align-items:center; gap:.45rem; text-align:center; font-size:.71rem; font-weight:500; }
  .agent-icon { display:flex; align-items:center; justify-content:center; width:50px; height:50px; border:1px solid color-mix(in srgb,var(--agent-color) 22%,transparent); border-radius:50%; background:var(--agent-ground); color:var(--agent-color); }
  .agent-icon :global(.brand-mark) { --brand-size:28px!important; }
  .agent-codex { --agent-color:#087f8c; --agent-ground:#d8f1ed; }
  .agent-claude-code { --agent-color:#b95031; --agent-ground:#fae2d5; }
  .agent-cursor { --agent-color:#6843af; --agent-ground:#ede4fa; }
  .agent-github-copilot { --agent-color:#3759b6; --agent-ground:#e0eaff; }
  .agent-opencode { --agent-color:#95600c; --agent-ground:#fff0c5; }
  .build-link { position:relative; display:flex; justify-content:center; width:100%; height:32px; margin-top:8px; }
  .build-link>span { position:absolute; left:calc(50% + 12px); top:8px; font-size:.66rem; color:#245e6a; white-space:nowrap; }
  .build-link>i { border-left:1px dashed #8ca99d; }
  .runtime { --emblem-size:200px; position:relative; display:grid; grid-template-columns:minmax(0,1fr) 64px 200px 64px minmax(0,1fr); align-items:center; padding-top:28px; }
  .runtime::before { content:''; position:absolute; left:50%; top:0; height:calc(28px + (300px - var(--emblem-size))/2); border-left:1px dashed #8ca99d; }
  .runtime::after { content:''; position:absolute; left:calc(50% - 3px); top:calc(19px + (300px - var(--emblem-size))/2); width:7px; height:7px; border-right:1px solid #5e8b79; border-bottom:1px solid #5e8b79; transform:rotate(45deg); }
  .node { position:relative; min-width:0; }
  .database { width:100%; max-width:304px; justify-self:end; background:#fffefa; border:1px solid #d1bd8e; border-radius:.8rem; box-shadow:0 8px 24px #5d46320b; overflow:hidden; transition:box-shadow .35s,border-color .35s; }
  .database-heading { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:.5rem; padding:1rem .75rem .8rem; background:linear-gradient(#fff6db,#fffefa); }
  .database-heading strong { font-size:.9rem; }.extension { font-size:.68rem; padding:.15rem .5rem; background:#f4e3b3; color:#674a13; border-radius:1rem; }
  .session-catalogs { text-align:left; font-size:.73rem; padding:.6rem .9rem .9rem; position:relative; }
  .session-label { font-size:.63rem; text-transform:uppercase; letter-spacing:.09em; color:#80673c; margin:0 0 .5rem; }
  .local-database,.catalog-name,.catalog-schema,.catalog-function { display:flex; align-items:center; gap:.35rem; min-width:0; }
  .local-database { color:#756951; padding:0 .45rem .55rem; }.local-database small { margin-left:auto; }
  .attached-catalog { border:1px solid #b8c7a9; border-radius:.45rem; background:#f3f7ec; padding:.6rem; opacity:1; visibility:visible; transition:opacity .45s,transform .45s; }
  .catalog-name { color:#385529; }.catalog-name strong { font-size:.8rem; }.catalog-name small { margin-left:auto; font-size:.62rem; }
  .catalog-schema { padding:.5rem 0 .4rem .7rem; }.catalog-schema small { margin-left:auto; color:var(--color-soil-600); font-size:.62rem; }
  .catalog-function { padding-left:1.3rem; color:#245e6a; }.function-kind { display:block; padding:.3rem 0 0 1.3rem; color:var(--color-soil-700); font-size:.65rem; }
  .attach-placeholder { position:absolute; bottom:40px; left:20px; right:20px; text-align:center; font-size:.72rem; line-height:1.7; color:#80673c; display:none; }
  [data-ready="true"][data-step="0"] .attached-catalog { opacity:0; visibility:hidden; transform:translateY(8px); }
  [data-ready="true"][data-step="0"] .attach-placeholder { display:block; }
  .worker { height:300px; text-align:center; }
  .worker-emblem { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); isolation:isolate; display:flex; align-items:center; justify-content:center; width:var(--emblem-size); height:auto; aspect-ratio:1; max-width:100%; }
  .worker-emblem::before { content:''; position:absolute; inset:0; border:1px solid #ddd5be; border-radius:50%; background:radial-gradient(circle,#f5e5bd 0%,#f8f3e3 55%,#f8f5ec80 72%); box-shadow:0 0 0 9px #ded7c41c; transition:box-shadow .35s,border-color .35s; z-index:-1; }
  .worker-emblem img { display:block; width:94%; height:auto; filter:drop-shadow(0 5px 5px #48371e1c); }
  .worker>strong { position:absolute; top:calc(50% + var(--emblem-size)/2 + 12px); left:0; right:0; font-family:Petrona,serif; font-size:1.25rem; line-height:1.3; letter-spacing:-.02em; }
  .connection { color:#4c736b; font-size:.64rem; text-align:center; position:relative; }
  .track { position:relative; margin:6px 0 18px; height:1px; background:#9eb5a9; }
  .track::after { content:''; position:absolute; right:2px; top:-3px; width:7px; height:7px; border-top:1px solid currentColor; border-right:1px solid currentColor; transform:rotate(45deg); }
  .packet { position:absolute; width:7px; height:7px; left:0; top:-3px; border-radius:2px; background:#45632f; opacity:0; }
  .inbound,.attach-label { display:none; }
  [data-step="1"] .attach-label { display:inline; }[data-step="1"] .call-label { display:none; }
  .returned { position:absolute; top:14px; right:12px; display:flex; flex-direction:column; gap:4px; opacity:0; }.returned i { width:14px; height:3px; background:var(--color-field-700); border-radius:1px; }
  .source-branches { height:252px; min-width:0; }.source-branches svg { display:block; width:100%; height:100%; overflow:visible; }
  .branch { stroke:#bdc9bc; stroke-width:1; stroke-linecap:round; stroke-linejoin:round; }.example-branch { stroke:#9a8ab6; }
  .branch-signal { stroke:#75539d; stroke-width:3; stroke-linecap:round; stroke-dasharray:5 95; opacity:0; }
  .source { position:relative; min-width:0; width:100%; max-width:304px; justify-self:start; }
  .source-heading { position:absolute; top:-34px; left:0; margin:0; font-family:'Noto Sans',sans-serif; font-size:.79rem; font-weight:600; letter-spacing:normal; line-height:1.5; }
  .source-list { list-style:none; padding:0; margin:0; display:grid; gap:8px; }
  .source-option { display:flex; align-items:center; gap:.6rem; height:44px; padding:.3rem .6rem; border:1px solid #e0dbcb; border-radius:.55rem; background:#fffefa; }
  .source-icon { display:flex; align-items:center; justify-content:center; flex:0 0 30px; width:30px; height:30px; border-radius:.4rem; background:var(--source-ground); color:var(--source-ink); }
  .source-copy { display:flex; flex-direction:column; gap:.1rem; min-width:0; }.source-copy strong { font-size:.78rem; line-height:1.3; font-weight:600; }.source-copy>span { font-size:.65rem; color:var(--color-soil-700); line-height:1.4; }
  .source-github { --source-ground:#ece5f6; --source-ink:#72529e; background:#f8f4fc; border-color:#c8b5df; }
  .source-github .source-copy>span { color:#72529e; font-weight:500; }
  .source-apis { --source-ground:#e5effb; --source-ink:#3e68a5; }
  .source-services { --source-ground:#dcf0e9; --source-ink:#34785f; }
  .source-files { --source-ground:#fcf0d5; --source-ink:#94660d; }
  .source-libraries { --source-ground:#f8e7de; --source-ink:#a45838; }
  [data-step="0"] .worker-emblem::before,[data-step="3"] .worker-emblem::before { border-color:#a7b994; box-shadow:0 0 0 9px #b5c6a628; }
  [data-step="1"] .database,[data-step="2"] .database,[data-step="4"] .database { border-color:#8da475; box-shadow:0 0 0 3px #b5c6a62b,0 8px 24px #5d46320b; }
  [data-step="3"] .source-github { border-color:#9072b5; box-shadow:0 0 0 2px #c9b7e12b; }
  [data-step="0"][data-playing="true"] .runtime::after { animation:build-arrival 1.6s ease-in-out 3; }
  [data-step="1"] .vgi-link .packet,[data-step="2"] .vgi-link .packet,[data-step="4"] .vgi-link .packet { animation:packet-out 1.6s linear 4; }
  [data-step="4"] .vgi-link .packet { animation-name:packet-back; }
  [data-step="3"] .branch-signal,[data-step="4"] .branch-signal { opacity:1; animation:source-flow 1.6s linear 4; }
  [data-step="4"] .branch-signal { animation-direction:reverse; stroke:#45632f; }
  [data-step="4"] .track::after { right:auto; left:3px; transform:rotate(-135deg); }
  [data-step="4"] .outbound { display:none; }[data-step="4"] .inbound { display:inline; }[data-step="4"] .returned { opacity:1; }
  .connection .packet:nth-child(2) { animation-delay:.25s; }.connection .packet:nth-child(3) { animation-delay:.5s; }
  [data-playing="false"] .packet,[data-playing="false"] .runtime::after,[data-playing="false"] .branch-signal { animation-play-state:paused!important; }
  .query-strip { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); background:var(--color-rock-900); color:#f4ece0; border-radius:.65rem; margin-top:1.2rem; overflow:hidden; }
  .sql-line { padding:.8rem 1rem; border-top:2px solid transparent; }.select-sql { border-left:1px solid #3c352d; }
  .query-label { display:block; color:#d4c7b4; font-size:.7rem; margin-bottom:.45rem; }
  .query-strip code { font-size:.72rem; line-height:1.85; overflow-wrap:anywhere; white-space:pre-wrap; }.sql-keyword { color:#efc979; }
  [data-step="1"] .attach-sql,[data-step="2"] .select-sql,[data-step="3"] .select-sql,[data-step="4"] .select-sql { border-top-color:#d9a441; background:#252015; }
  .command-note { grid-column:1/-1; font-size:.67rem; line-height:1.7; color:#c8bba6; margin:0; padding:.5rem 1rem .7rem; border-top:1px solid #3c352d; }
  .step-controls { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.5rem; margin-top:1.3rem; }
  .step-controls button { display:flex; align-items:center; gap:.5rem; text-align:left; min-height:48px; padding:.5rem .4rem; border-bottom:2px solid var(--color-soil-300); font-size:.75rem; color:var(--color-soil-700); cursor:pointer; }
  .step-number { display:flex; flex:none; align-items:center; justify-content:center; width:23px; height:23px; border-radius:50%; background:var(--color-soil-100); font-size:.7rem; font-family:'Noto Sans',sans-serif; }
  .step-controls [aria-pressed="true"] { border-color:var(--color-field-700); color:var(--color-soil-900); font-weight:600; }.step-controls [aria-pressed="true"] .step-number { background:var(--color-field-700); color:white; }
