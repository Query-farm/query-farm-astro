---
import { Icon } from 'astro-icon/components';
import BrandMark from './BrandMark.astro';
const steps = [
  { label: 'Your agent builds', title: 'Describe the connection you need.', text: 'Your coding agent uses the VGI skill to write a worker and test it with real SQL. You choose the language; you keep the code.' },
  { label: 'ATTACH the worker', title: 'Bring a database into your session.', text: 'ATTACH connects to the worker and registers its catalog as github. DuckDB can discover its schemas, tables, and functions alongside your other databases.' },
  { label: 'Query its catalog', title: 'Query the catalog you just attached.', text: 'GitHub releases live behind an API, but now github.main.releases(...) is a table function in your attached catalog. Your SQL calls the worker through VGI.' },
  { label: 'The worker fetches', title: 'Your worker does the integration.', text: 'VGI passes the function call to the worker. The worker calls GitHub’s API using ordinary code. The coding agent’s job is already done.' },
  { label: 'Rows come back', title: 'Now the data is part of your query.', text: 'The worker returns typed rows in Arrow batches through VGI. Therefore DuckDB can filter, aggregate, and join those rows with your local project inventory.' },
];
const agents = [
  { id: 'codex', label: 'Codex' }, { id: 'claude-code', label: 'Claude Code' },
  { id: 'cursor', label: 'Cursor' }, { id: 'github-copilot', label: 'Copilot' },
  { id: 'opencode', label: 'OpenCode' },
];
---
<section class="vgi-explainer not-prose" aria-labelledby="vgi-explainer-title" data-vgi-explainer data-step="0" data-playing="false">
  <div class="explainer-heading">
    <div><p class="eyebrow">How VGI works</p><h2 id="vgi-explainer-title">From an API to a SQL catalog with tables.</h2></div>
    <button class="playback" type="button" data-playback hidden><span class="play-icon"><Icon name="mdi:play-circle-outline" size={19} /></span><span class="pause-icon"><Icon name="mdi:pause-circle-outline" size={19} /></span><span data-playback-label>Play animation</span></button>
  </div>
  <p class="intro">You <strong>ATTACH a VGI worker as a database</strong> in your DuckDB session. Its catalog exposes schemas, tables, and functions backed by your APIs, files, or code.</p>

  <div class="diagram" role="group" aria-label="Your coding agent builds the worker. ATTACH adds its catalog as a database in your DuckDB session. Queries call the worker through VGI, the worker calls GitHub, and rows return to DuckDB.">
    <div class="builder">
      <span class="builder-heading">Your coding agent builds the worker</span>
      <div class="agent-options" aria-label="Coding agents">
        {agents.map(agent => <span class={`agent-option agent-${agent.id}`}><span class="agent-icon"><BrandMark name={agent.id} size={32} /></span><span>{agent.label}</span></span>)}
      </div>
      <span class="build-link"><span>Builds + tests</span><i aria-hidden="true"></i></span>
    </div>
    <div class="runtime">
      <div class="node database">
        <div class="database-heading"><BrandMark name="duckdb" size={31} /><strong>DuckDB session</strong><span class="extension">VGI extension</span></div>
        <div class="session-catalogs">
          <p class="session-label">Databases</p>
          <div class="local-database"><Icon name="mdi:database-outline" size={16} /><span>memory</span><small>local</small></div>
          <div class="attached-catalog" data-attached-catalog>
            <div class="catalog-name"><Icon name="mdi:database-check-outline" size={17} /><strong>github</strong><small>attached</small></div>
            <div class="catalog-schema"><Icon name="mdi:folder-outline" size={14} /><span>main</span><small>schema</small></div>
            <div class="catalog-function"><Icon name="mdi:table" size={14} /><span>releases(…)</span></div>
            <span class="function-kind">table function → rows</span>
          </div>
          <span class="attach-placeholder">Your worker’s catalog appears here.</span>
        </div>
        <span class="returned" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="connection vgi-link" aria-hidden="true"><span class="outbound"><span class="call-label">Call</span><span class="attach-label">ATTACH</span></span><span class="inbound">Rows</span><div class="track"><i class="packet"></i><i class="packet"></i><i class="packet"></i></div></div>
      <div class="node worker">
        <Icon name="mdi:code-braces" size={31} />
        <strong>Your worker</strong>
        <span class="worker-language">Your language</span>
        <span class="node-detail">Exposes a catalog</span>
      </div>
      <div class="connection api-link" aria-hidden="true"><span class="outbound">Fetch</span><span class="inbound">Data</span><div class="track"><i class="packet"></i><i class="packet"></i><i class="packet"></i></div></div>
      <div class="node source">
        <BrandMark name="github" size={31} />
        <strong>GitHub API</strong>
        <span class="source-data">Release data</span>
        <span class="node-detail">Your data source</span>
      </div>
    </div>
    <div class="query-strip">
      <div class="sql-line attach-sql"><span class="query-label">Attach a database</span><code><span class="sql-keyword">ATTACH</span> 'github' <span class="sql-keyword">AS</span> github<br />  (TYPE vgi, LOCATION '&lt;worker command&gt;');</code></div>
      <div class="sql-line select-sql"><span class="query-label">Query its catalog</span><code><span class="sql-keyword">SELECT</span> * <span class="sql-keyword">FROM</span> github.main.releases('duckdb', 'duckdb');</code></div>
      <p class="command-note">Your agent supplies the worker command for your chosen language.</p>
    </div>
  </div>

  <div class="step-controls" role="group" aria-label="Animation steps" hidden>
    {steps.map((step, i) => <button type="button" data-step-button={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`vgi-explainer-step-${i}`}><span class="step-number" aria-hidden="true">{i + 1}</span><span>{step.label}</span></button>)}
  </div>
  <div class="captions">
    {steps.map((step, i) => <div id={`vgi-explainer-step-${i}`} data-step-caption={i}><h3>{step.title}</h3><p>{step.text}</p></div>)}
  </div>
  <p class="sr-only" role="status" data-step-status></p>
  <p class="explainer-footer">The same pattern works for APIs, local files, and libraries. <a href="#watch">Watch the actual agent build below →</a></p>
</section>

<script>
  function setupVgiExplainers() {
    document.querySelectorAll<HTMLElement>('[data-vgi-explainer]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-step-button]')];
      const captions = [...root.querySelectorAll<HTMLElement>('[data-step-caption]')];
      const playback = root.querySelector<HTMLButtonElement>('[data-playback]')!;
      const label = root.querySelector<HTMLElement>('[data-playback-label]')!;
      const status = root.querySelector<HTMLElement>('[data-step-status]')!;
      const durations = [5000, 6000, 5200, 5200, 6000];
      let step = reducedMotion.matches ? buttons.length - 1 : 0;
      let remaining = durations[step];
      let startedAt = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let wantsPlayback = !reducedMotion.matches;
      let inView = false;
      let finished = reducedMotion.matches;

      const render = () => {
        root.dataset.step = String(step);
        playback.dataset.action = wantsPlayback ? 'pause' : 'play';
        buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === step)));
        captions.forEach((caption, i) => caption.hidden = i !== step);
        label.textContent = wantsPlayback ? 'Pause animation' : finished ? 'Replay animation' : 'Play animation';
      };
      const stopTimer = () => {
        if (timer !== undefined) {
          clearTimeout(timer);
          remaining = Math.max(0, remaining - (performance.now() - startedAt));
          timer = undefined;
        }
        root.dataset.playing = 'false';
      };
      const syncPlayback = () => {
        stopTimer();
        if (!wantsPlayback || !inView || document.hidden) return;
        root.dataset.playing = 'true';
        startedAt = performance.now();
        timer = setTimeout(() => {
          timer = undefined;
          if (step === buttons.length - 1) {
            wantsPlayback = false;
            finished = true;
            root.dataset.playing = 'false';
          } else {
            step += 1;
            remaining = durations[step];
            syncPlayback();
          }
          render();
        }, remaining);
      };
      playback.hidden = false;
      root.querySelector<HTMLElement>('.step-controls')!.hidden = false;
      playback.addEventListener('click', () => {
        if (finished) {
          stopTimer(); step = 0; remaining = durations[0]; finished = false;
        }
        wantsPlayback = !wantsPlayback;
        render(); syncPlayback();
      });
      buttons.forEach((button, i) => button.addEventListener('click', () => {
        stopTimer(); wantsPlayback = false; finished = false;
        step = i; remaining = durations[i]; render();
        status.textContent = `Step ${i + 1}. ${captions[i].textContent}`;
      }));
      const observer = new IntersectionObserver(entries => {
        inView = entries[0].isIntersecting;
        syncPlayback();
      }, { threshold: 0.25 });
      observer.observe(root);
      const visibilityChanged = () => syncPlayback();
      const motionChanged = () => {
        if (reducedMotion.matches) { stopTimer(); wantsPlayback = false; render(); }
      };
      document.addEventListener('visibilitychange', visibilityChanged);
      reducedMotion.addEventListener('change', motionChanged);
      document.addEventListener('astro:before-swap', () => {
        stopTimer(); observer.disconnect();
        document.removeEventListener('visibilitychange', visibilityChanged);
        reducedMotion.removeEventListener('change', motionChanged);
      }, { once: true });
      render();
    });
  }
  setupVgiExplainers();
  document.addEventListener('astro:page-load', setupVgiExplainers);
</script>

<style>
  .vgi-explainer { margin-top:3rem; padding:1.6rem 1.8rem 1.25rem; border:1px solid var(--color-soil-300); border-radius:1rem; background:#fffdf7; color:var(--color-soil-900); }
  .explainer-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .eyebrow { font-size:.75rem; font-weight:600; color:var(--color-sun-700); margin:0 0 .35rem; }
  h2 { font-size:clamp(1.5rem,3vw,2rem); line-height:1.2; margin:0; }
  .intro { font-size:.9rem; line-height:1.75; max-width:88ch; margin:.8rem 0 0; color:var(--color-soil-700); }
  .playback { display:flex; flex:none; align-items:center; gap:.4rem; padding:.6rem .7rem; border:1px solid var(--color-soil-300); border-radius:.4rem; font-size:.76rem; cursor:pointer; color:var(--color-field-700); min-height:44px; }
  .play-icon,.pause-icon { display:flex; }.pause-icon,[data-action="pause"] .play-icon { display:none; }[data-action="pause"] .pause-icon { display:flex; }
  [hidden] { display:none!important; }
  button:focus-visible,a:focus-visible { outline:2px solid var(--color-field-700); outline-offset:4px; }
  .diagram { max-width:980px; margin:1.5rem auto 0; }
  .builder { display:flex; align-items:center; flex-direction:column; }
  .builder-heading { font-size:.78rem; font-weight:600; margin-bottom:.8rem; }
  .agent-options { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:1.3rem; max-width:530px; width:100%; }
  .agent-option { display:flex; flex-direction:column; align-items:center; gap:.45rem; text-align:center; font-size:.73rem; font-weight:600; }
  .agent-icon { display:flex; align-items:center; justify-content:center; width:58px; height:58px; border:1px solid color-mix(in srgb,var(--agent-color) 35%,transparent); border-radius:1rem; background:var(--agent-ground); color:var(--agent-color); box-shadow:0 3px 0 color-mix(in srgb,var(--agent-color) 14%,transparent); }
  .agent-codex { --agent-color:#087f8c; --agent-ground:#d8f1ed; }
  .agent-claude-code { --agent-color:#b95031; --agent-ground:#fae2d5; }
  .agent-cursor { --agent-color:#6843af; --agent-ground:#ede4fa; }
  .agent-github-copilot { --agent-color:#3759b6; --agent-ground:#e0eaff; }
  .agent-opencode { --agent-color:#95600c; --agent-ground:#fff0c5; }
  .build-link { position:relative; display:flex; justify-content:center; width:100%; height:40px; margin-top:8px; }
  .build-link>span { position:absolute; left:calc(50% + 12px); top:8px; font-size:.66rem; color:#245e6a; white-space:nowrap; }
  .build-link>i { position:relative; border-left:2px dashed #4b8d97; }
  .runtime { position:relative; display:grid; grid-template-columns:minmax(0,1fr) 68px minmax(0,1fr) 68px minmax(0,1fr); align-items:center; }
  .runtime::before { content:''; position:absolute; left:50%; top:0; height:calc((100% - 186px)/2); border-left:2px dashed #4b8d97; }
  .runtime::after { content:''; position:absolute; left:calc(50% - 3px); top:calc((100% - 186px)/2 - 9px); width:8px; height:8px; border-right:2px solid #4b8d97; border-bottom:2px solid #4b8d97; transform:rotate(45deg); }
  .node { position:relative; display:flex; min-width:0; flex-direction:column; align-items:center; gap:.6rem; text-align:center; border:1px solid var(--node-accent); border-radius:.8rem; background:var(--node-ground); padding:1.1rem .85rem; transition:box-shadow .35s; }
  .database { --node-accent:#b98217; --node-ground:#fff0bf; }
  .worker { --node-accent:#3e8c98; --node-ground:#dcf1f1; color:#184f5d; }
  .source { --node-accent:#c27150; --node-ground:#fae2d5; color:#843d25; }
  .worker,.source { min-height:186px; justify-content:center; }
  .node strong { font-size:1rem; }.node-detail { font-size:.74rem; color:var(--color-soil-700); }
  .database-heading { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:.5rem; }
  .extension,.worker-language,.source-data { font-size:.78rem; line-height:1.5; padding:.15rem .5rem; border-radius:.3rem; }
  .extension { background:#e9c96c; color:#48310a; border:1px solid #cba747; font-weight:600; font-size:.7rem; }
  .worker-language { background:#b9dfe2; }.source-data { background:#f1c4ae; }
  .session-catalogs { width:100%; text-align:left; font-size:.73rem; margin-top:.2rem; position:relative; }
  .session-label { font-size:.65rem; text-transform:uppercase; letter-spacing:.07em; color:#6c5018; margin:0 0 .4rem; }
  .local-database,.catalog-name,.catalog-schema,.catalog-function { display:flex; align-items:center; gap:.35rem; min-width:0; }
  .local-database { color:#6c5018; padding:0 .4rem .4rem; }.local-database small { margin-left:auto; }
  .attached-catalog { border:1px solid #c09334; border-radius:.4rem; background:#fffaf0; padding:.5rem; opacity:1; visibility:visible; transition:opacity .45s,transform .45s; }
  .catalog-name { color:#62400a; }.catalog-name strong { font-size:.8rem; }.catalog-name small { margin-left:auto; font-size:.62rem; color:#45632f; }
  .catalog-schema { padding:.4rem 0 .3rem .7rem; }.catalog-schema small { margin-left:auto; color:var(--color-soil-600); font-size:.62rem; }
  .catalog-function { padding-left:1.3rem; color:#245e6a; }.function-kind { display:block; padding:.25rem 0 0 1.3rem; color:var(--color-soil-700); font-size:.65rem; }
  .attach-placeholder { position:absolute; bottom:30px; left:12px; right:12px; text-align:center; font-size:.72rem; line-height:1.7; color:#6c5018; display:none; }
  [data-ready="true"][data-step="0"] .attached-catalog { opacity:0; visibility:hidden; transform:translateY(8px); }
  [data-ready="true"][data-step="0"] .attach-placeholder { display:block; }
  .connection { color:#245e6a; font-size:.64rem; text-align:center; position:relative; }
  .track { position:relative; margin:6px 0 18px; height:2px; background:#6da5ad; }
  .track::after { content:''; position:absolute; right:3px; top:-3px; width:7px; height:7px; border-top:2px solid currentColor; border-right:2px solid currentColor; transform:rotate(45deg); }
  .packet { position:absolute; width:8px; height:8px; left:0; top:-3px; border-radius:2px; background:#087f8c; opacity:0; }
  .api-link { color:#914725; }.api-link .track { background:#d99573; }.api-link .packet { background:#b95031; }
  .inbound,.attach-label { display:none; }
  [data-step="1"] .attach-label { display:inline; }[data-step="1"] .call-label { display:none; }
  .returned { position:absolute; top:14px; right:12px; display:flex; flex-direction:column; gap:4px; opacity:0; }
  .returned i { width:19px; height:4px; background:var(--color-field-700); border-radius:1px; }
  [data-step="0"] .worker,[data-step="1"] .database,[data-step="2"] .database,[data-step="3"] .worker,[data-step="3"] .source,[data-step="4"] .database { box-shadow:0 0 0 3px color-mix(in srgb,var(--node-accent) 27%,transparent); }
  [data-step="0"][data-playing="true"] .runtime::after { animation:build-arrival 1.6s ease-in-out 3; }
  [data-step="1"] .vgi-link .packet,[data-step="2"] .vgi-link .packet,[data-step="3"] .api-link .packet,[data-step="4"] .connection .packet { animation:packet-out 1.6s linear 4; }
  [data-step="4"] .connection .packet { animation-name:packet-back; background:var(--color-field-700); }
  [data-step="4"] .connection { color:var(--color-field-700); }[data-step="4"] .track { background:#7e9e68; }
  [data-step="4"] .track::after { right:auto; left:3px; transform:rotate(-135deg); }
  [data-step="4"] .outbound { display:none; }[data-step="4"] .inbound { display:inline; }
  [data-step="4"] .returned { opacity:1; }
  .connection .packet:nth-child(2) { animation-delay:.25s; }.connection .packet:nth-child(3) { animation-delay:.5s; }
  [data-playing="false"] .packet,[data-playing="false"] .runtime::after { animation-play-state:paused!important; }
  .query-strip { background:var(--color-rock-900); color:#f4ece0; border-radius:.6rem; margin-top:1.3rem; overflow:hidden; }
  .sql-line { display:grid; grid-template-columns:145px minmax(0,1fr); align-items:center; gap:.75rem; padding:.8rem 1rem; border-left:3px solid transparent; }
  .select-sql { border-top:1px solid #3c352d; }.query-label { color:#d4c7b4; font-size:.7rem; }
  .query-strip code { font-size:.74rem; line-height:1.85; overflow-wrap:anywhere; white-space:pre-wrap; }.sql-keyword { color:#efc979; }
  [data-step="1"] .attach-sql,[data-step="2"] .select-sql,[data-step="3"] .select-sql,[data-step="4"] .select-sql { border-left-color:#d9a441; background:#252015; }
  .command-note { font-size:.67rem; line-height:1.7; color:#c8bba6; margin:0; padding:.5rem 1rem .7rem; border-top:1px solid #3c352d; }
  .step-controls { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.5rem; margin-top:1.3rem; }
  .step-controls button { display:flex; align-items:center; gap:.5rem; text-align:left; min-height:48px; padding:.5rem .4rem; border-bottom:2px solid var(--color-soil-300); font-size:.75rem; color:var(--color-soil-700); cursor:pointer; }
  .step-number { display:flex; flex:none; align-items:center; justify-content:center; width:23px; height:23px; border-radius:50%; background:var(--color-soil-100); font-size:.7rem; font-family:'Noto Sans',sans-serif; }
  .step-controls [aria-pressed="true"] { border-color:var(--color-field-700); color:var(--color-soil-900); font-weight:600; }.step-controls [aria-pressed="true"] .step-number { background:var(--color-field-700); color:white; }
  .captions { padding:1.2rem 0 .6rem; min-height:110px; }.captions h3 { font-family:'Noto Sans',sans-serif; font-size:.9rem; font-weight:600; letter-spacing:normal; margin:0 0 .4rem; }.captions p { font-size:.85rem; line-height:1.8; max-width:99ch; margin:0; color:var(--color-soil-700); }
  .explainer-footer { border-top:1px solid var(--color-soil-300); padding-top:.9rem; font-size:.73rem; line-height:1.8; color:var(--color-soil-700); }.explainer-footer a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; margin-left:.25rem; }
  @keyframes packet-out { 0% { left:0; opacity:0; } 15% { opacity:1; } 85% { opacity:1; } 100% { left:calc(100% - 8px); opacity:0; } }
  @keyframes packet-back { 0% { left:calc(100% - 8px); opacity:0; } 15% { opacity:1; } 85% { opacity:1; } 100% { left:0; opacity:0; } }
  @keyframes build-arrival { 0% { translate:0 -15px; opacity:0; } 20% { opacity:1; } 100% { translate:0 0; opacity:1; } }
  @media(max-width:800px) {
    .runtime { grid-template-columns:minmax(0,1fr) 42px minmax(0,1fr) 42px minmax(0,1fr); }
    .node { padding:.8rem .5rem; }.node strong { font-size:.85rem; }.catalog-name small,.catalog-schema small { display:none; }
    .sql-line { grid-template-columns:120px minmax(0,1fr); }.step-controls { gap:.2rem; }.step-controls button { font-size:.69rem; padding:.5rem .2rem; }
    .captions { min-height:132px; }
  }
  @media(max-width:640px) {
    .vgi-explainer { padding:1.2rem .85rem 1rem; margin-top:2rem; }.explainer-heading { flex-wrap:wrap; gap:.75rem; }.playback { font-size:.72rem; padding:.4rem .6rem; }.intro { font-size:.84rem; }
    .agent-options { gap:.35rem; }.agent-option { font-size:.65rem; }.agent-icon { width:44px; height:44px; border-radius:.7rem; }.agent-icon :global(.brand-mark) { --brand-size:27px!important; }
    .build-link { height:18px; margin:0; }.build-link>i,.build-link>span { display:none; }
    .runtime { grid-template-columns:minmax(0,1fr) 30px minmax(0,1fr); }
    .runtime::before,.runtime::after { display:none; }
    .database { grid-column:1/-1; grid-row:1; display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:.7rem; padding:.85rem .6rem; }
    .database-heading { gap:.6rem; }.session-catalogs { margin:0; }.catalog-name small,.catalog-schema small { display:none; }.catalog-function,.function-kind { padding-left:.6rem; }.catalog-schema { padding-left:.3rem; }
    .vgi-link { grid-column:1; grid-row:2; height:42px; }.vgi-link>.outbound,.vgi-link>.inbound { position:absolute; left:calc(50% + 12px); top:12px; }
    .vgi-link .track { position:absolute; height:38px; width:2px; left:50%; top:2px; margin:0; }.vgi-link .track::after { right:-3px; top:auto; bottom:2px; transform:rotate(135deg); }
    .worker { grid-column:1; grid-row:3; }.api-link { grid-column:2; grid-row:3; }.source { grid-column:3; grid-row:3; }
    .worker,.source { min-height:165px; padding:.8rem .4rem; }.node strong { font-size:.85rem; }.node-detail { font-size:.66rem; }.worker-language,.source-data { font-size:.73rem; padding:.15rem .3rem; }
    .connection { font-size:.59rem; }.returned { top:8px; right:8px; }.returned i { width:12px; height:3px; }
    [data-step="1"] .vgi-link .packet,[data-step="2"] .vgi-link .packet { animation-name:packet-down; left:-3px; }
    [data-step="4"] .vgi-link .packet { animation-name:packet-up; left:-3px; }
