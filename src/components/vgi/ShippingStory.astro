---
import CodeBlock from '../ui/CodeBlock.astro';
import story from '../../data/vgi-shipping-story.json';
import { vgiSkillsFile } from '../../lib/vgi-agents';
interface Props { id?: string; heading?: boolean; }
const { id = 'shipping-story', heading = true } = Astro.props;
const beats = [
  { tab: 'One quote', title: 'First, make one piece of code callable from SQL.', text: 'A 500g parcel to the US costs $5.50 under our sample rate card. The worker owns that calculation; DuckDB sees a typed function it can call.', point: 'This small query proves the connection works. A real shipping library can sit behind the same function.' },
  { tab: 'Every order', title: 'But one quote does not tell you which orders lose money.', text: 'The order table already has destinations, weights, revenue, and product costs. Therefore, pass those columns to the worker and bring the shipping quotes into the same query.', point: 'The Australian order has no rate in this fixture. Its NULL is a missing answer, not free shipping.' },
  { tab: 'Orders at risk', title: 'Now SQL can answer the business question.', text: 'Subtract the product and shipping costs from revenue. Two orders lose money. But a missing quote can hide another problem, so the query keeps that order in the review queue too.', point: 'You get one report to act on: two losses and one missing quote. The shipping rule stays in its library; filtering and calculation stay in SQL.' },
];
const labels: Record<string, string> = { order_id: 'Order', destination: 'Ship to', shipping_cents: 'Shipping (USD)', margin_cents: 'Margin (USD)' };
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
const cell = (value: string | number | null, column: string) => value == null ? (column === 'margin_cents' ? 'Review' : 'No quote') : column.endsWith('_cents') && typeof value === 'number' ? money.format(value / 100) : value;
---
<section class="shipping-story not-prose" id={id} data-shipping-story>
  {heading && <><p class="story-eyebrow">A small start. A useful result.</p><h2>Which orders lose money after shipping?</h2><p class="story-lede">Follow one working example from a single function call to a report you could use. The rates and orders are fictional; the SQL results are real.</p></>}
  <div class="story-tabs" role="tablist" aria-label="Shipping example stages">
    {beats.map((beat, i) => <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-story-tab={i}><span aria-hidden="true">0{i + 1}</span>{beat.tab}</button>)}
  </div>
  {beats.map((beat, i) => <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} tabindex="0" hidden={i !== 0} data-story-panel={i} class="story-panel">
    <h3>{beat.title}</h3><p class="story-narrative">{beat.text}</p>
    <div class="story-output">
      <div class="story-code"><CodeBlock code={`${story.scenes[i].sql};`} lang="sql" title="SQL against the running worker" tryable={false} /></div>
      <div class="story-result"><p class="result-label">Recorded query result</p><div class="table-scroll"><table aria-label={`${beat.tab}: verified SQL results`}><thead><tr>{story.scenes[i].columns.map(column => <th scope="col">{labels[column] || column}</th>)}</tr></thead><tbody>{story.scenes[i].rows.map(row => <tr>{row.map((value, c) => <td class:list={{ negative: typeof value === 'number' && value < 0, missing: value == null }}>{cell(value, story.scenes[i].columns[c])}</td>)}</tr>)}</tbody></table></div><p class="result-footnote">USD amounts shown in dollars. The function returns integer cents; “No quote” is SQL NULL.</p></div>
    </div>
    <p class="story-point">{beat.point}</p>
  </div>)}
  <div class="story-provenance"><span>Verified on DuckDB {story.engineVersion} · {story.checksPassed} SQL checks passed</span><a href={vgiSkillsFile('examples/shipping-margin/README.md')}>Get the runnable example →</a></div>
  <details class="story-data"><summary>Inspect the five sample orders</summary><CodeBlock code={story.setup} lang="sql" title="orders.sql · fictional input data" tryable={false} /></details>
</section>
<script>
  function setupShippingStories() {
    document.querySelectorAll<HTMLElement>('[data-shipping-story]').forEach(root => {
      if (root.dataset.ready) return; root.dataset.ready = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-story-tab]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-story-panel]'));
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', event => {
          const next = event.key === 'ArrowRight' ? (i + 1) % tabs.length : event.key === 'ArrowLeft' ? (i + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
          if (next !== null) { event.preventDefault(); select(next, true); }
        });
      });
    });
  }
  setupShippingStories(); document.addEventListener('astro:page-load', setupShippingStories);
</script>
<style>
  .shipping-story { container-type:inline-size; color:var(--color-soil-900); scroll-margin-top:8rem; }.story-eyebrow { font-size:.8rem; font-weight:600; color:var(--color-sun-700); margin:0 0 .65rem; }.shipping-story h2 { font-size:clamp(1.7rem,3vw,2.2rem); line-height:1.25; margin:0; }.story-lede { max-width:68ch; margin:1rem 0 1.5rem; font-size:1rem; line-height:1.8; color:var(--color-soil-700); }
  .story-tabs { display:flex; border-bottom:1px solid var(--color-soil-300); gap:1.2rem; margin-top:1.5rem; }.story-tabs button { display:flex; gap:.6rem; align-items:center; padding:.8rem .15rem; border:0; border-bottom:3px solid transparent; background:transparent; color:var(--color-soil-700); font-size:.85rem; cursor:pointer; }.story-tabs button>span { color:var(--color-sun-700); font-size:.7rem; }.story-tabs button[aria-selected='true'] { color:var(--color-soil-900); font-weight:600; border-color:var(--color-field-700); }.story-tabs button:focus-visible, .story-panel:focus-visible { outline:2px solid var(--color-field-700); outline-offset:3px; }
  .story-panel { padding:1.5rem 0 0; }.story-panel[hidden] { display:none; }.story-panel h3 { font-size:1.4rem; line-height:1.4; margin:0; }.story-narrative { max-width:80ch; color:var(--color-soil-700); font-size:.95rem; line-height:1.8; margin:.8rem 0 1.4rem; }.story-output { display:grid; gap:1.25rem; align-items:start; }.story-code, .story-result { min-width:0; }.story-result { padding:1rem; border:1px solid var(--color-soil-300); border-radius:.75rem; background:#fffdf7; }.result-label { margin:0 0 1rem; font-weight:600; font-size:.8rem; }.table-scroll { overflow-x:auto; }.story-result table { border-collapse:collapse; width:100%; font-size:.8rem; }.story-result th { text-align:left; font-weight:600; border-bottom:1px solid var(--color-soil-400); padding:.5rem .5rem .6rem 0; }.story-result td { border-bottom:1px solid var(--color-soil-200); padding:.7rem .5rem .7rem 0; white-space:nowrap; font-variant-numeric:tabular-nums; }.negative { color:#953d24; font-weight:600; }.missing { color:var(--color-sun-700); font-weight:600; }.result-footnote { font-size:.7rem; line-height:1.7; color:var(--color-soil-600); margin:1rem 0 0; }.story-point { border-left:3px solid var(--color-field-700); padding:.3rem 0 .3rem 1rem; font-size:.9rem; line-height:1.8; color:var(--color-soil-700); margin:1.5rem 0; }.story-provenance { display:flex; gap:1rem; justify-content:space-between; flex-wrap:wrap; font-size:.75rem; line-height:1.7; color:var(--color-soil-600); }.story-provenance a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; }.story-data { margin:1rem 0; }.story-data summary { cursor:pointer; color:var(--color-soil-700); font-size:.8rem; margin-bottom:1rem; }
  @container(min-width:850px) { .story-output { grid-template-columns:1.25fr 1fr; } }
  @media(max-width:450px) { .story-tabs { gap:.75rem; }.story-tabs button { gap:.3rem; font-size:.78rem; }.story-panel h3 { font-size:1.25rem; } }
</style>
