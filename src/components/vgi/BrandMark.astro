---
import { Icon } from 'astro-icon/components';
import codex from '../../../public/vgi/agents/codex.svg?raw';
interface Props { name: string; size?: number; }
const { name, size = 22 } = Astro.props;
const marks: Record<string, string> = {
  'claude-code': 'claudecode', cursor: 'cursor', 'github-copilot': 'githubcopilot', opencode: 'opencode',
  python: 'python', typescript: 'typescript', go: 'go', rust: 'rust', java: 'openjdk', csharp: 'csharp',
};
---
<span class="brand-mark" style={`--brand-size:${size}px`} aria-hidden="true" data-brand={name}>
  {name === 'codex' ? <Fragment set:html={codex} /> : name === 'duckdb' ? <img src="/vgi/icons/duckdb-mark.svg" alt="" width={size} height={size} /> : <Icon name={`simple-icons:${marks[name]}`} size={size} />}
</span>
<style>
  .brand-mark { display: inline-flex; align-items: center; justify-content: center; width: var(--brand-size); height: var(--brand-size); flex: 0 0 var(--brand-size); vertical-align: middle; }
  .brand-mark :global(svg), .brand-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .brand-mark :global(svg) { fill: currentColor; }
</style>
