---
import evidence from '../../data/vgi-github-demo.json';
import CodeBlock from '../ui/CodeBlock.astro';
import BrandMark from './BrandMark.astro';
import { vgiSkillsFile } from '../../lib/vgi-agents';
interface Props { heading?: boolean; }
const { heading = true } = Astro.props;
---
<section class="integration-demo not-prose" data-integration-demo>
  {heading && <><p class="demo-eyebrow">Built by Codex · verified in DuckDB</p><h2>A live API. A local file. One answer.</h2></>}
  <p>GitHub has the releases. Your project inventory has the versions you use. The agent-built worker brings the API into DuckDB, so a query can join the two.</p>
  <div class="sources"><span><BrandMark name="github" /> GitHub releases API</span><span aria-hidden="true">+</span><span><code>inventory.csv</code> Sample local projects</span><span aria-hidden="true">→</span><span><BrandMark name="duckdb" /> SQL result</span></div>
  <div class="result-table"><table aria-label="Live releases joined to sample project inventory"><thead><tr>{evidence.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{evidence.rows.map(row => <tr>{row.map((value, i) => <td>{i === row.length - 1 && String(value).startsWith('https://github.com/') ? <a href={String(value)}>Release notes ↗</a> : String(value ?? 'NULL')}</td>)}</tr>)}</tbody></table></div>
  <p class="provenance">Actual API results recorded {evidence.recordedOn}. Project names and installed tags are sample data. The query reports differing tags, not upgrade compatibility. This demo fetches at most three pages of five releases.</p>
  <details><summary>Inspect the query the agent wrote</summary><div class="query"><CodeBlock code={evidence.sql} lang="sql" tryable={false} /></div></details>
  <p class="evidence-links"><a href={vgiSkillsFile('examples/agent-github-releases/README.md')}>Get the generated worker and tests →</a></p>
</section>
<style>
  .integration-demo { color:var(--color-soil-900); max-width:95ch; }.demo-eyebrow { color:var(--color-sun-700); font-size:.8rem!important; font-weight:600; }.integration-demo h2 { font-size:clamp(1.7rem,3vw,2.2rem); margin:.5rem 0 1rem; line-height:1.25; }.integration-demo>p { font-size:.95rem; line-height:1.8; margin:1rem 0; }.sources { display:flex; align-items:center; gap:1rem; flex-wrap:wrap; font-size:.8rem; margin:1.5rem 0; }.sources>span { display:flex; align-items:center; gap:.5rem; }.result-table { overflow:auto; border:1px solid var(--color-soil-300); border-radius:.6rem; }table { width:100%; border-collapse:collapse; text-align:left; font-size:.82rem; }th { background:var(--color-soil-100); font-weight:600; }th,td { padding:.85rem 1rem; white-space:nowrap; }td { border-top:1px solid var(--color-soil-300); }.integration-demo .provenance { font-size:.76rem; color:var(--color-soil-600); }.integration-demo a { color:var(--color-field-700); text-decoration:underline; text-underline-offset:3px; }details { margin:1.4rem 0; }summary { cursor:pointer; font-size:.85rem; font-weight:600; }.query { margin-top:1rem; }.integration-demo .evidence-links { display:flex; gap:1.3rem; flex-wrap:wrap; font-size:.8rem; }
</style>
