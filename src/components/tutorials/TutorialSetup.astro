---
import CodeBlock from '../ui/CodeBlock.astro';
interface Props { setup: string; slug: string; nativeOnly?: boolean }
const { setup, slug, nativeOnly = false } = Astro.props;
---
<aside class="my-6 rounded-xl border border-soil-300 bg-white/50 p-5" aria-label="Run along with this article">
  <p class="!mt-0 font-medium text-soil-900">Run along, with the data included</p>
  <p class="text-sm text-soil-700">
    {nativeOnly
      ? 'The browser exercises use local sample data. PostgreSQL pushdown is demonstrated separately with native DuckDB and a real PostgreSQL server.'
      : 'Each Run example button opens an editable SQL shell with its own copy of this sample data. Run the examples in any order. The engine downloads on your first run; sample queries execute in your browser.'}
  </p>
  <details class="mt-4">
    <summary class="cursor-pointer font-medium text-link">Create these tables yourself: full setup SQL</summary>
    <div class="mt-3"><CodeBlock code={setup} tryable={false} /></div>
  </details>
  <p class="!mb-0 text-sm"><a href={`/media/posts/${slug}/walkthrough.sql`} download data-tutorial-download="walkthrough">Download the complete SQL walkthrough</a></p>
</aside>
