---
import QueryResult from '../docs/QueryResult.astro';
type Cell = string | number | boolean | null;
interface Props {
  columns?: string[];
  rows?: Cell[][];
  text?: string;
  label?: string;
  note?: string;
  emptyMessage?: string;
  resultId?: string;
}
const { columns, rows, text, label = 'Expected result · sample data', note, emptyMessage = 'No rows returned.', resultId } = Astro.props;
// The shared renderer leaves missing values blank by default. These tutorials
// teach NULL semantics, so spell out every NULL in the displayed output.
const displayRows = rows?.map(row => row.map(cell => cell === null ? 'NULL' : cell));
const displayColumns = columns?.map((name, index) => ({
  name,
  align: rows?.some(row => typeof row[index] === 'number') ? 'right' as const : 'left' as const,
}));
---
<div class="tutorial-result" data-tutorial-result={text !== undefined ? 'plan' : 'table'} data-result-id={resultId}>
  <div class="result-heading"><span>{label}</span>{rows && <span>{rows.length} {rows.length === 1 ? 'row' : 'rows'}</span>}</div>
  <div class="result-scroll" role="region" aria-label={label} tabindex="0">
    <QueryResult columns={displayColumns} rows={displayRows} text={text} hideLabel />
  </div>
  {rows?.length === 0 && <p class="result-empty">{emptyMessage}</p>}
  {columns && columns.length > 3 && <p class="result-scroll-hint">Scroll for more columns →</p>}
  {note && <p class="result-note">{note}</p>}
</div>
<style>
  .tutorial-result{margin:16px 0 0;overflow:hidden;border:1px solid #c2cbae;border-top:3px solid #45632f;border-radius:0 0 10px 10px;background:#fffdf7;min-width:0}
  .result-heading{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;padding:11px 14px;background:#eef1e6;color:#40552e;font-size:12px;line-height:1.45;font-weight:600}
  .result-heading span:last-child:not(:first-child){font-variant-numeric:tabular-nums;white-space:nowrap}
  .result-scroll{overflow-x:auto}.result-scroll:focus-visible{outline:2px solid #45632f;outline-offset:-3px}
  .tutorial-result :global(.not-prose){margin:0}
  .tutorial-result :global(.overflow-x-auto){overflow:visible;border:0;border-radius:0;background:transparent}
  .tutorial-result :global(table){display:table;width:max-content;min-width:100%;max-width:none;margin:0;border:0;border-radius:0;border-collapse:collapse}
  .tutorial-result :global(th),.tutorial-result :global(td){padding:9px 12px;font-size:12px;line-height:1.5;white-space:nowrap;border:0;border-bottom:1px solid #e5e7dd}
  .tutorial-result :global(th){background:#f7f8f2;font-weight:600}
  .tutorial-result :global(th.text-right),.tutorial-result :global(td.text-right){text-align:right}
  .tutorial-result :global(pre){background:none;border:0;box-shadow:none;margin:0;padding:12px 0;color:#40552e;font:12px/1.6 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;overflow:visible;max-height:none}
  .tutorial-result .result-empty,.tutorial-result .result-note{margin:0;padding:11px 14px;font-size:13px;line-height:1.55;color:#536144}
  .tutorial-result .result-note{border-top:1px solid #e5e7dd}
  .tutorial-result .result-scroll-hint{display:none;margin:0;padding:8px 14px;border-top:1px solid #e5e7dd;font-size:11px;color:#536144}
  @media(max-width:600px){.tutorial-result .result-scroll-hint{display:block}}
</style>
