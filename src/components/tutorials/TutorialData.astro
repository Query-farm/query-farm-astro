---
interface SampleTable {
  table: string;
  title: string;
  description: string;
  columns: string[];
  rows: (string | number | boolean | null)[][];
  totalRows: number;
  downloads: { label: string; file: string }[];
}
interface Props { tables: SampleTable[]; slug: string }
const { tables, slug } = Astro.props;
---
<div class="tutorial-data" data-tutorial-data>
  {tables.map(sample => (
    <section class="dataset" aria-label={sample.title} data-sample-table={sample.table}>
      <header>
        <p class="dataset-name"><code>{sample.table}</code><span>{sample.totalRows.toLocaleString('en-US')} rows</span></p>
        <h3>{sample.title}</h3>
        <p class="dataset-description">{sample.description}</p>
      </header>
      <div class="dataset-scroll" tabindex="0" role="region" aria-label={`${sample.title} sample records`}>
        <table>
          <thead><tr>{sample.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
          <tbody>{sample.rows.map(row => <tr>{row.map(value => <td>{value === null ? <span class="null-value">NULL</span> : String(value)}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <footer>
        <span>{sample.rows.length === sample.totalRows ? 'Every input row shown' : `${sample.rows.length} sample rows shown`}</span>
        <span>{sample.downloads.map(download => <a href={`/media/posts/${slug}/${download.file}`} download data-tutorial-download={`${sample.table}_${download.label.toLowerCase()}`}>{download.label} ↓</a>)}</span>
      </footer>
    </section>
  ))}
</div>
<style>
  .tutorial-data{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin:1.75rem 0}
  .dataset:only-child{grid-column:1/-1}.dataset{min-width:0;overflow:hidden;border:1px solid #cabb9f;border-top:3px solid #45632f;border-radius:3px 3px 12px 12px;background:#fffdf7}
  .dataset header{padding:1.1rem 1.1rem .85rem}.dataset .dataset-name{display:flex;justify-content:space-between;gap:10px;margin:0;font-size:12px;color:#695b49}.dataset-name code{font-size:12px;background:none;padding:0}.dataset h3{margin:.55rem 0;font-size:21px;line-height:1.2}.dataset .dataset-description{margin:0;font-size:13px;line-height:1.55;color:#695b49}
  .dataset-scroll{overflow-x:auto}.dataset table{display:table;width:100%;min-width:0;margin:0;border:0;font-size:13px;line-height:1.5;border-collapse:collapse;table-layout:auto}.dataset th,.dataset td{padding:.5rem .75rem;text-align:left;white-space:pre;border:0;border-bottom:1px solid #e8dfd0}.dataset th{background:#f2ecdf;color:#695b49;font-size:12px;font-weight:600;letter-spacing:0;text-transform:none}.dataset tr:last-child td{border:0}.dataset td:first-child{font-variant-numeric:tabular-nums;color:#695b49}.null-value{font:11px ui-monospace,monospace;border:1px dashed #ba9d70;border-radius:4px;padding:2px 4px;color:#805b1c}.dataset footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem;padding:.7rem 1rem;border-top:1px solid #d4c7b3;font-size:11px;color:#695b49}.dataset footer span:last-child{display:flex;gap:12px}.dataset a{font-weight:600;color:#45632f}
  @media(max-width:640px){.tutorial-data{grid-template-columns:minmax(0,1fr)}.dataset th,.dataset td{padding:.5rem .6rem}}
</style>
