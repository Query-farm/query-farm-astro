---
import TutorialCardArt from './TutorialCardArt.astro';
interface Props { hasTutorials: boolean; featuredHref?: string }
const { hasTutorials, featuredHref } = Astro.props;
---
<header class="library-hero" data-tutorial-hero data-revealed="true">
  <div class="hero-copy">
    <p class="hero-eyebrow">The Query.Farm workshop</p>
    <h1>Get your hands<br/>on <em>the data.</em></h1>
    <p class="hero-description">Find a hidden change. Untangle a messy match. Follow a slow query. Short DuckDB tutorials with data you can explore and SQL you can run.</p>
    <a class="hero-explore" href={hasTutorials ? '#tutorial-catalog' : '/products/extensions/'} data-hero-explore>{hasTutorials ? 'Find your next experiment' : 'Explore DuckDB extensions'} <span aria-hidden="true">↗</span></a>
    <p class="hero-details">Data included <span>·</span> Runs in your browser <span>·</span> Under 10 min read</p>
  </div>
  <figure class="hero-art">
    <p class="art-question">Same row count. Same data?</p>
    <div class="hero-picture"><TutorialCardArt slug="compare-parquet-duckdb" /></div>
    <figcaption>
      <button type="button" data-hero-reveal aria-pressed="false" hidden>Show changes</button>
      <p data-hero-answer role="status">Ada and Ben changed. Cy left; Eli joined.</p>
      {featuredHref && <a href={featuredHref} data-hero-tutorial>Find them with SQL <span aria-hidden="true">→</span></a>}
    </figcaption>
  </figure>
</header>
<style>
  .library-hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);align-items:center;gap:65px;padding:34px 0 38px}.hero-copy{min-width:0}.hero-eyebrow{margin:0 0 15px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--color-soil-600)}
  h1{margin:0;font:600 clamp(40px,4.6vw,59px)/1.02 var(--font-display);letter-spacing:-.04em;color:var(--color-soil-900)}h1 em{font-weight:500;color:var(--color-field-700)}.hero-description{margin:19px 0 0;max-width:46ch;font-size:15px;line-height:1.75;color:var(--color-soil-700)}
  .hero-explore{display:inline-flex;align-items:center;gap:24px;margin-top:20px;padding:11px 16px;border-radius:6px;background:var(--color-field-700);color:white;font-size:13px;font-weight:500;text-decoration:none}.hero-explore:hover{background:var(--color-field-800)}.hero-explore span{font-size:20px;line-height:1}.hero-details{display:flex;flex-wrap:wrap;gap:5px 9px;margin:15px 0 0;font-size:10px;color:var(--color-soil-600)}
  .hero-art{margin:0;min-width:0;padding:18px 20px 16px;background:#eee7d4;border-radius:12px}.art-question{margin:0;font:500 23px/1.2 var(--font-display);color:#40552e}.hero-picture{height:200px;margin:5px 0 0;display:flex;justify-content:center}figcaption{display:grid;grid-template-columns:auto 1fr;gap:8px 13px;align-items:center}figcaption p{margin:0;font-size:11px;line-height:1.6;color:#536144;min-height:35px}figcaption a{grid-column:2;font-size:11px;color:#45632f;text-decoration:none}figcaption a:hover{text-decoration:underline;text-underline-offset:3px}button{min-height:40px;min-width:112px;padding:8px 11px;border:0;border-radius:5px;background:#45632f;color:#fffdf7;font:500 11px var(--font-sans);cursor:pointer}button:hover{background:#33501f}button[hidden]{display:none}a:focus-visible,button:focus-visible{outline:2px solid #45632f;outline-offset:3px}
  @media(max-width:1023px){.library-hero{gap:30px}.hero-art{padding:16px}.hero-picture{height:175px}.hero-details{font-size:9px}figcaption{grid-template-columns:1fr;gap:7px}figcaption button{justify-self:start}figcaption a{grid-column:1}figcaption p{min-height:18px}}
  @media(max-width:760px){.library-hero{grid-template-columns:minmax(0,1fr);gap:22px;padding:26px 0 28px}.hero-copy{max-width:560px}h1{font-size:42px}.hero-description{margin-top:15px;font-size:14px;max-width:48ch}.hero-explore{margin-top:16px}.hero-eyebrow{margin-bottom:12px}.hero-details{margin-top:12px;font-size:9px;gap:4px 7px}.hero-art{width:100%;max-width:500px;justify-self:center;padding:14px 16px}.art-question{font-size:20px}.hero-picture{height:145px;margin-top:0}figcaption{grid-template-columns:auto 1fr;gap:6px 10px}figcaption p{font-size:10px;min-height:32px}figcaption a{grid-column:2;font-size:10px}button{min-height:40px;min-width:102px;font-size:10px}}
  @media(max-width:380px){.hero-picture{height:130px}.hero-art{padding:13px}.hero-details{font-size:8px}figcaption{column-gap:8px}figcaption p{font-size:9px}button{min-width:94px}}
</style>
<script>
  const hero = document.querySelector<HTMLElement>('[data-tutorial-hero]');
  if (hero) {
    const button=hero.querySelector<HTMLButtonElement>('[data-hero-reveal]')!;
    const answer=hero.querySelector<HTMLElement>('[data-hero-answer]')!;
    const emit=(name:string,params:Record<string,string>)=>(window as Window & {gtag?:(...args:unknown[])=>void}).gtag?.('event',name,{content_type:'tutorial',...params});
    const render=(revealed:boolean)=>{hero.dataset.revealed=String(revealed);button.setAttribute('aria-pressed',String(revealed));button.textContent=revealed?'Reset comparison':'Show changes';answer.textContent=revealed?'Ada and Ben changed. Cy left; Eli joined.':'Five rows yesterday. Five today. Look closer.';};
    button.hidden=false;render(false);
    button.addEventListener('click',()=>{const revealed=hero.dataset.revealed!=='true';render(revealed);emit('tutorial_hero_interaction',{action:revealed?'reveal':'reset',visual:'snapshot_comparison'});});
    hero.querySelector('[data-hero-explore]')?.addEventListener('click',()=>emit('tutorial_catalog_explore',{source:'hero'}));
    hero.querySelector('[data-hero-tutorial]')?.addEventListener('click',()=>emit('tutorial_select',{post:'compare-parquet-duckdb',category:'files-formats',source:'hero'}));
    hero.dataset.tutorialHeroReady='true';
  }
</script>
