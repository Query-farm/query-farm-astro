---
interface Props { post: string }
const { post } = Astro.props;
---
<span hidden data-tutorial-post={post}></span>
<script>
  import { installTutorialTracking } from '../../lib/tutorial-analytics';
  for (const marker of document.querySelectorAll<HTMLElement>('[data-tutorial-post]')) {
    const article = marker.closest<HTMLElement>('article');
    if (article && marker.dataset.tutorialPost) installTutorialTracking(article, marker.dataset.tutorialPost);
  }
</script>
