---
interface Props {kind:string;state:string}
const {kind,state}=Astro.props;
const is=(value:string)=>state===value;
const priceState:Record<string,{x:number;selected:number;time:string}>={before:{x:45,selected:-1,time:'08:55'},exact:{x:120,selected:0,time:'09:00'},between:{x:295,selected:1,time:'09:15'},after:{x:470,selected:2,time:'09:30'}};
const cursor=priceState[state];
---
<svg class="experiment-drawing" viewBox="0 0 520 260" fill="none" aria-hidden="true">
 {kind==='json' && <>
  <rect x="12" y="28" width="185" height="205" rx="16" fill="#fffdf5"/><text x="31" y="57" class="heading">Three orders</text>
  {['Ada · 2 items','Ben · empty []','Cy · 1 item'].map((label,i)=><g><rect x="27" y={76+i*47} width="155" height="36" rx="6" fill={i===1?'#e1cd9f':'#e8eddc'}/><text x="40" y={100+i*47} class="label">{label}</text></g>)}
  <path d="M211 130h62m-11-9 11 9-11 9" stroke="#819669" stroke-width="3" stroke-linecap="round"/>
  <text x="239" y="108" text-anchor="middle" class="tiny">{is('expand')?'UNNEST':'LEFT JOIN'}</text>
  {['Ada · MUG','Ada · TEA',...(is('preserve')?['Ben · NULL']:[]),'Cy · MUG'].map((label,i)=><g><rect x="290" y={43+i*46} width="212" height="36" rx="7" fill={label.includes('NULL')?'#e1cd9f':'#45632f'}/><circle cx="310" cy={61+i*46} r="4" fill={label.includes('NULL')?'#87642a':'#d2dfb0'}/><text x="324" y={68+i*46} class={label.includes('NULL')?'label':'label light'}>{label}</text></g>)}
  {is('expand')&&<text x="300" y="219" class="warning">Ben is absent</text>}
 </>}
 {kind==='join' && <>
  {[100,60,80].map((amount,i)=><g><rect x={35+i*170} y="24" width="110" height="65" rx="10" fill="#fffdf5"/><text x={90+i*170} y="49" text-anchor="middle" class="tiny">ORDER {101+i}</text><text x={90+i*170} y="77" text-anchor="middle" class="number">{amount}</text></g>)}
  {(is('expanded')?[[90,48],[90,153],[260,258],[430,363],[430,468]]:[[90,90],[260,260],[430,430]]).map(([from,to])=><path d={`M${from} 90 C${from} 125 ${to} 125 ${to} 152`} stroke="#9aa57c" stroke-width="2"/>)}
  {(is('expanded')?[100,100,60,80,80]:[100,60,80]).map((amount,i)=><g><rect x={is('expanded')?8+i*105:35+i*170} y="153" width={is('expanded')?81:110} height="60" rx="9" fill={is('expanded')?'#b98645':'#45632f'}/><text x={is('expanded')?48+i*105:90+i*170} y="192" text-anchor="middle" class="number light">{amount}</text></g>)}
  <text x="260" y="245" text-anchor="middle" class="label">{is('expanded')?'5 order–item pairs':'3 orders, each with an item summary'}</text>
 </>}
 {kind==='latest' && <>
  <path d="M55 40v175" stroke="#a1aa86" stroke-width="3"/>
  {['09:00','10:00','10:00'].map((time,i)=><g><circle cx="55" cy={65+i*67} r="9" fill={i===2&&!is('tie')?'#45632f':'#b89046'}/><text x="77" y={71+i*67} class="label">{time}</text><rect x="172" y={35+i*67} width="318" height="54" rx="10" fill={i===2&&!is('tie')?'#45632f':i>0?'#fffdf5':'#e1dfcd'}/><text x="192" y={68+i*67} class={i===2&&!is('tie')?'label light':'label'}>ID {i+1} · Ada · {['Free','Team','Pro'][i]}</text>{i>0&&<text x="462" y={69+i*67} text-anchor="end" class={i===2&&!is('tie')?'label light':'warning'}>{is('tie')?'tie':i===2?'✓':'—'}</text>}</g>)}
 </>}
 {kind==='csv' && <>
  <path d="M20 23h165l20 20v191H20z" fill="#fffdf5"/><path d="M185 23v20h20" fill="#d4c7a4"/><text x="38" y="58" class="heading">invoices.csv</text>
  {['42.50','19.95','pending','NULL','Feb 30','−5.00','1,200.00'].map((text,i)=><g><circle cx="40" cy={82+i*19} r="3" fill={[2,3].includes(i)||is('contract')&&[4,5].includes(i)?'#b67b43':'#6d8b49'}/><text x="52" y={88+i*19} class="small">{text}</text></g>)}
  <path d="M217 130h40m0 0 30-48m-30 48 30 48" stroke="#87966c" stroke-width="3" stroke-linecap="round"/>
  <rect x="300" y="33" width="200" height="83" rx="14" fill="#45632f"/><text x="320" y="62" class="tiny light">{is('numeric')?'NUMERIC':'ACCEPTED'}</text><text x="320" y="99" class="large light">{is('numeric')?'5':'3'}<tspan class="label light"> rows</tspan></text>
  <rect x="300" y="144" width="200" height="83" rx="14" fill="#e3ce9f"/><text x="320" y="173" class="tiny">REVIEW</text><text x="320" y="210" class="large">{is('numeric')?'2':'4'}<tspan class="label"> rows</tspan></text>
 </>}
 {kind==='schema' && <>
  <rect x="20" y="30" width="300" height="200" rx="15" fill="#fffdf5"/><text x="42" y="63" class="tiny">ORDER PAYLOAD</text><text x="40" y="99" class="code">{'{'}</text><text x="60" y="128" class="code">"order_id": 103,</text><rect x="48" y="140" width="253" height="34" rx="5" fill={is('number')?'#dfe8cd':'#ead3ae'}/><text x="60" y="164" class="code">"total": {is('string')?'"40"':is('number')?'40':'-5'},</text><text x="60" y="194" class="code">"status": "paid"</text><text x="40" y="220" class="code">{'}'}</text>
  <path d="M345 88 409 59 473 88v53c0 42-64 67-64 67s-64-25-64-67z" fill={is('number')?'#45632f':'#b98645'}/>
  {is('number')?<path d="m383 132 18 19 36-42" stroke="#fffdf5" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>:<><path d="M409 104v43" stroke="#fffdf5" stroke-width="8" stroke-linecap="round"/><circle cx="409" cy="164" r="5" fill="#fffdf5"/></>}
 </>}
 {kind==='sketch' && <>
  {[['A','B','C'],['B','C','D'],['A','E']].map((letters,i)=><g opacity={i===2&&is('two-days')?'.25':'1'}><rect x={13+i*172} y="23" width="151" height="92" rx="12" fill="#fffdf5"/><text x={88+i*172} y="50" text-anchor="middle" class="tiny">JAN {i+1}</text>{letters.map((letter,j)=><g><circle cx={38+i*172+j*44} cy="81" r="17" fill={['#b89046','#6e8e4b','#9e795b','#788b87','#a68caa'][letter.charCodeAt(0)-65]}/><text x={38+i*172+j*44} y="88" text-anchor="middle" class="label light">{letter}</text></g>)}</g>)}
  <path d="M89 122 260 159m0 0V122m0 37 171-37" stroke="#9ba882" stroke-width="2"/>
  <text x="260" y="184" text-anchor="middle" class="tiny">DISTINCT IDS IN THE PERIOD</text>
  {(is('two-days')?['A','B','C','D']:['A','B','C','D','E']).map((letter,i,all)=><g><circle cx={260-(all.length-1)*31+i*62} cy="222" r="23" fill={['#b89046','#6e8e4b','#9e795b','#788b87','#a68caa'][i]}/><text x={260-(all.length-1)*31+i*62} y="230" text-anchor="middle" class="heading light">{letter}</text></g>)}
 </>}
 {kind==='asof' && <>
  <path d="M30 157h460" stroke="#a3ac8a" stroke-width="4" stroke-linecap="round"/>
  {[{x:120,time:'09:00',price:'10.00'},{x:240,time:'09:10',price:'12.00'},{x:420,time:'09:25',price:'11.50'}].map((price,i)=><g><circle cx={price.x} cy="157" r="9" fill={cursor.selected===i?'#45632f':'#b29b6e'}/><rect x={price.x-48} y="183" width="96" height="41" rx="8" fill={cursor.selected===i?'#45632f':'#fffdf5'}/><text x={price.x} y="210" text-anchor="middle" class={cursor.selected===i?'heading light':'heading'}>{price.price}</text><text x={price.x} y="247" text-anchor="middle" class="small">{price.time}</text></g>)}
  <path d={`M${cursor.x} 85v60`} stroke="#b67b43" stroke-width="3" stroke-dasharray="5 5"/>
  <rect x={Math.max(5,Math.min(395,cursor.x-60))} y="25" width="120" height="64" rx="11" fill="#e4c88b"/><text x={Math.max(65,Math.min(455,cursor.x))} y="49" text-anchor="middle" class="tiny">WREN ORDER</text><text x={Math.max(65,Math.min(455,cursor.x))} y="76" text-anchor="middle" class="heading">{cursor.time}</text>
  {cursor.selected>=0&&<path d={`M${cursor.x} 128H${[120,240,420][cursor.selected]}`} stroke="#45632f" stroke-width="5" stroke-linecap="round"/>}
 </>}
 {kind==='parquet' && <>
  <text x="25" y="30" class="tiny">ROW GROUP</text>
  {[1,2,3,4].map((day,i)=><text x={174+i*91} y="30" text-anchor="middle" class="tiny">JAN {day}</text>)}
  {[0,1,2,3].map((group)=><g><text x="49" y={74+group*49} text-anchor="middle" class="heading">{group}</text><path d={`M140 ${66+group*49}H480`} stroke="#c4cbb2" stroke-width="1"/>
   <rect x={is('mixed-two')?151:151+group*91} y={49+group*49} width={is('mixed-two')?319:46} height="33" rx="7" fill={is('mixed-two')||group===(is('sorted-three')?2:1)?'#45632f':'#ccd4ba'}/>
   <text x={is('mixed-two')?310:174+group*91} y={71+group*49} text-anchor="middle" class={is('mixed-two')||group===(is('sorted-three')?2:1)?'small light':'small'}>{is('mixed-two')?'Jan 1 → Jan 4':String(group+1)}</text>
  </g>)}
  <text x="260" y="254" text-anchor="middle" class="small">2,048 rows in each group · green = might match</text>
 </>}
 {kind==='explain' && <>
  {[{id:'sort',label:'ORDER BY',sub:'total DESC, region',y:19},{id:'group',label:'HASH GROUP BY',sub:'region → sum(amount)',y:101},{id:'scan',label:'SCAN orders',sub:"status = 'paid'",y:183}].map((op,i)=><g>
   {i<2&&<path d={`M260 ${op.y+63}v18m-6-12 6-6 6 6`} stroke="#8b9b72" stroke-width="2"/>}
   <rect x="63" y={op.y} width="394" height="63" rx="11" fill={is(op.id)?'#45632f':'#fffdf5'}/><text x="84" y={op.y+26} class={is(op.id)?'heading light':'heading'}>{op.label}</text><text x="84" y={op.y+49} class={is(op.id)?'small light':'small'}>{op.sub}</text><text x="431" y={op.y+40} text-anchor="end" class={is(op.id)?'number light':'number'}>{op.id==='scan'?'~4':'~2'}</text>
  </g>)}
 </>}
 {kind==='profile' && <>
  <text x="22" y="34" class="tiny">MEASURED OUTPUT ROWS</text><text x="22" y="77" class="heading">{is('scan')?'Filtered scan':is('inner')?'INNER JOIN':'SEMI JOIN'}</text>
  {Array.from({length:is('inner')?16:8},(_,i)=><rect x={22+(i%8)*61} y={100+Math.floor(i/8)*48} width="49" height="35" rx="7" fill={is('inner')&&i>=8?'#b98645':'#45632f'}/>)}
  <text x="22" y="218" class="small">Each block represents 1,000 output rows.</text><text x="22" y="245" class="small">{is('inner')?'Second campaign → another match per order':is('semi')?'At least one match → one qualifying order':'Paid records passed to the next operator'}</text>
 </>}
</svg>
<style>
 .experiment-drawing{display:block;width:100%;height:100%;min-width:0;min-height:0;overflow:visible;font-family:var(--font-sans)}.heading{font:600 22px var(--font-display);fill:#3b4b30}.label{font:500 18px var(--font-sans);fill:#465139}.small{font:15px var(--font-sans);fill:#5f684d}.tiny{font:600 12px var(--font-sans);letter-spacing:.04em;fill:#697053}.number{font:500 29px var(--font-display);fill:#3b4b30}.large{font:500 37px var(--font-display);fill:#3b4b30}.code{font:19px ui-monospace,monospace;fill:#3b4b30}.warning{font:500 18px var(--font-sans);fill:#946332}.light{fill:#fffdf5}
</style>
