---
import {tutorialExperiments} from '../../data/tutorial-experiments';
import {practicalTutorialExperiments} from '../../data/practical-tutorial-experiments';
import PracticalTutorialArt from './PracticalTutorialArt.astro';
interface Props {slug:string}
const kind=tutorialExperiments[Astro.props.slug].kind;
---
{practicalTutorialExperiments[Astro.props.slug] ? <PracticalTutorialArt kind={kind} state={tutorialExperiments[Astro.props.slug].states[0].id} compact /> : <svg class={`lesson-art lesson-art-${kind}`} viewBox="0 0 360 180" aria-hidden="true" fill="none" data-tutorial-card-art={kind}>
 <circle cx="180" cy="91" r="76" fill={['csv','join','latest'].includes(kind)?'#e5d3ab':'#dce2c8'}/>
 {kind==='json'&&<><g class="float-left"><rect x="25" y="30" width="131" height="124" rx="12" fill="#fffdf5"/><text x="43" y="77" class="brackets">{'{'}</text><rect x="70" y="59" width="63" height="7" rx="3" fill="#b99a52"/><rect x="70" y="82" width="47" height="7" rx="3" fill="#b99a52"/><text x="113" y="131" class="brackets">{'}'}</text></g><path d="M169 90h29m-9-8 9 8-9 8" stroke="#7a905d" stroke-width="3"/>{[41,79,117].map((y,i)=><g class="float-right"><rect x="212" y={y} width="124" height="28" rx="6" fill={i===1?'#a7b980':'#45632f'}/><circle cx="226" cy={y+14} r="3" fill="#fffdf5"/><path d={`M240 ${y+14}h76`} stroke="#e3ebd0" stroke-width="4" stroke-linecap="round"/></g>)}</>}
 {kind==='join'&&<><g class="float-left"><rect x="36" y="33" width="117" height="112" rx="10" fill="#fffdf5"/><text x="94" y="64" text-anchor="middle" class="small">ORDER TOTAL</text><text x="94" y="106" text-anchor="middle" class="big">100</text></g><path d="M168 89h30m-9-9 9 9-9 9" stroke="#7a905d" stroke-width="3"/><g class="float-right"><rect x="220" y="32" width="102" height="53" rx="9" fill="#b89046"/><rect x="220" y="99" width="102" height="53" rx="9" fill="#b89046"/><text x="271" y="68" text-anchor="middle" class="number light">100</text><text x="271" y="135" text-anchor="middle" class="number light">100</text></g></>}
 {kind==='latest'&&<><rect x="63" y="32" width="188" height="110" rx="9" fill="#c7bd9d" transform="rotate(-8 157 87)"/><rect x="75" y="32" width="188" height="110" rx="9" fill="#fffdf5"/><text x="96" y="59" class="small">LATEST UPDATE</text><text x="96" y="100" class="big">10:00</text><text x="98" y="124" class="small">ID 3 wins the tie</text><g class="stamp"><circle cx="277" cy="123" r="35" fill="#45632f"/><path d="m261 123 11 11 22-27" stroke="#fffdf5" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></g></>}
 {kind==='csv'&&<><g class="float-left"><path d="M60 21h154l20 20v117H60z" fill="#fffdf5"/><path d="M214 21v20h20" fill="#d3c6a3"/><text x="79" y="50" class="small">invoices.csv</text><text x="79" y="78" class="number">42.50</text><rect x="76" y="91" width="136" height="24" rx="5" fill="#e2c68e"/><text x="86" y="108" class="small">pending</text><path d="M80 131h90" stroke="#c8cdb5" stroke-width="6" stroke-linecap="round"/></g><g class="stamp"><rect x="217" y="108" width="93" height="45" rx="22" fill="#45632f"/><text x="263" y="137" text-anchor="middle" class="label light">3 clean</text></g></>}
 {kind==='schema'&&<><rect x="46" y="39" width="154" height="111" rx="12" fill="#fffdf5"/><text x="62" y="106" class="brackets">{'{ }'}</text><g class="stamp"><path d="M215 49 264 28 313 49v50c0 35-49 59-49 59s-49-24-49-59z" fill="#45632f"/><path d="m244 89 15 16 27-33" stroke="#fffdf5" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></g></>}
 {kind==='sketch'&&<><circle cx="135" cy="70" r="49" fill="#cfb479" fill-opacity=".8"/><circle cx="222" cy="70" r="49" fill="#8fa86c" fill-opacity=".75"/><circle cx="180" cy="119" r="49" fill="#a7b99a" fill-opacity=".75"/><g class="stamp"><rect x="113" y="67" width="134" height="52" rx="26" fill="#fffdf5"/><text x="180" y="103" text-anchor="middle" class="big">8 ≠ 5</text></g></>}
 {kind==='asof'&&<><path d="M38 121h286" stroke="#7d9460" stroke-width="3"/>{[70,170,284].map((x,i)=><g><circle cx={x} cy="121" r="7" fill={i===1?'#45632f':'#b89046'}/><text x={x} y="153" text-anchor="middle" class="label">{['10.00','12.00','11.50'][i]}</text></g>)}<g class="stamp"><rect x="125" y="30" width="129" height="65" rx="11" fill="#45632f"/><text x="189" y="55" text-anchor="middle" class="small light">ORDER TIME</text><text x="189" y="82" text-anchor="middle" class="number light">09:15</text><path d="M189 95v16h-19" stroke="#45632f" stroke-width="3"/></g></>}
 {kind==='parquet'&&<>{[0,1,2,3].map((i)=><g class="float-left"><rect x={30+i*76} y="42" width="60" height="104" rx="8" fill={i===1?'#45632f':'#fffdf5'}/>{[65,86,107,128].map(y=><rect x={42+i*76} y={y} width="36" height="5" rx="2" fill={i===1?'#cadcaf':'#c6cdb4'}/>)}</g>)}<g class="stamp"><circle cx="253" cy="80" r="34" fill="#e9d3a1" stroke="#9b7f3e" stroke-width="4"/><path d="m278 105 24 25" stroke="#9b7f3e" stroke-width="9" stroke-linecap="round"/><text x="253" y="85" text-anchor="middle" class="small">min → max</text></g></>}
 {kind==='explain'&&<><path d="M180 49v84m-6-14 6-6 6 6m-12-58 6-6 6 6" stroke="#8b9b71" stroke-width="3"/>{['SORT','SUM','SCAN'].map((label,i)=><g class={i===1?'stamp':''}><rect x="100" y={9+i*58} width="160" height="41" rx="8" fill={i===1?'#45632f':'#fffdf5'}/><text x="180" y={36+i*58} text-anchor="middle" class={i===1?'label light':'label'}>{label}</text></g>)}</>}
 {kind==='profile'&&<><g class="float-left"><circle cx="97" cy="93" r="52" fill="#fffdf5" stroke="#acbc91" stroke-width="4"/><rect x="83" y="22" width="28" height="13" rx="4" fill="#45632f"/><path d="M97 59v34l23 13" stroke="#45632f" stroke-width="4" stroke-linecap="round"/></g>{[70,124,70].map((width,i)=><g class="float-right"><rect x="183" y={40+i*42} width={width} height="28" rx="6" fill={i===1?'#b89046':'#45632f'}/><text x={192+width} y={60+i*42} class="small">{i===1?'16k':'8k'}</text></g>)}</>}
</svg>}
<style>
 .lesson-art{display:block;width:100%;height:100%;min-height:0;min-width:0;max-width:430px;font-family:var(--font-sans)}.brackets{font:500 62px var(--font-display);fill:#45632f}.big{font:500 38px var(--font-display);fill:#3b4b30}.number{font:500 29px var(--font-display);fill:#3b4b30}.small{font:11px var(--font-sans);fill:#697053}.label{font:500 16px var(--font-sans);fill:#465139}.light{fill:#fffdf5}.float-left,.float-right,.stamp{transform-box:fill-box;transform-origin:center;transition:transform .3s ease}
 :global(.tutorial-card:hover) .float-left,:global(.tutorial-card:focus-within) .float-left{transform:translateY(-3px) rotate(-2deg)}:global(.tutorial-card:hover) .float-right,:global(.tutorial-card:focus-within) .float-right{transform:translateY(3px)}:global(.tutorial-card:hover) .stamp,:global(.tutorial-card:focus-within) .stamp{transform:scale(1.06) rotate(2deg)}@media(prefers-reduced-motion:reduce){.lesson-art *{transition:none!important}}
</style>
