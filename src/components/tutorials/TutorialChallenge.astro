---
import TutorialResult from './TutorialResult.astro';
import { tutorialChallenges } from '../../data/tutorial-challenges';
import { serializeJsonLd } from '../../lib/breadcrumbs';
interface Props { post: string }
const challenge = tutorialChallenges[Astro.props.post];
const editorId = `challenge-${challenge.id}-sql`;
---
<section id={`challenge-${challenge.id}`} class="tutorial-challenge" data-tutorial-challenge={challenge.id} data-state="ready" aria-labelledby={`challenge-${challenge.id}-title`}>
  <p class="challenge-kicker">Your turn · check your answer</p>
  <h3 id={`challenge-${challenge.id}-title`}>{challenge.title}</h3>
  <p class="challenge-prompt">{challenge.prompt}</p>
  <details class="challenge-expected"><summary>See the expected result</summary><TutorialResult columns={challenge.columns} rows={challenge.rows} label="Your target result" /></details>
  <label for={editorId}>Your SQL</label>
  <textarea id={editorId} data-challenge-editor spellcheck="false" autocapitalize="off" autocomplete="off" rows="6" maxlength="20000" wrap="off">{challenge.starter}</textarea>
  <div class="challenge-actions"><button type="button" data-challenge-check disabled>Run &amp; check</button><button type="button" data-challenge-reset disabled>Reset</button><span>Sample data is loaded for you.</span></div>
  <p class="challenge-status" data-challenge-status role="status" aria-live="polite">Preparing the editor…</p>
  <noscript><p>Enable JavaScript to run your SQL. The expected result, hint, and solution are available below.</p></noscript>
  <div class="challenge-output" data-challenge-output hidden>
    <p>Your result</p><div class="challenge-result-scroll" role="region" aria-label="Your challenge query result" tabindex="0" data-challenge-table></div>
  </div>
  <div class="challenge-help">
    <details data-challenge-hint><summary>Need a hint?</summary><p>{challenge.hint}</p></details>
    <details data-challenge-solution><summary>Show a solution</summary><pre><code>{challenge.solution}</code></pre><button type="button" data-challenge-load-solution hidden>Put this in the editor</button></details>
  </div>
  <script is:inline type="application/json" data-challenge-config set:html={serializeJsonLd(challenge)} />
</section>
<script>
  import '../../scripts/tutorial-challenges';
</script>
<style>
  .tutorial-challenge{margin:32px 0;padding:24px;border-radius:12px;background:#e9eddf;min-width:0}.tutorial-challenge [hidden]{display:none!important}
  .tutorial-challenge .challenge-kicker{margin:0 0 8px;color:#45632f;font:600 11px/1.4 var(--font-sans);letter-spacing:.06em;text-transform:uppercase}.tutorial-challenge h3{margin:0;font-size:25px;line-height:1.2;border:0;padding:0}.tutorial-challenge .challenge-prompt{margin:12px 0;font-size:15px;line-height:1.65}
  .tutorial-challenge details{margin:12px 0;font-size:13px}.tutorial-challenge summary{cursor:pointer;color:#33501f;font-weight:500}.tutorial-challenge details p{font-size:13px;line-height:1.6;margin:10px 0}.tutorial-challenge label{display:block;margin:18px 0 8px;font-size:12px;font-weight:600;color:#33501f}
  textarea{display:block;box-sizing:border-box;width:100%;max-width:100%;min-height:165px;resize:vertical;overflow:auto;padding:15px;border:1px solid #75664d;border-radius:7px;background:#1a1512;color:#f4ece0;font:13px/1.6 ui-monospace,monospace;tab-size:2}
  .challenge-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:12px}.challenge-actions button,[data-challenge-load-solution]{min-height:42px;border:0;border-radius:5px;padding:9px 14px;font:500 13px var(--font-sans);cursor:pointer}.challenge-actions button:first-child{background:#45632f;color:white}.challenge-actions button:first-child:hover{background:#33501f}.challenge-actions button:disabled{opacity:.55;cursor:wait}.challenge-actions button:nth-child(2),[data-challenge-load-solution]{background:#dce3cd;color:#33501f}.challenge-actions span{font-size:11px;color:#536144}
  .tutorial-challenge .challenge-status{margin:13px 0 0;font-size:13px;line-height:1.6;min-height:21px;color:#40552e}[data-state='passed'] .challenge-status{font-weight:600}[data-state='error'] .challenge-status{color:#843e25;white-space:pre-wrap;overflow-wrap:anywhere}
  .challenge-output{margin-top:16px;border-radius:7px;background:#fffdf7;overflow:hidden}.tutorial-challenge .challenge-output>p{margin:0;padding:10px 13px;font-size:12px;font-weight:600;color:#40552e}.challenge-result-scroll{overflow-x:auto}.challenge-result-scroll :global(table){display:table;width:max-content;min-width:100%;margin:0;border:0;border-collapse:collapse;font-size:12px}.challenge-result-scroll :global(th),.challenge-result-scroll :global(td){padding:9px 13px;text-align:left;white-space:nowrap;border-bottom:1px solid #e5e7dd}.challenge-result-scroll :global(th){background:#f4f5ed}.challenge-result-scroll :global(p){padding:12px;font-size:13px}
  .challenge-help{display:flex;flex-direction:column;margin-top:10px}.challenge-help details{margin:7px 0}.challenge-help pre{max-width:100%;overflow-x:auto;font-size:12px;background:#1a1512;color:#f4ece0;padding:15px;border-radius:7px}.challenge-help code{background:transparent;color:inherit;font-size:inherit}
  textarea:focus-visible,button:focus-visible,summary:focus-visible,.challenge-result-scroll:focus-visible{outline:2px solid #45632f;outline-offset:3px}
  @media(max-width:600px){.tutorial-challenge{padding:18px 14px}.tutorial-challenge h3{font-size:23px}.challenge-actions span{flex-basis:100%}textarea{font-size:12px;padding:12px}.challenge-result-scroll :global(th),.challenge-result-scroll :global(td){padding:8px 10px}}
</style>
