---
import SectionSubNav from '../sections/SectionSubNav.astro';
import { tutorialCategoryLabel } from '../../data/tutorial-taxonomy';
interface Props { title?: string; category?: string }
const { title, category } = Astro.props;
const tabs = [
  { name: 'All tutorials', href: '/tutorials', active: Astro.url.pathname.replace(/\/$/, '') === '/tutorials' },
  { name: 'Extensions', href: '/products/extensions' },
];
---
{title && category ? <div class="tutorial-subnav tutorial-breadcrumb-bar sticky z-40 bg-soil-100" style="top: var(--qf-nav-h)" data-tutorial-breadcrumbs>
  <nav class="section-container" aria-label="Breadcrumb">
    <ol>
      <li><a href="/tutorials/">Tutorials</a></li>
      <li><span aria-hidden="true">›</span><a href={`/tutorials/?category=${category}`}>{tutorialCategoryLabel(category)}</a></li>
      <li class="current-tutorial"><span aria-hidden="true">›</span><span aria-current="page">{title}</span></li>
    </ol>
  </nav>
</div> : <SectionSubNav name="Tutorials" href="/tutorials" tabs={tabs} class="tutorial-subnav" compactOnMobile>
  <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18" /></svg>
</SectionSubNav>}
<style>
  ol{display:flex;align-items:center;gap:12px;min-height:48px;margin:0;padding:10px 0;list-style:none;font-size:13px;line-height:1.5}
  li{display:flex;align-items:center;gap:12px;min-width:0}
  li:not(.current-tutorial){flex-shrink:0}
  a{color:var(--color-field-700);text-decoration:none}
  a:hover{text-decoration:underline;text-underline-offset:3px}
  a:focus-visible{outline:2px solid var(--color-field-700);outline-offset:4px}
  li>span[aria-hidden]{color:var(--color-soil-500)}
  [aria-current]{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--color-soil-700)}
  @media(max-width:639px){ol{flex-wrap:wrap;gap:6px 10px;font-size:12px}li{gap:10px}.current-tutorial{flex-basis:100%}.current-tutorial>span[aria-hidden]{display:none}}
</style>
<style is:global>
  html:has(.tutorial-subnav){--qf-blog-nav-h:48px;scroll-padding-top:calc(var(--qf-nav-h) + var(--qf-blog-nav-h) + 16px)}
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-tutorial-breadcrumbs]');
  if (bar) {
    const updateHeight = () => document.documentElement.style.setProperty('--qf-blog-nav-h', `${bar.getBoundingClientRect().height}px`);
    new ResizeObserver(updateHeight).observe(bar);
    updateHeight();
  }
</script>
