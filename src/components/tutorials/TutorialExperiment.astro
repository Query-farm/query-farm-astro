---
import {tutorialExperiments} from '../../data/tutorial-experiments';
import TutorialExperimentArt from './TutorialExperimentArt.astro';
import PracticalTutorialArt from './PracticalTutorialArt.astro';
import {practicalTutorialExperiments} from '../../data/practical-tutorial-experiments';
interface Props {slug:string}
const {slug}=Astro.props;
const experiment=tutorialExperiments[slug];
---
<figure class="experiment" data-tutorial-experiment={experiment.kind} data-post={slug} data-choice={experiment.states[0].id} aria-label={experiment.title}>
  <header><p class="experiment-eyebrow">Explore the idea</p><h2>{experiment.title}</h2><p class="experiment-question">{experiment.question}</p></header>
  <div class="experiment-controls" role="group" aria-label={experiment.question}>
    {experiment.states.map((state,i)=><button type="button" data-experiment-choice={state.id} aria-pressed={i===0} aria-controls={`experiment-${slug}-${state.id}`} disabled>{state.label}</button>)}
  </div>
  <div class="experiment-scenes" aria-live="polite" aria-atomic="true">
    {experiment.states.map((state,i)=><div class="experiment-scene" id={`experiment-${slug}-${state.id}`} data-experiment-scene={state.id} hidden={i!==0}>
      <div class="experiment-art">{practicalTutorialExperiments[slug] ? <PracticalTutorialArt kind={experiment.kind} state={state.id} /> : <TutorialExperimentArt kind={experiment.kind} state={state.id} />}</div>
      <div class="experiment-finding"><p class="experiment-value">{state.value}</p><p class="experiment-unit">{state.unit}</p></div>
      <div class="experiment-explanation"><h3>{state.title}</h3><p>{state.caption}</p></div>
    </div>)}
  </div>
  <noscript><p class="experiment-question">This illustration shows the first case. Enable JavaScript to switch cases; the SQL and results below cover the lesson.</p></noscript>
</figure>
<style>
 .experiment{margin:30px 0 36px;padding:25px;border:0;border-radius:16px;background:#ede7d6;overflow:hidden;color:#35472c}.experiment [hidden]{display:none!important}.experiment header{max-width:600px}.experiment .experiment-eyebrow{margin:0 0 10px;font:600 10px/1.4 var(--font-sans);letter-spacing:.09em;text-transform:uppercase;color:#84632f}.experiment h2{margin:0;padding:0;border:0;font:500 31px/1.12 var(--font-display);letter-spacing:-.02em;color:#35472c}.experiment .experiment-question{margin:12px 0 0;font:14px/1.65 var(--font-sans);color:#586148}
 .experiment-controls{display:flex;flex-wrap:wrap;gap:8px;margin:19px 0 0}.experiment-controls button{min-height:41px;padding:9px 13px;border:1px solid #b1bc9b;border-radius:7px;background:#f9f6ec;color:#3f5630;font:500 12px/1.4 var(--font-sans);cursor:pointer}.experiment-controls button[aria-pressed='true']{background:#45632f;color:#fffdf5;border-color:#45632f}.experiment-controls button:disabled{cursor:default}.experiment-controls button:focus-visible{outline:2px solid #45632f;outline-offset:3px}
 .experiment-scene{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:0 16px;align-items:center;animation:reveal-experiment .22s ease-out}.experiment-art{height:245px;min-width:0;display:flex;align-items:center}.experiment-finding{padding:15px 0 15px 18px;border-left:1px solid #c9c9af}.experiment .experiment-value{margin:0;font:500 38px/1.05 var(--font-display);letter-spacing:-.035em;white-space:nowrap}.experiment .experiment-unit{margin:9px 0 0;font:12px/1.5 var(--font-sans);color:#5c684d}.experiment-explanation{grid-column:1/-1;padding-top:6px}.experiment h3{margin:0;font:600 15px/1.5 var(--font-sans);color:#35472c}.experiment .experiment-explanation p{margin:7px 0 0;font:14px/1.7 var(--font-sans);color:#536144}
 @keyframes reveal-experiment{from{opacity:.5;transform:translateY(3px)}to{opacity:1;transform:none}}
 @media(max-width:650px){.experiment{padding:20px 16px}.experiment h2{font-size:27px}.experiment .experiment-question{font-size:13px}.experiment-scene{grid-template-columns:minmax(0,1fr);gap:0}.experiment-art{height:215px}.experiment-finding{display:flex;gap:14px;align-items:center;border:0;padding:0 0 14px}.experiment .experiment-value{font-size:34px}.experiment .experiment-unit{margin:0;max-width:24ch;font-size:12px}.experiment-controls button{font-size:11px;padding:8px 10px}.experiment .experiment-explanation p{font-size:13px}}
 @media(prefers-reduced-motion:reduce){.experiment-scene{animation:none}}
</style>
<script>
 for(const figure of document.querySelectorAll<HTMLElement>('[data-tutorial-experiment]')){
  const buttons=figure.querySelectorAll<HTMLButtonElement>('[data-experiment-choice]');
  for(const button of buttons){button.disabled=false;button.addEventListener('click',()=>{
   const choice=button.dataset.experimentChoice!;
   figure.dataset.choice=choice;
   for(const other of buttons)other.setAttribute('aria-pressed',String(other===button));
   for(const scene of figure.querySelectorAll<HTMLElement>('[data-experiment-scene]'))scene.hidden=scene.dataset.experimentScene!==choice;
   (window as Window & {gtag?:(...args:unknown[])=>void}).gtag?.('event','tutorial_visual_interaction',{post:figure.dataset.post,content_type:'tutorial',visual:figure.dataset.tutorialExperiment,choice});
  });}
  figure.dataset.experimentReady='true';
 }
</script>
