---
import NewTutorialCardArt from './NewTutorialCardArt.astro';
import {tutorialExperiments} from '../../data/tutorial-experiments';
interface Props { slug: string }
const { slug } = Astro.props;
const kind = slug === 'compare-parquet-duckdb' ? 'snapshots' : slug === 'fuzzy-matching-duckdb' ? 'matching' : slug === 'duckdb-postgresql-query-pushdown' ? 'pushdown' : 'sql';
---
{tutorialExperiments[slug] ? <NewTutorialCardArt slug={slug} /> : <svg class={`card-art art-${kind}`} viewBox="0 0 360 180" fill="none" aria-hidden="true" data-tutorial-card-art={kind}>
  {kind === 'snapshots' && <>
    <circle cx="180" cy="87" r="77" fill="#e8d9b3"/>
    <g class="paper-left"><path d="M44 20h110l18 18v111H44z" fill="#fffdf5"/><path d="M154 20v18h18" fill="#d6c9ab"/>
      <text x="57" y="44" class="paper-heading">Yesterday</text><text x="57" y="70" class="row-count">5<tspan class="row-label"> rows</tspan></text>
      {[88,100,112,124,136].map((y,i)=><rect x="57" y={y} width={i===4?69:98} height="6" rx="2" class={i<3?'changed-mark':'quiet-mark'} fill={i===2?'#c99d81':i<2?'#d4ad58':'#ded9c9'}/>)}
    </g>
    <g class="paper-right"><path d="M197 20h110l18 18v111H197z" fill="#f6f8e9"/><path d="M307 20v18h18" fill="#c6cfb0"/>
      <text x="210" y="44" class="paper-heading">Today</text><text x="210" y="70" class="row-count">5<tspan class="row-label"> rows</tspan></text>
      {[88,100,112,124,136].map((y,i)=><rect x="210" y={y} width={i===4?69:98} height="6" rx="2" class={i<2||i===3?'changed-mark':'quiet-mark'} fill={i===3?'#86a55e':i<2?'#d4ad58':'#ded9c9'}/>)}
    </g>
    <g class="art-answer"><rect x="104" y="143" width="152" height="30" rx="15" fill="#45632f"/><text x="180" y="163" text-anchor="middle" class="answer-label" fill="#fffdf5">4 records changed</text></g>
    <g class="art-question"><circle cx="180" cy="101" r="21" fill="#45632f"/><text x="180" y="110" text-anchor="middle" font-size="28" fill="#fffdf5">?</text></g>
  </>}
  {kind === 'matching' && <>
    <circle cx="180" cy="90" r="76" fill="#dddcbf"/>
    <path d="M96 64c27-28 121-28 155 0M96 114c27 28 121 28 155 0" stroke="#95a477" stroke-width="2" stroke-dasharray="5 7"/>
    <g class="name-left"><rect x="24" y="52" width="163" height="62" rx="9" fill="#fffdf5"/><circle cx="44" cy="69" r="4" fill="#bd9551"/><text x="58" y="73" class="small-label">INCOMING</text><text x="42" y="99" class="name-label">tools ACME</text></g>
    <g class="name-right"><rect x="175" y="92" width="163" height="62" rx="9" fill="#45632f"/><circle cx="196" cy="109" r="4" fill="#d9c888"/><text x="209" y="113" class="small-label" fill="#dce6c5">CANDIDATE</text><text x="193" y="139" class="name-label" fill="#fffdf5">Acme Tools</text></g>
    <g class="match-score"><circle cx="283" cy="48" r="29" fill="#fffdf5" stroke="#86a55e" stroke-width="3"/><text x="283" y="54" text-anchor="middle" font-size="23" fill="#45632f">100</text><text x="283" y="67" text-anchor="middle" font-size="8" fill="#45632f">SIMILARITY</text></g>
  </>}
  {kind === 'pushdown' && <>
    <rect x="21" y="35" width="116" height="115" rx="14" fill="#f8f5e5"/><text x="79" y="59" text-anchor="middle" class="paper-heading">Input rows</text>
    {Array.from({length:35},(_,i)=><rect class="input-tile" x={36+(i%7)*13} y={74+Math.floor(i/7)*12} width="8" height="7" rx="2" fill="#b9944e" style={`--tile:${i}`}/>)}
    <path d="M153 74h52M195 65l10 9-10 9" stroke="#6a8052" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><text x="179" y="101" text-anchor="middle" class="small-label">GROUP BY</text>
    <g class="result-stack"><rect x="222" y="35" width="116" height="115" rx="14" fill="#45632f"/><text x="280" y="59" text-anchor="middle" class="paper-heading" fill="#fffdf5">The answer</text>{[75,91,107,123].map((y,i)=><rect x="238" y={y} width={i===3?59:84} height="9" rx="3" fill="#d4dfb0"/>)}</g>
    <text x="180" y="173" text-anchor="middle" class="answer-label" fill="#45632f">8,000 rows → 4 totals</text>
  </>}
  {kind === 'sql' && <><circle cx="180" cy="90" r="72" fill="#e5d5ae"/><rect x="91" y="39" width="178" height="108" rx="10" fill="#45632f"/><text x="113" y="79" font-size="27" fill="#f8f5e5">SELECT</text>{[96,112,128].map(y=><rect x="113" y={y} width="112" height="5" rx="2" fill="#c9dbab"/>)}</>}
</svg>}
<style>
  .card-art{display:block;width:100%;height:100%;max-width:430px;font-family:var(--font-sans);overflow:visible}.paper-heading{font:600 16px var(--font-display);fill:#3b402a}.row-count{font:500 25px var(--font-display);fill:#3b402a}.row-label{font:11px var(--font-sans)}.answer-label{font:500 13px var(--font-sans)}.small-label{font:9px var(--font-sans);letter-spacing:.04em;fill:#666b50}.name-label{font:500 20px var(--font-display);fill:#3b402a}.name-right .name-label,.result-stack .paper-heading{fill:#fffdf5}.name-right .small-label{fill:#dce6c5}
  .paper-left,.paper-right,.name-left,.name-right,.match-score,.result-stack,.input-tile,.art-answer,.changed-mark{transition:transform .35s ease,opacity .3s ease,fill .3s ease;transform-box:fill-box;transform-origin:center}.paper-left{transform:rotate(-8deg)}.paper-right{transform:rotate(8deg)}.art-question{display:none}
  :global(.tutorial-card:hover) .paper-left,:global(.tutorial-card:focus-within) .paper-left{transform:rotate(-3deg) translateX(-3px)}:global(.tutorial-card:hover) .paper-right,:global(.tutorial-card:focus-within) .paper-right{transform:rotate(3deg) translateX(3px)}:global(.tutorial-card:hover) .name-left,:global(.tutorial-card:focus-within) .name-left{transform:translate(6px,4px)}:global(.tutorial-card:hover) .name-right,:global(.tutorial-card:focus-within) .name-right{transform:translate(-6px,-4px)}:global(.tutorial-card:hover) .match-score,:global(.tutorial-card:focus-within) .match-score{transform:scale(1.08)}:global(.tutorial-card:hover) .input-tile,:global(.tutorial-card:focus-within) .input-tile{transform:translateX(3px);opacity:.55;transition-delay:calc(var(--tile)*6ms)}:global(.tutorial-card:hover) .result-stack,:global(.tutorial-card:focus-within) .result-stack{transform:translateX(-5px)}
  :global([data-tutorial-hero][data-revealed='false']) .art-answer{opacity:0;transform:translateY(5px)}:global([data-tutorial-hero][data-revealed='false']) .changed-mark{fill:#ded9c9}:global([data-tutorial-hero][data-revealed='false']) .art-question{display:block}
  @media(prefers-reduced-motion:reduce){.card-art *{transition:none!important}}
</style>
