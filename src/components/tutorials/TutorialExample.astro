---
import CodeBlock from '../ui/CodeBlock.astro';
import TutorialResult from './TutorialResult.astro';
interface Props { example: {
  id: string;
  title: string;
  sql: string;
  expectedColumns?: string[];
  expectedRows?: (string | number | boolean | null)[][];
  planExcerpt?: string;
  planLabel?: string;
  planNote?: string;
} }
const { example } = Astro.props;
---
<section class="tutorial-example my-7 min-w-0" id={example.id} data-article-example={example.id} aria-label={example.title}>
  <p class="mb-3 text-sm font-medium text-soil-700">{example.title}</p>
  <CodeBlock code={example.sql} />
  {example.expectedRows !== undefined && <TutorialResult
    columns={example.expectedColumns}
    rows={example.expectedRows}
    emptyMessage={example.id === 'check-keys' ? 'No invalid keys found in either snapshot.' : undefined}
  />}
  {example.planExcerpt !== undefined && <TutorialResult
    text={example.planExcerpt}
    label={example.planLabel ?? 'Captured local plan · selected operators'}
    note={example.planNote ?? 'Reformatted from native DuckDB 2.0.0 on the same data. Timings and internal projections omitted; browser formatting can differ.'}
  />}
</section>
