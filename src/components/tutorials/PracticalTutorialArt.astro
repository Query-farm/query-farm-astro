---
interface Props {kind:string;state:string;compact?:boolean}
const {kind,state,compact=false}=Astro.props;
const green='#45632f',gold='#b98645',cream='#fffdf5',pale='#dce4cb';
const is=(s:string)=>s===state;
const eventTimes=['09:00','09:05','09:06','09:15','09:45','10:20'];
const funnel:Record<string,{steps:string[];times:string[];ok:boolean[];note:string}>={
 ada:{steps:['VIEW','RUN × 2','ENQUIRY'],times:['09:00','09:05 / 06','09:15'],ok:[true,true,true],note:'One qualifying session · 15 minutes'},
 ben:{steps:['RUN','VIEW','ENQUIRY'],times:['10:00','10:05','10:08'],ok:[false,true,false],note:'Run precedes entry · no valid second step'},
 cy:{steps:['VIEW','RUN','ENQUIRY'],times:['09:00','09:02','10:00'],ok:[true,true,false],note:'Enquiry is outside the window and session'},
 dee:{steps:['VIEW','RUN','ENQUIRY'],times:['11:00','11:04','11:12'],ok:[true,true,true],note:'One qualifying session · 12 minutes'},
};
const f=funnel[state];
const counts:Record<number,number>={1:70,2:0,4:14,5:28,8:42,9:56,10:70,11:84};
const cells=[['North','jan',100],['North','feb',null],['North','mar',140],['South','jan',50],['South','feb',70],['South','mar',0]];
const hashUsers=[['Ada',83],['Ben',4],['Cy',45],['Dee',65],['Eli',73],['Fay',83],['Gus',77],['Hao',10],...(is('ivy')?[['Ivy',11]]:[])];
---
<svg class:list={['practical-art',{'compact':compact}]} viewBox="0 0 520 260" fill="none" aria-hidden="true" data-practical-art={kind} data-tutorial-card-art={compact?kind:undefined}>
 {kind==='sessions'&&<>
  <text x="20" y="26" class="eyebrow">SIX CLICKS · EVENT ORDER, SPACING SCHEMATIC</text>
  {(is('45')?[[16,488]]:is('20')?[[16,312],[352,68],[436,68]]:[[16,404],[436,68]]).map(([x,w],i)=><g class="arrive" style={`--i:${i}`}><rect x={x} y="96" width={w} height="104" rx="18" fill={i%2===0?pale:'#e7d1a4'}/><text x={x+w/2} y="183" text-anchor="middle" class="small">S{i+1}</text></g>)}
  <path d="M46 127H474" stroke="#98aa7f" stroke-width="3"/>
  {eventTimes.map((t,i)=><g class="arrive" style={`--i:${i}`}><circle cx={46+i*85} cy="127" r="15" fill={i<4||is('45')?green:i===4&&is('30')?green:gold}/><text x={46+i*85} y="133" text-anchor="middle" class="small light">{i+1}</text><text x={46+i*85} y="225" text-anchor="middle" class="small">{t}</text></g>)}
  <path d="M301 89q42-61 85 0m0 0q42-61 85 0" stroke="#ae9567" stroke-width="2" stroke-dasharray="4 4"/>
  <text x="343" y="55" text-anchor="middle" class="label">30m</text><text x="429" y="55" text-anchor="middle" class="label">35m</text>
 </>}
 {kind==='funnel'&&f&&<>
  <text x="20" y="27" class="eyebrow">{state.toUpperCase()}’S JOURNEY</text>
  <path d="M72 110H448" stroke="#a1b28b" stroke-width="4"/>
  {f.steps.map((s,i)=><g class="arrive" style={`--i:${i}`}><rect x={14+i*173} y="62" width="147" height="102" rx="16" fill={f.ok[i]?green:'#e4c795'}/><text x={87+i*173} y="96" text-anchor="middle" class={f.ok[i]?'label light':'label'}>{s}</text><text x={87+i*173} y="137" text-anchor="middle" class={f.ok[i]?'heading light':'heading'}>{f.times[i]}</text><circle cx={137+i*173} cy="66" r="15" fill={f.ok[i]?'#a9bc8b':gold}/><text x={137+i*173} y="72" text-anchor="middle" class="label light">{f.ok[i]?'✓':'!'}</text></g>)}
  <text x="260" y="203" text-anchor="middle" class="label">{f.note}</text>
  <text x="260" y="240" text-anchor="middle" class="small">Whole fixture: 9 entries → 3 runs → 2 enquiries</text>
 </>}
 {kind==='calendar'&&<>
  <text x="20" y="25" class="eyebrow">JANUARY 2026 · WINDOW ENDS ON THE 11TH</text>
  {Array.from({length:11},(_,i)=>i+1).map((day,i)=>{
   const present=day in counts,selected=is('rows')?day>=2&&present:day>=5&&(present||is('filled'));
   const x=16+(i%6)*84,y=45+Math.floor(i/6)*96;
   return <g class="arrive" style={`--i:${i/2}`}><rect x={x} y={y} width="73" height="82" rx="10" fill={selected?(is('rows')?'#e6cc98':green):cream} stroke={!present?'#9d8b69':'none'} stroke-dasharray={!present?'4 3':undefined}/><text x={x+12} y={y+23} class={selected&&!is('rows')?'small light':'small'}>{String(day).padStart(2,'0')}</text><text x={x+36} y={y+62} text-anchor="middle" class={selected&&!is('rows')?'number light':'number'}>{present?counts[day]:is('filled')&&day>=5?'0':'—'}</text></g>;
  })}
  <text x="260" y="251" text-anchor="middle" class="small">{is('rows')?'Highlighted: seven recorded observations':is('range')?'Highlighted: five observed values inside January 5–11':'Highlighted: seven dates, with two assumed zeros'}</text>
 </>}
 {kind==='schemas'&&<>
  {[{name:'EARLIER',cols:'id · amount_text',rows:['1    10.00','2    20.00']},{name:'LATER',cols:'+ coupon',rows:['3    30.50    SAVE','4    pending    NULL']}].map((file,i)=><g class="arrive" style={`--i:${i}`}><rect x="12" y={19+i*119} width="206" height="101" rx="12" fill={cream}/><text x="27" y={44+i*119} class="eyebrow">{file.name}</text><text x="27" y={65+i*119} class="small">{file.cols}</text>{file.rows.map((r,j)=><text x="27" y={87+i*119+j*20} class="code">{r}</text>)}</g>)}
  <path d="M229 68q23 0 23 61t23 61m-46-3q23 0 23-58t23-61" stroke="#8ba16e" stroke-width="2"/>
  <rect x="282" y="29" width="227" height="207" rx="14" fill={green}/><text x="299" y="57" class="eyebrow light">{is('typed')?'TYPED AMOUNTS':'UNION BY NAME'}</text>
  <text x="299" y="83" class="small light">ID</text><text x="334" y="83" class="small light">{is('typed')?'amount':'text'}</text><text x="435" y="83" class="small light">coupon</text>
  {[['1','10.00','NULL'],['2','20.00','NULL'],['3','30.50','SAVE'],['4',is('typed')?'NULL':'pending','NULL']].map((r,i)=><g class="arrive" style={`--i:${i}`}>
   {i===3&&<rect x="292" y={93+i*33} width="207" height="28" rx="5" fill={gold}/>}
   {r.map((v,j)=><text x={[299,334,435][j]} y={112+i*33} class="code light">{v}</text>)}
  </g>)}
 </>}
 {kind==='reshape'&&<>
  {(is('wide')||is('report'))?<>
   <text x="20" y="27" class="eyebrow">{is('report')?'REGIONAL REPORT · SUM AT EACH CELL':'SOURCE SPREADSHEET'}</text>
   {['REGION','JAN','FEB','MAR'].map((v,i)=><text x={[25,211,329,447][i]} y="68" text-anchor={i?'middle':'start'} class="eyebrow">{v}</text>)}
   {['North','South'].map((r,i)=><g class="arrive" style={`--i:${i}`}><text x="25" y={124+i*76} class="heading">{r}</text>{[0,1,2].map(j=><g><rect x={165+j*118} y={87+i*76} width="93" height="58" rx="10" fill={i===0&&j===1?'#e7d0a0':green}/><text x={211+j*118} y={124+i*76} text-anchor="middle" class={i===0&&j===1?'label':'heading light'}>{cells[i*3+j][2]??'NULL'}</text></g>)}</g>)}
   <text x="260" y="249" text-anchor="middle" class="small">Unknown February ≠ zero March</text>
  </>:<>
   <text x="20" y="25" class="eyebrow">REGION</text><text x="209" y="25" class="eyebrow">MONTH</text><text x="399" y="25" class="eyebrow">AMOUNT</text>
   {cells.filter(c=>is('complete')||c[2]!==null).map((row,i)=><g class="arrive" style={`--i:${i}`}><rect x="14" y={37+i*36} width="491" height="29" rx="7" fill={row[2]===null?'#e7d0a0':cream}/>{row.map((v,j)=><text x={[25,209,399][j]} y={57+i*36} class="label">{v??'NULL'}</text>)}</g>)}
  </>}
 </>}
 {kind==='cohort'&&<>
  <text x="18" y="26" class="eyebrow">SIGNUP WEEK</text>{[0,1,2].map(i=><text x={203+i*120} y="26" text-anchor="middle" class="eyebrow">WEEK {i}</text>)}
  {[[100,50,100],[100,0,null],[100,null,null]].map((row,r)=><g><text x="18" y={74+r*56} class="label">Jan {5+r*7}</text>{row.map((value,c)=><g class="arrive" style={`--i:${r+c}`}><rect x={149+c*120} y={43+r*56} width="107" height="44" rx="9" fill={value===null?cream:value===0?'#e5d3b0':value===50?'#91a774':green} stroke={c===1&&r===(is('return')?0:is('zero')?1:2)?'#a46b20':'none'} stroke-width="4" stroke-dasharray={value===null?'4 4':undefined}/><text x={203+c*120} y={72+r*56} text-anchor="middle" class={value!==null&&value>0?'label light':'label'}>{value===null?'—':value+'%'}</text></g>)}</g>)}
  {(is('return')?['Ada ✓','Ben —']:is('zero')?['Cy —','Dee —']:['Eli ?']).map((name,i,all)=><g class="arrive" style="--i:3"><rect x={260-all.length*75+i*150} y="218" width="135" height="34" rx="17" fill={is('return')&&i===0?green:cream}/><text x={327-all.length*75+i*150} y="241" text-anchor="middle" class={is('return')&&i===0?'label light':'label'}>{name}</text></g>)}
 </>}
 {kind==='percentile'&&<>
  <text x="18" y="24" class="eyebrow">100 REQUESTS · SORTED FROM FASTEST TO SLOWEST</text>
  {Array.from({length:100},(_,i)=><g class="arrive" style={`--i:${Math.floor(i/20)}`}><circle cx={25+(i%20)*24.5} cy={49+Math.floor(i/20)*25} r="8" fill={i<95?green:gold}/>{i===94&&<circle cx={25+14*24.5} cy="149" r="12" stroke="#b27728" stroke-width="3"/>}</g>)}
  <text x="18" y="186" class="small">95 × 100 ms</text><text x="500" y="186" text-anchor="end" class="small">5 × 1,000 ms</text>
  <path d="M25 215H495" stroke="#aeb89a" stroke-width="3"/>
  <path d={`M25 215H${25+(is('exact')?100:is('mean')?550:145)*.47}`} stroke={is('exact')?green:gold} stroke-width="12" stroke-linecap="round"/>
  <circle cx={25+100*.47} cy="215" r="9" fill={cream} stroke={green} stroke-width="3"/>
  <text x="25" y="249" class="small">0</text><text x="495" y="249" text-anchor="end" class="small">1,000 ms</text><text x="260" y="249" text-anchor="middle" class="small">Outlined dot = request 95</text>
 </>}
 {kind==='transform'&&<>
  <rect x="14" y="24" width="206" height="210" rx="14" fill={cream}/><text x="31" y="54" class="eyebrow">SUPPLIED JSON</text>
  <text x="32" y="91" class="code">id: 101</text><text x="32" y="119" class="code">buyer.name: Ada</text><text x="32" y="147" class="code">items: [ MUG, TEA ]</text><text x="32" y="181" class="small">2 × 12.50</text><text x="32" y="208" class="small">1 × 8.00</text>
  <path d="M230 130h40m-9-8 9 8-9 8" stroke="#849867" stroke-width="3"/>
  <rect x="282" y="24" width="224" height="210" rx="14" fill={green}/><text x="299" y="54" class="eyebrow light">{is('arrays')?'CONSISTENT ARRAYS':'NEW CONTRACT'}</text>
  {(is('rename')?['order_id: 101','customer: Ada']:is('arrays')?['Ada [MUG, TEA]','Ben []','Cy [MUG]']:['order_id: 101','currency: USD','total: 33']).map((t,i)=><g class="arrive" style={`--i:${i}`}><rect x="293" y={75+i*46} width="201" height="35" rx="7" fill="#66844d"/><text x="304" y={99+i*46} class="code light">{t}</text></g>)}
  <text x="260" y="258" text-anchor="middle" class="small">Schematic fields · complete JSON is shown in the SQL results</text>
 </>}
 {kind==='buckets'&&<>
  <text x="18" y="25" class="eyebrow">TREATMENT IF BUCKET &lt; {is('50')?'50':'20'} · GREEN = TREATMENT</text>
  {hashUsers.map(([name,bucket],i)=>{const x=14+i%3*173,y=40+Math.floor(i/3)*65,treatment=Number(bucket)<(is('50')?50:20);return <g class="arrive" style={`--i:${i/2}`}><rect x={x} y={y} width="146" height="52" rx="11" fill={treatment?green:cream}/><text x={x+14} y={y+33} class={treatment?'heading light':'heading'}>{name}</text><text x={x+129} y={y+33} text-anchor="end" class={treatment?'label light':'label'}>{bucket}</text></g>})}
  <text x="260" y="257" text-anchor="middle" class="small">Same input + algorithm + seed → same bucket</text>
 </>}
 {kind==='absence'&&<>
  <text x="20" y="26" class="eyebrow">CUSTOMERS</text><text x="315" y="26" class="eyebrow">ORDERS → CUSTOMER</text>
  <path d="M196 63C250 63 250 63 309 63M196 63C250 63 250 111 309 111M196 159C250 159 250 207 309 207" stroke="#9faf8d" stroke-width="2"/>
  {['Ada','Ben','Cy','Dee'].map((name,i)=><g class="arrive" style={`--i:${i}`}><rect x="14" y={42+i*48} width="182" height="38" rx="9" fill={is('customers')&&i%2===1?green:cream}/><text x="27" y={67+i*48} class={is('customers')&&i%2===1?'label light':'label'}>{name}</text>{is('predicate')&&<text x="182" y={67+i*48} text-anchor="end" class={i%2===1?'warning':'small'}>{i%2===1?'NULL':'false'}</text>}{is('customers')&&i%2===1&&<text x="176" y={67+i*48} class="label light">✓</text>}</g>)}
  {['101 → 1','102 → 1','103 → NULL','104 → 3'].map((label,i)=><g class="arrive" style={`--i:${i}`}><rect x="309" y={42+i*48} width="197" height="38" rx="9" fill={i===2?(is('orders')?green:'#e6cca0'):cream}/><text x="325" y={67+i*48} class={i===2&&is('orders')?'label light':'label'}>{label}</text></g>)}
  <text x="260" y="254" text-anchor="middle" class="small">{is('predicate')?'WHERE keeps true; neither false nor NULL passes.':is('customers')?'No matching order → keep the customer.':'No matching customer → keep the order.'}</text>
 </>}
</svg>
<style>
 .practical-art{display:block;width:100%;height:100%;min-width:0;min-height:0;overflow:visible;font-family:var(--font-sans)}.eyebrow{font:600 12px var(--font-sans);letter-spacing:.025em;fill:#6b7054}.small{font:15px var(--font-sans);fill:#60694e}.label{font:500 18px var(--font-sans);fill:#435335}.heading{font:600 23px var(--font-display);fill:#3b4b30}.number{font:500 30px var(--font-display);fill:#3b4b30}.code{font:15px ui-monospace,monospace;fill:#435335}.warning{font:500 17px var(--font-sans);fill:#9a6529}.light{fill:#fffdf5}.arrive{animation:art-arrive .32s ease-out both;animation-delay:calc(var(--i,0)*.035s);transform-box:fill-box;transform-origin:center}.compact .arrive{animation:none}.compact{transition:transform .3s ease}:global(.tutorial-card:hover) .compact{transform:translateY(-3px)}@keyframes art-arrive{from{opacity:.35;transform:translateY(5px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.arrive{animation:none}.compact{transition:none}}
</style>
