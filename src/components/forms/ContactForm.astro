---
import Input from './Input.astro';
import Textarea from './Textarea.astro';
import Select from './Select.astro';
import Button from '../ui/Button.astro';

const inquiryOptions = [
  { value: 'consulting', label: 'Consulting Services' },
  { value: 'extensions', label: 'DuckDB Extensions' },
  { value: 'services', label: 'Data Services' },
  { value: 'partnership', label: 'Partnership Opportunities' },
  { value: 'other', label: 'Other' }
];
---

<form class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <Input
      label="First Name"
      name="firstName"
      type="text"
      placeholder="John"
      required
    />
    <Input
      label="Last Name"
      name="lastName"
      type="text"
      placeholder="Doe"
      required
    />
  </div>

  <Input
    label="Email Address"
    name="email"
    type="email"
    placeholder="john@example.com"
    required
  />

  <Input
    label="Company"
    name="company"
    type="text"
    placeholder="Your Company Name"
  />

  <Select
    label="Inquiry Type"
    name="inquiryType"
    options={inquiryOptions}
    required
  />

  <Textarea
    label="Message"
    name="message"
    placeholder="Tell us about your project or inquiry..."
    required
    rows={6}
  />

  <div class="flex items-start">
    <input
      type="checkbox"
      id="consent"
      name="consent"
      required
      class="mt-1 h-4 w-4 rounded border-soil-300 text-earth-600 focus:ring-earth-500"
    />
    <label for="consent" class="ml-2 text-sm text-soil-700">
      I agree to receive communications from Query.Farm about my inquiry.
      <span class="text-harvest-600">*</span>
    </label>
  </div>

  <Button variant="primary" size="lg" type="submit">
    Send Message
  </Button>

  <p class="text-sm text-soil-500 italic">
    Note: Form submission is currently UI-only. Backend integration coming soon.
  </p>
</form>
