---
interface Props {
  inline?: boolean;
  class?: string;
  /** Unique per instance — the footer form and a page form can co-exist. */
  id?: string;
}

const { inline = false, class: className = '', id = 'newsletter-email' } = Astro.props;

// Buttondown list/username — see /company/newsletter for the dedicated page.
const buttondownList = 'queryfarm-dispatch';
---

<form
  action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownList}`}
  method="post"
  target="popupwindow"
  onsubmit={`window.open('https://buttondown.com/${buttondownList}', 'popupwindow')`}
  class={inline ? `flex gap-2 ${className}` : `w-full ${className}`}
>
  <div class={inline ? 'flex-1' : 'flex w-full flex-col gap-1.5'}>
    <label
      for={id}
      class={inline ? 'sr-only' : 'text-[12.5px] font-medium text-soil-600'}
    >
      Email address
    </label>
    <input
      type="email"
      id={id}
      name="email"
      placeholder="you@company.com"
      required
      class="w-full rounded-lg border border-soil-300 bg-[#fffdf7] px-3.5 py-2.5 text-[15.5px] font-light text-soil-900 transition placeholder:text-soil-500 focus:border-link focus:ring-[3px] focus:ring-link/20 focus:outline-none"
    />
  </div>

  <button
    type="submit"
    class={`rounded-lg border border-field-700 bg-field-700 px-5 py-2.5 text-sm font-medium text-white transition hover:-translate-y-px motion-reduce:hover:translate-y-0 ${inline ? '' : 'mt-3 w-full sm:w-auto'}`}
  >
    Subscribe
  </button>
</form>

{!inline && (
  <p class="mt-2.5 text-[13px] text-soil-600">
    New DuckDB extensions, releases, and infrastructure notes. Unsubscribe any time.
  </p>
)}
