---
import Button from '../ui/Button.astro';

interface Props {
  inline?: boolean;
  class?: string;
}

const { inline = false, class: className = '' } = Astro.props;
---

<form class={inline ? `flex gap-2 ${className}` : `space-y-4 ${className}`}>
  <div class={inline ? 'flex-1' : 'w-full'}>
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      type="email"
      id="newsletter-email"
      name="email"
      placeholder="Enter your email"
      required
      class="w-full px-4 py-2.5 rounded-lg border border-soil-300 focus:border-earth-500 focus:ring-2 focus:ring-earth-500 focus:outline-none transition-colors duration-200"
    />
  </div>
  <Button variant="accent" type="submit">
    Subscribe
  </Button>
</form>

{!inline && (
  <p class="mt-2 text-xs text-soil-500">
    Get updates on new DuckDB extensions, releases, and data infrastructure insights.
  </p>
)}
