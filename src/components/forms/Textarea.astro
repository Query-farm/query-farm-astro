---
interface Props {
  label: string;
  name: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  value?: string;
  error?: string;
  class?: string;
}

const {
  label,
  name,
  placeholder,
  required = false,
  rows = 4,
  value,
  error,
  class: className = ''
} = Astro.props;

const textareaClasses = error
  ? 'border-red-500 focus:border-red-600 focus:ring-red-500'
  : 'border-soil-300 focus:border-earth-500 focus:ring-earth-500';
---

<div class={`space-y-2 ${className}`}>
  <label for={name} class="block text-sm font-medium text-soil-900">
    {label}
    {required && <span class="text-harvest-600">*</span>}
  </label>
  <textarea
    id={name}
    name={name}
    placeholder={placeholder}
    required={required}
    rows={rows}
    class={`w-full px-4 py-2.5 rounded-lg border ${textareaClasses} focus:outline-none focus:ring-2 transition-colors duration-200 resize-y`}
  >{value}</textarea>
  {error && (
    <p class="text-sm text-red-600">{error}</p>
  )}
</div>
