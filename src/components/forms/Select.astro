---
interface Props {
  label: string;
  name: string;
  options: { value: string; label: string }[];
  required?: boolean;
  value?: string;
  error?: string;
  class?: string;
}

const {
  label,
  name,
  options,
  required = false,
  value,
  error,
  class: className = ''
} = Astro.props;

const selectClasses = error
  ? 'border-red-500 focus:border-red-600 focus:ring-red-500'
  : 'border-soil-300 focus:border-earth-500 focus:ring-earth-500';
---

<div class={`space-y-2 ${className}`}>
  <label for={name} class="block text-sm font-medium text-soil-900">
    {label}
    {required && <span class="text-harvest-600">*</span>}
  </label>
  <select
    id={name}
    name={name}
    required={required}
    class={`w-full px-4 py-2.5 rounded-lg border ${selectClasses} focus:outline-none focus:ring-2 transition-colors duration-200 bg-white`}
  >
    <option value="">Select an option</option>
    {options.map(option => (
      <option value={option.value} selected={value === option.value}>
        {option.label}
      </option>
    ))}
  </select>
  {error && (
    <p class="text-sm text-red-600">{error}</p>
  )}
</div>
