---
/**
 * SparkBars — the card-sized crop of a post's lead figure.
 *
 * Same numbers as the hero BarTable, no axes, no values: at card size a chart
 * can only carry shape, so it carries shape and the caption says what it is.
 * Marked aria-hidden because the card's title and topic already name the post —
 * a screen reader gets nothing from an unlabelled decorative crop, and the full
 * figure is a table on the post itself.
 */
import type { BarRow, BarSeries } from './chart-types';

interface Props {
  series: BarSeries[];
  rows: BarRow[];
  label: string;
  /** Rows to show; the rest are dropped. */
  limit?: number;
}

const { series, rows, label, limit = 5 } = Astro.props;

const shown = rows.slice(0, limit);
const scaleMax = Math.max(...shown.flatMap(row => row.values));
const pct = (n: number) => `${Math.max((n / scaleMax) * 100, 2)}%`;
---

<div class="qf-spark" aria-hidden="true">
  <div class="qf-spark-plot">
    {shown.map(row => (
      <div class="qf-spark-row">
        {row.values.map((value, i) => (
          <span class="qf-spark-track">
            <span class="qf-spark-bar" style={`width:${pct(value)};background:${row.color ?? series[i].color}`}></span>
          </span>
        ))}
      </div>
    ))}
  </div>
  <span class="qf-spark-label">{label}</span>
</div>

<style>
  .qf-spark {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--color-soil-200);
    background: linear-gradient(180deg, #fffdf7 0%, var(--color-soil-50) 100%);
  }
  .qf-spark-plot {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .qf-spark-row {
    display: flex;
    flex-direction: column;
    /* The 2px surface gap that separates touching marks. */
    gap: 2px;
  }
  .qf-spark-track {
    display: block;
    height: 4px;
  }
  .qf-spark-bar {
    display: block;
    height: 4px;
    border-radius: 0 2px 2px 0;
  }
  .qf-spark-label {
    font-size: 11.5px;
    color: var(--color-soil-500);
  }
</style>
