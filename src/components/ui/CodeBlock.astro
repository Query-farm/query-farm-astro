---
interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'sql', title } = Astro.props;

// Generate unique ID for this code block
const blockId = `code-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="code-block-wrapper relative rounded-lg overflow-hidden border border-green-900/30" style="background: linear-gradient(135deg, #1a3a1a 0%, #0d2818 100%);">
  {title && (
    <div class="px-4 py-2 border-b border-green-900/30 flex items-center justify-between" style="background: rgba(13, 40, 24, 0.8);">
      <span class="text-sm font-mono text-green-200">{title}</span>
      <button
        class="copy-button px-3 py-1 text-xs font-medium text-green-300 hover:text-green-200 transition-colors rounded"
        data-code-id={blockId}
        aria-label="Copy code"
      >
        <span class="copy-text">Copy</span>
        <span class="copied-text hidden">Copied!</span>
      </button>
    </div>
  )}

  <div class="relative">
    {!title && (
      <button
        class="copy-button absolute top-3 right-3 px-3 py-1.5 text-xs font-medium text-green-300 hover:text-green-100 transition-colors rounded backdrop-blur-sm z-10"
        style="background: rgba(13, 40, 24, 0.9);"
        data-code-id={blockId}
        aria-label="Copy code"
      >
        <span class="copy-text flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy
        </span>
        <span class="copied-text hidden flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Copied!
        </span>
      </button>
    )}

    <pre
      id={blockId}
      class={`p-4 overflow-x-auto leading-relaxed language-${lang} farm-theme`}
      data-language={lang}
      style="font-size: 0.9375rem;"
    ><code class={`language-${lang}`}>{code}</code></pre>
  </div>
</div>

<style is:global>
  /* Farm-themed Prism syntax highlighting */
  .farm-theme {
    background: linear-gradient(135deg, #1a3a1a 0%, #0d2818 100%) !important; /* Dark green gradient */
    color: #e8f5e9; /* Light green-tinted white */
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    tab-size: 2;
  }

  .farm-theme code {
    display: block;
    white-space: pre;
    background: transparent;
    color: inherit;
  }

  /* Prism token colors with vibrant farm theme */
  .farm-theme .token.comment,
  .farm-theme .token.prolog,
  .farm-theme .token.doctype,
  .farm-theme .token.cdata {
    color: #a5d6a7; /* Light green - more visible comments */
    font-style: italic;
    opacity: 0.9;
  }

  .farm-theme .token.punctuation {
    color: #c8e6c9; /* Very light green */
  }

  .farm-theme .token.property,
  .farm-theme .token.tag,
  .farm-theme .token.boolean,
  .farm-theme .token.constant,
  .farm-theme .token.symbol,
  .farm-theme .token.deleted {
    color: #fff59d; /* Bright yellow - golden wheat */
  }

  .farm-theme .token.selector,
  .farm-theme .token.attr-name,
  .farm-theme .token.string,
  .farm-theme .token.char,
  .farm-theme .token.builtin,
  .farm-theme .token.inserted {
    color: #c5e1a5; /* Fresh sprout green */
  }

  .farm-theme .token.operator,
  .farm-theme .token.entity,
  .farm-theme .token.url,
  .farm-theme .token.variable {
    color: #e8f5e9; /* Light text */
  }

  .farm-theme .token.keyword,
  .farm-theme .token.atrule,
  .farm-theme .token.attr-value {
    color: #66bb6a; /* Vibrant harvest green */
    font-weight: 600;
  }

  .farm-theme .token.function,
  .farm-theme .token.class-name {
    color: #ffeb3b; /* Bright sunflower yellow */
    font-weight: 500;
  }

  .farm-theme .token.regex,
  .farm-theme .token.important {
    color: #ffb74d; /* Warm earth orange */
  }

  .farm-theme .token.number {
    color: #ffab91; /* Terracotta/clay orange */
  }

  .farm-theme .token.important,
  .farm-theme .token.bold {
    font-weight: bold;
  }

  .farm-theme .token.italic {
    font-style: italic;
  }
</style>

<!-- Load Prism.js for syntax highlighting -->
<script is:inline>
  // Load Prism.js from CDN if not already loaded
  if (typeof Prism === 'undefined') {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js';
    script.onload = function() {
      // Load SQL language support
      const sqlScript = document.createElement('script');
      sqlScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js';
      sqlScript.onload = function() {
        // Highlight all code blocks
        if (typeof Prism !== 'undefined') {
          Prism.highlightAll();
        }
      };
      document.head.appendChild(sqlScript);
    };
    document.head.appendChild(script);
  } else {
    // Prism already loaded, just highlight
    if (typeof Prism !== 'undefined') {
      Prism.highlightAll();
    }
  }
</script>

<script is:inline>
  // Copy functionality
  (function() {
    function setupCopyButtons() {
      const copyButtons = document.querySelectorAll('.copy-button');

      copyButtons.forEach(button => {
        // Remove existing listeners to prevent duplicates
        const newButton = button.cloneNode(true);
        button.parentNode.replaceChild(newButton, button);

        newButton.addEventListener('click', async function() {
          const codeId = this.getAttribute('data-code-id');
          const codeBlock = document.getElementById(codeId);

          if (codeBlock) {
            const code = codeBlock.textContent || '';

            try {
              await navigator.clipboard.writeText(code);

              // Show "Copied!" feedback
              const copyText = this.querySelector('.copy-text');
              const copiedText = this.querySelector('.copied-text');

              if (copyText && copiedText) {
                copyText.classList.add('hidden');
                copiedText.classList.remove('hidden');

                // Reset after 2 seconds
                setTimeout(() => {
                  copyText.classList.remove('hidden');
                  copiedText.classList.add('hidden');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy code:', err);
            }
          }
        });
      });
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCopyButtons);
    } else {
      setupCopyButtons();
    }
  })();
</script>
