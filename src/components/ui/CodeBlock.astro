---
/**
 * CodeBlock — code always sits on rock-900 (#1a1512). Never on a coloured
 * band: syntax hues lose separation on brown. See DESIGN_BRIEF.md §3.
 *
 * The `pre[data-language]` hook is what src/components/repl/ExampleShellMounter
 * looks for to inject the "Try" button, and `.code-block-wrapper` /
 * `.code-block-toolbar` are the class names it reaches for — do not rename.
 */
interface Props {
  code: string;
  lang?: string;
  title?: string;
  /** When false, omit data-language so the REPL "Try" mounter skips this block.
   *  Syntax highlighting (driven by the language-* class) is unaffected. Use for
   *  boilerplate like the bare INSTALL/LOAD block, which has nothing to run. */
  tryable?: boolean;
}

const { code, lang = 'sql', title, tryable = true } = Astro.props;

// Generate unique ID for this code block
const blockId = `code-${Math.random().toString(36).substr(2, 9)}`;

const copyButtonClass =
  'code-toolbar-button copy-button transition-colors';
---

<div class="code-block-wrapper relative overflow-hidden rounded-xl border border-rock-800 bg-rock-900">
  {title && (
    <div class="flex items-center justify-between border-b border-rock-800 bg-rock-950 px-4 py-2">
      <span class="text-[13px] font-medium text-cream-2">{title}</span>
      <div class="code-block-controls flex items-center gap-1">
        <button class={copyButtonClass} data-code-id={blockId} aria-label="Copy code">
          <span class="copy-text inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy
          </span>
          <span class="copied-text hidden items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Copied!
          </span>
        </button>
      </div>
    </div>
  )}

  {!title && (
    <div class="code-block-toolbar flex items-center justify-end gap-1 border-b border-rock-800 bg-rock-950 px-2 py-1">
      <button class={copyButtonClass} data-code-id={blockId} aria-label="Copy code">
        <span class="copy-text inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy
        </span>
        <span class="copied-text hidden items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Copied!
        </span>
      </button>
    </div>
  )}

  <pre
    id={blockId}
    class={`overflow-x-auto p-5 language-${lang} farm-theme`}
    data-language={tryable ? lang : undefined}
  ><code class={`language-${lang}`}>{code}</code></pre>
</div>

<style is:global>
  /* Strata Sun syntax theme. Ground is rock-900, always — never a band. */
  .farm-theme {
    background: #1a1512 !important;
    color: #e9e1d3;
    font-family: var(--qf-code-font-family);
    font-size: var(--qf-code-font-size);
    line-height: var(--qf-code-line-height);
    tab-size: 2;
  }

  .farm-theme code {
    display: block;
    white-space: pre;
    background: transparent;
    color: inherit;
  }

  /* The copied-text span is toggled with .hidden, so it must not be forced to
     flex while hidden. */
  .code-block-wrapper .copied-text:not(.hidden) {
    display: inline-flex;
  }

  .farm-theme .token.comment,
  .farm-theme .token.prolog,
  .farm-theme .token.doctype,
  .farm-theme .token.cdata {
    color: #8b8073;
    font-style: italic;
  }

  .farm-theme .token.punctuation {
    color: #c6b8a2;
  }

  .farm-theme .token.property,
  .farm-theme .token.tag,
  .farm-theme .token.boolean,
  .farm-theme .token.constant,
  .farm-theme .token.symbol,
  .farm-theme .token.deleted {
    color: #e0b464;
  }

  .farm-theme .token.selector,
  .farm-theme .token.attr-name,
  .farm-theme .token.string,
  .farm-theme .token.char,
  .farm-theme .token.builtin,
  .farm-theme .token.inserted {
    color: #9fc48c;
  }

  .farm-theme .token.operator,
  .farm-theme .token.entity,
  .farm-theme .token.url,
  .farm-theme .token.variable {
    color: #e9e1d3;
  }

  .farm-theme .token.keyword,
  .farm-theme .token.atrule,
  .farm-theme .token.attr-value {
    color: #d9a441;
    font-weight: 600;
  }

  .farm-theme .token.function,
  .farm-theme .token.class-name {
    color: #d3a6e0;
  }

  .farm-theme .token.regex,
  .farm-theme .token.important {
    color: #e0975a;
  }

  .farm-theme .token.number {
    color: #8fc7d8;
  }

  .farm-theme .token.important,
  .farm-theme .token.bold {
    font-weight: bold;
  }

  .farm-theme .token.italic {
    font-style: italic;
  }
</style>

<!-- Load Prism.js for syntax highlighting -->
<script>
  const qfWindow = window as Window & { Prism?: any; __qfPrismLoading?: boolean };

  /**
   * Teach Prism's stock SQL grammar the DuckDB statement keywords it doesn't
   * ship: it was written for MySQL/T-SQL, so `INSTALL x FROM community;`
   * highlighted FROM but left INSTALL as plain text.
   *
   * Inserted as its own token *before* `keyword` so it wins the match, and
   * aliased to `keyword` so it inherits the farmTheme gold with no extra CSS.
   *
   * Every CodeBlock on the page emits this same inline script, so it has to be
   * idempotent — but the guard cannot be a flag stored on the grammar. Prism
   * walks a grammar's own keys and treats each value as a token pattern, so a
   * stray `foo = true` makes tokenize() throw `e.exec is not a function`.
   * Testing for the inserted token is both the guard and real grammar state.
   */
  function patchDuckDBSqlGrammar() {
    const Prism = qfWindow.Prism;
    if (!Prism || !Prism.languages || !Prism.languages.sql) return;
    if (Prism.languages.sql['duckdb-keyword']) return;
    Prism.languages.insertBefore('sql', 'keyword', {
      'duckdb-keyword': {
        pattern: /\b(?:ATTACH|COPY|DETACH|EXPORT|INSTALL|MACRO|PRAGMA|QUALIFY|SUMMARIZE|UNNEST)\b/i,
        alias: 'keyword',
      },
    });
  }

  /**
   * Cedar (the AWS-authored policy language row-column-security.astro's
   * example uses) has no Prism component of its own — cdnjs 404s on
   * prism-cedar.min.js, harmlessly, via the onerror path below. Without a
   * grammar at all, `lang="cedar"` would just render as unstyled text, so
   * this defines one directly rather than leaving it unhighlighted.
   *
   * Not exhaustive Cedar syntax — just enough of it (permit/forbid,
   * principal/action/resource/context, `Namespace::Type::"id"` entity refs,
   * strings, comparisons) to read correctly on the policy examples this site
   * actually shows.
   */
  function defineCedarGrammar() {
    const Prism = qfWindow.Prism;
    if (!Prism || !Prism.languages) return;
    if (Prism.languages.cedar) return;
    Prism.languages.cedar = {
      'comment': { pattern: /\/\/.*/, greedy: true },
      'string': { pattern: /"(?:[^"\\]|\\.)*"/, greedy: true },
      'keyword': /\b(?:permit|forbid|when|unless|if|then|else|in|has|like|is)\b/,
      'boolean': /\b(?:true|false)\b/,
      'variable': /\b(?:principal|action|resource|context)\b/,
      'class-name': /\b[A-Z]\w*(?=::)/,
      'punctuation': /::|[(){}\[\];,.]/,
      'operator': /==|!=|<=|>=|&&|\|\||[<>!+\-*]/,
    };
  }

  function highlightWithDuckDBSql() {
    const Prism = qfWindow.Prism;
    if (!Prism) return;
    patchDuckDBSqlGrammar();
    defineCedarGrammar();
    Prism.highlightAll();
  }

  /**
   * Which Prism components this page actually needs, read off the blocks that
   * are on it. A fixed list meant every page paid for every language, and
   * adding one (c, go, rust, java, typescript for the /vgi/architecture
   * comparison) taxed pages that show nothing but SQL. Names Prism ships in its
   * core bundle (clike, javascript, markup, css) resolve to a 404 here and are
   * skipped by the onerror path, which is harmless.
   */
  function neededPrismLanguages() {
    const langs = new Set<string>();
    document.querySelectorAll('pre[class*="language-"]').forEach(function(pre) {
      const match = /language-([\w+#-]+)/.exec(pre.className);
      if (match) langs.add(match[1]);
    });
    return Array.from(langs);
  }

  // Load Prism.js from CDN if not already loaded. Every CodeBlock emits this
  // same inline script, so the in-flight flag keeps N blocks from queuing N
  // copies of the loader before the first one has finished.
  if (!qfWindow.Prism && !qfWindow.__qfPrismLoading) {
    qfWindow.__qfPrismLoading = true;
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js';
    script.onload = function() {
      // Resolved in onload, not at parse time: this script runs while the page
      // is still streaming, so earlier blocks would only see part of the DOM.
      const languages = neededPrismLanguages();
      if (languages.length === 0) {
        highlightWithDuckDBSql();
        return;
      }
      let loaded = 0;

      languages.forEach(function(lang) {
        const langScript = document.createElement('script');
        langScript.src = `https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-${lang}.min.js`;
        langScript.onload = function() {
          loaded += 1;
          if (loaded === languages.length) {
            highlightWithDuckDBSql();
          }
        };
        langScript.onerror = function() {
          loaded += 1;
          if (loaded === languages.length) {
            highlightWithDuckDBSql();
          }
        };
        document.head.appendChild(langScript);
      });
    };
    document.head.appendChild(script);
  } else if (qfWindow.Prism) {
    // Prism already loaded, just highlight
    highlightWithDuckDBSql();
  }
</script>

<script>
  // Copy functionality
  (function() {
    function setupCopyButtons(root?: ParentNode) {
      const scope = root && root.querySelectorAll ? root : document;
      const copyButtons = scope.querySelectorAll<HTMLButtonElement>('.copy-button');

      copyButtons.forEach(button => {
        if (button.dataset.copySetup === 'true') return;
        button.dataset.copySetup = 'true';

        button.addEventListener('click', async function(this: HTMLButtonElement) {
          const codeId = this.getAttribute('data-code-id');
          const codeBlock = document.getElementById(codeId);

          if (codeBlock) {
            const code = codeBlock.textContent || '';

            try {
              await navigator.clipboard.writeText(code);

              // Show "Copied!" feedback
              const copyText = this.querySelector('.copy-text');
              const copiedText = this.querySelector('.copied-text');

              if (copyText && copiedText) {
                copyText.classList.add('hidden');
                copiedText.classList.remove('hidden');

                // Reset after 2 seconds
                setTimeout(() => {
                  copyText.classList.remove('hidden');
                  copiedText.classList.add('hidden');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy code:', err);
            }
          }
        });
      });
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => setupCopyButtons(document));
    } else {
      setupCopyButtons(document);
    }

    document.addEventListener('qf:content-loaded', event => {
      const root = (event as CustomEvent<{ root?: ParentNode }>).detail?.root;
      setupCopyButtons(root);
    });
  })();
</script>
