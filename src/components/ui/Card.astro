---
/**
 * Card — the `.card` surface: hairline soil-300 rule, 12px radius, warm paper
 * fill. `featured` adds the gold edge; `outlined` is the transparent variant
 * that sits directly on a coloured ground.
 */
interface Props {
  variant?: 'default' | 'featured' | 'outlined';
  padding?: 'sm' | 'md' | 'lg' | 'none';
  href?: string;
  class?: string;
  id?: string;
}

const {
  variant = 'default',
  padding = 'md',
  href,
  class: className = '',
  id
} = Astro.props;

const variantClasses = {
  default: 'card',
  featured:
    'rounded-xl border border-sun-400 bg-sun-200/25 shadow-sm hover:shadow-md transition-shadow duration-200',
  outlined:
    'rounded-xl border border-soil-300 bg-transparent hover:border-sun-400 transition-colors duration-200'
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};

const classes = `${variantClasses[variant] ?? variantClasses.default} ${paddingClasses[padding]} ${className}`;

const Tag = href ? 'a' : 'div';
const linkProps = href ? { href } : {};
const idProp = id ? { id } : {};
---

<Tag class={classes} {...linkProps} {...idProp}>
  <slot />
</Tag>
