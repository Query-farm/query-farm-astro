---
interface Props {
  variant?: 'default' | 'featured' | 'outlined';
  padding?: 'sm' | 'md' | 'lg' | 'none';
  href?: string;
  class?: string;
  id?: string;
}

const {
  variant = 'default',
  padding = 'md',
  href,
  class: className = '',
  id
} = Astro.props;

const variantClasses = {
  default: 'card',
  featured: 'bg-earth-50 border-2 border-earth-300 shadow-lg hover:shadow-xl rounded-xl transition-shadow duration-200',
  outlined: 'bg-transparent border-2 border-soil-300 hover:border-earth-400 rounded-xl transition-colors duration-200'
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};

const classes = `${variantClasses[variant]} ${paddingClasses[padding]} ${className}`;

const Tag = href ? 'a' : 'div';
const linkProps = href ? { href } : {};
const idProp = id ? { id } : {};
---

<Tag class={classes} {...linkProps} {...idProp}>
  <slot />
</Tag>
