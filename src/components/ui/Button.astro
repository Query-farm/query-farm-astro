---
/**
 * Button — the `.btn` family from the Strata Sun system.
 *
 *   primary   field-700 fill  (the CTA — 5.1:1 on paper)
 *   accent    sun-700 fill    (the only gold that may carry text on light)
 *   secondary outlined, ink border
 *   ghost     outlined, soft border
 *
 * `onDark` re-cuts every variant for a dark ground (pipe-4/5/6, rock-*, the
 * single dark slab): borders go to translucent white, text to cream, and the
 * accent fill flips to sun-400 with ink text — sun-700 on brown is unreadable.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  /** Render for placement on a dark ground. */
  onDark?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  type = 'button',
  onDark = false,
  class: className = ''
} = Astro.props;

const lightVariants = {
  // Hover DARKENS. Lightening the fill drops the white label toward 4.8:1 and,
  // for text links, every lighter green fails outright on the cat-gold chip.
  // field-800 keeps the label at 9.1:1.
  primary:
    'bg-field-700 border-field-700 text-white hover:bg-field-800 hover:border-field-800',
  accent:
    'bg-sun-700 border-sun-700 text-white hover:bg-sun-800 hover:border-sun-800',
  secondary:
    'bg-white/70 border-soil-900 text-soil-900 hover:bg-white',
  ghost:
    'bg-transparent border-soil-300 text-soil-700 hover:border-soil-900 hover:text-soil-900'
};

const darkVariants = {
  // On dark the fill LIGHTENS on hover (moving away from the ground), so the
  // label has to flip to ink — white on field-400 measures 3.19:1 and fails.
  // Same pattern the accent variant already uses with sun-400.
  primary:
    'bg-field-600 border-field-600 text-white hover:bg-field-400 hover:border-field-400 hover:text-rock-900',
  accent:
    'bg-sun-400 border-sun-400 text-rock-900 hover:bg-sun-300 hover:border-sun-300',
  secondary:
    'bg-white/10 border-white/30 text-cream hover:bg-white/20',
  ghost:
    'bg-transparent border-white/25 text-cream hover:bg-white/10 hover:border-white/45'
};

const sizeClasses = {
  sm: 'gap-1.5 px-[15px] py-[7px] text-[12.5px]',
  md: 'gap-2 px-[22px] py-[11px] text-[14px]',
  lg: 'gap-2 px-7 py-[14px] text-base'
};

const focusClasses = onDark
  ? 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-400'
  : 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link';

const baseClasses =
  'inline-flex items-center justify-center whitespace-nowrap rounded-lg border font-medium leading-tight transition-colors duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = (onDark ? darkVariants : lightVariants)[variant] ?? lightVariants.primary;

const classes = `${baseClasses} ${variantClasses} ${sizeClasses[size] ?? sizeClasses.md} ${focusClasses} ${className}`;

const Tag = href ? 'a' : 'button';
const linkProps = href ? {
  href,
  ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})
} : { type };
---

<Tag class={classes} {...linkProps}>
  <slot />
</Tag>
