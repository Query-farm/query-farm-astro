---
interface Props {
  targetId: string;
  class?: string;
}

const { targetId, class: className = '' } = Astro.props;
---

<button
  class:list={[
    "share-link-btn flex-shrink-0 p-2 text-soil-400 hover:text-harvest-700 hover:bg-soil-50 rounded-lg transition-colors",
    className
  ]}
  data-target-id={targetId}
  aria-label="Copy link"
  title="Copy link"
>
  <svg class="w-5 h-5 link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
  </svg>
  <svg class="w-5 h-5 check-icon hidden text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
</button>

<script is:inline>
  // Setup share link buttons - runs once globally
  (function() {
    function setupShareLinkButtons() {
      document.querySelectorAll('.share-link-btn').forEach(button => {
        // Skip if already setup
        if (button.dataset.setupComplete) return;
        button.dataset.setupComplete = 'true';

        button.addEventListener('click', async () => {
          const targetId = button.dataset.targetId;
          if (!targetId) return;

          // Build the full URL with the anchor
          const url = `${window.location.origin}${window.location.pathname}#${targetId}`;

          try {
            await navigator.clipboard.writeText(url);

            // Show check icon
            const linkIcon = button.querySelector('.link-icon');
            const checkIcon = button.querySelector('.check-icon');
            if (linkIcon && checkIcon) {
              linkIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');

              setTimeout(() => {
                linkIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
              }, 2000);
            }
          } catch (err) {
            console.error('Failed to copy link:', err);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupShareLinkButtons);
    } else {
      setupShareLinkButtons();
    }
  })();
</script>
