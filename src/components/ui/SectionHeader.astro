---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  class: className = ''
} = Astro.props;

const alignClasses = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`space-y-4 ${alignClasses} ${className}`}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-wider text-harvest-600">
      {eyebrow}
    </p>
  )}
  <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-soil-900">
    {title}
  </h2>
  {description && (
    <p class="text-lg md:text-xl text-soil-600 max-w-3xl" class:list={[align === 'center' && 'mx-auto']}>
      {description}
    </p>
  )}
</div>
