---
/**
 * SectionHeader — eyebrow / heading / lede. The eyebrow is the sentence-case
 * `qf-eyebrow` in sun-700; the heading takes its display size from the global
 * h2 rule, so it must not be re-weighted here.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  class: className = ''
} = Astro.props;

const alignClasses = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`space-y-4 ${alignClasses} ${className}`}>
  {eyebrow && (
    <p class="qf-eyebrow text-sun-700">
      {eyebrow}
    </p>
  )}
  <h2 class="text-[clamp(1.55rem,3.4vw,2.5rem)] text-soil-900">
    {title}
  </h2>
  {description && (
    <p class="text-lg text-soil-700 max-w-3xl" class:list={[align === 'center' && 'mx-auto']}>
      {description}
    </p>
  )}
</div>
