---
/**
 * Badge — the `.badge` shape from the Strata Sun system: pill, hairline
 * border, sentence-case Commissioner. Mono is for code only, so weight and
 * colour carry the label rather than uppercase + tracking. Gold badges use
 * sun-700 for the text (the only gold that carries text on a light ground);
 * the wash behind it stays very light.
 */
interface Props {
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'info';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = ''
} = Astro.props;

const variantClasses = {
  default: 'border-soil-300 bg-soil-100/70 text-soil-700',
  primary: 'border-field-600/45 bg-field-600/10 text-field-700',
  success: 'border-field-600/45 bg-field-600/10 text-field-700',
  warning: 'border-sun-400 bg-sun-400/12 text-sun-700',
  info:    'border-sun-400/60 bg-sun-400/10 text-sun-700'
};

const sizeClasses = {
  sm: 'px-2.5 py-0.5 text-[12.5px]',
  md: 'px-3 py-1 text-[13.5px]'
};

const baseClasses =
  'inline-flex items-center rounded-full border font-medium leading-normal';

const classes = `${baseClasses} ${variantClasses[variant] ?? variantClasses.default} ${sizeClasses[size] ?? sizeClasses.sm} ${className}`;
---

<span class={classes}>
  <slot />
</span>
