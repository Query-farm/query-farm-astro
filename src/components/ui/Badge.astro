---
interface Props {
  variant?: 'default' | 'success' | 'warning' | 'info';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = ''
} = Astro.props;

const variantClasses = {
  default: 'bg-soil-200 text-soil-800 border-soil-300',
  success: 'bg-green-100 text-green-800 border-green-300',
  warning: 'bg-harvest-100 text-harvest-800 border-harvest-300',
  info: 'bg-duck-100 text-duck-800 border-duck-300'
};

const sizeClasses = {
  sm: 'px-2 py-1 text-xs',
  md: 'px-3 py-1.5 text-sm'
};

const baseClasses = 'inline-flex items-center font-medium rounded-md border';
const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
