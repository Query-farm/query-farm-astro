---
/**
 * PageHead — the header block every non-home page opens with (`.pagehead`).
 *
 *   eyebrow / h1 / lede   with an optional mark at the left and an optional
 *                         aside (a figure, a badge cluster) pulled to the right.
 *
 * No breadcrumb trail. Every section that had one also has a sticky subnav bar
 * naming the section and the current page, so the trail only said it twice.
 * Pages still emit BreadcrumbList structured data where they set it up, which is
 * what search results actually read.
 *
 * Beneath it, optionally, the hairband: the 5px six-colour strip that is one
 * of the only two ways a non-home page may touch the stage palette
 * (DESIGN_BRIEF.md §5). Pass `hairband` for the default strip, or fill the
 * `hairband` slot to put something else in that position.
 *
 * ── Variants ──────────────────────────────────────────────────────────────
 *   variant="default"  Editorial / company pages (brief families E, F).
 *                      1024px measure, `pt-11 pb-9`, clamped display h1.
 *   variant="section"  Product / docs / catalog pages (families B, C, D).
 *                      1200px measure (1360 with `wide`), `py-11`, stepped
 *                      `text-4xl md:text-5xl` h1, relaxed lede leading.
 *
 * Anything a variant can't express is overridable one class-string at a time
 * — `container`, `titleClass`, `ledeClass`, `asideClass` — so a page never has
 * to fall back to hand-rolling the whole block.
 *
 * ── Slots ─────────────────────────────────────────────────────────────────
 *   title     — rich h1 content (a figure span, an inline mark). Replaces the
 *               `title` prop's text. Use it when the headline carries markup
 *               that must not be set in Fraunces (brief §2).
 *   lede      — rich lede content (links, <code>). Replaces the `lede` prop.
 *   icon      — replaces the default 56px mark tile entirely (emoji, inline
 *               SVG). Use the `icon` prop for the common <img> case.
 *   badges    — rendered bare between the h1 and the lede; supply your own
 *               wrapper so the row's spacing stays with the page.
 *   aside     — right-hand column of the header row (stat, badges, buttons)
 *   default   — rendered bare inside the text column, beneath the lede
 *               (a button row, a copyline). Supply your own top margin.
 *   hairband  — replaces the default strip beneath the header
 */
interface Props {
  /** Plain-text headline. Omit only when filling the `title` slot instead. */
  title?: string;
  /** Mono eyebrow above the title — use for a section label. */
  eyebrow?: string;
  lede?: string;
  /** Square product mark shown to the left of the title. */
  icon?: {
    src: string;
    alt?: string;
    /** Intrinsic size written to the img attributes. Defaults to 32. */
    width?: number;
    height?: number;
    /** Extra classes on the 56px tile (e.g. `overflow-hidden`). */
    class?: string;
    /** Replaces the img's own classes. Defaults to `h-8 w-8 object-contain`. */
    imgClass?: string;
  };
  /** Render the six-colour strip beneath the header. */
  hairband?: boolean;
  /** Constrain to the wide container instead of the default one. */
  wide?: boolean;
  /** Which page family this header belongs to. See the note above. */
  variant?: 'default' | 'section';
  /** Full override for the container class, when neither measure fits. */
  container?: string;
  /** Full override for the h1 class. */
  titleClass?: string;
  /** Full override for the lede paragraph class (measure, leading). */
  ledeClass?: string;
  /** Full override for the wrapper around the `aside` slot. */
  asideClass?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  lede,
  icon,
  hairband = false,
  wide = false,
  variant = 'default',
  container,
  titleClass,
  ledeClass,
  asideClass,
  class: className = ''
} = Astro.props;

const section = variant === 'section';

const hasTitleSlot = Astro.slots.has('title');
const hasLedeSlot = Astro.slots.has('lede');
const hasIconSlot = Astro.slots.has('icon');
const hasBadges = Astro.slots.has('badges');
const hasAside = Astro.slots.has('aside');
const hasBody = Astro.slots.has('default');
const hasHairbandSlot = Astro.slots.has('hairband');
const showHairband = hairband || hasHairbandSlot;

const containerClass =
  container ??
  (section
    ? wide
      ? 'mx-auto w-full max-w-[1360px] px-6 sm:px-7'
      : 'mx-auto w-full max-w-[1200px] px-6 sm:px-7'
    : wide
      ? 'mx-auto w-full max-w-[1360px] px-4 sm:px-6 lg:px-8'
      : 'section-container');

const padY = section ? 'py-11' : 'pt-11 pb-9';

/* In `section` the row carries the offset from the crumb line, because the
   eyebrow is the column's first line; in `default` the h1 carries it. */
const rowClass = section
  ? 'mt-3 flex flex-wrap items-start gap-5'
  : 'flex flex-wrap items-start gap-x-5 gap-y-4';

const h1Class =
  titleClass ??
  (section
    ? 'mt-3 text-4xl md:text-5xl text-soil-900'
    : 'mt-3 text-[clamp(2rem,4.4vw,3.25rem)] text-soil-900');

const ledePClass =
  ledeClass ??
  (section
    ? 'mt-3.5 max-w-[58ch] text-[17.5px] leading-relaxed text-soil-700'
    : 'mt-3.5 max-w-[58ch] text-[17.5px] text-soil-700');

const asideWrapClass =
  asideClass ?? (section ? 'ml-auto hidden text-right lg:block' : 'ml-auto shrink-0 sm:text-right');
---

<header
  class:list={[
    'border-b border-soil-300 bg-gradient-to-b from-[#faf7ef] to-soil-50',
    padY,
    className
  ]}
>
  <div class={containerClass}>
    <div class={rowClass}>
      {hasIconSlot ? (
        <slot name="icon" />
      ) : icon && (
        <span
          class:list={[
            section ? '' : 'mt-3',
            'flex h-14 w-14 flex-none items-center justify-center rounded-xl border border-soil-300 bg-soil-100',
            icon.class ?? ''
          ]}
        >
          <img
            src={icon.src}
            alt={icon.alt ?? ''}
            width={icon.width ?? 32}
            height={icon.height ?? 32}
            class={icon.imgClass ?? 'h-8 w-8 object-contain'}
          />
        </span>
      )}

      <div class="min-w-0 flex-1">
        {eyebrow && <span class="qf-eyebrow text-sun-700">{eyebrow}</span>}

        <h1 class={h1Class}>{hasTitleSlot ? <slot name="title" /> : title}</h1>

        {hasBadges && <slot name="badges" />}

        {(hasLedeSlot || lede) && (
          <p class={ledePClass}>{hasLedeSlot ? <slot name="lede" /> : lede}</p>
        )}

        {hasBody && <slot />}
      </div>

      {hasAside && (
        <div class={asideWrapClass}>
          <slot name="aside" />
        </div>
      )}
    </div>
  </div>
</header>

{showHairband && (
  hasHairbandSlot ? (
    <slot name="hairband" />
  ) : (
    <div class="hairband" aria-hidden="true">
      <i class="block bg-pipe-1"></i>
      <i class="block bg-pipe-2"></i>
      <i class="block bg-pipe-3"></i>
      <i class="block bg-pipe-4"></i>
      <i class="block bg-pipe-5"></i>
      <i class="block bg-pipe-6"></i>
    </div>
  )
)}
