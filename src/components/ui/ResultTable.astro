---
/**
 * A query result rendered as a real table on the terminal slab.
 *
 * The alternative — and what the VGI guide pages used to do — is to paste the
 * shell's own box-drawing output into a code block. It looks right in a
 * terminal and wrong on a page: the `│ ├ ┼ ┘` glyphs are drawn to butt against
 * each other at line-height 1, so at the web font's line-height every vertical
 * rule breaks into dashes and the table reads as damaged. Real `<tr>`s also
 * wrap, scroll and reflow on a phone, which a fixed-width ASCII block cannot.
 *
 * This mirrors the sample-output table in the homepage's 10-second tour
 * (pages/vgi/index.astro) — same rock-900 ground, same hairline rules, same
 * treatment of figures — so a result looks the same wherever a reader meets one.
 *
 * `numericCols` gets `.qf-figure`: tabular Noto Sans, never the display face,
 * whose figures are not tabular (DESIGN_BRIEF §2). That is what makes a column of
 * magnitudes or delays line up on the decimal instead of drifting.
 */
interface Props {
  /** Column headers, in order. */
  columns: string[];
  /** Row cells, in the same order as `columns`. */
  rows: (string | number)[][];
  /** Indices of columns holding figures — right-aligned and set in tabular. */
  numericCols?: number[];
  /** Caption above the table. */
  title?: string;
  /**
   * `dark` (default): the terminal slab, for a result shown on its own.
   * `paper`: warm beige (soil-100), for a result sitting directly under the query that produced it,
   * so the dark panel is always the code and the light one always its answer.
   */
  tone?: 'dark' | 'paper';
}

const { columns, rows, numericCols = [], title = 'result', tone = 'dark' } = Astro.props;
const isNum = (i: number) => numericCols.includes(i);
const paper = tone === 'paper';
const c = paper
  ? {
      box: 'border-soil-300 bg-soil-100',
      head: 'border-soil-300/70 text-soil-600',
      rule: 'border-soil-300/70',
      th: 'text-soil-600',
      row: 'border-soil-200',
      num: 'text-sun-700',
      cell: 'text-soil-900',
    }
  : {
      box: 'border-rock-800 bg-rock-900',
      head: 'border-white/10 text-cream-2',
      rule: 'border-white/10',
      th: 'text-cream-2',
      row: 'border-white/5',
      num: 'text-sun-400',
      cell: 'text-[#e9e1d3]',
    };
---

<div class={`mt-4 overflow-hidden rounded-xl border ${c.box}`}>
  <div class={`border-b px-4 py-2.5 text-[12.5px] font-medium ${c.head}`}>{title}</div>
  <div class="overflow-x-auto">
    <table class="w-full font-mono text-[12.5px]">
      <thead>
        <tr class={`border-b ${c.rule}`}>
          {
            columns.map((col, i) => (
              <th
                class:list={[
                  `whitespace-nowrap px-4 py-2 font-medium ${c.th}`,
                  isNum(i) ? 'text-right' : 'text-left',
                ]}
              >
                {col}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class={`border-t first:border-t-0 ${c.row}`}>
              {row.map((cell, ci) => (
                <td
                  class:list={[
                    'px-4 py-1.5',
                    isNum(ci)
                      ? `qf-figure whitespace-nowrap text-right ${c.num}`
                      : c.cell,
                  ]}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
