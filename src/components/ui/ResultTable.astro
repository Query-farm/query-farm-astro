---
/**
 * A query result rendered as a real table on the terminal slab.
 *
 * The alternative — and what the VGI guide pages used to do — is to paste the
 * shell's own box-drawing output into a code block. It looks right in a
 * terminal and wrong on a page: the `│ ├ ┼ ┘` glyphs are drawn to butt against
 * each other at line-height 1, so at the web font's line-height every vertical
 * rule breaks into dashes and the table reads as damaged. Real `<tr>`s also
 * wrap, scroll and reflow on a phone, which a fixed-width ASCII block cannot.
 *
 * This mirrors the sample-output table in the homepage's 10-second tour
 * (pages/vgi/index.astro) — same rock-900 ground, same hairline rules, same
 * treatment of figures — so a result looks the same wherever a reader meets one.
 *
 * `numericCols` gets `.qf-figure`: tabular Commissioner, never Fraunces, which
 * ships no tabular set (DESIGN_BRIEF §3). That is what makes a column of
 * magnitudes or delays line up on the decimal instead of drifting.
 */
interface Props {
  /** Column headers, in order. */
  columns: string[];
  /** Row cells, in the same order as `columns`. */
  rows: (string | number)[][];
  /** Indices of columns holding figures — right-aligned and set in tabular. */
  numericCols?: number[];
  /** Caption above the table. */
  title?: string;
}

const { columns, rows, numericCols = [], title = 'result' } = Astro.props;
const isNum = (i: number) => numericCols.includes(i);
---

<div class="mt-4 overflow-hidden rounded-xl border border-rock-800 bg-rock-900">
  <div class="border-b border-white/10 px-4 py-2.5 text-[12.5px] font-medium text-cream-2">{title}</div>
  <div class="overflow-x-auto">
    <table class="w-full font-mono text-[12.5px]">
      <thead>
        <tr class="border-b border-white/10">
          {
            columns.map((col, i) => (
              <th
                class:list={[
                  'whitespace-nowrap px-4 py-2 font-medium text-cream-2',
                  isNum(i) ? 'text-right' : 'text-left',
                ]}
              >
                {col}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-t border-white/5 first:border-t-0">
              {row.map((cell, ci) => (
                <td
                  class:list={[
                    'px-4 py-1.5',
                    isNum(ci)
                      ? 'qf-figure whitespace-nowrap text-right text-sun-400'
                      : 'text-[#e9e1d3]',
                  ]}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
