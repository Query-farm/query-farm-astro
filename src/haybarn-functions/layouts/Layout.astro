---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HaybarnSubNav from '../../components/sections/HaybarnSubNav.astro';
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import { defaultSnapshot, categories, getFunctions, getFunction, catalogUrl, categoryUrl, functionUrl, type Snapshot } from '../lib/catalog';
import { functionJsonUrl, functionMarkdownUrl, indexJsonUrl, indexMarkdownUrl } from '../lib/agent-docs';
interface Props { title: string; description?: string; active?: string; snapshot?: Snapshot; functionName?: string; wide?: boolean; }
const { title, description = 'Find SQL functions, understand their arguments, and run examples with Haybarn.', active = '', snapshot = defaultSnapshot, functionName, wide = false } = Astro.props;
const docs = getFunctions(snapshot);
const fn = functionName ? getFunction(snapshot, functionName) : undefined;
const markdownUrl = fn ? functionMarkdownUrl(snapshot, fn) : active === 'catalog' ? indexMarkdownUrl(snapshot) : active === 'agents' ? '/products/haybarn/functions/agents/index.md' : undefined;
const jsonUrl = fn ? functionJsonUrl(snapshot, fn) : active === 'catalog' ? indexJsonUrl(snapshot) : undefined;
const pageTitle = `${title}${fn ? ` · ${snapshot.label}` : ''}`;
const canonicalPath = fn ? functionUrl(snapshot, fn) : active === 'catalog' ? catalogUrl(snapshot) : undefined;
---
<BaseLayout title={pageTitle} description={description.replace(/`([^`]+)`/g, '$1').replace(/\s+/g, ' ').trim()} ogImage="/products/haybarn/functions/social.png" {canonicalPath} mainClass="haybarn-guide" mainSearchKind={active === 'home' ? 'page' : 'haybarn-guide'}>
  <Fragment slot="head">
    <link rel="describedby" href="/products/haybarn/functions/llms.txt" type="text/plain" />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    {jsonUrl && <link rel="alternate" type="application/json" href={jsonUrl} />}
  </Fragment>
  <HaybarnSubNav slot="subnav" functionGuide />
    <div class="site-grid" data-haybarn-guide>
      <aside class="sidebar" id="sidebar">
        <a class="sidebar-search" href={catalogUrl(snapshot)} data-search-open aria-haspopup="dialog" aria-controls="haybarn-search" aria-expanded="false"><span aria-hidden="true">⌕</span> Search functions <kbd>/</kbd></a>
        <nav aria-label="Guide navigation">
          <a href="/products/haybarn/functions/" class:list={['nav-link', { active: active === 'home' }]}><span aria-hidden="true">⌂</span> Overview</a>
          <a href={catalogUrl(snapshot)} class:list={['nav-link', { active: active === 'catalog' }]}><span aria-hidden="true">ƒ</span> All functions <span class="nav-count">{docs.length}</span></a>
          <p class="nav-heading">Explore by category</p>
          {categories.map(category => <a class="nav-link category-nav" href={categoryUrl(category.id, snapshot)}><span class={`nav-symbol ${category.color}`}>{category.icon}</span>{category.name}<span class="nav-count">{docs.filter(f => f.category === category.id).length}</span></a>)}
          <p class="nav-heading">Put it to work</p>
          <a href="/products/haybarn/recipes/" class:list={['nav-link', { active: active === 'recipes' }]}><span aria-hidden="true">▧</span> SQL recipes <span class="small-tag">Try it</span></a>
          <a href="/products/haybarn/playground/" class:list={['nav-link', { active: active === 'playground' }]}><span aria-hidden="true">▷</span> Playground</a>
          <a href="/products/haybarn/function-changes/" class:list={['nav-link', { active: active === 'releases' }]}><span aria-hidden="true">◴</span> Function changes</a>
          <a href="/products/haybarn/functions/agents/" class:list={['nav-link', { active: active === 'agents' }]}><span aria-hidden="true">⌘</span> For agents <span class="small-tag">API</span></a>
        </nav>
      </aside>
      <div class="page-area">
        <div id="guide-content" class:list={['main-content', { wide }]} tabindex="-1" data-pagefind-body={!fn && active !== 'catalog' ? true : undefined} data-haybarn-search-page={!fn && active !== 'catalog' ? true : undefined} data-pagefind-filter="kind:Guide" data-pagefind-meta={`title:${title}`}><span hidden data-pagefind-filter="snapshot:guide"></span><span hidden data-pagefind-filter="scope:haybarn"></span><slot /></div>
      </div>
    </div>
    <SiteSearch snapshot={snapshot} />
</BaseLayout>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.haybarn-nav-toggle');
  const closeNavigation = () => { document.body.classList.remove('haybarn-nav-open'); toggle?.setAttribute('aria-expanded', 'false'); };
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(expanded));
    document.body.classList.toggle('haybarn-nav-open', expanded);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !document.querySelector('dialog[open]')) closeNavigation();
  });
  document.querySelector('#mobile-menu-button')?.addEventListener('click', closeNavigation);
  const header = document.querySelector('header[data-pagefind-ignore]');
  const subnav = document.querySelector('[data-haybarn-subnav]');
  const measure = () => document.documentElement.style.setProperty('--haybarn-sticky-height', `${(header?.getBoundingClientRect().height ?? 58) + (subnav?.getBoundingClientRect().height ?? 52)}px`);
  const observer = new ResizeObserver(measure);
  if (header) observer.observe(header);
  if (subnav) observer.observe(subnav);
  measure();
</script>
