---
import { snapshots, getFunction, functionUrl } from '../lib/catalog';

interface Props { name: string; }
const { name } = Astro.props;
const seen = new Set<string>();
// Snapshots are newest first within each engine. Link to a captured build
// where the function exists, with one badge per major.minor release line.
const releases = snapshots.flatMap(snapshot => {
  const fn = getFunction(snapshot, name);
  if (!fn) return [];
  const version = snapshot.engineVersion.match(/^v?(\d+\.\d+)/)?.[1] ?? snapshot.engineVersion;
  const key = `${snapshot.engine}-${version}`;
  if (seen.has(key)) return [];
  seen.add(key);
  return [{ snapshot, fn, version }];
});
---
<div class="release-badges" id="availability" aria-label="Supported releases">
  <span class="release-badges-label">Available in</span>
  {releases.map(({ snapshot, fn, version }) => (
    <a class:list={['release-badge', { 'release-badge-haybarn': snapshot.engine === 'haybarn' }]}
      href={functionUrl(snapshot, fn)} title={`Observed in ${snapshot.label}`}>
      {snapshot.engine === 'haybarn' ? 'Haybarn' : 'DuckDB'} <span>{version}</span>
    </a>
  ))}
</div>
