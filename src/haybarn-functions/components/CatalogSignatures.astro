---
import type { FunctionDoc, Snapshot } from '../lib/catalog';
import { orderedOverloads } from '../lib/reference';
import { signatureParts } from '../lib/arguments';
import { isOperatorName, operatorNotation, referenceName } from '../../../scripts/haybarn-functions/notation.mjs';

interface Props { fn: FunctionDoc; snapshot: Snapshot; }
const { fn, snapshot } = Astro.props;
const forms = new Map<string, { notation: string | null; parts: string[] }>();
for (const row of orderedOverloads(fn)) {
  const notation = isOperatorName(fn.name) ? operatorNotation(row)?.expression ?? referenceName(fn.name) : null;
  const parts = signatureParts(row, snapshot, false, true);
  const key = notation ?? `${fn.name}(${parts.join(', ')})`;
  if (!forms.has(key)) forms.set(key, { notation, parts });
}
// Let narrow screens break a long identifier at underscores, keeping its final
// segment and opening parenthesis together. No characters are added to the name.
const nameSegments = fn.name.split(/(?<=_)(?=[^_])/);
---
<div class="catalog-signatures">
  {[...forms.values()].map(({ notation, parts }) => <code class="catalog-signature">{notation ?? <Fragment>{nameSegments.map((segment, i) => <Fragment>{i > 0 && <wbr />}<span class="catalog-function-name">{segment}{i === nameSegments.length - 1 ? parts.length ? '(' : '()' : ''}</span></Fragment>)}{parts.map((part, i) => <Fragment><wbr /><span class="catalog-argument">{part}{i < parts.length - 1 ? ',' : ')'}</span>{i < parts.length - 1 ? ' ' : ''}</Fragment>)}</Fragment>}</code>)}
</div>
