---
import { translationsFor } from '../lib/translations';
import TranslationExample from './TranslationExample.astro';
interface Props { name: string; engine: 'haybarn' | 'duckdb'; }
const { name, engine } = Astro.props;
const translations = translationsFor(name);
const direct = translations.filter(row => row.relation === 'direct');
const rewrites = translations.filter(row => row.relation === 'rewrite');
---
{translations.length > 0 && <section id="other-engines" class="doc-section">
  <h2>In other engines</h2>
  {direct.map(translation => <TranslationExample {translation} {name} {engine} />)}
  {rewrites.length > 0 && <details class="translation-rewrites">
    <summary>Used in larger rewrites <span>{rewrites.length}</span></summary>
    <p>These examples use <code>{name}</code> as one part of a larger SQL translation.</p>
    {rewrites.map(translation => <TranslationExample {translation} {name} {engine} />)}
  </details>}
</section>}
<style>
  .translation-rewrites { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  summary { cursor: pointer; font-size: 17px; font-weight: 500; }
  summary span { color: var(--muted); margin-left: 8px; }
  .translation-rewrites > p { margin: 14px 0 0; color: var(--muted); font-size: 16px; }
</style>
