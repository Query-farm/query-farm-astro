---
import Playground from './Playground.astro';
import type { UsageGuide } from '../data/usage-guides';
interface Props { guide: UsageGuide; }
const { guide } = Astro.props;
---
<div class="usage-guide">
  <p>{guide.summary}</p>
  <p>{guide.behavior}</p>
  <Playground sql={guide.sql} title={guide.purpose} source="Guide example" />
  <div class="expected-result" tabindex="0" role="region" aria-label="Expected query result">
    <table><caption>Expected result</caption><thead><tr>{guide.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
      <tbody>{guide.rows.map(row => <tr>{row.map(value => <td><code>{value ?? 'NULL'}</code></td>)}</tr>)}</tbody>
    </table>
  </div>
  <p class="usage-pitfall"><strong>Watch for:</strong> {guide.pitfall}</p>
</div>
<style>
  .expected-result { overflow-x: auto; margin: 20px 0; }
  table { border-collapse: collapse; width: 100%; text-align: left; font-size: 14px; }
  caption { text-align: left; font-weight: 600; margin-bottom: 8px; }
  th, td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  th { font-weight: 600; }
  td code { white-space: pre-wrap; }
  .usage-pitfall { margin-top: 18px; }
</style>
