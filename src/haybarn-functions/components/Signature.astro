---
import { type Overload, type Snapshot, formatSignature } from '../lib/catalog';
import { signatureParts } from '../lib/arguments';
interface Props { row: Overload; snapshot: Snapshot; }
const { row, snapshot } = Astro.props;
const parts = signatureParts(row, snapshot);
const signature = parts.length > 2 ? `${row.function_name}(\n  ${parts.join(',\n  ')}\n) → ${row.return_type ?? (row.function_type.includes('table') ? 'TABLE' : 'not specified')}` : formatSignature(row, snapshot);
---
<div class="signature-box"><code>{signature}</code></div>
