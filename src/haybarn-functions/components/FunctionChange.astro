---
import { functionUrl, categoryInfo, type FunctionDoc, type Snapshot, type Overload } from '../lib/catalog';
import { runnableExamplesFor } from '../lib/examples';
import { catalogExamples } from '../lib/reference';
import { recipesFor } from '../data/recipes';
import { referenceName, isOperatorName } from '../../../scripts/haybarn-functions/notation.mjs';
import InlineDescription from './InlineDescription.astro';
import FunctionKind from './FunctionKind.astro';
import Signature from './Signature.astro';
interface Props { fn: FunctionDoc; snapshot: Snapshot; from: Snapshot; to: Snapshot; change: string; before: Overload[]; after: Overload[]; }
const { fn, snapshot, from, to, change, before, after } = Astro.props;
const kinds = isOperatorName(fn.name) ? ['operator'] : fn.kinds;
const url = functionUrl(snapshot, fn);
const exampleAnchor = runnableExamplesFor(fn.name).length ? 'examples' : catalogExamples(fn).length ? 'catalog-examples' : recipesFor(fn.name).length ? 'recipes' : null;
const search = [fn.name, fn.description, ...fn.aliases, ...[...fn.overloads, ...before, ...after].flatMap(row => [row.return_type, row.varargs, ...row.parameters, ...row.parameter_types])].join(' ').toLowerCase();
const sides = [
  { label: after.length ? 'Before' : 'Absent overloads', release: from, rows: before, direction: 'before' },
  { label: before.length ? 'After' : 'Additional overloads', release: to, rows: after, direction: 'after' },
].filter(side => side.rows.length);
---
<article class="function-change" data-function-change data-name={fn.name} data-category={fn.category} data-search={search}>
  <header><h3><a href={url}><code>{referenceName(fn.name)}</code></a></h3><div class="change-kinds">{kinds.map(kind => <FunctionKind {kind} />)}<span class="change-category">{categoryInfo(fn.category).name}</span></div></header>
  {fn.description && <p class="change-description"><InlineDescription text={fn.description} /></p>}
  {change === 'changed' && <div class:list={['diff-detail', { 'single-side': sides.length === 1 }]}>
      {sides.map(side => <section class={`change-overloads ${side.direction}`} aria-label={`${side.label}: ${side.release.label}`}>
        <h4>{side.label}<span>{side.release.label}</span></h4>
        {side.rows.map(row => <div class="change-overload"><FunctionKind kind={isOperatorName(fn.name) ? 'operator' : row.function_type} /><Signature {row} snapshot={side.release} /></div>)}
      </section>)}
    </div>}
  <div class="change-links"><a href={`${url}#signatures`}>Arguments & returns <span aria-hidden="true">↗</span></a>{exampleAnchor && <a href={`${url}#${exampleAnchor}`}>Examples <span aria-hidden="true">↗</span></a>}</div>
</article>

<style>
  .function-change { padding: 22px 0; border-top: 1px solid var(--line); }
  header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px 20px; }
  h3 { margin: 0; font-size: 21px; min-width: 0; overflow-wrap: anywhere; }
  h3 a { color: var(--green); }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .change-kinds { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .change-category { color: var(--muted); font-size: var(--text-sm); }
  .change-description { max-width: 850px; font-size: var(--text-base); line-height: 1.8; margin: 12px 0 0; }
  .change-links { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 13px; font-size: var(--text-sm); color: var(--green); }
  .change-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .diff-detail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 20px 0; }
  .single-side { grid-template-columns: minmax(0, 1fr); }
  .change-overloads { min-width: 0; }
  h4 { margin: 0 0 12px; font-size: var(--text-base); font-family: var(--sans); font-weight: 500; }
  h4 span { display: block; margin-top: 4px; color: var(--muted); font-size: var(--text-sm); font-weight: 400; }
  .change-overload { margin-top: 12px; }
  .change-overload :global(.signature-box) { margin-top: 7px; padding: 12px; overflow: visible; }
  .change-overload :global(.signature-box > code) { white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--text-sm); line-height: 1.9; }
  .before :global(.signature-box) { background: #f0e6dc; border-left-color: #b97d5b; }
  .after :global(.signature-box) { background: #eaf0e1; border-left-color: #729448; }
  @media (max-width: 1000px) { .diff-detail { grid-template-columns: minmax(0, 1fr); } }
</style>
