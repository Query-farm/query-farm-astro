---
import { documentationFor } from '../lib/upstream-docs';
import type { FunctionDoc } from '../lib/catalog';
import EngineLogo from './EngineLogo.astro';
interface Props { fn: FunctionDoc; }
const links = documentationFor(Astro.props.fn);
---
{links.length > 0 && <aside id="duckdb-docs" class="upstream-docs" aria-label="Additional DuckDB documentation">
  <div><EngineLogo dialect="duckdb" label="DuckDB" /><strong>DuckDB documentation</strong></div>
  <ul>{links.map(link => <li><a href={link.url}>{link.title}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
</aside>}
<style>
  .upstream-docs { margin-top: 30px; padding: 18px 22px; border: 1px solid var(--line); border-radius: 5px; background: var(--paper-light); }
  .upstream-docs > div { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; padding: 0; margin: 12px 0 0 42px; }
  a { font-size: 16px; color: var(--green); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 600px) { ul { margin-left: 0; } }
</style>
