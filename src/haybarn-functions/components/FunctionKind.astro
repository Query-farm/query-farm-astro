---
import FunctionKindIcon from './FunctionKindIcon.astro';
import { functionKinds } from '../data/function-kinds';
interface Props { kind: string; }
const { kind } = Astro.props;
const info = functionKinds[kind];
---
<span class={`kind-badge ${info?.color ?? ''}`} title={info?.meaning}>
  <FunctionKindIcon kind={kind} />{info?.label ?? kind}
</span>
