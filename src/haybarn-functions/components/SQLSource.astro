---
import { formatSQL } from '../lib/sql-format';
import { highlightSQL } from '../lib/sql-highlight';
interface Props { sql: string; }
const tokens = highlightSQL(formatSQL(Astro.props.sql));
---
<pre class="macro-source"><code class="language-sql">{tokens.map(token => <span class={token.kind ? `sql-${token.kind}` : undefined}>{token.text}</span>)}</code></pre>
