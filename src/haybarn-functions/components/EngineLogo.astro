---
import { engineLogos } from '../data/engines';
interface Props { dialect: string; label: string; }
const { dialect, label } = Astro.props;
const logo = engineLogos[dialect];
---
{logo ? <img class="engine-logo" src={logo} alt="" width="32" height="32" loading="lazy" /> : <span class="engine-fallback" aria-hidden="true">{label.slice(0, 2)}</span>}
<style>
  .engine-logo { width: 32px; height: 32px; object-fit: contain; flex-shrink: 0; }
  .engine-fallback { display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0; border-radius: 4px; background: var(--paper-deep); color: var(--muted); font-size: 14px; text-transform: uppercase; }
</style>
