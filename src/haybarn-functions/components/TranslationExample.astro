---
import { highlightSQL } from '../lib/sql-highlight';
import EngineLogo from './EngineLogo.astro';
import { usesSameFunction, type translationsFor } from '../lib/translations';
interface Props { translation: ReturnType<typeof translationsFor>[number]; name: string; engine: 'haybarn' | 'duckdb'; }
const { translation, name, engine } = Astro.props;
const targetLabel = engine === 'haybarn' ? 'Haybarn' : 'DuckDB';
const sameFunction = usesSameFunction(translation);
---
<div class:list={['translation', { 'translation-same': sameFunction }]}>
    <div class="translation-heading">
      <EngineLogo dialect={translation.source.dialect} label={translation.source.engine} />
      <h3>{translation.source.engine}{translation.source.name && <code>{translation.source.name}()</code>}</h3>
      {sameFunction ? <a class="translation-same-label" href={translation.provenance.url} title={`View the unchanged SQLGlot example for ${translation.source.engine} and ${targetLabel}`}>Same function</a> : translation.scope && <span class="translation-scope">{translation.scope}</span>}
    </div>
    {!sameFunction && <Fragment>
    <div class="translation-examples">
      {[{ label: translation.source.engine, dialect: translation.source.dialect, sql: translation.source.sql }, { label: targetLabel, dialect: engine, sql: translation.target.sql }].map((example, i) => <div class:list={['translation-example', { destination: i === 1 }]}>
        {i === 1 && <div class="translation-label"><EngineLogo dialect={example.dialect} label={example.label} />In {example.label}</div>}
        <pre><code>{highlightSQL(example.sql).map(token => <span class:list={[token.kind ? `sql-${token.kind}` : undefined, { 'translation-match': i === 1 && token.text.toLowerCase() === name }]}>{token.text}</span>)}</code></pre>
      </div>)}
    </div>
    <p class="translation-source"><a href={translation.provenance.url}>SQLGlot example ↗</a></p>
    </Fragment>}
  </div>
<style>
  .translation + .translation { margin-top: 28px; }
  .translation-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 16px 0; }
  .translation h3 { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; font-family: var(--sans); font-size: 19px; font-weight: 550; margin: 0; }
  .translation-scope { color: var(--muted); font-size: 16px; margin-left: auto; }
  .translation-same { border-bottom: 1px solid var(--line); }
  .translation-same-label { margin-left: auto; color: var(--green); font-size: 16px; }
  .translation-same-label:hover { text-decoration: underline; text-underline-offset: 3px; }
  .translation-examples { min-width: 0; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .translation-example { min-width: 0; background: #2b241b; }
  .translation-label { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #e2e7d7; color: var(--green-dark); font-size: 16px; font-weight: 550; }
  pre { margin: 0; padding: 18px; color: #f1e9db; font: 16px/1.75 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  pre code { font: inherit; }
  .translation-match { color: #e9c579; text-decoration: underline; text-decoration-color: #e9c57966; text-underline-offset: 4px; }
  .translation .translation-source { margin: 18px 0 0; font-size: 14px; }
  .translation-source a { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 600px) { .translation-scope { width: 100%; margin-left: 44px; } }
</style>
