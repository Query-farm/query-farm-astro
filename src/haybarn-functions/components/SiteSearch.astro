---
import { type Snapshot, catalogUrl } from '../lib/catalog';
interface Props { snapshot: Snapshot; }
const { snapshot } = Astro.props;
---
<dialog id="haybarn-search" class="search-dialog" aria-labelledby="haybarn-search-title" data-snapshot={snapshot.id}>
  <div class="search-dialog-heading"><h2 id="haybarn-search-title">Search functions</h2><button type="button" data-search-close aria-label="Close search">Esc <span aria-hidden="true">×</span></button></div>
  <div class="search-dialog-input"><span aria-hidden="true">⌕</span><label class="sr-only" for="haybarn-search-input">Search functions and examples</label><input id="haybarn-search-input" type="search" autocomplete="off" spellcheck="false" placeholder="A function, an argument, something you want to do…" /></div>
  <div class="search-options">
    <div class="search-kinds" role="group" aria-label="Search content"><button type="button" data-search-kind="" aria-pressed="true">All</button><button type="button" data-search-kind="Function" aria-pressed="false">Functions</button><button type="button" data-search-kind="Guide" aria-pressed="false">Guides</button></div>
    <label><input type="checkbox" id="search-all-releases" /> Include other releases</label>
  </div>
  <div class="search-results-scroll">
    <p id="haybarn-search-status" role="status" aria-live="polite" aria-atomic="true">Search descriptions, arguments, SQL examples, and guides.</p>
    <div id="search-suggestions"><span>Try</span>{['list_transform', 'capture groups', 'VARCHAR'].map(query => <button type="button" data-search-suggestion={query}>{query}</button>)}</div>
    <ol id="haybarn-search-results" aria-label="Search results"></ol>
    <button type="button" id="search-more" class="button secondary" hidden>Show more results</button>
    <div id="search-error" hidden><button type="button" id="search-retry" class="button secondary">Try again</button><a href={catalogUrl(snapshot)} class="text-link">Browse functions →</a></div>
  </div>
  <div class="search-dialog-footer"><span id="search-scope">{snapshot.label}</span><span><kbd>↑</kbd> <kbd>↓</kbd> Navigate · <kbd>↵</kbd> Open</span></div>
</dialog>
<script>
  import '../lib/haybarn-search';
</script>
