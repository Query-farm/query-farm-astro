style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# The VGI way: your function is a separate worker process DuckDB talks to
direction: down

client: "SQL client" {
  style.fill: "#f7f3ea"
  style.stroke: "#cfc4ad"
  style.border-radius: 10
}

engine: "DuckDB engine\nthe client" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#d8e3e8"
  style.stroke: "#2f5058"
  style.border-radius: 12
  style.shadow: true
}

worker: "worker — separate process\nyour Python code" {
  icon: ../assets/python-icon.svg
  style.fill: "#e3e6d2"
  style.stroke: "#5f7a3c"
  style.border-radius: 12
  style.shadow: true
}

client -> engine: query
engine -> worker: "VGI calls + Arrow batches" {
  style.stroke: "#5f7a3c"
  style.bold: true
}
