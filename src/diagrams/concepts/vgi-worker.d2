# The VGI way: your function is a separate worker process DuckDB talks to
direction: down

client: "SQL client" {
  style.fill: "#faf9f7"
  style.stroke: "#a89f90"
  style.border-radius: 10
}

engine: "DuckDB engine\nthe client" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#eef4fb"
  style.stroke: "#2563eb"
  style.border-radius: 12
  style.shadow: true
}

worker: "worker — separate process\nyour Python code" {
  icon: ../assets/python-icon.svg
  style.fill: "#f6f9f5"
  style.stroke: "#16a34a"
  style.border-radius: 12
  style.shadow: true
}

client -> engine: query
engine -> worker: "VGI calls + Arrow batches" {
  style.stroke: "#16a34a"
  style.bold: true
}
