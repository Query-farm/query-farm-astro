# VGI three-tier architecture: SQL client → DuckDB engine → VGI worker(s)
direction: right
style.font-size: 16

client: "SQL client\nCLI · app · BI tool" {
  style.fill: "#faf9f7"
  style.stroke: "#a89f90"
  style.border-radius: 12
  style.shadow: true
}

engine: "DuckDB engine\nthe client" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#eef4fb"
  style.stroke: "#2563eb"
  style.border-radius: 14
  style.shadow: true
  style.bold: true
}

workers: "VGI workers" {
  style.fill: "#f3f8f4"
  style.stroke: "#cfe8d4"
  style.border-radius: 16

  w1: "worker\nyour Python code" {
    icon: ../assets/python-icon.svg
    style.fill: "#ffffff"
    style.stroke: "#16a34a"
    style.border-radius: 12
    style.shadow: true
  }
  w2: "worker" {
    icon: ../assets/python-icon.svg
    style.fill: "#ffffff"
    style.stroke: "#16a34a"
    style.border-radius: 12
    style.shadow: true
  }
}

client <-> engine: "SQL  ⇄  results" {
  style.stroke: "#8a8175"
}
engine -> workers.w1: "VGI calls + Arrow batches" {
  style.stroke: "#15803d"
  style.bold: true
}
engine -> workers.w2: {
  style.stroke: "#15803d"
}
