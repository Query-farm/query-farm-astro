style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# VGI three-tier architecture: SQL client → DuckDB engine → VGI worker(s)
direction: right
style.font-size: 16

client: "SQL client\nCLI · app · BI tool" {
  style.fill: "#f7f3ea"
  style.stroke: "#cfc4ad"
  style.border-radius: 12
  style.shadow: true
}

engine: "DuckDB engine\nthe client" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#d8e3e8"
  style.stroke: "#2f5058"
  style.border-radius: 14
  style.shadow: true
  style.bold: true
}

workers: "VGI workers" {
  style.fill: "#dee8d1"
  style.stroke: "#7a9a54"
  style.border-radius: 16

  w1: "worker\nyour Python code" {
    icon: ../assets/python-icon.svg
    style.fill: "#fffdf7"
    style.stroke: "#5f7a3c"
    style.border-radius: 12
    style.shadow: true
  }
  w2: "worker" {
    icon: ../assets/python-icon.svg
    style.fill: "#fffdf7"
    style.stroke: "#5f7a3c"
    style.border-radius: 12
    style.shadow: true
  }
}

client <-> engine: "SQL  ⇄  results" {
  style.stroke: "#a9825a"
}
engine -> workers.w1: "VGI calls + Arrow batches" {
  style.stroke: "#4f6a34"
  style.bold: true
}
engine -> workers.w2: {
  style.stroke: "#4f6a34"
}
