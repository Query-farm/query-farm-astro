style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# What VGI is built on: the protocol stack, top (closest to you) to bottom (the wire)
direction: down

vgi: "VGI — the function & catalog protocol\nbind · init · process · finalize · catalogs" {
  style.fill: "#dee8d1"
  style.stroke: "#4f6a34"
}
rpc: "vgi-rpc — transport-agnostic RPC framework\nmethods, request/response, streaming"
arrow: "Apache Arrow IPC — columnar serialization"
transport: "Transport\nsubprocess · Unix socket · HTTP"

vgi -> rpc: defined as RPC methods
rpc -> arrow: serialized as
arrow -> transport: sent over
