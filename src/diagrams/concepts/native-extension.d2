# The usual way: a native extension compiled into DuckDB
direction: right

client: SQL {
  style.fill: "#f6f4f1"
  style.stroke: "#8a8175"
  style.border-radius: 8
}

engine: "DuckDB engine" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#eef4fb"
  style.stroke: "#2563eb"
  style.border-radius: 12
  style.shadow: true

  ext: "your function\n(an extension, compiled in,\nshipped per DuckDB release)" {
    style.fill: "#fde8e8"
    style.stroke: "#dc2626"
    style.border-radius: 8
  }
}

client -> engine: query
