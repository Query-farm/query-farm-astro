style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# The usual way: a native extension compiled into DuckDB
direction: right

client: SQL {
  style.fill: "#efe9db"
  style.stroke: "#a9825a"
  style.border-radius: 8
}

engine: "DuckDB engine" {
  icon: ../assets/duckdb-icon.svg
  style.fill: "#d8e3e8"
  style.stroke: "#2f5058"
  style.border-radius: 12
  style.shadow: true

  ext: "your function\n(an extension, compiled in,\nshipped per DuckDB release)" {
    style.fill: "#f2ded4"
    style.stroke: "#a8412a"
    style.border-radius: 8
  }
}

client -> engine: query
