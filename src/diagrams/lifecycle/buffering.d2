style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# Buffering lifecycle: sink (process) → combine → source (finalize), via params.storage
direction: down

sink: "Sink — process()" {
  w1: "Worker 1\nprocess(batch) -> state_id"
  w2: "Worker N\nprocess(batch) -> state_id"
}

storage: "params.storage\n(BoundStorage, keyed by execution_id)" {
  style.fill: "#dee8d1"
  style.stroke: "#4f6a34"
}

combine: "combine(state_ids)\nreduce all partials once\n-> finalize_state_ids"

source: "Source — finalize()\nstream the result out\n(one batch per tick)" {
  style.fill: "#e3e6d2"
  style.stroke: "#5f7a3c"
}

sink.w1 -> storage: stash batch
sink.w2 -> storage: stash batch
storage -> combine
combine -> source
