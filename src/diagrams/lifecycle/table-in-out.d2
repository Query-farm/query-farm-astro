# Table-in-out single-worker lifecycle — see scripts/render-diagrams.sh
shape: sequence_diagram

engine: DuckDB engine
worker: VGI worker (Table-in-out)

engine -> worker: bind(request)
worker -> engine: BindResponse (output schema)

input phase: {
  engine -> worker: init(phase = INPUT)
  per input batch: {
    engine -> worker: exchange(batch)
    worker -> worker: process(batch, out)
    worker -> engine: out.emit() output batches
  }
  engine -> worker: close input stream
}

finalize phase: {
  engine -> worker: init(phase = FINALIZE)
  worker -> worker: finalize(params, states, out)
  worker -> engine: out.emit() / out.finish()
}
