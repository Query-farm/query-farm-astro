style.fill: "#f7f3ea"   # soil-50 paper — was d2 theme white, which fought the page ground
# Aggregate lifecycle: update → combine → finalize (DuckDB GROUP BY model)
direction: down

workers: Parallel workers {
  w1: "Worker 1 — update()\nfold each batch into\nper-group state"
  w2: "Worker 2 — update()\nfold each batch into\nper-group state"
}

combine: "combine(source, target)\nmerge partial states\nfor each group across workers"

finalize: "finalize(group_ids, states)\none output row per group" {
  style.fill: "#dee8d1"
  style.stroke: "#4f6a34"
}

workers.w1 -> combine: partial states
workers.w2 -> combine: partial states
combine -> finalize
