# Parallel workers: primary runs finalize, secondaries do not — see scripts/render-diagrams.sh
shape: sequence_diagram

engine: DuckDB engine
primary: Primary worker
secondary: Secondary worker(s)

engine -> primary: init(INPUT) + global_init()
engine -> secondary: init(INPUT, execution_id from primary)

exchange (round-robin): {
  engine -> primary: exchange(batch subset)
  engine -> secondary: exchange(batch subset)
}

engine -> secondary: input ends -> stop (no finalize)
engine -> primary: init(FINALIZE)
primary -> engine: finalize() -> output
