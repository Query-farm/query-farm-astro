# Scalar function lifecycle — see scripts/render-diagrams.sh
shape: sequence_diagram

engine: DuckDB engine
worker: VGI worker (Scalar)

engine -> worker: bind(request)
worker -> engine: BindResponse (output schema)
engine -> worker: init(request)

per input batch: {
  engine -> worker: exchange(batch)
  worker -> worker: compute(batch) -> Array
  worker -> engine: output batch (same row count)
}

engine -> worker: close input stream
