---
import PageLayout from './PageLayout.astro';
import CrossfieldSubNav from '../components/sections/CrossfieldSubNav.astro';
import Button from '../components/ui/Button.astro';
import { crossfieldStories, crossfieldDocs } from '../data/crossfield';
interface Props {
  frontmatter: { title: string; description: string; eyebrow?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
const toc = headings.filter(h => h.depth === 2);
---
<PageLayout title={frontmatter.title + ' — Crossfield'} description={frontmatter.description}>
  <CrossfieldSubNav slot="subnav" />
  <div class="story-shell" data-pagefind-body data-pagefind-filter="kind:page">
    <header class="story-head">
      <p class="qf-eyebrow text-sun-700">Crossfield / {frontmatter.eyebrow || 'Inside DuckDB'}</p>
      <h1>{frontmatter.title}</h1>
      <p class="story-lede">{frontmatter.description}</p>
    </header>
    <div class="story-grid">
      <aside class="story-toc" aria-label="In this guide">
        <p class="qf-eyebrow text-sun-700">In this guide</p>
        <nav><ul>{toc.map(h => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ul></nav>
        <a class="story-docs" href={crossfieldDocs}>Documentation →</a>
      </aside>
      <article class="story-prose extension-prose"><slot /></article>
    </div>
    <footer class="story-next">
      <div><h2>Run a complete reporting example.</h2><p>Start with order fulfillment, or <a href={crossfieldDocs + '/trading'}>explore investment reporting</a>. Both include source data, model definitions, SQL and expected results.</p></div>
      <Button href={crossfieldDocs + '/fulfillment'}>Run the fulfillment example</Button>
    </footer>
    <nav class="story-related" aria-label="More about Crossfield">
      {crossfieldStories.filter(p => p.href !== current).map(p => <a href={p.href}><strong>{p.title} →</strong><span>{p.description}</span></a>)}
    </nav>
  </div>
</PageLayout>
<style is:global>
  .story-shell { max-width: 1180px; margin: 0 auto; padding: 3.5rem 1.5rem; }
  .story-head { max-width: 900px; padding-bottom: 2.75rem; border-bottom: 1px solid var(--color-soil-300); }
  .story-head h1 { font-size: clamp(2.35rem,5vw,3.65rem); line-height: 1.07; margin-top: 1rem; max-width: 24ch; }
  .story-lede { font-size: 1.2rem; line-height: 1.75; color: var(--color-soil-700); margin-top: 1.5rem; max-width: 65ch; }
  .story-grid { display: grid; gap: 2.5rem; padding-top: 2.5rem; }
  .story-toc { display: none; }
  .story-prose { min-width: 0; max-width: 820px; font-size: 1.02rem; line-height: 1.85; }
  .story-prose p,.story-prose ul,.story-prose ol { margin-block: 1.2rem; }
  .story-prose h2 { font-size: clamp(1.65rem,3vw,2.15rem); line-height: 1.2; margin: 3rem 0 1.2rem; scroll-margin-top: 9rem; }
  .story-prose > h2:first-child { margin-top: 0; }
  .story-prose h3 { margin: 2rem 0 .8rem; font-size: 1.35rem; scroll-margin-top: 9rem; }
  .story-prose a { color: var(--color-field-700); text-decoration: underline; text-underline-offset: 3px; }
  .story-prose :not(pre) > code { font-size: .86em; padding: .15rem .25rem; border-radius: .2rem; background: var(--color-soil-100); overflow-wrap: anywhere; }
  .story-prose pre { background: var(--color-rock-900) !important; overflow-x: auto; }
  .story-prose ul { padding-left: 1.3rem; list-style: disc; }
  .story-prose ol { padding-left: 1.3rem; list-style: decimal; }
  .story-prose li { margin-block: .55rem; }
  .story-prose table { display: block; max-width: 100%; overflow-x: auto; margin-block: 1.5rem; border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; }
  .story-prose th { background: var(--color-soil-100); text-align: left; }
  .story-prose th,.story-prose td { padding: .7rem .85rem; border-bottom: 1px solid var(--color-soil-300); vertical-align: top; min-width: 7rem; }
  .story-prose blockquote { padding: .2rem 1.1rem; border-left: 3px solid var(--color-field-700); background: var(--color-soil-100); margin-block: 1.5rem; }
  .story-prose figure { margin-block: 2rem; }
  .story-next { margin-top: 4rem; padding-block: 2rem; border-block: 1px solid var(--color-soil-300); display: flex; gap: 1.5rem; justify-content: space-between; align-items: center; flex-wrap: wrap; }
  .story-next h2 { font-size: 1.8rem; margin: .6rem 0; }
  .story-next p { color: var(--color-soil-700); }
  .story-next p a { color:var(--color-link); text-decoration:underline; text-underline-offset:3px; }
  .story-related { display: grid; gap: 1.5rem; padding-top: 2rem; }
  .story-related a { color: var(--color-field-700); }
  .story-related span { display: block; color: var(--color-soil-700); font-size: .875rem; line-height: 1.6; margin-top: .5rem; }
  @media(min-width:1000px) { .story-grid { grid-template-columns: 210px minmax(0,1fr); gap: 3rem; } .story-toc { display: block; position: sticky; top: 9rem; align-self: start; font-size: .875rem; line-height: 1.6; } .story-toc ul { margin-top: 1.2rem; } .story-toc li { margin-bottom: .9rem; } .story-toc a { color: var(--color-soil-700); } .story-docs { display: block; margin-top: 1.5rem; color: var(--color-field-700) !important; } .story-related { grid-template-columns: repeat(3,minmax(0,1fr)); } }
</style>
