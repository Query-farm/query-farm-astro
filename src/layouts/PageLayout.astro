---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: unknown;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType,
  jsonLd,
  noindex = false
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} ogType={ogType} jsonLd={jsonLd} noindex={noindex}>
  <slot name="subnav" slot="subnav" />
  <slot />
</BaseLayout>
