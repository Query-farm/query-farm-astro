---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  showBreadcrumbs?: boolean;
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  ogImage,
  showBreadcrumbs = false,
  breadcrumbs = []
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  {showBreadcrumbs && breadcrumbs.length > 0 && (
    <div class="bg-soil-50 border-b border-soil-200">
      <div class="section-container py-4">
        <nav class="flex items-center space-x-2 text-sm">
          <a href="/" class="text-soil-600 hover:text-earth-700 transition-colors">
            Home
          </a>
          {breadcrumbs.map((crumb, index) => (
            <>
              <svg class="w-4 h-4 text-soil-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              {index === breadcrumbs.length - 1 ? (
                <span class="text-soil-900 font-medium">{crumb.name}</span>
              ) : (
                <a href={crumb.href} class="text-soil-600 hover:text-earth-700 transition-colors">
                  {crumb.name}
                </a>
              )}
            </>
          ))}
        </nav>
      </div>
    </div>
  )}

  <slot />
</BaseLayout>
