---
import PageLayout from './PageLayout.astro';
import CrossfieldSubNav from '../components/sections/CrossfieldSubNav.astro';
import { crossfieldPages, crossfieldDocs } from '../data/crossfield';

interface Props {
  frontmatter: { title: string; description: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
const index = crossfieldPages.findIndex(page => page.href === current);
const next = crossfieldPages[index + 1];
const toc = headings.filter(heading => heading.depth === 2);
---

<PageLayout title={`${frontmatter.title} — Crossfield documentation`} description={frontmatter.description}>
  <CrossfieldSubNav slot="subnav" />
  <div class="mx-auto grid w-full max-w-[1440px] gap-9 px-6 py-10 sm:px-7 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[200px_minmax(0,1fr)_180px]">
    <aside class="hidden self-start lg:sticky lg:top-32 lg:block" aria-label="Crossfield documentation">
      <p class="qf-eyebrow mb-4 text-sun-700">Documentation</p>
      <nav aria-label="Documentation pages">
        <ul class="space-y-1">
          {crossfieldPages.map(page => <li>
            <a href={page.href} aria-current={current === page.href ? 'page' : undefined} class:list={[
              'block rounded-md px-3 py-2.5 text-sm no-underline transition-colors focus-visible:outline-2 focus-visible:outline-link',
              current === page.href ? 'bg-soil-200 font-semibold text-soil-900' : 'text-soil-700 hover:bg-soil-100 hover:text-soil-900',
            ]}>{page.title}</a>
          </li>)}
        </ul>
      </nav>
      <div class="mt-7 border-t border-soil-300 pt-5 text-sm leading-relaxed text-soil-700">
        <span class="font-semibold text-soil-900">Development documentation</span>
        <p class="mt-2">Crossfield will ship as part of <a class="text-link underline underline-offset-4" href="/products/haybarn">Haybarn</a>.</p>
        <a class="mt-2 inline-block text-link underline underline-offset-4" href={`${crossfieldDocs}/compatibility`}>Check availability</a>
      </div>
    </aside>
    <article class="min-w-0" data-crossfield-doc data-pagefind-body data-pagefind-filter="kind:page">
      <header class="mb-8 border-b border-soil-300 pb-7">
        <p class="qf-eyebrow text-sun-700">Crossfield / Documentation</p>
        <h1 class="mt-3 text-4xl text-soil-900 md:text-5xl">{frontmatter.title}</h1>
        <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-soil-700">{frontmatter.description}</p>
      </header>
      <div class="crossfield-prose extension-prose"><slot /></div>
      {next && <a href={next.href} class="mt-12 flex items-center justify-between gap-4 rounded-xl border border-soil-300 bg-soil-100 p-5 no-underline hover:border-field-700 focus-visible:outline-2 focus-visible:outline-link">
        <span><span class="qf-eyebrow block text-sun-700">Next</span><span class="mt-1 block font-display text-xl text-soil-900">{next.title}</span></span>
        <span aria-hidden="true" class="text-xl text-link">→</span>
      </a>}
    </article>
    <aside class="hidden self-start xl:sticky xl:top-32 xl:block" aria-label="On this page">
      <p class="mb-3 text-sm font-semibold text-soil-900">On this page</p>
      <ul class="space-y-3 text-sm leading-relaxed">
        {toc.map(heading => <li><a href={`#${heading.slug}`} class="text-soil-700 no-underline hover:text-link focus-visible:outline-2 focus-visible:outline-link">{heading.text}</a></li>)}
      </ul>
    </aside>
  </div>
</PageLayout>

<style is:global>
  .crossfield-prose { color: var(--color-soil-900); font-size: 1rem; line-height: 1.8; }
  .crossfield-prose > :first-child { margin-top: 0; }
  .crossfield-prose p, .crossfield-prose ul, .crossfield-prose ol { margin-block: 1.15rem; }
  .crossfield-prose h2 { margin-top: 2.8rem; padding-top: 1.4rem; border-top: 1px solid var(--color-soil-300); font-size: 1.8rem; line-height: 1.25; scroll-margin-top: 9rem; }
  .crossfield-prose > h2:first-child { padding-top: 0; border-top: 0; }
  .crossfield-prose h3 { margin-block: 1.8rem .8rem; font-size: 1.3rem; scroll-margin-top: 9rem; }
  .crossfield-prose ul { list-style: disc; padding-left: 1.4rem; }
  .crossfield-prose ol { list-style: decimal; padding-left: 1.4rem; }
  .crossfield-prose li { padding-left: .25rem; margin-block: .45rem; }
  .crossfield-prose a { color: var(--color-field-700); text-decoration: underline; text-underline-offset: 3px; }
  .crossfield-prose a:focus-visible { outline: 2px solid var(--color-field-700); outline-offset: 3px; }
  .crossfield-prose :not(pre) > code { padding: .12em .3em; background: var(--color-soil-100); border-radius: .2rem; font-size: .86em; overflow-wrap: anywhere; }
  .crossfield-prose pre { overflow-x: auto; background: var(--color-rock-900) !important; }
  .crossfield-prose .expressive-code { margin-block: 1.5rem; }
  .crossfield-prose table { display: block; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5rem; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .crossfield-prose th { background: var(--color-soil-100); text-align: left; color: var(--color-soil-900); }
  .crossfield-prose td, .crossfield-prose th { padding: .7rem .8rem; border: 1px solid var(--color-soil-300); vertical-align: top; min-width: 7rem; }
  .crossfield-prose blockquote { margin-block: 1.5rem; padding: .3rem 1.1rem; border-left: 3px solid var(--color-field-700); background: var(--color-soil-100); }
</style>
