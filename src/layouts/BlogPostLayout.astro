---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, author, tags } = entry.data;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <article class="py-12 lg:py-16">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <!-- Article Header -->
        <header class="mb-8 lg:mb-12">
          <div class="mb-4">
            <a href="/blog" class="inline-flex items-center text-sm text-earth-600 hover:text-earth-700 font-medium transition-colors">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Blog
            </a>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-soil-900 mb-4">
            {title}
          </h1>

          {description && (
            <p class="text-xl text-soil-600 mb-6">
              {description}
            </p>
          )}

          <div class="flex flex-wrap items-center gap-4 text-sm text-soil-600">
            {author && (
              <div class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                {author}
              </div>
            )}
            <div class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-soil-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {formattedDate}
            </div>
          </div>

          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {tags.map(tag => (
                <Badge variant="default">
                  {tag}
                </Badge>
              ))}
            </div>
          )}
        </header>

        <!-- Article Content -->
        <div class="prose prose-lg prose-soil max-w-none
                    prose-headings:font-display prose-headings:font-bold prose-headings:text-soil-900
                    prose-p:text-soil-700 prose-p:leading-relaxed
                    prose-a:text-earth-600 prose-a:no-underline hover:prose-a:text-earth-700 prose-a:font-medium
                    prose-strong:text-soil-900 prose-strong:font-semibold
                    prose-code:text-earth-700 prose-code:bg-soil-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                    prose-pre:bg-soil-900 prose-pre:text-soil-50
                    prose-blockquote:border-l-earth-500 prose-blockquote:text-soil-700
                    prose-img:rounded-xl prose-img:shadow-lg">
          <slot />
        </div>

        <!-- Article Footer -->
        <footer class="mt-12 pt-8 border-t border-soil-200">
          <div class="flex items-center justify-between">
            <a href="/blog" class="btn-secondary">
              ← Back to All Posts
            </a>
            <div class="flex items-center gap-3">
              <span class="text-sm text-soil-600">Share:</span>
              <a href={`https://twitter.com/intent/tweet?url=${Astro.url}&text=${title}`} target="_blank" rel="noopener noreferrer" class="text-soil-600 hover:text-earth-700 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                </svg>
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} target="_blank" rel="noopener noreferrer" class="text-soil-600 hover:text-earth-700 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
