---
// Bare document shell. Nothing in the site routes through this today — use
// BaseLayout (head/meta/JSON-LD + nav + footer) or PageLayout instead. Kept as
// a minimal, palette-correct starting point for one-off standalone pages.
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Query.Farm' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-soil-50 text-soil-900">
    <slot />
  </body>
</html>
