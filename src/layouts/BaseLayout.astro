---
import Header from '../components/layout/Header.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** og:type — "website" for landing pages, "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Optional JSON-LD structured data object (or array) injected verbatim. */
  jsonLd?: unknown;
  /** Article metadata emitted only when ogType is "article". */
  articlePublishedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  noHeader?: boolean;
  noFooter?: boolean;
  /** Emit robots noindex — for pages that are legitimately thin (see blog tag archives). */
  noindex?: boolean;
}

const {
  title,
  description = 'DuckDB extensions, services, and data infrastructure solutions for modern teams. Build powerful data systems with Query.Farm.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  jsonLd,
  articlePublishedTime,
  articleAuthor,
  articleSection,
  articleTags = [],
  noHeader = false,
  noFooter = false,
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Query.Farm' ? title : `${title} | Query.Farm`;
const ogImageURL = new URL(ogImage, Astro.site);

// Cache-bust the image URL itself, not just the page's. Discord (and other
// unfurl bots) cache a fetched og:image by its own URL, separate from the
// page's embed-metadata cache — re-sharing the PAGE with a `?v=` query
// string still hands the bot the same unversioned /og-image.jpg it already
// has cached, so a redesigned default image can sit stale in link previews
// for months after the site itself is fixed. Stamping a content hash onto
// the image URL means every real change to the file is a genuinely new URL
// (the same trick /favicon.svg?v=2 above uses by hand). Static site, public/
// assets only — skip anything that isn't a local file (an absolute URL, or
// a path that doesn't resolve, which shouldn't happen for a valid prop).
if (!/^https?:\/\//.test(ogImage)) {
  const ogImagePath = join(process.cwd(), 'public', ogImage);
  if (existsSync(ogImagePath)) {
    const hash = createHash('sha256').update(readFileSync(ogImagePath)).digest('hex').slice(0, 10);
    ogImageURL.searchParams.set('v', hash);
  }
}

// GA4 property for query.farm. Duplicated as a literal in astro.config.mjs,
// which builds the Starlight <head> for /vgi/docs and can't import this file.
const GA_MEASUREMENT_ID = 'G-EZ01WJETLF';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- ICO first, as a fallback for crawlers/old browsers that only ever
         request /favicon.ico regardless of this tag; SVG after with
         sizes="any" so every browser that supports it prefers this one. Both
         must actually be the Strata Sun mark — Cloudflare Pages direct-upload
         deploys don't prune old assets, so a stale favicon.ico from a
         previous design can otherwise keep serving indefinitely even once
         this file is gone from the repo. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Google tag (gtag.js) — production builds only, and never from a local
      host. Two gates because they close two different holes: the
      `import.meta.env.PROD` check keeps gtag.js out of `npm run dev`
      entirely, and the hostname check keeps `npm run preview` — a real
      production build, just served from localhost — from reporting local
      page views into the live property. The tag is injected from script
      rather than written as a <script src>, so a local run doesn't even
      make the request to Google.
      Mirrored in astro.config.mjs for the Starlight (/vgi/docs) head.
    */}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
        if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){ dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);

          var gaTag = document.createElement('script');
          gaTag.async = true;
          gaTag.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(gaTag);
        }
      </script>
    )}

    {/*
      Fonts come in via an @import at the top of global.css, which bundles into
      the stylesheet — so the browser can't discover fonts.gstatic.com until it
      has fetched AND parsed that CSS. Preconnecting here collapses one round
      trip off the critical path. Pre-dates the redesign; the redesign just
      made it matter more, since Fraunces is a variable font on three axes.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Query.Farm" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === 'article' && articleTags.map(tag => <meta property="article:tag" content={tag} />)}

    {/* Twitter card. The card tags stay — X and several other clients read them
        to build link previews — but no `site` tag: that one names an account,
        and @queryfarm is not one we hold. Written as a JSX comment, not an HTML
        one: Astro ships `<!-- -->` to every rendered page. */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content={fullTitle} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Fonts are loaded in global.css -->
  </head>
  <body class="flex flex-col min-h-screen bg-soil-50 text-soil-900">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[200] focus:rounded-lg focus:border focus:border-soil-900 focus:bg-soil-50 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-soil-900"
    >
      Skip to content
    </a>

    {!noHeader && (
      <>
        <Header />
        <MobileNav />
      </>
    )}

    <main id="main" class="flex-1" data-pagefind-filter="kind:page">
      <slot />
    </main>

    {!noFooter && <Footer />}
  </body>
</html>
