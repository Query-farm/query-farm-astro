# Hosted Orchard — local secrets for `npx wrangler pages dev dist` (port 8788).
# Copy to .dev.vars (gitignored) and fill in. Production values are Pages
# project secrets: see docs/orchard-hosted.md.

# Session cookie key: at least 32 random characters (openssl rand -base64 48).
SESSION_SECRET=

# WorkOS (staging environment while testing).
# The site's confidential client (User Management sign-in for the console).
WORKOS_CLIENT_ID=client_
WORKOS_API_KEY=sk_test_
# Optional; defaults to <origin>/api/auth/callback. `wrangler pages dev dist`
# serves on :8788, and this exact URI must be registered in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:8788/api/auth/callback
# The public OAuth client DuckDB's vgi extension uses for ATTACH, and the AuthKit
# issuer. Not read by the site yet: the hosted gateway (plan step 5) needs them.
WORKOS_VGI_CLIENT_ID=client_
WORKOS_AUTHKIT_DOMAIN=https://<subdomain>.authkit.app

# Comma-separated emails allowed into /products/orchard/console/admin/ (must be verified in WorkOS).
ORCHARD_ADMINS=

# Resend: lead and request emails (also used by the enquiry form).
RESEND_API_KEY=re_
ORCHARD_NOTIFY_TO=hello@query.farm
ORCHARD_NOTIFY_FROM=Query.Farm Orchard <website@query.farm>

# Stripe (test mode while testing).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Metered prices (one per size, each on its own Billing Meter) and the paid-worker license price.
STRIPE_PRICE_S=price_
STRIPE_PRICE_M=price_
STRIPE_PRICE_L=price_
STRIPE_PRICE_LICENSE=price_

# Bearer token for POST /api/orchard/meter (also a GitHub Actions secret).
ORCHARD_METER_TOKEN=

# Existing enquiry form secrets, for completeness.
TURNSTILE_SECRET_KEY=
RESEND_WEBHOOK_SECRET=
