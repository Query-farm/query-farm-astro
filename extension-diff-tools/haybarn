#!/bin/sh
# Wrapper that makes Haybarn (Query.Farm's DuckDB distribution) look like a
# single `duckdb` binary to extension-diff.py / check-examples.py, which invoke
# the CLI as `<binary> -c "<sql>"`. All args are forwarded to the npx-launched
# Haybarn CLI. Override the launch command with HAYBARN_CMD, e.g.
#   HAYBARN_CMD="uvx haybarn-cli==1.5.3" extension-diff-tools/haybarn -c "SELECT 1"
exec ${HAYBARN_CMD:-npx --yes haybarn@rc} "$@"
