{
  "version": "0.2.0.dev0",
  "name": "scoped_sales",
  "description": "Independent dataset metric fixture: logical amount is twice the physical raw amount.",
  "datasets": [
    {
      "name": "orders",
      "source": "main.scoped_orders",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "source_id"
              }
            ]
          }
        },
        {
          "name": "amount",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "raw_amount * 2"
              }
            ]
          }
        },
        {
          "name": "region",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "region"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "status",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "status"
              }
            ]
          }
        }
      ],
      "metrics": [
        {
          "name": "revenue",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "SUM(amount)"
              }
            ]
          }
        },
        {
          "name": "rows",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "COUNT(*)"
              }
            ]
          }
        },
        {
          "name": "mean",
          "datatype": "Float",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "AVG(amount)"
              }
            ]
          }
        },
        {
          "name": "paid",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "SUM(amount) FILTER (WHERE status = 'paid')"
              }
            ]
          }
        },
        {
          "name": "paid_rows",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "COUNT(*) FILTER (WHERE status = 'paid')"
              }
            ]
          }
        },
        {
          "name": "not_paid",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "SUM(CASE WHEN NOT status = 'paid' THEN amount ELSE 0 END)"
              }
            ]
          }
        },
        {
          "name": "median",
          "datatype": "Float",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY amount)"
              }
            ]
          }
        },
        {
          "name": "private_total",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "SUM(amount)"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "returns",
      "source": "main.scoped_returns",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "source_id"
              }
            ]
          }
        },
        {
          "name": "amount",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "raw_amount"
              }
            ]
          }
        },
        {
          "name": "region",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "region"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        }
      ],
      "metrics": [
        {
          "name": "revenue",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "SUM(amount)"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "root_total",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(orders.amount)"
          }
        ]
      }
    },
    {
      "name": "root_double",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "orders.revenue * 2"
          }
        ]
      }
    },
    {
      "name": "rank_first",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "RANK() OVER (ORDER BY orders.revenue ASC NULLS FIRST)"
          }
        ]
      }
    },
    {
      "name": "rank_last",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "RANK() OVER (ORDER BY orders.revenue ASC NULLS LAST)"
          }
        ]
      }
    }
  ],
  "custom_extensions": [
    {
      "vendor_name": "CROSSFIELD",
      "data": "{\"policy_version\":1,\"metrics\":[\"orders.revenue\",\"orders.rows\",\"orders.mean\",\"orders.paid\",\"orders.paid_rows\",\"orders.not_paid\",\"orders.median\",\"returns.revenue\",\"root_total\",\"root_double\",\"rank_first\",\"rank_last\"],\"dimensions\":[\"orders.region\",\"returns.region\"],\"filter_dimensions\":[\"orders.id\",\"orders.region\"],\"detail_fields\":[\"orders.id\",\"orders.amount\"],\"key_evidence\":\"trusted\",\"allow_semantic_joins\":true,\"field_semantics\":{\"orders.region\":{\"shared_dimension\":\"company.region.v1\",\"domain\":\"company.region\"},\"returns.region\":{\"shared_dimension\":\"company.region.v1\",\"domain\":\"company.region\"}},\"metric_semantics\":{\"orders.revenue\":{\"unit\":\"USD\",\"additivity\":\"additive\"},\"returns.revenue\":{\"unit\":\"USD\",\"additivity\":\"additive\"},\"rank_first\":{\"window_grain\":[\"orders.region\"]},\"rank_last\":{\"window_grain\":[\"orders.region\"]}},\"window_metrics\":[\"rank_first\",\"rank_last\"]}"
    }
  ]
}
