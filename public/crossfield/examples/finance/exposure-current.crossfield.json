{
  "crossfield": 1,
  "name": "exposure",
  "id": "org.queryfarm.examples.finance.exposure",
  "imports": [
    {
      "path": "exposure.ossie.json"
    }
  ],
  "policy": {
    "policy_version": 1,
    "metrics": [
      "gross_exposure",
      "net_exposure"
    ],
    "dimensions": [
      "positions.book",
      "positions.issuer"
    ],
    "filter_dimensions": [
      "positions.book",
      "positions.issuer"
    ],
    "key_evidence": "trusted",
    "dataset_bindings": {
      "positions": {
        "binding_key": "warehouse",
        "provider_id": "org.queryfarm.examples.finance",
        "instance_id": "synthetic"
      }
    },
    "dataset_semantics": {
      "positions": {
        "population": "as_of = DATE '2024-01-31' AND book IN ('Book A', 'Book B')",
        "population_id": "exposure.snapshot.2024-01-31"
      }
    },
    "metric_semantics": {
      "gross_exposure": {
        "additivity": "additive",
        "unit": "USD"
      },
      "net_exposure": {
        "additivity": "additive",
        "unit": "USD"
      }
    },
    "allow_semantic_joins": true,
    "field_semantics": {
      "positions.issuer": {
        "shared_dimension": "example.cash_equity_issuer.v1",
        "domain": "example.cash_equity_issuer"
      }
    }
  }
}
