{
  "crossfield": 1,
  "name": "executions",
  "id": "org.queryfarm.examples.finance.executions",
  "imports": [
    {
      "path": "executions.ossie.json"
    }
  ],
  "policy": {
    "policy_version": 1,
    "metrics": [
      "filled_shares",
      "execution_cost",
      "execution_price"
    ],
    "dimensions": [
      "fills.order_id"
    ],
    "filter_dimensions": [
      "fills.order_id"
    ],
    "key_evidence": "trusted",
    "dataset_bindings": {
      "fills": {
        "binding_key": "warehouse",
        "provider_id": "org.queryfarm.examples.finance",
        "instance_id": "synthetic"
      }
    },
    "dataset_semantics": {
      "fills": {
        "population": "status = 'active'",
        "population_id": "executions.snapshot.2024-01-31"
      }
    },
    "metric_semantics": {
      "filled_shares": {
        "additivity": "additive"
      },
      "execution_cost": {
        "additivity": "additive",
        "unit": "USD"
      },
      "execution_price": {
        "additivity": "non_additive"
      }
    }
  }
}
