{
  "crossfield": 1,
  "name": "limits",
  "id": "org.queryfarm.examples.finance.limits",
  "imports": [
    {
      "path": "limits.ossie.json"
    }
  ],
  "policy": {
    "policy_version": 1,
    "metrics": [
      "gross_limit"
    ],
    "dimensions": [
      "issuer_limits.issuer"
    ],
    "filter_dimensions": [
      "issuer_limits.issuer"
    ],
    "key_evidence": "trusted",
    "dataset_bindings": {
      "issuer_limits": {
        "binding_key": "warehouse",
        "provider_id": "org.queryfarm.examples.finance",
        "instance_id": "synthetic"
      }
    },
    "dataset_semantics": {
      "issuer_limits": {
        "population": "as_of = DATE '2024-01-31'",
        "population_id": "limits.snapshot.2024-01-31"
      }
    },
    "metric_semantics": {
      "gross_limit": {
        "additivity": "additive",
        "unit": "USD"
      }
    },
    "allow_semantic_joins": true,
    "field_semantics": {
      "issuer_limits.issuer": {
        "shared_dimension": "example.cash_equity_issuer.v1",
        "domain": "example.cash_equity_issuer"
      }
    }
  }
}
