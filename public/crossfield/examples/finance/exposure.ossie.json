{
  "version": "0.2.0.dev0",
  "name": "exposure",
  "description": "Independently authored synthetic trading fixture. USD cash equities at a fixed reporting cutoff.",
  "datasets": [
    {
      "name": "positions",
      "source": "main.positions",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "id"
              }
            ]
          }
        },
        {
          "name": "as_of",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "as_of"
              }
            ]
          }
        },
        {
          "name": "book",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "book"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "issuer",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "issuer"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "market_value_usd",
          "datatype": "Decimal",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "market_value_usd"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "gross_exposure",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(ABS(positions.market_value_usd))"
          }
        ]
      }
    },
    {
      "name": "net_exposure",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(positions.market_value_usd)"
          }
        ]
      }
    }
  ]
}
