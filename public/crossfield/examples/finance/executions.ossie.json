{
  "version": "0.2.0.dev0",
  "name": "executions",
  "description": "Independently authored synthetic trading fixture. USD cash equities at a fixed reporting cutoff.",
  "datasets": [
    {
      "name": "fills",
      "source": "main.fills",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "id"
              }
            ]
          }
        },
        {
          "name": "order_id",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "order_id"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "shares",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "shares"
              }
            ]
          }
        },
        {
          "name": "price",
          "datatype": "Decimal",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "price"
              }
            ]
          }
        },
        {
          "name": "status",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "status"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "filled_shares",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(fills.shares)"
          }
        ]
      }
    },
    {
      "name": "execution_cost",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(fills.shares * fills.price)"
          }
        ]
      }
    },
    {
      "name": "execution_price",
      "datatype": "Float",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(fills.shares * fills.price) / NULLIF(SUM(fills.shares), 0)"
          }
        ]
      }
    }
  ]
}
