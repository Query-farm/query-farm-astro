{
  "version": "0.2.0.dev0",
  "name": "limits",
  "description": "Independently authored synthetic trading fixture. USD cash equities at a fixed reporting cutoff.",
  "datasets": [
    {
      "name": "issuer_limits",
      "source": "main.issuer_limits",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "id"
              }
            ]
          }
        },
        {
          "name": "issuer",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "issuer"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "as_of",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "as_of"
              }
            ]
          }
        },
        {
          "name": "limit_usd",
          "datatype": "Decimal",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "limit_usd"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "gross_limit",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(issuer_limits.limit_usd)"
          }
        ]
      }
    }
  ]
}
