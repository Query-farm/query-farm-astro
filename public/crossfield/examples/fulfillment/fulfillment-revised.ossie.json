{
  "version": "0.2.0.dev0",
  "name": "fulfillment",
  "description": "Synthetic order fulfillment, January 31 original promise cohort, observed through February 3. One source row per order.",
  "datasets": [
    {
      "name": "orders",
      "source": "main.order_facts",
      "primary_key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "id"
              }
            ]
          }
        },
        {
          "name": "region",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "region"
              }
            ]
          },
          "dimension": {
            "is_time": false
          }
        },
        {
          "name": "status",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "status"
              }
            ]
          }
        },
        {
          "name": "original_promised_date",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "original_promised_date"
              }
            ]
          }
        },
        {
          "name": "revised_promised_date",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "revised_promised_date"
              }
            ]
          }
        },
        {
          "name": "ordered_units",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "ordered_units"
              }
            ]
          }
        },
        {
          "name": "delivered_units",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "delivered_units"
              }
            ]
          }
        },
        {
          "name": "last_delivered_date",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "last_delivered_date"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "eligible_orders",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(orders.id)"
          }
        ]
      }
    },
    {
      "name": "on_time_orders",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(CASE WHEN orders.delivered_units >= orders.ordered_units AND orders.last_delivered_date <= orders.revised_promised_date THEN 1 ELSE 0 END)"
          }
        ]
      }
    },
    {
      "name": "on_time_percent",
      "datatype": "Float",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "100.0 * SUM(CASE WHEN orders.delivered_units >= orders.ordered_units AND orders.last_delivered_date <= orders.revised_promised_date THEN 1 ELSE 0 END) / COUNT(orders.id)"
          }
        ]
      }
    }
  ]
}
