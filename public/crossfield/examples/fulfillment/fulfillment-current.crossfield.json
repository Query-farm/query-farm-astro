{
  "crossfield": 1,
  "name": "fulfillment",
  "id": "org.queryfarm.examples.fulfillment",
  "imports": [
    {
      "path": "fulfillment-current.ossie.json"
    }
  ],
  "policy": {
    "policy_version": 1,
    "metrics": [
      "eligible_orders",
      "on_time_orders",
      "on_time_percent"
    ],
    "dimensions": [
      "orders.region"
    ],
    "filter_dimensions": [
      "orders.region"
    ],
    "key_evidence": "trusted",
    "dataset_bindings": {
      "orders": {
        "binding_key": "warehouse",
        "provider_id": "org.queryfarm.examples.fulfillment",
        "instance_id": "synthetic"
      }
    },
    "dataset_semantics": {
      "orders": {
        "population": "original_promised_date = DATE '2024-01-31' AND status <> 'cancelled'",
        "population_id": "orders.original-promise.2024-01-31"
      }
    },
    "metric_semantics": {
      "eligible_orders": {
        "additivity": "additive"
      },
      "on_time_orders": {
        "additivity": "additive"
      },
      "on_time_percent": {
        "additivity": "non_additive"
      }
    }
  }
}
