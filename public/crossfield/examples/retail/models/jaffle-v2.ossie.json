  ],
  "relationships": [
    {
      "name": "orders_customers",
      "from": "orders",
      "to": "customers",
      "from_columns": [
        "customer_id"
      ],
      "to_columns": [
        "id"
      ]
    },
    {
      "name": "orders_stores",
      "from": "orders",
      "to": "stores",
      "from_columns": [
        "store_id"
      ],
      "to_columns": [
        "id"
      ]
    },
    {
      "name": "items_orders",
      "from": "items",
      "to": "orders",
      "from_columns": [
        "order_id"
      ],
      "to_columns": [
        "id"
      ]
    },
    {
      "name": "items_products",
      "from": "items",
      "to": "products",
      "from_columns": [
        "sku"
      ],
      "to_columns": [
        "sku"
      ]
    }
  ],
  "metrics": [
    {
      "name": "order_count",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(orders.id)"
          }
        ]
      },
      "description": "Order count; independent of the number of order lines."
    },
    {
      "name": "subtotal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(orders.subtotal)"
          }
        ]
      },
      "description": "Order amounts excluding tax, in USD."
    },
    {
      "name": "tax",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(orders.tax)"
          }
        ]
      },
      "description": "Tax collected, in USD."
    },
    {
      "name": "order_total",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(orders.total)"
          }
        ]
      },
      "description": "Order amounts including tax, in USD."
    },
    {
      "name": "item_count",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(items.id)"
          }
        ]
      },
      "description": "Order-line count, including repeated products."
    },
    {
      "name": "customer_count",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(DISTINCT orders.customer_id)"
          }
        ]
      }
    },
    {
      "name": "first_orders",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(CASE WHEN orders.is_first THEN 1 ELSE 0 END)"
          }
        ]
      }
    },
    {
      "name": "repeat_orders",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(CASE WHEN orders.is_first THEN 0 ELSE 1 END)"
          }
        ]
      }
    },
    {
      "name": "average_order_value",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "order_total / NULLIF(order_count, 0)"
          }
        ]
      }
    },
    {
      "name": "revenue",
      "datatype": "Decimal",
      "description": "Revenue excludes collected tax (current reporting definition).",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "subtotal"
          }
        ]
      }
    }
  ],
  "description": "Frozen Jaffle Shop reporting population: orders, order lines and store/customer/product dimensions."
}
