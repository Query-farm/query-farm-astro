{
  "crossfield": 1,
  "name": "jaffle",
  "id": "org.queryfarm.examples.jaffle",
  "imports": [
    {
      "path": "jaffle-v2.ossie.json"
    }
  ],
  "policy": {
    "policy_version": 1,
    "metrics": [
      "order_count",
      "subtotal",
      "tax",
      "order_total",
      "item_count",
      "customer_count",
      "first_orders",
      "repeat_orders",
      "average_order_value",
      "revenue"
    ],
    "dimensions": [
      "orders.order_day",
      "orders.order_month",
      "orders.is_first",
      "products.name",
      "products.category",
      "stores.id",
      "stores.name",
      "customers.id",
      "customers.name"
    ],
    "detail_fields": [
      "orders.id",
      "orders.customer_id",
      "orders.store_id",
      "orders.order_day",
      "orders.order_month",
      "orders.subtotal",
      "orders.tax",
      "orders.total",
      "orders.is_first",
      "items.id",
      "items.order_id",
      "items.sku",
      "products.sku",
      "products.name",
      "products.category",
      "products.price",
      "stores.id",
      "stores.name",
      "customers.id",
      "customers.name"
    ],
    "relationships": [
      "orders_customers",
      "orders_stores",
      "items_orders",
      "items_products"
    ],
    "key_evidence": "trusted",
    "metric_semantics": {
      "order_count": {
        "additivity": "additive"
      },
      "subtotal": {
        "additivity": "additive",
        "unit": "USD"
      },
      "tax": {
        "additivity": "additive",
        "unit": "USD"
      },
      "order_total": {
        "additivity": "additive",
        "unit": "USD"
      },
      "item_count": {
        "additivity": "additive"
      },
      "customer_count": {
        "additivity": "non_additive"
      },
      "first_orders": {
        "additivity": "additive"
      },
      "repeat_orders": {
        "additivity": "additive"
      },
      "average_order_value": {
        "additivity": "non_additive",
        "unit": "USD"
      },
      "revenue": {
        "additivity": "additive",
        "unit": "USD",
        "tags": {
          "owner": "finance",
          "format": "currency"
        }
      }
    },
    "relationship_semantics": {
      "orders_customers": {
        "optional": false,
        "key_evidence": "trusted"
      },
      "orders_stores": {
        "optional": false,
        "key_evidence": "trusted"
      },
      "items_orders": {
        "optional": false,
        "key_evidence": "trusted"
      },
      "items_products": {
        "optional": false,
        "key_evidence": "trusted"
      }
    },
    "dataset_bindings": {
      "orders": {
        "binding_key": "sales",
        "provider_id": "org.queryfarm.fixture.jaffle"
      },
      "items": {
        "binding_key": "sales",
        "provider_id": "org.queryfarm.fixture.jaffle"
      },
      "products": {
        "binding_key": "reference",
        "provider_id": "org.queryfarm.fixture.jaffle"
      },
      "stores": {
        "binding_key": "reference",
        "provider_id": "org.queryfarm.fixture.jaffle"
      },
      "customers": {
        "binding_key": "reference",
        "provider_id": "org.queryfarm.fixture.jaffle"
      }
    },
    "field_semantics": {
      "orders.order_day": {
        "granularity": "day",
        "calendar": "gregorian"
      },
      "orders.order_month": {
        "granularity": "month",
        "calendar": "gregorian"
      },
      "orders.subtotal": {
        "decimal_type": "DECIMAL(18,2)",
        "unit": "USD"
      },
      "orders.tax": {
        "decimal_type": "DECIMAL(18,2)",
        "unit": "USD"
      },
      "orders.total": {
        "decimal_type": "DECIMAL(18,2)",
        "unit": "USD"
      },
      "products.price": {
        "decimal_type": "DECIMAL(18,2)",
        "unit": "USD"
      },
      "stores.name": {
        "comment": "Display name of the store.",
        "tags": {
          "role": "grouping"
        },
        "sql_name": "store_name"
      },
      "orders.is_first": {
        "sql_name": "is_first_order"
      },
      "products.name": {
        "sql_name": "product_name"
      },
      "products.category": {
        "sql_name": "product_category"
      },
      "stores.id": {
        "sql_name": "store_id"
      },
      "customers.id": {
        "sql_name": "customer_id"
      },
      "customers.name": {
        "sql_name": "customer_name"
      }
    },
    "filter_dimensions": [
      "orders.order_day",
      "orders.order_month",
      "orders.is_first",
      "products.name",
      "products.category",
      "stores.id",
      "stores.name",
      "customers.id",
      "customers.name"
    ],
    "tags": {
      "owner": "finance",
      "example": "jaffle-shop"
    }
  }
}
