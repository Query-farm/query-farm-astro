/*
  Content-Signal: search=yes, ai-input=yes, ai-train=no

# Astro fingerprints these assets, so changed content gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# Data files the Haybarn function Pages Functions fetch; the public API is
# under /products/haybarn/functions/api/v1/.
/haybarn-function-data/*
  X-Robots-Tag: noindex

# Exact source documents should never be transformed or MIME-sniffed.
/*.json
  X-Content-Type-Options: nosniff

/*.md
  X-Content-Type-Options: nosniff

/*.txt
  X-Content-Type-Options: nosniff

# Bluesky handle verification for @query.farm: the account's DID as plain text.
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
