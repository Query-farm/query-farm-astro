/*
  Content-Signal: search=yes, ai-input=yes, ai-train=no

# Exact source documents should never be transformed or MIME-sniffed.
/*.json
  X-Content-Type-Options: nosniff

/*.md
  X-Content-Type-Options: nosniff

/*.txt
  X-Content-Type-Options: nosniff

# Bluesky handle verification for @query.farm: the account's DID as plain text.
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
